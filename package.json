{
  "name": "mcp-benchmark",
  "version": "1.3.0",
  "description": "Deterministic quantitative quality benchmark and linter for Model Context Protocol (MCP) tool definitions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-benchmark": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "benchmark": "tsx src/cli.ts",
    "test": "node --test",
    "rules": "node dist/cli.js --rules",
    "discover": "node dist/cli.js --discover",
    "update-leaderboard": "node dist/cli.js --update-leaderboard",
    "sync-registry": "node scripts/sync-registry.mjs",
    "generate-ecosystem": "node scripts/generate-ecosystem-artifacts.mjs"
  },
  "files": [
    "dist",
    "examples",
    "fixtures",
    "registry",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "keywords": [
    "agent-skills",
    "ai-agents",
    "benchmark",
    "claude",
    "code-quality",
    "eval",
    "github-action",
    "json-schema",
    "linter",
    "llm",
    "mcp",
    "mcp-server",
    "mcp-tools",
    "model-context-protocol",
    "sarif",
    "tool-definitions",
    "tool-use"
  ],
  "author": "Yunus Arda Güney (@yunusarda-sudo)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunusarda-sudo/mcp-benchmark.git"
  },
  "homepage": "https://github.com/yunusarda-sudo/mcp-benchmark#readme",
  "bugs": {
    "url": "https://github.com/yunusarda-sudo/mcp-benchmark/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=18"
  }
}
