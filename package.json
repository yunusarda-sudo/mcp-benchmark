{
  "name": "mcp-benchmark",
  "version": "1.1.0",
  "description": "Deterministic quantitative quality benchmark and linter for Model Context Protocol (MCP) tool definitions",
  "main": "dist/index.js",

  "types": "dist/index.d.ts",
  "bin": {
    "mcp-benchmark": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "benchmark": "tsx src/cli.ts",
    "test": "node --test"
  },
  "files": [
    "dist",
    "examples",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "benchmark",
    "linter",
    "eval",
    "ai-agents",
    "tool-use",
    "llm",
    "claude"
  ],
  "author": "Yunus Arda Güney (@yunusarda-sudo)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yunusarda-sudo/mcp-benchmark.git"
  },
  "homepage": "https://github.com/yunusarda-sudo/mcp-benchmark#readme",
  "bugs": {
    "url": "https://github.com/yunusarda-sudo/mcp-benchmark/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
