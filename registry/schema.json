{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpServerRegistryEntry",
  "description": "A benchmarked MCP server entry. Registry entries are written by scripts/sync-registry.mjs from live tools/list output; manual entries are community submissions.",
  "type": "object",
  "required": [
    "name",
    "category",
    "tools",
    "source"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Registry server name (e.g. io.github.acme/weather) or display name for manual entries",
      "minLength": 2,
      "maxLength": 200
    },
    "title": {
      "type": "string",
      "description": "Human-readable title from the registry",
      "maxLength": 100
    },
    "category": {
      "type": "string",
      "description": "Ecosystem domain category",
      "enum": [
        "AI, LLMs & Agents",
        "Databases & Storage",
        "Vector DBs & AI Search",
        "Developer Tools & DevOps",
        "Developer Tools & VCS",
        "Finance, Crypto & Web3",
        "Payments, CRM & Finance",
        "E-Commerce & Retail",
        "Web Scraping & Automation",
        "Communication & Alerting",
        "Productivity & Notes",
        "Healthcare & Wellness",
        "Design, UI & 3D Media",
        "Jobs, Career & Learning",
        "Travel, Maps & Weather",
        "Security & Identity",
        "Observability & Analytics",
        "Cloud & Hosting Platforms",
        "Social, Media & Knowledge",
        "Other"
      ]
    },
    "description": {
      "type": "string",
      "description": "Short summary of what this MCP server connects to"
    },
    "repository": {
      "type": "string",
      "description": "GitHub/GitLab repository URL"
    },
    "maintainer": {
      "type": "string",
      "description": "GitHub username or organization handle"
    },
    "tools": {
      "type": "array",
      "description": "List of MCP tool definitions provided by the server",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "inputSchema": {
            "type": "object"
          },
          "outputSchema": {
            "type": "object"
          }
        }
      },
      "maxItems": 500
    },
    "$schema": {
      "type": "string"
    },
    "source": {
      "description": "Provenance of the tool definitions",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "registry",
            "name",
            "version",
            "remoteUrl",
            "fetchedAt",
            "toolsSha256"
          ],
          "properties": {
            "type": {
              "const": "registry"
            },
            "registry": {
              "const": "registry.modelcontextprotocol.io"
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "remoteUrl": {
              "type": "string",
              "pattern": "^https://"
            },
            "fetchedAt": {
              "type": "string",
              "format": "date-time"
            },
            "toolsSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "publishedAt": {
              "type": "string",
              "format": "date-time",
              "description": "Registry publishedAt (or updatedAt) of this version"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "submittedAt"
          ],
          "properties": {
            "type": {
              "const": "manual"
            },
            "submittedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    }
  }
}
