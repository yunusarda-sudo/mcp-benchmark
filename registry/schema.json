{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McpServerRegistryEntry",
  "description": "Schema for community MCP server contributions to the MCP Benchmark Leaderboard",
  "type": "object",
  "required": ["name", "category", "tools"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of the MCP server",
      "minLength": 2,
      "maxLength": 64
    },
    "category": {
      "type": "string",
      "description": "Ecosystem domain category",
      "enum": [
        "Developer Tools & VCS",
        "Databases & Storage",
        "Vector DBs & AI Search",
        "Productivity & Notes",
        "Communication & Alerting",
        "Cloud & Hosting Platforms",
        "Observability & Analytics",
        "Web Scraping & Automation",
        "Payments, CRM & Finance",
        "Social, Media & Knowledge",
        "Security & Identity",
        "Other"
      ]
    },
    "description": {
      "type": "string",
      "description": "Short summary of what this MCP server connects to"
    },
    "repository": {
      "type": "string",
      "description": "GitHub/GitLab repository URL"
    },
    "maintainer": {
      "type": "string",
      "description": "GitHub username or organization handle"
    },
    "tools": {
      "type": "array",
      "description": "List of MCP tool definitions provided by the server",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "inputSchema": { "type": "object" },
          "outputSchema": { "type": "object" }
        }
      }
    }
  }
}
