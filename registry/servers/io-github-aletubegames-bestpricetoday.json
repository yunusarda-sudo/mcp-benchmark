{
  "$schema": "../schema.json",
  "name": "io.github.aletubegames/bestpricetoday",
  "title": "BestPriceToday Deals",
  "category": "Developer Tools & DevOps",
  "description": "Brazilian marketplace deals feed (Mercado Livre/Amazon/Shopee) with price history, paid via x402",
  "repository": "https://github.com/aletubegames/bestpricetoday",
  "tools": [
    {
      "name": "deals_sample",
      "description": "Free tool: 3 real deals from today's catalog, no payment required. Use to test your MCP integration, then upgrade to the paid tools (deals_search/feed/top/history) for full results.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "deals_search",
      "description": "Multi-marketplace product search: Mercado Livre daily catalog plus live AliExpress and Shopee. $0.01 USDC per call.",
      "inputSchema": {
        "type": "object",
        "required": [
          "q"
        ],
        "properties": {
          "q": {
            "type": "string",
            "description": "Search query"
          },
          "marketplace": {
            "type": "string",
            "enum": [
              "all",
              "ml",
              "aliexpress",
              "shopee"
            ],
            "default": "all"
          },
          "limit": {
            "type": "integer",
            "default": 20
          },
          "x_payment": {
            "type": "string",
            "description": "PAYMENT-SIGNATURE value after paying the returned quote"
          }
        }
      }
    },
    {
      "name": "deals_feed",
      "description": "Daily-refreshed Brazilian deals catalog with optional filters. Up to 100 items. $0.01 USDC per call.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "min_price": {
            "type": "number"
          },
          "max_price": {
            "type": "number"
          },
          "limit": {
            "type": "integer",
            "default": 50
          },
          "x_payment": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "deals_top",
      "description": "Products ranked by discount vs their price history max. $0.01 USDC per call.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "default": 20
          },
          "x_payment": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "deal_history",
      "description": "Full recorded price series for a product by its ml_code. $0.01 USDC per call.",
      "inputSchema": {
        "type": "object",
        "required": [
          "ml_code"
        ],
        "properties": {
          "ml_code": {
            "type": "string"
          },
          "x_payment": {
            "type": "string"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.aletubegames/bestpricetoday",
    "version": "1.0.0",
    "remoteUrl": "https://api.alaserver.com.br/mcp",
    "publishedAt": "2026-11-27T15:42:02.122034Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "3c7deb6d00c1a18705be65fbc6381d9171e88a31ac4d4c1956dff15129ea1abb"
  }
}
