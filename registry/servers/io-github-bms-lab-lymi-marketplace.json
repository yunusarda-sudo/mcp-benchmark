{
  "$schema": "../schema.json",
  "name": "io.github.bms-lab/lymi-marketplace",
  "title": "LYMI Marketplace",
  "category": "AI, LLMs & Agents",
  "description": "Discover, test and purchase AI agents, automations and digital solutions from LYMI.",
  "tools": [
    {
      "name": "buy_product",
      "description": "Get a secure checkout link for a Lymi.io product, with the Basic, Standard or Premium package. Give the link to your human: they pay in seconds by card, PayPal, Apple Pay or Google Pay, and delivery starts right away.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Product id from search_marketplace"
          },
          "package": {
            "type": "string",
            "enum": [
              "basic",
              "standard",
              "premium"
            ]
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "request_custom_build",
      "description": "Ask the LYMI team to build a custom AI agent, automation, website, CRM or dashboard for a business. The team replies by email within 24 hours.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "need": {
            "type": "string",
            "description": "What the business needs, in plain words"
          }
        },
        "required": [
          "email",
          "need"
        ]
      }
    },
    {
      "name": "search_marketplace",
      "description": "Search AI agents, automations and AI services on the Lymi.io Marketplace. Returns id, title, price and link.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Keywords. Leave empty to list the most popular products."
          },
          "category": {
            "type": "string",
            "enum": [
              "prompts",
              "assistants",
              "mcp",
              "mini-apps",
              "models",
              "ecommerce",
              "marketing",
              "ai-agents",
              "automations",
              "agentic-ai",
              "saas",
              "raas",
              "gaas",
              "templates",
              "services",
              "websites",
              "dev-tools",
              "data",
              "design",
              "courses",
              "crm",
              "family",
              "kids"
            ]
          }
        }
      }
    },
    {
      "name": "get_product",
      "description": "Get the full details of one Lymi.io Marketplace product by its id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "try_agent",
      "description": "Send one test message to a Lymi.io agent and get its reply. Free demo, no account needed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "message"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.bms-lab/lymi-marketplace",
    "version": "1.0.0",
    "remoteUrl": "https://lymi.io/mcp",
    "publishedAt": "2026-11-25T14:47:14.798012Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "0baf8fe073620b30fbaed319368fed4a8da65175378ee974076a978b9f9f0097"
  }
}
