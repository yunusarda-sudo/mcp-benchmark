            "type": "string",
            "description": "amount_rub"
          },
          "ticker": {
            "type": "string",
            "description": "ticker"
          }
        },
        "required": [
          "amount_rub",
          "ticker"
        ]
      }
    },
    {
      "name": "acp_checkout",
