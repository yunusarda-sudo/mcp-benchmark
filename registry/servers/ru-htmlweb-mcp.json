{
  "$schema": "../schema.json",
  "name": "ru.htmlweb/mcp",
  "title": "htmlweb.ru — справочники и проверки для AI",
  "category": "Payments, CRM & Finance",
  "description": "RU API for AI agents: INN/OGRN, banks by BIC, geo by IP. Agents self-register, pay via x402.",
  "repository": "https://github.com/kdg22/mcp-htmlweb",
  "tools": [
    {
      "name": "register_agent",
      "description": "Создать api_key агента без регистрации на сайте. Без Authorization. До 2/сутки с IP; повтор с того же IP за день возвращает существующий ключ. Без бесплатной суточной квоты (adm=0).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Метка агента (опционально)"
          }
        },
        "required": []
      }
    },
    {
      "name": "api_catalog",
      "description": "Каталог штатного API: классы и pub_* (как /json/{obj}/help). Без obj — список классов; с obj — методы. Баланс: money/get_limit; пакет: money/set_limit.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "obj": {
            "type": "string",
            "description": "ai|calendar|convert|geo|mail|mnp|money|service|validator"
          }
        },
        "required": []
      }
    },
    {
      "name": "api_call",
      "description": "Вызов штатного REST: Get::apiParam → Class::pub_m. Эквивалент https://htmlweb.ru/json/{obj}/{m}. Баланс: obj=money m=get_limit; пакет с баланса: m=set_limit + set_limit=N.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "obj": {
            "type": "string",
            "description": "obj"
          },
          "m": {
            "type": "string",
            "description": "m"
          },
          "params": {
            "type": "string",
            "description": "JSON-объект прочих параметров метода (или передайте их плоско рядом с obj/m)"
          }
        },
        "required": [
          "obj",
          "m"
        ]
      }
    },
    {
      "name": "get_pricing",
      "description": "Тарифы, пакеты и commerce.json. Бесплатно.",
      "inputSchema": {
        "type": "object",
        "properties": [],
        "required": []
      }
    },
    {
      "name": "create_topup_card",
      "description": "Ссылка Robokassa для пополнения баланса ключа (3-D Secure). amount_rub мин. 50.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "amount_rub": {
            "type": "string",
            "description": "amount_rub"
          }
        },
