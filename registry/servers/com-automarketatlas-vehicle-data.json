  "description": "Used-car valuation and pricing trends by market, vehicle year, and mileage over REST and MCP.",
  "repository": "https://github.com/Joyall-au/automarket-atlas-examples",
  "tools": [
    {
      "name": "list_markets",
      "description": "List markets with prepared data, native currencies, sources, and snapshot dates.",
      "inputSchema": {
        "properties": {},
        "title": "list_marketsArguments",
        "type": "object"
      }
    },
    {
      "name": "find_vehicles",
      "description": "Find exact supported make, model, and year values before requesting an estimate.",
      "inputSchema": {
        "properties": {
          "country": {
            "title": "Country",
            "type": "string"
          },
          "query": {
            "default": "",
            "title": "Query",
            "type": "string"
          }
