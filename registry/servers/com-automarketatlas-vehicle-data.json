        ],
        "title": "market_trendsArguments",
        "type": "object"
      }
    },
    {
      "name": "estimate_vehicle",
      "description": "Get a comparable-listing valuation. Odometer input is in kilometers.\n\n    Guest requests are limited. An authenticated call uses a signup reward first,\n    then the prepaid USD balance. Supply max_charge_cents=0 for free-only use.\n    Keep request_id stable across retries. Only successful valuations use credit.\n    Follow error.next_action to create an account or get a hosted checkout link.\n    ",
      "inputSchema": {
        "properties": {
          "country": {
            "title": "Country",
            "type": "string"
          },
          "make": {
            "title": "Make",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "year": {
            "title": "Year",
            "type": "integer"
          },
          "mileage_km": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Mileage Km"
          },
          "fuel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Fuel"
          },
          "transmission": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Transmission"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Request Id"
          },
          "max_charge_cents": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Charge Cents"
          }
        },
        "required": [
          "country",
          "make",
          "model",
          "year"
        ],
        "title": "estimate_vehicleArguments",
        "type": "object"
      }
    },
    {
      "name": "account_status",
      "description": "Read remaining signup valuations and USD balance using the client's Bearer key.",
      "inputSchema": {
        "properties": {},
        "title": "account_statusArguments",
        "type": "object"
      }
    }
