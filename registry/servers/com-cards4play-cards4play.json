{
  "$schema": "../schema.json",
  "name": "com.cards4play/cards4play",
  "title": "Cards4Play",
  "category": "Other",
  "description": "Play Hearts, Spades, Euchre, Rook and more with friends or bots from your agent.",
  "repository": "https://github.com/mattdowell/cards4play-mcp",
  "tools": [
    {
      "name": "cards4play_list_games",
      "description": "List the games available to a Cards4Play agent.",
      "inputSchema": {
        "required": [],
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "cards4play_get_rules",
      "description": "Read a concise rules description for a supported game and rule set.",
      "inputSchema": {
        "required": [
          "game"
        ],
        "type": "object",
        "properties": {
          "game": {
            "type": "string",
            "enum": [
              "hearts",
              "spades",
              "ohhell",
              "whist",
              "euchre",
              "rook",
              "cribbage",
              "bridge"
            ]
          },
          "variant": {
            "type": "string",
            "description": "Optional rule set id from cards4play_list_games. Omit for the game's default."
          }
        }
      }
    },
    {
      "name": "cards4play_create_table",
      "description": "Create an invite-only table with the agent, its human owner, and the game's bots.",
      "inputSchema": {
        "required": [
          "game"
        ],
        "type": "object",
        "properties": {
          "game": {
            "type": "string",
            "enum": [
              "hearts",
              "spades",
              "ohhell",
              "whist",
              "euchre",
              "rook",
              "cribbage",
              "bridge"
            ]
          },
          "variant": {
            "type": "string",
            "description": "Optional rule set id from cards4play_list_games. Omit for the game's default."
          }
        }
      }
    },
    {
      "name": "cards4play_list_tables",
      "description": "List the agent's current and completed tables.",
      "inputSchema": {
        "required": [],
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "cards4play_get_state",
      "description": "Read the full agent-safe snapshot, stateVersion, legalActions, and expert advice.",
      "inputSchema": {
        "required": [
          "gameId"
        ],
        "type": "object",
        "properties": {
          "gameId": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "cards4play_get_advice",
      "description": "Read the expert strategy's recommended action for the agent's current turn.",
      "inputSchema": {
        "required": [
          "gameId"
        ],
        "type": "object",
        "properties": {
          "gameId": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "cards4play_autoplay",
      "description": "Play one agent turn using the expert strategy and return the new state.",
      "inputSchema": {
        "required": [
          "gameId"
        ],
        "type": "object",
        "properties": {
          "gameId": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "cards4play_accept_table",
      "description": "Accept a Cards4Play invitation to a table.",
      "inputSchema": {
        "required": [
          "gameId"
        ],
        "type": "object",
        "properties": {
          "gameId": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "cards4play_submit_action",
      "description": "Submit exactly one actionId from the current legalActions.",
      "inputSchema": {
        "required": [
          "gameId",
          "actionId",
          "expectedVersion",
          "idempotencyKey"
        ],
        "type": "object",
        "properties": {
          "gameId": {
            "type": "integer"
          },
          "actionId": {
            "type": "string"
          },
          "expectedVersion": {
            "type": "integer"
          },
          "idempotencyKey": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "cards4play_wait_for_turn",
      "description": "Wait up to 25 seconds for the agent's next turn or a table change.",
      "inputSchema": {
        "required": [
          "gameId"
        ],
        "type": "object",
        "properties": {
          "timeoutSeconds": {
            "maximum": 25,
            "minimum": 1,
            "type": "integer"
          },
          "gameId": {
            "type": "integer"
          }
        }
      }
    }
  ],
