{
  "$schema": "../schema.json",
  "name": "ro.builtin/startups",
  "title": "builtin.ro",
  "category": "Design, UI & 3D Media",
  "description": "Startups, founders and communities in Romania and Moldova: search them and read their pages.",
  "tools": [
    {
      "name": "search",
      "description": "Search startups, people with an idea and communities in Romania and Moldova. Answers with a list of results, each with an id to fetch, a title and a url to cite.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200,
            "description": "What to look for, in a few words or a question. A place, a field, or hiring, raising or cofounder in it narrows the search as county, industry or state would."
          },
          "kind": {
            "type": "string",
            "enum": [
              "auto",
              "startups",
              "communities"
            ],
            "description": "Which results to return. Default auto: both."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "Results in each list. Default 5."
          },
          "county": {
            "type": "string",
            "description": "A county's code, name or seat, like CJ, Cluj or Cluj-Napoca."
          },
          "state": {
            "type": "string",
            "enum": [
              "cofounder",
              "funding",
              "hiring"
            ],
            "description": "Only startups looking for a cofounder, raising money or hiring."
          },
          "industry": {
            "type": "string",
            "enum": [
              "AI / Software",
              "Fintech",
              "Healthtech",
              "Edtech",
              "Security",
              "Energy",
              "Mobility",
              "Logistics",
              "Agritech",
              "Proptech",
              "HR Tech",
              "Developer tools",
              "Hardware & Robotics",
              "E-commerce",
              "Marketplace",
              "Food & Beverage",
              "Manufacturing",
              "Fashion",
              "Tourism",
              "Other"
            ],
            "description": "Only startups of this field."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "fetch",
      "description": "A startup's, person's or community's page as Markdown, by the id a search gave.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "A page's path from a search, like /s/acme."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "ro.builtin/startups",
    "version": "1.0.0",
    "remoteUrl": "https://www.builtin.ro/mcp",
    "publishedAt": "2026-11-28T06:16:02.15298Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "1e6fc387b52afe22bac35c410802303bc69e35bbadc6f0f2bc848cddb62c0718"
  }
}
