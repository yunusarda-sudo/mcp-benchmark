{
 "$schema": "../schema.json",
 "name": "io.free3d/models",
 "category": "AI, LLMs & Agents",
 "description": "Search 100k+ 3D models; x402-gated downloads ($0.10, USDC)",
 "tools": [
  {
   "name": "search_models",
   "description": "Full-text search over the Free3D.io catalog (name, description, tags). Returns model ids — follow up with get_model_card for metadata or download_model (paid).",
   "inputSchema": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string",
      "description": "Search text, e.g. \"ikea chair\""
     },
     "limit": {
      "type": "integer",
      "description": "Max results, 1-25 (default 10)",
      "minimum": 1,
      "maximum": 25
     }
    },
    "required": [
     "query"
    ]
   }
  },
  {
   "name": "get_model_card",
   "description": "Public metadata card for one model: title, category, tags, formats, preview, canonical URL, license note. Same payload as GET /x402/card/{hash}.json.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "model_id": {
      "type": "string",
      "description": "8-char hex model id",
      "pattern": "^[0-9a-fA-F]{8}$"
     }
    },
    "required": [
     "model_id"
    ]
   }
  },
  {
   "name": "download_model",
   "description": "x402-gated download access, $0.10. Call without `payment` to get the offer (accepts: Base USDC via EIP-3009 gasless, or legacy on-chain USDC/USDT/PYUSD on Solana/Tron/EVM). Then retry with payment.payload (base64 PaymentPayload) or payment.tx_hash + payment.network. Returns access_token + download URL.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "model_id": {
      "type": "string",
      "description": "8-char hex model id",
      "pattern": "^[0-9a-fA-F]{8}$"
     },
     "payment": {
      "type": "object",
      "description": "Payment proof from the offer",
      "properties": {
       "payload": {
        "type": "string",
        "description": "base64 x402 PaymentPayload (EIP-3009, eip155:8453)"
       },
       "tx_hash": {
        "type": "string",
        "description": "on-chain tx hash (legacy transfer)"
       },
       "network": {
        "type": "string",
        "description": "base|ethereum|arbitrum|solana|tron"
       }
      }
     }
    },
    "required": [
     "model_id"
    ]
   }
  }
 ],
 "source": {
  "type": "registry",
  "registry": "registry.modelcontextprotocol.io",
  "name": "io.free3d/models",
  "version": "1.0.0",
  "remoteUrl": "https://free3d.io/mcp",
  "publishedAt": "2026-11-20T18:01:53.931878Z",
