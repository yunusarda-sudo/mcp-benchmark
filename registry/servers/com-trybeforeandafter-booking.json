{
  "$schema": "../schema.json",
  "name": "com.trybeforeandafter/booking",
  "title": "Before + After",
  "category": "E-Commerce & Retail",
  "description": "Find local service providers, see real prices and prepare a checkout the customer pays on.",
  "tools": [
    {
      "name": "search_offers",
      "description": "Search public fixed-total service offers (the treatment field takes a service type slug). No authorization needed. Prices are fixed totals in USD cents with a price_valid_until time.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "treatment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "max_price_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          },
          "provider_slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_offer",
      "description": "Read one public offer by service_id. No authorization needed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "service_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "provider_slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "service_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "find_services",
      "description": "Find providers that offer a service in a place, at any price basis: fixed total, per unit, diagnostic visit, estimate or quote. location is a market slug (atlanta, austin), a ZIP, a city or a county. Returns match (matched, no_provider_here, service_unrecognized), the canonical service, and each provider's matching services with their price basis, price, final_total (false: the amount is a base, with tax and/or conditional charges added; never quote it as the amount paid), tax, conditions and service page. A no-match is never filled with an unrelated service. No authorization needed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "location": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          }
        },
        "required": [
          "service",
          "location"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_services",
      "description": "Read one provider's complete public service catalog, optionally resolving q against its service vocabulary. Includes stable ids, descriptions, turnaround, price model, quantity basis, provenance, requestability and explicit unknowns. No authorization needed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "provider_slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "q": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "provider_slug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_service",
      "description": "Read one public service by provider_slug and stable service_id. Returns the same canonical detail the human page renders, plus a human URL and an action URL only when the service is requestable or sold at checkout. A service sold at checkout also carries checkout.booking: automatic (paying books the time and charges the total) or provider_accepts (charged when the provider accepts), and links.checkoutOffer for an exact priced total. No authorization needed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "provider_slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "service_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
          }
        },
        "required": [
          "provider_slug",
          "service_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_vehicle_offers",
      "description": "Read one provider's offers for one car (year, make, model): each offer's own page URL, title and price, the same the page and checkout use. Wheel repair is priced per wheel by wheel size; an oil change is an exact total for that car and oil package. booking is checkout (the page books and pays) or discuss_with_provider (no fixed price; the provider confirms first). No authorization needed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "provider_slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "year": {
            "type": "integer",
            "minimum": 1980,
            "maximum": 2099
          },
          "make": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^[^<>]+$"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^[^<>]+$"
          }
        },
        "required": [
          "provider_slug",
          "year",
          "make",
          "model"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "prepare_booking",
      "description": "Prepare a checkout link for the customer. No sign-in or grant needed. Returns checkout_url and booking_token. Nothing is booked or charged until the customer opens checkout_url and completes checkout on Before + After; the agent never handles payment. Keep booking_token secret and use it with get_booking_status. idempotency_key must be a fresh random secret (32+ characters); reusing it with the same input returns the same checkout.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "service_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
          },
          "provider_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"
          },
          "start_at": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40,
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-]\\d{2}:\\d{2})))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "live_slot",
              "preferred_time"
            ]
          },
          "expected_price_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 32,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]{32,128}$"
          }
        },
        "required": [
          "service_id",
          "provider_id",
          "mode",
          "expected_price_cents",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "prepare_checkout",
      "description": "Prepare one private, expiring link (handoff_url) that opens an exact checkout for the customer: provider, service and size or grade, quantity, car, drop-off time, drop-off or pickup, the price lines, total and terms, plus any name and email the customer authorized you to share. No sign-in or grant needed. Nothing is held, booked or charged; the customer reviews and pays with Apple Pay, Google Pay or a card. If the price, time or terms change before they pay, the page shows the change and asks them to confirm. Returns the transaction as priced now and what the customer still provides. idempotency_key must be a fresh random secret (32+ characters); reusing it with the same input returns the same link.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "provider_slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "service": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "size": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,40}$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "drop_off": {
            "type": "string",
            "maxLength": 40,
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-]\\d{2}:\\d{2})))$"
          },
          "grade": {
            "type": "string",
            "enum": [
              "synthetic_blend",
              "full_synthetic"
            ]
          },
          "vehicle": {
            "type": "object",
            "properties": {
              "year": {
                "type": "string",
                "pattern": "^(19[5-9]\\d|20\\d\\d)$"
              },
              "make": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "engine": {
                "type": "string",
                "maxLength": 40
              }
            },
            "required": [
              "year",
              "make",
              "model"
            ],
            "additionalProperties": false
          },
          "fulfillment": {
            "type": "string",
            "enum": [
              "drop_off",
              "pickup"
            ]
          },
          "customer": {
            "type": "object",
            "properties": {
              "first_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "last_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "email": {
                "type": "string",
                "maxLength": 200
              }
            },
            "additionalProperties": false
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 32,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]{32,128}$"
          }
        },
        "required": [
          "provider_slug",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "create_booking_request",
      "description": "Send a booking request for the authorized customer. This is a request, not a confirmed appointment. Reusing the same idempotency_key with the same input returns the same booking.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "service_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "provider_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "start_at": {
            "type": "string",
            "maxLength": 40,
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-]\\d{2}:\\d{2})))$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "live_slot",
              "preferred_time"
            ]
          },
          "expected_price_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]{16,128}$"
          },
          "contact_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "notes": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "service_id",
          "provider_id",
          "start_at",
          "mode",
          "expected_price_cents",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_booking_status",
      "description": "Read a booking's status. Send booking_token (from prepare_booking) alone, or, with the customer's agent grant as Authorization: Bearer, exactly one of booking_id or the idempotency_key used to create it. Never both authorities.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "booking_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^bnbk1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{43}$"
          },
          "booking_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]{16,128}$"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "cancel_booking",
      "description": "Cancel a booking. Send booking_token (from prepare_booking) with idempotency_key, or, with the customer's agent grant as Authorization: Bearer, booking_id with idempotency_key. Never both authorities. Repeating the same cancel returns the same result.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "booking_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^bnbk1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{43}$"
          },
          "booking_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]{16,128}$"
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "change_booking",
      "description": "Changing or rescheduling a booking is not supported and always returns unsupported_operation. Cancel and create a new request instead.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "booking_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "start_at": {
            "type": "string",
            "maxLength": 40,
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-]\\d{2}:\\d{2})))$"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "send_booking_feedback",
      "description": "After the customer finished checkout, tell Before + After how its booking tool worked for you (booking_tool: rating 1-5 and/or comment) and what you saw of the provider's side (provider_observation comment, and observed yes/no facts: confirmation_received, details_kept, provider_confirmed, provider_update_received, photos_received, checkout_completed). booking_token from prepare_booking is required and is the only authority. Never rate the provider's work and never include the customer's personal details. Sending again replaces what you sent. Only the Before + After team reads it; it never counts toward any provider's rating.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "booking_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^bnbk1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{43}$"
          },
          "booking_tool": {
            "type": "object",
            "properties": {
              "rating": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "comment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "additionalProperties": false
          },
          "provider_observation": {
            "type": "object",
            "properties": {
              "comment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "comment"
            ],
            "additionalProperties": false
          },
          "observed": {
            "type": "object",
            "properties": {
              "confirmation_received": {
                "type": "boolean"
              },
              "details_kept": {
                "type": "boolean"
              },
              "provider_confirmed": {
                "type": "boolean"
              },
              "provider_update_received": {
                "type": "boolean"
              },
              "photos_received": {
                "type": "boolean"
              },
              "checkout_completed": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "booking_token"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "report_checkout_problem",
      "description": "Tell Before + After where checkout got stuck: step (find_service, choose_option, choose_time, vehicle, contact_details, fulfillment, price, checkout_link, payment, other) and a plain-text comment on what went wrong. No authorization needed; add booking_token if you have one to tie the report to that checkout. Never include the customer's personal details. Only the Before + After team reads it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "enum": [
              "find_service",
              "choose_option",
              "choose_time",
              "vehicle",
              "contact_details",
              "fulfillment",
              "price",
              "checkout_link",
              "payment",
              "other"
            ]
          },
          "comment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "booking_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^bnbk1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "step",
          "comment"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
