   "inputSchema": {
    "type": "object",
    "properties": {
     "jobId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
     },
     "locationAddress": {
      "type": "object",
      "properties": {
       "street1": {
        "type": "string",
        "minLength": 1,
        "maxLength": 250
       },
       "street2": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
       },
       "city": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
       },
       "state": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
       },
       "country": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2,
        "pattern": "^[A-Z]{2}$"
       },
       "zipCode": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10
       }
      },
      "required": [
       "street1",
       "city",
       "state",
       "country",
       "zipCode"
      ],
      "additionalProperties": false
     }
    },
    "required": [
     "jobId",
     "locationAddress"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "companycam_find_projects",
   "description": "Find projects by name or street address, or list projects if query is omitted. Use meta.next_cursor as after for the next page.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
     },
     "after": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
