{
 "$schema": "../schema.json",
 "name": "ai.opsrev.roofing-ai/mcp",
 "title": "OpsRev Roofing AI",
 "category": "AI, LLMs & Agents",
 "description": "Connect roofing jobs, estimates, measurements, proposals, and field photos to AI assistants.",
 "tools": [
  {
   "name": "acculynx_list_jobs",
   "description": "List up to 25 jobs on one page, newest first. Use page 1 for recent jobs. Optionally filter by milestone.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
     },
     "milestones": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
     }
    },
    "required": [],
    "additionalProperties": false
   }
  },
  {
   "name": "acculynx_search_jobs",
   "description": "Find roofing jobs by customer, address, or job name. Use the returned job ID for detail calls.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
     }
    },
    "required": [
     "query"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "acculynx_get_job",
   "description": "Read one job by its AccuLynx job ID.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90,
      "pattern": "^[A-Za-z0-9_-]+$"
     }
    },
    "required": [
     "jobId"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "acculynx_get_estimates",
   "description": "Find estimate records for one known AccuLynx job.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90,
      "pattern": "^[A-Za-z0-9_-]+$"
     }
    },
    "required": [
     "jobId"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "acculynx_get_milestones",
   "description": "Read the milestone history for one known AccuLynx job.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "jobId": {
      "type": "string",
      "minLength": 1,
