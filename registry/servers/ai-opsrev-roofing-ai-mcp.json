     }
    },
    "required": [
     "jobId"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "acculynx_list_estimates",
   "description": "List up to 25 estimates on one page.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
     }
    },
    "required": [],
    "additionalProperties": false
   }
  },
  {
   "name": "acculynx_get_estimate",
   "description": "Read one estimate by its estimate ID.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "estimateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90,
      "pattern": "^[A-Za-z0-9_-]+$"
     }
    },
    "required": [
     "estimateId"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "acculynx_list_estimate_sections",
   "description": "List sections on one estimate.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "estimateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90,
      "pattern": "^[A-Za-z0-9_-]+$"
     }
    },
    "required": [
     "estimateId"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "acculynx_get_estimate_section",
   "description": "Read one section on an estimate.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "estimateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90,
      "pattern": "^[A-Za-z0-9_-]+$"
     },
     "sectionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90,
      "pattern": "^[A-Za-z0-9_-]+$"
     }
    },
    "required": [
     "estimateId",
     "sectionId"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "acculynx_list_estimate_items",
   "description": "List the items in one estimate section.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "estimateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90,
      "pattern": "^[A-Za-z0-9_-]+$"
     },
     "sectionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90,
      "pattern": "^[A-Za-z0-9_-]+$"
     }
    },
    "required": [
     "estimateId",
     "sectionId"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "acculynx_list_contact_types",
   "description": "Find the location-specific contact type IDs needed to create a contact.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
     }
    },
    "required": [],
    "additionalProperties": false
   }
  },
  {
   "name": "acculynx_list_job_contacts",
   "description": "Find the contacts linked to a known job, including their contact IDs.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "jobId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
     }
    },
    "required": [
     "jobId"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "acculynx_get_contact",
   "description": "Read a specific contact by ID, including email addresses and phone numbers.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "contactId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
     }
    },
    "required": [
     "contactId"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "acculynx_create_contact",
   "description": "Create a contact with the supplied name and company contact types. Use List AccuLynx contact types for the IDs. Confirm the details with the user before creating.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "firstName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
     },
     "lastName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
     },
     "companyName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
     },
     "contactTypeIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
       "type": "string",
       "minLength": 36,
       "maxLength": 36,
       "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
      }
     },
     "email": {
      "type": "string",
      "minLength": 1,
      "maxLength": 254,
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
     },
     "emailType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8,
      "enum": [
       "Personal",
       "Work",
       "Other"
      ]
     },
     "phone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "pattern": "^\\d{10}$"
     },
     "phoneType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6,
      "enum": [
       "Home",
       "Mobile",
       "Work"
      ]
     }
    },
    "required": [
     "firstName",
     "lastName",
     "contactTypeIds"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "acculynx_add_contact_note",
   "description": "Add an internal note to an existing contact. Confirm the contact and exact note with the user before saving.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "contactId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
     },
     "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
     }
    },
    "required": [
     "contactId",
     "note"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "acculynx_create_job",
   "description": "Create a new unassigned lead linked to an existing primary contact. Confirm the contact and job details with the user before creating.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "contactId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
     },
     "locationAddress": {
      "type": "object",
      "properties": {
       "street1": {
        "type": "string",
        "minLength": 1,
        "maxLength": 250
       },
       "street2": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
       },
       "city": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
       },
       "state": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
       },
       "country": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2,
        "pattern": "^[A-Z]{2}$"
       },
       "zipCode": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10
       }
      },
      "required": [
       "street1",
       "city",
       "state",
       "country",
       "zipCode"
      ],
      "additionalProperties": false
     },
     "priority": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6,
      "enum": [
       "Normal",
       "High",
       "Urgent"
      ]
     },
     "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
     }
    },
    "required": [
     "contactId"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "acculynx_set_job_priority",
   "description": "Set the priority on one existing job. Confirm the job and new priority with the user before saving.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "jobId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
     },
     "priority": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6,
      "enum": [
       "Normal",
       "High",
       "Urgent"
      ]
     }
    },
    "required": [
     "jobId",
     "priority"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "acculynx_update_job_address",
