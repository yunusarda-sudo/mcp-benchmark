{
  "$schema": "../schema.json",
  "name": "com.getscentai/fragrance-finder",
  "title": "ScentAI Fragrance Finder MCP",
  "category": "Vector DBs & AI Search",
  "description": "Search perfumes, fragrance notes, accords, and side-by-side scent comparisons on getscentai.com.",
  "repository": "https://github.com/yueliao11/mcp-servers",
  "tools": [
    {
      "name": "search_perfumes",
      "description": "Search perfumes, fragrance brands, scent notes, and accords in the ScentAI database on getscentai.com.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query (min 2 chars), e.g. 'Sauvage', 'Baccarat Rouge', 'vanilla', 'oud'."
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_perfume_details",
      "description": "Retrieve detailed fragrance profile (notes, accords, concentration, release year) by brandSlug and perfumeSlug.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "brandSlug": {
            "type": "string",
            "description": "Brand slug from search_perfumes (e.g., 'dior')."
          },
          "perfumeSlug": {
            "type": "string",
            "description": "Perfume slug from search_perfumes (e.g., 'sauvage')."
          }
        },
        "required": [
          "brandSlug",
          "perfumeSlug"
        ]
      }
    },
    {
      "name": "compare_perfumes",
      "description": "Compare two perfumes side-by-side by their brand/perfume slugs to analyze shared accords, overlapping notes, and key differences.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "brandSlugA": {
            "type": "string",
            "description": "Brand slug of first perfume."
          },
          "perfumeSlugA": {
            "type": "string",
            "description": "Perfume slug of first perfume."
          },
          "brandSlugB": {
            "type": "string",
            "description": "Brand slug of second perfume."
          },
          "perfumeSlugB": {
            "type": "string",
            "description": "Perfume slug of second perfume."
          }
        },
        "required": [
          "brandSlugA",
          "perfumeSlugA",
          "brandSlugB",
          "perfumeSlugB"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.getscentai/fragrance-finder",
    "version": "1.0.1",
    "remoteUrl": "https://getscentai.com/api/mcp",
    "publishedAt": "2026-11-22T00:58:42.9582Z",
    "fetchedAt": "2026-11-22T12:49:37.224Z",
