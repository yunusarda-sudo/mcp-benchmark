{
  "$schema": "../schema.json",
  "name": "com.iberimo/rentals",
  "title": "Iberimo",
  "category": "E-Commerce & Retail",
  "description": "Holiday rentals: search, prices for given dates and booking links.",
  "tools": [
    {
      "name": "find_destinations",
      "description": "Finds the places Poplidays rents holiday homes in (towns, resorts, regions) from a name. Returns their id, needed by search_rentals.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Place name, e.g. \"Val Thorens\" or \"Biarritz\".",
            "minLength": 2,
            "maxLength": 80
          },
          "language": {
            "type": "string",
            "default": "en",
            "description": "Language of the answer and of the links.",
            "enum": [
              "fr",
              "en",
              "es",
              "de"
            ]
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "search_rentals",
      "description": "Lists available holiday rentals in a destination for given dates and party, with the total price of the stay (mandatory fees included) and a link to book it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "destinationId": {
            "type": "integer",
            "description": "Id returned by find_destinations.",
            "minimum": 1
          },
          "arrival": {
            "type": "string",
            "description": "Arrival date, YYYY-MM-DD.",
            "format": "date"
          },
          "departure": {
            "type": "string",
            "description": "Departure date, YYYY-MM-DD.",
            "format": "date"
          },
          "adults": {
            "type": "integer",
            "default": 2,
            "minimum": 1,
            "maximum": 20
          },
          "children": {
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 15
          },
          "maxPrice": {
            "type": [
              "null",
              "integer"
            ],
            "default": null,
            "description": "Highest total price of the stay, in euros.",
            "minimum": 1
          },
          "features": {
            "type": "array",
            "default": [],
            "description": "Features every rental must have.",
            "items": {
              "type": "string",
              "enum": [
                "private-swimming-pool",
                "shared-swimming-pool",
                "jacuzzi",
                "sauna",
                "hammam",
                "pets-allowed",
                "disabled-access",
                "baby-bed",
                "foot-of-the-slopes",
                "seafront",
                "sea-view",
                "mountain-view",
                "lake-view",
                "garden",
                "terrace",
                "parking",
                "internet-access",
                "washing-machine",
                "dish-washer",
                "bed-linen-included",
                "towels-included",
                "cleaning-included"
              ]
            },
            "maxItems": 6,
            "uniqueItems": true
          },
          "rentalType": {
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "enum": [
              "house",
              "apartment",
              "chalet",
              "villa",
              "studio",
              "gite",
              "bed-and-breakfast",
              "mobil-home",
              "bungalow",
              "camping",
              "docked-boat"
            ]
          },
          "maxResults": {
            "type": "integer",
            "default": 5,
            "minimum": 1,
            "maximum": 10
          },
          "language": {
            "type": "string",
            "default": "en",
            "enum": [
              "fr",
              "en",
              "es",
              "de"
            ]
          }
        },
        "required": [
          "destinationId",
          "arrival",
          "departure"
        ]
      }
    },
    {
      "name": "get_rental",
      "description": "Describes one holiday rental: capacity, rooms, amenities, guest rating and latest reviews, location, indicative price per night and cancellation terms.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "rentalId": {
            "type": "integer",
            "description": "Id returned by search_rentals.",
            "minimum": 1
          },
          "language": {
            "type": "string",
            "default": "en",
            "enum": [
              "fr",
              "en",
              "es",
              "de"
            ]
          }
        },
        "required": [
          "rentalId"
        ]
      }
    },
    {
      "name": "get_quote",
      "description": "Prices a stay in one holiday rental for given dates and party: availability, total, discount, mandatory fees, cancellation terms, and the link to book it on the website.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "rentalId": {
            "type": "integer",
            "minimum": 1
          },
          "arrival": {
            "type": "string",
            "description": "Arrival date, YYYY-MM-DD.",
            "format": "date"
          },
          "departure": {
            "type": "string",
            "description": "Departure date, YYYY-MM-DD.",
            "format": "date"
          },
          "adults": {
            "type": "integer",
            "default": 2,
            "minimum": 1,
            "maximum": 20
          },
          "children": {
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 15
          },
          "language": {
            "type": "string",
            "default": "en",
            "enum": [
              "fr",
              "en",
              "es",
              "de"
            ]
          }
        },
        "required": [
          "rentalId",
          "arrival",
          "departure"
        ]
      }
    },
    {
      "name": "start_booking",
      "description": "Returns the website link that opens the rental with the dates and party filled in, where the traveller checks the price and books. Nothing is reserved until they do.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "rentalId": {
            "type": "integer",
            "minimum": 1
          },
          "arrival": {
            "type": "string",
            "description": "Arrival date, YYYY-MM-DD.",
            "format": "date"
          },
          "departure": {
            "type": "string",
            "description": "Departure date, YYYY-MM-DD.",
            "format": "date"
          },
          "adults": {
            "type": "integer",
            "default": 2,
            "minimum": 1,
            "maximum": 20
          },
          "children": {
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 15
          },
          "language": {
            "type": "string",
            "default": "en",
            "enum": [
              "fr",
              "en",
              "es",
              "de"
            ]
          }
        },
        "required": [
          "rentalId",
          "arrival",
          "departure"
        ]
      }
    },
    {
      "name": "get_availability",
      "description": "Lists the stays that can be booked in one holiday rental (arrival, departure, nights) between two dates, without prices. Use get_quote or find_cheapest_stay to price them.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "rentalId": {
            "type": "integer",
            "minimum": 1
          },
          "from": {
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "description": "First arrival date to consider, YYYY-MM-DD; today when omitted.",
            "format": "date"
          },
          "to": {
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "description": "Last arrival date to consider, YYYY-MM-DD; at most 92 days after from.",
            "format": "date"
          },
          "nights": {
            "type": [
              "null",
              "integer"
            ],
            "default": null,
            "description": "Only stays of exactly this many nights.",
            "minimum": 1,
            "maximum": 28
          }
        },
        "required": [
          "rentalId"
        ]
      }
    },
    {
      "name": "find_cheapest_stay",
      "description": "Prices the bookable stays of a given length in one rental between two dates and returns them cheapest first, with the link to book each. At most four stays are priced; when more exist, they are sampled evenly across the period.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "rentalId": {
            "type": "integer",
            "minimum": 1
          },
          "from": {
            "type": "string",
            "description": "First arrival date to consider, YYYY-MM-DD.",
            "format": "date"
          },
          "to": {
            "type": "string",
            "description": "Last arrival date to consider, YYYY-MM-DD; at most 92 days after from.",
            "format": "date"
          },
          "nights": {
            "type": "integer",
            "default": 7,
            "minimum": 1,
            "maximum": 28
          },
          "adults": {
            "type": "integer",
            "default": 2,
            "minimum": 1,
            "maximum": 20
          },
          "children": {
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 15
          },
          "language": {
            "type": "string",
            "default": "en",
            "enum": [
              "fr",
              "en",
              "es",
              "de"
            ]
          }
        },
        "required": [
          "rentalId",
          "from",
          "to"
        ]
      }
    },
    {
      "name": "last_minute_deals",
      "description": "Lists discounted rentals for a one-week stay starting next Saturday, optionally in one destination or by holiday theme, with the price of the week and a link to book it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "destinationId": {
            "type": [
              "null",
              "integer"
            ],
            "default": null,
            "description": "Id returned by find_destinations; anywhere when omitted.",
            "minimum": 1
          },
          "theme": {
            "type": [
              "null",
              "string"
            ],
            "default": null,
            "enum": [
              "sea",
              "mountain",
              "countryside",
              "city"
            ]
          },
          "adults": {
            "type": "integer",
            "default": 2,
            "minimum": 1,
            "maximum": 20
          },
          "children": {
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "maximum": 15
          },
          "maxResults": {
            "type": "integer",
            "default": 5,
            "minimum": 1,
            "maximum": 10
          },
          "language": {
            "type": "string",
            "default": "en",
            "enum": [
              "fr",
              "en",
              "es",
              "de"
            ]
          }
        }
      }
    },
    {
      "name": "compare_rentals",
      "description": "Sets two to four holiday rentals side by side: capacity, rooms, surface, amenities, rating, location and indicative price per night.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "rentalIds": {
            "type": "array",
            "description": "Ids returned by search_rentals.",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 4,
            "uniqueItems": true
          },
          "language": {
            "type": "string",
            "default": "en",
            "enum": [
              "fr",
              "en",
              "es",
              "de"
            ]
          }
        },
        "required": [
          "rentalIds"
        ]
      }
    },
    {
      "name": "get_destination_guide",
      "description": "Gives the Poplidays guide to a destination when one is written: overview and frequently asked questions (when to go, getting there, what to do).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "destinationId": {
            "type": "integer",
            "description": "Id returned by find_destinations.",
            "minimum": 1
          },
          "language": {
            "type": "string",
            "default": "en",
            "enum": [
              "fr",
              "en",
              "es",
              "de"
            ]
          }
        },
        "required": [
          "destinationId"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
