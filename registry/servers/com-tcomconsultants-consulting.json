{
  "$schema": "../schema.json",
  "name": "com.tcomconsultants/consulting",
  "title": "TcomConsultants.com",
  "category": "AI, LLMs & Agents",
  "description": "AI-ready websites, SEO and agent booking layers: services, prices, call times and quote requests.",
  "tools": [
    {
      "name": "search_site",
      "description": "Find pages about services, industries, cities, case studies, blog articles and glossary terms. Returns titles, summaries and URLs (with Markdown versions).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "e.g. \"AI-ready website\", \"SEO for law firms\", \"Toronto\""
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 8
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_page",
      "description": "Return the Markdown text of a TcomConsultants.com page. Accepts a full URL or a path such as /services/seo/.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "get_services_and_prices",
      "description": "Services offered, the $500 USD scoping-call / project retainer, partner membership prices, how booking works and the rules agents must follow.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "list_call_times",
      "description": "Open start times for the next 30 days. start is a Unix timestamp (UTC); iso is the same time in ISO 8601.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 10,
            "description": "How many days with open times to return"
          }
        }
      }
    },
    {
      "name": "request_call_booking",
      "description": "Hold a chosen time for 30 minutes and get the Stripe pay_url for the $500 USD retainer. Only call when the person explicitly asked to book. The call is booked only after the person pays at pay_url; you never take payment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "start": {
            "type": "integer",
            "description": "A start value from list_call_times"
          },
          "company": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "site": {
            "type": "string",
            "description": "Their website, if any"
          },
          "topic": {
            "type": "string",
            "enum": [
              "New website",
              "AI-ready website / AI search",
              "SEO",
              "Social media marketing",
              "AI agent or receptionist",
              "Directory, marketplace or app",
              "Ads, CRM and automation",
              "Something else"
            ]
          },
          "meeting": {
            "type": "string",
            "enum": [
              "Google Meet",
              "Zoom",
              "Phone call",
              "Microsoft Teams"
            ]
          },
          "notes": {
            "type": "string"
          },
          "tz": {
            "type": "string",
            "description": "IANA time zone of the person, e.g. Europe/London"
          },
          "agent": {
            "type": "string",
            "description": "Name of your assistant or app"
          },
          "consent": {
            "type": "string",
            "enum": [
              "yes"
            ],
            "description": "The person explicitly asked you to send this"
          },
          "dry": {
            "type": "boolean",
            "description": "Validate only; nothing is sent or held"
          }
        },
        "required": [
          "name",
          "email",
          "start",
          "consent"
        ]
      }
    },
    {
      "name": "request_quote",
      "description": "Send an enquiry to the team for a person who agreed to be contacted. kind=lead for a quote or free audit, kind=project to start a project (the person may then pay the $500 USD retainer at the returned pay_url; you never take payment).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "site": {
            "type": "string"
          },
          "need": {
            "type": "string",
            "enum": [
              "More leads",
              "Get named by AI",
              "New website",
              "Social media growth",
              "AI agent / receptionist",
              "App, directory or marketplace"
            ]
          },
          "message": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "budget": {
            "type": "string"
          },
          "timeline": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "lead",
              "project"
            ],
            "default": "lead"
          },
          "agent": {
            "type": "string",
            "description": "Name of your assistant or app"
          },
          "consent": {
            "type": "string",
            "enum": [
              "yes"
            ],
            "description": "The person explicitly asked you to send this"
          },
          "dry": {
            "type": "boolean",
            "description": "Validate only; nothing is sent or held"
          }
        },
        "required": [
          "name",
          "email",
          "consent"
        ]
      }
    },
    {
      "name": "apply_as_partner",
      "description": "Free application. Membership ($29.95/month or $299.95/year USD) is paid only after acceptance and gives priority access to briefs, not guaranteed work.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "skills": {
            "type": "string"
          },
          "portfolio": {
            "type": "string"
          },
          "linkedin": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "rate": {
            "type": "string"
          },
          "availability": {
            "type": "string"
          },
          "languages": {
            "type": "string"
          },
          "plan": {
            "type": "string",
            "enum": [
              "monthly",
              "yearly"
            ]
          },
          "message": {
            "type": "string"
          },
          "agent": {
            "type": "string",
            "description": "Name of your assistant or app"
          },
          "consent": {
            "type": "string",
            "enum": [
              "yes"
            ],
            "description": "The person explicitly asked you to send this"
          },
          "dry": {
            "type": "boolean",
            "description": "Validate only; nothing is sent or held"
          }
        },
        "required": [
          "name",
          "email",
          "consent"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
