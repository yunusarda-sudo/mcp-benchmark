{
  "$schema": "../schema.json",
  "name": "de.nameholder/mcp",
  "title": "Nameholder Domain Intelligence",
  "category": "Other",
  "description": "Search expired & auction domains across 9 markets with Wayback, DA, spam & brand valuation.",
  "tools": [
    {
      "name": "search_unified_pool",
      "description": "Search across auctions, expired, backorder, and buy_now domain pools aggregated from Nameholder, Sedo, Namecheap, Dynadot, Porkbun, NameSilo, GoDaddy, DropCatch, and Fragment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "Substring search query"
          },
          "pools": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "auctions",
                "expired",
                "backorder",
                "buy_now"
              ]
            },
            "description": "Filter by pool: auctions, expired, backorder, buy_now"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "nameholder",
                "sedo",
                "namecheap",
                "dynadot",
                "porkbun",
                "namesilo",
                "godaddy",
                "dropcatch",
                "fragment"
              ]
            },
            "description": "Filter by marketplace source"
          },
          "tlds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "TLD list e.g. ['com','de','ai']"
          },
          "minScore": {
            "type": "number",
            "description": "Minimum Brand Score (0-100)"
          },
          "minAuthority": {
            "type": "number",
            "description": "Minimum Domain Authority (0-100)"
          },
          "maxSpamScore": {
            "type": "number",
            "description": "Maximum Spam Score (0-100)"
          },
          "maxPrice": {
            "type": "number",
            "description": "Maximum price in EUR"
          },
          "maxLength": {
            "type": "number",
            "description": "Maximum domain stem length"
          },
          "sort": {
            "type": "string",
            "enum": [
              "karma_desc",
              "score_desc",
              "authority_desc",
              "price_asc",
              "price_desc",
              "age_desc",
              "length_asc",
              "added_desc"
            ]
          },
          "pageSize": {
            "type": "number",
            "description": "Results per page (1-50)"
          }
        }
      }
    },
    {
      "name": "check_domain_live",
      "description": "Run a live RDAP availability, lifecycle, and expiration check for a domain.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "FQDN to check, e.g. nordlicht.de"
          }
        },
        "required": [
          "domain"
        ]
      }
    },
    {
      "name": "enrich_domain_seo",
      "description": "Compute Wayback Machine CDX history sparkline, snapshot count, parking/redirect signals, Spam Score, Domain Authority, Backlinks estimate, and composite Karma Score.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "FQDN to enrich, e.g. flowdesk.io"
          },
          "live": {
            "type": "boolean",
            "description": "Whether to query live Wayback CDX API"
          }
        },
        "required": [
          "domain"
        ]
      }
    },
    {
      "name": "valuate_brand",
      "description": "Estimate market value in EUR (min/median/max and tier AAA-C) for a domain or handle.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Domain or handle name"
          },
          "assetType": {
            "type": "string",
            "enum": [
              "domain",
              "telegram_fragment",
              "whatsapp",
              "twitter",
              "instagram",
              "tiktok",
              "github"
            ]
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "create_batch_check_task",
      "description": "Submit a batch of up to 50 domains for availability, SEO enrichment, and brand valuation (enforces daily UTC quota).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of FQDNs (max 50)"
          }
        },
        "required": [
          "domains"
        ]
      }
    },
    {
      "name": "list_saved_filters",
      "description": "List saved search filters and alert subscriptions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "create_saved_filter_alert",
      "description": "Create a saved search filter over the unified pool and enable automated Inbox, Telegram, and Webhook alerts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Filter label"
          },
          "q": {
            "type": "string"
          },
          "pools": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "auctions",
                "expired",
                "backorder",
                "buy_now"
              ]
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "nameholder",
                "sedo",
                "namecheap",
                "dynadot",
                "porkbun",
                "namesilo",
                "godaddy",
                "dropcatch",
                "fragment"
              ]
            }
          },
          "tlds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minScore": {
            "type": "number"
          },
          "minAuthority": {
            "type": "number"
          },
          "maxSpamScore": {
            "type": "number"
          },
          "maxPrice": {
            "type": "number"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "get_drop_radar",
      "description": "Fetch top ranked dropping domains in the next 24h-72h ordered by urgency and valuation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Max items (default 15)"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "de.nameholder/mcp",
    "version": "1.0.0",
    "remoteUrl": "https://nameholder.de/api/mcp",
    "publishedAt": "2026-11-24T12:21:22.63286Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "a2538fa3424b27e26df48b6df85886ee082a7a86c5804cd33e3592cbaa9be8f2"
  }
}
