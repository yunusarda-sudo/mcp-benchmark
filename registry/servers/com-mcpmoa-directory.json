{
  "$schema": "../schema.json",
  "name": "com.mcpmoa/directory",
  "title": "MCP모아 — 한국 MCP 디렉토리",
  "category": "Security & Identity",
  "description": "Search 190+ Korean MCP servers with install configs and source-level security audits. Read-only.",
  "tools": [
    {
      "name": "search_servers",
      "description": "MCP모아에 등록된 한국 MCP 서버를 검색합니다. 검색어는 이름·설명·태그·연동 API(DART, data.go.kr, 기상청 등)에 대해 찾습니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 100,
            "description": "검색어(예: 법령, DART, 카카오, 부동산, hwp). 낱말을 공백으로 이어 쓰면 모두 포함된 서버만 찾습니다. 비우면 전체"
          },
          "category": {
            "type": "string",
            "enum": [
              "public-data",
              "finance",
              "law",
              "kakao-naver",
              "map-location",
              "weather",
              "commerce",
              "collaboration",
              "devtools"
            ],
            "description": "분야 slug로 거르기"
          },
          "official_only": {
            "type": "boolean",
            "description": "운영사 공식 서버만"
          },
          "safe_only": {
            "type": "boolean",
            "description": "보안 점검 '안전' 판정만"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_server",
      "description": "서버 한 개의 설명, 클라이언트별 설치 정보(claude_code 명령·claude_desktop·cursor), 설치 전 준비 단계, 필요한 환경변수, 보안 점검 결과(판정·데이터 흐름·유의사항)를 돌려줍니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "description": "search_servers 결과의 slug"
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_categories",
      "description": "MCP모아 분야(공공데이터·금융·법률 등)와 분야별 서버 수, 전체 보안 점검 요약을 돌려줍니다.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "list_global_official",
      "description": "노션·깃허브·피그마 등 해외 서비스가 직접 운영하는 공식 MCP의 연결 방법과 주의점을 한국어로 돌려줍니다(한국 MCP 목록과 별도).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 100,
            "description": "서비스 이름(예: notion, github)"
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.mcpmoa/directory",
    "version": "1.0.0",
    "remoteUrl": "https://mcpmoa.com/api/mcp",
    "publishedAt": "2026-11-18T22:08:34.79302Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "f79c7c6cb42b0bcda61053bcfef4fd9ecffe03360a1d2d644000cd784f60ad20"
  }
}
