{
  "$schema": "../schema.json",
  "name": "io.github.MyDramaDB/mydramadb",
  "title": "MyDramaDB Korean Drama Data",
  "category": "Developer Tools & DevOps",
  "description": "Look up a Korean drama by title, find out who played a character, or check an actor's other credits.",
  "repository": "https://github.com/MyDramaDB/mydramadb-mcp",
  "tools": [
    {
      "name": "search_dramas",
      "description": "Find drama titles, aliases, remakes, people or shows matching genre/year filters. Resolve ambiguity before using a slug.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "q": {
            "default": "",
            "type": "string",
            "maxLength": 120
          },
          "kind": {
            "default": "shows",
            "type": "string",
            "enum": [
              "all",
              "shows",
              "people"
            ]
          },
          "year": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?:19|20|21)[0-9]{2}$|^2200$"
              },
              {
                "minItems": 1,
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?:19|20|21)[0-9]{2}$|^2200$"
                }
              }
            ]
          },
          "genre": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              {
                "minItems": 1,
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                }
              }
            ]
          },
          "genreMatch": {
            "default": "any",
            "type": "string",
            "enum": [
              "any",
              "all"
            ]
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "airing",
                  "upcoming",
                  "completed",
                  "cancelled",
                  "unknown"
                ]
              },
              {
                "minItems": 1,
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "airing",
                    "upcoming",
                    "completed",
                    "cancelled",
                    "unknown"
                  ]
                }
              }
            ]
          },
          "workType": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "television_series",
                  "web_series",
                  "film",
                  "television_special",
                  "short_film",
                  "other",
                  "unknown"
                ]
              },
              {
                "minItems": 1,
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "television_series",
                    "web_series",
                    "film",
                    "television_special",
                    "short_film",
                    "other",
                    "unknown"
                  ]
                }
              }
            ]
          },
          "hasSubtitles": {
            "type": "string",
            "const": "true"
          },
          "sort": {
            "type": "string",
            "enum": [
              "released",
              "recent",
              "title",
              "year",
              "relevance"
            ]
          },
          "page": {
            "default": 1,
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 6000
              },
              {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]{0,6})$"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_drama",
      "description": "Get published drama facts and sources. Plot prose is withheld by default; use spoiler options only with user permission.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "spoilerPolicy": {
            "default": "none",
            "type": "string",
            "enum": [
              "none",
              "through_episode",
              "all"
            ]
          },
          "throughSeason": {
            "default": 1,
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 20000
              },
              {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]{0,6})$"
              }
            ]
          },
          "throughEpisode": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 20000
              },
              {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]{0,6})$"
              }
            ]
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      }
    },
