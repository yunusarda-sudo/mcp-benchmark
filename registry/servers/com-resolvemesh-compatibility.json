{
  "$schema": "../schema.json",
  "name": "com.resolvemesh/compatibility",
  "title": "ResolveMesh Registry Search and Compatibility",
  "category": "Developer Tools & DevOps",
  "description": "Search the MCP Registry for a capability, check client compatibility, and read approved changes.",
  "tools": [
    {
      "name": "find_tool",
      "description": "Search the official MCP Registry for servers that provide a capability your current tools lack. Describe the capability in a few words. Do not include prompts, user data, or secrets. Results are registry listings; ResolveMesh has not tested or approved them.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200,
            "description": "The capability you need, in a few plain words. No prompts, user data, or secrets."
          },
          "client": {
            "description": "Your client, to label which connections its transports support.",
            "type": "string",
            "enum": [
              "chatgpt-web",
              "chatgpt-desktop",
              "claude-code",
              "cursor",
              "codex",
              "gemini-cli",
              "vs-code",
              "windsurf",
              "copilot-coding-agent"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "compatibility_lookup",
      "description": "Return the source-backed ResolveMesh compatibility result for one allowlisted client and hosted-tool pair.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "client": {
            "type": "string",
            "enum": [
              "chatgpt-web",
              "chatgpt-desktop",
              "claude-code",
              "cursor",
              "codex",
              "gemini-cli",
              "vs-code",
              "windsurf",
              "copilot-coding-agent"
            ]
          },
          "tool": {
            "type": "string",
            "enum": [
              "github",
              "linear",
              "figma",
              "notion",
              "atlassian",
              "stripe",
              "supabase",
              "sentry",
              "vercel",
              "neon"
            ]
          }
        },
        "required": [
          "client",
          "tool"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "compatibility_changes",
      "description": "Return cursor-paginated, approved ResolveMesh compatibility events using the same allowlisted filters as the public JSON API.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "client": {
            "type": "string",
            "enum": [
              "chatgpt-web",
              "chatgpt-desktop",
              "claude-code",
              "cursor",
              "codex",
              "gemini-cli",
              "vs-code",
              "windsurf",
              "copilot-coding-agent"
            ]
          },
          "cursor": {
            "type": "string",
            "maxLength": 2048
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "severity": {
            "type": "string",
            "enum": [
              "INFORMATIONAL",
              "ACTION_REQUIRED",
              "BREAKING"
            ]
          },
          "since": {
            "type": "string"
          },
          "tool": {
            "type": "string",
            "enum": [
              "github",
              "linear",
              "figma",
              "notion",
              "atlassian",
              "stripe",
              "supabase",
              "sentry",
              "vercel",
              "neon"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.resolvemesh/compatibility",
    "version": "0.2.0",
    "remoteUrl": "https://resolvemesh.com/mcp/public",
    "publishedAt": "2026-11-24T01:03:06.556086Z",
    "fetchedAt": "2026-11-24T12:15:48.059Z",
    "toolsSha256": "7be71e2c4fe025bc55675471fbd092fc7b64f1ce66c32efed685a924dfdc99fd"
  }
}
