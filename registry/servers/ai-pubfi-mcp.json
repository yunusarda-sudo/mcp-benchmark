{
  "$schema": "../schema.json",
  "name": "ai.pubfi/mcp",
  "title": "PubFi MCP",
  "category": "Travel, Maps & Navigation",
  "description": "Use MCP 2026-07-28 discovery or 2025-11-25 initialize to list and execute PubFi routes.",
  "repository": "https://github.com/helixbox/pubfi-docs",
  "tools": [
    {
      "name": "pubfi.capabilities.list",
      "description": "Enumerate the complete installed Registry v2 catalog as deterministic compact pages. The server does not rank, infer intent, or choose a capability.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 50,
            "description": "Maximum compact capability summaries to return."
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Opaque generation-bound cursor returned by the preceding page."
          },
          "provider_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9](?:[a-z0-9]|-(?!-))*[a-z0-9]$|^[a-z0-9]$",
            "description": "Optional exact public provider key. This is a static filter, not semantic search."
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST"
            ]
          }
        }
      }
    },
    {
      "name": "pubfi.capabilities.get",
      "description": "Return the full typed request, response, metering, and readiness contract for one exact capability id from the installed Registry generation.",
      "inputSchema": {
        "type": "object",
        "required": [
          "capability_id"
        ],
        "additionalProperties": false,
        "properties": {
          "capability_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$",
            "description": "Exact capability id returned by pubfi.capabilities.list."
          }
        }
      }
    },
    {
      "name": "pubfi.route.execute",
      "description": "Execute one exact GET or POST path through the authenticated PubFi account lane and the same Registry v2 matcher and typed executor as the HTTP gateway. Append :free only when the capability catalog publishes that exact account-scoped free variant.",
      "inputSchema": {
        "type": "object",
        "required": [
          "raw_path",
          "method"
        ],
        "additionalProperties": false,
        "properties": {
          "raw_path": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2048,
            "pattern": "^/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._~-]{1,128}(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._~-]{1,128}){0,63}$",
            "description": "Exact original URI path consumed by the Registry matcher. Segments use canonical unreserved ASCII only; percent escapes, dot segments, query, fragment, and backslash are forbidden."
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST"
            ]
          },
          "query": {
            "type": "string",
            "maxLength": 65536,
            "pattern": "^(?!\\?)[\\x20-\\x7E]*$",
            "description": "Exact ASCII raw query string without a leading question mark."
          },
          "body": {
            "type": "string",
            "maxLength": 1048576,
            "pattern": "^[\\x20-\\x7E]*$",
            "description": "Exact optional ASCII request-body bytes. For JSON routes, supply one compact serialized JSON document rather than a nested MCP argument value."
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[\\x20-\\x7E]+$"
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[\\x20-\\x7E]+$"
          }
        }
      }
    },
    {
      "name": "pubfi.substrate.runtime_upgrade.verify",
      "description": "Verify one reviewed Substrate System.apply_authorized_upgrade extrinsic through the authenticated account lane. Supply the expected Blake2b-256 hash of the FRAME System AuthorizedUpgrade code payload, not the active :code hash at the apply block. The server streams and discards provider runtime code, persists only a compact proof, and returns independent comparison evidence.",
      "inputSchema": {
        "type": "object",
        "required": [
          "network",
          "expected_authorized_code_hash"
        ],
        "oneOf": [
          {
            "required": [
              "extrinsic_index"
            ],
            "not": {
              "required": [
                "extrinsic_hash"
              ]
            }
          },
          {
            "required": [
              "extrinsic_hash"
            ],
            "not": {
              "required": [
                "extrinsic_index"
              ]
            }
          }
        ],
        "additionalProperties": false,
        "properties": {
          "network": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
          },
          "extrinsic_index": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^(?:0|[1-9][0-9]*)-(?:0|[1-9][0-9]*)$"
          },
          "extrinsic_hash": {
            "type": "string",
            "minLength": 66,
            "maxLength": 66,
            "pattern": "^0x[0-9a-f]{64}$",
            "description": "Canonical lowercase 0x-prefixed 32-byte hash."
          },
          "expected_authorized_code_hash": {
            "type": "string",
            "minLength": 66,
            "maxLength": 66,
            "pattern": "^0x[0-9a-f]{64}$",
            "description": "Canonical lowercase 0x-prefixed 32-byte hash."
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[\\x20-\\x7E]+$"
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[\\x20-\\x7E]+$"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "ai.pubfi/mcp",
    "version": "0.3.23",
    "remoteUrl": "https://mcp.pubfi.ai/",
    "publishedAt": "2026-11-27T16:46:18.241516Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "b83a298021a84091225f34be63f1ec32c9cca34d0d656ac2ed57da5aa3acd5eb"
  }
}
