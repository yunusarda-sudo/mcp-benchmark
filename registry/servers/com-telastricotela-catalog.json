{
  "$schema": "../schema.json",
  "name": "com.telastricotela/catalog",
  "title": "Telas Tricotela Catalog",
  "category": "E-Commerce & Retail",
  "description": "Cotton fabrics and sewing supplies for patchwork and creative sewing. Read-only shop catalog.",
  "tools": [
    {
      "name": "search_products",
      "description": "Busca productos públicos por texto o filtros. Prioriza referencias exactas de producto, Tilda o combinación y usa disponibilidad sincronizada.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 120
          },
          "filters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "category_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "minimum_cut_mm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295,
                "description": "Exact product minimum cut in millimetres (25 cm = 250). Products without a numeric minimum cut do not match."
              },
              "brand": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "composition": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "format": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "collection": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "width_mm": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                }
              },
              "color": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            },
            "required": []
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10
          },
          "cursor": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": [],
        "anyOf": [
          {
            "required": [
              "query"
            ],
            "properties": {
              "query": {
                "pattern": "\\S"
              }
            }
          },
          {
            "required": [
              "filters"
            ],
            "properties": {
              "filters": {
                "minProperties": 1
              }
            }
          }
        ]
      }
    },
    {
      "name": "get_product",
      "description": "Consulta la ficha y sus variantes con disponibilidad sincronizada. El PVP es informativo y corresponde al producto. El precio final puede variar según la combinación o la longitud personalizada.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "variants_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 25
          },
          "variants_cursor": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": [
          "product_id"
        ]
      }
    },
    {
      "name": "get_product_availability",
      "description": "Consulta disponibilidad actual en PrestaShop. Omite combination_id para obtener el estado agregado del producto, o indica el ID entero de la variante para consultarla. Un estado general in_stock no confirma la disponibilidad de una variante ni de un corte personalizado. unknown no confirma ni descarta que se pueda servir la longitud solicitada.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "combination_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        },
        "required": [
          "product_id"
        ]
      }
    },
    {
      "name": "get_store_information",
      "description": "Read the official Telas Tricotela store document for its specialization, shipping, pickup, payment and returns policies, and links to store information.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
