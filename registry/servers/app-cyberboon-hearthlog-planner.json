{
  "$schema": "../schema.json",
  "name": "app.cyberboon/hearthlog-planner",
  "title": "HearthLog Home Maintenance Planner",
  "category": "Other",
  "description": "Deterministic 12-month home-maintenance plans from coarse home attributes.",
  "tools": [
    {
      "name": "generate_home_plan",
      "description": "Create a free, anonymous 12-month home maintenance plan and get a shareable plan code. No account, email or address is collected. Plans expire after 30 days.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "place_type": {
            "default": "detached",
            "description": "detached, townhouse, apartment, office, school or other",
            "type": "string",
            "enum": [
              "detached",
              "townhouse",
              "apartment",
              "office",
              "school",
              "other"
            ]
          },
          "climate": {
            "default": "temperate",
            "description": "cold, temperate, hot_dry or hot_humid; ignored for office/school/other",
            "type": "string",
            "enum": [
              "cold",
              "temperate",
              "hot_dry",
              "hot_humid"
            ]
          },
          "tenure": {
            "default": "owner",
            "description": "owner or renter",
            "type": "string",
            "enum": [
              "owner",
              "renter"
            ]
          },
          "heating": {
            "default": "unknown",
            "description": "gas, oil, electric, heat_pump, none or unknown",
            "type": "string",
            "enum": [
              "gas",
              "oil",
              "electric",
              "heat_pump",
              "none",
              "unknown"
            ]
          },
          "age_band": {
            "default": "unknown",
            "description": "new, recent, older or unknown",
            "type": "string",
            "enum": [
              "new",
              "recent",
              "older",
              "unknown"
            ]
          },
          "country": {
            "description": "Optional ISO 3166-1 alpha-2 country code",
            "type": "string",
            "pattern": "^[A-Za-z]{2}$"
          },
          "locale": {
            "default": "en",
            "description": "One of the 13 supported locales",
            "type": "string",
            "enum": [
              "en",
              "tr",
              "de",
              "es",
              "fr",
              "it",
              "pt-BR",
              "pt-PT",
              "nl",
              "pl",
              "sv",
              "ja",
              "ko"
            ]
          },
          "name": {
            "description": "Optional plan title shown only in the immediate response; never stored",
            "type": "string",
            "maxLength": 60
          }
        }
      }
    },
    {
      "name": "get_plan",
      "description": "Read a plan by its 8-character code, optionally in any supported locale. Unknown or expired codes return a tool error.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16,
            "description": "The 8-character plan code"
          },
          "locale": {
            "description": "Optional response locale; defaults to the plan's stored locale",
            "type": "string",
            "enum": [
              "en",
              "tr",
              "de",
              "es",
              "fr",
              "it",
              "pt-BR",
              "pt-PT",
              "nl",
              "pl",
              "sv",
              "ja",
              "ko"
            ]
          }
        },
        "required": [
          "code"
        ]
      }
    },
    {
      "name": "get_planner_info",
      "description": "List supported place types, climates, locales, tools and the public plan URL pattern.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "app.cyberboon/hearthlog-planner",
    "version": "1.0.1",
    "remoteUrl": "https://homemaintain-mcp.cyberboon.app/mcp",
    "publishedAt": "2026-11-27T20:53:44.476565Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "b0691a3fc67491939bd231d0ddd45d429496f6f0d5aa0fc5d5303317dd80233f"
  }
}
