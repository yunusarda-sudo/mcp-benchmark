{
  "$schema": "../schema.json",
  "name": "S3 MinIO MCP",
  "category": "Developer Tools & VCS",
  "description": "S3 MinIO MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "get_s3_object",
      "description": "Download object from Amazon S3 or MinIO bucket by key name.",
      "inputSchema": {
        "type": "object",
        "required": [
          "bucket",
          "key"
        ],
        "properties": {
          "bucket": {
            "type": "string",
            "description": "Target S3 bucket name."
          },
          "key": {
            "type": "string",
            "description": "Object storage key path."
          }
        }
      }
    }
  ]
}
