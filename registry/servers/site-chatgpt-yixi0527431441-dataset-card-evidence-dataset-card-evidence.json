{
  "$schema": "../schema.json",
  "name": "site.chatgpt.yixi0527431441.dataset-card-evidence/dataset-card-evidence",
  "title": "Dataset Card Evidence",
  "category": "AI, LLMs & Agents",
  "description": "Compare Hugging Face dataset license labels and access gates across two revision snapshots.",
  "tools": [
    {
      "name": "compare_card_revisions",
      "description": "Compare two caller-supplied evidence snapshots of the same Hugging Face dataset. Returns exact label and gate changes with source revision links. Runs without network access.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "before",
          "after"
        ],
        "properties": {
          "before": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dataset",
              "revision",
              "cardLicenses",
              "accessGate"
            ],
            "properties": {
              "dataset": {
                "type": "string",
                "description": "Hub dataset ID"
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "cardLicenses": {
                "type": "array",
                "maxItems": 24,
                "items": {
                  "type": "string"
                }
              },
              "accessGate": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "manual",
                      "auto"
                    ]
                  }
                ]
              }
            }
          },
          "after": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dataset",
              "revision",
              "cardLicenses",
              "accessGate"
            ],
            "properties": {
              "dataset": {
                "type": "string",
                "description": "Hub dataset ID"
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "cardLicenses": {
                "type": "array",
                "maxItems": 24,
                "items": {
                  "type": "string"
                }
              },
              "accessGate": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "manual",
                      "auto"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "name": "sample_dataset_report",
      "description": "Return a dated report from three public datasets with pinned card links.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "describe_dataset_audit",
      "description": "Return batch endpoint availability, input schema, protocol and price.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ],
