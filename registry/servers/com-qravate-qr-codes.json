    },
    {
      "name": "set_gs1_product",
      "description": "Rattache le GTIN d’un produit (code EAN) à un QR code dynamique, avec des liens par usage (fiche produit, rappel, notice, allergènes, passeport numérique…) et par langue : le QR suit alors la norme GS1 Digital Link, lisible en caisse dès 2027. L’adresse encodée change : il faut retélécharger le code avant d’imprimer. remove=true retire le produit. Plans Pro et Max. Nécessite l’accès en écriture.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "qr": {
            "type": "string"
          },
          "gtin": {
            "description": "GTIN de 8, 12, 13 ou 14 chiffres, attribué par GS1 (le nombre sous le code-barres).",
            "type": "string"
          },
          "links": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Type GS1 : gs1:pip, gs1:recallStatus, gs1:instructions, gs1:allergenInfo, gs1:nutritionalInfo, gs1:ingredientsInfo, gs1:dpp, gs1:defaultLinkMulti (avec lang)…"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "lang": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 2
                },
                "title": {
                  "type": "string",
                  "maxLength": 120
                }
              },
              "required": [
                "type",
                "url"
              ]
            }
          },
          "forward": {
            "description": "Transmettre lot, série et date limite à la page ouverte.",
            "type": "boolean"
          },
          "remove": {
            "type": "boolean"
          }
        },
        "required": [
          "qr"
        ]
      }
    },
    {
      "name": "update_destination",
      "description": "Change la destination d’un QR code dynamique (effective en une minute environ). Nécessite l’accès en écriture.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "qr": {
            "type": "string"
          },
          "destination": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "qr",
          "destination"
        ]
      }
    },
    {
      "name": "rename_qr_code",
      "description": "Change le nom d’un QR code, celui qui sert à s’y retrouver dans l’espace et les statistiques. Le code imprimé et sa destination ne changent pas. Nécessite l’accès en écriture.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "qr": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Nouveau nom, par exemple « Menu terrasse été »."
          }
        },
        "required": [
          "qr",
          "name"
        ]
      }
    },
    {
      "name": "set_redirect_rules",
      "description": "Remplace les règles de redirection d’un QR code (liste ordonnée : la première règle active dont toutes les conditions sont remplies l’emporte ; sinon, destination principale). Conditions : device, os, app, lang, country, weekday (1 = lundi), time { from, to } en HH:MM, date { from, to } en AAAA-MM-JJ. Plusieurs destinations avec weight (somme 100) font un test A/B. Plans Pro et Max. Une liste vide retire les règles. Nécessite l’accès en écriture.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "qr": {
            "type": "string"
          },
          "rules": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 60
                },
                "active": {
                  "type": "boolean"
                },
                "when": {
                  "default": {},
                  "type": "object",
                  "properties": {
                    "device": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "mobile",
                          "tablet",
                          "desktop"
                        ]
                      }
                    },
                    "os": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "ios",
                          "android",
                          "windows",
                          "macos",
