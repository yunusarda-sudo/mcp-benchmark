{
  "$schema": "../schema.json",
  "name": "com.qravate/qr-codes",
  "title": "QRavate QR codes",
  "category": "Design, UI & 3D Media",
  "description": "Manage your QRavate dynamic QR codes: create, edit destinations and designs, read scan stats.",
  "tools": [
    {
      "name": "list_design_options",
      "description": "Liste les styles prêts à porter, les icônes à placer au centre (Wi-Fi, menu, avis, PDF, vidéo…), les formes et les cadres utilisables dans le paramètre design des outils de création.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "create_static_qr_code",
      "description": "Crée un QR code statique (Wi-Fi, texte, e-mail, téléphone, SMS, vCard ou URL figée). Il ne se modifie pas après impression et ne compte pas les scans : pour un lien qu’on voudra changer ou mesurer, préférez create_qr_code. Les données ne sont pas conservées par QRavate.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "url",
              "text",
              "email",
              "tel",
              "sms",
              "wifi",
              "vcard"
            ]
          },
          "url": {
            "description": "type url : adresse.",
            "type": "string"
          },
          "text": {
            "description": "type text : texte.",
            "type": "string",
            "maxLength": 1000
          },
          "email": {
            "description": "type email : destinataire.",
            "type": "string"
          },
          "subject": {
            "type": "string",
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "maxLength": 1000
          },
          "phone": {
            "description": "types tel et sms : numéro.",
            "type": "string"
          },
          "message": {
            "description": "type sms : message.",
            "type": "string",
            "maxLength": 500
          },
          "ssid": {
            "description": "type wifi : nom du réseau.",
            "type": "string",
            "maxLength": 64
          },
          "password": {
            "description": "type wifi : mot de passe.",
            "type": "string",
            "maxLength": 64
          },
          "security": {
            "type": "string",
            "enum": [
              "WPA",
              "WEP",
              "nopass"
            ]
          },
          "firstName": {
            "description": "type vcard.",
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "website": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "design": {
            "type": "object",
            "properties": {
              "preset": {
                "description": "Style prêt à porter : Classique, Vermillon, Soirée, Bouteille, Lagon, Kraft, Minuit. Les autres réglages le complètent.",
                "type": "string",
                "enum": [
                  "Classique",
                  "Vermillon",
                  "Soirée",
                  "Bouteille",
                  "Lagon",
                  "Kraft",
                  "Minuit"
                ]
              },
              "color": {
                "description": "Couleur du code (modules). Foncée, sur un fond clair.",
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "background": {
                "description": "Couleur du fond. Claire.",
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "eye_color": {
                "description": "Couleur des trois repères des coins, et de l’icône.",
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "gradient_to": {
                "description": "Seconde couleur pour un dégradé sur les modules.",
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "module_shape": {
                "type": "string",
                "enum": [
                  "square",
                  "rounded",
                  "dot",
                  "diamond",
                  "stripes",
                  "fluid"
                ]
              },
              "eye_shape": {
                "type": "string",
                "enum": [
                  "square",
                  "rounded",
                  "circle",
                  "leaf"
                ]
              },
              "icon": {
                "description": "Logo prédéfini au centre : un identifiant de list_design_options (wifi, menu, coffee, wine, star, thumbs-up, heart, message, phone, mail, map-pin, calendar…), « auto » pour le choisir d’après le nom et la destination, ou « none ».",
                "type": "string"
              },
              "brand_logo": {
                "description": "Logo de marque au centre, à la couleur de la marque : instagram, facebook, whatsapp, tiktok, youtube, x, google, googlemaps, apple, spotify, pinterest, snapchat, threads, tripadvisor, airbnb, bookingdotcom, ubereats, deliveroo, paypal, etsy, vinted. Seulement pour renvoyer vers une page sur ce réseau ou ce service.",
                "type": "string",
                "enum": [
                  "instagram",
                  "facebook",
                  "whatsapp",
                  "tiktok",
                  "youtube",
                  "x",
                  "google",
                  "googlemaps",
                  "apple",
                  "spotify",
                  "pinterest",
                  "snapchat",
                  "threads",
                  "tripadvisor",
                  "airbnb",
                  "bookingdotcom",
                  "ubereats",
                  "deliveroo",
                  "paypal",
                  "etsy",
                  "vinted"
                ]
              },
              "logo_url": {
                "description": "Adresse publique d’un logo (PNG, JPG ou SVG, 2 Mo max), placé au centre. Prioritaire sur le logo de marque et l’icône.",
                "type": "string",
                "format": "uri"
              },
              "frame_text": {
                "description": "Texte d’appel dans un cadre, par exemple « Voir le menu ». Vide : sans cadre.",
                "type": "string",
                "maxLength": 40
              },
              "frame_style": {
                "description": "Forme du cadre : bottom (bandeau dessous), top, box, badge, none.",
                "type": "string",
                "enum": [
                  "none",
                  "bottom",
                  "top",
                  "box",
                  "badge"
                ]
              }
            },
            "description": "Apparence du QR code. Tout est facultatif : sans design, le code est noir sur blanc."
          }
        },
        "required": [
          "type"
        ]
      }
    },
    {
      "name": "get_account",
      "description": "Plan de l’espace connecté, QR dynamiques utilisés et maximum, fonctions incluses, accès en écriture.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "list_qr_codes",
      "description": "Liste les QR codes dynamiques de l’espace, avec recherche par nom ou destination.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "search": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "paused",
              "blocked"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        }
      }
    },
    {
      "name": "get_qr_code",
      "description": "Détail d’un QR code, par identifiant ou code court, avec son image (aperçu, téléchargement PNG et SVG).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "get_stats",
      "description": "Statistiques de scans pour un QR ou tout l’espace, à utiliser pour toute question sur les scans ou les performances des QR codes ; le résultat s’affiche en tableau de bord graphique. Par jour, pays et type d’appareil sur tous les plans ; villes, systèmes, navigateurs, langues, heures, jours de la semaine et évolution avec les statistiques avancées (Pro et Max). Dates AAAA-MM-JJ, heure de Paris ; 30 derniers jours par défaut.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "qr": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "to": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    {
      "name": "compare_stats",
      "description": "Compare les scans de plusieurs QR codes sur une période (par exemple un code par point de vente), avec un graphique des courbes superposées. Statistiques avancées : plans Pro et Max.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "qrs": {
            "minItems": 2,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "to": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "qrs"
        ]
      }
    },
    {
      "name": "export_qr_codes",
      "description": "Export CSV des QR codes, destinations et scans sur une période (plans Pro et Max).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "to": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    {
      "name": "create_qr_code",
      "description": "Crée un QR code dynamique vers une URL, avec un design (style, couleurs, icône ou logo au centre, texte d’appel). La destination reste modifiable après impression, et les scans sont comptés. Pour faire télécharger une application mobile, donnez app_store_url et/ou google_play_url : l’iPhone ouvre l’App Store, Android ouvre Google Play, et destination (facultative) sert les autres appareils. Tous les plans. Nécessite l’accès en écriture.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "description": "Nom pour s’y retrouver, par exemple « Menu terrasse »."
          },
          "destination": {
            "description": "URL ouverte au scan. Obligatoire, sauf pour une application : elle sert alors les autres appareils (par défaut, la fiche App Store).",
            "type": "string",
            "format": "uri"
          },
          "app_store_url": {
            "description": "Fiche App Store de l’application (https://apps.apple.com/…).",
            "type": "string",
            "format": "uri"
          },
          "google_play_url": {
            "description": "Fiche Google Play de l’application (https://play.google.com/store/apps/details?id=…).",
            "type": "string",
            "format": "uri"
          },
          "design": {
            "type": "object",
            "properties": {
              "preset": {
                "description": "Style prêt à porter : Classique, Vermillon, Soirée, Bouteille, Lagon, Kraft, Minuit. Les autres réglages le complètent.",
                "type": "string",
                "enum": [
                  "Classique",
                  "Vermillon",
                  "Soirée",
                  "Bouteille",
                  "Lagon",
                  "Kraft",
                  "Minuit"
                ]
              },
              "color": {
                "description": "Couleur du code (modules). Foncée, sur un fond clair.",
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "background": {
                "description": "Couleur du fond. Claire.",
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "eye_color": {
                "description": "Couleur des trois repères des coins, et de l’icône.",
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "gradient_to": {
                "description": "Seconde couleur pour un dégradé sur les modules.",
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "module_shape": {
                "type": "string",
                "enum": [
                  "square",
                  "rounded",
                  "dot",
                  "diamond",
                  "stripes",
                  "fluid"
                ]
              },
              "eye_shape": {
                "type": "string",
                "enum": [
                  "square",
                  "rounded",
                  "circle",
                  "leaf"
                ]
              },
              "icon": {
                "description": "Logo prédéfini au centre : un identifiant de list_design_options (wifi, menu, coffee, wine, star, thumbs-up, heart, message, phone, mail, map-pin, calendar…), « auto » pour le choisir d’après le nom et la destination, ou « none ».",
                "type": "string"
              },
              "brand_logo": {
                "description": "Logo de marque au centre, à la couleur de la marque : instagram, facebook, whatsapp, tiktok, youtube, x, google, googlemaps, apple, spotify, pinterest, snapchat, threads, tripadvisor, airbnb, bookingdotcom, ubereats, deliveroo, paypal, etsy, vinted. Seulement pour renvoyer vers une page sur ce réseau ou ce service.",
                "type": "string",
                "enum": [
                  "instagram",
                  "facebook",
                  "whatsapp",
                  "tiktok",
                  "youtube",
                  "x",
                  "google",
                  "googlemaps",
                  "apple",
                  "spotify",
                  "pinterest",
                  "snapchat",
                  "threads",
                  "tripadvisor",
                  "airbnb",
                  "bookingdotcom",
                  "ubereats",
                  "deliveroo",
                  "paypal",
                  "etsy",
                  "vinted"
                ]
              },
              "logo_url": {
                "description": "Adresse publique d’un logo (PNG, JPG ou SVG, 2 Mo max), placé au centre. Prioritaire sur le logo de marque et l’icône.",
                "type": "string",
                "format": "uri"
              },
              "frame_text": {
                "description": "Texte d’appel dans un cadre, par exemple « Voir le menu ». Vide : sans cadre.",
                "type": "string",
                "maxLength": 40
              },
              "frame_style": {
                "description": "Forme du cadre : bottom (bandeau dessous), top, box, badge, none.",
                "type": "string",
                "enum": [
                  "none",
                  "bottom",
                  "top",
                  "box",
                  "badge"
                ]
              }
            },
            "description": "Apparence du QR code. Tout est facultatif : sans design, le code est noir sur blanc."
          }
        },
        "required": [
          "name"
        ]
      }
    },
