{
  "$schema": "../schema.json",
  "name": "io.github.youthmy11-ai/forgesuite-mcp",
  "title": "ForgeSuite Web3, FinOps, Brand & Media MCP",
  "category": "AI, LLMs & Agents",
  "description": "Web3 wallet/token audit, calldata, .env, web extract, SRT/media QC, LLM cost, invoice & brand.",
  "repository": "https://github.com/youthmy11-ai/youthmy11-ai.github.io",
  "tools": [
    {
      "name": "envshield_scan",
      "description": "Scan .env files, JSON configs, shell logs, or transcripts for leaked API keys (OpenAI, Anthropic, GitHub, AWS, Google, Stripe, Telegram, Slack), 64-hex EVM private keys, seed mnemonics, JWTs, database URI passwords, and high-entropy secrets. Returns structured findings and safely redacted text.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Raw .env, config, JSON, diff, or log text to scan."
          },
          "includeRedacted": {
            "type": "boolean",
            "default": true,
            "description": "Include safely redacted text in the response (default: true)."
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "calldata_decode",
      "description": "Decode Ethereum / Base / BSC / Arbitrum 0x hex calldata (ERC-20, Permit2, EIP-2612, ERC-721/1155, Uniswap V2/V3/Universal Router, Safe multisig, AccessControl) and flag unlimited MaxUint256 / MaxUint160 approval risks.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "calldata": {
            "type": "string",
            "description": "Hex-encoded EVM transaction calldata (0x...)."
          }
        },
        "required": [
          "calldata"
        ]
      }
    },
    {
      "name": "tokencost_estimate",
      "description": "Estimate per-run, daily, and monthly LLM API and multi-turn AI agent costs across Claude 4.5 (Opus/Sonnet/Haiku), GPT-5/Mini, Gemini 2.5 Pro/Flash, and DeepSeek V3 with prompt caching and client retainer markup.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Optional sample prompt text to estimate input tokens."
          },
          "inputTokens": {
            "type": "number",
            "description": "Explicit input token count per initial turn."
          },
          "outputTokens": {
            "type": "number",
            "default": 600,
            "description": "Expected output tokens per turn."
          },
          "turns": {
            "type": "number",
            "default": 1,
            "description": "Number of multi-turn agent steps per run."
          },
          "toolTokensPerTurn": {
            "type": "number",
            "default": 0,
            "description": "Tool output tokens appended per turn."
          },
          "cachedRatioPct": {
            "type": "number",
            "default": 0,
            "description": "Prompt cache hit percentage (0-100)."
          },
          "requestsPerDay": {
            "type": "number",
            "default": 100,
            "description": "Runs per day."
          },
          "daysPerMonth": {
            "type": "number",
            "default": 30,
            "description": "Active days per month."
          },
          "marginMultiplier": {
            "type": "number",
            "default": 1,
            "description": "Client retainer quote markup multiplier."
          },
          "model": {
            "type": "string",
            "description": "Optional provider/model filter."
          }
        }
      }
    },
    {
      "name": "cryptobill_quote",
      "description": "Generate a clean Markdown/JSON freelance crypto invoice with subtotal/discount/tax math plus a live serverless CryptoBill Forge #inv= shareable A4 PDF & QR payment link.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "businessName": {
            "type": "string",
            "description": "Contractor or studio business name."
          },
          "businessEmail": {
            "type": "string",
            "description": "Optional sender contact email."
          },
          "clientName": {
            "type": "string",
            "description": "Client or organization name being billed."
          },
          "clientEmail": {
            "type": "string",
            "description": "Optional client billing email."
          },
          "invoiceNumber": {
            "type": "string",
            "description": "Invoice reference number."
          },
          "currency": {
            "type": "string",
            "enum": [
              "USDT",
              "USD",
              "EUR"
            ],
            "default": "USDT"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "qty": {
                  "type": "number",
                  "default": 1
                },
                "unitPrice": {
                  "type": "number"
                }
              },
              "required": [
                "description",
                "unitPrice"
              ]
            }
          },
          "taxPercent": {
            "type": "number",
            "default": 0
          },
          "discountPercent": {
            "type": "number",
            "default": 0
          },
          "dueDays": {
            "type": "number",
            "default": 7
          },
          "notes": {
            "type": "string"
          },
          "paymentMethods": {
            "type": "object",
            "properties": {
              "bep20": {
                "type": "string"
              },
              "trc20": {
                "type": "string"
              },
              "solanaUsdc": {
                "type": "string"
              },
              "paypalEmail": {
                "type": "string"
              },
              "binancePayId": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "clientName",
          "items"
        ]
      }
    },
    {
      "name": "evm_token_risk_scan",
      "description": "Audit live EVM token/contract bytecode, EIP-1967 / ZeppelinOS / Beacon / EIP-1167 proxies, SELFDESTRUCT/DELEGATECALL/CALLCODE opcodes, ownership status, and mint/blacklist/pause/tax selectors across Base, Ethereum, BSC, and Arbitrum.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chain": {
            "type": "string",
            "enum": [
              "base",
              "ethereum",
              "bsc",
              "arbitrum"
            ],
            "default": "base",
            "description": "Target EVM chain (default: base)."
          },
          "address": {
            "type": "string",
            "description": "0x-prefixed 20-byte EVM contract or token address."
          },
          "rpcUrl": {
            "type": "string",
            "description": "Optional custom public HTTPS EVM JSON-RPC endpoint."
          }
        },
        "required": [
          "address"
        ]
      }
    },
    {
      "name": "solana_mint_risk_scan",
      "description": "Audit live Solana Mainnet SPL Token and Token-2022 mints for active mintAuthority, freezeAuthority, permanentDelegate, transferFeeConfig, transferHook, mintCloseAuthority, and Top-10 holder concentration.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mint": {
            "type": "string",
            "description": "32-44 character Base58 Solana mint address."
          },
          "rpcUrl": {
            "type": "string",
            "description": "Optional custom public HTTPS Solana JSON-RPC endpoint."
          }
        },
        "required": [
          "mint"
        ]
      }
    },
    {
      "name": "brand_domain_handle_scan",
      "description": "Check candidate brand or product names live across authoritative RDAP + DoH domains (.com, .io, .ai, .co, .dev, .app, .org, .net), developer/social registries (GitHub, npm, PyPI, Bluesky, Reddit), and the Apple iOS App Store.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Candidate brand name (or comma-separated list)."
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional array of brand names."
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional alias array of candidate names."
          },
          "tlds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional TLD list (e.g. ['com','ai','io','dev'])."
          },
          "extensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional TLD extension alias list."
          }
        }
      }
    },
    {
      "name": "multi_chain_wallet_scan",
      "description": "Inspect 1 to 5 EVM (0x...) and/or Solana (Base58) wallets live across Ethereum, Base, Arbitrum, BSC, Polygon, and Solana Mainnet for native & stablecoin balances, tx nonces, EIP-7702 delegations, Gnosis Safe M-of-N multisig signers, SPL/Token-2022 holdings, and recent Solana signatures.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "description": "Single EVM/Solana wallet address or comma-separated list."
          },
          "wallets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Array of up to 5 wallet addresses."
          },
          "chains": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ethereum",
                "base",
                "arbitrum",
                "optimism",
                "bsc",
                "polygon",
                "solana"
              ]
            }
          },
          "signatureLimit": {
            "type": "number",
            "default": 10
          }
        }
      }
    },
    {
      "name": "subtitle_caption_audit",
      "description": "Audit and auto-fix SubRip (.srt) and WebVTT (.vtt) subtitles for timestamp overlaps, CPS > 20 reading speed spikes, 9:16 TikTok/Reels/Shorts safe-zone line overflows, and brand keyword casing — returning a 0-100 quality score plus normalized .srt and .vtt.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "Raw .srt or .vtt subtitle text."
          },
          "shiftMs": {
            "type": "number",
            "default": 0
          },
          "tempoScale": {
            "type": "number",
            "default": 1
          },
          "maxCps": {
            "type": "number",
            "default": 20
          },
          "maxLineLength": {
            "type": "number",
            "default": 32
          },
          "autoFix": {
            "type": "boolean",
            "default": true
          },
          "brandTerms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "content"
        ]
      }
    },
    {
      "name": "media_brief_audit",
      "description": "Audit spoken voiceover scripts (Latin + CJK) and visual production briefs for 135/150/165 WPM duration vs target seconds, FFmpeg atempo distortion risk, celebrity likeness/copyright/trademark pre-flight compliance, and 1:1, 9:16, 16:9 & 4:5 specs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "description": "Spoken voiceover script text."
          },
          "brief": {
            "type": "string",
            "description": "Optional visual prompt or creative brief."
          },
          "targetSec": {
            "type": "number",
            "default": 30
          },
          "wpm": {
            "type": "number",
            "default": 150
          },
          "ratio": {
            "type": "string",
            "enum": [
              "9:16",
              "1:1",
              "16:9",
              "4:5"
            ],
            "default": "9:16"
          },
          "consentVerified": {
            "type": "boolean",
            "default": false
          },
          "ownedBrands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "targetAgent": {
            "type": "string",
            "enum": [
              "pay-per-use-media-gen",
              "short-video-clipper",
              "multi-lang-video-dubber"
            ],
            "default": "pay-per-use-media-gen"
          }
        }
      }
    },
    {
      "name": "web_clean_extract",
      "description": "Fetch any public HTTP/HTTPS web page with strict IPv4/IPv6 SSRF protection and extract clean LLM-ready Markdown, canonical/OpenGraph/JSON-LD metadata, HTML tables converted to CSV + Markdown, and exact estimated LLM token savings versus raw HTML.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Public http:// or https:// URL to extract."
          },
          "maskPii": {
            "type": "boolean",
            "default": false,
            "description": "Redact detected email addresses in extracted text and tables."
          },
          "maxChars": {
            "type": "integer",
            "default": 40000,
            "description": "Maximum Markdown output characters (500-80000)."
          }
        },
        "required": [
          "url"
        ]
      }
    }
  ],
