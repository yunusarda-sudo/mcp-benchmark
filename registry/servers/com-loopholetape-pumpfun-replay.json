          }
        }
      }
    },
    {
      "name": "get_example",
      "description": "Returns a picks document made from three real buys of a real bot on pump.fun, together with the full answer the replay gives for it, so the format of both can be copied.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "how_to_buy_a_full_run",
      "description": "Says how to replay a whole document of up to 50 picks, which costs 1 USDC and is paid by the bot's own wallet over x402 on Solana with a plain HTTP request, when a run is charged and when it is not, and how a buyer fetches a paid answer again.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ],
