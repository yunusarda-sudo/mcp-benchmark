{
  "$schema": "../schema.json",
  "name": "com.loopholetape/pumpfun-replay",
  "title": "Replay for pump.fun bots",
  "category": "Finance, Crypto & Web3",
  "description": "See what a pump.fun trading bot's past picks would really have brought, replayed on real trades.",
  "repository": "https://github.com/loopholetape/pumpfun-replay",
  "tools": [
    {
      "name": "check_picks",
      "description": "Call this first, and it is free. Give the picks document of a pump.fun trading bot, and it says whether the replay would take it, with a sentence that names what to change if not, and whether its first pick fits the free sample. It does not look at the chain.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document"
        ],
        "properties": {
          "document": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "picks"
            ],
            "properties": {
              "settings": {
                "type": "object",
                "additionalProperties": false,
                "description": "How the bot's own orders behave. Every field is optional and has the default given here.",
                "properties": {
                  "delay_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000,
                    "default": 800,
                    "description": "Milliseconds from the bot's decision to the landing of its order, rounded up to whole slots."
                  },
                  "slot_ms": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000,
                    "default": 400,
                    "description": "Length of one slot in milliseconds."
                  },
                  "placement": {
                    "type": "string",
                    "enum": [
                      "last",
                      "first",
                      "after_trigger"
                    ],
                    "default": "last",
                    "description": "Where in its landing slot the order sits: after the recorded transactions of the slot (last), or before them (first, after_trigger)."
                  },
                  "base_fee": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 5000,
                    "description": "Network fee of one transaction in lamports."
                  },
                  "priority_fee": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "Priority fee of one transaction in lamports."
                  },
                  "tip": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "Tip paid with one transaction in lamports."
                  },
                  "quiet_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400,
                    "default": 60,
                    "description": "Seconds without a real trade after which the replay treats a coin as no longer trading."
                  }
                }
              },
              "picks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "description": "The picks to replay. Each one is replayed by itself, so two picks on the same coin do not feel each other.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "mint",
                    "decision",
                    "stake_lamports",
                    "slippage_bps",
                    "exit"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "description": "Your own name for the pick, different for each pick of a document."
                    },
                    "mint": {
                      "type": "string",
                      "minLength": 32,
                      "maxLength": 44,
                      "description": "The coin's mint address in base58."
                    },
                    "decision": {
                      "description": "The moment the bot decided. A whole number is a Unix time in seconds and means the start of that second. An object with slot and index means directly after the transaction at that position in the slot.",
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "slot",
                            "index"
                          ],
                          "properties": {
                            "slot": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          }
                        }
                      ]
                    },
                    "stake_lamports": {
                      "type": "integer",
                      "minimum": 1000000,
                      "maximum": 100000000000,
                      "description": "What the bot puts in, with fees included, in lamports."
                    },
                    "slippage_bps": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10000,
                      "description": "The slippage the bot allows, in hundredths of a percent."
                    },
                    "exit": {
                      "description": "The rule by which the bot sells: after a holding time, or at a rise or a fall with a time limit.",
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "seconds"
                          ],
                          "properties": {
                            "type": {
                              "const": "time"
                            },
                            "seconds": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 3600
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "up_bps",
                            "down_bps",
                            "max_seconds"
                          ],
                          "properties": {
                            "type": {
                              "const": "threshold"
                            },
                            "up_bps": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "down_bps": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 10000
                            },
                            "max_seconds": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 3600
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "replay_first_pick",
      "description": "Replays the first pick of a picks document against the trades that really happened on the chain and returns what it would have brought: the price after the bot's own delay, the effect of its own order, every fee, the result in SOL beside the simplest paper trade, or the reason the order would have failed. This is the free sample, allowed 6 times an hour for a caller with an exit window of up to 15 minutes, and it leaves the other picks of the document out.",
