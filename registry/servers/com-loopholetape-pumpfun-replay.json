{
  "$schema": "../schema.json",
  "name": "com.loopholetape/pumpfun-replay",
  "title": "Replay for pump.fun bots",
  "category": "Other",
  "description": "Estimate what past pump.fun picks made on the curve and PumpSwap after fees; backtest one for free.",
  "repository": "https://github.com/loopholetape/pumpfun-replay",
  "tools": [
    {
      "name": "check_picks",
      "description": "Call this first, and it is free. Give the picks document of a pump.fun trading bot, and it says whether the replay would take it, with a sentence that names what to change if not, and whether its first pick fits the free sample. It checks the optional landing rate and sample size or send log without reading the chain.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document"
        ],
        "properties": {
          "document": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "picks"
            ],
            "properties": {
              "landing": {
                "description": "Orders that never land are outside the replay unless your bot gives its own landing data. Add a landing field beside picks with {\"rate\": 0.5, \"sample_size\": 4} if two of four sends landed, or give send_log with one to 256 rows. Each row gives sent_at_ms as a Unix time in milliseconds and landed as true or false. Include the transaction signature if you have it, and count a signed order once. A trade that reached the chain and failed still counts as landed. For a landed send you can give landed_at_ms from the bot’s clock, or the replay can look up the signature and use the block time recorded in whole seconds. Lookups use the run’s usual allowance for reading history, so a run that reaches its limit gives delays only for the sends it could time. Sends without usable times still count toward the rate, and the delay figures say how many sends could be timed. The free check validates the fields and the free first pick uses the sample. The replay uses the chosen delay for pricing and estimates each send’s chance of landing from the same sample. A missed buy costs nothing and a missed sale leaves the tokens open. If a sale at a price target misses before the pick’s time limit, the replay tries once more at that limit and counts the proceeds only if that sale fills. Each pick gives its estimated cash change and open tokens in expected, and the run gives expected_net_sol and net_sol_range in summary. The range shows how the cash estimate changes across a 95 percent interval for the landing rate, so a small sample can give a wide range.",
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "rate",
                      "sample_size"
                    ],
                    "properties": {
                      "rate": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "sample_size": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "send_log"
                    ],
                    "properties": {
                      "send_log": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 256,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "sent_at_ms",
                            "landed"
                          ],
                          "properties": {
                            "sent_at_ms": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 253402300799999
                            },
                            "landed_at_ms": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 253402300799999
                            },
                            "landed": {
                              "type": "boolean"
                            },
                            "signature": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,88}$"
                            }
                          },
                          "if": {
                            "required": [
                              "landed_at_ms"
                            ]
                          },
                          "then": {
                            "properties": {
                              "landed": {
                                "const": true
                              }
                            }
                          },
                          "description": "Each signature must decode to 64 bytes and occur only once, and a landing time must fall at or after the send time."
                        }
                      }
                    }
                  }
                ]
              },
              "settings": {
                "type": "object",
                "additionalProperties": false,
                "description": "How the bot's own orders behave. Every field is optional and has the default given here.",
                "properties": {
                  "delay_ms": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000,
                    "default": 800,
                    "description": "Milliseconds from the bot's decision to the landing of its order, rounded up to whole slots."
                  },
                  "slot_ms": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000,
                    "default": 400,
                    "description": "Length of one slot in milliseconds."
                  },
                  "placement": {
                    "type": "string",
                    "enum": [
                      "last",
                      "first",
                      "after_trigger"
                    ],
                    "default": "last",
                    "description": "Where in its landing slot the order sits: after the recorded transactions of the slot (last), or before them (first, after_trigger)."
                  },
                  "base_fee": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 5000,
                    "description": "Network fee of one transaction in lamports."
                  },
                  "priority_fee": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "Priority fee of one transaction in lamports."
                  },
                  "tip": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "description": "Tip paid with one transaction in lamports."
                  },
                  "quiet_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400,
                    "default": 60,
                    "description": "Seconds without a real trade after which the replay treats a coin as no longer trading."
                  }
                }
              },
              "picks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "description": "The picks to replay. Each one is replayed by itself, so two picks on the same coin do not feel each other.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "mint",
                    "decision",
                    "stake_lamports",
                    "slippage_bps",
                    "exit"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "description": "Your own name for the pick, different for each pick of a document."
                    },
                    "mint": {
                      "type": "string",
                      "minLength": 32,
                      "maxLength": 44,
                      "description": "The coin's mint address in base58."
                    },
                    "decision": {
                      "description": "The moment the bot decided. A whole number is a Unix time in seconds and means the start of that second. An object with slot and index means directly after the transaction at that position in the slot.",
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "slot",
                            "index"
                          ],
                          "properties": {
                            "slot": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          }
                        }
                      ]
                    },
                    "stake_lamports": {
                      "type": "integer",
                      "minimum": 1000000,
                      "maximum": 100000000000,
                      "description": "What the bot puts in, with fees included, in lamports."
                    },
                    "slippage_bps": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10000,
                      "description": "The slippage the bot allows, in hundredths of a percent."
                    },
                    "exit": {
                      "description": "The rule by which the bot sells: after a holding time, or at a rise or a fall with a time limit.",
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "seconds"
                          ],
                          "properties": {
                            "type": {
                              "const": "time"
                            },
                            "seconds": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 3600
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "up_bps",
                            "down_bps",
                            "max_seconds"
                          ],
                          "properties": {
                            "type": {
                              "const": "threshold"
                            },
                            "up_bps": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "down_bps": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 10000
                            },
                            "max_seconds": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 3600
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            },
            "examples": [
              {
                "settings": {
                  "delay_ms": 800,
                  "placement": "last",
