{
  "$schema": "../schema.json",
  "name": "com.pdfbankstatementtocsv/statement-parser",
  "title": "Bank Statement Parser & Reconciler",
  "category": "Finance, Crypto & Web3",
  "description": "Parse bank statement text into transactions, verify balance math, and export CSV, QBO, or OFX.",
  "tools": [
    {
      "name": "parse_bank_statement_text",
      "description": "Deterministically parse plain bank statement text into normalized transactions with exact integer-cent balance reconciliation (Opening + Credits - Debits = Closing), automatic inverted-sign resolution, and formula-safe CSV, QuickBooks QBO, or OFX export.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48000,
            "description": "Raw extracted bank statement text lines (e.g. from pdftotext, clipboard copy, or OCR)."
          },
          "format": {
            "type": "string",
            "enum": [
              "csv",
              "qbo",
              "ofx"
            ],
            "default": "csv",
            "description": "Accounting export format to render."
          },
          "bank_profile": {
            "type": "string",
            "enum": [
              "auto",
              "chase",
              "bofa",
              "wellsfargo",
              "international"
            ],
            "default": "auto",
            "description": "Optional bank layout hint."
          },
          "date_order": {
            "type": "string",
            "enum": [
              "auto",
              "MDY",
              "DMY"
            ],
            "default": "auto",
            "description": "Date parsing order for slash-separated numeric dates."
          },
          "number_locale": {
            "type": "string",
            "enum": [
              "auto",
              "US",
              "EU"
            ],
            "default": "auto",
            "description": "Decimal/thousands separator locale (US: 1,234.56; EU: 1.234,56)."
          },
          "opening_balance": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "description": "Optional statement opening balance override if omitted from the text."
          },
          "closing_balance": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "description": "Optional statement closing balance override if omitted from the text."
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "description": "Optional ISO 4217 currency code override (e.g. USD, EUR, GBP)."
          },
          "include_bom": {
            "type": "boolean",
            "default": false,
            "description": "Prefix UTF-8 BOM to CSV output for Microsoft Excel."
          }
        }
      }
    },
    {
      "name": "reconcile_and_export_transactions",
      "description": "Normalize structured bank transactions across US/EU amount and date formats into exact integer cents, verify opening/closing and running balance math with row-level discrepancy flags, and export to CSV, QuickBooks QBO, or OFX.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transactions"
        ],
        "properties": {
          "transactions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "description": "Ordered list of statement transactions.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "description"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "description": "Transaction date (ISO, MM/DD/YYYY, DD/MM/YYYY, MM/DD, Oct 04 2026, etc.)."
                },
                "description": {
                  "type": "string",
                  "description": "Merchant or transaction description."
                },
                "amount": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "description": "Signed amount (negative for debit, positive for credit); supports parentheses, CR/DR, and trailing minus."
                },
                "debit": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "description": "Positive debit/withdrawal amount."
                },
                "credit": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "description": "Positive credit/deposit amount."
                },
                "running_balance": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "description": "Printed running balance after this row."
                },
                "check_number": {
                  "type": "string",
                  "description": "Optional check or reference number."
                }
              }
            }
          },
          "opening_balance": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "description": "Statement opening balance."
          },
          "closing_balance": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "description": "Statement closing balance."
          },
          "format": {
            "type": "string",
            "enum": [
              "csv",
              "qbo",
              "ofx"
            ],
            "default": "csv",
            "description": "Accounting export format to render."
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "default": "USD",
            "description": "ISO 4217 currency code."
          },
          "bank_name": {
            "type": "string",
            "default": "Bank Statement",
            "description": "Institution name included in metadata."
          },
          "account_masked": {
            "type": "string",
            "default": "••••0000",
            "description": "Masked account label (last 4 digits used in QBO/OFX)."
          },
          "date_order": {
            "type": "string",
            "enum": [
              "auto",
              "MDY",
              "DMY"
            ],
            "default": "auto",
            "description": "Date parsing order for slash-separated numeric dates."
          },
          "number_locale": {
            "type": "string",
            "enum": [
              "auto",
              "US",
              "EU"
            ],
            "default": "auto",
            "description": "Decimal/thousands separator locale (US: 1,234.56; EU: 1.234,56)."
          },
          "statement_year": {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2100,
            "description": "Fallback year for short MM/DD transaction dates."
          },
          "disable_auto_sign_resolver": {
            "type": "boolean",
            "default": false,
            "description": "Disable automatic inverted debit/credit sign correction against balances."
          },
          "include_bom": {
            "type": "boolean",
            "default": false,
            "description": "Prefix UTF-8 BOM to CSV output for Microsoft Excel."
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.pdfbankstatementtocsv/statement-parser",
    "version": "1.0.0",
    "remoteUrl": "https://pdfbankstatementtocsv.com/api/mcp",
    "publishedAt": "2026-11-27T13:57:54.651293Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "0d9c2d4987cb466b7d8ceb0f0cafbf3d9e8a02742d55012f5dd11b70c9a87ae7"
  }
}
