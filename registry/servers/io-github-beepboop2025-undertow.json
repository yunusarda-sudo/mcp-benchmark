{
  "$schema": "../schema.json",
  "name": "io.github.beepboop2025/undertow",
  "title": "Undertow market liquidity and exit-cost tools",
  "category": "Developer Tools & DevOps",
  "description": "Dated exit evidence, depth, tiers and gold cash scenarios. No executable quotes or trade authority.",
  "repository": "https://github.com/beepboop2025/undertow-mcp",
  "tools": [
    {
      "name": "agent_access_status",
      "description": "Identity, entitlement, daily usage, access instructions; missing/refused subscriber tools.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "crypto_exit_check",
      "description": "Four BTC sell sizes by rung/bracket. Withholds stale/future, uncovered or unconverted venues. Fees excluded; no trade clearance.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sizes_usd": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 1000000000000
            },
            "default": [
              1000,
              10000,
              100000,
              1000000
            ]
          },
          "max_age_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400,
            "default": 7200
          }
        }
      }
    },
    {
      "name": "crypto_funding_cost",
      "description": "Input perpetual funding/fees, net carry, linear break-even. Constant-rate scenario, not forecast.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "notional_usd",
          "side",
          "rate_bps_per_settlement",
          "settlements"
        ],
        "properties": {
          "notional_usd": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 1000000000000
          },
          "side": {
            "type": "string",
            "enum": [
              "long",
              "short"
            ]
          },
          "rate_bps_per_settlement": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000,
            "description": "1 bp = 0.01%; positive rate means longs pay shorts."
          },
          "settlements": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "round_trip_fee_bps": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000,
            "default": 0
          }
        }
      }
    },
    {
      "name": "crypto_portfolio_stress",
      "description": "Linear input shocks, 20 exposures: P&L/equity, asset/venue concentration. Symbols label scenarios. No liquidation/probability model.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "equity_usd",
          "positions"
        ],
        "properties": {
          "equity_usd": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 1000000000000
          },
          "positions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "asset",
                "side",
                "notional_usd",
                "price_change_pct"
              ],
              "properties": {
                "asset": {
                  "type": "string",
                  "pattern": "^[A-Z0-9][A-Z0-9._-]{0,15}$"
                },
                "venue": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
                },
                "side": {
                  "type": "string",
                  "enum": [
                    "long",
                    "short"
                  ]
                },
                "notional_usd": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 1000000000000
                },
                "price_change_pct": {
                  "type": "number",
                  "minimum": -100,
                  "maximum": 1000
                },
                "cost_usd": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000,
                  "default": 0
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "depth_episodes",
      "description": "BTC depth-collapse onset/trough/recovery under preregistered rules. Zero differs from missing. ETH: subscriber tier.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "exit_atlas",
      "description": "First-party stablecoin supply and depeg flags, exit doors, dollar curve, fees, exchange reserves. Gaps stay gaps. Research only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string",
            "enum": [
              "summary",
              "stablecoins",
              "doors",
              "dollar_curve",
              "fees",
              "exchanges",
              "context",
              "coverage",
              "independence"
            ],
            "default": "summary"
          },
          "coin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "exit_cost",
      "description": "BTC nearest-rung sell estimates; interpolated bid-depth bands. Fees excluded; not executable. One size, default freshness.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "size_usd": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "position size in USD (published rungs run $1,000 to $1,000,000)"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "gold_cash_realisation",
      "description": "Gold sale/cash gates from inputs: decimal kg, fineness (0,1], USD/troy-oz bid, USD fees, currency/USD FX (USD=1), aware ISO clocks. Arithmetic and withheld-cash reasons only; no fetch, storage, execution or verified balance.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quantity_kg",
          "fineness",
          "bid_usd_per_oz",
          "fees_usd",
          "fx_quote_per_usd",
          "fx_fee_bps",
          "quote_currency",
          "cutoff",
          "quote_asof",
          "fx_asof",
          "quote_valid_until",
          "fx_valid_until",
          "settlement_at",
          "cleared",
          "access_restricted",
          "pledged"
        ],
        "properties": {
          "quantity_kg": {
            "type": "string",
            "pattern": "^[0-9]{1,12}(\\.[0-9]{1,12})?$",
            "maxLength": 25
          },
          "fineness": {
            "type": "string",
            "pattern": "^[0-9]{1,12}(\\.[0-9]{1,12})?$",
            "maxLength": 25
          },
          "bid_usd_per_oz": {
            "type": "string",
            "pattern": "^[0-9]{1,12}(\\.[0-9]{1,12})?$",
            "maxLength": 25
          },
          "fees_usd": {
            "type": "string",
            "pattern": "^[0-9]{1,12}(\\.[0-9]{1,12})?$",
            "maxLength": 25
          },
          "fx_quote_per_usd": {
            "type": "string",
            "pattern": "^[0-9]{1,12}(\\.[0-9]{1,12})?$",
            "maxLength": 25
          },
          "fx_fee_bps": {
            "type": "string",
            "pattern": "^[0-9]{1,12}(\\.[0-9]{1,12})?$",
            "maxLength": 25
          },
          "quote_currency": {
            "type": "string",
            "enum": [
              "USD",
              "INR",
              "AED",
              "EUR",
              "GBP",
              "JPY",
              "CHF",
              "SGD"
            ]
          },
          "cutoff": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "quote_asof": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "fx_asof": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "quote_valid_until": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "fx_valid_until": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "settlement_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "cleared": {
            "type": "boolean"
          },
          "access_restricted": {
            "type": "boolean"
          },
          "pledged": {
            "type": "boolean"
          },
          "max_quote_age_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400,
            "default": 900
          }
        }
      }
    },
    {
      "name": "latest_article",
      "description": "Latest published editorial: title/full text/URL/clock/quality receipt. No args or generated prose. Missing text/failed receipt errors. Editorial, not a board reading.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "liquidity_tiers",
      "description": "Nine segment tiers, Seiche funding, measure counts, replay/withholding reasons. PARTIAL: missing history/unpassed replay, never calm.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "market_corpus_context",
      "description": "Corpus coverage/rights/clocks. No summary pagination; other views: records/total/next_offset. Retrieval age is not observation freshness. Coverage, not readings.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "enum": [
              "summary",
              "datasets",
              "flows",
              "exports"
            ],
            "default": "summary"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20000,
            "default": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 2
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "research_network",
      "description": "Cross-product metadata, clocks, rights, next steps. Follow next_offset. Unavailable: retrieval/contract/size failure. No local counts, shared score or authority.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "all",
              "china",
              "regions",
              "information_controls",
              "model_evaluations",
              "funding",
              "institutions",
              "liquidity",
              "global_data"
            ],
            "default": "all",
            "description": "Catalog topic, not a free-text query."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000,
            "default": 0,
            "description": "Zero-based page start."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 2,
            "description": "Set for full metadata; omission returns 2 compact rows."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "sealed_record",
      "description": "Calls sealed/signed before outcomes: hits/misses, decided counts, ledger root. Report hits and misses together.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "trade_safety_exit_context",
      "description": "Exact-rung BTC/USD observe/paper: request hash, PIT source/rights, level-free peg, bid bands, approved venue clocks, startup SHA. No live mode/clearance.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Opaque complete-request hash"
          },
          "mode": {
            "type": "string",
            "enum": [
              "observe",
              "paper"
            ]
          },
          "instrument": {
            "type": "string",
            "const": "BTC/USD"
          },
          "side": {
            "type": "string",
            "const": "sell"
          },
          "venue": {
            "type": "null"
          },
          "requested_size_usd": {
            "type": "number",
            "enum": [
              1000,
              10000,
              100000,
              1000000
            ]
          }
        },
        "required": [
          "request_hash",
          "mode",
          "instrument",
          "side",
          "venue",
          "requested_size_usd"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "unwind_watch",
      "description": "Watched-filer headlines: effective positions, days-to-exit brackets, blind spots. No live execution model. Full grids: subscriber tier.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cik": {
            "type": "integer",
            "description": "SEC CIK of a watched filer (returns that filer's full FREE row instead of the all-filer headline)"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "venue_concentration",
      "description": "BTC two-sided depth: HHI, effective/top venue, venue depth. ETH and venue failure: subscriber tier.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "venue_price_reconciliation",
      "description": "BTC/ETH consensus: depth/squared-half-spread weights, deepest-venue blindness, concentration, dislocations. Experimental; no execution authority.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
