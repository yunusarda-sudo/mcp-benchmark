{
  "$schema": "../schema.json",
  "name": "io.github.araaraara194-cloud/kubaru",
  "title": "Kubaru AI - Sapporo tourism allocation window",
  "category": "AI, LLMs & Agents",
  "description": "Plans Sapporo, Japan itineraries within resident-agreed crowd caps so AI agents don't herd.",
  "repository": "https://github.com/araaraara194-cloud/kubaru",
  "tools": [
    {
      "name": "get_rules",
      "description": "くばるAIの配分ルール(エリアごとの受け入れ上限、快適ライン、仮押さえの有効時間)を返す。",
      "inputSchema": {
        "properties": {},
        "type": "object",
        "title": "get_rulesArguments"
      }
    },
    {
      "name": "list_experiences",
      "description": "配れる体験(2〜3時間のパッケージ)の一覧を返す。",
      "inputSchema": {
        "properties": {},
        "type": "object",
        "title": "list_experiencesArguments"
      }
    },
    {
      "name": "get_availability",
      "description": "指定した日(1〜7)の、エリア×時間帯ごとの残り枠と混雑率を返す。\n    slot は morning / late_morning / afternoon / evening / night のどれか(省略で全部)。",
      "inputSchema": {
        "properties": {
          "day": {
            "title": "Day",
            "type": "integer"
          },
          "slot": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Slot"
          }
        },
        "required": [
          "day"
        ],
        "type": "object",
        "title": "get_availabilityArguments"
      }
    },
    {
      "name": "get_options",
      "description": "旅行者の希望から、その人に配られた札幌の候補の一覧をもらう(30分有効)。ここから旅行者と相談して選ぶ。\n\n    request: 旅行者の希望を自由文で(例「2泊3日、ふたりで海鮮と温泉。人混みは苦手」)。日数・人数も文章から読み取る\n    days: 日数(1〜7)、または日の番号のリスト。省略時は文章から読み取り、なければ2日\n    party: 人数。省略時は文章から読み取り、なければ1人\n    ",
      "inputSchema": {
        "properties": {
          "request": {
            "title": "Request",
            "type": "string"
          },
          "days": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Days"
          },
          "party": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Party"
          },
          "agent_name": {
            "default": "ai-agent",
            "title": "Agent Name",
            "type": "string"
          }
        },
        "required": [
          "request"
        ],
        "type": "object",
        "title": "get_optionsArguments"
      }
    },
    {
      "name": "book_options",
      "description": "get_options の候補から選んだ番号を押さえる(確定)。例: picks=[\"1a\",\"2c\"]。同じ日・同じ時間帯はひとつまで。",
      "inputSchema": {
        "properties": {
          "offer_id": {
            "title": "Offer Id",
            "type": "string"
          },
          "picks": {
            "items": {
              "type": "string"
            },
            "title": "Picks",
            "type": "array"
          },
          "agent_name": {
            "default": "ai-agent",
            "title": "Agent Name",
            "type": "string"
          }
        },
        "required": [
          "offer_id",
          "picks"
        ],
        "type": "object",
        "title": "book_optionsArguments"
      }
    },
    {
      "name": "request_plan",
      "description": "(おまかせ) 旅行者の希望から、くばるAIが旅程を1つ組んで仮押さえする(15分で失効)。ふつうは get_options を使う。\n\n    request: 旅行者の希望を自由文で(例「海鮮が好き。人混みは苦手で静かに過ごしたい」)\n    days: 滞在する日(1〜7のリスト)。省略時は1〜3日目\n    party: 人数\n    first_time: 札幌が初めてなら true\n    per_day: 1日に入れる体験の数\n    busy: すでに予定がある時間 例 {\"1\": [\"afternoon\"]}\n    ",
      "inputSchema": {
        "properties": {
          "request": {
            "title": "Request",
            "type": "string"
          },
          "days": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Days"
          },
          "party": {
            "default": 1,
            "title": "Party",
            "type": "integer"
          },
          "first_time": {
            "default": true,
            "title": "First Time",
            "type": "boolean"
          },
          "per_day": {
            "default": 2,
            "title": "Per Day",
            "type": "integer"
          },
          "busy": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Busy"
          },
          "traveler_name": {
            "default": "",
            "title": "Traveler Name",
            "type": "string"
          },
          "agent_name": {
            "default": "ai-agent",
            "title": "Agent Name",
            "type": "string"
          }
        },
        "required": [
          "request"
        ],
        "type": "object",
        "title": "request_planArguments"
      }
    },
    {
      "name": "confirm_booking",
      "description": "request_plan で仮押さえした旅程を確定する。",
      "inputSchema": {
        "properties": {
          "hold_id": {
            "title": "Hold Id",
            "type": "string"
          }
        },
        "required": [
          "hold_id"
        ],
        "type": "object",
        "title": "confirm_bookingArguments"
      }
    },
    {
      "name": "cancel_booking",
      "description": "仮押さえまたは確定した旅程を取り消し、枠を戻す。",
      "inputSchema": {
        "properties": {
          "hold_id": {
            "title": "Hold Id",
            "type": "string"
          }
        },
        "required": [
          "hold_id"
        ],
        "type": "object",
        "title": "cancel_bookingArguments"
      }
    },
    {
      "name": "reset_demo",
      "description": "デモ用: すべての予約を消して窓口を初期状態に戻す。",
      "inputSchema": {
        "properties": {},
        "type": "object",
        "title": "reset_demoArguments"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.araaraara194-cloud/kubaru",
    "version": "0.2.0",
    "remoteUrl": "https://kubaru.onrender.com/mcp",
    "publishedAt": "2026-11-26T12:54:53.702305Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
