    {
      "name": "tex402_invoice",
      "description": "Render a print-ready business or Web3 Invoice/Receipt PDF from structured JSON with deterministic BigInt fixed-point totals, optional logo, and offline vector payment QR code across 4 LaTeX themes (clean, ledger, minimal, web3) via POST /v1/pdf/invoice ($0.010 USDC via x402). Returns computed_totals, a 15-minute PDF download_url, and optional 150-DPI PNG page preview image blocks.",
      "inputSchema": {
        "type": "object",
        "description": "Structured invoice payload with exact server-side 10^6-scaled BigInt fixed-point math, multi-page line items, optional company logo, and vector payment QR code.",
        "properties": {
          "theme": {
            "type": "string",
            "enum": [
              "clean",
              "ledger",
              "minimal",
              "web3"
            ],
            "default": "clean",
            "description": "Visual LaTeX theme for the generated invoice PDF"
          },
          "accent_color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "description": "Optional 6-digit hex accent color such as #0f172a"
          },
          "paper_size": {
            "type": "string",
            "enum": [
              "letter",
              "a4"
            ],
            "default": "letter"
          },
          "include_page_previews": {
            "type": "boolean",
            "default": false
          },
          "invoice_number": {
            "type": "string",
            "minLength": 1,
            "description": "Unique invoice identifier such as INV-2026-0042"
          },
          "issue_date": {
            "type": "string"
          },
          "due_date": {
            "type": "string"
          },
          "po_number": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "unpaid",
              "paid",
              "draft",
              "overdue",
              "void"
            ],
            "default": "unpaid"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{2,12}$",
            "default": "USD",
            "description": "ISO 4217 currency or token ticker such as USD, EUR, JPY, or USDC"
          },
          "currency_symbol": {
            "type": "string",
            "description": "Optional explicit currency symbol override"
          },
          "from": {
            "type": "object",
            "description": "Seller or issuer party details",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "company": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "address": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "object"
                  }
                ]
              },
              "tax_id": {
                "type": "string"
              },
              "website": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          },
          "to": {
            "type": "object",
            "description": "Buyer or recipient party details",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "company": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "address": {
                "oneOf": [
                  {
                    "type": "string"
                  },
