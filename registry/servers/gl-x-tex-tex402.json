    {
      "name": "tex402_lint",
      "description": "Validate LaTeX (.tex) syntax and ChkTeX rules in <300ms via POST /v1/lint ($0.002 USDC via x402) without rendering a PDF. Attach x402 payment via _meta['x402/payment'] or Payment-Signature header, or run npx -y tex402-mcp locally.",
      "inputSchema": {
        "type": "object",
        "description": "Validate LaTeX (.tex) syntax and ChkTeX rules in <300ms via POST /v1/lint ($0.002 USDC) without rendering a PDF.",
        "properties": {
          "main_tex": {
            "type": "string",
            "minLength": 1,
            "description": "Root LaTeX document source code (.tex) to lint and validate"
          },
          "files": {
            "type": "object",
            "description": "Optional map of safe relative project paths (e.g. 'refs.bib', 'macros.sty') to UTF-8 strings or 'base64:...' binary payloads",
            "additionalProperties": {
              "type": "string"
            }
          },
          "engine": {
            "type": "string",
            "enum": [
              "pdflatex",
              "xelatex"
            ],
            "default": "pdflatex",
            "description": "TeX engine for draft validation ('pdflatex' or 'xelatex')"
          }
        },
        "required": [
          "main_tex"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tex402_compile",
      "description": "Compile multi-file LaTeX (.tex) source to PDF inside TeX402's networkless Docker TeX Live sandbox via POST /v1/compile ($0.008 USDC via x402). Returns a 15-minute PDF download_url, structured diagnostics, and optional 150-DPI PNG page preview image blocks.",
      "inputSchema": {
        "type": "object",
        "description": "Compile multi-file LaTeX (.tex) source to PDF inside TeX402's networkless Docker TeX Live sandbox via POST /v1/compile ($0.008 USDC).",
        "properties": {
          "main_tex": {
            "type": "string",
            "minLength": 1,
            "description": "Root LaTeX document source code (.tex)"
          },
          "files": {
            "type": "object",
            "description": "Optional map of safe relative project paths (e.g. 'refs.bib', 'styles/custom.sty', 'images/fig1.png') to UTF-8 text or 'base64:...' binary payloads",
            "additionalProperties": {
              "type": "string"
            }
          },
          "engine": {
            "type": "string",
            "enum": [
              "pdflatex",
              "xelatex"
            ],
            "default": "pdflatex",
            "description": "TeX engine used for compilation ('pdflatex' or 'xelatex')"
          },
          "bibliography": {
            "type": "boolean",
            "default": false,
            "description": "Run multi-pass biber/bibtex bibliography resolution when true"
          },
          "include_page_previews": {
            "type": "boolean",
            "default": false,
            "description": "Render 150-DPI PNG page previews and return them as native MCP image/png blocks"
          }
        },
        "required": [
          "main_tex"
        ],
        "additionalProperties": false
      }
    },
