  "name": "app.sstracker/sstracker",
  "title": "SSTracker free youth training",
  "category": "Jobs, Career & Learning",
  "description": "Free youth sports drills, practice plans and age-group answers for parents and coaches.",
  "tools": [
    {
      "name": "find_drills",
      "description": "For parents, coaches and trainers (adults). Free SSTracker drills open at a child's age (the app's own age gates: contact, tackling, heading and advanced drills wait for their age), each with steps, minutes, a safety line and its page link.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sport": {
            "type": "string",
            "enum": [
              "baseball",
              "basketball",
              "bowling",
              "cheer",
              "cross_country",
              "diving",
              "field_hockey",
              "flag_football",
              "football",
              "golf",
              "gymnastics",
              "hockey",
              "lacrosse",
              "rugby",
              "soccer",
              "softball",
              "swimming",
              "tennis",
              "track_and_field",
              "volleyball",
              "water_polo",
              "wrestling"
            ],
            "description": "The sport, e.g. \"soccer\" or \"basketball\"."
          },
          "age": {
            "type": "integer",
            "minimum": 4,
            "maximum": 18,
            "description": "The child's age in years."
          },
          "skill": {
            "type": "string",
            "description": "Optional: one of the sport's skills, e.g. \"shooting\"."
          },
          "at_home": {
            "type": "boolean",
            "description": "Only drills that work at home."
          }
        },
        "required": [
          "sport",
          "age"
        ],
        "additionalProperties": false
      }
    },
