{
  "$schema": "../schema.json",
  "name": "io.github.moelayyan90/xguard",
  "title": "XGuard",
  "category": "AI, LLMs & Agents",
  "description": "Paid technical intelligence for developers and AI agents. USD 0.001 per successful atomic query.",
  "repository": "https://github.com/moelayyan90/XGuard",
  "tools": [
    {
      "name": "xguard.facts",
      "description": "Read one recorded primary-source fact, its verification time, age, confidence and recent observations. USD 0.001 per atomic result.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "fact"
        ]
      }
    },
    {
      "name": "xguard.dependencies",
      "description": "Check an exact release against OSV. For npm and PyPI, include publisher evidence, withdrawal or deprecation, and the linked GitHub repository’s archive state when available. USD 0.001 per atomic result.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ecosystem": {
            "type": "string",
            "enum": [
              "npm",
              "PyPI",
              "Go",
              "crates.io",
              "Maven",
              "NuGet"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "ecosystem",
          "name",
          "version"
        ]
      }
    },
    {
      "name": "xguard.breaking_changes",
      "description": "Compare two supplied OpenAPI 3 documents for route, parameter, authentication and JSON contract changes. Unsupported constructs are reported explicitly. USD 0.001 per atomic result.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "before": {
            "type": "object"
          },
          "after": {
            "type": "object"
          }
        },
        "required": [
          "before",
          "after"
        ]
      }
    },
    {
      "name": "xguard.models",
      "description": "Read a published OpenAI model card, one observed price field, or compare the documented text-token costs of two models for a bounded workload. USD 0.001 per atomic result.",
      "inputSchema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fact": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": [
              "fact"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "model"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "models": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "input_tokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              }
            },
            "required": [
              "models",
              "input_tokens",
              "output_tokens"
            ]
          }
        ]
      }
    },
    {
      "name": "xguard.compatibility",
      "description": "Check an exact runtime or peer version against an exact npm release’s published Node.js engine or peer dependency range. USD 0.001 per atomic result.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "target_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "name",
          "version",
          "target",
          "target_version"
        ]
      }
    },
    {
      "name": "xguard.failures",
      "description": "Look up a supported Cloudflare Workers error in the official error reference and return the documented diagnostic steps. USD 0.001 per atomic result.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "cloudflare-workers"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "1101",
              "1102",
              "1019",
              "1021",
              "1022",
              "1024",
              "1027",
              "1042"
            ]
          }
        },
        "required": [
          "provider",
          "code"
        ]
      }
    },
    {
      "name": "xguard.infrastructure",
      "description": "Return a provider’s recorded service status, cited evidence and a deployment or incident-response action. USD 0.001 per atomic result.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "github",
              "cloudflare",
              "anthropic",
              "openai",
              "npm"
            ]
          }
        },
        "required": [
          "provider"
        ]
      }
    },
    {
      "name": "xguard.tools",
      "description": "Resolve a technical task to a tool, input contract, payment method and supported transports in the XGuard registry. USD 0.001 per atomic result.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "fact",
              "dependency",
              "api-diff",
              "model-price",
              "compatibility",
              "diagnosis",
              "cloud-status",
              "advisory",
              "decision"
            ]
          }
        },
        "required": [
          "task"
        ]
      }
    },
    {
      "name": "xguard.security",
      "description": "Look up published OSV advisories for one exact package release; returns affected-package evidence and published fix boundaries. USD 0.001 per atomic result.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ecosystem": {
            "type": "string",
            "enum": [
              "npm",
              "PyPI",
              "Go",
              "crates.io",
              "Maven",
              "NuGet"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "ecosystem",
          "name",
          "version"
        ]
      }
    },
    {
      "name": "xguard.decisions",
      "description": "Return an evidence-scoped deployment, upgrade or dependency-security decision for one question. USD 0.001 per atomic result.",
      "inputSchema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "question": {
                "type": "string",
                "enum": [
                  "provider-available"
                ]
              },
              "provider": {
                "type": "string",
                "enum": [
                  "github",
                  "cloudflare",
                  "anthropic",
                  "openai",
                  "npm"
                ]
              }
            },
            "required": [
              "question",
              "provider"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "question": {
                "type": "string",
                "enum": [
                  "known-vulnerabilities"
                ]
              },
              "ecosystem": {
                "type": "string",
                "enum": [
                  "npm",
                  "PyPI",
                  "Go",
                  "crates.io",
                  "Maven",
                  "NuGet"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "question",
              "ecosystem",
              "name",
              "version"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "question": {
                "type": "string",
                "enum": [
                  "npm-compatibility"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              },
              "target_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "question",
              "name",
              "version",
              "target",
              "target_version"
            ]
          }
        ]
      }
    },
    {
      "name": "xguard.batch",
      "description": "Return all requested fact units in order. One unavailable item aborts the entire batch before settlement. USD 0.001 per atomic result.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "facts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        "required": [
          "facts"
        ]
      }
    },
    {
      "name": "xguard.history",
      "description": "Read a bounded page of observations for one fact. USD 0.001 per atomic result.",
      "inputSchema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fact": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            },
            "required": [
              "fact"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fact": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300
              },
              "cursor": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "observed_at": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "observed_at",
                  "id"
                ]
              }
            },
            "required": [
              "fact",
              "from",
              "to"
            ]
          }
        ]
      }
    },
    {
      "name": "xguard.compare",
      "description": "Compare recorded observations for one fact at two UTC timestamps. USD 0.001 per atomic result.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          }
        },
        "required": [
          "fact",
          "from",
          "to"
        ]
      }
    },
    {
      "name": "xguard.changes",
      "description": "Read adjacent observations for a fact or one page of recorded changes to a source. USD 0.001 per atomic result.",
      "inputSchema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fact": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": [
              "fact"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "entity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 220
              },
              "change": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            },
            "required": [
              "entity"
            ]
          }
        ]
      }
    },
    {
      "name": "xguard.evidence",
      "description": "Retrieve one primary-source evidence record by canonical source and observation ID. USD 0.001 per atomic result.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "entity",
          "observation"
        ]
      }
    }
  ],
