{
 "$schema": "../schema.json",
 "name": "ai.opencurrent/actions-latest",
 "title": "GitHub Actions Version Check",
 "category": "Developer Tools & DevOps",
 "description": "Check the latest major version of GitHub Actions before writing a workflow (e.g. checkout@v3).",
 "tools": [
  {
   "name": "latest_action",
   "description": "Latest release tag and major tag (e.g. v6) of an action like actions/checkout.",
   "inputSchema": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
     "action": {
      "type": "string",
      "minLength": 3,
      "maxLength": 140,
      "description": "owner/repo, e.g. actions/setup-node"
     }
    },
    "required": [
     "action"
    ]
   }
  },
  {
   "name": "check_action",
   "description": "Compare a `uses:` value (e.g. actions/checkout@v3) with the action's latest release: majors behind and the tag to use.",
   "inputSchema": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
     "uses": {
      "type": "string",
      "minLength": 5,
      "maxLength": 200
     }
    },
    "required": [
     "uses"
    ]
   }
  }
 ],
 "source": {
  "type": "registry",
  "registry": "registry.modelcontextprotocol.io",
  "name": "ai.opencurrent/actions-latest",
  "version": "0.1.0",
