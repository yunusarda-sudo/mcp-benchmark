{
  "$schema": "../schema.json",
  "name": "Brave Search MCP",
  "category": "Vector DBs & AI Search",
  "description": "Brave Search MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "brave_web_search",
      "description": "Search the public web using Brave Search independent privacy-first index.",
      "inputSchema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "description": "Web search query terms."
          },
          "count": {
            "type": "integer",
            "description": "Number of results to return (max 20)."
          }
        }
      }
    }
  ]
}
