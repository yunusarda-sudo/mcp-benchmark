{
  "$schema": "../schema.json",
  "name": "YouTube Transcript MCP",
  "category": "Social, Media & Knowledge",
  "description": "YouTube Transcript MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "fetch_transcript",
      "description": "Download full timestamped subtitle text captions for YouTube video ID.",
      "inputSchema": {
        "type": "object",
        "required": [
          "videoId"
        ],
        "properties": {
          "videoId": {
            "type": "string",
            "description": "11-character YouTube video ID."
          },
          "language": {
            "type": "string",
            "description": "Language code preference (e.g. en, tr)."
          }
        }
      }
    }
  ]
}
