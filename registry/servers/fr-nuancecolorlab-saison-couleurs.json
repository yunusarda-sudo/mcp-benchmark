                  "clairs",
                  "fonces",
                  "moyens",
                  "froids",
                  "tres_fonces",
                  "nsp"
                ],
                "description": "moyens, froids, tres_fonces : marron seulement"
              },
              "nettete": {
                "type": "string",
                "enum": [
                  "franc",
                  "grise",
                  "nsp"
                ],
                "description": "marron seulement"
              },
              "iris": {
                "type": "string",
                "enum": [
                  "uni",
                  "melange"
                ]
              }
            }
          },
          "soleil": {
            "type": "string",
            "enum": [
              "brule",
              "brule-bronze",
              "bronze",
              "jamais",
              "nsp"
            ],
            "description": "Sans crème solaire : brule, brule-bronze, bronze, jamais (ne brûle presque jamais), nsp. Indice chaud/froid important."
          },
