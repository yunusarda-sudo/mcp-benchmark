{
  "$schema": "../schema.json",
  "name": "fr.nuancecolorlab/saison-couleurs",
  "title": "Nuance, saison de couleurs",
  "category": "Design, UI & 3D Media",
  "description": "Classify a person's color season (12 seasons) from your description; returns palette with hex codes.",
  "tools": [
    {
      "name": "classer_saison",
      "description": "Classe la saison de couleurs d’une personne parmi les 12 saisons (méthode Nuance v14.10, calcul déterministe) à partir d’une description en choix fermés : peau, cheveux, sourcils, yeux, réaction au soleil, taches de rousseur, et barbe ou crâne pour un homme. Accepte une seule description ou plusieurs (une par photo, de 2 à 6), auquel cas les classements sont comparés et l’accord est indiqué (fort, moyen ou faible). Renvoie la saison, sa nuance éventuelle, un niveau de confiance, 12 couleurs avec codes hex (neutres, phares, accents), 3 couleurs de plus si la personne est entre deux saisons, les couleurs à éviter près du visage et les règles de port. Ne reçoit ni photo, ni nom, ni texte libre ; ne conserve rien. Guide d’observation : ressource nuance://consignes. Vocabulaire et codes : ressource nuance://vocabulaire.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "personne"
        ],
        "properties": {
          "schema": {
            "type": "string",
            "const": "nuance-agent-1"
          },
          "personne": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "genre",
              "tranche_age"
            ],
            "properties": {
              "genre": {
                "type": "string",
                "enum": [
                  "femme",
                  "homme"
                ]
              },
              "tranche_age": {
                "type": "string",
                "enum": [
                  "moins_13",
                  "13_15",
                  "16_17",
                  "18_29",
                  "30_44",
                  "45_59",
                  "60_plus"
                ],
                "description": "Avant 18 ans : résultat provisoire."
              }
            }
          },
          "peau": {
            "type": "object",
            "additionalProperties": false,
            "description": "Peau du visage, hors bronzage marqué et maquillage couvrant.",
            "properties": {
              "profondeur": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10,
                "description": "1 très claire, 10 très foncée"
              },
              "reflet": {
                "type": "string",
                "enum": [
                  "rose",
                  "beige_rose",
                  "peche",
                  "dore",
                  "jaune",
                  "olive",
                  "incertain"
                ],
                "description": "« incertain » si vous hésitez : le calcul part du reflet pêche et signale la sensibilité."
              },
              "profondeur_incertaine": {
                "type": "boolean"
              },
              "code": {
                "type": "string",
                "pattern": "^P(0[1-9]|10)[A-F]$",
                "description": "Alternative : code du nuancier (voir GET /api/agent/schema)"
              }
            }
          },
          "cheveux": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code"
            ],
            "description": "Absent si crane = chauve.",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "C01",
                  "C21",
                  "C02",
                  "C03",
                  "C05",
                  "C04",
                  "C06",
                  "C08",
                  "C09",
                  "C07",
                  "C10",
                  "C14",
                  "C13",
                  "C11",
                  "C12",
                  "C15",
                  "C16",
                  "C17",
                  "C18",
                  "C22",
                  "C19",
                  "C20",
                  "C23"
                ],
                "description": "Couleur naturelle si les racines se voient. Noms et codes couleur : GET /api/agent/schema"
              },
              "meches": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "nature",
                  "couleur",
                  "proportion"
                ],
                "properties": {
                  "nature": {
                    "type": "string",
                    "enum": [
                      "naturel",
                      "coloration"
                    ]
                  },
                  "couleur": {
                    "type": "string",
                    "enum": [
                      "C18",
                      "C15",
                      "C16",
                      "C13",
                      "C10",
                      "C06",
                      "C07",
                      "C03",
                      "C01",
                      "C22",
                      "C19",
                      "C20",
                      "C23"
                    ],
                    "description": "naturel : C22, C19, C20, C23 ; coloration : C18, C15, C16, C13, C10, C06, C07, C03, C01"
                  },
                  "proportion": {
                    "type": "number",
                    "enum": [
                      0.1,
                      0.25,
                      0.5,
                      0.75,
                      1
                    ]
                  }
                }
              }
            }
          },
          "reflets_soleil": {
            "type": "string",
            "enum": [
              "dore",
              "roux",
              "cendre",
              "aucun",
              "nsp"
            ],
            "description": "Au soleil, les cheveux prennent des reflets dorés, roux, cendrés, aucun ; nsp si inconnu."
          },
          "sourcils": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
