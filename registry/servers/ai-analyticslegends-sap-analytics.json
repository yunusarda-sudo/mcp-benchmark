{
  "$schema": "../schema.json",
  "name": "ai.analyticslegends/sap-analytics",
  "title": "Analytics Legends — SAP AI & Analytics MCP Server",
  "category": "Observability & Analytics",
  "description": "SAP AI & analytics market data for agents: SAP firms, day rates, jobs, Joule & BDC news",
  "repository": "https://github.com/analyticslegends/analytics-legends-mcp",
  "tools": [
    {
      "name": "find_answers",
      "description": "Start here for an SAP AI & analytics PROBLEM, asked in EN, FR or DE (agents in production, Joule value, BW 7.5 cliff, BDC vs Datasphere vs Databricks…). Returns up to 3 tracked challenges: short answer, what shipped, what is announced, next steps, citation_url. Empty = not a tracked challenge; try search_concepts. Public.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "description": "As asked, in EN, FR or DE.",
            "examples": [
              "What happens to BW 7.5 after 2027?"
            ]
          },
          "audience": {
            "type": "string",
            "enum": [
              "cio_architect",
              "consultant",
              "firm",
              "recruiter"
            ],
            "description": "Reorders matches, never adds one."
          },
          "lang": {
            "type": "string",
            "enum": [
              "EN",
              "FR",
              "DE"
            ],
            "description": "Default: language of the question."
          }
        },
        "required": [
          "question"
        ]
      }
    },
    {
      "name": "search_firms",
      "description": "Search SAP AI & analytics service providers (consultancies, Big-4, agencies, SAP partners, platforms). Returns slug, name, HQ, website, claim, sap_signal_band; SAP end-customers are in find_sap_clients. Public.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "All words must match."
          },
          "country": {
            "type": "string",
            "description": "ISO alpha-2.",
            "examples": [
              "DE"
            ]
          },
          "region": {
            "type": "string",
            "enum": [
              "EMEA",
              "AMER",
              "LATAM",
              "APAC",
              "AFRICA",
              "GLOBAL"
            ]
          },
          "kind": {
            "type": "string",
            "description": "Organisation kind (list_firm_kinds)."
          },
          "module": {
            "type": "string",
            "description": "SAP module code; list: count_firms_by by=module.",
            "examples": [
              "DATASPHERE"
            ]
          },
          "limit": {
            "type": "integer",
            "default": 10
          },
          "cursor": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "count_firms_by",
      "description": "Count the firm directory by country, region, kind, module or sap_signal_band, with search_firms' filters, instead of paging search_firms to tally. Rows: value, n; the tail folds into '(other)'. Public.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "by": {
            "type": "string",
            "enum": [
              "country",
              "region",
              "kind",
              "module",
              "sap_signal_band"
            ],
            "description": "Which facet to count on."
          },
          "query": {
            "type": "string",
            "description": "All words must match."
          },
          "country": {
            "type": "string",
            "description": "ISO alpha-2."
          },
          "region": {
            "type": "string",
            "enum": [
              "EMEA",
              "AMER",
              "LATAM",
              "APAC",
              "AFRICA",
              "GLOBAL"
            ]
          },
          "kind": {
            "type": "string",
            "description": "Organisation kind (list_firm_kinds)."
          },
          "module": {
            "type": "string",
            "description": "SAP module code; list: count_firms_by by=module."
          }
        },
        "required": [
          "by"
        ]
      }
    },
    {
      "name": "get_firm",
      "description": "One firm's public profile by its slug from search_firms (verbatim; some slugs are numeric). A brand name such as 'accenture' returns the list of its entities to choose from. Public.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "search_firms.rows[].slug, verbatim."
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "list_firm_kinds",
      "description": "The organisation kinds of the firm directory with a live count each — the vocabulary of search_firms' `kind`. Public, complete without a key.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "list_freelance_platforms",
      "description": "Platforms where an SAP consultant can create a profile (freelance marketplaces, job boards, expert networks), with signup URL, confidence grade and assessment date. Public, complete without a key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "description": "ISO alpha-2."
          },
          "platform_type": {
            "type": "string",
            "description": "Live list: _meta.available_platform_types."
          },
          "limit": {
            "type": "integer",
            "default": 50
          },
          "cursor": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "find_opportunities",
      "description": "Search public SAP AI & analytics postings. Mostly PERMANENT roles: set employment_type for freelance questions. A posting listed in several cities is one row with `locations`. Public, except the link to the original listing (paid).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "All words must match.",
            "examples": [
              "SAC Planning"
            ]
          },
          "location": {
            "type": "string",
            "description": "City or place, substring match."
          },
          "country": {
            "type": "string",
            "description": "ISO alpha-2.",
            "examples": [
              "DE"
            ]
          },
          "employment_type": {
            "type": "string",
            "enum": [
              "freelance",
              "contract",
              "permanent"
            ],
            "description": "Rows that declare none are set aside."
          },
          "remote_mode": {
            "type": "string",
            "description": "Undeclared rows set aside."
          },
          "eligibility": {
            "type": "string",
            "enum": [
              "open",
              "restricted",
              "unstated"
            ],
            "description": "Who may apply to a remote role."
          },
          "lang": {
            "type": "string",
            "default": "EN",
            "description": "Title language; not a filter."
          },
          "limit": {
            "type": "integer",
            "default": 10
          },
          "cursor": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "search_news",
      "description": "Search the curated SAP AI & analytics news corpus; defaults to SAP-specific items (scope 'sap'). Each item carries source_url (the publisher) and citation_url: cite both. Public.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "All words must match.",
            "examples": [
              "Business Data Cloud"
            ]
          },
          "category": {
            "type": "string",
            "description": "Live list: _meta.available_categories."
          },
          "scope": {
            "type": "string",
            "enum": [
              "sap",
              "ecosystem",
              "general",
              "all"
            ],
            "default": "sap",
            "description": "Editorial scope, set by one deterministic rule (2026-11-07): 'sap' = an SAP product or SAP itself n…"
          },
          "published_since": {
            "type": "string",
            "description": "YYYY-MM-DD, inclusive."
          },
          "published_until": {
            "type": "string",
            "description": "YYYY-MM-DD, inclusive."
          },
          "limit": {
            "type": "integer",
            "default": 10
          },
          "cursor": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "search_concepts",
      "description": "Search the SAP AI & analytics concept encyclopaedia (the stack's vocabulary): slug, title, category, level, editor's summary. Full card: get_concept_card (paid). Public.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "All words must match.",
            "examples": [
              "data product"
            ]
          },
          "category": {
            "type": "string",
            "description": "Category name or prefix, e.g. datasphere."
          },
          "limit": {
            "type": "integer",
            "default": 10
          },
          "cursor": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "get_concept",
      "description": "One concept's metadata and editor's summary by slug from search_concepts (e.g. 'sap-business-data-cloud-bdc'). The card body, cheat sheet and tables are paid (get_concept_card). Public.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "search_concepts.rows[].slug.",
            "examples": [
              "sap-business-data-cloud-bdc"
            ]
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "list_studies",
      "description": "List the deep-research studies: title, edition, as-of date, audience, word count, citation_url, one row per study in the language asked. Metadata only; the text is get_study (paid). Public.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "All words must match."
          },
          "lang": {
            "type": "string",
            "default": "en",
            "description": "en, fr or de."
          },
          "limit": {
            "type": "integer",
            "default": 10
          },
          "cursor": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "get_day_rate_benchmark",
      "description": "Published SAP freelance day-rate aggregate by country, specialisation and seniority: min/max (median, p10, p90 when sourced) in the row's currency, with source, date and confidence. Small, secondary sources; 0 rows = no such cell here, see `_meta.available_*`. Public.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "description": "ISO alpha-2.",
            "examples": [
              "FR"
            ]
          },
          "specialisation": {
            "type": "string",
            "description": "Live list: _meta.available_specialisations.",
            "examples": [
              "datasphere"
            ]
          },
          "seniority": {
            "type": "string",
            "description": "e.g. senior."
          }
        }
      }
    },
    {
      "name": "list_sap_modules",
      "description": "The SAP module/product taxonomy (codes such as DATASPHERE, BDC, SAC, BW4HANA with labels) that other tools filter on; use it to map loose wording to a code. Public, complete without a key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "All words must match."
          },
          "limit": {
            "type": "integer",
            "default": 50
          },
          "cursor": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "find_academy_modules",
      "description": "Search the Academy training catalogue (Datasphere, BDC, SAC, BW/4HANA, Databricks) by text, track or level. Rows are in the language asked. Full text: get_academy_module (paid). Public.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "All words must match.",
            "examples": [
              "datasphere"
            ]
          },
          "track": {
            "type": "string",
            "description": "Track slug or English name."
          },
          "level": {
            "type": "string",
            "description": "Beginner, Intermediate, Advanced or Expert."
          },
          "library": {
            "type": "string",
            "enum": [
              "sap",
              "career"
            ],
            "description": "sap (SAP Academy) or career."
          },
          "lang": {
            "type": "string",
            "enum": [
              "EN",
              "FR"
            ],
            "default": "EN",
            "description": "EN or FR."
          },
          "limit": {
            "type": "integer",
            "default": 10
          },
          "cursor": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "query_knowledge_graph",
      "description": "Relations between concepts, Academy modules, studies and vendors: list nodes (node_type, query) or one node's edges (node_id). The only tool that serves edges. Public.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string",
            "description": "<type>:<id>; returns its edges.",
            "examples": [
              "concept:C001"
            ]
          },
          "node_type": {
            "type": "string",
            "description": "concept, module, study or vendor."
          },
          "edge_type": {
            "type": "string",
            "description": "Live list: _meta.available_edge_types."
          },
          "direction": {
            "type": "string",
            "enum": [
              "from",
              "to",
              "both"
            ],
            "default": "both",
            "description": "Which side of the edge `node_id` must sit on."
          },
          "query": {
            "type": "string",
            "description": "Substring of a node label (node listing only)."
          },
          "lang": {
            "type": "string",
            "default": "en",
            "description": "en, fr or de."
          },
          "limit": {
            "type": "integer",
            "default": 10
          },
          "cursor": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "get_concept_card",
      "description": "The full concept card: body, cheat sheet, glossary, pro tip and the four analysis tables, EN/FR/DE. Paid: MCP Pass or Firm Pass key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "search_concepts.rows[].slug."
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "get_study",
      "description": "Read a study's text: without `section` returns the section list and introduction, then pass a heading as `section`. Slugs from list_studies. Paid: MCP Pass or Firm Pass key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "list_studies.rows[].slug."
          },
          "lang": {
            "type": "string",
            "default": "en",
            "description": "Edition language."
          },
          "section": {
            "type": "string",
            "description": "A heading from `sections`; omit for the list."
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "get_academy_module",
      "description": "Read one Academy module in full (body, objectives, summary) by id or slug from find_academy_modules; `lang` picks one language. Paid: MCP Pass or Firm Pass key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Module id (M001) or slug."
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "fr",
              "de"
            ],
            "description": "One language only; omit for all three."
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "find_sap_clients",
      "description": "Search the SAP END-CUSTOMER corpus (companies that run SAP); each row says its verification status. Paid: MCP Pass or Firm Pass key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "All words must match."
          },
          "country": {
            "type": "string",
            "description": "ISO alpha-2.",
            "examples": [
              "DE"
            ]
          },
          "industry": {
            "type": "string",
            "description": "Substring match."
          },
          "product": {
            "type": "string",
            "enum": [
              "datasphere",
              "bdc",
              "sac",
              "bw",
              "bw4hana",
              "s4hana",
              "ecc",
              "hana",
              "joule",
              "businessobjects",
              "bpc",
              "successfactors",
              "ariba",
              "concur"
            ],
            "description": "Detected in use."
          },
          "limit": {
            "type": "integer",
            "default": 10
          },
          "cursor": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "get_sap_client_profile",
      "description": "One SAP end-customer's full profile (products in use, modules, analytics solutions, evidence) by id from find_sap_clients. Paid: MCP Pass or Firm Pass key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "find_sap_clients.rows[].id."
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "get_expansion_brief",
      "description": "Brief for entering a region: providers there (local vs group), SAP end-customer counts by country and industry, live opportunities, brand families present in both regions. Paid: MCP Pass or Firm Pass key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "target_region": {
            "type": "string",
            "enum": [
              "EMEA",
              "AMER",
              "LATAM",
              "APAC",
              "AFRICA",
              "GLOBAL"
            ],
            "description": "Not GLOBAL."
          },
          "home_region": {
            "type": "string",
            "enum": [
              "EMEA",
              "AMER",
              "LATAM",
              "APAC",
              "AFRICA",
              "GLOBAL"
            ],
            "description": "Where you operate today."
          }
        },
        "required": [
          "target_region"
        ]
      }
    },
    {
      "name": "find_partner_candidates",
      "description": "Rank local service providers of a country or region as partner or acquisition candidates; local_only (default) excludes foreign groups' subsidiaries. Paid: MCP Pass or Firm Pass key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "description": "ISO alpha-2.",
            "examples": [
              "CH"
            ]
          },
          "region": {
            "type": "string",
            "enum": [
              "EMEA",
              "AMER",
              "LATAM",
              "APAC",
              "AFRICA",
              "GLOBAL"
            ]
          },
          "kind": {
            "type": "string",
            "description": "Organisation kind (list_firm_kinds)."
          },
          "module": {
            "type": "string",
            "description": "SAP module code; list: count_firms_by by=module."
          },
          "local_only": {
            "type": "boolean",
            "default": true,
            "description": "true: firms with no sister entity abroad."
          },
          "limit": {
            "type": "integer",
            "default": 10
          },
          "cursor": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "get_firm_intel",
      "description": "Intelligence profile of a services firm: SAP practice size, partner level, products delivered, typical day rate, notable clients. Search by name, country, product or engagement mode; a null is a data gap. Paid: MCP Pass or Firm Pass key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Exact match ranks first.",
            "examples": [
              "Accenture"
            ]
          },
          "country": {
            "type": "string",
            "description": "ISO alpha-2."
          },
          "delivers": {
            "type": "string",
            "enum": [
              "datasphere",
              "bdc",
              "sac",
              "bw",
              "bw4hana",
              "s4hana",
              "ecc",
              "hana",
              "joule",
              "businessobjects",
              "bpc",
              "successfactors",
              "ariba",
              "concur"
            ],
            "description": "Declared by the firm."
          },
          "mode": {
            "type": "string",
            "enum": [
              "freelance",
              "permanent",
              "subcontract"
            ],
            "description": "Declared by the firm."
          },
          "limit": {
            "type": "integer",
            "default": 3
          },
          "cursor": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "submit_brief",
      "description": "ACTION: deposit an SAP need as a private brief, matched every 6 h against consenting consultants; nothing is e-mailed. Paid: MCP Pass or Firm Pass key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "sap_products": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "1-8, such as Datasphere, BW/4HANA, Joule."
          },
          "country": {
            "type": "string",
            "description": "ISO alpha-2."
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "context": {
            "type": "string"
          },
          "remote_policy": {
            "type": "string",
            "enum": [
              "onsite",
              "hybrid",
              "remote"
            ]
          },
          "seniority": {
            "type": "string",
            "enum": [
              "junior",
              "mid",
              "senior",
              "architect"
            ]
          },
          "duration_months": {
            "type": "integer"
          },
          "budget_day_rate": {
            "type": "integer"
          },
          "architecture": {
            "type": "object",
            "description": "recommend_architecture input."
          },
          "consent": {
            "type": "boolean",
            "description": "Must be true."
          },
          "idempotency_key": {
            "type": "string",
            "description": "8-80 chars."
          }
        },
        "required": [
          "title",
          "sap_products",
          "country",
          "consent",
          "idempotency_key"
        ]
      }
    },
    {
      "name": "request_introduction",
      "description": "ACTION: a brief's anonymised selection, or with candidate_ref an introduction request the consultant answers in the app. Paid: MCP Pass or Firm Pass key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "need_id": {
            "type": "string"
          },
          "candidate_ref": {
            "type": "string",
            "description": "Omit to read the selection."
          }
        },
        "required": [
          "need_id"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "ai.analyticslegends/sap-analytics",
    "version": "1.2.0",
