{
  "$schema": "../schema.json",
  "name": "be.renovatiestart/renovatie-tools",
  "title": "Renovatiestart",
  "category": "Design, UI & 3D Media",
  "description": "Vlaamse renovatiegidsen en rekentools voor budget, premies, thuisbatterijen en financiering.",
  "tools": [
    {
      "name": "search_content",
      "description": "Zoek in publieke renovatie-informatie voor Vlaanderen. Geeft canonieke bronnen; lees de pagina en primaire bronnen voor veranderlijke regels.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "limit": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "read_page",
      "description": "Lees één publieke pagina uit deze build. Geef een exact canoniek adres uit search_content. Haalt geen externe URL op en kan geen aanvragen of accounts lezen.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 500,
            "format": "uri"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "calculate_premie",
      "description": "Indicatieve Mijn VerbouwPremie voor eigenaar-bewoners in Vlaanderen. Regels oktober 2026; controleer actuele overheidsvoorwaarden. Geen aanvraag of toekenning. Zonder factuur volgt het maximum.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "work": {
            "type": "string",
            "enum": [
              "wp-lw",
              "wp-hy",
              "wp-geo",
              "wp-ll",
              "dak",
              "muur"
            ]
          },
          "category": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "invoice": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          }
        },
        "required": [
          "work",
          "category"
        ]
      }
    },
    {
      "name": "calculate_project_premie",
      "description": "Som van basispremies voor één Vlaamse woning; groepeert facturen en past plafonds één keer toe. Alleen subsidiabele bedragen excl. btw, zonder verhogingen.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "category": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "items": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "work": {
                  "type": "string",
                  "enum": [
                    "dak",
                    "muur",
                    "wp-lw",
                    "wp-hy",
                    "wp-geo",
                    "wp-ll"
                  ]
                },
                "invoice": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000000
                }
              },
              "required": [
                "work",
                "invoice"
              ]
            }
          }
        },
        "required": [
          "category",
          "items"
        ]
      }
    },
    {
      "name": "calculate_budget",
      "description": "Twee kostenramingen voor geselecteerde werken, btw en reserve. Vul eigen bedragen in. Premies alleen voor subsidiabele werken; category 0 rekent zonder premies. low/high zijn kostenscenario’s, geen gegarandeerde grenzen na premies.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "items": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "low": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000000
                },
                "high": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10000000
                },
                "vat": {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 0
                    },
                    {
                      "type": "number",
                      "const": 6
                    },
                    {
                      "type": "number",
                      "const": 21
                    }
                  ]
                },
                "work": {
                  "type": "string",
                  "enum": [
                    "dak",
                    "muur",
                    "wp-lw",
                    "wp-hy",
                    "wp-geo",
                    "wp-ll"
                  ]
                }
              },
              "required": [
                "low",
                "high",
                "vat"
              ]
            }
          },
          "reservePercent": {
            "type": "number",
            "minimum": 0,
            "maximum": 50
          },
          "category": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        },
        "required": [
          "items",
          "reservePercent"
        ]
      }
    },
    {
      "name": "calculate_battery",
      "description": "Batterijscenario met eigen zonnestroom vóór verliezen, vaste tarieven en degradatie. Geen dynamische handel, capaciteitstarief of financiering. Geen dimensioneringsadvies.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "cost": {
            "type": "number",
            "minimum": 1,
            "maximum": 100000
          },
          "charged": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000
          },
          "efficiency": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          },
          "importPrice": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "exportPrice": {
            "type": "number",
            "minimum": -1,
            "maximum": 5
          },
          "annualCost": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000
          },
          "degradation": {
            "type": "number",
            "minimum": 0,
            "maximum": 20
          },
          "years": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        },
        "required": [
          "cost",
          "charged",
          "efficiency",
          "importPrice",
          "exportPrice",
          "annualCost",
          "degradation",
          "years"
        ]
      }
    },
    {
      "name": "calculate_finance",
      "description": "Vooraf te financieren bedrag en vaste maandtermijn. Trek premie alleen af als al ontvangen. Nominale jaarrente, geen JKP, dossierkosten of latere aflossing.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "budget": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "savings": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "premieAmount": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "premieReceived": {
            "type": "boolean"
          },
          "annualRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 30
          },
          "months": {
            "type": "integer",
            "minimum": 1,
            "maximum": 360
          }
        },
        "required": [
          "budget",
          "savings",
          "premieAmount",
          "premieReceived",
          "annualRate",
          "months"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "be.renovatiestart/renovatie-tools",
    "version": "1.0.0",
    "remoteUrl": "https://renovatiestart.be/mcp",
