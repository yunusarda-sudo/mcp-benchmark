{
  "$schema": "../schema.json",
  "name": "ch.opendata/vornamen",
  "title": "First names in Switzerland",
  "category": "Other",
  "description": "Official statistics of first names in Switzerland (BFS): people by year of birth, newborn rankings.",
  "repository": "https://gitlab.com/opendata.ch/vornamen",
  "tools": [
    {
      "name": "name_profile",
      "description": "How many people in Switzerland have this first name, by sex; median and peak year of birth; its rank among newborns over the years; similar spellings; link to the page with charts and map.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "A first name, e.g. 'Anna' or 'Noah'."
          },
          "lang": {
            "description": "Language of the page linked in the answer.",
            "type": "string",
            "enum": [
              "de",
              "fr",
              "it",
              "en"
            ]
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "newborn_ranking",
      "description": "The ranking of first names given to newborns in one year, for Switzerland, a language region (region-de, region-fr, region-it, region-rm) or a canton (zh, be, ...).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "year": {
            "description": "Year; 2025 if left out.",
            "type": "integer",
            "minimum": 2000,
            "maximum": 2025
          },
          "region": {
            "description": "ch (default), region-<language> or a canton code.",
            "type": "string",
            "enum": [
              "ch",
              "region-de",
              "region-fr",
              "region-it",
              "region-rm",
              "ag",
              "ai",
              "ar",
              "be",
              "bl",
              "bs",
              "fr",
              "ge",
              "gl",
              "gr",
              "ju",
              "lu",
              "ne",
              "nw",
              "ow",
              "sg",
              "sh",
              "so",
              "sz",
              "tg",
              "ti",
              "ur",
              "vd",
              "vs",
              "zg",
              "zh"
            ]
          },
          "sex": {
            "description": "f for girls/women, m for boys/men; both if left out.",
            "type": "string",
            "enum": [
              "f",
              "m"
            ]
          },
          "limit": {
            "description": "Names per sex; 20 if left out.",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "lang": {
            "description": "Language of the page linked in the answer.",
            "type": "string",
            "enum": [
              "de",
              "fr",
              "it",
              "en"
            ]
          }
        }
      }
    },
    {
      "name": "names_by_birth_year",
      "description": "The most frequent first names among people living in Switzerland today who were born in a given year.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 1915,
            "maximum": 2025,
            "description": "Year of birth, e.g. 1985."
          },
          "sex": {
            "description": "f for girls/women, m for boys/men; both if left out.",
            "type": "string",
            "enum": [
              "f",
              "m"
            ]
          },
          "limit": {
            "description": "Names per sex; 20 if left out.",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "year"
        ]
      }
    },
    {
      "name": "compare_names",
      "description": "Several first names side by side: people living in Switzerland, median year of birth, newborn rank.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "names": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "description": "Up to ten first names."
          }
        },
        "required": [
          "names"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "ch.opendata/vornamen",
    "version": "1.0.0",
    "remoteUrl": "https://vornamen.opendata.ch/mcp",
    "publishedAt": "2026-11-21T19:57:29.592514Z",
    "fetchedAt": "2026-11-22T12:49:37.224Z",
    "toolsSha256": "dfe3c841f0d8ff6b5e24d8547b7255d2c4356228986856d8d3383a598a325fe9"
  }
}
