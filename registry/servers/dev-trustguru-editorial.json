{
  "$schema": "../schema.json",
  "name": "dev.trustguru/editorial",
  "title": "Trust Guru Editorial",
  "category": "Design, UI & 3D Media",
  "description": "Find and cite Trust Guru guides and dated sources for India, Brazil, and Mexico.",
  "tools": [
    {
      "name": "search_guides",
      "description": "Search one market by brand or task, returning canonical guide links and matching section anchors.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "market": {
            "type": "string",
            "enum": [
              "IN",
              "BR",
              "MX"
            ],
            "description": "India (IN), Brazil (BR), or Mexico (MX)."
          },
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "limit": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "market",
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "read_guide",
      "description": "Read a guide overview and its section list, or retrieve one published section with its cited sources and check dates.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^\\/(?:en-in|pt-br|es-mx)\\/(?:[a-z0-9-]+\\/)+$",
            "description": "Guide path returned by search_guides."
          },
          "section": {
            "description": "Published section anchor, without the # prefix.",
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[\\w-]+$"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "dev.trustguru/editorial",
    "version": "0.1.0",
    "remoteUrl": "https://trustguru.dev/mcp",
    "publishedAt": "2026-11-24T02:58:25.224252Z",
    "fetchedAt": "2026-11-24T12:15:48.059Z",
    "toolsSha256": "804c3a9f66870adeab0700466c6edf41d016182796ec13e1d28e369f53101991"
  }
}
