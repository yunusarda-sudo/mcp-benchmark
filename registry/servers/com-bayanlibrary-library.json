{
  "$schema": "../schema.json",
  "name": "com.bayanlibrary/library",
  "title": "Bayān library",
  "category": "Jobs, Career & Learning",
  "description": "Read-only search of the Quran, hadith and classical books of the four Sunni schools, with citations.",
  "tools": [
    {
      "name": "search",
      "description": "Find passages, hadith and works of Bayān's library. Each passage or hadith comes with its ref, its citation and its public url. works, authors, death_year_from/death_year_to, genres and schools restrict the search: filters combine with AND, values of one filter with OR; take their values from list_works.",
      "inputSchema": {
        "properties": {
          "query": {
            "description": "Words to find, in Arabic, English or French.",
            "maxLength": 200,
            "minLength": 2,
            "title": "Query",
            "type": "string"
          },
          "kinds": {
            "default": [
              "passage",
              "hadith",
              "work"
            ],
            "description": "What to find: passages, hadith, works.",
            "items": {
              "$ref": "#/$defs/OpenKind"
            },
            "maxItems": 3,
            "minItems": 1,
            "title": "Kinds",
            "type": "array"
          },
          "works": {
            "anyOf": [
              {
                "items": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 20,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only these works: their slugs, from list_works or lookup_work. Any of them matches.",
            "title": "Works"
          },
          "language": {
            "default": "en",
            "description": "Language of titles and of the translation attached.",
            "enum": [
              "ar",
              "en",
              "fr"
            ],
            "title": "Language",
            "type": "string"
          },
          "limit": {
            "default": 8,
            "description": "Hits to return.",
            "maximum": 10,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "authors": {
            "anyOf": [
              {
                "items": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 20,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only works by these authors: each an author_key from list_works, the Arabic name exactly as listed (e.g. \"محمد بن إسماعيل البخاري\"), not the Latin name. Any of them matches.",
            "title": "Authors"
          },
          "death_year_from": {
            "anyOf": [
              {
                "maximum": 1500,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only works whose author died in this hijri year or later (e.g. 200). Works without a stated year are left out.",
            "title": "Death Year From"
          },
          "death_year_to": {
            "anyOf": [
              {
                "maximum": 1500,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only works whose author died in this hijri year or earlier (e.g. 300). Works without a stated year are left out.",
            "title": "Death Year To"
          },
          "genres": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/Discipline"
                },
                "maxItems": 17,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only works of these genres, the library's disciplines as list_works names them. Any of them matches.",
            "title": "Genres"
          },
          "schools": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "hanafi",
                    "maliki",
                    "shafii",
                    "hanbali"
                  ],
                  "type": "string"
                },
                "maxItems": 4,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only works of these schools (madhhab). Any of them matches.",
            "title": "Schools"
          }
        },
        "required": [
          "query"
        ],
        "type": "object",
        "$defs": {
          "Discipline": {
            "description": "The disciplines of the library, in the order a reader meets them.",
            "enum": [
              "quran",
              "hadith",
              "commentaries",
              "fiqh_hanafi",
              "fiqh_maliki",
              "fiqh_shafii",
              "fiqh_hanbali",
              "usul_fiqh",
              "hadith_sciences",
              "narrators",
              "aqida",
              "quran_sciences",
              "arabic",
              "lexicons",
              "hadith_criticism",
              "atraf",
              "other"
            ],
            "title": "Discipline",
            "type": "string"
          },
          "OpenKind": {
            "description": "What a search finds in the open library.",
            "enum": [
              "passage",
              "hadith",
              "work"
            ],
            "title": "OpenKind",
            "type": "string"
          }
        },
        "title": "searchArguments"
      }
    },
    {
      "name": "get_passage",
      "description": "Read a passage by its ref: the Arabic text, its stored translation when there is one, its citation, the edition's attribution and neighbouring passages.",
      "inputSchema": {
        "properties": {
          "ref": {
            "description": "A passage ref from search.",
            "maxLength": 22,
            "minLength": 22,
            "title": "Ref",
            "type": "string"
          },
          "context": {
            "default": 0,
            "description": "Neighbouring passages of the same edition to add on each side.",
            "maximum": 3,
            "minimum": 0,
            "title": "Context",
            "type": "integer"
          },
          "language": {
            "default": "en",
            "description": "Language of titles and of the translation attached.",
            "enum": [
              "ar",
              "en",
              "fr"
            ],
            "title": "Language",
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "type": "object",
        "title": "get_passageArguments"
      }
    },
    {
      "name": "get_verse",
      "description": "Read one verse of the Quran or a run of verses: the Arabic text, the translation with its credit, and refs to the tafsir passages linked to them.",
      "inputSchema": {
        "properties": {
          "sura": {
            "maximum": 114,
            "minimum": 1,
            "title": "Sura",
            "type": "integer"
          },
          "aya": {
            "maximum": 286,
            "minimum": 1,
            "title": "Aya",
            "type": "integer"
          },
          "end_aya": {
            "anyOf": [
              {
                "maximum": 286,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Last verse of a range of at most 10 verses.",
            "title": "End Aya"
          },
          "language": {
            "default": "en",
            "description": "Language of titles and of the translation attached.",
            "enum": [
              "ar",
              "en",
              "fr"
            ],
            "title": "Language",
            "type": "string"
          }
        },
        "required": [
          "sura",
          "aya"
        ],
        "type": "object",
        "title": "get_verseArguments"
      }
    },
    {
      "name": "lookup_work",
      "description": "Find works of the library by title, author or slug; a slug restricts a search to its work.",
      "inputSchema": {
        "properties": {
          "query": {
            "description": "A title, an author or a slug, in Arabic or Latin letters.",
            "maxLength": 200,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "language": {
            "default": "en",
            "description": "Language of titles and of the translation attached.",
            "enum": [
              "ar",
              "en",
              "fr"
            ],
            "title": "Language",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object",
        "title": "lookup_workArguments"
      }
    },
    {
      "name": "list_works",
      "description": "List the works of the library with their slug, author_key, author's death year (hijri), genre and school, and the authors, genres and schools they cover: the values search's filters take. The same filters narrow the list.",
      "inputSchema": {
        "properties": {
          "language": {
            "default": "en",
            "description": "Language of titles and of the translation attached.",
            "enum": [
              "ar",
              "en",
              "fr"
            ],
            "title": "Language",
            "type": "string"
          },
          "works": {
            "anyOf": [
              {
                "items": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 20,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only these works: their slugs, from list_works or lookup_work. Any of them matches.",
            "title": "Works"
          },
          "authors": {
            "anyOf": [
              {
                "items": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 20,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only works by these authors: each an author_key from list_works, the Arabic name exactly as listed (e.g. \"محمد بن إسماعيل البخاري\"), not the Latin name. Any of them matches.",
            "title": "Authors"
          },
          "death_year_from": {
            "anyOf": [
              {
                "maximum": 1500,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only works whose author died in this hijri year or later (e.g. 200). Works without a stated year are left out.",
            "title": "Death Year From"
          },
          "death_year_to": {
            "anyOf": [
              {
                "maximum": 1500,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only works whose author died in this hijri year or earlier (e.g. 300). Works without a stated year are left out.",
            "title": "Death Year To"
          },
          "genres": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/Discipline"
                },
                "maxItems": 17,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only works of these genres, the library's disciplines as list_works names them. Any of them matches.",
            "title": "Genres"
          },
          "schools": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "hanafi",
                    "maliki",
                    "shafii",
                    "hanbali"
                  ],
                  "type": "string"
                },
                "maxItems": 4,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only works of these schools (madhhab). Any of them matches.",
            "title": "Schools"
          }
        },
        "type": "object",
        "$defs": {
          "Discipline": {
            "description": "The disciplines of the library, in the order a reader meets them.",
            "enum": [
              "quran",
              "hadith",
              "commentaries",
              "fiqh_hanafi",
              "fiqh_maliki",
              "fiqh_shafii",
              "fiqh_hanbali",
              "usul_fiqh",
              "hadith_sciences",
              "narrators",
              "aqida",
              "quran_sciences",
              "arabic",
              "lexicons",
              "hadith_criticism",
              "atraf",
              "other"
            ],
            "title": "Discipline",
            "type": "string"
          }
        },
        "title": "list_worksArguments"
      }
    }
  ],
