        "properties": {
          "start_unix": {
            "type": "string"
          },
          "end_unix": {
            "type": "string"
          }
        },
        "required": [
          "start_unix",
          "end_unix"
        ]
      }
    },
    {
      "name": "IdempotencyKey",
      "description": "The same idempotency key for a buyer and resource for 24 hours.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "buyer_id": {
            "type": "string"
          },
          "resource_id": {
            "type": "string"
          }
        },
        "required": [
          "buyer_id",
          "resource_id"
        ]
      }
    },
