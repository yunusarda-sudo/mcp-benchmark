      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "chain_id": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "memo": {
            "type": "string"
          }
        },
        "required": [
          "chain_id",
          "address",
          "memo"
        ]
      }
    },
    {
      "name": "HexUtf8",
      "description": "Convert hex to UTF-8, or UTF-8 to hex.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          }
        },
        "required": [
          "value",
          "direction"
        ]
      }
    },
    {
