{
  "$schema": "../schema.json",
  "name": "com.agentreststop/agent-rest-stop",
  "title": "Agent Rest Stop",
  "category": "AI, LLMs & Agents",
  "description": "Search and read the web. Pay USDC on Base per call, or one Lightning settlement.",
  "tools": [
    {
      "name": "WebRead",
      "description": "Read a public web page as clean article text. Send {\"url\":\"https://...\"} for one page at $0.002, or {\"urls\":[\"https://...\"]} for up to 10 pages at $0.002 each. Plain fetch, no JavaScript.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "WebSearch",
      "description": "Web search. Send {\"query\":\"...\"} and get ranked results with title, URL, domain, snippet, and description. Each result includes a POST /read call at $0.002.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "TokenSnapshot",
      "description": "Base token info, ERC-20. Look up the name, symbol, decimals, total supply, and raw supply of a token on Base. Send a ticker such as USDC, or the contract address.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ]
      }
    },
    {
      "name": "SpotPrice",
      "description": "Current ETH price in USD and BTC. Current USD price ETH, plus the 24 hour high, low, change, volume, and the time of the quote. An empty body returns ETH.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          }
        },
        "required": [
          "symbol"
        ]
      }
    },
    {
      "name": "CryptoPrice",
      "description": "Token price. USD spot price for a ticker such as ETH, BTC, or SOL, with the 24 hour high, low, change, and volume. Send {\"symbol\":\"ETH\"}.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          }
        },
        "required": [
          "symbol"
        ]
      }
    },
    {
      "name": "Weather",
      "description": "Current weather by city. Temperature, conditions, rain, wind, humidity, and the next hours. Send {\"city\":\"London\"}, or latitude and longitude.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "city": {
            "type": "string"
          }
        },
        "required": [
          "city"
        ]
      }
    },
    {
      "name": "CoinGap",
      "description": "Coin pair quote. Mid price and amount out for a have/want pair from the live USD price.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "have": {
            "type": "string"
          },
          "want": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          }
        },
        "required": [
          "have",
          "want",
          "amount"
        ]
      }
    },
    {
      "name": "GasBuffer",
      "description": "Base gas price. Current base fee, priority fee tiers, ready-to-sign max fee, and what a 21000-gas transfer costs in ETH and USD.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "chain": {
            "type": "string"
          },
          "tx_count": {
            "type": "string"
          }
        },
        "required": [
          "chain",
          "tx_count"
        ]
      }
    },
    {
      "name": "StablePeg",
      "description": "Stablecoin peg. Live price and deviation in basis points for USDC, USDT, and DAI. An empty body returns all three.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          }
        },
        "required": [
          "symbol"
        ]
      }
    },
    {
      "name": "RouteOneHop",
      "description": "One-hop route. The venue and slope for a have/want pair from the route table.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "have": {
            "type": "string"
          },
          "want": {
            "type": "string"
          }
        },
        "required": [
          "have",
          "want"
        ]
      }
    },
    {
      "name": "SlippageCap",
      "description": "Slippage cap. Largest order size that stays under a basis-point cap.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "amount_usd": {
            "type": "string"
          },
          "max_bps": {
            "type": "string"
          }
        },
        "required": [
          "amount_usd",
          "max_bps"
        ]
      }
    },
    {
      "name": "SchemaGate",
      "description": "Validate JSON keys and types. Send a schema of key to type name and the payload to check.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "schema": {
            "type": "string"
          },
          "payload": {
            "type": "string"
          }
        },
        "required": [
          "schema",
          "payload"
        ]
      }
    },
    {
      "name": "HashMatch",
      "description": "SHA-256 compare. Pass or fail a value against a sha256 hex digest.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "left": {
            "type": "string"
          },
          "right": {
            "type": "string"
          },
          "algo": {
            "type": "string"
          }
        },
        "required": [
          "left",
          "right",
          "algo"
        ]
      }
    },
    {
      "name": "Checksum",
      "description": "EIP-55 checksum. Send an address and get the checksummed form. A mixed-case address must already match.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "chain_id": {
            "type": "string"
          }
        },
        "required": [
          "address",
          "chain_id"
        ]
      }
    },
    {
      "name": "ReceiptAudit",
      "description": "x402 receipt check. Confirms a receipt has a network and an amount. Does not settle it again.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "payment_response": {
            "type": "string"
          }
        },
        "required": [
          "payment_response"
        ]
      }
    },
    {
      "name": "AllowlistStamp",
      "description": "Allowlist check. Pass or fail an address against a named list stored for this service.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "list_id": {
            "type": "string"
          }
        },
        "required": [
          "address",
          "list_id"
        ]
      }
    },
    {
      "name": "CrashLocker",
      "description": "Store one JSON document up to 8KB and return its locker id.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "doc": {
            "type": "string"
          }
        },
        "required": [
          "doc"
        ]
      }
    },
    {
      "name": "LockerRead",
      "description": "Read one stored JSON document by its locker id.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          }
        },
        "required": [
          "key"
        ]
      }
    },
    {
      "name": "SnapshotDiff",
      "description": "Diff two stored JSON documents at the top level.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "key_a": {
            "type": "string"
          },
          "key_b": {
            "type": "string"
          }
        },
        "required": [
          "key_a",
          "key_b"
        ]
      }
    },
    {
      "name": "BannerMint",
      "description": "Store an SVG banner and return its public URL.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "line": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "line"
        ]
      }
    },
    {
      "name": "ReceiptArchive",
      "description": "Append one receipt line for an agent id.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "receipt": {
            "type": "string"
          }
        },
        "required": [
          "agent_id",
          "receipt"
        ]
      }
    },
    {
      "name": "AgentCard",
      "description": "Build an agent card from a name, a purpose, and a tool list.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "tools": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "purpose",
          "tools"
        ]
      }
    },
    {
      "name": "LlmsTxt",
      "description": "Build an llms.txt document from a name, a purpose, and links.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "links": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "purpose",
          "links"
        ]
      }
    },
    {
      "name": "McpManifest",
      "description": "Build a small MCP manifest from a name and a tool list.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "tools": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "tools"
        ]
      }
    },
    {
      "name": "RegistryList",
      "description": "Add one guest card to the public directory for 24 hours.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "card": {
            "type": "string"
          },
          "payer": {
            "type": "string"
          }
        },
        "required": [
          "card",
          "payer"
        ]
      }
    },
    {
      "name": "DiscoverQuery",
      "description": "Find tools on this service by need, such as price, proof, or storage.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "need": {
            "type": "string"
          }
        },
        "required": [
          "need"
        ]
      }
    },
    {
      "name": "BudgetSplit",
      "description": "Split a dollar budget by weight without passing each item's cap.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "budget_usd": {
            "type": "string"
          },
          "items": {
            "type": "string"
          }
        },
        "required": [
          "budget_usd",
          "items"
        ]
      }
    },
    {
      "name": "RetryPlan",
      "description": "Choose retry, pay, or abort from an HTTP status.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "error"
        ]
      }
    },
    {
      "name": "DeadlineGuard",
      "description": "Go or stop by comparing a deadline with the current time.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "deadline_unix": {
            "type": "string"
          }
        },
        "required": [
          "deadline_unix"
        ]
      }
    },
    {
      "name": "UsdSatsQuote",
      "description": "USD to satoshis. Convert dollars into USDC atomic units and BTC sats.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "usd": {
            "type": "string"
          }
        },
        "required": [
          "usd"
        ]
      }
    },
    {
      "name": "DuplicateGuard",
      "description": "Remember a buyer and resource for the rest of the day. The first call is new.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "buyer_id": {
            "type": "string"
          },
          "resource_id": {
            "type": "string"
          }
        },
        "required": [
          "buyer_id",
          "resource_id"
        ]
      }
    },
    {
      "name": "FreshNonce",
