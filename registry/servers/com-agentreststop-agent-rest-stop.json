      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "chain": {
            "type": "string"
          }
        },
        "required": [
          "address",
          "chain"
        ]
      }
    },
    {
      "name": "ClockSkew",
      "description": "Clock skew in seconds between a client unix time and this service.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "client_unix": {
            "type": "string"
          }
        },
        "required": [
          "client_unix"
        ]
      }
    },
    {
      "name": "BlockLag",
      "description": "Block number. Latest block on Base, Ethereum, Optimism, Arbitrum, or Polygon, with the block time and how far behind a client block is.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "chain": {
            "type": "string"
          },
          "client_block": {
            "type": "string"
          }
        },
        "required": [
          "chain",
          "client_block"
        ]
      }
    },
    {
      "name": "WindowOpen",
