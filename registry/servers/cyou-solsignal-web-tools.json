{
  "$schema": "../schema.json",
  "name": "cyou.solsignal/web-tools",
  "title": "SolSignal Web Tools",
  "category": "Web Scraping & Automation",
  "description": "Web page to Markdown (JS rendering), link extraction, PDF to text, image OCR. Free tier + x402.",
  "tools": [
    {
      "name": "web_to_markdown",
      "description": "Fetch any public web page and return clean Markdown (main article content by default, or the full page). Renders JavaScript-heavy pages in headless Chromium automatically when needed. Returns title, byline, markdown.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2000,
            "format": "uri",
            "description": "Public http(s) URL"
          },
          "mode": {
            "type": "string",
            "enum": [
              "article",
              "full"
            ]
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 100000
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "web_links",
      "description": "Extract all links (internal/external, anchor text), title, description, OpenGraph image, canonical URL and RSS/Atom feeds from a web page.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2000,
            "format": "uri",
            "description": "Public http(s) URL"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "pdf_to_text",
      "description": "Download a PDF from a URL (up to 25 MB) and extract its text layer, page count, title and author.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2000,
            "format": "uri",
            "description": "Public http(s) URL"
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 100000
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "image_ocr",
      "description": "OCR: extract text from an image URL (PNG/JPEG/GIF/TIFF/WebP). Languages: eng, deu, fra, spa, ita, por (join with +).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2000,
            "format": "uri",
            "description": "Public http(s) URL"
          },
          "lang": {
            "type": "string",
            "pattern": "^(eng|deu|fra|spa|ita|por)(\\+(eng|deu|fra|spa|ita|por))*$"
          }
        },
        "required": [
          "url"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "cyou.solsignal/web-tools",
    "version": "1.0.0",
    "remoteUrl": "https://tools.solsignal.cyou/mcp",
    "publishedAt": "2026-11-22T19:56:30.993485Z",
    "fetchedAt": "2026-11-23T16:50:40.239Z",
    "toolsSha256": "f81b84c6aff3e94c45f457abab927a2068f01979647b4ed84f14653dfdad44c2"
  }
}
