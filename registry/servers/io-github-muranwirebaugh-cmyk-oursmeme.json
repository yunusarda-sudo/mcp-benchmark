{
  "$schema": "../schema.json",
  "name": "io.github.muranwirebaugh-cmyk/oursmeme",
  "title": "OursMeme BNB Chain Perpetuals",
  "category": "Developer Tools & DevOps",
  "description": "48-tool BNB Chain perpetual DEX MCP for live Pyth BTC/ETH/XAU quotes and unsigned EVM calldata.",
  "repository": "https://github.com/muranwirebaugh-cmyk/ours-mcp",
  "tools": [
    {
      "name": "get_rules",
      "description": "返回 OursMeme 的产品规则：手续费、资金费、LP、收入分配、meme 代币、分红、亏损挖矿、平台积分，以及使用这些工具的注意事项。第一次接入时先读一遍。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_overview",
      "description": "各标的（BTC / ETH / 24/7 XAU 连续黄金指数等）的汇总：当前价格（Pyth 实时报价中间价，美元）、池子总规模、24 小时交易量、多头占比。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_stats",
      "description": "某个标的在一段时间内的统计和按天序列：池子、交易量、新市场数、清算次数和规模、平台收入、交易者盈亏。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "under": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{1,11}$",
            "description": "标的代号，如 BTC / ETH / XAU；平台可以添加新标的"
          },
          "range": {
            "default": "30d",
            "type": "string",
            "enum": [
              "24h",
              "7d",
              "30d"
            ]
          }
        },
        "required": [
          "under",
          "range"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_markets",
      "description": "列出合约市场，可按标的筛选并排序。返回 slug、代号、池子规模、24h 交易量、持仓量、多头占比、资金费、LP 年化、最大杠杆、代币价格等。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "under": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{1,11}$",
            "description": "标的代号，如 BTC / ETH / XAU；平台可以添加新标的"
          },
          "coinMargined": {
            "default": false,
            "description": "true 时查询 Meme 代币本位永续市场（以 Meme 代币自身作为保证金）",
            "type": "boolean"
          },
          "sort": {
            "default": "vol24h",
            "type": "string",
            "enum": [
              "vol24h",
              "pool",
              "oi",
              "lpApr",
              "fees7d",
              "tokenChg24h",
              "ageDays"
            ]
          },
          "order": {
            "default": "desc",
            "type": "string",
            "enum": [
              "desc",
              "asc"
            ]
          },
          "limit": {
            "default": 30,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "officialOnly": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "coinMargined",
          "sort",
          "order",
          "limit",
          "officialOnly"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_market",
      "description": "单个市场的完整数据，以及它的合约地址（市场、共享池 glv、锁仓金库、代币、底池、分配器、分红、挖矿）和当前链上买一 / 卖一价。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market": {
            "description": "市场：短链接 slug、市场合约地址、代币地址、代币代号，或标的代号如 BTC / ETH / XAU（表示该标的的官方市场）"
          }
        },
        "required": [
          "market"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_price",
      "description": "某市场（或标的）当前链上实时执行价（主流与 24/7 XAU 连续黄金指数等来自 Pyth 实时报价，Meme 币本位来自链上 DEX TWAP 喂价）：买一、卖一和中间价（美元）。开多/平空按卖一成交，开空/平多按买一成交。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market": {
            "description": "市场：短链接 slug、市场合约地址、代币地址、代币代号，或标的代号如 BTC / ETH / XAU（表示该标的的官方市场）"
          }
        },
        "required": [
          "market"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_market_trades",
      "description": "某市场最近的合约成交（开平仓、清算、ADL），含方向、规模、价格、盈亏、手续费。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market": {
            "description": "市场：短链接 slug、市场合约地址、代币地址、代币代号，或标的代号如 BTC / ETH / XAU（表示该标的的官方市场）"
          },
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "market",
          "limit"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_candles",
      "description": "某市场 meme 代币的 K 线（来自链上内盘发射曲线和毕业后 PancakeSwap V2 成交）。标的本身（含 24/7 XAU 连续黄金指数）的实时报价请用 get_price 或直接查 Pyth。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market": {
            "description": "市场：短链接 slug、市场合约地址、代币地址、代币代号，或标的代号如 BTC / ETH / XAU（表示该标的的官方市场）"
          },
          "interval": {
            "default": "1h",
            "type": "string",
            "enum": [
              "1m",
              "5m",
              "15m",
              "1h",
              "4h",
              "1d"
            ]
          }
        },
        "required": [
          "market",
          "interval"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_lp_history",
      "description": "某市场 LP 份额净值、手续费收入、交易者盈亏的按天历史。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market": {
            "description": "市场：短链接 slug、市场合约地址、代币地址、代币代号，或标的代号如 BTC / ETH / XAU（表示该标的的官方市场）"
          },
          "days": {
            "default": 30,
            "description": "查询 LP 历史统计天数（1–3650，默认 30 天）",
            "type": "integer",
            "minimum": 1,
            "maximum": 3650
          }
        },
        "required": [
          "market",
          "days"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_creators",
      "description": "市场创建者（dev）列表：名称、站点、钱包、创建的市场数。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_creator",
      "description": "单个创建者的信息，可以传钱包地址或站点名。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "creator": {
            "description": "创建者钱包地址或站点名"
          }
        },
        "required": [
          "creator"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_feed",
      "description": "平台最新动态：新市场、代币买卖、分红、回购。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_liquidations",
      "description": "清算榜：最近被清算的仓位、即将被清算的高风险仓位及汇总。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_leaderboard",
      "description": "排行榜。pnl：交易者已实现盈亏榜（含收益率、胜率、交易量、清算次数、跟单人数）；roi：交易者收益率榜（已实现盈亏 ÷ 投入保证金，需投入不少于 20 USDC、平仓不少于 2 笔）；volume：交易者交易量榜；market：市场交易量榜；creator：创建者分给 LP 和持币人的收入榜。交易者榜可以用 market 只看某个市场、site 只看某个创建者站点的市场、search 按地址或前缀查名次。疑似对敲（镜像开仓）的地址不参与排名。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "board": {
            "default": "pnl",
            "type": "string",
            "enum": [
              "pnl",
              "roi",
              "volume",
              "market",
              "creator"
            ]
          },
          "range": {
            "default": "7d",
            "description": "统计区间：24h / 7d / 30d / all",
            "type": "string",
            "enum": [
              "24h",
              "7d",
              "30d",
              "all"
            ]
          },
          "market": {
            "description": "只统计某个市场（仅交易者榜）"
          },
          "site": {
            "description": "只统计这个创建者（dev 地址）名下的市场"
          },
          "search": {
            "description": "按地址或地址前缀查名次"
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "board",
          "range",
          "limit"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_market_positions",
      "description": "某市场当前所有未平仓位：多空仓位数与规模、多空平均开仓价、平均杠杆、前 10 大仓位占比，以及按规模排序的大户仓位（地址、方向、规模、保证金、杠杆、开仓价）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market": {
            "description": "市场：短链接 slug、市场合约地址、代币地址、代币代号，或标的代号如 BTC / ETH / XAU（表示该标的的官方市场）"
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "market",
          "limit"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_market_series",
      "description": "某市场的时间序列：24h 按小时，7d / 30d 按天。每个点有交易量、笔数、交易者数、新开多 / 新开空规模、清算次数和规模、交易者已实现盈亏、平仓利润费、代币成交额；按天时还有 LP 净值和池子规模。附区间合计。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market": {
            "description": "市场：短链接 slug、市场合约地址、代币地址、代币代号，或标的代号如 BTC / ETH / XAU（表示该标的的官方市场）"
          },
          "range": {
            "default": "7d",
            "type": "string",
            "enum": [
              "24h",
              "7d",
              "30d"
            ]
          }
        },
        "required": [
          "market",
          "range"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_token_holders",
      "description": "某市场 meme 代币的持币地址数和持币排行（数量、占总量 10 亿的百分比），并标出底池、挖矿储备、分红合约、dev 等非流通地址。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market": {
            "description": "市场：短链接 slug、市场合约地址、代币地址、代币代号，或标的代号如 BTC / ETH / XAU（表示该标的的官方市场）"
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "market",
          "limit"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_token_trades",
      "description": "某市场 meme 代币在内盘的最近买卖：时间、地址、方向、USDC、代币数量、成交价、手续费、交易哈希。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market": {
            "description": "市场：短链接 slug、市场合约地址、代币地址、代币代号，或标的代号如 BTC / ETH / XAU（表示该标的的官方市场）"
          },
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "market",
          "limit"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_trending",
      "description": "窗口内（1h / 6h / 24h）合约加代币成交额最高的市场（含交易者数、代币涨跌幅），以及最新创建的市场。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "window": {
            "default": "24h",
            "type": "string",
            "enum": [
              "1h",
              "6h",
              "24h"
            ]
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "window",
          "limit"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_account_stats",
      "description": "一个钱包的历史战绩：合约已实现盈亏、交易量、胜率、清算次数、手续费（总计和分市场），LP 存取金额，已领取的分红 / 挖矿 / dev / 返佣，亏损挖矿所得。仅允许本人 API Key / JWT 或已链上授权的子账户查询。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account": {
            "description": "用户钱包地址（交易的签名人和收款人）"
          },
          "range": {
            "default": "all",
            "type": "string",
            "enum": [
              "24h",
              "7d",
              "30d",
              "all"
            ]
          }
        },
        "required": [
          "account",
          "range"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_market_economics",
      "description": "某市场的收入统计（24h / 7d / 全部，v1 含平台、返佣、LP、dev、持币分红、回购各项）、回购销毁、分红发放与领取、代币成交额和手续费、亏损挖矿（已实现亏损、挖出代币）、推广返佣，以及最近的结算记录。判断持币分红收益、挖矿补贴力度时用。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market": {
            "description": "市场：短链接 slug、市场合约地址、代币地址、代币代号，或标的代号如 BTC / ETH / XAU（表示该标的的官方市场）"
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "market",
          "limit"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_account_rewards",
      "description": "一个钱包的奖励记录和合计：分红领取、亏损补贴（入账、解锁时间、领取）、持有代币所在市场的回购销毁、作为 dev 的收入结算和领取。挖矿代币按市场分开。仅允许本人 API Key / JWT 或已链上授权的子账户查询。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account": {
            "description": "用户钱包地址（交易的签名人和收款人）"
          },
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          }
        },
        "required": [
          "account",
          "limit"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_account_referrals",
      "description": "一个钱包作为邀请人的统计：邀请到的交易者数、近 7 天活跃数、他们 24 小时交易量、带来的盈利平仓费、已领返佣，按市场列出。仅允许本人 API Key / JWT 或已链上授权的子账户查询。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account": {
            "description": "用户钱包地址（交易的签名人和收款人）"
          }
        },
        "required": [
          "account"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_creator_economics",
      "description": "一个 dev（市场创建者）名下所有市场的累计收入、分给 LP / 持币人 / 回购的金额、dev 自己的收入、近 30 天每日收入，以及收入分配比例的修改记录。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account": {
            "description": "用户钱包地址（交易的签名人和收款人）"
          }
        },
        "required": [
          "account"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_account",
      "description": "一个钱包在平台上的全部状态：持仓（含强平价）、未成交委托（限价单、止盈止损，含订单 key）、可领取的资金费 / 分红（含外部导入代币 Merkle 分红）/ 挖矿、USDC 和 BNB 余额。仅允许本人 API Key / JWT 或已链上授权的子账户查询。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account": {
            "description": "用户钱包地址（交易的签名人和收款人）"
          }
        },
        "required": [
          "account"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_account_trades",
      "description": "一个钱包的历史成交，可按市场筛选。仅允许本人 API Key / JWT 或已链上授权的子账户查询。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account": {
            "description": "用户钱包地址（交易的签名人和收款人）"
          },
          "market": {
            "description": "市场：短链接 slug、市场合约地址、代币地址、代币代号，或标的代号如 BTC / ETH / XAU（表示该标的的官方市场）"
          },
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "account",
          "limit"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_order",
      "description": "按订单 key 查询订单状态（已创建 / 已成交 / 已取消 / 冻结）及成交结果。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {}
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "quote_token",
      "description": "某市场 meme 代币买或卖的报价：输入报价资产金额（买，通常是 USDC）或代币数量（卖），返回预计得到的数量和手续费。毕业前走内盘发射曲线，毕业后走 PancakeSwap V2（含代币税）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market": {
            "description": "市场：短链接 slug、市场合约地址、代币地址、代币代号，或标的代号如 BTC / ETH / XAU（表示该标的的官方市场）"
          },
          "side": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ]
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000000000000,
            "description": "买：花多少 USDC；卖：卖多少枚代币"
          }
        },
        "required": [
          "market",
          "side",
          "amount"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_launch_params",
      "description": "创建新市场时各参数的链上允许范围：创建费、首笔 LP 最小值、杠杆范围、报价资产和毕业募集额、代币税、资金费档位、收入分配规则。调用 build_launch_market 前先读。",
      "inputSchema": {
