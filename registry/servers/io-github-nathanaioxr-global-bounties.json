  "tools": [
    {
      "name": "search_bounties",
      "description": "Search source-checked mathematics prizes and science challenges.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "mathematics",
              "science",
              "math"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "UNDER_REVIEW",
              "ACTIVE_CLOSED_TO_NEW_ENTRIES",
              "CLOSED",
              "PAUSED"
            ]
          },
          "q": {
            "type": "string",
            "maxLength": 120
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    {
      "name": "get_prize_stats",
      "description": "Count open records and report prize and pool amounts separately.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      }
    }
  ],
