{
  "$schema": "../schema.json",
  "name": "BigQuery MCP",
  "category": "Databases & Storage",
  "description": "BigQuery MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "run_bigquery_sql",
      "description": "Submit SQL job to Google Cloud BigQuery and fetch dry-run or actual rows.",
      "inputSchema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "description": "Standard SQL query statement."
          },
          "maximumBytesBilled": {
            "type": "integer",
            "description": "Cost limit ceiling in bytes."
          }
        }
      }
    }
  ]
}
