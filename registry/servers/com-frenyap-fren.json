{
  "$schema": "../schema.json",
  "name": "com.frenyap/fren",
  "title": "FREN",
  "category": "Vector DBs & AI Search",
  "description": "Driving app tools: check country coverage, find places and plan driving routes. Read-only.",
  "tools": [
    {
      "name": "list_fren_countries",
      "description": "Lists the countries where FREN offers camera alerts, offline maps or offline navigation, with the availability of each. Returns country codes and names only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lang": {
            "type": "string",
            "maxLength": 8,
            "description": "Optional language code for the reply, for example en"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_fren_coverage",
      "description": "Reports whether camera alerts, offline maps and offline navigation are available in one country. Returns availability only and does not return any individual camera data.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "maxLength": 2,
            "pattern": "^[A-Za-z]{2}$",
            "description": "Two-letter ISO 3166-1 country code, for example DE"
          },
          "lang": {
            "type": "string",
            "maxLength": 8,
            "description": "Optional language code for the reply, for example en"
          }
        },
        "required": [
          "country"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "find_place",
      "description": "Finds up to 5 places matching a name in one country and returns their names and coordinates. Results come from OpenStreetMap data.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "maxLength": 2,
            "pattern": "^[A-Za-z]{2}$",
            "description": "Two-letter ISO 3166-1 country code, for example DE"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Name to search for"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Maximum number of results"
          },
          "lang": {
            "type": "string",
            "maxLength": 8,
            "description": "Optional language code for the reply, for example en"
          }
        },
        "required": [
          "country",
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "plan_route",
      "description": "Plans a driving route between two points in one country and returns the distance, the travel time and the main steps. It does not return a map, and drivers must follow road signs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "maxLength": 2,
            "pattern": "^[A-Za-z]{2}$",
            "description": "Two-letter ISO 3166-1 country code, for example DE"
          },
          "from": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "lat",
              "lon"
            ],
            "additionalProperties": false,
            "description": "Start point: latitude and longitude"
          },
          "to": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "lat",
              "lon"
            ],
            "additionalProperties": false,
            "description": "End point: latitude and longitude"
          },
          "lang": {
            "type": "string",
            "maxLength": 8,
            "description": "Optional language code for the reply, for example en"
          }
        },
        "required": [
          "country",
          "from",
          "to"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.frenyap/fren",
    "version": "1.0.1",
    "remoteUrl": "https://mcp.frenyap.com/mcp",
    "publishedAt": "2026-11-25T10:28:49.093149Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "0d190a1fef9e1048dba2ca024c64194d3c712336a2710273ed1b4311f0dfea21"
  }
}
