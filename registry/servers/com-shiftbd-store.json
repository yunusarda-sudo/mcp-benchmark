{
  "$schema": "../schema.json",
  "name": "com.shiftbd/store",
  "title": "ShiftBD AI Shopping",
  "category": "E-Commerce & Retail",
  "description": "AI shopping server for searching products and placing guest orders in Bangladesh.",
  "tools": [
    {
      "name": "search_products",
      "description": "Search active products by name, SKU, description or category. Returns current public prices and stock indication.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Product name, keyword or SKU"
          },
          "category": {
            "type": "string",
            "description": "Optional category name"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_product_details",
      "description": "Get full details of one active product by product ID or slug.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "integer"
          },
          "slug": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "list_categories",
      "description": "List active ShiftBD product categories.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "check_stock",
      "description": "Check current available stock for a product by ID or slug.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "integer"
          },
          "slug": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "calculate_shipping",
      "description": "Calculate configured ShiftBD delivery charge for inside or outside delivery area.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "area": {
            "type": "string",
            "enum": [
              "inside",
              "outside"
            ]
          }
        },
        "required": [
          "area"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "create_order",
      "description": "Create a cash-on-delivery order only after explicit customer confirmation. Supply a unique idempotency_key for each logical order and reuse the SAME key when retrying that order; never generate a new key for a retry. Reusing a key with different order details is rejected.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "idempotency_key": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          },
          "customer_name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "area": {
            "type": "string",
            "enum": [
              "inside",
              "outside"
            ]
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "product_id": {
                  "type": "integer"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                }
              },
              "required": [
                "product_id",
                "quantity"
              ],
              "additionalProperties": false
            }
          },
          "custom_message": {
            "type": "string",
            "maxLength": 2000,
            "description": "Optional customer delivery instruction, same as the human guest checkout Additional Message field."
          },
          "customer_confirmed": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "idempotency_key",
          "customer_name",
          "phone",
          "address",
          "area",
          "items",
          "customer_confirmed"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.shiftbd/store",
    "version": "1.0.0",
    "remoteUrl": "https://shiftbd.com/mcp",
    "publishedAt": "2026-11-24T18:52:51.941432Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "30bf33c9659879c2b39e5dfbe1e3552068334ef4c2110e7991879b167e279ef6"
  }
}
