{
  "$schema": "../schema.json",
  "name": "io.github.viren040/trucommerce-catalogue",
  "title": "TruCommerce Catalogue Pilot",
  "category": "Developer Tools & DevOps",
  "description": "Independent Indian product identity lookup from official brand sources. No live offers or checkout.",
  "tools": [
    {
      "name": "search_products",
      "description": "Search five source-checked Dermafique and ITC Master Chef product identities. Returns official brand links, no live offers.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 200,
            "default": ""
          },
          "brand": {
            "type": "string",
            "maxLength": 100
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 10
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_product",
      "description": "Get one product identity, official brand page and source-check date. Does not determine ingredient suitability or stock.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "product_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "compare_products",
      "description": "Compare 2–5 selected records by brand, title, category and official link. No best-product ranking or health claims.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "minItems": 2,
            "maxItems": 5
          }
        },
        "required": [
          "product_ids"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "catalogue_status",
      "description": "Read the public pilot coverage, freshness and limits.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.viren040/trucommerce-catalogue",
    "version": "0.1.0",
    "remoteUrl": "https://trucommerce-catalogue-pilot.netlify.app/mcp",
    "publishedAt": "2026-11-26T10:23:25.004458Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "e4fed3df27f5ab53cc8640e80ebd7e1e3898dc71ca5982264baee097d9599843"
  }
}
