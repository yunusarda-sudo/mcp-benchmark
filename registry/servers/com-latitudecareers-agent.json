{
  "$schema": "../schema.json",
  "name": "com.latitudecareers/agent",
  "title": "Latitude Careers",
  "category": "AI, LLMs & Agents",
  "description": "Career coaching in Sydney, online: services, prices, policies and request links you review and send.",
  "tools": [
    {
      "name": "list_services",
      "description": "Career coaching services, bundles and programs from Latitude Careers, an independent career coaching practice based in Sydney that coaches online across Australia and overseas (not Latitude Financial). Titles name the audience; quote the item that matches the person. Prices for Australian clients are in AUD and include GST; see the outside_australia policy for others. Ask the person's city or time zone rather than assuming Sydney.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "audience": {
            "description": "Only items for this audience",
            "type": "string",
            "enum": [
              "career-changer",
              "job-seeker",
              "university-student",
              "school-student"
            ]
          },
          "type": {
            "description": "Only this kind of item",
            "type": "string",
            "enum": [
              "service",
              "program",
              "bundle"
            ]
          },
          "market": {
            "default": "AU",
            "description": "Where the person lives or will attend sessions from; 'OTHER' for anywhere else",
            "type": "string",
            "enum": [
              "AU",
              "NZ",
              "US",
              "GB",
              "EU",
              "CH",
              "OTHER"
            ]
          },
          "locale": {
            "default": "en",
            "description": "'fr' is accepted; text is English until French content ships",
            "type": "string",
            "enum": [
              "en",
              "fr"
            ]
          }
        }
      }
    },
    {
      "name": "get_service",
      "description": "Full details of one service, bundle or program from Latitude Careers, an independent career coaching practice based in Sydney that coaches online across Australia and overseas (not Latitude Financial), as on the website: what's included, who it's for and how it works. Use an id from list_services.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "An item id from list_services, for example 'school-discover'; 'intro-call' is the free 15-minute call"
          },
          "locale": {
            "default": "en",
            "description": "'fr' is accepted; text is English until French content ships",
            "type": "string",
            "enum": [
              "en",
              "fr"
            ]
          }
        },
        "required": [
          "itemId"
        ]
      }
    },
    {
      "name": "explain_policies",
      "description": "Plain-language booking rules from the current Terms of Latitude Careers, an independent career coaching practice based in Sydney that coaches online across Australia and overseas (not Latitude Financial): rescheduling, change of plans, validity, under-18s, payment, employer invoices, clients outside Australia, time zones and privacy.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "topic": {
            "default": "all",
            "description": "One topic, or 'all'",
            "type": "string",
            "enum": [
              "rescheduling",
              "change_of_plans",
              "validity",
              "under_18",
              "payment",
              "employer_invoice",
              "outside_australia",
              "time_zones",
              "privacy",
              "all"
            ]
          },
          "locale": {
            "default": "en",
            "description": "'fr' is accepted; text is English until French content ships",
            "type": "string",
            "enum": [
              "en",
              "fr"
            ]
          }
        }
      }
    },
    {
      "name": "how_to_book",
      "description": "How to request a service from Latitude Careers, an independent career coaching practice based in Sydney that coaches online across Australia and overseas (not Latitude Financial): a prefilled request link for the person to complete and send. Requests aren't bookings; a coach replies within one business day. Ask the person's city or time zone rather than assuming Sydney, and pass only what they want to share: never names, emails or a conversation summary.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "An item id from list_services, for example 'school-discover'; 'intro-call' is the free 15-minute call"
          },
          "forWhom": {
            "description": "Who the sessions are for, in the request form's words, as prepare_request uses them: 'me', 'someone_else' (another adult the person is paying for), 'employer' (an employer pays), 'employee' (a manager or HR person asking for an employee) or 'my_teenager' (a parent booking a school service). School services take my_teenager only; adult services never do",
            "type": "string",
            "enum": [
              "me",
              "someone_else",
              "employer",
              "employee",
              "my_teenager"
            ]
          },
          "preferredTimes": {
            "description": "Times that suit the person",
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "weekday_mornings",
                "weekday_afternoons",
                "weekday_evenings",
                "weekends"
              ]
            }
          },
          "timeZone": {
            "description": "The person's IANA time zone, for example Australia/Perth; ask rather than assume",
            "type": "string",
            "maxLength": 64
          },
          "overseas": {
            "description": "True if the person lives outside Australia or will be overseas for the sessions",
            "type": "boolean"
          },
          "locale": {
            "default": "en",
            "description": "'fr' is accepted; text is English until French content ships",
            "type": "string",
            "enum": [
              "en",
              "fr"
            ]
          }
        },
        "required": [
          "itemId"
        ]
      }
    },
    {
      "name": "prepare_request",
      "description": "Latitude Careers, an independent career coaching practice based in Sydney that coaches online across Australia and overseas (not Latitude Financial): prepares a booking request, intro-call request or message with the details the person wants to send. Nothing is sent: give the person reviewUrl to check the details and press Send, and tell them what stillNeeded lists, which only they can give on that page. Ask for their city or time zone; don't assume Sydney. Fields this tool doesn't list, such as consent or payment details, are refused: the person gives those on the page.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "booking_request",
              "intro_call_request",
              "message"
            ]
          },
          "itemId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "forWhom": {
            "type": "string",
            "enum": [
              "me",
              "someone_else",
              "employer",
              "employee",
              "my_teenager"
            ]
          },
          "participant": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "email": {
                "type": "string",
                "maxLength": 254,
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              "studentName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "schoolYear": {
                "type": "string",
                "enum": [
                  "Year 9",
                  "Year 10",
                  "Year 11",
                  "Year 12"
                ]
              }
            },
            "additionalProperties": false
          },
          "employer": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "invoiceEmail": {
