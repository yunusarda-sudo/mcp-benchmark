{
  "$schema": "../schema.json",
  "name": "com.creatordeskai/machine-products",
  "title": "Creator Desk Machine Products",
  "category": "AI, LLMs & Agents",
  "description": "Pay-per-call x402 agent tools: extract, inspect, DNS, links, preflight, commerce.",
  "repository": "https://github.com/creatordeskai-prog/creator-desk-machine-products",
  "tools": [
    {
      "name": "creator_desk_verify_completion",
      "description": "Use when you have a storefront URL and supplied evidence and need a readiness verdict, defects, corrective actions, and an evidence receipt.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "standard_id": {
            "type": "string",
            "const": "CDS-COMMERCE-001",
            "description": "Commerce verification standard identifier."
          },
          "standard_version": {
            "type": "string",
            "const": "0.2.0",
            "description": "Commerce verification standard version."
          },
          "objective": {
            "type": "string",
            "maxLength": 2000,
            "description": "Optional goal for this verification."
          },
          "target_url": {
            "type": "string",
            "format": "uri",
            "description": "Public HTTPS commerce/storefront URL being verified."
          },
          "evidence": {
            "type": "object",
            "description": "Storefront evidence to check.",
            "additionalProperties": false,
            "properties": {
              "contact_url": {
                "type": "string",
                "format": "uri",
                "description": "Public contact page URL."
              },
              "shipping_url": {
                "type": "string",
                "format": "uri",
                "description": "Public shipping policy URL."
              },
              "returns_url": {
                "type": "string",
                "format": "uri",
                "description": "Public returns policy URL."
              },
              "privacy_url": {
                "type": "string",
                "format": "uri",
                "description": "Public privacy policy URL."
              },
              "terms_url": {
                "type": "string",
                "format": "uri",
                "description": "Public terms page URL."
              },
              "product": {
                "type": "object",
                "description": "Product details shown by the storefront.",
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "description": "Product title."
                  },
                  "price": {
                    "type": "object",
                    "description": "Product price and currency.",
                    "additionalProperties": false,
                    "properties": {
                      "amount": {
                        "type": "number",
                        "minimum": 0,
                        "description": "Nonnegative price amount."
                      },
                      "currency": {
                        "type": "string",
                        "pattern": "^[A-Za-z]{3}$",
                        "description": "Three-letter currency code."
                      }
                    }
                  },
                  "inventory": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "description": "Reported product inventory."
                  }
                }
              },
              "cart": {
                "type": "object",
                "description": "Shopping cart availability and URL.",
                "additionalProperties": false,
                "properties": {
                  "available": {
                    "type": "boolean",
                    "description": "Whether the cart is available."
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Public cart URL."
                  }
                }
              },
              "checkout": {
                "type": "object",
                "description": "Checkout availability and URL.",
                "additionalProperties": false,
                "properties": {
                  "available": {
                    "type": "boolean",
                    "description": "Whether checkout is available."
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Public checkout URL."
                  }
                }
              }
            }
          }
        },
        "required": [
          "target_url",
          "evidence"
        ]
      }
    },
    {
      "name": "creator_desk_inspect_url",
      "description": "Use when you have a public HTTPS URL and need its HTTP status, redirects, latency, security headers, and page metadata.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "Public HTTPS URL to inspect. Local/private destinations and non-443 ports are rejected."
          }
        }
      }
    },
    {
      "name": "creator_desk_extract_page",
      "description": "Use when you have a public HTTPS HTML page URL and need clean Markdown and page metadata.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "description": "Public HTTPS HTML page to read. Private/local destinations, embedded credentials and non-443 ports are rejected."
          }
        }
      }
    },
    {
      "name": "creator_desk_lookup_dns",
      "description": "Use when you have a public DNS hostname and optional record type and need the matching DNS records and lookup status.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host"
        ],
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "description": "Public DNS hostname. IP literals, single-label names and local/reserved suffixes are rejected."
          },
          "type": {
            "type": "string",
            "enum": [
              "A",
              "AAAA",
              "MX",
              "TXT",
              "NS",
              "CNAME",
              "CAA",
              "SOA"
            ],
            "default": "A",
            "description": "DNS record type to look up. Defaults to A. One of A, AAAA, MX, TXT, NS, CNAME, CAA, SOA."
          }
        }
      }
    },
    {
      "name": "creator_desk_check_broken_links",
      "description": "Use when you have up to 20 public HTTPS URLs and need per-link status, redirects, latency, and broken-link results.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "urls"
        ],
        "properties": {
          "urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            },
            "description": "1-20 public HTTPS URLs to check. Private/local targets and non-443 ports are rejected."
          }
        }
      }
    },
    {
      "name": "creator_desk_agent_preflight",
      "description": "Use when you have a public HTTPS agent origin and need an A2A and x402 readiness verdict with surface checks.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "origin"
        ],
        "properties": {
          "origin": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "Public HTTPS origin for the agent/service. Private/local destinations and non-443 ports are rejected."
          }
        }
      }
    },
    {
      "name": "creator_desk_word_count",
      "description": "Use when you have optional plain text and need its word count or a deterministic payment canary result.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000,
            "description": "Optional text to count. Omit for the deterministic canary sample."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "creator_desk_inspect_tls",
      "description": "Report the public HTTPS leaf certificate fields.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "description": "url for creator desk inspect tls."
          },
          "at": {
            "description": "at for creator desk inspect tls.",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "creator_desk_email_policy",
      "description": "Report MX, SPF, DMARC and BIMI records without deliverability claims.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 3,
            "maxLength": 253,
            "description": "domain for creator desk email policy."
          }
        },
        "required": [
          "domain"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "creator_desk_well_known",
      "description": "Inventory bounded public well-known and root files.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "description": "url for creator desk classify links."
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "creator_desk_structured_data",
      "description": "Extract literal JSON-LD fields from one page.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "description": "url for creator desk classify links."
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "creator_desk_list_forms",
      "description": "List page form actions and input attributes without submitting.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "description": "url for creator desk classify links."
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "creator_desk_parse_feed",
      "description": "Parse bounded RSS or Atom items.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "description": "url for creator desk parse feed."
          },
          "limit": {
            "description": "limit for creator desk parse feed.",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "creator_desk_lint_openapi",
      "description": "Structural OpenAPI 3.x lint with operations and broken references.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "url": {
            "description": "url for creator desk lint openapi.",
            "type": "string",
            "maxLength": 2048
          },
          "document": {
            "description": "document for creator desk lint openapi.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "creator_desk_parse_sitemap",
      "description": "Count sitemap URLs and report bounded samples.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "description": "url for creator desk parse sitemap."
          },
          "limit": {
            "description": "limit for creator desk parse sitemap.",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "creator_desk_test_robots",
      "description": "Evaluate robots allow and disallow rules for paths.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "origin": {
            "type": "string",
            "maxLength": 2048,
            "description": "origin for creator desk test robots."
          },
          "paths": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^\\/"
            },
            "description": "paths for creator desk test robots."
          },
          "user_agent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "user agent for creator desk test robots."
          }
        },
        "required": [
          "origin",
          "paths",
          "user_agent"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "creator_desk_validate_identifiers",
      "description": "Validate checksum and structure of non-payment identifiers.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "isbn10",
              "isbn13",
              "gtin",
              "iban",
              "issn",
              "luhn"
            ],
            "description": "type for creator desk validate identifiers."
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "value for creator desk validate identifiers."
          }
        },
        "required": [
          "type",
          "value"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "creator_desk_convert_timezone",
      "description": "Convert an explicit timestamp to an IANA zone.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "at for creator desk convert timezone."
          },
          "zone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "zone for creator desk convert timezone."
          }
        },
        "required": [
          "at",
          "zone"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "creator_desk_expand_schedule",
      "description": "Expand bounded occurrences from an explicit instant.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "expression for creator desk expand schedule."
          },
          "kind": {
            "type": "string",
            "enum": [
              "cron",
              "rrule"
            ],
            "description": "kind for creator desk expand schedule."
          },
          "from": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "from for creator desk expand schedule."
          },
          "count": {
            "description": "count for creator desk expand schedule.",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "zone": {
            "description": "zone for creator desk expand schedule.",
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "expression",
          "kind",
          "from"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "creator_desk_inspect_jwt",
      "description": "Decode JWT fields and optionally verify with public key material.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 10,
            "maxLength": 16000,
            "description": "token for creator desk inspect jwt."
          },
          "now": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "now for creator desk inspect jwt."
          },
          "jwks_url": {
            "description": "jwks url for creator desk inspect jwt.",
            "type": "string",
            "maxLength": 2048
          },
          "public_pem": {
            "description": "public pem for creator desk inspect jwt.",
            "type": "string",
            "maxLength": 10000
          }
        },
        "required": [
          "token",
          "now"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "creator_desk_inspect_headers",
      "description": "Parse cache, CORS, CSP, rate limit and cookie names.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "url": {
            "description": "url for creator desk inspect headers.",
            "type": "string",
            "maxLength": 2048
          },
          "headers": {
            "description": "headers for creator desk inspect headers.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "creator_desk_a11y_lite",
      "description": "Check deterministic HTML accessibility signals.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "description": "url for creator desk classify links."
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "creator_desk_classify_links",
