            "description": "url for creator desk select html."
          },
          "selectors": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": "selectors for creator desk select html."
          }
        },
        "required": [
