{
  "$schema": "../schema.json",
  "name": "com.creatordeskai/machine-products",
  "title": "Creator Desk Machine Products",
  "category": "AI, LLMs & Agents",
  "description": "Pay-per-call x402 agent tools: extract, inspect, DNS, links, preflight, commerce.",
  "repository": "https://github.com/creatordeskai-prog/CreatorDesk-x402-factory",
  "tools": [
    {
      "name": "creator_desk_verify_completion",
      "description": "Use when you have a storefront URL and supplied evidence and need a readiness verdict, defects, corrective actions, and an evidence receipt.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "standard_id": {
            "type": "string",
            "const": "CDS-COMMERCE-001"
          },
          "standard_version": {
            "type": "string",
            "const": "0.2.0"
          },
          "objective": {
            "type": "string",
            "maxLength": 2000
          },
          "target_url": {
            "type": "string",
            "format": "uri",
            "description": "Public HTTPS commerce/storefront URL being verified."
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "contact_url": {
                "type": "string",
                "format": "uri"
              },
              "shipping_url": {
                "type": "string",
                "format": "uri"
              },
              "returns_url": {
                "type": "string",
                "format": "uri"
              },
              "privacy_url": {
                "type": "string",
                "format": "uri"
              },
              "terms_url": {
                "type": "string",
                "format": "uri"
              },
              "product": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "price": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "amount": {
                        "type": "number",
                        "minimum": 0
                      },
                      "currency": {
                        "type": "string",
                        "pattern": "^[A-Za-z]{3}$"
                      }
                    }
                  },
                  "inventory": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                }
              },
              "cart": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "available": {
                    "type": "boolean"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              },
              "checkout": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "available": {
                    "type": "boolean"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "required": [
          "target_url",
          "evidence"
        ]
      }
    },
    {
      "name": "creator_desk_inspect_url",
      "description": "Use when you have a public HTTPS URL and need its HTTP status, redirects, latency, security headers, and page metadata.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "Public HTTPS URL to inspect. Local/private destinations and non-443 ports are rejected."
          }
        }
      }
    },
    {
      "name": "creator_desk_extract_page",
      "description": "Use when you have a public HTTPS HTML page URL and need clean Markdown and page metadata.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "description": "Public HTTPS HTML page to read. Private/local destinations, embedded credentials and non-443 ports are rejected."
          }
        }
      }
    },
    {
      "name": "creator_desk_lookup_dns",
      "description": "Use when you have a public DNS hostname and optional record type and need the matching DNS records and lookup status.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host"
        ],
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "description": "Public DNS hostname. IP literals, single-label names and local/reserved suffixes are rejected."
          },
          "type": {
            "type": "string",
            "enum": [
              "A",
              "AAAA",
              "MX",
              "TXT",
              "NS",
              "CNAME",
              "CAA",
              "SOA"
            ],
            "default": "A"
          }
        }
      }
    },
    {
      "name": "creator_desk_check_broken_links",
      "description": "Use when you have up to 20 public HTTPS URLs and need per-link status, redirects, latency, and broken-link results.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "urls"
        ],
        "properties": {
          "urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            },
            "description": "1-20 public HTTPS URLs to check. Private/local targets and non-443 ports are rejected."
          }
        }
      }
    },
    {
      "name": "creator_desk_agent_preflight",
      "description": "Use when you have a public HTTPS agent origin and need an A2A and x402 readiness verdict with surface checks.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "origin"
        ],
        "properties": {
          "origin": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "Public HTTPS origin for the agent/service. Private/local destinations and non-443 ports are rejected."
          }
        }
      }
    },
    {
      "name": "creator_desk_word_count",
      "description": "Use when you have optional plain text and need its word count or a deterministic payment canary result.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "creator_desk_machine_distribution_offers",
      "description": "Use when you need Creator Desk Machine Distribution pricing, its service page and available checkout or x402 links.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "creator_desk_machine_acquisition_offers",
      "description": "Use when you need Creator Desk Machine Acquisition Network pricing, its service page and available checkout or x402 links.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "creator_desk_machine_router_offers",
      "description": "Use when you need Creator Desk Machine Marketplace Router pricing, its service page and available checkout or x402 links.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.creatordeskai/machine-products",
    "version": "0.11.1",
    "remoteUrl": "https://api.creatordeskai.com/mcp",
    "publishedAt": "2026-11-24T15:06:23.500379Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "920e6eb06f39f5ad093b5fd6cf0b690b0e45da6893880c61c8de3256483ccb34"
  }
}
