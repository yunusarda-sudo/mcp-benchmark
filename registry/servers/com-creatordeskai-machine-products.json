      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "description": "url for creator desk classify links."
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    {
