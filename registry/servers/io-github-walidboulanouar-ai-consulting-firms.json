{
  "$schema": "../schema.json",
  "name": "io.github.walidboulanouar/ai-consulting-firms",
  "title": "AI Consulting Firms",
  "category": "Developer Tools & DevOps",
  "description": "Compare consulting firms by RFP scope and named client evidence.",
  "repository": "https://github.com/walidboulanouar/ai-consulting-firms-mcp",
  "tools": [
    {
      "name": "search_firms",
      "description": "Find AI consulting firms by name, specialty or workflow. Omit the query for the full directory. Results include IDs for compare_firms and links to sources.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "default": "",
            "type": "string",
            "maxLength": 160
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      }
    },
    {
      "name": "compare_firms",
      "description": "Compare two to five AI consulting firms by their directory IDs from search_firms. Returns profiles, source links and procurement questions.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ids": {
            "minItems": 2,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        },
        "required": [
          "ids"
        ]
      }
    },
    {
      "name": "recommend_providers",
      "description": "Read the editorial picks for AI consulting firms, each with a specific use case and supporting source. Use short project keywords, or omit the query to review all picks.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "default": "",
            "type": "string",
            "maxLength": 160
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.walidboulanouar/ai-consulting-firms",
    "version": "1.1.1",
    "remoteUrl": "https://theaiconsultingfirms.com/mcp",
    "publishedAt": "2026-11-25T21:26:12.628704Z",
