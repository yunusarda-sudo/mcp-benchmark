{
  "$schema": "../schema.json",
  "name": "com.pokemonlore/pokemonlore",
  "title": "PokemonLore MCP",
  "category": "Vector DBs & AI Search",
  "description": "Pokédex, team coverage, type matchups, stat calculator, TCG Pocket and Simplified Chinese PTCG.",
  "tools": [
    {
      "name": "get_pokemon",
      "description": "Look up a Pokémon by English/Japanese/Roomaji/Portuguese name, form slug (e.g. 'charizard-mega-x'), or National Pokédex ID. Returns base stats, Lv.50/100 stat ranges, abilities, defensive type matchups, evolution paths, localized names, and pokemonlore.com link.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            ],
            "description": "Pokémon name (English, Japanese, Roomaji, or Portuguese), PokéAPI slug, or Pokédex ID (e.g. 'Pikachu', 'ピカチュウ', 'garchomp', 445)."
          },
          "locale": {
            "description": "Preferred pokemonlore.com URL locale (default: 'en').",
            "type": "string",
            "enum": [
              "en",
              "ja",
              "pt-BR",
              "roomaji"
            ]
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "analyze_team",
      "description": "Analyze a Pokémon team of 1–6 members for generation-accurate defensive weaknesses, resistances, immunities, STAB offensive coverage gaps, and top recommended teammates with structured explanations.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "members": {
            "minItems": 1,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pokemon": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  ],
                  "description": "Pokémon name (multi-language), slug, or Pokédex ID."
                },
                "teraType": {
                  "description": "Optional Tera Type (applied for games supporting Terastallization, such as 'sv').",
                  "type": "string",
                  "enum": [
                    "normal",
                    "fighting",
                    "flying",
                    "poison",
                    "ground",
                    "rock",
                    "bug",
                    "ghost",
                    "steel",
                    "fire",
                    "water",
                    "grass",
                    "electric",
                    "psychic",
                    "ice",
                    "dragon",
                    "dark",
                    "fairy"
                  ]
                }
              },
              "required": [
                "pokemon"
              ]
            },
            "description": "1 to 6 team members."
          },
          "gameId": {
            "description": "Target game ID for dex availability and generation defaults (e.g. 'sv', 'swsh', 'lza', 'rby', 'dppt', 'champions'; default: 'sv').",
            "type": "string",
            "enum": [
              "rby",
              "gsc",
              "rse",
              "colo",
              "frlg",
              "xd",
              "dppt",
              "hgss",
              "bw",
              "b2w2",
              "xy",
              "oras",
              "sm",
              "usum",
              "lgpe",
              "swsh",
              "bdsp",
              "arceus",
              "sv",
              "lza",
              "home",
              "champions"
            ]
          },
          "generation": {
            "description": "Override type chart generation (1–9). Defaults to the selected game's generation.",
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "includeRecommendations": {
            "description": "Whether to compute top teammate recommendations (defaults to true when team has fewer than 6 Pokémon).",
            "type": "boolean"
          },
          "recommendationLimit": {
            "description": "Number of teammate recommendations to return (default: 5).",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "fullyEvolvedOnly": {
            "description": "Restrict teammate recommendations to fully evolved Pokémon in the target game (default: true).",
            "type": "boolean"
          }
        },
        "required": [
          "members"
        ]
      }
    },
    {
      "name": "get_type_matchups",
      "description": "Calculate defensive weaknesses/resistances/immunities (4x, 2x, 0.5x, 0.25x, 0x) and offensive STAB coverage for 1 or 2 Pokémon types, supporting Generation 1–9 type chart differences.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "types": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "normal",
                "fighting",
                "flying",
                "poison",
                "ground",
                "rock",
                "bug",
                "ghost",
                "steel",
                "fire",
                "water",
                "grass",
                "electric",
                "psychic",
                "ice",
                "dragon",
                "dark",
                "fairy"
              ]
            },
            "description": "One or two Pokémon types (e.g. ['water', 'ground'] or ['steel', 'fairy'])."
          },
          "generation": {
            "description": "Generation type chart to apply (1–9, default: 9).",
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          }
        },
        "required": [
          "types"
        ]
      }
    },
    {
      "name": "calculate_stats",
      "description": "Calculate exact Pokémon stats for a given level (1–100), nature, IVs (0–31), and EVs (0–252, total ≤ 510), plus Lv.50 and Lv.100 min/max ranges. Accepts either a Pokémon name/slug/ID or explicit base stats.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "pokemon": {
            "description": "Pokémon name, slug, or Pokédex ID to auto-load base stats (optional if baseStats is provided).",
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            ]
          },
          "baseStats": {
            "description": "Explicit base stats (optional if pokemon is provided).",
            "type": "object",
            "properties": {
              "hp": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "attack": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "defense": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "specialAttack": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "specialDefense": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "speed": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              }
            },
            "required": [
              "hp",
              "attack",
              "defense",
              "specialAttack",
              "specialDefense",
              "speed"
            ]
          },
          "level": {
            "description": "Pokémon level (1–100, default: 50).",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "nature": {
            "description": "Pokémon nature (e.g. 'adamant', 'timid', 'jolly', default: 'hardy').",
            "type": "string",
            "enum": [
              "hardy",
              "lonely",
              "brave",
              "adamant",
              "naughty",
              "bold",
              "docile",
              "relaxed",
              "impish",
              "lax",
              "timid",
              "hasty",
              "serious",
              "jolly",
              "naive",
              "modest",
              "mild",
              "quiet",
              "bashful",
              "rash",
              "calm",
              "gentle",
              "sassy",
              "careful",
              "quirky"
            ]
          },
          "ivs": {
            "description": "Individual Values per stat (0–31, defaults to 31 for omitted stats).",
            "type": "object",
            "properties": {
              "hp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              },
              "attack": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              },
              "defense": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              },
              "specialAttack": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              },
              "specialDefense": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              },
              "speed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              }
            }
          },
          "evs": {
            "description": "Effort Values per stat (0–252, total ≤ 510, defaults to 0 for omitted stats).",
            "type": "object",
            "properties": {
              "hp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 252
              },
              "attack": {
                "type": "integer",
                "minimum": 0,
                "maximum": 252
              },
              "defense": {
                "type": "integer",
                "minimum": 0,
                "maximum": 252
              },
              "specialAttack": {
                "type": "integer",
                "minimum": 0,
                "maximum": 252
              },
              "specialDefense": {
                "type": "integer",
                "minimum": 0,
                "maximum": 252
              },
              "speed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 252
              }
            }
          }
        }
      }
    },
    {
      "name": "search_tcg_pocket_cards",
      "description": "Search Pokémon TCG Pocket cards by name, card ID (e.g. 'A1-001'), expansion, energy type, rarity, ex status, full-art status, or artist. Call with no filters to also inspect available expansions, types, and rarities.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "description": "Search text matching card name, card ID, pack, or artist.",
            "type": "string"
          },
          "expansion": {
            "description": "Expansion ID (e.g. 'A1', 'A2', 'A2a') or name substring.",
            "type": "string"
          },
          "type": {
            "description": "Card energy type or 'Trainer' (e.g. 'Fire', 'Water', 'Lightning', 'Grass', 'Psychic', 'Fighting', 'Darkness', 'Metal', 'Dragon', 'Colorless', 'Trainer').",
            "type": "string"
          },
          "rarity": {
            "description": "Rarity symbol or name (e.g. '◊◊◊◊', '☆', '☆☆', '☆☆☆', 'Crown Rare').",
            "type": "string"
          },
          "exOnly": {
            "description": "Only return Pokémon ex cards.",
            "type": "boolean"
          },
          "fullartOnly": {
            "description": "Only return full-art / illustration / crown cards.",
            "type": "boolean"
          },
          "limit": {
            "description": "Maximum number of cards to return (1–50, default: 20).",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        }
      }
    },
    {
      "name": "search_ptcg_chs_cards",
      "description": "Search Simplified Chinese Pokémon TCG (PTCG-CHS) cards across all 245+ products and 24,500+ printings by Chinese name, verified English Pokémon name (e.g. 'Charizard ex', '皮卡丘'), product code (e.g. 'CSV10C', '151C'), collector number, rarity, card type, energy attribute, or series. Call with no filters to list the latest Chinese TCG products.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "description": "Search text matching Chinese card name, verified English Pokémon name, collector number, or illustrator.",
            "type": "string"
          },
          "collection": {
            "description": "Filter by collection slug (e.g. 'csv10c'), product code (e.g. 'CSV10C'), or Chinese product name.",
            "type": "string"
          },
          "cardType": {
            "description": "Filter by card category.",
            "type": "string",
            "enum": [
              "pokemon",
              "trainer",
              "energy"
            ]
          },
          "attribute": {
            "description": "Filter Pokémon cards by TCG energy type.",
            "type": "string",
            "enum": [
              "grass",
              "fire",
              "water",
              "lightning",
              "psychic",
              "fighting",
              "darkness",
              "metal",
              "fairy",
              "dragon",
              "colorless"
            ]
          },
          "rarity": {
            "description": "Filter by printed rarity (e.g. 'SAR', 'SR', 'AR', 'RR', 'UR', 'C', 'U', 'R').",
            "type": "string"
          },
          "series": {
            "description": "Filter by PTCG-CHS era/series.",
            "type": "string",
            "enum": [
              "sun-moon",
              "sword-shield",
              "scarlet-violet",
              "other"
            ]
          },
          "limit": {
            "description": "Maximum number of cards or collections to return (1–50, default: 20).",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
