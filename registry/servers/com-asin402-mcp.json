{
  "$schema": "../schema.json",
  "name": "com.asin402/mcp",
  "title": "ASIN402 Amazon Data",
  "category": "AI, LLMs & Agents",
  "description": "Live Amazon data for AI agents: prices, history, deals, FBA profit, sell scores. Pay per call.",
  "tools": [
    {
      "name": "check_deal",
      "description": "Compare an Amazon product's current price with its 30/90/180-day averages and typical range (outliers filtered). Returns verdict buy_now, fair_price, wait or verify_offer with the numbers behind it. Costs $0.02 (x402, USDC on Base).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "asin": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{10}$",
            "description": "Amazon ASIN, e.g. 0735211299"
          },
          "domain": {
            "type": "string",
            "enum": [
              "us",
              "uk",
              "de",
              "fr",
              "jp",
              "ca",
              "it",
              "es",
              "in",
              "mx",
              "br"
            ],
            "description": "Amazon marketplace, default us"
          }
        },
        "required": [
          "asin"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "sell_score",
      "description": "Score 0-100 for how good an Amazon product is to sell: demand, competition, Amazon on the listing, price stability, review moat, price fit, plus plain-language risk flags. Costs $0.10.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "asin": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{10}$",
            "description": "Amazon ASIN, e.g. 0735211299"
          },
          "domain": {
            "type": "string",
            "enum": [
              "us",
              "uk",
              "de",
              "fr",
              "jp",
              "ca",
              "it",
              "es",
              "in",
              "mx",
              "br"
            ],
            "description": "Amazon marketplace, default us"
          }
        },
        "required": [
          "asin"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "fba_profit",
      "description": "Referral fee, FBA fee, net profit, margin, ROI, break-even cost and max landed cost for 30% ROI for selling a product via Amazon FBA. Costs $0.05.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "asin": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{10}$",
            "description": "Amazon ASIN, e.g. 0735211299"
          },
          "domain": {
            "type": "string",
            "enum": [
              "us",
              "uk",
              "de",
              "fr",
              "jp",
              "ca",
              "it",
              "es",
              "in",
              "mx",
              "br"
            ],
            "description": "Amazon marketplace, default us"
          },
          "cost": {
            "type": "number",
            "minimum": 0,
            "description": "Your unit cost of goods"
          },
          "shipping": {
            "type": "number",
            "minimum": 0,
            "description": "Inbound shipping per unit"
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Override the sell price (default: current buy box)"
          }
        },
        "required": [
          "asin"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "product_snapshot",
      "description": "Current price (buy box, Amazon, lowest new/used), 30/90/180-day averages, sales rank, estimated monthly sales, rating, reviews and offer count for one product. Costs $0.005.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "asin": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{10}$",
            "description": "Amazon ASIN, e.g. 0735211299"
          },
          "domain": {
            "type": "string",
            "enum": [
              "us",
              "uk",
              "de",
              "fr",
              "jp",
              "ca",
              "it",
              "es",
              "in",
              "mx",
              "br"
            ],
            "description": "Amazon marketplace, default us"
          }
        },
        "required": [
          "asin"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "compare_marketplaces",
      "description": "Compare one ASIN's live price across Amazon US, UK, DE, FR, IT, ES, JP, CA, IN, MX and BR, converted to USD: cheapest and most expensive marketplace, spread and difference vs the US. Costs $0.03.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "asin": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{10}$",
            "description": "Amazon ASIN, e.g. 0735211299"
          },
          "marketplaces": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "us",
                "uk",
                "de",
                "fr",
                "jp",
                "ca",
                "it",
                "es",
                "in",
                "mx",
                "br"
              ]
            },
            "minItems": 2,
            "description": "Subset to compare (default all 11)"
          }
        },
        "required": [
          "asin"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_products",
      "description": "Everything tracked for 1-100 products: details, categories, images, statistics, price and sales-rank history, buy box, offers, stock, rating history. Price follows data cost (from about $0.005); the payment quote shows the exact amount. history=false (default) keeps responses small.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "asins": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{10}$",
              "description": "Amazon ASIN, e.g. 0735211299"
            },
            "minItems": 1,
            "maxItems": 100,
            "description": "ASINs (use asins OR codes)"
          },
          "codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 100,
            "description": "UPC/EAN/ISBN-13 codes"
          },
          "domain": {
            "type": "string",
            "enum": [
              "us",
              "uk",
              "de",
              "fr",
              "jp",
              "ca",
              "it",
              "es",
              "in",
              "mx",
              "br"
            ],
            "description": "Amazon marketplace, default us"
          },
          "history": {
            "type": "boolean",
            "description": "Include price/rank history (default false)"
          },
          "days": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Limit history to last N days"
          },
          "stats": {
            "type": "integer",
            "minimum": 0,
            "description": "Statistics window in days (default 180, 0 = off)"
          },
          "offers": {
            "type": "integer",
            "minimum": 20,
            "maximum": 100,
            "description": "Fetch live marketplace offers (costs more)"
          },
          "buybox": {
            "type": "boolean",
            "description": "Buy box history and stats (+cost)"
          },
          "rating": {
            "type": "boolean",
            "description": "Rating and review-count history (+cost)"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "search_products",
      "description": "Keyword search like the Amazon search bar; up to 10 full products per page with stats. About $0.005-0.02 per page; the quote shows the exact amount.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "minLength": 2
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "domain": {
            "type": "string",
            "enum": [
              "us",
              "uk",
              "de",
              "fr",
              "jp",
              "ca",
              "it",
              "es",
              "in",
              "mx",
              "br"
            ],
            "description": "Amazon marketplace, default us"
          },
          "history": {
            "type": "boolean"
          }
        },
        "required": [
          "term"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "find_products",
      "description": "Find ASINs matching filters (price, sales rank, monthly sales, offers, buy box, Amazon presence, brand, category, rating...). Prices in cents. Example selection: {\"current_SALES_lte\":20000,\"monthlySold_gte\":300,\"perPage\":50}. Fields: https://asin402.com/docs/finder. From about $0.005.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "selection": {
            "type": "object",
            "additionalProperties": {},
            "description": "Product Finder query object"
          },
          "domain": {
            "type": "string",
            "enum": [
              "us",
              "uk",
              "de",
              "fr",
              "jp",
              "ca",
              "it",
              "es",
              "in",
              "mx",
              "br"
            ],
            "description": "Amazon marketplace, default us"
          }
        },
        "required": [
          "selection"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "find_deals",
      "description": "Products whose price recently dropped, with filters. selection must include priceTypes with one value: 0 Amazon, 1 New, 18 Buy box. Example: {\"priceTypes\":[18],\"dateRange\":0}. Fields: https://asin402.com/docs/deals. About $0.005 per page.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "selection": {
            "type": "object",
            "additionalProperties": {}
          },
          "domain": {
            "type": "string",
            "enum": [
              "us",
              "uk",
              "de",
              "fr",
              "jp",
              "ca",
              "it",
              "es",
              "in",
              "mx",
              "br"
            ],
            "description": "Amazon marketplace, default us"
          }
        },
        "required": [
          "selection"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "best_sellers",
      "description": "Ordered best-seller ASINs for a category ID (find IDs with search_categories). About $0.007.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "Category ID"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "description": "Top N (default 100)"
          },
          "domain": {
            "type": "string",
            "enum": [
              "us",
              "uk",
              "de",
              "fr",
              "jp",
              "ca",
              "it",
              "es",
              "in",
              "mx",
              "br"
            ],
            "description": "Amazon marketplace, default us"
          }
        },
        "required": [
          "category"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "search_categories",
      "description": "Search Amazon categories by name to get IDs for best_sellers, find_products and find_deals. About $0.005.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "minLength": 2
          },
          "domain": {
            "type": "string",
            "enum": [
              "us",
              "uk",
              "de",
              "fr",
              "jp",
              "ca",
              "it",
              "es",
              "in",
              "mx",
              "br"
            ],
            "description": "Amazon marketplace, default us"
          }
        },
        "required": [
          "term"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "lookup_barcode",
      "description": "Find the Amazon listings for 1-20 barcodes: ASIN, title, brand, current prices, sales rank and monthly sales. From $0.005; not charged if nothing matches.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "codes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{8,14}$"
            },
            "minItems": 1,
            "maxItems": 20
          },
          "max_per_code": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "domain": {
            "type": "string",
            "enum": [
              "us",
              "uk",
              "de",
              "fr",
              "jp",
              "ca",
              "it",
              "es",
              "in",
              "mx",
              "br"
            ],
            "description": "Amazon marketplace, default us"
          }
        },
        "required": [
          "codes"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "watch_asins",
      "description": "Pay once to check 1-50 ASINs on a schedule (every 1h-24h, for 1-30 days) and record price drops/rises, below-target prices, stock changes and buy box seller changes. Returns watch_id and a secret key; read events with check_watch (free). Price = ASINs x checks x credits (minimum $0.05); the quote shows the exact amount.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "asins": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{10}$"
            },
            "minItems": 1,
            "maxItems": 50
          },
          "domain": {
            "type": "string",
            "enum": [
              "us",
              "uk",
              "de",
              "fr",
              "jp",
              "ca",
              "it",
              "es",
              "in",
              "mx",
              "br"
            ],
            "description": "Amazon marketplace, default us"
          },
          "interval": {
            "type": "string",
            "enum": [
              "1h",
              "3h",
              "6h",
              "12h",
              "24h"
            ]
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "price_below": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "min_change_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 90
          },
          "buybox": {
            "type": "boolean",
            "description": "Track buy box (default true; false is cheaper)"
          }
        },
        "required": [
          "asins"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "check_watch",
      "description": "Free. New events for a watch created with watch_asins, plus the latest snapshot per ASIN. Pass since = next_since from your previous check.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "watch_id": {
            "type": "string",
            "pattern": "^w_[A-Za-z0-9_-]+$"
          },
          "key": {
            "type": "string",
            "minLength": 10
          },
          "since": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "watch_id",
          "key"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "product_preview",
      "description": "Free, 5 per day: title, brand, category, current buy box / Amazon / lowest prices, rating, review count, sales rank and whether Amazon sells it, for any ASIN, or for one barcode (UPC/EAN/ISBN-13) instead of an ASIN. Price history, monthly sales and all analysis (check_deal, sell_score, fba_profit) are paid.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "asin": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]{10}$",
            "description": "Amazon ASIN, e.g. 0735211299"
          },
          "barcode": {
            "type": "string",
            "pattern": "^\\d{8,14}$",
            "description": "Use instead of asin: one UPC, EAN or ISBN-13"
          },
          "domain": {
            "type": "string",
            "enum": [
              "us",
              "uk",
              "de",
              "fr",
              "jp",
              "ca",
              "it",
              "es",
              "in",
              "mx",
              "br"
            ],
            "description": "Amazon marketplace, default us"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "free_sample",
      "description": "Free. A real, live result from a paid tool for one fixed product (ASIN 0735211299), so you can see the output before paying. Samples: deal-check, sell-score, fba-profit, product, data-product, compare-marketplaces, lookup.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "deal-check",
              "sell-score",
              "fba-profit",
              "product",
              "data-product",
              "compare-marketplaces",
              "lookup"
            ],
            "description": "Which paid endpoint to sample"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "how_to_pay",
      "description": "Free. Prices, network and how paid tools are paid on this hosted MCP server.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    }
