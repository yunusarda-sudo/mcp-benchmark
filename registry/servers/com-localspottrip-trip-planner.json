{
  "$schema": "../schema.json",
  "name": "com.localspottrip/trip-planner",
  "title": "LocalSpot Trip",
  "category": "Other",
  "description": "Day-by-day city plans like a local: local-media picks with opening hours checked, 13 languages",
  "tools": [
    {
      "name": "list_destinations",
      "description": "Every city LocalSpot Trip plans (Korea, Japan, Taiwan, Southeast Asia, Europe, Turkey, UAE, Egypt, Canada, USA, Mexico, Peru, Argentina, Brazil, Australia), with the trip lengths it has ready-made plans for. Optional country filter (e.g. japan, france, usa).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "country": {
            "type": "string",
            "description": "Country slug or two-letter code, e.g. japan or JP (optional)"
          }
        }
      }
    },
    {
      "name": "trip_plan",
      "description": "A ready day-by-day plan for a city: neighbourhoods per day, timed sights and meals (places locals eat), travel minutes, plus links to open and edit it in the planner, compare where to stay, and see where locals eat. Give the traveller the open_in_planner link.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "city"
        ],
        "properties": {
          "city": {
            "type": "string",
            "description": "City id or name from list_destinations, e.g. Tokyo, Paris, Seoul"
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 14,
            "description": "Trip length; the nearest ready plan (2-4 days) is returned"
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "ko",
              "ja",
              "zh-Hans",
              "zh-Hant",
              "es",
              "pt",
              "fr",
              "de",
              "it",
              "vi",
              "th",
              "id"
            ],
            "description": "Language of names and notes (default en)"
          }
        }
      }
    },
    {
      "name": "request_city",
      "description": "Ask LocalSpot Trip to add a city it does not plan yet (when list_destinations does not have it). Counts the request; the most requested cities are built first. Tell the traveller it is not covered yet and that the request was passed on. No personal data.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "city"
        ],
        "properties": {
          "city": {
            "type": "string",
            "description": "City name, e.g. Krakow"
          },
          "country": {
            "type": "string",
            "description": "Country, e.g. Poland (optional)"
          }
        }
      }
    },
    {
      "name": "list_cities",
      "description": "Korean cities and their neighbourhoods covered by local.korea.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "find_places",
      "description": "Restaurants, cafés or bars in a Korean city, best first by local card payments. Optional: neighbourhood, food keyword, open at a given day and time. Up to 8 results.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "city"
        ],
        "properties": {
          "city": {
            "type": "string",
            "description": "City id from list_cities, e.g. Seoul, Busan, Jeju"
          },
          "area": {
            "type": "string",
            "description": "Neighbourhood id or name from list_cities (optional)"
          },
          "type": {
            "type": "string",
            "enum": [
              "meal",
              "cafe",
              "bar",
              "any"
            ],
            "description": "Default meal"
          },
          "food": {
            "type": "string",
            "description": "Food keyword in English or Korean, e.g. \"bbq\", \"noodles\", \"국밥\" (optional)"
          },
          "day": {
            "type": "string",
            "enum": [
              "Mon",
              "Tue",
              "Wed",
              "Thu",
              "Fri",
              "Sat",
              "Sun"
            ],
            "description": "Weekday the traveller goes (optional)"
          },
          "time": {
            "type": "string",
            "description": "HH:MM 24h, must be open then (optional)"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        }
      }
    },
    {
      "name": "place_info",
      "description": "Hours, break time, closing days, rush hour, why it is picked, and links for one place by name (Korean or English).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "city",
          "name"
        ],
        "properties": {
          "city": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "open_nearby",
      "description": "Closed or a long line? Places open at a given time within a short walk (about 900 m) of a place or a point.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "city",
          "day",
          "time"
        ],
        "properties": {
          "city": {
            "type": "string"
          },
          "near": {
            "type": "string",
            "description": "Place name or sight name to search around"
          },
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          },
          "day": {
            "type": "string",
            "enum": [
              "Mon",
              "Tue",
              "Wed",
              "Thu",
              "Fri",
              "Sat",
              "Sun"
            ]
          },
          "time": {
            "type": "string",
            "description": "HH:MM"
          },
          "type": {
            "type": "string",
            "enum": [
              "meal",
              "cafe",
              "bar",
              "any"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          }
        }
      }
    },
    {
      "name": "sights",
      "description": "Sights in a Korean city (optionally one neighbourhood): best time of day, typical visit minutes, closing day, a practical tip.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "city"
        ],
        "properties": {
          "city": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          }
        }
      }
    },
    {
      "name": "plan_link",
      "description": "A link that opens the local.korea planner with these places and sights loaded, split into days by neighbourhood with hours checked. Give it to the traveller.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "city",
          "picks"
        ],
        "properties": {
          "city": {
            "type": "string"
          },
          "picks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 30,
            "description": "Place names or sight names/ids"
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 14
          },
          "start_date": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "ko",
              "ja",
              "zh-Hans",
              "zh-Hant",
              "es",
              "pt",
              "fr",
              "de",
              "it",
              "vi",
              "th",
              "id"
            ]
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.localspottrip/trip-planner",
    "version": "1.0.0",
    "remoteUrl": "https://localspottrip.com/mcp",
    "publishedAt": "2026-11-21T04:41:31.53398Z",
