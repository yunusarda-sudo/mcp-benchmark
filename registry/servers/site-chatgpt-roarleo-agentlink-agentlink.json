{
  "$schema": "../schema.json",
  "name": "site.chatgpt.roarleo.agentlink/agentlink",
  "title": "AgentLink",
  "category": "AI, LLMs & Agents",
  "description": "Read-only checks for agent tools and batch handoffs. Get the exact record IDs to retry.",
  "tools": [
    {
      "name": "check_tool_change",
      "description": "Find which saved jobs would break if a tool's declared contract changed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "current": {
            "$ref": "#/$defs/Catalogue"
          },
          "proposed": {
            "$ref": "#/$defs/Catalogue"
          },
          "jobs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Job"
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "required": [
          "current",
          "proposed",
          "jobs"
        ],
        "additionalProperties": false,
        "$defs": {
          "CheckRequest": {
            "type": "object",
            "properties": {
              "current": {
                "$ref": "#/$defs/Catalogue"
              },
              "proposed": {
                "$ref": "#/$defs/Catalogue"
              },
              "jobs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Job"
                },
                "minItems": 1,
                "maxItems": 50
              }
            },
            "required": [
              "current",
              "proposed",
              "jobs"
            ],
            "additionalProperties": false
          },
          "Catalogue": {
            "type": "object",
            "required": [
              "services"
            ],
            "properties": {
              "services": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Service"
                },
                "minItems": 0,
                "maxItems": 50
              }
            },
            "additionalProperties": true
          },
          "Service": {
            "type": "object",
            "required": [
              "id",
              "tool_name",
              "input_schema",
              "output_schema"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              },
              "tool_name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              },
              "input_schema": {
                "$ref": "#/$defs/Contract"
              },
              "output_schema": {
                "$ref": "#/$defs/Contract"
              }
            },
            "additionalProperties": true
          },
          "Contract": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "object",
                  "array",
                  "string",
                  "boolean",
                  "integer",
                  "number",
                  "null"
                ]
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "properties": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/Contract"
                }
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "additionalProperties": {
                "type": "boolean"
              },
              "items": {
                "$ref": "#/$defs/Contract"
              },
              "enum": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "additionalProperties": false,
            "description": "Supported profile: object fields, required keys and boolean additionalProperties; array items; scalar enums. Maximum nesting depth is 8. Root input and output contracts must be objects. Other contract features yield UNASSESSED. Integers must be within JavaScript's safe range."
          },
          "Job": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              },
              "service_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              },
              "request": {
                "type": "object"
              },
              "expects": {
                "type": "object",
                "maxProperties": 20,
                "additionalProperties": {
                  "$ref": "#/$defs/ExpectedField"
                }
              }
            },
            "required": [
              "id",
              "service_id",
              "request",
              "expects"
            ],
            "additionalProperties": false
          },
          "ExpectedField": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "object",
                  "array",
                  "string",
                  "boolean",
                  "integer",
                  "number",
                  "null"
                ]
              },
              "enum": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "name": "check_tool_fallback",
      "description": "Rank supplied replacement tools for a saved job and check top-level field translations.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "job": {
            "$ref": "#/$defs/FallbackJob"
          },
          "candidates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "$ref": "#/$defs/FallbackCandidate"
            }
          }
        },
        "required": [
          "job",
          "candidates"
        ],
        "additionalProperties": false,
        "$defs": {
          "FallbackRequest": {
            "type": "object",
            "properties": {
              "job": {
                "$ref": "#/$defs/FallbackJob"
              },
              "candidates": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "$ref": "#/$defs/FallbackCandidate"
                }
              }
            },
            "required": [
              "job",
              "candidates"
            ],
            "additionalProperties": false
          },
          "FallbackJob": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              },
              "operation": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$",
                "description": "The operation label supplied by the caller."
              },
              "request": {
                "type": "object",
                "maxProperties": 50,
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$",
                  "not": {
                    "enum": [
                      "__proto__",
                      "prototype",
                      "constructor"
                    ]
                  },
                  "description": "A literal top-level name."
                }
              },
              "expects": {
                "type": "object",
                "maxProperties": 20,
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$",
                  "not": {
                    "enum": [
                      "__proto__",
                      "prototype",
                      "constructor"
                    ]
                  },
                  "description": "A literal top-level name."
                },
                "additionalProperties": {
                  "$ref": "#/$defs/ExpectedField"
                }
              }
            },
            "required": [
              "id",
              "operation",
              "request",
              "expects"
            ],
            "additionalProperties": false
          },
          "ExpectedField": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "object",
                  "array",
                  "string",
                  "boolean",
                  "integer",
                  "number",
                  "null"
                ]
              },
              "enum": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "FallbackCandidate": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              },
              "tool_name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              },
              "operation": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              },
              "input_schema": {
                "$ref": "#/$defs/Contract"
              },
              "output_schema": {
                "$ref": "#/$defs/Contract"
              },
              "mapping": {
                "type": "object",
                "properties": {
                  "request": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$",
                      "not": {
                        "enum": [
                          "__proto__",
                          "prototype",
                          "constructor"
                        ]
                      },
                      "description": "A literal top-level name."
                    },
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$",
                      "not": {
                        "enum": [
                          "__proto__",
                          "prototype",
                          "constructor"
                        ]
                      },
                      "description": "A literal top-level name."
                    },
                    "maxProperties": 50,
                    "description": "Map a saved job field name to the corresponding candidate field name. Omitted fields keep their names."
                  },
                  "reply": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$",
                      "not": {
                        "enum": [
                          "__proto__",
                          "prototype",
                          "constructor"
                        ]
                      },
                      "description": "A literal top-level name."
                    },
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$",
                      "not": {
                        "enum": [
                          "__proto__",
                          "prototype",
                          "constructor"
                        ]
                      },
                      "description": "A literal top-level name."
                    },
                    "maxProperties": 50,
                    "description": "Map a saved job field name to the corresponding candidate field name. Omitted fields keep their names."
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "tool_name",
              "operation",
              "input_schema",
              "output_schema"
            ],
            "additionalProperties": false
          },
          "Contract": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "object",
                  "array",
                  "string",
                  "boolean",
                  "integer",
                  "number",
                  "null"
                ]
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "properties": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/Contract"
                }
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "additionalProperties": {
                "type": "boolean"
              },
              "items": {
                "$ref": "#/$defs/Contract"
              },
              "enum": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "additionalProperties": false,
            "description": "Supported profile: object fields, required keys and boolean additionalProperties; array items; scalar enums. Maximum nesting depth is 8. Root input and output contracts must be objects. Other contract features yield UNASSESSED. Integers must be within JavaScript's safe range."
          }
        }
      }
    },
    {
      "name": "check_tool_replies",
      "description": "Compare recorded tool replies at the fields a saved job uses and find drift.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "checks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/$defs/ReplyCheck"
            }
          },
          "cases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/$defs/ReplyCase"
            }
          }
        },
        "required": [
          "checks",
          "cases"
        ],
        "additionalProperties": false,
        "$defs": {
          "ReplyRequest": {
            "type": "object",
            "properties": {
              "checks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "$ref": "#/$defs/ReplyCheck"
                }
              },
              "cases": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "$ref": "#/$defs/ReplyCase"
                }
              }
            },
            "required": [
              "checks",
              "cases"
            ],
            "additionalProperties": false
          },
          "ReplyCheck": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9._-]{0,63}$"
                  },
                  "baseline_path": {
                    "type": "string",
                    "maxLength": 512,
                    "pattern": "^(?:$|/(?:[^~]|~[01])*)$",
                    "description": "A JSON Pointer. Use an empty string for the whole reply, or a slash-prefixed field path."
                  },
                  "candidate_path": {
                    "type": "string",
                    "maxLength": 512,
                    "pattern": "^(?:$|/(?:[^~]|~[01])*)$",
                    "description": "A JSON Pointer. Use an empty string for the whole reply, or a slash-prefixed field path."
                  },
                  "mode": {
                    "const": "exact"
                  }
                },
                "required": [
                  "id",
                  "baseline_path",
                  "candidate_path",
                  "mode"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9._-]{0,63}$"
                  },
                  "baseline_path": {
                    "type": "string",
                    "maxLength": 512,
                    "pattern": "^(?:$|/(?:[^~]|~[01])*)$",
                    "description": "A JSON Pointer. Use an empty string for the whole reply, or a slash-prefixed field path."
                  },
                  "candidate_path": {
                    "type": "string",
                    "maxLength": 512,
                    "pattern": "^(?:$|/(?:[^~]|~[01])*)$",
                    "description": "A JSON Pointer. Use an empty string for the whole reply, or a slash-prefixed field path."
                  },
                  "mode": {
                    "const": "absolute_tolerance"
                  },
                  "tolerance": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "id",
                  "baseline_path",
                  "candidate_path",
                  "mode",
                  "tolerance"
                ],
                "additionalProperties": false
              }
            ]
          },
          "ReplyCase": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              },
              "baseline": {},
              "candidate": {}
            },
            "required": [
              "id",
              "baseline",
              "candidate"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "name": "verify_batch_handoff",
      "description": "Find missing, changed, duplicate or unexpected records by ID and return the exact IDs to retry.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "key_field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "compare_fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "baseline": {
            "type": [
              "array",
              "null"
            ],
            "maxItems": 200,
            "items": {},
            "description": "Use null for a missing record list. Individual malformed rows are included in the verification findings."
          },
          "candidate": {
            "type": [
              "array",
              "null"
            ],
            "maxItems": 200,
            "items": {},
            "description": "Use null for a missing record list. Individual malformed rows are included in the verification findings."
          }
        },
        "required": [
          "key_field",
          "compare_fields",
          "baseline",
          "candidate"
        ],
        "additionalProperties": false,
        "$defs": {
          "BatchHandoffRequest": {
            "type": "object",
            "properties": {
              "key_field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "compare_fields": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "baseline": {
                "type": [
                  "array",
                  "null"
                ],
                "maxItems": 200,
                "items": {},
                "description": "Use null for a missing record list. Individual malformed rows are included in the verification findings."
              },
              "candidate": {
                "type": [
                  "array",
                  "null"
                ],
                "maxItems": 200,
                "items": {},
                "description": "Use null for a missing record list. Individual malformed rows are included in the verification findings."
              }
            },
            "required": [
              "key_field",
              "compare_fields",
              "baseline",
              "candidate"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "name": "check_batch_recovery",
      "description": "Classify which interrupted batch writes to skip, retry or look up from supplied destination evidence.",
      "inputSchema": {
        "type": "object",
        "required": [
          "batch_id",
          "destination",
          "lookup",
          "items"
        ],
        "properties": {
          "batch_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "destination": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
          },
          "lookup": {
            "type": "object",
            "required": [
              "tool",
              "argument"
            ],
            "properties": {
              "tool": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
              },
              "argument": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$",
                "not": {
                  "enum": [
                    "constructor",
                    "prototype"
                  ]
                }
              }
            },
            "additionalProperties": false,
            "description": "Caller-configured read-only lookup for the named destination. AgentLink returns its name and argument without calling it."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "required": [
                "id",
                "operation_ref",
                "evidence"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
                },
                "operation_ref": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
                },
                "evidence": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "$ref": "#/$defs/RecoveryEvidence"
                  }
                }
              },
              "additionalProperties": false,
              "description": "Each id and operation_ref must be unique within a batch. Supply evidence for the exact operation. An empty evidence array marks an unknown outcome."
            }
          },
          "response_format": {
            "type": "string",
            "const": "compact",
            "description": "Optional. Set to compact for decision IDs and unresolved lookups without echoed evidence. Omit for the full report."
          }
        },
        "additionalProperties": false,
        "$defs": {
          "RecoveryRequest": {
            "type": "object",
            "required": [
              "batch_id",
              "destination",
              "lookup",
              "items"
            ],
            "properties": {
              "batch_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
              },
              "destination": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
              },
              "lookup": {
                "type": "object",
                "required": [
                  "tool",
                  "argument"
                ],
                "properties": {
                  "tool": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
                  },
                  "argument": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$",
                    "not": {
                      "enum": [
                        "constructor",
                        "prototype"
                      ]
                    }
                  }
                },
                "additionalProperties": false,
                "description": "Caller-configured read-only lookup for the named destination. AgentLink returns its name and argument without calling it."
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "operation_ref",
                    "evidence"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
                    },
                    "operation_ref": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$"
                    },
                    "evidence": {
                      "type": "array",
                      "maxItems": 8,
                      "items": {
                        "$ref": "#/$defs/RecoveryEvidence"
                      }
                    }
                  },
                  "additionalProperties": false,
                  "description": "Each id and operation_ref must be unique within a batch. Supply evidence for the exact operation. An empty evidence array marks an unknown outcome."
                }
              },
              "response_format": {
                "type": "string",
                "const": "compact",
                "description": "Optional. Set to compact for decision IDs and unresolved lookups without echoed evidence. Omit for the full report."
              }
            },
            "additionalProperties": false
          },
          "RecoveryEvidence": {
            "type": "object",
            "required": [
              "state",
              "reference"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "APPLIED",
                  "FINAL_NOT_APPLIED",
                  "NOT_FOUND",
                  "PENDING"
                ],
                "description": "FINAL_NOT_APPLIED requires authoritative proof for this exact operation that no write occurred and every prior attempt is final and cannot apply later. NOT_FOUND alone is not such proof."
              },
              "reference": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
                "description": "Caller-supplied evidence reference. For APPLIED, use the destination's unique effect ID so repeated reports of the same effect can be recognized."
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "name": "get_tool_observation",
      "description": "Read the latest signed AgentLink monitoring result for an enrolled HTTPS endpoint before relying on its tool. Check freshness, availability and correctness.",
      "inputSchema": {
        "type": "object",
        "required": [
