{
  "$schema": "../schema.json",
  "name": "org.heurion/clinical-research-tools",
  "title": "Heurion Clinical Research Tools",
  "category": "Security & Identity",
  "description": "Zero-auth clinical MCP: E-value, CONSORT, Table 1, PubMed verify, KM/forest & PHI scan.",
  "repository": "https://github.com/heurion-org/heurion",
  "tools": [
    {
      "name": "public_e_value_calculate",
      "description": "计算观察性研究的 VanderWeele E-value，生成偏倚阈值 SVG 曲线及中英文审稿人回复模板。",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "effect_type": {
            "type": "string",
            "enum": [
              "RR",
              "OR",
              "HR"
            ],
            "description": "效应量类型：RR、OR 或 HR"
          },
          "estimate": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "效应量点估计值"
          },
          "ci_lower": {
            "description": "95% 置信区间下限",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ci_upper": {
            "description": "95% 置信区间上限",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rare_outcome": {
            "description": "当使用 OR/HR 时，是否满足罕见结局假设（<15%），默认 true",
            "type": "boolean"
          },
          "lang": {
            "description": "输出语言：zh（默认）或 en",
            "type": "string",
            "enum": [
              "zh",
              "en"
            ]
          }
        },
        "required": [
          "effect_type",
          "estimate"
        ]
      }
    },
    {
      "name": "public_consort_diagram",
      "description": "依据筛选、排除与随机分组数字生成标准 CONSORT 2010 / STROBE 受试者流向图（SVG 与 Mermaid 代码），并执行算术一致性校验。",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "title": {
            "description": "流程图标题",
            "type": "string",
            "maxLength": 120
          },
          "lang": {
            "description": "图形标签语言",
            "type": "string",
            "enum": [
              "zh",
              "en"
            ]
          },
          "total_assessed": {
            "type": "number",
            "minimum": 0,
            "description": "初筛评估总人数"
          },
          "exclusions": {
            "description": "排除原因明细数组",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string",
                  "description": "排除原因"
                },
                "count": {
                  "type": "number",
                  "minimum": 0,
                  "description": "排除例数"
                }
              },
              "required": [
                "reason",
                "count"
              ]
            }
          },
          "eligible_total": {
            "description": "合格入组总人数（缺省自动按 初筛-排除 计算）",
            "type": "number",
            "minimum": 0
          },
          "arms": {
            "description": "研究分组数组（最多 4 组）",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "研究组/队列名称"
                },
                "allocated": {
                  "type": "number",
                  "minimum": 0,
                  "description": "分配入组人数"
                },
                "lost_to_followup": {
                  "description": "失访人数",
                  "type": "number",
                  "minimum": 0
                },
                "discontinued": {
                  "description": "中止干预人数",
                  "type": "number",
                  "minimum": 0
                },
                "analyzed": {
                  "type": "number",
                  "minimum": 0,
                  "description": "纳入最终分析人数"
                }
              },
              "required": [
                "name",
                "allocated",
                "analyzed"
              ]
            }
          }
        },
        "required": [
          "total_assessed"
        ]
      }
    },
    {
      "name": "public_table1_generate",
      "description": "从临床表格数据（CSV 文本或 JSON 记录）生成医学期刊标准 Table 1 基线特征三线表，自动执行统计检验、SMD 计算与 PHI 隐私预扫。",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "csv": {
            "description": "CSV 或 TSV 表格文本（≤500 行，与 records 二选一）",
            "type": "string",
            "maxLength": 200000
          },
          "records": {
            "description": "结构化对象行数组",
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "options": {
            "type": "object",
            "properties": {
              "group_col": {
                "description": "分组列名（如 group / arm）",
                "type": "string"
              },
              "strata": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "nonnormal_cols": {
                "description": "指定按偏态/中位数 IQR 汇总的列名",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "decimals": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              }
            }
          }
        }
      }
    },
    {
      "name": "public_kaplan_meier_survival",
      "description": "计算 Kaplan-Meier 生存曲线、Number at Risk 风险表、Log-rank 检验与单因素 Cox 回归，输出发表级 SVG、中英文结果描述与可复现 R 脚本。",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "csv": {
            "description": "包含时间、结局事件与可选分组列的 CSV/TSV 文本",
            "type": "string",
            "maxLength": 200000
          },
          "records": {
            "description": "结构化随访记录数组",
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "time_col": {
            "description": "生存时间列名",
            "type": "string"
          },
          "event_col": {
            "description": "事件状态列名（1=事件发生，0=删失）",
            "type": "string"
          },
          "group_col": {
            "description": "分组列名",
            "type": "string"
          },
          "time_unit": {
            "description": "时间单位（默认 Months）",
            "type": "string",
            "maxLength": 24
          },
          "title": {
            "description": "图表标题",
            "type": "string",
            "maxLength": 120
          },
          "lang": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ]
          }
        }
      }
    },
    {
      "name": "public_forest_plot_generate",
      "description": "基于亚组/多因素回归效应量及 95% CI 生成顶刊标准森林图 SVG、文字总结及 forestploter R 脚本。",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "effect_type": {
            "type": "string",
            "enum": [
              "HR",
              "OR",
              "RR"
            ]
          },
          "null_value": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "left_label": {
            "type": "string",
            "maxLength": 45
          },
          "right_label": {
            "type": "string",
            "maxLength": 45
          },
          "raw_lines": {
            "description": "按行文本格式：Subgroup | Estimate | CI_Lower | CI_Upper | P_value",
            "type": "string"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "estimate": {
                  "type": "number"
                },
                "ci_lower": {
                  "type": "number"
                },
                "ci_upper": {
                  "type": "number"
                },
                "p_value": {
                  "type": "string"
                },
                "events_text": {
                  "type": "string"
                },
                "weight": {
                  "type": "number"
                },
                "is_summary": {
                  "type": "boolean"
                },
                "is_header": {
                  "type": "boolean"
                }
              },
              "required": [
                "label",
                "estimate",
                "ci_lower",
                "ci_upper"
              ]
            }
          },
          "lang": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ]
          }
        }
      }
    },
    {
      "name": "public_phi_scan",
      "description": "对临床病历、病例报告草稿执行确定性 PHI 敏感隐私识别（身份证 MOD 11-2、手机号、Luhn 银行卡、MRN、Email、SSN、患者姓名）并生成脱敏文本。",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000,
            "description": "待扫描脱敏的临床文本或病例报告段落"
          },
          "lang": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ]
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "public_deep_review_audit",
      "description": "零大模型消耗的临床论文审稿审计：解析 Markdown 为文档 AST 与 TableSummary，自动发现摘要–正文–表格算术矛盾、方法–结果统计不一致、Spin Bias 夸大及 CONSORT/STROBE 规范缺口。单 IP 每分钟限 20 次。",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "markdown": {
            "type": "string",
            "minLength": 20,
            "maxLength": 120000,
            "description": "待审计的临床研究论文 Markdown 原文（支持 GFM 表格）"
          },
          "title": {
            "description": "可选文稿标题",
            "type": "string",
            "maxLength": 200
          },
          "include_scratchpad": {
            "description": "是否返回跨章节共享结构化草稿板（样本量、研究设计、统计检验与缩写汇总），默认 true",
            "type": "boolean"
          }
        },
        "required": [
          "markdown"
        ]
      }
    },
    {
      "name": "public_pubmed_citation_check",
      "description": "从医学文稿或参考文献中提取 PMID / DOI，借助 PubMed / Crossref（含 24h 内存缓存）核验文献真实性及文内声称的 HR/OR/95% CI 数值一致性。单 IP 每分钟限 15 次。",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "description": "包含 PMID / DOI 及效应量描述的论文段落或参考文献列表"
          }
        },
        "required": [
          "text"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "org.heurion/clinical-research-tools",
    "version": "1.0.0",
