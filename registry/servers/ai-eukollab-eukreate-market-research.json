{
  "$schema": "../schema.json",
  "name": "ai.eukollab/eukreate-market-research",
  "title": "EuKreate Market Research",
  "category": "Social, Media & Knowledge",
  "description": "EuKreate Market Research answers questions about a PLACE in the United States: what homes cost,…",
  "tools": [
    {
      "name": "compare-markets",
      "description": "The same market report for two to four places, in the order given, to compare them side by side (for example two ZIP codes, or a city and its county). A place EuKreate does not cover has found false and a message; the others still answer.",
      "inputSchema": {
        "$defs": {
          "PlaceAsked": {
            "additionalProperties": false,
            "properties": {
              "place": {
                "description": "A 5-digit ZIP, a city, a county, a two-letter state, or 'US'.",
                "maxLength": 120,
                "minLength": 1,
                "title": "Place",
                "type": "string"
              },
              "scope_kind": {
                "anyOf": [
                  {
                    "enum": [
                      "zip",
                      "city",
                      "county",
                      "state",
                      "national"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Omit unless the place is ambiguous; it is inferred.",
                "title": "Scope Kind"
              },
              "state": {
                "anyOf": [
                  {
                    "maxLength": 2,
                    "minLength": 2,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Two-letter state, for the city and county names that exist in several.",
                "title": "State"
              }
            },
            "required": [
              "place"
            ],
            "title": "PlaceAsked",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "places": {
            "items": {
              "$ref": "#/$defs/PlaceAsked"
            },
            "maxItems": 4,
            "minItems": 2,
            "title": "Places",
            "type": "array"
          }
        },
        "required": [
          "places"
        ],
        "title": "compare_marketsArguments",
        "type": "object"
      }
    },
    {
      "name": "get-a-market-report",
      "description": "EuKreate's market figures for one place: homes for sale, the median asking price, price per square foot and days on market, how much has sat over 60 and 90 days, breakdowns by bed count and property type, what has moved since earlier measurements, and the same headline figures for the area one…",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "place": {
            "description": "A 5-digit ZIP, a city, a county, a two-letter state, or 'US'.",
            "maxLength": 120,
            "minLength": 1,
            "title": "Place",
            "type": "string"
          },
          "scope_kind": {
            "anyOf": [
              {
                "enum": [
                  "zip",
                  "city",
                  "county",
                  "state",
                  "national"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Omit unless the place is ambiguous; it is inferred.",
            "title": "Scope Kind"
          },
          "state": {
            "anyOf": [
              {
                "maxLength": 2,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Two-letter state, for the city and county names that exist in several.",
            "title": "State"
          }
        },
        "required": [
          "place"
        ],
        "title": "get_market_reportArguments",
        "type": "object"
      }
    }
  ],
