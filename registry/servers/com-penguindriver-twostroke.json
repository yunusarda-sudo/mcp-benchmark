{
  "$schema": "../schema.json",
  "name": "com.penguindriver/twostroke",
  "title": "二行程經典車資料庫",
  "category": "Design, UI & 3D Media",
  "description": "二行程經典車資料庫：經典二行程機車規格、零件與保養。台灣繁體中文 MCP 工具。",
  "repository": "https://github.com/panda2143/taiwan-mcp-tools",
  "tools": [
    {
      "name": "search_models",
      "description": "搜尋二行程經典機車車款（本田、山葉、鈴木、川崎等），回傳車款代號。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "車款名稱，例如 NSR250、RZ350"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_model_specs",
      "description": "取得二行程經典車款的規格（附維基百科出處）、零件對照、保養資料與成交行情。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "車款代號，可先用 search_models 取得"
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "find_part",
      "description": "用零件型號或名稱（例如火星塞 BR9ES）反查適用的二行程車款。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_maintenance",
      "description": "取得某個二行程車款的保養資料（混合比、齒輪油、火星塞間隙、化油器設定等）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "slug"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.penguindriver/twostroke",
    "version": "1.0.1",
    "remoteUrl": "https://twostroke.penguindriver.com/mcp",
    "publishedAt": "2026-11-18T20:01:53.174112Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "2714aa7edcdc7fa7444c26ed545ba650534eadbddebb7b843663a3fdbde4c6de"
  }
}
