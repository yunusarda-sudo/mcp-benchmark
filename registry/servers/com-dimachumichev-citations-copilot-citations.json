{
  "$schema": "../schema.json",
  "name": "com.dimachumichev.citations/copilot-citations",
  "title": "Copilot Citations",
  "category": "AI, LLMs & Agents",
  "description": "Where Microsoft Copilot cites your site, and rivals instead, from Bing AI Performance CSVs.",
  "tools": [
    {
      "name": "upload_exports",
      "description": "Upload one or more Bing Webmaster Tools AI Performance CSV exports for a site. Pass each file's name and full text. Upload the overview export (the daily one) together with the grounding queries and pages exports so their dates are known, or give period_start and period_end (YYYY-MM-DD). Re-uploading the same report for the same period replaces it.",
      "inputSchema": {
        "properties": {
          "site": {
            "title": "Site",
            "type": "string"
          },
          "files": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "title": "Files",
            "type": "array"
          },
          "period_start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Period Start"
          },
          "period_end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Period End"
          }
        },
        "required": [
          "site",
          "files"
        ],
        "type": "object",
        "title": "upload_exportsArguments"
      }
    },
    {
      "name": "copilot_summary",
      "description": "Overview for a site: total Copilot citations, busiest day, top 5 grounding queries and top 5 cited pages for the latest uploaded period (or the period ending period_end).",
      "inputSchema": {
        "properties": {
          "site": {
            "title": "Site",
            "type": "string"
          },
          "period_end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Period End"
          }
        },
        "required": [
          "site"
        ],
        "type": "object",
        "title": "copilot_summaryArguments"
      }
    },
    {
      "name": "cited_queries",
      "description": "Grounding queries Copilot cited the site for, most citations first. Filter by text in the query, Bing's topic label or intent label.",
      "inputSchema": {
        "properties": {
          "site": {
            "title": "Site",
            "type": "string"
          },
          "contains": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Contains"
          },
          "topic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Topic"
          },
          "intent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Intent"
          },
          "limit": {
            "default": 25,
            "title": "Limit",
            "type": "integer"
          },
          "period_end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Period End"
          }
        },
        "required": [
          "site"
        ],
        "type": "object",
        "title": "cited_queriesArguments"
      }
    },
    {
      "name": "cited_pages",
      "description": "The site's pages Copilot cited, most citations first. Filter by text in the URL.",
      "inputSchema": {
        "properties": {
          "site": {
            "title": "Site",
            "type": "string"
          },
          "contains": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Contains"
          },
          "limit": {
            "default": 25,
            "title": "Limit",
            "type": "integer"
          },
          "period_end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Period End"
          }
        },
        "required": [
          "site"
        ],
        "type": "object",
        "title": "cited_pagesArguments"
      }
    },
    {
      "name": "missed_queries",
      "description": "Grounding queries where Copilot cited other sites and not this one, biggest first. Needs the opportunities export.",
      "inputSchema": {
        "properties": {
          "site": {
            "title": "Site",
            "type": "string"
          },
          "limit": {
            "default": 25,
            "title": "Limit",
            "type": "integer"
          },
          "period_end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Period End"
          }
        },
        "required": [
          "site"
        ],
        "type": "object",
        "title": "missed_queriesArguments"
      }
    },
    {
      "name": "what_changed",
      "description": "What changed between the two latest uploaded periods: citations per day, new and gone grounding queries and pages, biggest gains and drops. Paid plan.",
      "inputSchema": {
        "properties": {
          "site": {
            "title": "Site",
            "type": "string"
          },
          "top": {
            "default": 5,
            "title": "Top",
            "type": "integer"
          }
        },
        "required": [
          "site"
        ],
        "type": "object",
        "title": "what_changedArguments"
      }
    },
    {
      "name": "page_queries",
      "description": "Which grounding queries led Copilot to cite a given page. Needs a query-to-page mapping export (Bing's native exports don't include it).",
      "inputSchema": {
        "properties": {
          "site": {
            "title": "Site",
            "type": "string"
          },
          "page": {
            "title": "Page",
            "type": "string"
          },
          "period_end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Period End"
          }
        },
        "required": [
          "site",
          "page"
        ],
        "type": "object",
        "title": "page_queriesArguments"
      }
    },
    {
      "name": "account_status",
      "description": "This account's plan, sites and uploads.",
      "inputSchema": {
        "properties": {},
        "type": "object",
        "title": "account_statusArguments"
      }
    }
  ],
