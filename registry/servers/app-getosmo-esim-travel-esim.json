{
  "$schema": "../schema.json",
  "name": "app.getosmo.esim/travel-esim",
  "title": "OsmO Travel eSIM",
  "category": "Travel, Maps & Navigation",
  "description": "Compare travel eSIM data plans for any trip, check phone eSIM support, estimate data, set up.",
  "repository": "https://github.com/Mountainheads-Private-limited/osmo-travel-esim",
  "tools": [
    {
      "name": "search_esim_plans",
      "description": "Use this when the user is travelling abroad and wants mobile data, an eSIM, a travel SIM, or to avoid roaming charges. Finds eSIM plans in the OsmO catalogue that cover the whole trip, including multi-country trips, and ranks them by the published rule: fit first, then total price. Trip length is required. Covers data plans from the providers listed in the result. Does not handle home-country phone contracts or purchases.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "trip": {
            "type": "object",
            "properties": {
              "legs": {
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "destination": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 80,
                      "description": "Country, territory, city or region, e.g. 'Japan', 'Bali', 'Europe'"
                    },
                    "days": {
                      "description": "Days in this destination (give for every leg, or not at all)",
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 365
                    }
                  },
                  "required": [
                    "destination"
                  ]
                },
                "description": "Destinations in travel order"
              },
              "totalDays": {
                "type": "integer",
                "minimum": 1,
                "maximum": 365
              },
              "startDate": {
                "description": "YYYY-MM-DD",
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "endDate": {
                "description": "YYYY-MM-DD, inclusive",
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "legs"
            ]
          },
          "dataGb": {
            "description": "Data needed per person in GB; omit to estimate from usage",
            "type": "number",
            "minimum": 0.5,
            "maximum": 200
          },
          "usage": {
            "description": "Phone use if dataGb is unknown: light (~0.3 GB/day), moderate (~0.8), heavy (~2)",
            "type": "string",
            "enum": [
              "light",
              "moderate",
              "heavy"
            ]
          },
          "unlimited": {
            "description": "true = only unlimited-data plans",
            "type": "boolean"
          },
          "needs": {
            "type": "object",
            "properties": {
              "fiveG": {
                "type": "boolean"
              },
              "voice": {
                "type": "boolean"
              },
              "noIdCheck": {
                "type": "boolean"
              },
              "topUps": {
                "type": "boolean"
              }
            }
          },
          "maxPriceUsd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "travellers": {
            "description": "People travelling; each needs their own eSIM",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        },
        "required": [
          "trip"
        ]
      }
    },
    {
      "name": "get_esim_plan",
      "description": "Use this when the user asks about one specific plan returned by search_esim_plans: networks, 5G, ID check, when validity starts, top-ups, provider notes. Hotspot and speed limits are not in our data.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "planId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          }
        },
        "required": [
          "planId"
        ]
      }
    },
    {
      "name": "compare_esim_plans",
      "description": "Use this when the user wants two to four specific eSIM plans side by side.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "planIds": {
            "minItems": 2,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trip": {
            "type": "object",
            "properties": {
              "legs": {
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "destination": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 80,
                      "description": "Country, territory, city or region, e.g. 'Japan', 'Bali', 'Europe'"
                    },
                    "days": {
                      "description": "Days in this destination (give for every leg, or not at all)",
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 365
                    }
                  },
                  "required": [
                    "destination"
                  ]
                },
                "description": "Destinations in travel order"
              },
              "totalDays": {
                "type": "integer",
                "minimum": 1,
                "maximum": 365
              },
              "startDate": {
                "description": "YYYY-MM-DD",
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "endDate": {
                "description": "YYYY-MM-DD, inclusive",
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "legs"
            ]
          },
          "dataGb": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 200
          },
          "usage": {
            "description": "Used for the fit check if dataGb is unknown; default moderate",
            "type": "string",
            "enum": [
              "light",
              "moderate",
              "heavy"
            ]
          }
        },
        "required": [
          "planIds"
        ]
      }
    },
    {
      "name": "check_esim_device",
      "description": "Use this when the user asks whether their phone, tablet or watch supports eSIM. Answers from a maintained list of manufacturer-published specs; returns 'unknown' with self-check steps for models not listed.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "deviceModel": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          }
        },
        "required": [
          "deviceModel"
        ]
      }
    },
    {
      "name": "estimate_trip_data",
      "description": "Use this when the user is unsure how much mobile data they need for a trip. Returns an estimate with its assumptions and sources.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          },
          "activities": {
            "type": "object",
            "properties": {
              "mapsHoursPerDay": {
                "type": "number",
                "minimum": 0,
                "maximum": 24
              },
              "socialHoursPerDay": {
                "type": "number",
                "minimum": 0,
                "maximum": 24
              },
              "messagingHoursPerDay": {
                "type": "number",
                "minimum": 0,
                "maximum": 24
              },
              "videoCallMinPerDay": {
                "type": "number",
                "minimum": 0,
                "maximum": 1440
              },
              "streamingMinPerDay": {
                "type": "number",
                "minimum": 0,
                "maximum": 1440
              },
              "musicHoursPerDay": {
                "type": "number",
                "minimum": 0,
                "maximum": 24
              },
              "webHoursPerDay": {
                "type": "number",
                "minimum": 0,
                "maximum": 24
              },
              "hotspotHoursPerDay": {
                "type": "number",
                "minimum": 0,
                "maximum": 24
              }
            }
          },
          "usage": {
            "type": "string",
            "enum": [
              "light",
              "moderate",
              "heavy"
            ]
          },
          "wifiAtStay": {
            "type": "boolean"
          }
        },
        "required": [
          "days"
        ]
      }
    },
    {
      "name": "get_destination_guide",
      "description": "Use this when the user asks what to know about mobile data in one country: networks, 5G listed by plans, ID checks, typical plan prices, and researched local rules. Also accepts 'at sea' for cruises.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "destination": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          }
        },
        "required": [
          "destination"
        ]
      }
    },
    {
      "name": "get_esim_setup_steps",
      "description": "Use this when the user needs to install, activate, top up or fix a travel eSIM on iPhone or Android, for example no internet after landing. Gives general phone steps and provider top-up steps where we have them; not provider account support.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ]
          },
          "stage": {
            "type": "string",
            "enum": [
              "install",
              "activate",
              "troubleshoot",
              "topup"
            ]
          },
          "symptom": {
            "type": "string",
            "enum": [
              "no_internet",
              "no_signal",
              "sos_only",
              "qr_failed",
              "cannot_add",
              "other"
            ]
          },
          "planId": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          }
        },
        "required": [
          "platform",
          "stage"
        ]
      }
    },
    {
      "name": "compare_roaming_vs_esim",
      "description": "Use this when the user asks whether a travel eSIM is cheaper or better than their own mobile carrier's international roaming pass or plan for a trip to one destination, or about local SIM cards. Compares the carrier's published pass price with the eSIM plans in the OsmO catalogue. For multi-country trips, call it once per country.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "homeCarrier": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "destination": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          },
          "dataGb": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 200
          },
          "usage": {
            "type": "string",
            "enum": [
              "light",
              "moderate",
              "heavy"
            ]
          },
          "travellers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "homeCarrier",
          "destination",
          "days"
        ]
      }
    },
    {
      "name": "get_keep_your_number_guide",
      "description": "Use this when the user asks whether they keep their phone number, WhatsApp, iMessage or bank text codes while using a travel eSIM, or how to set up two SIMs so they aren't charged for roaming data.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ]
          },
          "homeCarrier": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          }
        },
        "required": [
          "platform"
        ]
      }
    },
    {
      "name": "get_before_you_fly_checklist",
      "description": "Use this when the user asks what to do before travelling so they have mobile data on arrival.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "destination": {
            "type": "string"
          },
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ]
          },
          "departureDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "planId": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "show_esim_plans",
