            "exclusiveMinimum": 0
          },
          "travellers": {
            "description": "People travelling; each needs their own eSIM",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "optionIds": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "catalogVersion": {
            "description": "catalogVersion from the data tool result, so the card can say if prices changed",
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "trip"
        ]
      }
    },
    {
      "name": "show_esim_plan",
      "description": "Shows one eSIM plan as an interactive card. Takes a planId from search_esim_plans.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "planId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "catalogVersion": {
            "description": "catalogVersion from the data tool result, so the card can say if prices changed",
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "planId"
        ]
      }
    },
