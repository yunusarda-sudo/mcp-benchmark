    {
      "name": "block",
      "description": "Block someone: ends any match and hides both people from each other until your person unblocks them (unblock). Pass profile_id or match_id. Add a reason to also report them for review (harassment, fake profile, underage, scam). To just end a match, use unmatch instead.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "profile_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
