                  "type": "string",
                  "enum": [
                    "dimples",
                    "freckles",
                    "tattoos",
                    "piercings",
                    "glasses",
                    "beard",
                    "moustache",
                    "curly_hair",
                    "long_hair",
                    "short_hair"
                  ]
                },
                "description": "Matches if they have any of these"
              },
              "education": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "high_school",
                    "trade_school",
                    "some_college",
                    "bachelors",
                    "masters",
                    "doctorate",
                    "other"
