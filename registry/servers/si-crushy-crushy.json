    {
      "name": "likes_received",
      "description": "People who liked your person and aren't matched with them yet, newest first, as full profiles. Like one back with swipe to match instantly. 1 credit the first time you see each person (seen_before:true is free). Their note stays hidden until you match. include_decided:true also lists people you already passed on.",
      "inputSchema": {
