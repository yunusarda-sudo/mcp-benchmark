                  "grey",
                  "dyed",
                  "bald",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "eye_color": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "brown",
                  "blue",
                  "green",
                  "hazel",
                  "grey",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "body_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "slim",
                  "athletic",
                  "average",
                  "curvy",
                  "full_figured",
                  "muscular"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "features": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "dimples",
                "freckles",
                "tattoos",
                "piercings",
                "glasses",
                "beard",
                "moustache",
                "curly_hair",
                "long_hair",
                "short_hair"
              ]
            },
            "description": "Visible features, e.g. dimples, freckles, tattoos, glasses, beard"
          },
          "private_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "height_cm",
                "pronouns",
                "orientation",
                "hometown",
                "languages",
                "zodiac",
                "hair_color",
                "eye_color",
                "body_type",
                "features",
                "occupation",
                "employer",
                "education",
                "school",
                "income",
                "drinking",
                "smoking",
                "cannabis",
                "drugs",
                "exercise",
                "diet",
                "pets",
                "ethnicity",
                "religion",
                "politics",
                "children",
                "family_plans",
                "relationship_type"
              ]
            },
            "description": "Detail fields to keep private: your own agent still reads them via get_me, nobody else sees them"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "add_photo",
      "description": "Add a photo of your person to their profile (max 6). Pass either a public https image url or base64 image data (JPG, PNG or WebP, up to 5 MB). The image is copied into Crushy's storage. Only use photos your person gave you.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "starts_with",
            "pattern": "^https:\\/\\/.*"
          },
          "base64": {
            "description": "Raw base64, or a data: URL",
            "type": "string",
            "maxLength": 7200000
          },
          "position": {
            "description": "0 = main photo. Default: last",
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        }
      }
    },
    {
      "name": "remove_photo",
      "description": "Remove a photo by its url (from get_me). To reorder photos, call update_profile with the photos list in the new order.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "discover",
      "description": "Search for new, mutually compatible people. Translate your person's request into filters (exact) and query (free text), e.g. \"blonde, about 5'6, dimples, doesn't smoke, six figures\" -> filters {hair_color:[\"blonde\"], features:[\"dimples\"], smoking:[\"never\"], income:[\"100k_150k\",\"150k_250k\",\"250k_plus\"]}, height_min_cm 165, height_max_cm 170. Location defaults to 50 km around your person's own city; only change it (near / radius_km / anywhere) when they ask. Returns full profiles with details and photos. Costs 1 credit the first time a person is ever shown to you (seen_before:true results are free); a search that finds nobody costs nothing. Each distinct search shows at most 50 people per 24 hours, best matches first and otherwise shuffled; repeat calls continue through the same list without repeats, and every 24 hours it reshuffles the whole pool. Only people your person passed on are left out (history lists them); someone already liked can reappear, marked you_liked:true, so don't like them twice. Looks filters (hair_color, eye_color, body_type, features, height) keep people who didn't answer that question, after the confirmed matches; those results carry looks_to_check, so look at their photos and only like the ones that fit. Set strict_looks:true for confirmed matches only. Taste words (\"pretty\", \"hot\", \"gorgeous\") are never filters: they switch to photo-only results and you judge attractiveness yourself from the photos. Don't put gender words in query; mutual gender preferences are always applied.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "description": "How many to fetch (default 5)",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "query": {
            "description": "Anything not covered by filters, in plain words: \"loves ice cream and Taylor Swift, plays guitar\". Split into concepts on and/or/commas; each matches bios, prompts, interests and details despite typos, plurals or spacing. People matching more concepts come first; each result lists what it matched",
            "type": "string",
            "maxLength": 300
          },
          "filters": {
            "description": "Exact filters. Each field takes a list of allowed values",
            "type": "object",
            "properties": {
              "hair_color": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "blonde",
                    "brown",
                    "black",
                    "red",
                    "auburn",
                    "grey",
                    "dyed",
                    "bald",
                    "other"
                  ]
                }
              },
              "eye_color": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "brown",
                    "blue",
                    "green",
                    "hazel",
                    "grey",
                    "other"
                  ]
                }
              },
              "body_type": {
