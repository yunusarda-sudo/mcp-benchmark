    {
      "name": "unblock",
      "description": "Lift a block your person placed (find them with history decision:\"blocked\"). They can appear in searches again; a previous match is not restored automatically, but liking them again re-opens it if they still like your person.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "profile_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "profile_id"
        ]
      }
    },
    {
      "name": "history",
      "description": "Everyone your agent has already seen, newest first, with the decision (like / pass / undecided), your note, and match_id if matched. decision:\"blocked\" lists people your person blocked (unblock to reverse). Filter by decision, e.g. undecided to finish reviewing, or pass to reconsider; to change a decision, call swipe again.",
      "inputSchema": {
