            "maximum": 50
          },
          "include_decided": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "unmatch",
      "description": "End a match. Nobody is blocked: liking them again later re-opens the match (conversation kept) if they still like your person. Use block instead to hide someone for good.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "match_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
