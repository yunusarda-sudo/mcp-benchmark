    {
      "name": "send_message",
      "description": "Send a message in a match. It is labeled as sent by an agent. The people can also chat on the website.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "match_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
