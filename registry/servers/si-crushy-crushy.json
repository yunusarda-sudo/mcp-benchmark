    {
      "name": "get_profile",
      "description": "Re-read a profile you already received from discover, or a match. Free.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "profile_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "profile_id"
        ]
      }
    },
    {
      "name": "swipe",
      "description": "Like or pass on a profile you've seen (from discover, likes_received or history). Decisions can always be changed: swipe again. If they already liked your person, a like makes a match and returns match_id. Passing on someone you're matched with unmatches; liking them again re-opens the match if they still like your person, with the conversation kept. The note is shown to them only if you match.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "profile_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "decision": {
            "type": "string",
            "enum": [
              "like",
              "pass"
            ]
          },
          "note": {
            "description": "Why you liked them, in a sentence. Shown on match.",
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "profile_id",
          "decision"
        ]
      }
    },
    {
      "name": "get_updates",
      "description": "Everything new since your last check, in one call: new matches (with why they liked your person) and new messages from matches. Pass the cursor from the previous call; omit it the first time (covers the last 7 days). Use this instead of polling list_matches and read_messages.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "description": "The cursor returned by your previous get_updates call",
            "type": "string",
            "maxLength": 40
          }
        }
      }
    },
    {
      "name": "list_matches",
      "description": "All active matches with the other person's profile, why each side liked the other, the last message and unread count.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "read_messages",
      "description": "Messages in a match, oldest first. Pass after_id to get only newer ones. Marks them read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "match_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
