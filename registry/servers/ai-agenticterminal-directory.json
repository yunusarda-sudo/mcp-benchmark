{
  "$schema": "../schema.json",
  "name": "ai.agenticterminal/directory",
  "title": "Agentic Terminal Directory",
  "category": "Payments, CRM & Finance",
  "description": "Verified merchants accepting agentic payments on Lightning/L402/BOLT12/USDT — search, verify, pay.",
  "repository": "https://github.com/observer-protocol/at-directory",
  "tools": [
    {
      "name": "search_merchants",
      "description": "Search OP-verified merchants by rail, chain, category, agent-callable tier, trust tier, and free text. Ranked by trust tier then verification recency.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "rail": {
            "type": "string",
            "enum": [
              "lightning",
              "bolt12",
              "l402",
              "usdt"
            ]
          },
          "chain": {
            "type": "string",
            "enum": [
              "tron",
              "ethereum",
              "solana",
              "bsc",
              "polygon",
              "arbitrum",
              "base"
            ]
          },
          "category": {
            "type": "string"
          },
          "agent_callable_tier": {
            "type": "string",
            "enum": [
              "full-api",
              "structured-handoff",
              "human-checkout"
            ]
          },
          "trust_tier_min": {
            "type": "number",
            "enum": [
              1,
              2,
              3
            ]
          },
          "accepts_usdc": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_merchant",
      "description": "Get the full record for one merchant including all rails, payment endpoints, and OP attestation. Tier 2+ requires an AT credential.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "verify_payment_endpoint",
      "description": "Run a live check against a merchant's declared payment endpoint for a rail. Returns health, detail, and rail-specific evidence.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "merchant_id": {
            "type": "string",
            "minLength": 1
          },
          "rail": {
            "type": "string",
            "enum": [
              "lightning",
              "bolt12",
              "l402",
              "usdt"
            ]
          }
        },
        "required": [
          "merchant_id",
          "rail"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "list_categories",
      "description": "List the category taxonomy with merchant counts.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "list_rails",
      "description": "List supported payment rails and their current merchant counts.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "whoami",
      "description": "Report the resolved credential state and rate limits for the calling agent.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "ai.agenticterminal/directory",
    "version": "1.0.0",
    "remoteUrl": "https://mcp.agenticterminal.ai/mcp",
    "fetchedAt": "2026-11-22T10:21:23.861Z",
    "toolsSha256": "8e1b10df314e081d933807daa3ea247ddfee2faafcfe7d379dfd1a4f870443c5"
  }
}
