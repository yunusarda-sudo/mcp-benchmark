          },
          "acknowledge_transfer_lock": {
            "default": false,
            "title": "Acknowledge Transfer Lock",
            "type": "boolean"
          }
        },
        "required": [
          "domain"
        ],
        "title": "update_registrant_contactArguments",
        "type": "object"
      }
    },
    {
      "name": "update_nameservers",
      "description": "Replace a domain's nameservers through AIvikings.",
      "inputSchema": {
        "properties": {
          "domain": {
            "title": "Domain",
            "type": "string"
          },
          "nameservers": {
            "items": {
              "type": "string"
