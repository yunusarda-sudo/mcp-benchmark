              }
            ],
            "default": null,
            "title": "Record Port"
          },
          "record_weight": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Record Weight"
          }
        },
        "required": [
          "domain",
          "dns_zone_record_id",
          "record_name",
          "record_type",
          "record_value"
        ],
        "title": "update_dns_recordArguments",
        "type": "object"
      }
    },
    {
      "name": "delete_dns_record",
      "description": "Permanently delete a managed DNS record. Call list_dns_records first and pass the exact DNS zone record ID returned by the provider.",
      "inputSchema": {
        "properties": {
          "domain": {
            "title": "Domain",
            "type": "string"
          },
          "dns_zone_record_id": {
            "title": "Dns Zone Record Id",
            "type": "string"
          }
        },
        "required": [
          "domain",
