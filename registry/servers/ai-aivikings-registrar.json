    {
      "name": "configure_dns_record",
      "description": "Configure an A record for a domain through AIvikings. Use record_name=@ or omit it for the root/apex record. To create a subdomain, pass a relative name such as www for www.example.com or staging.api for staging.api.example.com. For compatibility, a complete hostname such as www.example.com may also be passed as domain; the server will resolve it against the authenticated customer's longest matching parent domain.",
      "inputSchema": {
        "properties": {
          "domain": {
            "title": "Domain",
            "type": "string"
          },
          "record_value": {
            "title": "Record Value",
            "type": "string"
          },
          "record_name": {
            "default": "@",
            "title": "Record Name",
            "type": "string"
          }
        },
        "required": [
          "domain",
          "record_value"
        ],
        "title": "configure_dns_recordArguments",
        "type": "object"
      }
    },
    {
      "name": "create_dns_zone",
      "description": "Create the DNS zone for a domain the authenticated customer already owns on AIvikings' own nameservers, so its DNS records can be managed here. Use it before adding records to an existing domain that should use AIvikings DNS, then point the domain to the returned nameservers with update_nameservers (which also creates the zone by itself). Safe to call again: an existing zone is kept. The new zone starts empty; records at the previous DNS provider are not copied, so ask the user which records the domain needs (for example its website A record and mail MX records).",
      "inputSchema": {
        "properties": {
          "domain": {
            "title": "Domain",
            "type": "string"
          }
        },
        "required": [
          "domain"
        ],
        "title": "create_dns_zoneArguments",
        "type": "object"
      }
    },
    {
      "name": "list_dns_records",
      "description": "List the managed DNS records for a domain owned by the authenticated customer. Use the returned DNS zone record ID when updating or deleting a record.",
      "inputSchema": {
        "properties": {
          "domain": {
            "title": "Domain",
            "type": "string"
          }
        },
        "required": [
          "domain"
        ],
        "title": "list_dns_recordsArguments",
        "type": "object"
      }
    },
    {
      "name": "add_dns_record",
      "description": "Add a managed DNS record to a domain owned by the authenticated customer. Supported types are A, AAAA, CNAME, MX, TXT, NS, and SRV. Relative names are expanded below the domain, including nested names such as staging.api; use @ for the zone apex. SRV records require port and weight.",
      "inputSchema": {
        "properties": {
          "domain": {
            "title": "Domain",
            "type": "string"
          },
          "record_name": {
            "title": "Record Name",
            "type": "string"
          },
          "record_type": {
            "title": "Record Type",
            "type": "string"
          },
          "record_value": {
            "title": "Record Value",
            "type": "string"
          },
          "record_ttl": {
            "default": 43200,
            "title": "Record Ttl",
