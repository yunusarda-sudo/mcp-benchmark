          },
          "record_priority": {
            "default": 0,
            "title": "Record Priority",
            "type": "integer"
          },
          "record_port": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Record Port"
          },
          "record_weight": {
