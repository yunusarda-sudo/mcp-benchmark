        "properties": {
          "domain": {
            "title": "Domain",
            "type": "string"
          },
          "dns_zone_record_id": {
            "title": "Dns Zone Record Id",
            "type": "string"
          },
          "record_name": {
            "title": "Record Name",
            "type": "string"
          },
          "record_type": {
            "title": "Record Type",
            "type": "string"
          },
          "record_value": {
            "title": "Record Value",
            "type": "string"
          },
          "record_ttl": {
