{
  "$schema": "../schema.json",
  "name": "ai.aivikings/registrar",
  "title": "AiVikings.ai",
  "category": "Communication & Alerting",
  "description": "Find, register, and manage domains from any AI chat or agent",
  "repository": "https://github.com/AIvikings/aivikings-mcp",
  "tools": [
    {
      "name": "get_domain_audit_log",
      "description": "Read append-only domain change history for the authenticated customer. Omit domain for portfolio history. Requires audit:read. Results are newest recorded first; pass next_cursor with the same filters for another page. Times must include a timezone. Requested, state_changed, and outcome events share an operation_id. Accepted is not proof of provider completion. History starts when domain auditing was enabled; agent labels are self-reported.",
      "inputSchema": {
        "properties": {
          "domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Domain"
          },
          "action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Action"
          },
          "from_timestamp": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "From Timestamp"
          },
          "to_timestamp": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "To Timestamp"
          },
          "cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          },
          "limit": {
            "default": 100,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "get_domain_audit_logArguments",
        "type": "object"
      }
    },
    {
      "name": "get_current_user",
      "description": "Return the authenticated AIvikings customer for the current bearer API key, including name and email when the key belongs to a customer.",
      "inputSchema": {
        "properties": {},
        "title": "get_current_userArguments",
        "type": "object"
      }
    },
    {
      "name": "check_domain_availability",
      "description": "Check whether domain names can be registered through AIvikings. Takes a list of one or more names (up to 200). Each result has a status: available (confirmed free by the registry), probably_available (not registered as far as we can see, but NOT confirmed: lists of more than 50 names are not sent to the registry; check the shortlist again to confirm), taken, not_offered (AIvikings does not sell that TLD), invalid (see message), or try_again (could not be confirmed right now). Never tell the user a probably_available name is available. This tool does not return prices or premium status: before the user buys, always call get_domain_pricing for the chosen name and tell them if it is premium. For a single name or a short list (up to 10), include_price=true adds premium and prices in the same call.",
      "inputSchema": {
        "properties": {
          "domains": {
            "items": {
              "type": "string"
            },
            "title": "Domains",
            "type": "array"
          },
          "include_price": {
            "default": false,
            "title": "Include Price",
            "type": "boolean"
          },
          "currency": {
            "default": "USD",
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "domains"
        ],
        "title": "check_domain_availabilityArguments",
        "type": "object"
      }
    },
    {
      "name": "get_domain_pricing",
      "description": "Get a fresh price quote for one domain. Returns customer-facing registration, renewal, and transfer prices, plus is_premium so the user can be told when premium pricing applies. Omit currency to use the returned currency; USD and EUR can be requested explicitly. Prices are not converted: if the requested currency is unavailable, price fields are null with a price_unavailable_reason. Never exposes upstream cost prices.",
      "inputSchema": {
        "properties": {
          "domain": {
            "title": "Domain",
            "type": "string"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Currency"
          }
        },
        "required": [
          "domain"
        ],
        "title": "get_domain_pricingArguments",
        "type": "object"
      }
    },
    {
      "name": "get_prepaid_balance",
      "description": "Return the authenticated customer's prepaid balance for domain purchases. Returns both USD and EUR wallet balances. When automatic currency conversion is enabled, a zero balance in the requested currency does not block registration if the other wallet has enough credit; register_domain converts only the missing amount automatically.",
      "inputSchema": {
        "properties": {
          "currency": {
            "default": "USD",
            "title": "Currency",
            "type": "string"
          }
        },
        "title": "get_prepaid_balanceArguments",
        "type": "object"
      }
    },
    {
      "name": "list_contact_countries",
      "description": "List exact ConnectReseller country names and IDs for creating or updating contacts.",
      "inputSchema": {
        "properties": {},
        "title": "list_contact_countriesArguments",
        "type": "object"
      }
    },
    {
      "name": "list_contact_states",
      "description": "List exact ConnectReseller state names for a country name, country ID, or ISO code. Use the returned name in contact requests.",
      "inputSchema": {
        "properties": {
          "country": {
            "title": "Country",
            "type": "string"
          }
        },
        "required": [
          "country"
        ],
        "title": "list_contact_statesArguments",
        "type": "object"
      }
    },
    {
      "name": "create_contact",
      "description": "Create a reusable contact for domain registration. Use list_contact_countries and list_contact_states to choose valid country and state names. The returned handle can be passed to register_domain and reused for multiple domains. When handle is omitted, it is generated from the company initials (or contact-name initials), four digits, and the country code.",
      "inputSchema": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "address": {
            "title": "Address",
            "type": "string"
          },
          "city": {
            "title": "City",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "country": {
            "title": "Country",
            "type": "string"
          },
          "postal_code": {
            "title": "Postal Code",
            "type": "string"
          },
          "phone_country_code": {
            "title": "Phone Country Code",
            "type": "string"
          },
          "phone_number": {
            "title": "Phone Number",
            "type": "string"
          },
          "handle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Handle"
          },
          "organization": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Organization"
          },
          "address_line_2": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Address Line 2"
          },
          "default_registrant": {
            "default": false,
            "title": "Default Registrant",
            "type": "boolean"
          },
          "default_admin": {
            "default": false,
            "title": "Default Admin",
            "type": "boolean"
          },
          "default_technical": {
            "default": false,
            "title": "Default Technical",
            "type": "boolean"
          },
          "default_billing": {
            "default": false,
            "title": "Default Billing",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "email",
          "address",
          "city",
          "state",
          "country",
          "postal_code",
          "phone_country_code",
          "phone_number"
        ],
        "title": "create_contactArguments",
        "type": "object"
      }
    },
    {
      "name": "get_contact",
      "description": "Get one reusable contact by its handle.",
      "inputSchema": {
        "properties": {
          "contact_handle": {
            "title": "Contact Handle",
            "type": "string"
          }
        },
        "required": [
          "contact_handle"
        ],
        "title": "get_contactArguments",
        "type": "object"
      }
    },
    {
      "name": "list_contacts",
      "description": "List reusable contacts belonging to the authenticated customer.",
      "inputSchema": {
        "properties": {},
        "title": "list_contactsArguments",
        "type": "object"
      }
    },
    {
      "name": "list_domain_registration_contacts",
      "description": "List the authenticated customer's registrant/contact handles for domain registrations. Returns whether each contact is complete enough for registration, its missing required fields, its default domain-contact roles, and the handle to pass to register_domain. Always call this before attempting a domain registration.",
      "inputSchema": {
        "properties": {},
        "title": "list_domain_registration_contactsArguments",
        "type": "object"
      }
    },
    {
      "name": "assign_domain_registration_contact_roles",
      "description": "Assign one existing contact handle as the default for selected domain-registration roles. Set assign_registrant, assign_admin, assign_technical, and/or assign_billing to true; false leaves that role unchanged. Assigning a role replaces any previous default for that role. Use this when registration validation reports a missing registrant, admin, technical, or billing contact.",
      "inputSchema": {
        "properties": {
          "contact_handle": {
            "title": "Contact Handle",
            "type": "string"
          },
          "assign_registrant": {
            "default": false,
            "title": "Assign Registrant",
            "type": "boolean"
          },
          "assign_admin": {
            "default": false,
            "title": "Assign Admin",
            "type": "boolean"
          },
          "assign_technical": {
            "default": false,
            "title": "Assign Technical",
            "type": "boolean"
          },
          "assign_billing": {
            "default": false,
            "title": "Assign Billing",
            "type": "boolean"
          }
        },
        "required": [
          "contact_handle"
        ],
        "title": "assign_domain_registration_contact_rolesArguments",
        "type": "object"
      }
    },
    {
      "name": "remove_domain_registration_contact_roles",
      "description": "Remove selected default domain-registration roles from one existing contact handle. Set remove_registrant, remove_admin, remove_technical, and/or remove_billing to true; false leaves that role unchanged. This does not delete the contact. Removing a role without assigning it to another contact can make registration validation fail unless register_domain is called with an explicit registration-ready contact_handle.",
      "inputSchema": {
        "properties": {
          "contact_handle": {
            "title": "Contact Handle",
            "type": "string"
          },
          "remove_registrant": {
            "default": false,
            "title": "Remove Registrant",
            "type": "boolean"
          },
          "remove_admin": {
            "default": false,
            "title": "Remove Admin",
            "type": "boolean"
          },
          "remove_technical": {
            "default": false,
            "title": "Remove Technical",
            "type": "boolean"
          },
          "remove_billing": {
            "default": false,
            "title": "Remove Billing",
            "type": "boolean"
          }
        },
        "required": [
          "contact_handle"
        ],
        "title": "remove_domain_registration_contact_rolesArguments",
        "type": "object"
      }
    },
    {
      "name": "register_domain",
      "description": "Register a domain through AIvikings using the authenticated account's configurable default nameservers when nameservers are omitted. Call list_domain_registration_contacts first and pass contact_handle to use one complete reusable contact for registrant, admin, technical, and billing roles. If there is no registration-ready contact, call create_contact before registration. Set currency to the same USD or EUR currency used for the price quote; otherwise the customer's preferred currency is used. If that wallet is short and automatic conversion is enabled, only the missing amount is converted from the other supported wallet. For a premium domain, first show the current get_domain_pricing quote to the user and set allow_premium=true only after the user explicitly accepts that price.",
      "inputSchema": {
        "properties": {
          "domain": {
            "title": "Domain",
            "type": "string"
          },
          "period_years": {
            "title": "Period Years",
            "type": "integer"
          },
          "nameservers": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Nameservers"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Currency"
          },
          "contact_handle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Contact Handle"
          },
          "allow_premium": {
            "default": false,
            "title": "Allow Premium",
            "type": "boolean"
          }
        },
        "required": [
          "domain",
          "period_years"
        ],
        "title": "register_domainArguments",
        "type": "object"
      }
    },
    {
      "name": "get_domain_status",
      "description": "Fetch the latest domain status, expiry and nameservers from the registrar and refresh the saved AIvikings record. Use this for an on-demand update, including pending transfers.",
      "inputSchema": {
        "properties": {
