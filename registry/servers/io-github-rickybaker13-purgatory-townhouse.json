{
  "$schema": "../schema.json",
  "name": "io.github.rickybaker13/purgatory-townhouse",
  "title": "Purgatory Townhouse (Durango, CO) vacation rental",
  "category": "Developer Tools & DevOps",
  "description": "Check dates, get quotes, see photos, and request to book a 4BR ski-in rental at Purgatory Resort.",
  "repository": "https://github.com/rickybaker13/colorado-house",
  "tools": [
    {
      "name": "townhouse_check_availability",
      "description": "Check whether the townhouse is open for specific dates. Returns available true/false, any blocked nights in the range, and the minimum stay.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "check_in": {
            "type": "string",
            "description": "Arrival date, YYYY-MM-DD (e.g. 2027-01-15)"
          },
          "check_out": {
            "type": "string",
            "description": "Departure date, YYYY-MM-DD (e.g. 2027-01-15)"
          }
        },
        "required": [
          "check_in",
          "check_out"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "townhouse_get_calendar",
      "description": "List open and blocked nights for a date window (up to 120 days). Use this when the traveler has flexible dates. A night is the date the guest sleeps there.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "start": {
            "description": "First date to show, YYYY-MM-DD. Defaults to today.",
            "type": "string"
          },
          "days": {
            "default": 60,
            "description": "How many days to show (1-120).",
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "townhouse_get_quote",
      "description": "Exact price for a stay: nightly rates by season, cleaning fee, pet fee, total, deposit, and an estimate of what the same stay costs on Airbnb. Also confirms the dates are open.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "check_in": {
            "type": "string",
            "description": "Arrival date, YYYY-MM-DD (e.g. 2027-01-15)"
          },
          "check_out": {
            "type": "string",
            "description": "Departure date, YYYY-MM-DD (e.g. 2027-01-15)"
          },
          "guests": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Number of guests, including children."
          },
          "pets": {
            "default": 0,
            "description": "Number of pets.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "check_in",
          "check_out",
          "guests"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "townhouse_get_property_info",
      "description": "Facts about the townhouse: capacity, rooms, amenities, location and ski access, check-in and check-out times, and policies. Fields the owner has not published are null; do not guess them.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "section": {
            "default": "all",
            "description": "Which part to return.",
            "type": "string",
            "enum": [
              "all",
              "overview",
              "rooms",
              "amenities",
              "location",
              "policies"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "townhouse_get_photos",
      "description": "Photo URLs with a description of what each shows. Category \"area\" is scenery near the townhouse, not the townhouse itself (shows_the_property is false).",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "category": {
            "default": "all",
            "description": "Which photos to return.",
            "type": "string",
            "enum": [
              "all",
              "exterior",
              "living",
              "kitchen_dining",
              "bedrooms",
              "bathrooms",
              "details",
              "area"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "townhouse_request_booking",
      "description": "Submit a booking request for the traveler. Only call this after the traveler has seen the quote and approved sending the request. The owner reviews every request (usually within a day); the dates are held while it is pending. Nothing is charged by this call. Once approved, the traveler pays the 50% deposit from the private booking page this call returns (card, or the chosen method). Payment methods available: see payment_methods in townhouse_get_quote.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "check_in": {
            "type": "string",
            "description": "Arrival date, YYYY-MM-DD (e.g. 2027-01-15)"
          },
          "check_out": {
            "type": "string",
            "description": "Departure date, YYYY-MM-DD (e.g. 2027-01-15)"
          },
          "guests": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Number of guests, including children."
          },
          "pets": {
            "default": 0,
            "description": "Number of pets.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "guest_name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "description": "Traveler's full name."
          },
          "guest_email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "description": "Traveler's email; the owner sends confirmation and payment details here."
          },
          "guest_phone": {
            "description": "Traveler's phone number (optional).",
            "type": "string",
            "maxLength": 30
          },
          "payment_method": {
            "default": "credit_card",
            "description": "How the traveler plans to pay the deposit. Must be one of payment_methods from townhouse_get_quote. Bitcoin gets a discount.",
            "type": "string",
            "enum": [
              "credit_card",
              "bitcoin",
              "stablecoin",
              "venmo",
              "cashapp",
              "zelle"
            ]
          },
          "message": {
            "description": "Questions or notes for the owner (arrival time, special requests).",
            "type": "string",
            "maxLength": 1000
          },
          "agent_name": {
            "type": "string",
            "maxLength": 100,
            "description": "Name of the AI agent or app submitting this, e.g. \"Claude\" or \"TripPlanner\"."
          },
          "traveler_approved": {
            "type": "boolean",
            "const": true,
            "description": "Must be true: confirms the traveler saw the quote and asked you to send this request."
          }
        },
        "required": [
          "check_in",
          "check_out",
          "guests",
          "guest_name",
          "guest_email",
          "agent_name",
          "traveler_approved"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.rickybaker13/purgatory-townhouse",
    "version": "0.1.1",
    "remoteUrl": "https://skipurgatoryhouse.com/api/mcp",
    "publishedAt": "2026-11-25T19:34:23.306948Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "061a39368740834ea4eb3b81c5064a902ae9dfb7ae3e3e81a33265e5537943b0"
  }
}
