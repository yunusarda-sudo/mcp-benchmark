{
  "$schema": "../schema.json",
  "name": "Zendesk MCP",
  "category": "Communication & Alerting",
  "description": "Zendesk MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "create_ticket",
      "description": "Open a customer support ticket in Zendesk Support instance.",
      "inputSchema": {
        "type": "object",
        "required": [
          "subject",
          "comment"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "description": "Ticket subject line."
          },
          "comment": {
            "type": "string",
            "description": "Initial ticket comment body."
          }
        }
      }
    }
  ]
}
