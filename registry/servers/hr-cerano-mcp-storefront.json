{
  "$schema": "../schema.json",
  "name": "hr.cerano.mcp/storefront",
  "title": "www.cerano.hr catalog",
  "category": "AI, LLMs & Agents",
  "description": "Read-only product catalog for shopping agents: search, details, compatibility, shop answers.",
  "tools": [
    {
      "name": "search_catalog",
      "description": "Search this shop's product catalog (UCP catalog.search). Dimensions such as '80x80' work in the query. Returns products with price in minor units, availability status, URL and key parameters (metadata.parameters). filters.compatible_with keeps only products that fit a given product. Paginate with pagination.cursor.",
      "inputSchema": {
        "properties": {
          "catalog": {
            "properties": {
              "context": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "UCP buyer context (ignored)."
              },
              "signals": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "UCP signals (ignored)."
              },
              "attribution": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "UCP attribution (ignored)."
              },
              "query": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Free-text query."
              },
              "filters": {
                "anyOf": [
                  {
                    "properties": {
                      "categories": {
                        "anyOf": [
                          {
                            "items": {
                              "type": "string"
                            },
                            "maxItems": 20,
                            "type": "array"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "default": null,
                        "description": "Not supported yet; ignored with a message."
                      },
                      "price": {
                        "anyOf": [
                          {
                            "properties": {
                              "min": {
                                "anyOf": [
                                  {
                                    "minimum": 0,
                                    "type": "integer"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ],
                                "default": null,
                                "description": "Minimum, minor units."
                              },
                              "max": {
                                "anyOf": [
                                  {
                                    "minimum": 0,
                                    "type": "integer"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ],
                                "default": null,
                                "description": "Maximum, minor units."
                              }
                            },
                            "type": "object"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "default": null,
                        "description": "Price incl. VAT in the shop currency, ISO 4217 minor units."
                      },
                      "compatible_with": {
                        "anyOf": [
                          {
                            "maxLength": 100,
                            "minLength": 1,
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "default": null,
                        "description": "Only products that fit this product (product ID or SKU), i.e. those find_compatible returns as fits or fits_after_cut."
                      }
                    },
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "pagination": {
                "anyOf": [
                  {
                    "properties": {
                      "cursor": {
                        "anyOf": [
                          {
                            "maxLength": 64,
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "default": null,
                        "description": "Opaque cursor."
                      },
                      "limit": {
                        "anyOf": [
                          {
                            "minimum": 1,
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "default": null,
                        "description": "Requested page size (the server caps it)."
                      }
                    },
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "type": "object"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "catalog"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "lookup_catalog",
      "description": "Look up products by product ID (Shoptet GUID) or variant SKU (UCP catalog.lookup). Unknown IDs are reported in messages as not_found.",
      "inputSchema": {
        "properties": {
          "catalog": {
            "properties": {
              "context": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "UCP buyer context (ignored)."
              },
              "signals": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "UCP signals (ignored)."
              },
              "attribution": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "UCP attribution (ignored)."
              },
              "ids": {
                "description": "Product IDs (Shoptet GUID) or variant SKUs.",
                "items": {
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 20,
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "ids"
            ],
            "type": "object"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "catalog"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "get_product",
      "description": "Full product detail by product ID (Shoptet GUID) or variant SKU: title, full description, price in minor units (list_price when discounted), categories, image, brand, all parameters (e.g. width, depth, shape, series), downloadable documents, availability status and label (metadata.availability; restock_date = expected arrival as ISO date when the product is on the way and the shop publishes it), warranty as the shop states it (metadata.warranty), rating (average, scale_max, review count) when reviewed, compatibility summary (metadata.compatibility) where it applies, and the product URL. Keys without data are omitted.",
      "inputSchema": {
        "properties": {
          "catalog": {
            "properties": {
              "context": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "UCP buyer context (ignored)."
              },
              "signals": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "UCP signals (ignored)."
              },
              "attribution": {
                "anyOf": [
                  {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "UCP attribution (ignored)."
              },
              "id": {
                "description": "Product ID (Shoptet GUID) or variant SKU.",
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "catalog"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "find_compatible",
      "description": "Products that fit a given product: shower trays for a shower enclosure, walk-in screen or niche door, and enclosures, screens or doors for a shower tray. compatibility.status: fits (fits as is), fits_after_cut (a cuttable tray is cut to size), floor_only (no tray fits: the screen goes on the tiled floor only), unknown (data missing, never present it as a match), not_applicable (we do not track compatibility for this product type). Each returned product has metadata.compatibility with the evaluated variant sku, verdict, reason code and a message in the shop language. Results are capped per role and total is the full count; to narrow a long list use search_catalog with a query and filters.compatible_with.",
      "inputSchema": {
        "properties": {
          "id": {
            "description": "Product ID (Shoptet GUID) or variant SKU.",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "anyOf": [
              {
                "enum": [
                  "shower_tray",
                  "corner_enclosure",
                  "three_wall_enclosure",
                  "walk_in_screen",
                  "niche_door"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Return only this product type."
          },
          "limit": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Products per role (the server caps it)."
          }
        },
        "required": [
          "id"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "check_compatibility",
      "description": "Check a set of 2 to 20 products (e.g. a shower enclosure and a tray) before recommending them together. Returns a verdict for every pair (a, b = product IDs, a_sku, b_sku = the evaluated variants): fits, fits_after_cut (the cuttable tray is cut to size), incompatible, unknown (data missing, not a match) or not_applicable (we do not track compatibility for that pair), with a reason code and a message in the shop language.",
      "inputSchema": {
        "properties": {
          "ids": {
            "description": "2 to 20 product IDs (Shoptet GUID) or variant SKUs.",
            "items": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 100,
            "type": "array"
          }
        },
        "required": [
          "ids"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "find_by_space",
      "description": "Shower enclosure finder by measured space. Give placement (niche, corner, threewall, walkin) and width_cm (plus depth_cm for corner and threewall). Returns enclosure options per type and shape with category links and sample products. Each product carries metadata.compatibility in the same shape as find_compatible, limited to shower trays that fit both the enclosure and the measured space: status fits = a tray fits as is; fits_after_cut = no exact tray, only a cuttable one shortened to compatibility.cut_to; floor_only = no tray, the enclosure goes on a tiled floor; unknown = data missing, do not claim a fit. A niche tray is never wider than the measured niche. Relay the returned message. An option may have no sample products: use its category links. exact=false means no enclosure has this size and the nearest available size is returned instead: tell the customer.",
      "inputSchema": {
        "properties": {
          "request": {
            "properties": {
              "placement": {
                "description": "Where the shower goes: niche (between two walls, door only), corner (two walls), threewall (three walls) or walkin (open, glass panel).",
                "enum": [
                  "niche",
                  "corner",
                  "threewall",
                  "walkin"
                ],
                "type": "string"
              },
              "width_cm": {
                "description": "Measured width in cm: niche opening, corner/threewall wall length, walk-in glass width.",
                "exclusiveMinimum": 0,
                "maximum": 500,
                "type": "number"
              },
              "depth_cm": {
                "anyOf": [
                  {
                    "exclusiveMinimum": 0,
                    "maximum": 500,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Measured depth in cm; required for corner and threewall."
              }
            },
            "required": [
              "placement",
              "width_cm"
            ],
            "type": "object"
          }
        },
        "required": [
          "request"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "ask_business",
      "description": "Answer questions about the shop itself (shipping, payment, returns, complaints, warranty, installation) with verbatim snippets from the shop's published pages and articles, each with its URL (snippets may be empty for a page without quotable text, e.g. a form: link it). Quote or paraphrase only these snippets and link the URL; when answers is empty, the answer could not be found in the published information: say so and give the contact.",
      "inputSchema": {
        "properties": {
          "request": {
            "properties": {
              "question": {
                "description": "Customer question about the shop in the shop language, e.g. 'Kolik stojí doprava?' or 'Jak vrátit zboží?'.",
                "maxLength": 200,
                "minLength": 2,
                "type": "string"
              }
            },
            "required": [
              "question"
            ],
            "type": "object"
          }
        },
        "required": [
          "request"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "get_order_status",
      "description": "Status of the customer's order in this shop: order status, items, shipping (tracking, pickup point) and payment. Requires the order number and the e-mail the order was placed with, both provided by the customer; never guess them or retry with variations. Repeated failed attempts block verification for a while, also on the shop website; then stop and point the customer to continue_url.",
      "inputSchema": {
        "properties": {
          "order_code": {
            "description": "Order number exactly as the customer gives it.",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "description": "E-mail address the order was placed with.",
            "maxLength": 254,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "order_code",
          "email"
        ],
        "type": "object",
        "additionalProperties": false
      }
    }
  ],
