{
  "$schema": "../schema.json",
  "name": "com.sourcefoshan/furniture-tools",
  "title": "Source Foshan Furniture Tools",
  "category": "E-Commerce & Retail",
  "description": "Furniture HS code finder (HS 2022, headings 9401–9404) and shipping CBM and container calculator.",
  "tools": [
    {
      "name": "find_furniture_hs_code",
      "description": "Suggest international six-digit HS codes (HS 2022, headings 9401, 9402, 9403, 9404) for furniture, seats, mattresses and bedding from a product description in English or Chinese, or from a 4–6 digit code. Returns candidate codes with the conditions for choosing each one, classification notes and official sources. Reference only, not a customs ruling.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "description": "Product description, e.g. \"wooden dining table\", \"office chair\", \"沙发\", or an HS code such as \"9403.60\""
          },
          "category": {
            "description": "Optional filter by furniture group",
            "type": "string",
            "enum": [
              "seating",
              "furniture",
              "medical",
              "parts",
              "bedding",
              "tables",
              "storage",
              "beds",
              "outdoor"
            ]
          },
          "material": {
            "description": "Optional filter by principal material",
            "type": "string",
            "enum": [
              "wood",
              "metal",
              "plastic",
              "bamboo",
              "rattan",
              "rubber",
              "spring",
              "textile",
              "other",
              "various"
            ]
          },
          "limit": {
            "description": "Maximum codes to return (default 10)",
            "type": "integer",
            "minimum": 1,
            "maximum": 36
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "calculate_shipping_cbm",
      "description": "Work out shipping volume and container size for furniture. Either give carton dimensions (cartons) to get CBM, cubic feet, air volumetric and chargeable weight and sea LCL revenue tons, or give the volumes several suppliers quoted (supplier_volumes_m3) to add them up. Both suggest LCL, a 20GP or a 40HQ container using Source Foshan's consolidation thresholds (under 15 m³ LCL, under 28 m³ 20GP, up to 68 m³ 40HQ). Send one of the two inputs, not both.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "cartons": {
            "description": "Carton lines with dimensions in unit",
            "minItems": 1,
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "length": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Carton length"
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Carton width"
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Carton height"
                },
                "quantity": {
                  "description": "Number of identical cartons (default 1)",
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 100000
                },
                "weight": {
                  "description": "Gross weight of one carton, in weight_unit",
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "label": {
                  "description": "Optional name for this line, e.g. \"3-seat sofa\"",
                  "type": "string",
                  "maxLength": 120
                }
              },
              "required": [
                "length",
                "width",
                "height"
              ]
            }
          },
          "unit": {
            "description": "Dimension unit for cartons (default cm)",
            "type": "string",
            "enum": [
              "cm",
              "mm",
              "m",
              "in"
            ]
          },
          "weight_unit": {
            "description": "Weight unit for cartons (default kg)",
            "type": "string",
            "enum": [
              "kg",
              "lb"
            ]
          },
          "air_divisor": {
            "description": "Air volumetric divisor in cm³/kg (default 6000 IATA; couriers often use 5000)",
            "type": "integer",
            "minimum": 1000,
            "maximum": 10000
          },
          "supplier_volumes_m3": {
            "description": "Volumes in m³ quoted by each supplier, to consolidate into one shipment",
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.sourcefoshan/furniture-tools",
    "version": "1.0.0",
    "remoteUrl": "https://tools.sourcefoshan.com/mcp",
    "publishedAt": "2026-11-25T08:53:32.42387Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "23e829ee944c49cc986d3e7ae55a4e8964bdcbb913de5e5815b0ab8be505602f"
  }
}
