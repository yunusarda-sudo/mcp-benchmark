{
  "$schema": "../schema.json",
  "name": "org.ilsontvote/mcp",
  "title": "They voted (ilsontvote.org)",
  "category": "Developer Tools & DevOps",
  "description": "Who voted how: parliamentary and popular votes, laws and petitions. Read-only.",
  "repository": "https://github.com/rebisway/ilsontvote",
  "tools": [
    {
      "name": "import_status",
      "description": "State of the data imports: for each scheduled task, its last run, whether it succeeded and the last successful run (UTC).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "country": {
            "description": "Country code (tasks common to all countries are always listed)",
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        }
      }
    },
    {
      "name": "data_quality",
      "description": "Known gaps in the data, per chamber: date of the latest vote, incomplete roll calls, votes without a result, members in office compared with seats, overlapping terms, members without a group.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "country": {
            "description": "Country code",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "chamber": {
            "description": "Chamber code",
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        }
      }
    },
    {
      "name": "list_types",
      "description": "Lists the available document types (parliamentary vote, popular vote, law, bill, petition, member), their filters, the published countries and chambers, and the themes.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "search",
      "description": "Searches documents of one type, most recent first (members: alphabetical order; petitions can be sorted by signatures). Titles are in the language of the source: search with words of that language.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "description": "Type code (see list_types), for example parliamentary_vote",
            "type": "string"
          },
          "text": {
            "description": "Words that must all appear in the title (or in the member's name)",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "country": {
            "description": "Country code: FR, EU, GB, US, CH…",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "chamber": {
            "description": "Chamber code: AN, SENAT, UE, COMMONS…",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "from": {
            "description": "Start date, YYYY-MM-DD",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "to": {
            "description": "End date, YYYY-MM-DD",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "theme": {
            "description": "Theme code (approximate keyword classification)",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "final_votes_only": {
            "description": "Parliamentary votes: only final votes on a whole text (computed from the title). Includes resolutions, which are not laws; a text adopted at one reading is not necessarily enacted: check the title.",
            "type": "boolean",
            "default": false
          },
          "page": {
            "description": "Page, starting at 1",
            "type": "integer",
            "default": 1
          },
          "limit": {
            "description": "Results per page (50 at most)",
            "type": "integer",
            "default": 20
          },
          "sort": {
            "description": "Petitions only: 'date' (most recent first, default) or 'signatures' (most supported first, over all matching petitions)",
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "type"
        ]
      }
    },
    {
      "name": "get_document",
      "description": "Full record of a document found with search.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "description": "Type code",
            "type": "string"
          },
          "id": {
            "description": "Document 'id'",
            "type": "string"
          }
        },
        "required": [
          "type",
          "id"
        ]
      }
    },
    {
      "name": "vote_positions",
      "description": "For a parliamentary vote: breakdown by political group and the position of each member (for, against, abstention, non_voting, absent).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Parliamentary vote id",
            "type": "string"
          },
          "position": {
            "description": "Filter: for, against, abstention, non_voting or absent",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "group": {
            "description": "Filter by group short name",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "page": {
            "description": "Page, starting at 1",
            "type": "integer",
            "default": 1
          },
          "limit": {
            "description": "Members per page (200 at most)",
            "type": "integer",
            "default": 100
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "member_history",
      "description": "History of the recorded votes held during a member's terms (absences included, incomplete roll calls excluded).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Member id (search, type member)",
            "type": "string"
          },
          "text": {
            "description": "Words of the vote title",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "position": {
            "description": "for, against, abstention, non_voting, absent, delegated or corrected",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "final_votes_only": {
            "description": "Only final votes on a whole text (computed from the title; includes resolutions, and any reading of a text)",
            "type": "boolean",
            "default": false
          },
          "from": {
            "description": "Start date, YYYY-MM-DD",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "to": {
            "description": "End date, YYYY-MM-DD",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "page": {
            "description": "Page, starting at 1",
            "type": "integer",
            "default": 1
          },
          "limit": {
            "description": "Votes per page (50 at most)",
            "type": "integer",
            "default": 20
          }
        },
        "required": [
          "id"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "org.ilsontvote/mcp",
    "version": "1.0.1",
    "remoteUrl": "https://www.ilsontvote.org/mcp",
    "publishedAt": "2026-11-27T21:36:23.782677Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "324d25a9e2d1a2ee1c45698b1796b4731a2d05b9797b626653ccc6a057b5cfa7"
  }
}
