{
  "$schema": "../schema.json",
  "name": "ArXiv Research MCP",
  "category": "Developer Tools & VCS",
  "description": "ArXiv Research MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "search_papers",
      "description": "Search scientific e-print preprints on arXiv by author, category, or title.",
      "inputSchema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "description": "Search term or query expression."
          },
          "maxResults": {
            "type": "integer",
            "description": "Max articles to retrieve."
          }
        }
      }
    }
  ]
}
