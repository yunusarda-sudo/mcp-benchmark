{
  "$schema": "../schema.json",
  "name": "com.b2btoolstudio/data-api",
  "category": "Communication & Alerting",
  "description": "Federal contract recompetes, SEC 8-K red-flag alerts, openFDA, CISA KEV/EPSS, CMS NPI & OpenAPI.",
  "tools": [
    {
      "name": "fda_risk_lookup",
      "description": "Cross-reference openFDA 510(k), PMA, recalls, and ongoing Class I/II enforcement totals for a medtech company or K-number.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "sec_8k_radar",
      "description": "Extract and classify SEC EDGAR Form 8-K filings by ticker symbol.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "ticker"
        ]
      }
    },
    {
      "name": "npi_provider_search",
      "description": "Query CMS NPPES v2.1 Healthcare Providers with >=2 criteria (state + taxonomy and/or city, LOCATION address).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "taxonomy": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "state",
          "taxonomy"
        ]
      }
    },
    {
      "name": "cisa_kev_priority",
      "description": "Prioritize CISA Known Exploited Vulnerabilities with ransomware and FIRST EPSS enrichment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "vendor": {
            "type": "string"
          },
          "ransomware": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "openapi_breaking_diff",
      "description": "Deterministically diff two OpenAPI 3.x JSON objects for path/method/parameter breaking changes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "base": {
            "type": "object"
          },
          "target": {
            "type": "object"
          }
        },
        "required": [
          "base",
          "target"
        ]
      }
    },
    {
      "name": "usaspending_expiring_contracts",
      "description": "Find US federal contracts approaching expiration by NAICS code (option-year-aware index when available).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "naics": {
            "type": "string"
          },
          "monthsAhead": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "recompete_search",
      "description": "Search the option-year-aware Federal Recompete Radar index by NAICS, agency, stage (FINAL_PERIOD, BRIDGED, VEHICLE_SUNSET, OPTION_DECISION), set-aside, and award value.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "naics": {
            "type": "string",
            "description": "Comma-separated NAICS codes (e.g. 541511,541512)"
          },
          "agency": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "description": "Comma-separated stages: FINAL_PERIOD,BRIDGED,VEHICLE_SUNSET,OPTION_DECISION"
          },
          "setAside": {
            "type": "string"
          },
          "minAmount": {
            "type": "number"
          },
          "months": {
            "type": "integer"
          },
          "q": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "sec_8k_red_flags",
      "description": "Search the live cross-company SEC Form 8-K Red-Flag index by item code (e.g. 1.05, 4.01, 4.02, 5.02), severity tier (CRITICAL, HIGH, MEDIUM, LOW), filing date, or issuer name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "description": "Comma-separated SEC item codes (e.g. 1.05,4.01,4.02,5.02)"
          },
          "tier": {
            "type": "string",
            "description": "Comma-separated tiers: CRITICAL,HIGH,MEDIUM,LOW"
          },
          "date": {
            "type": "string",
            "description": "YYYY-MM-DD filing date"
          },
          "q": {
            "type": "string",
            "description": "Company name, ticker, or CIK substring"
          },
          "limit": {
            "type": "integer"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.b2btoolstudio/data-api",
    "version": "2.0.0",
    "remoteUrl": "https://api.b2btoolstudio.com/mcp",
    "publishedAt": "2026-11-25T20:14:19.90902Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "4633eb2cdcc9a6ea7dcc75d3120e9d7fd086dced1643ac77de2b0a0a7e685d88"
  }
}
