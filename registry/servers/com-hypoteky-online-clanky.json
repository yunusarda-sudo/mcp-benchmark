{
  "$schema": "../schema.json",
  "name": "com.hypoteky-online/clanky",
  "title": "Hypotéka Online",
  "category": "Other",
  "description": "Search and cite Czech mortgage articles, calculations and primary sources from Hypotéka Online.",
  "tools": [
    {
      "name": "search_articles",
      "description": "Find Czech mortgage guides by keyword, with dates, summaries and URLs for citations. Use short Czech search phrases.",
      "inputSchema": {
        "type": "object",
        "required": [
          "query"
        ],
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5
          }
        }
      }
    },
    {
      "name": "get_article",
      "description": "Get a published article by its slug or exact canonical URL, including the byline, dates, full HTML body and source links.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "maxLength": 290
          }
        },
        "oneOf": [
          {
            "required": [
              "slug"
            ]
          },
          {
            "required": [
              "url"
            ]
          }
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.hypoteky-online/clanky",
    "version": "1.0.0",
    "remoteUrl": "https://hypoteky-online.com/mcp",
    "publishedAt": "2026-11-19T06:52:15.211299Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "3d09dae6059e736c37b1217481092d16a1735b94e20bba13c6855f91f1d1b47d"
  }
}
