{
  "$schema": "../schema.json",
  "name": "io.github.CLNS-KR/clns",
  "title": "CLNS — Korea Import Compliance",
  "category": "Developer Tools & VCS",
  "description": "Korea import pre-check: clearance, MFDS, recalls, RRA, pet-food (feed) rules.",
  "repository": "https://github.com/CLNS-KR/CLNS-KR",
  "tools": [
    {
      "name": "assess_import_case",
      "description": "품목·상황을 자연어로 받아 수입요건·인증·표시·통관 함정을 3단계로 판정하고 근거 조항과 면책을 반환합니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "품목과 상황 설명(예: '중국산 블루투스 스피커를 수입해 판매')"
          },
          "facts": {
            "type": "object",
            "description": "purpose(resale|self_use), channel(direct|agency), price_usd, hs_code, rra_cert_no(적합성평가 인증·등록번호), target_age, detail_copy(국내 판매페이지 문구) 등"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "default": 3
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "lookup_hs_requirements",
      "description": "HS 코드로 세관장확인대상 여부·법령·기관을 판정합니다. 6자리는 요건 판정에 부족합니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "hs_code": {
            "type": "string",
            "description": "HS 10자리 품목코드"
          },
          "direction": {
            "type": "string",
            "enum": [
              "import",
              "export"
            ],
            "default": "import"
          }
        },
        "required": [
          "hs_code"
        ]
      }
    },
    {
      "name": "check_kc_certification",
      "description": "전기용품·생활용품·어린이제품·전파 적합성평가 중 어떤 절차가 걸리는지 판정합니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_name": {
            "type": "string"
          },
          "target_age": {
            "type": "string",
            "description": "어린이제품 판단용 대상 연령"
          },
          "rf_tx": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "battery": {
            "type": "string",
            "description": "배터리 종류/내장 여부"
          },
          "ac_plug": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "rra_cert_no": {
            "type": "string",
            "description": "전파 적합성평가 인증·등록번호(예: R-LARN-00-0210). 있으면 국립전파연구원 DB를 즉시 조회"
          }
        },
        "required": [
          "product_name"
        ]
      }
    },
    {
      "name": "check_food_cosmetics",
      "description": "수입신고·영업등록·한글표시·광고심의 등 식약처 요건을 판정합니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "food",
              "health_functional",
              "cosmetics",
              "food_contact",
              "additive"
            ]
          },
          "purpose": {
            "type": "string",
            "enum": [
              "resale",
              "self_use"
            ]
          },
          "functional": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          }
        },
        "required": [
          "product_name",
          "kind"
        ]
      }
    },
    {
      "name": "check_drug_import",
      "description": "성분명·제품명(한·영)으로 마약류(마약·향정신성의약품·대마)·마약류 원료물질·국내 전용 성분 여부를 대조하고, 식약처 의약품 제품 허가정보·DUR·e약은요·마약류 오남용 정보 API를 실시간으로 함께 조회하며, 휴대 반입/직구와 수량을 자가사용 인정기준(6병·3개월분)과 비교해 판정합니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_name": {
            "type": "string",
            "description": "성분명 또는 제품명(한글·영어 모두 가능, 예: '졸피뎀', 'Zolpidem', 'Adderall')"
          },
          "ingredient": {
            "type": "string",
            "description": "성분명을 따로 넘길 때(있으면 product_name 보다 우선)"
          },
          "channel": {
            "type": "string",
            "enum": [
              "carry",
              "online",
              "unknown"
            ],
            "default": "unknown"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "description": "수량(병·정 등). 6병 기준과 대조"
          },
          "unit": {
            "type": "string",
            "description": "수량 단위(병·정·캡슐 등)"
          },
          "prescription": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ],
            "description": "처방전 보유 여부(소명자료 힌트)"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "self_use",
              "resale"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "default": 3
          }
        },
        "required": [
          "product_name"
        ]
      }
    },
    {
      "name": "check_ad_labeling",
      "description": "상세페이지·상품명 문구와 라벨 문구를 품목 유형(일반식품/건강기능식품/화장품/기능성화장품)별로 대조해 질병 효능·의약품 오인·거짓과장·체험기·기능성 오인 등 위험 표현과 한글표시사항 누락 항목을 근거 법령·대체 표현과 함께 반환합니다. 같은 문구를 공정위 표시광고법·전자상거래법 축(가격·후기·청약철회·배송·구독·다크패턴)으로도 함께 검수합니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_name": {
            "type": "string",
            "description": "제품명(선택). 있으면 수입요건도 함께 판정"
          },
          "product_type": {
            "type": "string",
            "enum": [
              "general_food",
              "health_functional_food",
              "cosmetics",
              "functional_cosmetics"
            ],
            "description": "품목 유형. 생략하면 문구·제품명에서 판단"
          },
          "ad_copy": {
            "type": "string",
            "description": "상세페이지·상품명·홍보 문구(최대 4,000자)"
          },
          "label_text": {
            "type": "string",
            "description": "라벨·한글표시사항을 텍스트로 옮긴 내용(최대 4,000자)"
          },
          "label_items": {
            "type": "object",
            "description": "항목별 체크(예: {'product_name': true, 'expiry_storage': false})"
          },
          "functional": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ],
            "description": "기능성 여부(화장품이면 기능성화장품)"
          },
          "imported": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ],
            "description": "수입 제품 여부"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "resale",
              "self_use"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 8
          }
        },
        "required": []
      }
    },
    {
      "name": "check_ecommerce_compliance",
      "description": "쿠팡ㆍ스마트스토어ㆍ자사몰 상세페이지 문구를 공정위 표시광고법ㆍ전자상거래법으로 검수합니다. 허위 정가ㆍ마감임박, 체험단 대가성 미표기, 청약철회ㆍ환불 제한, 배송ㆍ품절 책임 회피, 인증ㆍ수상, 최저가ㆍ1위, 구독ㆍ자동결제, 가격ㆍ해지 다크패턴과 판매자 정보 고지 누락을 근거 조문(시행일ㆍ원문 URL)과 수정 전→후 문구로 반환합니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "detail_copy": {
            "type": "string",
            "description": "상세페이지ㆍ판매페이지 문구(가격ㆍ후기ㆍ배송ㆍ청약철회 안내 포함, 최대 8,000자)"
          },
          "product_name": {
            "type": "string",
            "description": "제품명(선택)"
          },
          "channel": {
            "type": "string",
            "enum": [
              "coupang",
              "smartstore",
              "own",
              "other"
            ],
            "description": "판매 채널. 생략하면 기타"
          },
          "disclosure_items": {
            "type": "object",
            "description": "고지 항목 체크(예: {'seller_identity': true, 'withdrawal': false})"
          },
          "include_disclosure": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ],
            "default": "yes",
            "description": "판매자 정보ㆍ거래조건 고지 체크 포함 여부"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 12
          }
        },
        "required": [
          "detail_copy"
        ]
      }
    },
    {
      "name": "check_korean_labeling",
      "description": "품목군(화장품·식품/건강기능식품·전기·생활용품 KC·반려동물 사료·일반 공산품)별 법정 한글표시사항 체크리스트를 근거 조문(시행일·원문 URL)과 함께 주고, 입력한 라벨 문구에서 누락 의심 항목을 짚습니다. 라벨 문구가 없으면 체크리스트와 흔한 과태료 사례(한글 스티커 훼손, 전성분 누락, 소비기한/제조일자 혼동, KC 표시 누락, 원산지 미표시 등)를 돌려줍니다. 항목을 찾지 못한 것은 입력에 없다는 뜻이며, 0건이 라벨의 적법을 확정하지 않습니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_type": {
            "type": "string",
            "enum": [
              "cosmetics",
              "functional_cosmetics",
              "general_food",
              "health_functional_food",
              "kc_electronics",
              "pet_food",
              "general_goods"
            ],
            "description": "품목군. 화장품·식품/건기식·전기생활용품(KC)·반려동물 사료·일반 공산품. 생략하면 제품명·라벨에서 판단"
          },
          "product_group": {
            "type": "string",
            "description": "product_type 별칭(한글 가능: 화장품ㆍ사료ㆍ공산품)"
          },
          "product_name": {
            "type": "string",
            "description": "제품명(선택). 품목군 추정에 쓰고 저장하지 않음"
          },
          "label_text": {
            "type": "string",
            "description": "포장 라벨ㆍ한글표시사항을 텍스트로 옮긴 내용(최대 4,000자)"
          },
          "label_items": {
            "type": "object",
            "description": "항목별 체크(예: {'kc_mark': true, 'cert_number': false}). 키는 응답 checklist 의 item_id"
          },
          "imported": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ],
            "description": "수입 제품 여부(수입 사료의 한글 포장지 등 조건부 항목 판단)"
          },
          "channel": {
            "type": "string",
            "enum": [
              "direct",
              "agency",
              "parallel_import",
              "online",
              "unknown"
            ],
            "description": "유통 경로. 구매대행(agency)ㆍ병행수입(parallel_import)이면 고지ㆍ표시 항목이 추가됨"
          },
          "animal_origin": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ],
            "description": "반려동물 사료에 동물성(반추동물) 원료가 포함되는지"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 13,
            "default": 13
          }
        },
        "required": []
      }
    },
    {
      "name": "check_feed_import",
      "description": "강아지·고양이 사료ㆍ간식, 단미사료, 반려동물 영양제를 수입ㆍ판매할 때 사료관리법(성분등록ㆍ사료 수입신고ㆍ표시ㆍ유해물질ㆍ제조업 등록)과 동물검역(지정검역물ㆍ검역증명서ㆍ반려동물 사료 수입위생조건)에서 확인해야 할 항목을 정리합니다. 사료관리법에 '수입업 등록' 제도는 없다는 점을 포함해 근거 조문(시행일ㆍ원문 URL)과 함께 돌려줍니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_name": {
            "type": "string",
            "description": "품목명ㆍ질의(예: '강아지 동결건조 간식', '고양이 사료 수입 판매')"
          },
          "product_type": {
            "type": "string",
            "enum": [
              "feed",
              "treat",
              "supplement",
              "raw_material",
              "unknown"
            ],
            "description": "사료ㆍ간식ㆍ보조사료(영양제)ㆍ단미사료(원료). 생략하면 품목명에서 판단"
          },
          "animal": {
            "type": "string",
            "enum": [
              "dog",
              "cat",
              "other",
              "unknown"
            ],
            "description": "급여 대상 동물. 수입위생조건 대상은 개·고양이·페럿·햄스터"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "resale",
              "self_use",
              "unknown"
            ],
            "description": "판매ㆍ영업 목적인지 자가소비(직구ㆍ휴대)인지"
          },
          "animal_origin": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ],
            "description": "동물성 원료(육포ㆍ육분ㆍ유제품 등) 포함 여부"
          },
          "channel": {
            "type": "string",
            "enum": [
              "direct",
              "agency",
              "carry",
              "unknown"
            ],
            "description": "수입 경로: 직구ㆍ구매대행ㆍ휴대 반입"
          },
          "manufacture": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ],
            "description": "국내 제조ㆍ가공ㆍ재포장(OEM 포함) 여부(제조업 등록 대상 판단)"
          },
          "checks": {
            "type": "object",
            "description": "확인 결과(예: {'ingredient_registration': true, 'import_declaration': false, 'korean_label': 'yes'}). 키는 응답 checklist 의 check_id"
          },
          "hs_code": {
            "type": "string",
            "description": "HS 10자리(예: 2309101000). 있으면 세관장확인 요건을 실조회"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 13,
            "default": 13
          }
        },
        "required": [
          "product_name"
        ]
      }
    },
    {
      "name": "lookup_mfds_disposition",
      "description": "식품제조가공업(15124560)·식품판매업(15124559) 행정처분결과를 조회합니다. 승인 전파 전·오프라인이면 내장 대표 적발 패턴으로 안내하며, 업소명·대표자·연락처·주소·인허가번호는 반환하지 않습니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "industry": {
            "type": "string",
            "enum": [
              "manufacturing",
              "sales",
              "all"
            ],
            "default": "all"
          },
          "keyword": {
            "type": "string",
            "description": "위반법령·위반내용 키워드(예: '표시', '자가품질검사')"
          },
          "license_no": {
            "type": "string",
            "description": "인허가번호로 조회할 때(응답·저장에는 남기지 않음)"
          },
          "confirmed_on": {
            "type": "string",
            "description": "처분확정일 YYYYMMDD"
          },
          "rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 5
          }
        },
        "required": []
      }
    },
    {
      "name": "lookup_recall",
      "description": "브랜드·모델명·제품명으로 국내 리콜 이력을 조회합니다. 로컬 인덱스(국표원 15040696, 2022-07-26 기준 과거 색인 — 최신 리콜 미포함) 우선, 없으면 소스 미연결을 그대로 알립니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "brand": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "product_name": {
            "type": "string",
            "description": "제품명·품목군 키워드(예: '미니 선풍기')"
          },
          "category": {
            "type": "string",
            "description": "법정제품분류 키워드(예: '전지', '직류전원장치')"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 5
          }
        },
        "required": [
          "brand"
        ]
      }
    },
    {
      "name": "get_legal_basis",
      "description": "코퍼스에 수록된 법령 조항의 요지·시행일·원문 URL을 반환합니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "law": {
            "type": "string"
          },
          "article": {
            "type": "string"
          }
        },
        "required": [
          "law"
        ]
      }
    },
    {
      "name": "explain_trap",
      "description": "케이스 ID(TRAP-01~25)의 시나리오, 흔한 AI 오답, 정답, 근거를 반환합니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^TRAP-(0[1-9]|1[0-9]|2[0-5])$"
          }
        },
        "required": [
          "case_id"
        ]
      }
    },
    {
      "name": "get_compliance_trends",
      "description": "일일 스냅샷 기반으로 전일 대비 리콜·행정처분·금지성분 기준의 신규/변경/삭제 건수와, 최근 N일(기본 30) 급증 폼목군·위해유형·위반법령을 반환합니다. 스냅샷이 없으면 '없음'을 그대로 밝히며 0을 꾸며내지 않습니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90,
            "default": 30,
            "description": "조회 기간(일). 기본 30, 최대 90"
          },
          "source": {
            "type": "string",
