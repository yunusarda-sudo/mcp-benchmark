{
  "$schema": "../schema.json",
  "name": "eu.drafto/mcp",
  "title": "Drafto",
  "category": "Productivity & Notes",
  "description": "Create, read, search, and organize your Drafto notes and notebooks.",
  "repository": "https://github.com/JakubAnderwald/drafto",
  "tools": [
    {
      "name": "list_notebooks",
      "description": "List all notebooks for the current user",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "list_notes",
      "description": "List notes in a notebook (non-trashed, ordered by last updated)",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "notebook_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The notebook ID to list notes from"
          }
        },
        "required": [
          "notebook_id"
        ]
      }
    },
    {
      "name": "read_note",
      "description": "Read a note's full content as Markdown",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "note_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The note ID to read"
          }
        },
        "required": [
          "note_id"
        ]
      }
    },
    {
      "name": "search_notes",
      "description": "Full-text search across all notes (titles, content, and notebook names)",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Search query"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "create_notebook",
      "description": "Create a new notebook (refuses a name the user already has, ignoring case and spacing)",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Notebook name"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "create_note",
      "description": "Create a new note in a notebook with optional Markdown content",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "notebook_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The notebook ID to create the note in"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Note title"
          },
          "content_markdown": {
            "description": "Note content in Markdown format",
            "type": "string"
          }
        },
        "required": [
          "notebook_id",
          "title"
        ]
      }
    },
    {
      "name": "update_note",
      "description": "Update a note's title and/or content (provide Markdown for content)",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "note_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The note ID to update"
          },
          "title": {
            "description": "New title",
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "content_markdown": {
            "description": "New content in Markdown format",
            "type": "string"
          }
        },
        "required": [
          "note_id"
        ]
      }
    },
    {
      "name": "move_note",
      "description": "Move a note to a different notebook",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "note_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The note ID to move"
          },
          "notebook_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The target notebook ID"
          }
        },
        "required": [
          "note_id",
          "notebook_id"
        ]
      }
    },
    {
      "name": "trash_note",
      "description": "Move a note to trash (soft-delete, recoverable for 30 days)",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "note_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The note ID to trash"
          }
        },
        "required": [
          "note_id"
        ]
      }
    },
    {
      "name": "rename_notebook",
      "description": "Rename a notebook (trims the name; rejects an empty name or one another notebook has)",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "notebook_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The notebook ID to rename"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "New notebook name"
          }
        },
        "required": [
          "notebook_id",
          "name"
        ]
      }
    },
    {
      "name": "delete_notebook",
      "description": "Delete an empty notebook (refuses if it still holds non-trashed notes)",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "notebook_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The notebook ID to delete"
          }
        },
        "required": [
          "notebook_id"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "eu.drafto/mcp",
    "version": "1.2.1",
    "remoteUrl": "https://drafto.eu/api/mcp",
