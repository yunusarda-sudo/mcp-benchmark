{
  "$schema": "../schema.json",
  "name": "com.austinhappyhourdatabase/happy-hours",
  "title": "Austin Happy Hour Database",
  "category": "Databases & Storage",
  "description": "Find Austin happy hours by day, time, or location, with food and drink deals and venue source links.",
  "tools": [
    {
      "name": "hhdb_public_prep",
      "description": "Check public MCP readiness, listing count, cache state, and available read-only tools.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    },
    {
      "name": "list_happy_hours",
      "description": "Return paginated public Austin happy-hour listing summaries. Results are sanitized public data only.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    {
      "name": "search_happy_hours",
      "description": "Search public Austin happy-hour listings by text, day, and item type. Results are sanitized public data only.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "day": {
            "type": "string",
            "enum": [
              "Sunday",
              "Monday",
              "Tuesday",
              "Wednesday",
              "Thursday",
              "Friday",
              "Saturday"
            ]
          },
          "itemType": {
            "type": "string",
            "enum": [
              "Beer",
              "Wine",
              "Spirit",
              "Food"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    {
      "name": "find_happy_hours",
      "description": "Find detailed public Austin happy-hour candidates by text, active day/time, category, and proximity. Returns matching schedules, offers, coordinates, source links, revision metadata, straight-line distance in meters, and remaining deal time for crawl planning.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "day": {
            "description": "Austin local weekday. Required when time is provided.",
            "type": "string",
            "enum": [
              "Sunday",
              "Monday",
              "Tuesday",
              "Wednesday",
              "Thursday",
              "Friday",
              "Saturday"
            ]
          },
          "time": {
            "description": "24-hour HH:mm in America/Chicago. Returns programs active at this time.",
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "category": {
            "type": "string",
            "enum": [
              "Beer",
              "Wine",
              "Spirit",
              "Food"
            ]
          },
          "latitude": {
            "description": "Origin latitude. Must be provided with longitude.",
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "description": "Origin longitude. Must be provided with latitude.",
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "radiusMeters": {
            "description": "Maximum straight-line radius from the origin. Requires latitude and longitude.",
            "type": "integer",
            "minimum": 1,
            "maximum": 50000
          },
          "minimumRemainingMinutes": {
            "description": "Only include active windows with at least this many minutes remaining. Requires day and time.",
            "type": "integer",
            "minimum": 1,
            "maximum": 1440
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    {
      "name": "get_happy_hour",
      "description": "Return one public Austin happy-hour listing by slug or exact name. Results are sanitized public data only.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.austinhappyhourdatabase/happy-hours",
    "version": "2.0.0",
    "remoteUrl": "https://mcp.austinhappyhourdatabase.com/",
    "publishedAt": "2026-11-23T14:08:09.955467Z",
    "fetchedAt": "2026-11-24T12:15:48.059Z",
    "toolsSha256": "ca7424552d66fdeedd48a3242e05b8c35cd2e48de7f0d9738f51933c69e1f61e"
  }
}
