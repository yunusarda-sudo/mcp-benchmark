    {
      "name": "station_info",
      "description": "Facts about one Metra station in the Chicago area on one service date, by station ID or name: its routes and the downtown terminals it serves.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "description": "Exactly one of station_id or name. At most one of window_id, arrive_by, or depart_after: it limits terminal_services to the downtown terminals served at that time. Without one, terminal_services is the weekday peak (inbound_am, or outbound_pm when direction is outbound) or, on a Saturday or Sunday service_date, weekend_daytime. arrive_by and depart_after accept a clock time on the service date (H:MM, HH:MM, or HH:MM:SS, Chicago local time) or an RFC 3339 date-time with an offset.",
        "required": [
          "service_date"
        ],
        "properties": {
          "station_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
          },
