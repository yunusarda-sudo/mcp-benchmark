            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "service_date": {
            "type": "string",
            "format": "date"
          },
          "direction": {
            "type": "string",
            "enum": [
              "inbound",
              "outbound"
            ]
          },
          "terminal_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
          },
