    {
      "name": "report_issue",
      "description": "Sends Commlo the user's report that a commute answer, a missing address, or coverage is wrong. Use only when the user asks to report it. Do not offer or mention reporting otherwise. Do not include names, emails or phone numbers. Returns a reference id.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "description": "One report. Exactly one of address_id or address_text. At most one of window_id, arrive_by, or depart_after, as in the question asked.",
        "required": [
          "service_date",
          "category",
          "description"
        ],
        "properties": {
          "address_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "description": "The address_id from the answer, when there was one."
          },
          "address_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "The address as the user gave it, when there is no address_id."
          },
          "service_date": {
            "type": "string",
            "format": "date",
            "description": "The service date of the answer."
          },
          "window_id": {
            "type": "string",
            "enum": [
              "inbound_am",
              "outbound_pm",
              "inbound_offpeak",
              "outbound_offpeak",
              "weekend_daytime",
              "early_late"
            ],
            "description": "The window asked about, if any."
          },
          "arrive_by": {
            "type": "string",
            "minLength": 4,
            "description": "The arrive_by time asked about, if any.",
            "maxLength": 40
          },
          "depart_after": {
            "type": "string",
            "minLength": 4,
            "description": "The depart_after time asked about, if any.",
            "maxLength": 40
          },
          "direction": {
            "type": "string",
            "enum": [
              "inbound",
              "outbound"
            ],
            "description": "The direction asked about, if any."
          },
          "terminal_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$",
            "description": "The downtown terminal asked about, if any."
          },
          "station_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$",
            "description": "The station_id of the option that looks wrong, if any."
          },
          "route_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "The route_id of the option that looks wrong, if any."
          },
          "trip_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "The trip_id of the train that looks wrong, if any."
          },
          "category": {
            "type": "string",
            "enum": [
              "wrong_train_time",
              "wrong_station",
              "wrong_drive_or_walk_time",
              "address_not_found",
              "coverage_wrong",
              "other"
            ],
            "description": "What looks wrong."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "What the user says is wrong, in plain words."
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "What the user expected instead, if they said."
          }
        }
      }
    }
