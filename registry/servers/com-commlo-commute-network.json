                  "WA",
                  "WI",
                  "WV",
                  "WY"
                ]
              },
              "postal_code": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{5}(?:-\\d{4})?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "service_date": {
            "type": "string",
            "format": "date"
          },
          "direction": {
            "type": "string",
            "enum": [
              "inbound",
              "outbound"
            ]
          },
          "terminal_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
          },
          "window_id": {
            "type": "string",
            "enum": [
              "inbound_am",
              "outbound_pm",
              "inbound_offpeak",
              "outbound_offpeak",
              "weekend_daytime",
              "early_late"
            ]
          },
          "arrive_by": {
            "type": "string",
            "minLength": 4,
            "description": "A clock time on the service date (H:MM, HH:MM, or HH:MM:SS, local time in the region of the address or station) or an RFC 3339 date-time with an offset, for example 09:00, 2026-11-12T09:00:00-06:00, or 2026-11-12T15:00:00Z."
          },
          "depart_after": {
            "type": "string",
            "minLength": 4,
            "description": "A clock time on the service date (H:MM, HH:MM, or HH:MM:SS, local time in the region of the address or station) or an RFC 3339 date-time with an offset, for example 09:00, 2026-11-12T09:00:00-06:00, or 2026-11-12T15:00:00Z."
          },
          "buffer_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1800,
            "default": 300
          },
          "options": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 3,
            "description": "How many options to return, from 1 to 5, default 3. The nearest one or two stations are always included, so an answer can hold more options than requested."
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "intent": {
                "type": "string",
                "enum": [
                  "buy",
                  "rent"
                ],
                "description": "buy or rent, only if the user said so. Tailors the answer."
              },
              "wants_agent_contact": {
                "type": "boolean",
                "description": "True only if the user asked to be connected with a listing agent. Returns the agent's contact when listing contact is enabled."
              }
            },
            "minProperties": 1,
            "description": "Optional. Fill only with facts the user volunteered. No names, contact details or chat text."
          }
        }
      }
    },
