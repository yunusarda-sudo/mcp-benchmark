              "outbound_pm",
              "inbound_offpeak",
              "outbound_offpeak",
              "weekend_daytime",
              "early_late"
            ]
          },
          "arrive_by": {
            "type": "string",
            "minLength": 4,
            "description": "A clock time on the service date (H:MM, HH:MM, or HH:MM:SS, local time in the region of the address or station) or an RFC 3339 date-time with an offset, for example 09:00, 2026-11-12T09:00:00-06:00, or 2026-11-12T15:00:00Z."
          },
          "depart_after": {
