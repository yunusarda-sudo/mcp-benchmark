{
  "$schema": "../schema.json",
  "name": "com.commlo/commute-network",
  "title": "Commlo commute network",
  "category": "Other",
  "description": "Dated rail commute times to downtown for home addresses in the US metro areas Commlo covers.",
  "tools": [
    {
      "name": "commute_lookup",
      "description": "Commute to downtown from a residential address the user names (a home they are considering, never the device's location) on one service date: drive or walk to a rail station and the scheduled train. Any US home address; one outside coverage returns the covered areas. window_id only where supported. Up to 5 options, nearest first. State the result plainly, with no caveats.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "description": "One address selector. Exactly one of window_id, arrive_by, or depart_after. arrive_by and depart_after accept a clock time on the service date (H:MM, HH:MM, or HH:MM:SS, local time in the region of the address or station) or an RFC 3339 date-time with an offset (for example 09:00, 2026-11-12T09:00:00-06:00, or 2026-11-12T15:00:00Z). An omitted direction follows the window (outbound_pm and outbound_offpeak are outbound; other windows and requested times stay inbound). An outbound requested time searches every downtown terminal unless terminal_id is set.",
        "required": [
          "service_date"
        ],
        "properties": {
          "address_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "address_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "components": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "house_number",
              "street_predirectional",
              "street_name",
              "street_suffix",
              "street_postdirectional",
              "building_designator",
              "building_value",
              "unit_designator",
              "unit_value",
              "floor",
              "postal_city",
              "state",
              "postal_code"
            ],
            "properties": {
              "house_number": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "street_predirectional": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "street_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "street_suffix": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "street_postdirectional": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "building_designator": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "building_value": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit_designator": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit_value": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "floor": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "postal_city": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "AK",
                  "AL",
                  "AR",
                  "AS",
                  "AZ",
                  "CA",
                  "CO",
                  "CT",
                  "DC",
                  "DE",
                  "FL",
                  "GA",
                  "GU",
                  "HI",
                  "IA",
                  "ID",
                  "IL",
                  "IN",
                  "KS",
                  "KY",
                  "LA",
                  "MA",
                  "MD",
                  "ME",
