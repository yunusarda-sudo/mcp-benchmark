    {
      "name": "get_alerts_by_place",
      "description": "Active official weather alerts covering a location by site code.\n\n    Returns every active alert whose coverage includes the location,\n    with its colour coded risk level, or an empty list when none are\n    active. lang is en or fr.\n    ",
      "inputSchema": {
        "properties": {
          "site_code": {
            "title": "Site Code",
            "type": "string"
          },
          "lang": {
            "default": "en",
            "title": "Lang",
            "type": "string"
          }
        },
        "required": [
          "site_code"
        ],
        "title": "get_alerts_by_placeArguments",
        "type": "object"
      }
    },
    {
      "name": "get_alerts_by_coordinates",
      "description": "Active official weather alerts covering a latitude and longitude point. lang is en or fr.",
