    {
      "name": "get_air_quality",
      "description": "Air Quality Health Index for a place, current value plus forecast.\n\n    Identify the place with a site code from search_locations, a place\n    name in query, or a latitude and longitude pair. Values come from\n    the nearest air quality station, which is named in the result.\n    lang is en or fr.\n    ",
      "inputSchema": {
        "properties": {
          "site_code": {
            "default": "",
