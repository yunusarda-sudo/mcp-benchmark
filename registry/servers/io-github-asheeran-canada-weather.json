{
  "$schema": "../schema.json",
  "name": "io.github.asheeran/canada-weather",
  "title": "Canada Weather",
  "category": "Developer Tools & DevOps",
  "description": "Official Canadian weather for 844 places: forecasts, conditions, alerts and air quality, EN and FR.",
  "tools": [
    {
      "name": "search_locations",
      "description": "Search Canadian forecast locations by name, in English or French.\n\n    Returns matching locations with site code, names in both languages,\n    province code, and coordinates. Use the site code with the other tools.\n    ",
      "inputSchema": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "province": {
            "default": "",
            "title": "Province",
            "type": "string"
          },
          "limit": {
            "default": 10,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "title": "search_locationsArguments",
        "type": "object"
      }
    },
    {
      "name": "get_current_conditions",
      "description": "Current observed weather conditions for a location by site code.\n\n    lang is en or fr. Get the site code from search_locations.\n    ",
      "inputSchema": {
        "properties": {
          "site_code": {
            "title": "Site Code",
            "type": "string"
          },
          "lang": {
            "default": "en",
            "title": "Lang",
            "type": "string"
          }
        },
        "required": [
          "site_code"
        ],
        "title": "get_current_conditionsArguments",
        "type": "object"
      }
    },
    {
      "name": "get_daily_forecast",
      "description": "Daily forecast periods for a location by site code. lang is en or fr.",
      "inputSchema": {
        "properties": {
          "site_code": {
            "title": "Site Code",
            "type": "string"
          },
          "lang": {
            "default": "en",
            "title": "Lang",
            "type": "string"
          }
        },
        "required": [
          "site_code"
        ],
        "title": "get_daily_forecastArguments",
        "type": "object"
      }
    },
    {
      "name": "get_hourly_forecast",
      "description": "Hourly forecast for a location by site code. lang is en or fr.",
      "inputSchema": {
        "properties": {
          "site_code": {
            "title": "Site Code",
            "type": "string"
          },
          "lang": {
            "default": "en",
            "title": "Lang",
            "type": "string"
          },
