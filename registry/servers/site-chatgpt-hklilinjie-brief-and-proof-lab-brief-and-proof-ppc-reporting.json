{
  "$schema": "../schema.json",
  "name": "site.chatgpt.hklilinjie.brief-and-proof-lab/brief-and-proof-ppc-reporting",
  "title": "Brief & Proof",
  "category": "Communication & Alerting",
  "description": "Compare Google Ads, Meta and GA4 PPC reports, create campaign assets, or view a $49 review offer.",
  "tools": [
    {
      "name": "generate_campaign_pack",
      "description": "Create three editable SVG assets (square, story, landscape) and a reusable field manifest from an offer, brand colors, dates and HTTPS destination. Fixed templates; no Canva connection, external images, account access, publication or storage.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Campaign pack input",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "businessName",
          "offer",
          "startDate",
          "endDate",
          "cta",
          "destinationUrl",
          "brand"
        ],
        "properties": {
          "businessName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "offer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO calendar date (YYYY-MM-DD)"
          },
          "endDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO calendar date (YYYY-MM-DD)"
          },
          "cta": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36
          },
          "destinationUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^\\s]+$",
            "maxLength": 240
          },
          "brand": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "primaryColor",
              "accentColor"
            ],
            "properties": {
              "primaryColor": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "accentColor": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "disclaimer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "isSynthetic": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    {
      "name": "analyze_marketing_report",
      "description": "Compute source-separated period comparisons, CPA and reported ROAS from supplied Google Ads, Meta Ads and GA4 rows. Return row-level provenance and quality warnings. No ad account access, scheduling, causal attribution or campaign changes.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Marketing report snapshot input",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "currency",
          "timezone",
          "currentPeriod",
          "previousPeriod",
          "rows"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO-like three-letter currency code, normally USD."
          },
          "timezone": {
            "type": "string",
            "minLength": 1
          },
          "currentPeriod": {
            "$ref": "#/$defs/dateRange"
          },
          "previousPeriod": {
            "$ref": "#/$defs/dateRange"
          },
          "isSynthetic": {
            "type": "boolean",
            "description": "Use true only for a clearly labelled synthetic sample."
          },
          "rows": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/row"
            }
          }
        },
        "$defs": {
          "dateRange": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "end": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          },
          "row": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "campaign",
              "period"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "enum": [
                  "google_ads",
                  "meta_ads",
                  "ga4"
                ]
              },
              "campaign": {
                "type": "string",
                "minLength": 1
              },
              "period": {
                "enum": [
                  "current",
                  "previous"
                ]
              },
              "spend": {
                "type": "number",
                "minimum": 0
              },
              "conversions": {
                "type": "number",
                "minimum": 0
              },
              "revenue": {
                "type": "number",
                "minimum": 0
              },
              "sessions": {
                "type": "number",
                "minimum": 0
              },
              "leads": {
                "type": "number",
                "minimum": 0
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "timezone": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "name": "get_weekly_report_pilot",
      "description": "Look up the one-time price, eligibility, delivery target and application link for a human-reviewed weekly PPC report for US marketing agencies. The service compares two weeks of redacted Google Ads, Meta Ads, or GA4 exports and traces findings to source rows. Read-only lookup with no arguments.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Weekly PPC report pilot inquiry",
        "description": "Read the current price, fit, prerequisites, delivery target and official links for the optional human-reviewed report pilot. This tool accepts no arguments.",
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "site.chatgpt.hklilinjie.brief-and-proof-lab/brief-and-proof-ppc-reporting",
    "version": "0.1.1",
    "remoteUrl": "https://brief-and-proof-lab.hklilinjie.chatgpt.site/api/agent-tools",
    "publishedAt": "2026-11-22T10:58:17.193865Z",
    "fetchedAt": "2026-11-22T12:49:37.224Z",
    "toolsSha256": "6ad57de15d7ae7c953aee4643f6f51536cabf8540cc4a84bc9d5d3cb9ec68824"
  }
}
