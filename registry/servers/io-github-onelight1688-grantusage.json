{
  "$schema": "../schema.json",
  "name": "io.github.OneLight1688/grantusage",
  "title": "GrantUsage Licensing-Window Verifier",
  "category": "Developer Tools & DevOps",
  "description": "Licensing-window verification for film/TV titles on streaming platforms; verifiable evidence packs.",
  "repository": "https://github.com/GrantUsage/grantusage",
  "tools": [
    {
      "name": "check_availability",
      "description": "查某片在某平台某地域的最新自建观测状态与证据链接（只核验可获得性事实，不判权属、不出法律意见）",
      "inputSchema": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "territory": {
            "type": "string"
          }
        },
        "required": [
          "platform",
          "title",
          "territory"
        ]
      }
    },
    {
      "name": "list_expiring",
      "description": "列出 N 天内到期的授权窗口（默认 14 天）",
      "inputSchema": {
        "type": "object",
        "properties": {
          "days": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "list_conflicts",
      "description": "公开冲突清单：A/B 级自建观测证实的事实冲突（不含 exposure）",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_evidence_bundle",
      "description": "案件证据包：时间线+快照哈希+独立时间戳+声明来源（付费资源，x402 按次）",
      "inputSchema": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "integer"
          }
        },
        "required": [
          "case_id"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.OneLight1688/grantusage",
    "version": "0.1.0",
    "remoteUrl": "https://grantusage.com/mcp",
    "publishedAt": "2026-11-27T09:50:41.349046Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
