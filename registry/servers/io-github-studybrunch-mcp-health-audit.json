{
  "$schema": "../schema.json",
  "name": "io.github.StudyBrunch/mcp-health-audit",
  "title": "MCP Health Audit",
  "category": "AI, LLMs & Agents",
  "description": "Health, token bloat, SHA-256 Rug Pull & prompt injection audit API for remote MCPs.",
  "tools": [
    {
      "name": "check_mcp_health",
      "description": "接続予定のリモートMCPサーバーの健全性(SAFE/WARN/DANGER)・推定トークン消費量・過去30日稼働率・ツール定義ハッシュ変化(Rug Pull兆候)・隠し指示リスクを0.1秒で照会します。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "照会したいリモートMCPのエンドポイントURL"
          },
          "target_id": {
            "type": "string",
            "description": "既知のターゲットID (例: exa, deepwiki, github)"
          }
        }
      }
    },
    {
      "name": "list_safe_mcp_servers",
      "description": "監査済みの公開リモートMCPサーバー一覧を、判定(SAFE等)や上限トークン数で絞り込んで取得します。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "string",
            "enum": [
              "SAFE",
              "WARN",
              "DANGER"
            ]
          },
          "tier": {
            "type": "string",
            "enum": [
              "A",
              "B"
            ]
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    {
      "name": "live_audit_mcp_url",
      "description": "未登録の公開HTTPSリモートMCPサーバーへ即時接続し、ツール数・実測トークン数・隠し指示有無をリアルタイム監査します。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "検査対象の公開リモートMCP URL (https:// のみ)"
          },
          "force_ai_inspection": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "url"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.StudyBrunch/mcp-health-audit",
    "version": "0.4.0",
    "remoteUrl": "https://mcp-health-audit-iw5mxgoywq-uc.a.run.app/mcp",
    "publishedAt": "2026-11-24T08:30:42.352541Z",
