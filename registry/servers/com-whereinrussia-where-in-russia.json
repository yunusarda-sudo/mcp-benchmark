{
  "$schema": "../schema.json",
  "name": "com.whereinrussia/where-in-russia",
  "title": "Where in Russia",
  "category": "Other",
  "description": "Source-backed opportunity matching for Russia's 89 regions, with signed, replayable receipts.",
  "tools": [
    {
      "name": "opportunity_match",
      "description": "Ranks all 89 Russian regions for a household, matches residence routes and returns findings with sources. The result comes with an Ed25519-signed receipt that anyone can verify at /.well-known/jwks.json. Deterministic: the same input on the same build gives the same result digest.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "profile": {
            "type": "object",
            "additionalProperties": false,
            "description": "The household. Every field is optional; nothing identifies a person.",
            "properties": {
              "who": {
                "type": "string",
                "enum": [
                  "a",
                  "c",
                  "k",
                  "r"
                ],
                "description": "a = alone, c = couple, k = family with children, r = retirees"
              },
              "children": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "citizenship": {
                "type": "string",
                "enum": [
                  "eu",
                  "anglo",
                  "cis",
                  "other"
                ],
                "description": "eu = EU, anglo = US/UK/Canada/Australia/NZ, cis = CIS countries, other"
              },
              "russian": {
                "type": "string",
                "enum": [
                  "none",
                  "basic",
                  "good",
                  "native"
                ],
                "description": "Russian language level"
              },
              "work": {
                "type": "string",
                "enum": [
                  "r",
                  "f",
                  "b",
                  "p"
                ],
                "description": "r = job in Russia, f = foreign or remote income, b = own business, p = pension or savings"
              },
              "housing": {
                "type": "string",
                "enum": [
                  "rent",
                  "buy"
                ],
                "description": "rent or buy"
              },
              "land": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "s",
                    "m",
                    "w",
                    "f",
                    "c"
                  ],
                  "description": "landscape"
                },
                "description": "s = sea, m = mountains, w = forest, f = steppe/fields, c = city"
              },
              "must": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "h",
                    "a",
                    "i"
                  ],
                  "description": "must-have"
                },
                "description": "h = hospital nearby, a = airport, i = internet for remote work"
              },
              "ties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "roots",
                    "family",
                    "talent",
                    "invest",
                    "study"
                  ],
                  "description": "a tie to Russia"
                },
                "description": "roots, family, talent, invest, study"
              }
            }
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 4,
            "description": "up to 4 region ids to look at closely (see region_profile)"
          },
          "powers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "property",
                "work",
                "family",
                "health",
                "logistics",
                "culture",
                "language",
                "watch"
              ],
              "description": "agent power"
            },
            "description": "which optional agents may work; legal, region, economy and auditor always run"
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "ru"
            ],
            "description": "answer language"
          }
        }
      }
    },
    {
      "name": "residence_routes",
      "description": "Eight ways to live in Russia (Decree 702, compatriots, Decree 883, specialists, family, investors, study, standard), each built only from facts with a source and a date. Returns the routes that may fit; the authorities decide.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "citizenship": {
            "type": "string",
            "enum": [
              "eu",
              "anglo",
              "cis",
              "other"
            ],
            "description": "eu = EU, anglo = US/UK/Canada/Australia/NZ, cis = CIS countries, other"
          },
          "work": {
            "type": "string",
            "enum": [
              "r",
              "f",
              "b",
              "p"
            ],
            "description": "r = job in Russia, f = foreign or remote income, b = own business, p = pension or savings"
          },
          "ties": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "roots",
                "family",
                "talent",
                "invest",
                "study"
              ],
              "description": "a tie to Russia"
            },
            "description": "roots, family, talent, invest, study"
          },
          "all": {
            "type": "boolean",
            "description": "return all eight routes"
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "ru"
            ],
            "description": "answer language"
          }
        }
      }
    },
    {
      "name": "region_profile",
      "description": "Official figures for one of the 89 regions (population, area, gross regional product, housing prices, airports, universities), its administrative and international status layers and whether it takes part in the programme for compatriots. Every figure carries its source and period.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "region"
        ],
        "properties": {
          "region": {
            "type": "string",
            "description": "region id (e.g. tat, nsk, kgd) or its name in English or Russian"
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "ru"
            ],
            "description": "answer language"
          }
        }
      }
    },
    {
      "name": "ask_russia",
      "description": "Answers a question about Russia’s regions from verified records only, with citations; anything missing is reported as open. Without a Pass each client gets 3 new questions; an Intelligence Pass removes the limit.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question"
        ],
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 400
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "ru"
            ],
            "description": "answer language"
          }
        }
      }
    },
    {
      "name": "future_twin",
      "description": "A household’s first years in one region from verified rules and data: arrival costs, an apartment at the official average price, income tax before and after tax residence. The arrival year is open to everyone; years 1–3 need an Intelligence Pass.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "region"
        ],
        "properties": {
          "region": {
            "type": "string"
          },
          "people": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "kids": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          },
          "incomeEur": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000,
            "description": "monthly income in euros"
          },
          "incomeType": {
            "type": "string",
            "enum": [
              "russia",
              "foreign"
            ],
            "description": "where the income comes from"
          },
          "m2": {
            "type": "integer",
            "minimum": 20,
            "maximum": 300
          },
          "market": {
            "type": "string",
            "enum": [
              "new",
              "old"
            ],
            "description": "new build or resale"
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "ru"
            ],
            "description": "answer language"
          }
        }
      }
    },
