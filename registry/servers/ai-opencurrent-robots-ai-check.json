{
 "$schema": "../schema.json",
 "name": "ai.opencurrent/robots-ai-check",
 "title": "AI Crawler Permission Check",
 "category": "AI, LLMs & Agents",
 "description": "Check a site's robots.txt rules for AI crawlers (GPTBot, ClaudeBot, PerplexityBot and more).",
 "tools": [
  {
   "name": "check_ai_crawlers",
   "description": "For a domain (and optional path), whether each known AI crawler/agent user-agent is allowed by robots.txt, with the deciding rule.",
   "inputSchema": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
     "site": {
      "type": "string",
      "minLength": 4,
      "maxLength": 255
     },
     "path": {
      "type": "string",
      "maxLength": 500
     }
    },
    "required": [
     "site"
    ]
   }
  },
  {
   "name": "check_user_agent",
   "description": "Whether a given crawler user-agent token may fetch a path on a domain according to robots.txt.",
   "inputSchema": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
     "site": {
      "type": "string",
      "minLength": 4,
      "maxLength": 255
     },
     "user_agent": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
     },
     "path": {
      "type": "string",
      "maxLength": 500
     }
    },
    "required": [
     "site",
     "user_agent"
    ]
   }
  }
 ],
