{
  "$schema": "../schema.json",
  "name": "io.github.raydeoliveira/rfbench",
  "title": "RFBench for RF impedance, Touchstone and matching",
  "category": "Developer Tools & DevOps",
  "description": "Free impedance, link-budget and Touchstone analysis. Metered matching and FCC Part 15 pre-checks.",
  "repository": "https://github.com/raydeoliveira/rfbench",
  "tools": [
    {
      "name": "rf_smith_transform",
      "description": "Free tier: Deterministic Smith-chart conversions (Z, Y, Gamma, VSWR) and RLC equivalents. Supply exactly one of z, y, gamma, gamma_polar, or vswr_phase.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "z": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "re",
              "im"
            ],
            "properties": {
              "re": {
                "type": "number"
              },
              "im": {
                "type": "number"
              }
            }
          },
          "y": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "re",
              "im"
            ],
            "properties": {
              "re": {
                "type": "number"
              },
              "im": {
                "type": "number"
              }
            }
          },
          "gamma": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "re",
              "im"
            ],
            "properties": {
              "re": {
                "type": "number"
              },
              "im": {
                "type": "number"
              }
            }
          },
          "gamma_polar": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mag",
              "deg"
            ],
            "properties": {
              "mag": {
                "type": "number",
                "minimum": 0
              },
              "deg": {
                "type": "number"
              }
            }
          },
          "vswr_phase": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vswr",
              "deg"
            ],
            "properties": {
              "vswr": {
                "type": "number",
                "minimum": 1
              },
              "deg": {
                "type": "number"
              }
            }
          },
          "z0": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "freq_hz": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "allow_active": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "rf_link_budget",
      "description": "Free tier: Friis FSPL, EIRP/ERP, 290K thermal noise floor, SNR, Fresnel radius, and max range. Supply tx_gain_dbi or tx_gain_dbd.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "freq_hz",
          "distance_m",
          "tx_power_dbm",
          "rx_gain_dbi",
          "bandwidth_hz"
        ],
        "properties": {
          "freq_hz": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "distance_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "tx_power_dbm": {
            "type": "number"
          },
          "tx_gain_dbi": {
            "type": "number"
          },
          "tx_gain_dbd": {
            "type": "number"
          },
          "rx_gain_dbi": {
            "type": "number"
          },
          "tx_cable_loss_db": {
            "type": "number",
            "minimum": 0
          },
          "rx_cable_loss_db": {
            "type": "number",
            "minimum": 0
          },
          "bandwidth_hz": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "noise_figure_db": {
            "type": "number",
            "minimum": 0
          },
          "rx_sensitivity_dbm": {
            "type": "number"
          },
          "required_snr_db": {
            "type": "number"
          },
          "z0": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    {
      "name": "rf_match_network",
      "description": "Metered ($0.01): L/Pi/T impedance matching, E12-E96 snapping, finite-Q loss, and tolerance corner VSWR.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "z_load",
          "freq_hz"
        ],
        "properties": {
          "z_load": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "re",
              "im"
            ],
            "properties": {
              "re": {
                "type": "number"
              },
              "im": {
                "type": "number"
              }
            }
          },
          "z_source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "re",
              "im"
            ],
            "properties": {
              "re": {
                "type": "number"
              },
              "im": {
                "type": "number"
              }
            }
          },
          "freq_hz": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "topology": {
            "type": "string",
            "enum": [
              "auto",
              "l-network",
              "pi-network",
              "t-network"
            ]
          },
          "q_target": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "series": {
            "type": "string",
            "enum": [
              "ideal",
              "E12",
              "E24",
              "E48",
              "E96"
            ]
          },
          "component_q": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "max_vswr": {
            "type": "number",
            "minimum": 1
          }
        }
      }
    },
    {
      "name": "rf_txline",
      "description": "Free tier: Lossless and lossy transmission-line Z_in, Gamma_in, VSWR_in, and quarter-wave Z0. Supply length_m or electrical_deg.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "z_load",
          "freq_hz"
        ],
        "properties": {
          "z_load": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "re",
              "im"
            ],
            "properties": {
              "re": {
                "type": "number"
              },
              "im": {
                "type": "number"
              }
            }
          },
          "z0": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "freq_hz": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "length_m": {
            "type": "number",
            "minimum": 0
          },
          "electrical_deg": {
            "type": "number",
            "minimum": 0
          },
          "velocity_factor": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "attenuation_db_per_100m": {
            "type": "number",
            "minimum": 0
          },
          "allow_active": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "rf_touchstone_analyze",
      "description": "Free tier: IEEE Touchstone v1.0 .s1p/.s2p analysis, uniform single-pass phase rotation S_ij*exp(+j*2*pi*f*delay_ps*1e-12) across s11/s21/s12/s22 (use delay_ps=2*tau for 1-port round-trip VNA extension), passbands, and Rollett K/stability.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "touchstone_text"
        ],
        "properties": {
          "touchstone_text": {
            "type": "string",
            "minLength": 1
          },
          "port_override": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          },
          "vswr_threshold": {
            "type": "number",
            "minimum": 1
          },
          "delay_ps": {
            "type": "number",
            "description": "Uniform single-pass electrical phase rotation S_ij * exp(+j * 2 * pi * f * delay_ps * 1e-12) across all S-parameters (s11, s21, s12, s22). For 1-port round-trip VNA fixture extension of one-way delay tau, pass delay_ps = 2 * tau."
          },
          "include_points": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "rf_fcc_compliance",
      "description": "Metered ($0.02): 47 CFR Part 15 limits. Mode 'radiated' requires standard + points[1..4096]; 'conducted' requires standard + points[1..4096]; 'ism-comb' requires band + fundamental_hz (+ optional clocks_hz[<=64]).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "radiated",
              "conducted",
              "ism-comb"
            ]
          },
          "standard": {
            "type": "string",
            "enum": [
              "part15b-class-a",
              "part15b-class-b",
              "part15c-15.209",
              "class-a",
              "class-b"
            ],
            "description": "Required for mode='radiated' (part15b-class-a|part15b-class-b|part15c-15.209) or mode='conducted' (class-a|class-b)."
          },
          "detector": {
            "type": "string",
            "enum": [
              "qp",
              "peak",
              "avg"
            ],
            "description": "Default detector for radiated/conducted mode."
          },
          "measurement_distance_m": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Default distance in meters (radiated mode)."
          },
          "max_offenders": {
            "type": "integer",
            "minimum": 1
          },
          "points": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "description": "Required for mode='radiated' or mode='conducted' (1..4096 points).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "freq_hz"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "freq_hz": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "detector": {
                  "type": "string",
                  "enum": [
                    "qp",
                    "peak",
                    "avg"
                  ]
                },
                "distance_m": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "level_dbuv_m": {
                  "type": "number",
                  "description": "Direct field strength in dBuV/m (radiated mode)."
                },
                "level_dbuv": {
                  "type": "number",
                  "description": "Direct conducted emission in dBuV (conducted mode)."
                },
                "rx_dbuv": {
                  "type": "number",
                  "description": "Receiver reading in dBuV when deriving corrected level."
                },
                "antenna_factor_db_m": {
                  "type": "number",
                  "description": "Antenna factor in dB/m (radiated transducer path)."
                },
                "cable_loss_db": {
                  "type": "number",
                  "minimum": 0
                },
                "preamp_gain_db": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "band": {
            "type": "string",
            "enum": [
              "902-928",
              "2400-2483.5",
              "5725-5850"
            ],
            "description": "Required for mode='ism-comb'."
          },
          "fundamental_hz": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Required for mode='ism-comb'."
          },
          "antenna_gain_dbi": {
            "type": "number",
            "description": "Optional TX antenna gain in dBi (ism-comb)."
          },
          "conducted_power_dbm": {
            "type": "number",
            "description": "Optional TX conducted power in dBm (ism-comb)."
          },
          "max_harmonic": {
            "type": "integer",
            "minimum": 2,
            "maximum": 40,
            "description": "Max harmonic order 2..40 (ism-comb)."
          },
          "clocks_hz": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "description": "Optional MCU/LO clock frequencies in Hz (ism-comb, max 64)."
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
