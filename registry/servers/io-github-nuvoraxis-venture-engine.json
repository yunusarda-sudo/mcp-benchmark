{
  "$schema": "../schema.json",
  "name": "io.github.nuvoraxis/venture-engine",
  "category": "Developer Tools & DevOps",
  "description": "EVM AML/OFAC screening, gas/tx simulation, and DeFi invariant monitoring over Base USDC x402.",
  "repository": "https://github.com/nuvoraxis/venture-engine",
  "tools": [
    {
      "name": "screen_evm_address",
      "description": "Screen an EVM address for OFAC/mixer risk, contract bytecode, and EIP-1967 proxy status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "description": "0x-prefixed EVM address"
          },
          "chain": {
            "type": "string",
            "enum": [
              "base",
              "ethereum",
              "arbitrum"
            ],
            "default": "base"
          }
        },
        "required": [
          "address"
        ]
      }
    },
    {
      "name": "estimate_gas",
      "description": "Estimate EIP-1559 gas fees (slow/standard/fast/urgent), base fee trend, and congestion across Base, Ethereum, and Arbitrum.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chain": {
            "type": "string",
            "enum": [
              "base",
              "ethereum",
              "arbitrum"
            ],
            "default": "base"
          }
        }
      }
    },
    {
      "name": "simulate_transaction",
      "description": "Run pre-flight eth_call and eth_estimateGas simulation with Solidity revert decoding, OFAC/mixer pre-check, and mempool guard warnings.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chain": {
            "type": "string",
            "enum": [
              "base",
              "ethereum",
              "arbitrum"
            ],
            "default": "base"
          },
          "from": {
            "type": "string",
            "description": "Optional 0x-prefixed sender address"
          },
          "to": {
            "type": "string",
            "description": "Target contract or recipient 0x-prefixed address"
          },
          "data": {
            "type": "string",
            "description": "0x-prefixed calldata bytes",
            "default": "0x"
          },
          "value": {
            "type": "string",
            "description": "Native wei amount in decimal or 0x hex",
            "default": "0x0"
          },
          "gas": {
            "type": "string",
            "description": "Optional gas limit in decimal or 0x hex"
          },
          "maxFeePerGas": {
            "type": "string",
            "description": "Optional maxFeePerGas in wei"
          },
          "maxPriorityFeePerGas": {
            "type": "string",
            "description": "Optional maxPriorityFeePerGas in wei"
          },
          "blockTag": {
            "type": "string",
            "default": "latest"
          }
        }
      }
    },
    {
      "name": "check_rpc_health",
      "description": "Probe multi-chain RPC endpoint latency, block height lag, and circuit-breaker health status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chain": {
            "type": "string",
            "enum": [
              "base",
              "ethereum",
              "arbitrum"
            ],
            "description": "Optional chain filter; omit to probe all chains"
          }
        }
      }
    },
    {
      "name": "inspect_contract_invariants",
      "description": "Inspect a smart contract, ERC-20 token, or DEX/Vault pool for proxy/admin slots, bytecode opcodes, ERC-20 sanity, and reserve invariants.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "description": "0x-prefixed EVM contract or pool address"
          },
          "chain": {
            "type": "string",
            "enum": [
              "base",
              "ethereum",
              "arbitrum"
            ],
            "default": "base"
          },
          "tokens": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional extra ERC-20 token addresses to snapshot reserves for"
          }
        },
        "required": [
          "address"
        ]
      }
    },
    {
      "name": "diff_contract_snapshots",
      "description": "Compute a risk diff between two AuditPulse inspection snapshots and format a webhook alert payload (generic, slack, or discord).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "previous": {
            "type": "object",
            "description": "Baseline AuditPulse inspection report"
          },
          "current": {
            "type": "object",
            "description": "New AuditPulse inspection report (if omitted, fetches live state via JSON-RPC)"
          },
          "format": {
            "type": "string",
            "enum": [
              "generic",
              "slack",
              "discord"
            ],
            "default": "generic"
          },
          "reserveDropPctThreshold": {
            "type": "number",
            "default": 10
          },
          "supplyChangePctThreshold": {
            "type": "number",
            "default": 20
          }
        },
        "required": [
          "previous"
        ]
      }
    },
    {
      "name": "verify_x402_payment",
      "description": "Verify a Base Mainnet USDC x402 payment transaction receipt against the receive-only treasury.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "txHash": {
            "type": "string",
            "description": "0x-prefixed 64-hex Base transaction hash"
          },
          "minAmountUsdcUnits": {
            "type": "string",
            "default": "20000",
            "description": "Minimum USDC amount in 6-decimal base units (20000 = $0.02)"
          }
        },
        "required": [
          "txHash"
        ]
      }
    },
    {
      "name": "batch_screen_evm_addresses",
      "description": "Screen up to 20 EVM addresses in parallel for OFAC/mixer risk, contract bytecode, and EIP-1967 proxy status ($0.05 Base USDC).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "addresses": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 20,
            "description": "Array of 1 to 20 0x-prefixed EVM addresses"
          },
          "chain": {
            "type": "string",
            "enum": [
              "base",
              "ethereum",
              "arbitrum"
            ],
            "default": "base"
          }
        },
        "required": [
          "addresses"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.nuvoraxis/venture-engine",
    "version": "1.0.0",
    "remoteUrl": "https://venture-engine-gateway.leonid-ai-global.workers.dev/mcp",
    "publishedAt": "2026-11-26T14:05:17.105844Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "dd70cc7b019c404b5bb7cef9f12b4f3c1b85c4d74a0fa61ea22f70795fa24d8f"
  }
}
