{
  "$schema": "../schema.json",
  "name": "io.github.mioku50/veyra-trust",
  "title": "Veyra Trust",
  "category": "Developer Tools & DevOps",
  "description": "Check x402 payment terms and preview observed endpoint history on Arc mainnet.",
  "repository": "https://github.com/mioku50/Veyra",
  "tools": [
    {
      "name": "veyra_check_endpoint",
      "description": "Check the live USDC offer for an x402 endpoint on Arc mainnet before paying. Returns an unsigned verdict, evidence, and deterministic preflight (`pass` means no blocking fact was found, not an endorsement).",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "HTTPS x402 resource URL."
          },
          "method": {
            "description": "If omitted, use the live offer or catalogue method.",
            "type": "string",
            "enum": [
              "GET",
              "POST"
            ]
          },
          "budgetUsdc": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 5
          },
          "capability": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "resource"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "veyra_endpoint_history",
      "description": "Preview the recency and coverage of stored Arc USDC observations. Full history and change details are sold separately.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "HTTPS x402 resource URL."
          },
          "method": {
            "default": "POST",
            "type": "string",
            "enum": [
              "GET",
              "POST"
            ]
          }
        },
        "required": [
          "resource"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "veyra_list_resources",
      "description": "List Veyra's published free and paid x402 API resources and their HTTP methods.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {},
        "additionalProperties": false
      }
    }
  ],
