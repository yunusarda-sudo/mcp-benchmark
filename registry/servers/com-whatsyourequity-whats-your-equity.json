              {
                "type": "number",
                "const": 20
              },
              {
                "type": "number",
                "const": 25
              },
              {
                "type": "number",
                "const": 30
              }
            ]
          }
        },
        "required": [
          "state",
          "homeValue",
          "mortgageBalance",
          "otherLiens",
          "amount",
          "creditScore",
          "occupancy",
          "units",
          "selfEmployed"
        ]
      }
    },
    {
      "name": "calculate_heloc_payment",
      "description": "Calculate interest-only and amortizing monthly payments, plus how the payment changes if a variable rate moves -1 to +3 percentage points. Use a rate returned by get_live_heloc_rates or one the homeowner provides; never assume a market rate.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000,
            "description": "Amount borrowed or drawn, in whole dollars"
          },
          "annualRatePercent": {
            "type": "number",
            "minimum": 0,
            "maximum": 30,
            "description": "Annual interest rate in percent. Use a rate from get_heloc_quote or one the homeowner provides; never guess."
          },
          "rateSource": {
            "default": "homeowner_provided",
            "type": "string",
            "enum": [
              "live_quote",
              "homeowner_provided"
            ]
          },
          "drawYears": {
            "default": 5,
            "description": "Interest-only draw period in years (0 for a fixed loan)",
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "repaymentYears": {
            "default": 20,
            "description": "Amortizing repayment period in years",
            "type": "integer",
            "minimum": 1,
            "maximum": 40
          }
        },
        "required": [
          "amount",
          "annualRatePercent"
        ]
      }
    },
