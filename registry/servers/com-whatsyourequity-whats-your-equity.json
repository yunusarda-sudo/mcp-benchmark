              "WI",
              "WY"
            ],
            "description": "Two-letter US state code of the property"
          },
          "homeValue": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000,
            "description": "Estimated home value in whole US dollars"
          },
          "mortgageBalance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000,
            "description": "Current first mortgage balance in whole US dollars (0 if paid off)"
          },
          "otherLiens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000,
            "description": "Other liens on the home (existing HELOC or second mortgage) in whole dollars; ask, 0 if none"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000,
            "description": "Line amount or loan amount the homeowner wants, in whole dollars"
          },
          "creditScore": {
            "type": "string",
            "enum": [
              "780+",
              "760-779",
              "740-759",
              "720-739",
              "700-719",
              "680-699",
              "660-679",
              "640-659"
            ],
            "description": "Homeowner-stated credit score range. No credit check is made."
          },
          "occupancy": {
            "type": "string",
            "enum": [
              "primary",
              "second_home",
              "investment"
            ],
            "description": "How the home is used; ask the homeowner"
          },
          "units": {
            "type": "string",
            "enum": [
              "1",
              "2-4"
            ],
            "description": "Number of units in the property; ask the homeowner"
          },
          "selfEmployed": {
            "type": "boolean",
            "description": "Whether the borrower is self-employed (affects pricing); ask the homeowner"
          },
          "product": {
            "default": "both",
            "type": "string",
            "enum": [
              "heloc",
              "home_equity_loan",
              "both"
            ]
          },
          "drawYears": {
            "default": 5,
            "description": "HELOC draw period in years",
            "anyOf": [
