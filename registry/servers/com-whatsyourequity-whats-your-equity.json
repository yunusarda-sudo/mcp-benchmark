{
  "$schema": "../schema.json",
  "name": "com.whatsyourequity/whats-your-equity",
  "title": "What's Your Equity?",
  "category": "Finance, Crypto & Web3",
  "description": "US home value, home equity, HELOC and home equity loan quotes, payments and offer comparisons.",
  "tools": [
    {
      "name": "get_home_valuation",
      "description": "Estimate what a US home is worth today. Give the state and ZIP plus what the homeowner paid (or a past appraised value) and the year: the value is grown by the federal house price index for that ZIP area. Use when a homeowner asks what their home is worth or needs a value for an equity or HELOC estimate. If status is need_purchase_info, ask for the purchase price and year, or for their own estimate. Never guess a value.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "AL",
              "AK",
              "AZ",
              "AR",
              "CA",
              "CO",
              "CT",
              "DE",
              "FL",
              "GA",
              "HI",
              "ID",
              "IL",
              "IN",
              "IA",
              "KS",
              "KY",
              "LA",
              "ME",
              "MD",
              "MA",
              "MI",
              "MN",
              "MS",
              "MO",
              "MT",
              "NE",
              "NV",
              "NH",
              "NJ",
              "NM",
              "NY",
              "NC",
              "ND",
              "OH",
              "OK",
              "OR",
              "PA",
              "RI",
              "SC",
              "SD",
              "TN",
              "TX",
              "UT",
              "VT",
              "VA",
              "WA",
              "WV",
              "WI",
              "WY"
            ],
            "description": "Two-letter US state code of the property"
          },
          "zip": {
            "type": "string",
            "pattern": "^\\d{5}$",
            "description": "5-digit ZIP code"
          },
          "street": {
            "description": "Street address (used only by an address-level valuation, if available)",
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "city": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "knownValue": {
            "description": "What the homeowner paid, or their last appraised value, in whole dollars",
            "type": "integer",
            "minimum": 10000,
            "maximum": 100000000
          },
          "knownYear": {
            "description": "Year of that purchase or appraisal",
            "type": "integer",
            "minimum": 1975,
            "maximum": 2100
          },
          "knownMonth": {
            "description": "Month of that purchase or appraisal, if known",
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        },
        "required": [
          "state",
          "zip"
        ]
      }
    },
    {
      "name": "generate_home_intelligence_report",
      "description": "Build a personalized Home Equity Intelligence Report for a US home: estimated value and growth since purchase (federal house price index for the ZIP area), equity and how much can be borrowed (up to 90% combined loan-to-value), local price trends over 1/3/5/10 years versus the US, a Census neighborhood snapshot for the ZIP code, and, when a credit score range is given and the state is served, current HELOC and home equity loan quotes. The value is an index-based estimate, not an appraisal. Use when a homeowner asks what their home is worth, how much equity they have, or wants a full picture before borrowing. Needs state, ZIP, mortgage balance and either the home value or what they paid and the year.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "AL",
              "AK",
              "AZ",
              "AR",
              "CA",
              "CO",
              "CT",
              "DE",
              "FL",
              "GA",
              "HI",
              "ID",
              "IL",
              "IN",
              "IA",
              "KS",
              "KY",
              "LA",
              "ME",
              "MD",
              "MA",
              "MI",
              "MN",
              "MS",
              "MO",
              "MT",
              "NE",
              "NV",
              "NH",
              "NJ",
              "NM",
              "NY",
              "NC",
              "ND",
              "OH",
              "OK",
              "OR",
              "PA",
              "RI",
              "SC",
              "SD",
              "TN",
              "TX",
              "UT",
              "VT",
              "VA",
              "WA",
              "WV",
              "WI",
              "WY"
            ],
            "description": "Two-letter US state code of the property"
          },
          "zip": {
            "type": "string",
            "pattern": "^\\d{5}$",
            "description": "5-digit ZIP code of the home"
          },
          "street": {
            "description": "Street address, shown on the report",
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "city": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "homeValue": {
            "description": "Home value if the homeowner already knows it; otherwise give knownValue and knownYear",
            "type": "integer",
            "minimum": 10000,
            "maximum": 100000000
          },
          "knownValue": {
            "description": "What the homeowner paid, or a past appraised value",
            "type": "integer",
            "minimum": 10000,
            "maximum": 100000000
          },
          "knownYear": {
            "description": "Year of that purchase or appraisal",
            "type": "integer",
            "minimum": 1975,
            "maximum": 2100
          },
          "knownMonth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "mortgageBalance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000,
            "description": "Current first mortgage balance (0 if none)"
          },
          "otherLiens": {
            "default": 0,
            "description": "Existing HELOC or second mortgage balance",
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "amount": {
            "description": "Amount the homeowner would like to borrow, for live rates",
            "type": "integer",
            "minimum": 20000,
            "maximum": 100000000
          },
          "creditScore": {
            "description": "Homeowner-stated credit score range, for live rates (no credit check)",
            "type": "string",
            "enum": [
              "780+",
              "760-779",
              "740-759",
              "720-739",
              "700-719",
              "680-699",
              "660-679",
              "640-659"
            ]
          },
          "occupancy": {
            "description": "How the home is used; needed for rates",
            "type": "string",
            "enum": [
              "primary",
              "second_home",
              "investment"
            ]
          },
          "units": {
            "description": "Number of units; needed for rates",
            "type": "string",
            "enum": [
              "1",
              "2-4"
            ]
          },
          "selfEmployed": {
            "description": "Whether the borrower is self-employed; needed for rates",
            "type": "boolean"
          }
        },
        "required": [
          "state",
          "zip",
          "mortgageBalance"
        ]
      }
    },
    {
      "name": "calculate_home_equity",
      "description": "Calculate a homeowner's estimated equity, loan-to-value and combined loan-to-value, plus potential borrowing capacity at 70%, 75%, 80% and 90% combined loan-to-value (90% is the program maximum). Inputs are the home value and lien balances in whole dollars. The capacity figures are arithmetic scenarios, not loan offers or approvals.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "homeValue": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000,
            "description": "Estimated home value in whole US dollars"
          },
          "valueSource": {
            "default": "homeowner_estimate",
            "description": "Where the home value came from",
            "type": "string",
            "enum": [
              "automated_valuation",
              "homeowner_estimate"
            ]
          },
          "mortgageBalance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000,
            "description": "Current first mortgage balance in whole dollars (0 if none)"
          },
          "otherLiens": {
            "default": 0,
            "description": "Existing HELOC, second mortgage or other lien balances in whole dollars",
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "state": {
            "description": "US state of the home, so state legal limits can be shown",
            "type": "string",
