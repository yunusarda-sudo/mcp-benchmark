{
  "$schema": "../schema.json",
  "name": "studio.sevenfourone.api/company-signals",
  "title": "Company Signals",
  "category": "Jobs, Career & Learning",
  "description": "SEC events, state WARN layoffs, job-board hiring and federal awards per company. Paid via x402.",
  "tools": [
    {
      "name": "company_signals",
      "description": "Joined company signals for one US ticker, each linked to its public source: SEC 8-K/13D/insider events, state WARN layoff and closure notices (CA, NY, TX, WA, NJ), public job-board hiring counts and federal contract awards (USAspending, last 12 months). Optional since= for only new facts. $0.01 per call.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 66,
            "description": "US stock symbol (NET), or name:<slug> for a covered private company (name:openai)"
          },
          "since": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "ticker"
        ]
      }
    },
    {
      "name": "signals_search",
      "description": "Search all company signals with typed filters: layer, type, state, ticker, min/max contract amount, min worker or role count, event date range, first-seen since (change log), closure, matched, min match confidence and text. Every row has a source link. $0.03 per call.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "layer": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "sec",
                "warn",
                "jobs",
                "contracts"
              ]
            }
          },
          "type": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "CA",
                "NY",
                "TX",
                "WA",
                "NJ"
              ]
            }
          },
          "ticker": {
            "maxItems": 25,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min_amount": {
            "type": "number",
            "minimum": 0
          },
          "max_amount": {
            "type": "number",
            "minimum": 0
          },
          "min_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "date_from": {
            "type": "string"
          },
          "date_to": {
            "type": "string"
          },
          "since": {
            "type": "string"
          },
          "closure": {
            "type": "boolean"
          },
          "matched": {
            "type": "boolean"
          },
          "min_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "q": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "sort": {
            "type": "string",
            "enum": [
              "event_date",
              "amount",
              "count",
              "first_seen"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    },
    {
      "name": "company_dossier",
      "description": "Full company dossier: identifiers (CIK, tickers, federal recipient UEIs with match confidence, job boards), per-layer summaries (SEC, WARN, hiring trend, contracts by agency), recent postings, a 30-day change log and every fact with its source link. $0.25 per call.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 66,
            "description": "US stock symbol (NET), or name:<slug> for a covered private company (name:openai)"
          }
        },
        "required": [
          "ticker"
        ]
      }
    },
    {
      "name": "sample",
      "description": "Free: what is covered, real example rows from each layer, fact types and prices.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "health",
      "description": "Free: service status, fact counts and last ingest runs.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "studio.sevenfourone.api/company-signals",
    "version": "0.1.0",
    "remoteUrl": "https://api.sevenfourone.studio/signals/mcp",
    "publishedAt": "2026-11-25T01:55:19.152596Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "3062b1c42d27b2c0fd69c6b310046ecef687103277c78e3c9d8144088c6fb440"
  }
}
