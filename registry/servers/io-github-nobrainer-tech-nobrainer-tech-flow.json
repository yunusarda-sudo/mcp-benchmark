{
  "$schema": "../schema.json",
  "name": "io.github.nobrainer-tech/nobrainer-tech-flow",
  "title": "NoBrainer Tech Flow",
  "category": "AI, LLMs & Agents",
  "description": "Task contract, evidence check and done gate for AI coding agents. Read-only, no sign-in.",
  "repository": "https://github.com/nobrainer-tech/nobrainer-tech-flow",
  "tools": [
    {
      "name": "start_flow_task",
      "description": "Use at the start of a non-trivial task. Checks your proposed outcome and definition of done (DoD) against Flow's contract rules, chooses the quick or full path, and returns DoD item IDs, a signed contract token and the first step. Computes only; stores nothing. Save the token in your goal file.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "maxLength": 300,
            "description": "Observable result and who sees it"
          },
          "dod": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 160,
                  "description": "One checkable acceptance item"
                },
                "proof": {
                  "enum": [
                    "test",
                    "command",
                    "file",
                    "url",
                    "observation"
                  ],
                  "description": "Evidence kind that proves it"
                },
                "level": {
                  "description": "Evidence level needed; default per proof",
                  "enum": [
                    "static",
                    "local",
                    "deployed",
                    "production",
                    "delivered",
                    "user"
                  ]
                }
              },
              "required": [
                "text",
                "proof"
              ],
              "additionalProperties": false
            }
          },
          "non_goals": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120
            }
          },
          "risks": {
            "description": "Risks that add Flow modules and owner gates",
            "maxItems": 6,
            "type": "array",
            "items": {
              "enum": [
                "public_contract",
                "irreversible",
                "external_effect",
                "multi_session",
                "security",
                "ambiguous"
              ]
            }
          },
          "local_flow": {
            "description": "Version of a locally loaded Flow skill, if any",
            "type": "string",
            "maxLength": 20
          }
        },
        "required": [
          "outcome",
          "dod"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_flow_step",
      "description": "Use when you need guidance on a Flow stage, an event (e.g. blocked), a module (e.g. nobrainer-review), or a PR's Definition of Done or readiness (topic pr_dod). Returns up to six rules quoted from the pinned release, with their source. With a token, event resume also returns a goal block.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 2048
          },
          "stage": {
            "enum": [
              "DRIFT_CHECK",
              "BUDDY",
              "SCOPE",
              "AUTOPILOT",
              "VERIFY",
              "RECEIVE_AUDIT",
              "LEARN"
            ]
          },
          "event": {
            "enum": [
              "blocked",
              "review_failed",
              "decision_changed",
              "worker_reported",
              "repeated_failure",
              "resume"
            ]
          },
          "module": {
            "type": "string",
            "pattern": "^nobrainer-[a-z-]{2,40}$"
          },
          "topic": {
            "description": "pr_dod: gates and verdict for a pull request's Definition of Done",
            "enum": [
              "pr_dod"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "check_flow_evidence",
      "description": "Use after running a check. Validates one to four evidence records against DoD items in the contract token: exit codes, test counts in the output, hashes, URL status and evidence level. It cannot see your machine; it checks structure and consistency only. Returns verdicts and an updated token.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 2048,
            "description": "Contract token from start_flow_task or the last check"
          },
          "evidence": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item": {
                  "type": "string",
                  "pattern": "^AC[0-9]{2}$"
                },
                "kind": {
                  "enum": [
                    "test",
                    "command",
                    "file",
                    "url",
                    "observation"
                  ]
                },
                "cmd": {
                  "type": "string",
                  "maxLength": 300
                },
                "exit": {
                  "type": "integer"
                },
                "out": {
                  "description": "Last lines of output, including the summary line",
                  "type": "string",
                  "maxLength": 4000
                },
                "passed": {
                  "type": "integer",
                  "minimum": 0
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0
                },
                "path": {
                  "type": "string",
                  "maxLength": 300
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "url": {
                  "type": "string",
                  "maxLength": 500
                },
                "status": {
                  "type": "integer"
                },
                "note": {
                  "type": "string",
                  "maxLength": 300
                },
                "expected": {
                  "description": "Items expected (rows, pages)",
                  "type": "integer",
                  "minimum": 0
                },
                "received": {
                  "description": "Items returned",
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "item",
                "kind"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "token",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "check_flow_done",
      "description": "Use before saying a task is done. Returns DONE only when every DoD item has accepted, current evidence, DONE_WITH_GAPS when the rest are listed in unchecked with a reason, otherwise NOT_DONE with the exact missing items.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 2048,
            "description": "Latest contract token"
          },
          "unchecked": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item": {
                  "type": "string",
                  "pattern": "^AC[0-9]{2}$"
                },
                "reason": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 200
                }
              },
              "required": [
                "item",
                "reason"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "token"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "draft_flow_handoff",
      "description": "Use after check_flow_done. Returns a short final-report skeleton from the done receipt: delivered outcome, proof per DoD item, what was not checked, decisions left to the user and the next action.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "receipt": {
            "type": "string",
            "maxLength": 2048,
            "description": "Receipt from check_flow_done"
          }
        },
        "required": [
          "receipt"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "recommend_flow_model",
      "description": "Use when picking a model for a Flow task: top-3 from a pinned NoBrainer benchmark snapshot, no invented scores.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "enum": [
              "nb-index",
              "orchestration",
              "instructions",
              "frontend",
              "research",
              "writing",
              "terminal-coding"
            ]
          },
          "have": {
            "description": "Providers, models or apps you can use",
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "priority": {
            "enum": [
              "quality",
              "balanced",
              "efficient"
            ]
          },
          "role": {
            "enum": [
              "main",
              "worker"
            ]
          }
        },
        "required": [
          "task"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.nobrainer-tech/nobrainer-tech-flow",
    "version": "2.13.1",
    "remoteUrl": "https://mcp.nobrainer.tech/mcp",
