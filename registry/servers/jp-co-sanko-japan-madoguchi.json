{
  "$schema": "../schema.json",
  "name": "jp.co.sanko-japan/madoguchi",
  "title": "三興 試作の相談窓口 (Sanko prototype inquiry)",
  "category": "AI, LLMs & Agents",
  "description": "Japanese prototype maker: design models, CNC, vacuum casting, molds. Check fit and send inquiries.",
  "tools": [
    {
      "name": "get_company_profile",
      "description": "株式会社三興（SANKO, 試作・デザインモデル・金型・樹脂成形の会社）の会社概要・拠点・強み・得意な分野。Company profile of SANKO Co., Ltd.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "list_capabilities",
      "description": "三興が受けられる作り方の一覧（デザイン設計、クレイモデル、切削、3D プリント＝粉末造形、真空注型、真空成形、表面処理、金型、射出・ブロー成形の量産）と、それぞれ何に向くか・個数の目安。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "check_feasibility",
      "description": "作りたい物の条件（目的・個数・大きさ・材質・3D データの有無・期限）から、三興で相談できるか、どの作り方が向くかを返す。三興でできない工程（金属の切削・板金など）は協力工場への取次になる。価格・納期の約束はしない。Check whether SANKO can handle a prototype request and which methods fit.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "description": "何に使うか（展示会用の見た目／形の確認／機能試験／量産前 など）"
          },
          "description": {
            "type": "string",
            "description": "作りたい物の説明"
          },
          "quantity": {
            "type": "string",
            "description": "個数（例: 1, 10, 20, 量産）"
          },
          "size": {
            "type": "string",
            "description": "おおよその大きさ（mm）"
          },
          "material": {
            "type": "string",
            "description": "材質・見た目の希望"
          },
          "has_3d_data": {
            "type": "string",
            "description": "3D データ・図面の有無（あり／2D だけ／スケッチだけ／なし）"
          },
          "deadline": {
            "type": "string",
            "description": "希望の期限"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_inquiry_checklist",
      "description": "三興に試作を相談するとき、相談者に聞いておく項目の一覧（目的・物・大きさ・個数・材質・データ・期限・連絡先）。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "submit_inquiry",
      "description": "試作の相談を三興の担当者にメールで送る。相談できるのは法人・個人事業主のみ。送る前に、送る内容を相談者本人に見せて「送ってよい」と言われたときだけ呼ぶ（user_confirmed: true）。受付番号を返す。ファイルは受け取らない。Send the prototype inquiry to SANKO (only after the user has reviewed and approved it).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string",
            "description": "会社名（個人なら空でよい）"
          },
          "name": {
            "type": "string",
            "description": "お名前"
          },
          "email": {
            "type": "string",
            "description": "返信用メールアドレス"
          },
          "phone": {
            "type": "string",
            "description": "電話番号（任意）"
          },
          "prefecture": {
            "type": "string",
            "description": "都道府県（任意）"
          },
          "summary": {
            "type": "string",
            "description": "ご相談の内容（何を・何のために作りたいか。相談者の言葉で）"
          },
          "purpose": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "material": {
            "type": "string"
          },
          "has_3d_data": {
            "type": "string"
          },
          "deadline": {
            "type": "string"
          },
          "applicant_type": {
            "type": "string",
            "enum": [
              "法人",
              "個人事業主"
            ],
            "description": "相談できるのは法人・個人事業主のみ"
          },
          "request_type": {
            "type": "string",
            "enum": [
              "三興で作る",
              "取次（協力工場）を含む",
              "わからない"
            ],
            "description": "check_feasibility の request_type"
          },
          "user_confirmed": {
            "type": "boolean",
            "description": "相談者本人が送る内容を確かめ、三興から連絡が来ることに同意したら true"
          }
        },
        "required": [
          "name",
          "email",
          "summary",
          "applicant_type",
          "user_confirmed"
        ],
        "additionalProperties": false
      }
    }
  ],
