{
  "$schema": "../schema.json",
  "name": "io.github.quickman924/shanglan-womenswear",
  "title": "Shanglan factory facts",
  "category": "Developer Tools & DevOps",
  "description": "Look up published Shanglan women's OEM factory facts, MOQ, styles, guides, and inquiry checklist.",
  "tools": [
    {
      "name": "get_factory_profile",
      "description": "Published identity, capabilities, quality, boundaries, and contact facts for Shanglan, a women's clothing factory in Shenzhen. Optional section filter. Does not include prices, stock, certifications, or a WhatsApp number.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "section": {
            "description": "Omit or use all for every section.",
            "type": "string",
            "enum": [
              "identity",
              "capabilities",
              "quality",
              "boundaries",
              "contact",
              "all"
            ]
          }
        }
      }
    },
    {
      "name": "lookup_production_terms",
      "description": "Look up one published commercial term: moq, sampling, revisions, bulk, shipping, response, or quality. Use all for every term. Ranges are copied from the site with their start conditions. This does not reserve capacity or promise a ship date.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "moq",
              "sampling",
              "revisions",
              "bulk",
              "shipping",
              "response",
              "quality",
              "all"
            ]
          }
        },
        "required": [
          "topic"
        ]
      }
    },
    {
      "name": "search_styles",
      "description": "Search the published women's development styles by keyword, style code (SY001), or category (woven, denim, knit). Returns names, excerpts, and public URLs. A style code that is not on the site is an error. These are development references, not priced stock.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "code": {
            "type": "string",
            "pattern": "^SY\\d{3}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "woven",
              "denim",
              "knit"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        }
      }
    },
    {
      "name": "search_guides",
      "description": "Search published FAQ answers and the MOQ, timeline, and low-MOQ guide passages. The query must contain a real word. An unknown topic returns an empty match list, not a guessed answer.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "prepare_inquiry_checklist",
      "description": "Turn what the buyer already has into a checklist for the public quote form. Requires at least one real starting point: tech pack, sketch, reference photos, sample garment, or a published style code. Does not submit the inquiry or contact the factory.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "techPack": {
            "type": "boolean"
          },
          "sketch": {
            "type": "boolean"
          },
          "referencePhotos": {
            "type": "boolean"
          },
          "sampleGarment": {
            "type": "boolean"
          },
          "styleCodes": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SY\\d{3}$"
            }
          },
          "category": {
            "type": "string",
            "enum": [
              "woven",
              "denim",
              "knit",
              "mixed-or-unsure"
            ]
          },
          "quantityBand": {
            "type": "string",
            "enum": [
              "50–99 pieces",
              "100–299 pieces",
              "300–499 pieces",
              "500–999 pieces",
              "1,000+ pieces",
              "Not sure yet"
            ]
          },
          "sizeRange": {
            "type": "string",
            "enum": [
              "xs-xxl",
              "eu-34-48",
              "us-0-16",
              "uk-6-20",
              "plus-or-special",
              "unspecified"
            ]
          },
          "wantsLabelsOrPackaging": {
            "type": "boolean"
          },
          "notes": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.quickman924/shanglan-womenswear",
    "version": "1.0.0",
    "remoteUrl": "https://customgarmentmanufacturer.com/api/mcp",
    "publishedAt": "2026-11-25T10:01:01.540459Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "8f6668745b4967145f62f27360102647745c955d936f697565c76be098610305"
  }
}
