{
  "$schema": "../schema.json",
  "name": "com.rexceltech/pvault",
  "title": "RexCelTech pvault — Protein Database & Construct Workbench",
  "category": "Databases & Storage",
  "description": "Read-only protein database, homolog search, 3D geometry, MSA, and construct audit MCP server.",
  "repository": "https://github.com/Rexceltech/pvault",
  "tools": [
    {
      "name": "pvault_vault_overview",
      "description": "Vault entity_kind, counts, default_vault, registered_vaults, vault_groups.",
      "inputSchema": {
        "properties": {
          "include": {
            "description": "'sections','provenance'.",
            "type": "array"
          },
          "vault": {
            "description": "Vault.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "pvault_lookup_accession",
      "description": "Lookup records (seq, termini, aligned_span) by accession, stem, prefix, seq_id, seq_hash, or domain_architecture.",
      "inputSchema": {
        "properties": {
          "include": {
            "description": "'cluster_delta','biophysics','motifs'.",
            "type": "array"
          },
          "limit": {
            "description": "Max (default 5).",
            "type": "integer"
          },
          "mode": {
            "description": "Mode (default 'exact').",
            "enum": [
              "exact",
              "prefix",
              "stem",
              "seq_id",
              "seq_hash",
              "domain_architecture"
            ],
            "type": "string"
          },
          "output_path": {
            "description": "Export .tsv/.jsonl/.fasta.",
            "type": "string"
          },
          "query": {
            "description": "Accession, stem, prefix, seq_id, or seq.",
            "type": "string"
          },
          "vault": {
            "description": "Vault, 'all', or 'v1,v2'.",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      }
    },
    {
      "name": "pvault_query",
      "description": "Declarative query over .pvault, UNIONs, GROUP BY cluster, and .p3d structures; mints ResultSetHandleId.",
      "inputSchema": {
        "properties": {
          "explain": {
            "description": "Plan only (omits rows and handle_id).",
            "type": "boolean"
          },
          "histograms": {
            "description": "Include histograms (default false).",
            "type": "boolean"
          },
          "output_path": {
            "description": "Export .tsv/.jsonl/.fasta (<=5000).",
            "type": "string"
          },
          "query": {
            "description": "FROM <vault|v1 UNION v2|structures> [WHERE ...] [GROUP BY cluster] [ORDER BY ...] [LIMIT ...] [OFFSET ...] [PRECISION QUANTIZED|EXACT] [SELECT ...].",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      }
    },
    {
      "name": "pvault_search_homologs",
      "description": "1D sequence or 3Di structural homolog search returning ResultSetHandleId and top hits.",
      "inputSchema": {
        "properties": {
          "comp_bias": {
            "description": "Bias.",
            "enum": [
              "local_sliding_window",
              "none"
            ],
            "type": "string"
          },
          "dedup_by_protein": {
            "description": "Dedup chains (3Di).",
            "type": "boolean"
          },
          "include": {
            "description": "'sequence','description'.",
            "type": "array"
          },
          "limit": {
            "description": "Max (1..=32).",
            "type": "integer"
          },
          "max_e_value": {
            "description": "Max E-value.",
            "type": "number"
          },
          "min_cov": {
            "description": "Min %cov.",
            "type": "integer"
          },
          "min_pct_id": {
            "description": "Min 1D %id.",
            "type": "integer"
          },
          "min_pct_id_3di": {
            "description": "Min 3Di %id.",
            "type": "integer"
          },
          "mode": {
            "description": "Mode.",
            "enum": [
              "homolog_align",
              "structural_3di"
            ],
            "type": "string"
          },
          "output_path": {
            "description": "Export .tsv/.jsonl/.fasta.",
            "type": "string"
          },
          "query": {
            "description": "1D seq, 3Di acc/seq, or .pdb/.cif.",
            "type": "string"
          },
          "sort": {
            "description": "1D: score|pct_id|cov|members_desc; 3Di: structural_score|tm_score|lddt|bit_score_desc|evalue_asc.",
            "type": "string"
          },
          "two_pass": {
            "description": "Two-pass.",
            "type": "boolean"
          },
          "vault": {
            "description": "Vault, group, 'all', or 'v1,v2'.",
            "type": "string"
          },
          "where": {
            "description": "WHERE or @h_xxxx.",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      }
    },
    {
      "name": "pvault_inspect_cluster",
      "description": "Cluster conservation, Neff, foldability, 3D hotspots, subclade slicing & ASR.",
      "inputSchema": {
        "properties": {
          "algorithm": {
            "description": "Tree algo.",
            "enum": [
              "nj",
              "upgma"
            ],
            "type": "string"
          },
          "asr_model": {
            "description": "ASR.",
            "enum": [
              "lg",
              "wag",
              "jukes-cantor"
            ],
            "type": "string"
          },
          "cluster_id": {
            "description": "cluster_id.",
            "type": "integer"
          },
          "family_name": {
            "description": "Family.",
            "type": "string"
          },
          "max_leaves": {
            "description": "Max leaves (64).",
            "type": "integer"
          },
          "node_id": {
            "description": "Tree node_id.",
            "type": "integer"
          },
          "output_path": {
            "description": "Export .json/.nwk/.fasta.",
            "type": "string"
          },
          "sdp_rules": {
            "description": "SDP e.g. '42=C,88=H'.",
            "type": "string"
          },
          "slice_subclade": {
            "description": "Tree+ASR+handle.",
            "type": "boolean"
          },
          "vault": {
            "description": "Vault.",
            "type": "string"
          },
          "where": {
            "description": "WHERE or @h_xxxx.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "pvault_measure_3d_geometry",
      "description": "3D Ca/Cb distances, lDDT/TM-score, constellation check, or PDB export.",
      "inputSchema": {
        "properties": {
          "accession": {
            "description": "Accession (or seq_id).",
            "type": "string"
          },
          "constellation": {
            "description": "Constellation (Cβ–Cβ Å, ':ca').",
            "type": "string"
          },
          "export_pdb": {
            "description": "Export PDB.",
            "type": "boolean"
          },
          "output_pdb_path": {
            "description": "PDB path.",
            "type": "string"
          },
          "residue_pairs": {
            "description": "<=16 [r1,r2] pairs.",
            "type": "array"
          },
          "seq_id": {
            "description": "seq_id (or accession).",
            "type": "integer"
          },
          "state_idx": {
            "description": "0-based state.",
            "type": "integer"
          },
          "vault": {
            "description": "Vault.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "pvault_materialize_msa",
      "description": "Materialize .a3m MSA or ColabFold multimer .tar.gz bundle.",
      "inputSchema": {
        "properties": {
          "col_count": {
            "description": "Col count.",
            "type": "integer"
          },
          "col_start": {
            "description": "0-based col.",
            "type": "integer"
          },
          "fasta_query": {
            "description": "FASTA for bundle.",
            "type": "string"
          },
          "handle_id_or_cluster_id": {
            "description": "Handle, cluster_id, or family.",
            "type": "string"
          },
          "header_format": {
            "description": "Header.",
            "enum": [
              "seq_id",
              "accession"
            ],
            "type": "string"
          },
          "max_sequences": {
            "description": "Max seqs.",
            "type": "integer"
          },
          "mode": {
            "description": "MSA mode.",
            "enum": [
              "all",
              "unpaired",
              "paired"
            ],
            "type": "string"
          },
          "output_path": {
            "description": "Path (.a3m/.tar.gz).",
            "type": "string"
          },
          "pairing_strategy": {
            "description": "Pairing.",
            "enum": [
              "greedy",
              "best",
              "operon"
            ],
            "type": "string"
          },
          "query_seq": {
            "description": "Projected query.",
            "type": "string"
          },
          "sdp_rules": {
            "description": "SDP e.g. '42=C,88=H'.",
            "type": "string"
          },
          "subsampling": {
            "description": "'top_identity'|'hhfilter'|'afcluster'.",
            "type": "string"
          },
          "vault": {
            "description": "Vault/group.",
            "type": "string"
          },
          "where": {
            "description": "WHERE (pct_id/cov to cluster centroid).",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "pvault_evaluate_construct",
      "description": "Audit monomer/multimer constructs, ΔE fitness, batch ranking, & DMS/epistasis.",
      "inputSchema": {
        "properties": {
          "cluster_id": {
            "description": "cluster_id.",
            "type": "integer"
          },
          "construct_seq": {
            "description": "Seq/FASTA.",
            "type": "string"
          },
          "construct_seqs": {
            "description": "<=128 batch seqs.",
            "type": "array"
          },
          "family_name": {
            "description": "Family.",
            "type": "string"
          },
          "fasta_query": {
            "description": "Monomer/multimer FASTA.",
            "type": "string"
          },
          "include_epistasis": {
            "description": "MI_APC couplings.",
            "type": "boolean"
          },
          "include_rescue": {
            "description": "PROSS/SERp rescue.",
            "type": "boolean"
          },
          "intent": {
            "description": "Compartment.",
            "enum": [
              "cytosolic",
              "secreted",
              "membrane"
            ],
            "type": "string"
          },
          "max_active_cols": {
            "description": "Cols (2..=64).",
            "type": "integer"
          },
          "output_path": {
            "description": "Report JSON path.",
            "type": "string"
          },
          "pairing_strategy": {
            "description": "Pairing.",
            "enum": [
              "greedy",
              "best",
              "operon"
            ],
            "type": "string"
          },
          "scan_mutagenesis_span": {
            "description": "1-based {start,end} or [start,end] (<=64).",
            "oneOf": [
              {
                "properties": {
                  "end": {
                    "type": "integer"
                  },
                  "start": {
                    "type": "integer"
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "type": "object"
              },
              {
                "items": {
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              }
            ]
          },
          "top_k": {
            "description": "Top-k (1..=64).",
            "type": "integer"
          },
          "vault": {
            "description": "Vault.",
            "type": "string"
          },
          "where": {
            "description": "WHERE or @h_xxxx.",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  ],
  "source": {
    "type": "registry",
