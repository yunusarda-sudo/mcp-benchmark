{
  "$schema": "../schema.json",
  "name": "com.rexceltech/pvault",
  "title": "RexCelTech pvault — Protein Database & Construct Workbench",
  "category": "Databases & Storage",
  "description": "Read-only protein database, homolog search, 3D geometry, MSA, and construct audit MCP server.",
  "repository": "https://github.com/Rexceltech/pvault",
  "tools": [
    {
      "name": "pvault_vault_overview",
      "description": "Vault counts, entity_kind, default_vault, vaults, groups.",
      "inputSchema": {
        "properties": {
          "include": {
            "description": "'sections','provenance'.",
            "type": "array"
          },
          "vault": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "pvault_lookup_accession",
      "description": "Lookup by accession, stem, prefix, seq_id, seq_hash, or domain_arch.",
      "inputSchema": {
        "properties": {
          "include": {
            "description": "'cluster_delta','biophysics','motifs'.",
            "type": "array"
          },
          "limit": {
            "description": "Max (default 5).",
            "type": "integer"
          },
          "mode": {
            "description": "Mode (default 'exact').",
            "enum": [
              "exact",
              "prefix",
              "stem",
              "seq_id",
              "seq_hash",
              "domain_architecture"
            ],
            "type": "string"
          },
          "output_path": {
            "description": "Export .tsv/.jsonl/.fasta.",
            "type": "string"
          },
          "query": {
            "description": "Accession, stem, prefix, seq_id, or seq.",
            "type": "string"
          },
          "vault": {
            "description": "Vault, 'all', or 'v1,v2'.",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      }
    },
    {
      "name": "pvault_query",
      "description": "Query .pvault/UNION/GROUP BY/.p3d; mints handle.",
      "inputSchema": {
        "properties": {
          "explain": {
            "description": "Plan only (omits rows and handle_id).",
            "type": "boolean"
          },
          "histograms": {
            "description": "Include histograms (default false).",
            "type": "boolean"
          },
          "output_path": {
            "description": "Export .tsv/.jsonl/.fasta (<=5000).",
            "type": "string"
          },
          "query": {
            "description": "FROM <vault|v1 UNION v2|structures> [WHERE] [GROUP BY cluster] [ORDER BY] [LIMIT] [OFFSET] [PRECISION QUANTIZED|EXACT] [SELECT].",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      }
    },
    {
      "name": "pvault_search_homologs",
      "description": "1D/3Di homolog search returning handle & top hits.",
      "inputSchema": {
        "properties": {
          "comp_bias": {
            "description": "Composition-bias correction for 1D homolog alignment ('local_sliding_window' default, or 'none').",
            "enum": [
              "local_sliding_window",
              "none"
            ],
            "type": "string"
          },
          "dedup_by_protein": {
            "description": "Dedup chains (3Di).",
            "type": "boolean"
          },
          "include": {
            "description": "'sequence','description'.",
            "type": "array"
          },
          "limit": {
            "description": "Max (1..=32).",
            "type": "integer"
          },
          "max_e_value": {
            "description": "Max E-value.",
            "type": "number"
          },
          "min_cov": {
            "description": "Min %cov.",
            "type": "integer"
          },
          "min_pct_id": {
            "description": "Min 1D %id.",
            "type": "integer"
          },
          "min_pct_id_3di": {
            "description": "Min 3Di %id.",
            "type": "integer"
          },
          "mode": {
            "enum": [
              "homolog_align",
              "structural_3di"
            ],
            "type": "string"
          },
          "output_path": {
            "description": "Export .tsv/.jsonl/.fasta.",
            "type": "string"
          },
          "query": {
            "description": "1D seq, 3Di acc/seq, or .pdb/.cif.",
            "type": "string"
          },
          "sort": {
            "description": "1D: score|pct_id|cov|members_desc; 3Di: structural_score|tm_score|lddt|bit_score_desc|evalue_asc",
            "type": "string"
          },
          "two_pass": {
            "description": "Enable two-pass adaptive alignment rescoring after fast Syncmer hit ranking (default true).",
            "type": "boolean"
          },
          "vault": {
            "description": "Vault, group, 'all', or 'v1,v2'.",
            "type": "string"
          },
          "where": {
            "description": "Optional SQL-like metadata filter expression or prior @h_xxxx result handle to restrict candidate sequences.",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      }
    },
    {
      "name": "pvault_inspect_cluster",
      "description": "Cluster conservation, Neff, foldability, 3D, subclade & ASR.",
      "inputSchema": {
        "properties": {
          "algorithm": {
            "enum": [
              "nj",
              "upgma"
            ],
            "type": "string"
          },
          "asr_model": {
            "enum": [
              "lg",
              "wag",
              "jukes-cantor"
            ],
            "type": "string"
          },
          "cluster_id": {
            "type": "integer"
          },
          "family_name": {
            "type": "string"
          },
          "max_leaves": {
            "description": "Max leaves (64).",
            "type": "integer"
          },
          "node_id": {
            "description": "Tree node_id.",
            "type": "integer"
          },
          "output_path": {
            "description": "Export .json/.nwk/.fasta.",
            "type": "string"
          },
          "sdp_rules": {
            "description": "Specificity-determining position constraints (1-based centroid col=AA, comma-separated, e.g. '42=C,88=H').",
            "type": "string"
          },
          "slice_subclade": {
            "description": "Tree+ASR+handle.",
            "type": "boolean"
          },
          "vault": {
            "type": "string"
          },
          "where": {
            "description": "Optional SQL-like metadata filter expression or prior @h_xxxx result handle to restrict cluster members.",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "pvault_measure_3d_geometry",
      "description": "3D Ca/Cb dist, lDDT/TM, constellation, PDB.",
      "inputSchema": {
        "properties": {
          "accession": {
            "description": "Accession (or seq_id).",
            "type": "string"
          },
          "constellation": {
            "description": "3D catalytic triad/site pattern in Cβ–Cβ Å (append ':ca' for Cα–Cα, e.g. 'H-D-S:4.5,6.0').",
            "type": "string"
          },
          "export_pdb": {
            "type": "boolean"
          },
          "output_pdb_path": {
            "description": "PDB path.",
            "type": "string"
          },
          "residue_pairs": {
            "description": "<=16 [r1,r2] pairs.",
            "type": "array"
          },
          "seq_id": {
            "description": "seq_id (or accession).",
            "type": "integer"
          },
          "state_idx": {
            "description": "0-based state.",
            "type": "integer"
          },
          "vault": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "pvault_materialize_msa",
      "description": "Materialize .a3m MSA or ColabFold .tar.gz.",
      "inputSchema": {
        "properties": {
          "col_count": {
            "description": "Number of aligned columns to slice from col_start.",
            "type": "integer"
          },
          "col_start": {
            "description": "0-based col.",
            "type": "integer"
          },
          "fasta_query": {
            "description": "Multi-chain FASTA or ':'-separated sequences for ColabFold multimer MSA bundle synthesis.",
            "type": "string"
          },
          "handle_id_or_cluster_id": {
            "description": "Handle, cluster_id, or family.",
            "type": "string"
          },
          "header_format": {
            "enum": [
              "seq_id",
              "accession"
            ],
            "type": "string"
          },
          "max_sequences": {
            "description": "Max seqs.",
            "type": "integer"
          },
          "mode": {
            "enum": [
              "all",
              "unpaired",
              "paired"
            ],
            "type": "string"
          },
          "output_path": {
            "description": "Path (.a3m/.tar.gz).",
            "type": "string"
          },
          "pairing_strategy": {
            "enum": [
              "greedy",
              "best",
              "operon"
            ],
            "type": "string"
          },
          "query_seq": {
            "description": "Projected query.",
            "type": "string"
          },
          "sdp_rules": {
            "description": "Specificity-determining position constraints (1-based centroid col=AA, comma-separated, e.g. '42=C,88=H').",
            "type": "string"
          },
          "subsampling": {
            "description": "'top_identity'|'hhfilter'|'afcluster'.",
            "type": "string"
          },
          "vault": {
            "description": "Vault/group.",
            "type": "string"
          },
          "where": {
            "description": "Optional SQL-like metadata filter expression or prior @h_xxxx result handle (pct_id/cov to cluster centroid).",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "pvault_evaluate_construct",
      "description": "Audit constructs, ΔE, batch, DMS & epistasis.",
      "inputSchema": {
        "properties": {
          "avoid_enzymes": {
            "description": "Restriction enzymes or 4-12bp motifs to avoid.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "cluster_id": {
            "type": "integer"
          },
          "construct_seq": {
            "description": "Single-chain raw amino acid sequence or inline FASTA to audit; omit if supplying fasta_query.",
            "type": "string"
          },
          "construct_seqs": {
            "description": "1..=128 batch seqs.",
            "items": {
              "type": "string"
            },
            "maxItems": 128,
            "minItems": 1,
            "type": "array"
          },
          "detail": {
            "enum": [
              "summary",
              "standard",
              "full"
            ],
            "type": "string"
          },
          "dna_input_mode": {
            "enum": [
              "off",
              "longest_orf",
              "frame1"
            ],
            "type": "string"
          },
          "emit_dna": {
            "description": "Emit codon-optimized DNA, QC & primers.",
            "type": "boolean"
          },
          "family_name": {
            "type": "string"
          },
          "fasta_query": {
            "description": "Single- or multi-chain FASTA (or ':'-delimited raw chains) for monomer/multimer audit; mutually exclusive with construct_seq.",
            "type": "string"
          },
          "host": {
            "enum": [
              "auto",
              "e_coli",
              "mammalian",
              "insect",
              "yeast"
            ],
            "type": "string"
          },
          "include_curves": {
            "description": "Include 17-point pH 5.5-9.5 titration curves (default false unless detail='full').",
            "type": "boolean"
          },
          "include_epistasis": {
            "description": "Opt-in MI_APC co-evolutionary couplings and 3D/MSA fitness scoring (default false for sequence audits; true for cluster-only lookups).",
            "type": "boolean"
          },
          "include_rescue": {
            "description": "PROSS/SERp rescue.",
            "type": "boolean"
          },
          "intent": {
            "enum": [
              "cytosolic",
              "secreted",
              "membrane"
            ],
            "type": "string"
          },
          "max_active_cols": {
            "description": "1D APC-MI active-col cap (2..=64, def 48); deep-MSA Potts expands up to 256 across apc_background_corrected & contact3d_gated (contact3d_gated filters pairs <=12A).",
            "type": "integer"
          },
          "output_path": {
            "description": "Report JSON path.",
            "type": "string"
          },
          "pairing_strategy": {
            "enum": [
              "greedy",
              "best",
              "operon"
            ],
            "type": "string"
          },
          "parent": {
            "description": "Optional wild-type parent (vault/.p3d accession, FASTA, or raw AA sequence; auto-enables include_epistasis unless false).",
            "type": "string"
          },
          "scan_mutagenesis_span": {
            "description": "1-based inclusive window {start,end} or [start,end] (<=64 cols) for in-silico saturation mutagenesis.",
            "oneOf": [
              {
                "properties": {
                  "end": {
                    "type": "integer"
                  },
                  "start": {
                    "type": "integer"
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "type": "object"
              },
              {
                "items": {
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              }
            ]
          },
          "top_k": {
            "description": "Top-k (1..=64).",
            "type": "integer"
          },
          "vault": {
            "type": "string"
          },
          "where": {
            "description": "Optional SQL-like metadata filter expression or prior @h_xxxx result handle to scope homolog/cluster selection.",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
