{
  "$schema": "../schema.json",
  "name": "pro.neozoom/hotel-booking",
  "title": "Neozoom Hotel Booking",
  "category": "Travel, Maps & Navigation",
  "description": "Neozoom hotel search and guest-confirmed API booking with hotel-issued access.",
  "tools": [
    {
      "name": "get_hotel_info",
      "description": "Neozoom location, room types, supported guests, booking workflow and official links. Represents this hotel only.",
      "inputSchema": {
        "properties": {},
        "type": "object",
        "title": "get_hotel_infoArguments"
      }
    },
    {
      "name": "search_rooms",
      "description": "Live Neozoom room tariffs for two adults; optional bathtub/terrace/kitchen and total-stay budget filters.",
      "inputSchema": {
        "properties": {
          "request": {
            "$ref": "#/$defs/RoomSearch"
          }
        },
        "required": [
          "request"
        ],
        "type": "object",
        "$defs": {
          "RoomSearch": {
            "additionalProperties": false,
            "properties": {
              "checkin": {
                "format": "date",
                "title": "Checkin",
                "type": "string"
              },
              "checkout": {
                "format": "date",
                "title": "Checkout",
                "type": "string"
              },
              "adults": {
                "const": 2,
                "default": 2,
                "title": "Adults",
                "type": "integer"
              },
              "features": {
                "items": {
                  "enum": [
                    "bath",
                    "terrace",
                    "kitchen"
                  ],
                  "type": "string"
                },
                "maxItems": 3,
                "title": "Features",
                "type": "array"
              },
              "max_total_rub": {
                "anyOf": [
                  {
                    "maximum": 10000000,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Max Total Rub"
              }
            },
            "required": [
              "checkin",
              "checkout"
            ],
            "title": "RoomSearch",
            "type": "object"
          }
        },
        "title": "search_roomsArguments"
      }
    },
    {
      "name": "get_quote",
      "description": "Fresh selected-room tariff, a 5-minute signed quote, and explicit cancellation/tax limitations. No hold.",
      "inputSchema": {
        "properties": {
          "request": {
            "$ref": "#/$defs/QuoteInput"
          }
        },
        "required": [
          "request"
        ],
        "type": "object",
        "$defs": {
          "QuoteInput": {
            "additionalProperties": false,
            "properties": {
              "stay": {
                "$ref": "#/$defs/RoomSearch"
              },
              "offer_id": {
                "pattern": "^neozoom:[0-9]{1,12}$",
                "title": "Offer Id",
                "type": "string"
              }
            },
            "required": [
              "stay",
              "offer_id"
            ],
            "title": "QuoteInput",
            "type": "object"
          },
          "RoomSearch": {
            "additionalProperties": false,
            "properties": {
              "checkin": {
                "format": "date",
                "title": "Checkin",
                "type": "string"
              },
              "checkout": {
                "format": "date",
                "title": "Checkout",
                "type": "string"
              },
              "adults": {
                "const": 2,
                "default": 2,
                "title": "Adults",
                "type": "integer"
              },
              "features": {
                "items": {
                  "enum": [
                    "bath",
                    "terrace",
                    "kitchen"
                  ],
                  "type": "string"
                },
                "maxItems": 3,
                "title": "Features",
                "type": "array"
              },
              "max_total_rub": {
                "anyOf": [
                  {
                    "maximum": 10000000,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Max Total Rub"
              }
            },
            "required": [
              "checkin",
              "checkout"
            ],
            "title": "RoomSearch",
            "type": "object"
          }
        },
        "title": "get_quoteArguments"
      }
    },
    {
      "name": "create_booking_link",
      "description": "Recheck selected quote and return an attributed Neozoom hosted checkout URL. Creates no booking, cart or payment.",
      "inputSchema": {
        "properties": {
          "request": {
            "$ref": "#/$defs/CheckoutInput"
          }
        },
        "required": [
          "request"
        ],
        "type": "object",
        "$defs": {
          "CheckoutInput": {
            "additionalProperties": false,
            "properties": {
              "quote_token": {
                "maxLength": 4096,
                "minLength": 40,
                "title": "Quote Token",
                "type": "string"
              },
              "agent": {
                "default": "other",
                "enum": [
                  "claude",
                  "codex",
                  "other",
                  "web"
                ],
                "title": "Agent",
                "type": "string"
              }
            },
            "required": [
              "quote_token"
            ],
            "title": "CheckoutInput",
            "type": "object"
          }
        },
        "title": "create_booking_linkArguments"
      }
    },
    {
      "name": "create_booking",
      "description": "Create a REAL Neozoom reservation after guest confirmation/consents. Requires hotel-issued Authorization bearer. Same key on retries; never auto-retry unknown outcome.",
      "inputSchema": {
        "properties": {
          "request": {
            "$ref": "#/$defs/DirectRequest"
          }
        },
        "required": [
          "request"
        ],
        "type": "object",
        "$defs": {
          "DirectRequest": {
            "additionalProperties": false,
            "properties": {
              "quote_token": {
                "maxLength": 4096,
                "minLength": 40,
                "title": "Quote Token",
                "type": "string"
              },
              "guest": {
                "$ref": "#/$defs/Guest"
              },
              "confirmed": {
                "title": "Confirmed",
                "type": "boolean"
              },
              "terms_accepted": {
                "title": "Terms Accepted",
                "type": "boolean"
              },
              "personal_data_consent": {
                "title": "Personal Data Consent",
                "type": "boolean"
              },
              "idempotency_key": {
                "maxLength": 128,
                "minLength": 12,
                "title": "Idempotency Key",
                "type": "string"
              },
              "agent": {
                "default": "other",
                "enum": [
                  "claude",
                  "codex",
                  "other"
                ],
                "title": "Agent",
                "type": "string"
              }
            },
            "required": [
              "quote_token",
              "guest",
              "confirmed",
              "terms_accepted",
              "personal_data_consent",
              "idempotency_key"
            ],
            "title": "DirectRequest",
            "type": "object"
          },
          "Guest": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "maxLength": 100,
                "minLength": 1,
                "title": "Name",
                "type": "string"
              },
              "surname": {
                "maxLength": 100,
                "minLength": 1,
                "title": "Surname",
                "type": "string"
              },
              "phone": {
                "maxLength": 30,
                "minLength": 7,
                "pattern": "^\\+?[0-9 ()-]+$",
                "title": "Phone",
                "type": "string"
              },
              "email": {
                "maxLength": 200,
                "minLength": 5,
                "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
                "title": "Email",
                "type": "string"
              }
            },
            "required": [
              "name",
              "surname",
              "phone",
              "email"
            ],
            "title": "Guest",
            "type": "object"
          }
        },
        "title": "create_bookingArguments"
      }
    },
    {
      "name": "get_booking",
      "description": "Read only this credential's booking and reconcile with the hotel's stored Bnovo result. No payment claim.",
      "inputSchema": {
        "properties": {
          "booking_id": {
            "title": "Booking Id",
            "type": "string"
          }
        },
        "required": [
          "booking_id"
        ],
        "type": "object",
        "title": "get_bookingArguments"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "pro.neozoom/hotel-booking",
    "version": "0.3.0",
    "remoteUrl": "https://neozoom.pro/mcp",
    "publishedAt": "2026-11-28T00:36:05.198406Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "ffef041dc2f9dfdcc295a4792900b39adb62bb19dbac61a349568ecad9af43e4"
  }
}
