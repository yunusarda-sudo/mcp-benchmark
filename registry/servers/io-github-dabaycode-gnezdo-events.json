{
  "$schema": "../schema.json",
  "name": "io.github.dabaycode/gnezdo-events",
  "title": "Gnezdo Events",
  "category": "Developer Tools & DevOps",
  "description": "Find local events and check session times, prices, availability and registration links.",
  "tools": [
    {
      "name": "search_events",
      "description": "Find public events in a city for specific local dates, times, audience and budget. Use the event ID to check details. For every clickable event-page link in your reply, including citations, copy shareUrl verbatim with its query string. Use url only to verify the canonical address or when the visitor explicitly requests the canonical URL. An empty list means no matching sessions.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Public city slug or unambiguous localized name"
          },
          "from": {
            "description": "First local date, inclusive; defaults to today in the city",
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "to": {
            "description": "Last local date, inclusive; default window is seven days, maximum 31",
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "startTimeFrom": {
            "description": "Earliest local start time, inclusive",
            "type": "string",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
          },
          "startTimeBefore": {
            "description": "Latest local start time, exclusive",
            "type": "string",
            "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
          },
          "q": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "category": {
            "description": "Public category slug",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "audience": {
            "type": "string",
            "enum": [
              "kids",
              "pregnancy",
              "beginners",
              "pets"
            ]
          },
          "format": {
            "type": "string",
            "enum": [
              "camp",
              "retreat",
              "festival",
              "tour",
              "excursion",
              "masterclass",
              "talk",
              "meetup",
              "regular"
            ]
          },
          "spokenLanguage": {
            "description": "Language spoken at the meeting",
            "type": "string",
            "enum": [
              "ru",
              "en",
              "ka",
              "be",
              "uk",
              "pl",
              "hy",
              "az",
              "tr",
              "de",
              "fr",
              "es",
              "it",
              "lt",
              "lv",
              "sr",
              "he",
              "kk"
            ]
          },
          "locale": {
            "description": "Language of the response, defaults to ru",
            "type": "string",
            "enum": [
              "ru",
              "en"
            ]
          },
          "maxPrice": {
            "description": "Maximum confirmed price inclusive, requires currency",
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "recurrence": {
            "type": "string",
            "enum": [
              "any",
              "recurring",
              "once"
            ]
          },
          "limit": {
            "description": "Results per page, defaults to five",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "cursor": {
            "description": "Opaque nextCursor from the same search",
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "city"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_event",
      "description": "Look up one public session by its ID or slug. For every clickable event-page link in your reply, including citations, copy shareUrl verbatim with its query string. Use url only to verify the canonical address or when the visitor explicitly requests the canonical URL. Use action for the published registration or organizer contact details.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Event ID, current slug or previous slug"
          },
          "locale": {
            "type": "string",
            "enum": [
              "ru",
              "en"
            ]
          }
        },
        "required": [
          "ref"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.dabaycode/gnezdo-events",
    "version": "1.0.0",
    "remoteUrl": "https://gnezdo.app/api/mcp",
    "publishedAt": "2026-11-24T13:53:55.74127Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "f24179d80d39742bb36144ceba840263b095641aafcc8e0f28d65802a17bb8de"
  }
}
