{
  "$schema": "../schema.json",
  "name": "com.vigilena/japan-companies",
  "title": "Vigilena",
  "category": "Other",
  "description": "Look up Japanese companies from public records: profiles, registry changes, bulk checks, tenders.",
  "tools": [
    {
      "name": "search_companies",
      "description": "社名・法人番号・インボイス登録番号で検索し、閉鎖した法人も印を付けて返す。",
      "inputSchema": {
        "properties": {
          "query": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "limit": {
            "default": 20,
            "maximum": 20,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "type": "object",
        "title": "search_companiesArguments"
      }
    },
    {
      "name": "get_company",
      "description": "法人の基本情報、最近の登記異動・落札・補助金・有報、社会保険の被保険者数と資格の等級を返す。",
      "inputSchema": {
        "properties": {
          "corporate_number": {
            "pattern": "^[0-9]{13}$",
            "title": "Corporate Number",
            "type": "string"
          }
        },
        "required": [
          "corporate_number"
        ],
        "type": "object",
        "title": "get_companyArguments"
      }
    },
    {
      "name": "get_company_changes",
      "description": "法人の社名変更・所在地移転・合併・閉鎖などの登記の異動を新しい順に返す。",
      "inputSchema": {
        "properties": {
          "corporate_number": {
            "pattern": "^[0-9]{13}$",
            "title": "Corporate Number",
            "type": "string"
          },
          "page": {
            "default": 1,
            "maximum": 100,
            "minimum": 1,
            "title": "Page",
            "type": "integer"
          }
        },
        "required": [
          "corporate_number"
        ],
        "type": "object",
        "title": "get_company_changesArguments"
      }
    },
    {
      "name": "check_companies",
      "description": "最大 50 社を照らし、直近 1 年の登記の変化と名寄せの結果を返す。",
      "inputSchema": {
        "properties": {
          "queries": {
            "items": {
              "maxLength": 100,
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Queries",
            "type": "array"
          }
        },
        "required": [
          "queries"
        ],
        "type": "object",
        "title": "check_companiesArguments"
      }
    },
    {
      "name": "find_service_tenders",
      "description": "業種・都道府県コード・等級で締切前の入札公告を探す。等級は A〜D または none。",
      "inputSchema": {
        "properties": {
          "industry": {
            "enum": [
              "web",
              "video",
              "design",
              "promotion",
              "event",
              "training",
              "research",
              "it",
              "translation"
            ],
            "title": "Industry",
            "type": "string"
          },
          "prefecture": {
            "anyOf": [
              {
                "pattern": "^[0-9]{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Prefecture"
          },
          "grade": {
            "anyOf": [
              {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "none"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Grade"
          }
        },
        "required": [
          "industry"
        ],
        "type": "object",
        "title": "find_service_tendersArguments"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.vigilena/japan-companies",
    "version": "0.1.0",
    "remoteUrl": "https://api.vigilena.com/mcp",
    "publishedAt": "2026-11-23T12:14:53.059367Z",
    "fetchedAt": "2026-11-24T12:15:48.059Z",
    "toolsSha256": "d868070e92b6256c8bb5e5a064090d15d87fe14da3f9256b4a3f6889144112f5"
  }
}
