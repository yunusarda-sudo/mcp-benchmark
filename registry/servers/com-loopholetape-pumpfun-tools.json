{
  "$schema": "../schema.json",
  "name": "com.loopholetape/pumpfun-tools",
  "title": "Tools for pump.fun bots",
  "category": "Finance, Crypto & Web3",
  "description": "Check bot wallets, decode failed trades and read live fees and feed counts on pump.fun.",
  "tools": [
    {
      "name": "decode_error",
      "description": "Look up a signature or decode a program error from its log.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string"
          }
        },
        "required": [
          "input"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "wallet_free_day",
      "description": "Read the latest active day or choose a UTC day and follow poll_url while the history is being read.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "wallet": {
            "type": "string",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
          },
          "day": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "wallet"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "fee_check",
      "description": "Read the priority fees and tips for a coin using the ordinary free allowance.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mint": {
            "type": "string",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
          },
          "venue": {
            "type": "string",
            "enum": [
              "pump",
              "pumpswap"
            ]
          }
        },
        "required": [
          "mint",
          "venue"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "fees_active",
      "description": "Find coins by their filled buys in the recent fee window.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "venue": {
            "type": "string",
            "enum": [
              "pump",
              "pumpswap"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "error_status",
      "description": "Read the market status for errors that affect many wallets.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "feed_count",
      "description": "Count recorded transactions for your window and filters before comparing a log.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "start_us": {
            "type": "integer"
          },
          "end_us": {
            "type": "integer"
          },
          "venues": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "pump.fun",
                "PumpSwap"
              ]
            }
          },
          "include_failed": {
            "type": "boolean"
          },
          "signers": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
            }
          },
          "coins": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
            }
          }
        },
        "required": [
          "start_us",
          "end_us",
          "venues",
          "include_failed"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "watch_start",
      "description": "Start the wallet’s free day and save the access key from the reply.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "wallet": {
            "type": "string",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
          },
          "access_key": {
            "type": "string",
            "description": "Supply the watch access key here or send it in the Authorization header as a Bearer token."
          }
        },
        "required": [
          "wallet"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "watch_events",
      "description": "Read events after your saved cursor and set wait to at most 25 seconds to wait for a new record.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "wallet": {
            "type": "string",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
          },
          "access_key": {
            "type": "string",
            "description": "Supply the watch access key here or send it in the Authorization header as a Bearer token."
          },
          "after": {
            "type": "integer",
            "minimum": 0
          },
          "wait": {
            "type": "integer",
            "minimum": 0,
            "maximum": 25
          }
        },
        "required": [
          "wallet"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "how_to_pay",
      "description": "Read the payment guide and its complete example before buying a tool.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.loopholetape/pumpfun-tools",
    "version": "1.0.0",
    "remoteUrl": "https://loopholetape.com/mcp",
    "publishedAt": "2026-11-27T06:30:07.091071Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
