{
  "$schema": "../schema.json",
  "name": "com.57hours/trips",
  "title": "57hours Trips",
  "category": "E-Commerce & Retail",
  "description": "Search guided outdoor adventures on 57hours: open dates, spots left and prices.",
  "tools": [
    {
      "name": "search_trips",
      "description": "Find 57hours guided adventures that can be booked now.\n\nEvery result has at least one open departure matching the filters and comes\nwith its next matching departure and its lowest matching price. Returns\n{trips: [...], totalMatches, nextOffset}. When a keyword query matches no\ntrip on all its words, it is retried on any word and `matchedAllTerms` is\nfalse.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Keywords about the trip itself, e.g. 'volcanoes glacier', 'hut to hut', 'northern lights'. Leave out anything a filter below covers."
          },
          "activity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Activity, e.g. 'Hiking', 'Backcountry Skiing', 'Mountain Biking', 'Sailing'. Matches part of the name. See list_facets."
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Country of the trip, e.g. 'Iceland', 'Italy', 'USA', 'Japan'. See list_facets."
          },
          "date_from": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Earliest start date, YYYY-MM-DD, or a month as YYYY-MM."
          },
          "date_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Latest start date, YYYY-MM-DD, or a month as YYYY-MM (the whole month)."
          },
          "skill_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "beginner, intermediate or advanced. Trips whose listing states no level are kept."
          },
          "min_days": {
            "anyOf": [
              {
                "maximum": 60,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Shortest trip length in days."
          },
          "max_days": {
            "anyOf": [
              {
                "maximum": 60,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Longest trip length in days."
          },
          "max_price": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Budget per person, in max_price_currency."
          },
          "max_price_currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Currency of max_price, e.g. USD, EUR. Defaults to USD."
          },
          "group_size": {
            "anyOf": [
              {
                "maximum": 50,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Number of travelers. Keeps only departures with that many spots."
          },
          "include_early_bird": {
            "default": true,
            "description": "Include early-bird deposits for future seasons.",
            "type": "boolean"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Also show prices converted to this currency (approximate), e.g. EUR, GBP, CAD."
          },
          "sort": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "relevance (default with a query), popular (default otherwise), soonest, price_low."
          },
          "limit": {
            "default": 10,
            "description": "Trips to return.",
            "maximum": 20,
            "minimum": 1,
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "description": "Skip this many trips, for the next page.",
            "maximum": 200,
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "get_trip",
      "description": "One trip in detail: description, highlights, location, length, skill\nlevel, rating, guides and its next open departures with spots and prices.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "trip_id": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "tripId from search_trips."
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "A 57hours.com trip page link, instead of trip_id."
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Also show prices converted to this currency (approximate)."
          },
          "departures_limit": {
            "default": 10,
            "description": "How many upcoming open dates to include.",
            "maximum": 50,
            "minimum": 0,
            "type": "integer"
          },
          "group_size": {
            "anyOf": [
              {
                "maximum": 50,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Number of travelers, preselected in each departure's bookingUrl. Doesn't filter departures."
          }
        },
        "type": "object"
      }
    },
    {
      "name": "list_departures",
      "description": "Every open departure of one trip, soonest first, with spots left, price\nand a bookingUrl that opens checkout for that date and party size. Returns {tripId, name, url, departures: [...],\ntotalMatches, nextOffset}.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "trip_id": {
            "description": "tripId from search_trips or get_trip.",
            "minimum": 1,
            "type": "integer"
          },
          "date_from": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Earliest start date, YYYY-MM-DD or YYYY-MM."
          },
          "date_to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Latest start date, YYYY-MM-DD or YYYY-MM (the whole month)."
          },
          "group_size": {
            "anyOf": [
              {
                "maximum": 50,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Keep only departures with this many spots."
          },
          "include_early_bird": {
            "default": true,
            "description": "Include early-bird deposits.",
            "type": "boolean"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Also show prices converted to this currency (approximate)."
          },
          "limit": {
            "default": 20,
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "maximum": 500,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "trip_id"
        ],
        "type": "object"
      }
    },
    {
      "name": "list_facets",
      "description": "The activities and countries that have bookable trips right now, each\nwith its trip count, plus the currencies prices can be shown in. Use the\nnames as search_trips' activity and country filters.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.57hours/trips",
    "version": "1.0.0",
    "remoteUrl": "https://mcp.57hours.com/trips",
    "publishedAt": "2026-11-25T08:08:10.662721Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "7a5b29087b51fb1f58e1858b3be1b91656b6b3d67b7a71a620afc4f380353ad7"
  }
}
