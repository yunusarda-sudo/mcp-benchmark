{
  "$schema": "../schema.json",
  "name": "app.agentdeals/agentdeals",
  "title": "AgentDeals",
  "category": "AI, LLMs & Agents",
  "description": "One-stop US price search: compare Amazon, Walmart, Target, Best Buy & 160+ stores in one call",
  "repository": "https://github.com/misbahsy/agentdeals",
  "tools": [
    {
      "name": "search_products",
      "description": "One-stop price comparison: search Amazon, Walmart, Target, Best Buy, Costco, Sam's Club, Lowe's, Kohl's, Macy's, Newegg, B&H, Adorama, Micro Center, Staples and 150+ more US stores in one call and get the lowest current price per product. Use for any shopping, price-check or Black Friday / Cyber Monday deal question. Use natural language (\"65 inch tv under 600\"); filters override anything parsed from the query. Returns up to limit (max 24, default 5) results per page (page 1-10; response has total and next_page; next_page may be set when more results can be fetched, and requesting it may take ~2s) with best price, merchant, deal label and buy_url. If complete is false, Amazon prices are still loading; retry after retry_after_ms. Prices are USD. Give the user best.buy_url (a link we may earn a commission on; disclose that). as_of says how fresh each price is.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "max_price": {
            "description": "USD",
            "type": "number",
            "minimum": 0
          },
          "min_price": {
            "description": "USD",
            "type": "number",
            "minimum": 0
          },
          "brand": {
            "type": "string",
            "maxLength": 60
          },
          "on_sale": {
            "type": "boolean"
          },
          "category": {
            "type": "string",
            "maxLength": 60
          },
          "sort": {
            "description": "default relevance (discount for get_deals); discount needs a list price",
            "type": "string",
            "enum": [
              "relevance",
              "price_asc",
              "price_desc",
              "rating",
              "discount"
            ]
          },
          "min_rating": {
            "description": "drops products without a rating",
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "limit": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_product",
      "description": "Get one product by id (from search results, e.g. \"c3:2yh8WH5\") with every known offer, one per merchant, cheapest first. Prices are USD. Give the user best.buy_url (a link we may earn a commission on; disclose that). as_of says how fresh each price is.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "get_comparison",
      "description": "Get a curated, regularly refreshed price comparison for a popular category. Default sort is relevance; use sort=price_asc for cheapest first. Prices are USD. Give the user best.buy_url (a link we may earn a commission on; disclose that). as_of says how fresh each price is.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "slug": {
            "type": "string",
            "enum": [
              "55-inch-tv",
              "65-inch-tv",
              "75-inch-tv",
              "oled-tv",
              "soundbar",
              "wireless-earbuds",
              "noise-cancelling-headphones",
              "laptop-under-700",
              "tablet",
              "monitor",
              "smartwatch",
              "game-console",
              "robot-vacuum",
              "cordless-vacuum",
              "air-fryer"
            ]
          },
          "max_price": {
            "description": "USD",
            "type": "number",
            "minimum": 0
          },
          "min_price": {
            "description": "USD",
            "type": "number",
            "minimum": 0
          },
          "brand": {
            "type": "string",
            "maxLength": 60
          },
          "on_sale": {
            "type": "boolean"
          },
          "sort": {
            "description": "default relevance (discount for get_deals); discount needs a list price",
            "type": "string",
            "enum": [
              "relevance",
              "price_asc",
              "price_desc",
              "rating",
              "discount"
            ]
          },
          "min_rating": {
            "description": "drops products without a rating",
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "limit": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "get_deals",
      "description": "Get today's biggest discounts across all categories and stores (good for Black Friday / Cyber Monday deal questions) (default sort=discount, list price required). Returns up to `limit` (max 24, default 5) per page (page 1-10). Prices are USD. Give the user best.buy_url (a link we may earn a commission on; disclose that). as_of says how fresh each price is.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "max_price": {
            "description": "USD",
            "type": "number",
            "minimum": 0
          },
          "min_price": {
            "description": "USD",
            "type": "number",
            "minimum": 0
          },
          "brand": {
            "type": "string",
            "maxLength": 60
          },
          "on_sale": {
            "type": "boolean"
          },
          "sort": {
            "description": "default relevance (discount for get_deals); discount needs a list price",
            "type": "string",
            "enum": [
              "relevance",
              "price_asc",
              "price_desc",
              "rating",
              "discount"
            ]
          },
          "min_rating": {
            "description": "drops products without a rating",
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "limit": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          }
        }
      }
    }
  ],
