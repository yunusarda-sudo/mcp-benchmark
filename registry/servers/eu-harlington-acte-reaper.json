{
  "$schema": "../schema.json",
  "name": "eu.harlington.acte/reaper",
  "title": "Reaper — Corporate Registry, KYB/UBO & Statutory Formalities",
  "category": "Travel, Maps & Navigation",
  "description": "Deterministic KYB/UBO extracts, statutory deed preflight, INPI/RNE filing sagas & eIDAS seals.",
  "repository": "https://github.com/antica-labs/reaper-mcp",
  "tools": [
    {
      "name": "certify_corporate_kyb_and_ubo_extract",
      "description": "Certifies SIREN/RCS/RBE/LEI corporate standing, share capital EUR, and UBO stakes in p95 145 ms (0,24 EUR, 99.8% accuracy, -15% URN continuity).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "siren_identifier": {
            "type": "string",
            "pattern": "^\\d{9}$",
            "default": "752039685"
          },
          "jurisdiction_code": {
            "type": "string",
            "minLength": 2,
            "default": "FR"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "execute_full_corporate_and_fiduciary_clearance",
      "description": "Executes atomic Tri-SaaS KYB/UBO, Korpus Akoma Ntoso statute, and ORION net-wealth clearance in p95 390 ms (0,48 EUR vs 0,57 EUR standalone, -15%, ~1,430 tokens saved).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "siren_identifier": {
            "type": "string",
            "pattern": "^\\d{9}$",
            "default": "752039685"
          },
          "citation_reference_text": {
            "type": "string",
            "minLength": 3,
            "default": "Code civil Art. 2011"
          },
          "jurisdiction_code": {
            "type": "string",
            "minLength": 2,
            "default": "FR"
          },
          "portfolio_scope_id": {
            "type": "string",
            "minLength": 2,
            "default": "pf_752039685"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "validate_statutory_deed_formalities",
      "description": "Pre-validates INPI Guichet Unique, Greffe RCS, and JAL statutory deed formalities in p95 95 ms at 0,00 EUR zero-charge with 15-minute quote_token.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "corporate_form_code": {
            "type": "string",
            "minLength": 2,
            "default": "SAS"
          },
          "share_capital_eur": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 150000
          },
          "formality_kind_code": {
            "type": "string",
            "minLength": 2,
            "default": "INCORPORATION_AND_RBE"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "orchestrate_registry_filing_saga",
      "description": "Orchestrates stateful multi-week INPI, Greffe, RBE, and JAL corporate filing sagas under RLS in p95 170 ms (0,65 EUR, 99.9% idempotent, ~620 tokens saved).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "filing_saga_id": {
            "type": "string",
            "pattern": "^sga_[a-zA-Z0-9_-]{8,64}$"
          },
          "siren_identifier": {
            "type": "string",
            "pattern": "^\\d{9}$",
            "default": "752039685"
          },
          "formality_kind_code": {
            "type": "string",
            "minLength": 2,
            "default": "STATUTORY_CAPITAL_INCREASE"
          },
          "step_index_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20,
            "default": 0
          },
          "step_milestone_code": {
            "type": "string",
            "minLength": 2,
            "default": "JAL_PUBLICATION_SUBMITTED"
          },
          "mark_completed_flag": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "seal_corporate_resolution_eidas",
      "description": "Seals corporate minutes and share-movement ledgers with eIDAS SHA-256 integrity under tenant RLS in p95 140 ms (0,45 EUR, RFC 3161 opposable).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "siren_identifier": {
            "type": "string",
            "pattern": "^\\d{9}$",
            "default": "752039685"
          },
          "resolution_title_text": {
            "type": "string",
            "minLength": 3,
            "default": "Assemblée Générale Extraordinaire"
          },
          "share_movement_amount_eur": {
            "type": "number",
            "minimum": 0,
            "default": 50000
          },
          "matter_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "stage_avocat_deed_countersignature",
      "description": "Stages an L22 B2A2H Acte d'Avocat human countersignature docket in p95 185 ms at 0,00 EUR zero-charge autonomous capture (KZ-076 opposable).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "deed_summary_text": {
            "type": "string",
            "minLength": 3,
            "default": "Acte d'Avocat — Cession d'actions SAS"
          },
          "signatory_parties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": [
              "Cédant",
              "Cessionnaire"
            ]
          },
          "preferred_slot_iso": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "subscribe_corporate_bodacc_drift",
      "description": "Registers an SSRF-safe L24 BODACC, RNE, and insolvency modification webhook (1,50 EUR/mo) in p95 110 ms (99.9% recall, opposable Ed25519 JWS).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "siren_identifier": {
            "type": "string",
            "pattern": "^\\d{9}$",
            "default": "752039685"
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          },
          "hmac_secret_ref": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          }
        },
        "required": [
          "webhook_url"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "search",
      "description": "Searches certified French SIREN, RCS, RBE, and statutory formality records in p95 80 ms at 0,00 EUR zero-charge.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "fetch",
      "description": "Fetches a single corporate KYB/RCS record by ID or SIREN in p95 75 ms (0,05 EUR, 0,00 EUR on miss or reviewer).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
