{
  "$schema": "../schema.json",
  "name": "io.github.ShuanggeAI/memeo",
  "title": "Memeo",
  "category": "AI, LLMs & Agents",
  "description": "Discover viral AI video templates, photo requirements, reference prompts, and credit costs.",
  "tools": [
    {
      "name": "list_meme_templates",
      "description": "Search the public catalog for photo roles, duration, format, credit options and previews.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "gaming",
              "holidays",
              "comedy",
              "dance",
              "music",
              "pets"
            ]
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_template_details",
      "description": "Read the photo checklist, steps, captions and credit quote for a template.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_viral_prompt",
      "description": "Find a published reference prompt by exact slug or topic and open its creator.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "slug"
            ]
          },
          {
            "required": [
              "topic"
            ]
          }
        ]
      }
    },
    {
      "name": "list_collections",
      "description": "Discover the GTA 6 and Santa Cam collections, template directory and pricing guide.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_account_credits",
      "description": "Read the credit balance for the owner of a Memeo user API key.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ],
