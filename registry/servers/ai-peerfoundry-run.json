{
  "$schema": "../schema.json",
  "name": "ai.peerfoundry/run",
  "title": "PeerFoundry Run",
  "category": "AI, LLMs & Agents",
  "description": "Beta code sandbox for agents. Run Python or JavaScript with no network and a 30 s timeout.",
  "tools": [
    {
      "name": "run_code",
      "description": "Run python or javascript with no outbound network. Returns stdout, stderr, exit_code, status, duration_ms, and run_id. Call keys.create once. Pass caller_key from keys.create on every later tools/call. Authorization: Bearer pf_... or the header X-Caller-Key also works. A header key is used when one is present.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "python",
              "javascript"
            ]
          },
          "code": {
            "type": "string"
          },
          "stdin": {
            "type": "string"
          },
          "timeout_s": {
            "type": "integer",
            "const": 30
          },
          "files": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "content"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "encoding": {
                  "type": "string",
                  "enum": [
                    "utf8",
                    "base64"
                  ]
                }
              }
            }
          },
          "caller_key": {
            "type": "string"
          }
        },
        "required": [
          "language",
          "code"
        ]
      }
    },
    {
      "name": "keys.create",
      "description": "Mint one pf_ key. The raw key is shown once.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    {
      "name": "keys_create",
      "description": "Mint one pf_ key. The raw key is shown once.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
