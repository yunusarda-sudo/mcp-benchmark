{
  "$schema": "../schema.json",
  "name": "es.aldmobility/car-rental",
  "title": "ALD Mobility",
  "category": "E-Commerce & Retail",
  "description": "Car rental in Madrid and Costa del Sol, Spain: locations, terms, fleet and price quotes.",
  "tools": [
    {
      "name": "listar_puntos",
      "description": "Puntos de recogida de ALD Mobility con su horario, zona, suplemento y si admiten entrega en hotel.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "consultar_condiciones",
      "description": "Fianza, seguro, kilometraje, combustible, requisitos del conductor, antelación mínima, días mínimos y máximos, pago, cancelación y extras con su precio.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "buscar_vehiculos",
      "description": "Flota con precio base por día (IVA incluido), del más barato al más caro, con fotos, categoría, carrocería, equipamiento y descripción. Filtros opcionales por punto, categoría, combustible, cambio y plazas mínimas.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "punto": {
            "description": "Punto de recogida (id de /api/v1/puntos).",
            "type": "string",
            "enum": [
              "madrid-centro",
              "madrid-barajas",
              "madrid-atocha",
              "madrid-chamartin",
              "malaga-aeropuerto",
              "marbella"
            ]
          },
          "categoria": {
            "description": "Categoría: economico, compacto, suv, premium, deportivo o furgoneta.",
            "type": "string",
            "enum": [
              "economico",
              "compacto",
              "suv",
              "premium",
              "deportivo",
              "furgoneta"
            ]
          },
          "combustible": {
            "type": "string",
            "enum": [
              "gasolina",
              "diesel",
              "hibrido",
              "hibrido-enchufable",
              "electrico"
            ]
          },
          "cambio": {
            "type": "string",
            "enum": [
              "manual",
              "automatico"
            ]
          },
          "plazas": {
            "description": "Plazas mínimas.",
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          }
        }
      }
    },
    {
      "name": "calcular_presupuesto",
      "description": "Precio exacto de un alquiler (mismo cálculo que la web) para un vehículo, un punto y unas fechas en hora de Madrid, con extras opcionales (ids de consultar_condiciones, formato id:cantidad), desglose, total con IVA y bookingUrl para que el usuario revise y envíe la reserva en la web con esos extras ya marcados.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "vehiculo": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,60}$",
            "description": "Id del vehículo (de /api/v1/vehiculos)."
          },
          "punto": {
            "type": "string",
            "enum": [
              "madrid-centro",
              "madrid-barajas",
              "madrid-atocha",
              "madrid-chamartin",
              "malaga-aeropuerto",
              "marbella"
            ],
            "description": "Punto de recogida."
          },
          "punto_devolucion": {
            "description": "Punto de devolución (por defecto, el de recogida).",
            "type": "string",
            "enum": [
              "madrid-centro",
              "madrid-barajas",
              "madrid-atocha",
              "madrid-chamartin",
              "malaga-aeropuerto",
              "marbella"
            ]
          },
          "fecha_recogida": {
            "type": "string",
            "description": "AAAA-MM-DD, hora de Madrid."
          },
          "hora_recogida": {
            "type": "string",
            "description": "HH:MM, hora de Madrid."
          },
          "fecha_devolucion": {
            "type": "string"
          },
          "hora_devolucion": {
            "type": "string"
          },
          "edad": {
            "default": "30+",
            "description": "Franja de edad del conductor: 21-24, 25-29 o 30+.",
            "type": "string",
            "enum": [
              "21-24",
              "25-29",
              "30+"
            ]
          },
          "extras": {
            "description": "Extras opcionales (ids de las condiciones), con formato id:cantidad separados por comas.",
            "type": "string",
            "pattern": "^[a-z0-9-]{1,40}:\\d{1,2}(,[a-z0-9-]{1,40}:\\d{1,2}){0,9}$"
          }
        },
        "required": [
          "vehiculo",
          "punto",
          "fecha_recogida",
          "hora_recogida",
          "fecha_devolucion",
          "hora_devolucion"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "es.aldmobility/car-rental",
    "version": "1.0.0",
    "remoteUrl": "https://aldmobility.es/mcp",
    "publishedAt": "2026-11-19T22:24:13.343394Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "2e9f28b707493761efbf04717aedb477e68c8542108205667876c013e05d6390"
  }
}
