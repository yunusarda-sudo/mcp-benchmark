{
  "$schema": "../schema.json",
  "name": "eu.harlington.edu/formations",
  "title": "Harlington Formations — Accredited Legal, Tax & AI Executive Education",
  "category": "AI, LLMs & Agents",
  "description": "233 executive courses & 14 packs: Bar CLE quota validation, enrollment sagas & SHA-256 credentials.",
  "repository": "https://github.com/antica-labs/formations-mcp",
  "tools": [
    {
      "name": "recommend_accredited_curriculum_pathway",
      "description": "Matches practitioner roles against 233 executive courses & 14 specialization packs with accredited hours and EUR pricing in p95 110 ms (0,12 EUR, 99.6% precision).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "practitioner_role_code": {
            "type": "string",
            "minLength": 2,
            "default": "AVOCAT_BARREAU"
          },
          "regulatory_topic_code": {
            "type": "string",
            "minLength": 2,
            "default": "EU_AI_ACT_AND_DPO"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "validate_continuing_education_hours",
      "description": "Validates annual Barreau Law 71-1130 (20h/yr, 40h/2y) / CNB / AMF / CNIL continuing-education quotas in p95 85 ms at 0,00 EUR zero-charge with 15-minute quote_token.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "regulated_body_code": {
            "type": "string",
            "minLength": 2,
            "default": "CNB_BARREAU_LOI_71_1130"
          },
          "completed_annual_hours": {
            "type": "number",
            "minimum": 0,
            "default": 14
          },
          "completed_deontology_hours": {
            "type": "number",
            "minimum": 0,
            "default": 2
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "certify_executive_credential_seal",
      "description": "Verifies SHA-256 cryptographic completion seals on Harlington executive credentials in p95 70 ms (0,08 EUR, 100% deterministic).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "certificate_sha256_hex": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$",
            "default": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
          },
          "credential_reference_code": {
            "type": "string",
            "minLength": 2,
            "default": "CERT-HRL-2026-001"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "benchmark_cohort_competency_readiness",
      "description": "Benchmarks tenant-isolated law-firm or enterprise training completion and regulatory audit scores in p95 130 ms (0,22 EUR, 99.9% RLS isolation).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cohort_year_count": {
            "type": "integer",
            "minimum": 2024,
            "maximum": 2035,
            "default": 2026
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "orchestrate_enterprise_enrollment_saga",
      "description": "Orchestrates stateful OPCO, FIF-PL, and firm training convention sagas under RLS in p95 160 ms (0,35 EUR, 99.9% idempotent, ~540 tokens saved).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "enrollment_saga_id": {
            "type": "string",
            "pattern": "^sga_[a-zA-Z0-9_-]{8,64}$"
          },
          "funding_body_code": {
            "type": "string",
            "minLength": 2,
            "default": "FIF_PL_AVOCATS"
          },
          "cohort_learners_count": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "default": 10
          },
          "step_index_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20,
            "default": 0
          },
          "step_milestone_code": {
            "type": "string",
            "minLength": 2,
            "default": "CONVENTION_STAGED"
          },
          "mark_completed_flag": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "stage_pedagogical_convention_escalation",
      "description": "Stages an L22 B2A2H bespoke Barreau, FIF-PL, or OPCO executive convention review slot in p95 180 ms at 0,00 EUR zero-charge autonomous capture (KZ-076 opposable).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "convention_summary_text": {
            "type": "string",
            "minLength": 3,
            "default": "Convention sur-mesure FIF-PL / OPCO formation continue Barreau"
          },
          "organization_entities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": [
              "Cabinet d'Avocats",
              "FIF-PL"
            ]
          },
          "preferred_slot_iso": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "subscribe_syllabus_regulatory_drift",
      "description": "Registers an SSRF-safe L24 legislative reform and syllabus update webhook (0,90 EUR/mo) in p95 105 ms (99.9% recall, opposable Ed25519 JWS).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "syllabus_domain_code": {
            "type": "string",
            "minLength": 2,
            "default": "BARREAU_DEONTOLOGIE_ET_IA"
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          },
          "hmac_secret_ref": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          }
        },
        "required": [
          "webhook_url"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "search",
      "description": "Searches Harlington's 233 executive courses, 14 specialization packs, and Cahiers briefs in p95 75 ms at 0,00 EUR zero-charge.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "fetch",
      "description": "Fetches a single specialization pack or course syllabus by ID in p95 70 ms (0,05 EUR, 0,00 EUR on miss or reviewer).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
