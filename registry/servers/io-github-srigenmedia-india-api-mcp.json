{
  "$schema": "../schema.json",
  "name": "io.github.srigenmedia/india-api-mcp",
  "title": "India Public APIs MCP",
  "category": "Developer Tools & DevOps",
  "description": "246 Indian public APIs catalog plus live PIN code, IFSC, DIGIPIN and data.gov.in mandi prices.",
  "repository": "https://github.com/srigenmedia/india-api-mcp",
  "tools": [
    {
      "name": "search_apis",
      "description": "Search the catalog of 246 Indian public APIs by keyword, domain, access tier or auth method.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "access_tier": {
            "type": "string"
          },
          "auth_method": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        }
      }
    },
    {
      "name": "get_api",
      "description": "Get full metadata for one API by its ID (e.g. IN-API-0001).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "api_id": {
            "type": "string"
          }
        },
        "required": [
          "api_id"
        ]
      }
    },
    {
      "name": "list_taxonomy",
      "description": "Domain -> sub-domain -> API count taxonomy.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "pincode_lookup",
      "description": "Look up post offices, district and state for an Indian 6-digit PIN code (India Post data).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pincode": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "pincode"
        ]
      }
    },
    {
      "name": "ifsc_lookup",
      "description": "Resolve an Indian bank IFSC code to bank, branch, address and supported rails.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ifsc": {
            "type": "string",
            "minLength": 11,
            "maxLength": 11
          }
        },
        "required": [
          "ifsc"
        ]
      }
    },
    {
      "name": "digipin_encode",
      "description": "Encode latitude/longitude into India Post's 10-character DIGIPIN (computed locally).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon"
        ]
      }
    },
    {
      "name": "digipin_decode",
      "description": "Decode a DIGIPIN back to the centre latitude/longitude of its ~4m grid cell.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "digipin": {
            "type": "string"
          }
        },
        "required": [
          "digipin"
        ]
      }
    },
    {
      "name": "ogd_dataset_query",
      "description": "Query any data.gov.in OGD resource by resource_id (cached 6h, 500 uncached calls/day cap).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "resource_id": {
            "type": "string"
          },
          "filters": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 10
          }
        },
        "required": [
          "resource_id"
        ]
      }
    },
    {
      "name": "mandi_prices",
      "description": "Current daily mandi (Agmarknet) commodity prices via data.gov.in.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          },
          "commodity": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.srigenmedia/india-api-mcp",
    "version": "0.2.0",
    "remoteUrl": "https://india-api.srigenmedia.com/mcp",
    "publishedAt": "2026-11-25T07:07:28.651248Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "dd4424e33ad46137ec60ed2a5f8f82480109e377f65ca40988812e1d9f190474"
  }
}
