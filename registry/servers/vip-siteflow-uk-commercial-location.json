{
  "$schema": "../schema.json",
  "name": "vip.siteflow/uk-commercial-location",
  "title": "SiteFlow UK",
  "category": "Travel, Maps & Navigation",
  "description": "24h presence, 0-100 commercial site scoring & EPC/MEES checks across 359 Great Britain councils.",
  "repository": "https://github.com/TonyZPW/siteflow-mcp-examples",
  "tools": [
    {
      "name": "list_cities",
      "description": "List published Great Britain local authorities (359 areas across England, Wales and Scotland) with release IDs and capabilities.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "enum": [
              "England",
              "Wales",
              "Scotland"
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        }
      }
    },
    {
      "name": "search_locations",
      "description": "Search UK postcodes, rail/metro stations, streets or places to obtain coordinates and city_id.",
      "inputSchema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "description": "UK postcode (e.g. W1F 8TH, LS1 6NP), station or street name"
          },
          "city_id": {
            "type": "string",
            "description": "Optional area id hint (defaults to leeds)"
          }
        }
      }
    },
    {
      "name": "analyze_place",
      "description": "Estimate people simultaneously present within 250 m, 500 m or 1 km of a Great Britain coordinate across 24 hours (typical weekday, weekend and bank holiday).",
      "inputSchema": {
        "type": "object",
        "required": [
          "point"
        ],
        "properties": {
          "city_id": {
            "type": "string"
          },
          "point": {
            "type": "object",
            "required": [
              "lat",
              "lon"
            ],
            "properties": {
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              }
            }
          },
          "day_type": {
            "type": "string",
            "enum": [
              "weekday",
              "weekend",
              "holiday"
            ],
            "default": "weekday"
          },
          "date": {
            "type": "string",
            "description": "Optional YYYY-MM-DD date"
          },
          "radius_m": {
            "type": "integer",
            "enum": [
              250,
              500,
              1000
            ],
            "default": 500
          }
        }
      }
    },
    {
      "name": "score_site",
      "description": "Full commercial site suitability score (0-100) & Pre-Lease Due Diligence Audit for a UK retail or hospitality trade: 7-day demand, timing, competitor headroom, transit access, street-level micro-location pitch, 2026 VOA Business Rates (Rateable Value, Zone A GBP/m2, Small Business Rate Relief), Footfall-per-GBP Value Index, IMD affluence, Non-Domestic EPC/MEES, DfT road traffic, GIAS schools, flood zones and heritage planning flags.",
      "inputSchema": {
        "type": "object",
        "required": [
          "business_type",
          "point"
        ],
        "properties": {
          "city_id": {
            "type": "string"
          },
          "business_type": {
            "type": "string",
            "enum": [
              "cafe",
              "convenience",
              "restaurant",
              "takeaway",
              "bar"
            ]
          },
          "point": {
            "type": "object",
            "required": [
              "lat",
              "lon"
            ],
            "properties": {
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              }
            }
          },
          "radius_m": {
            "type": "integer",
            "enum": [
              250,
              500,
              1000
            ],
            "default": 500
          }
        }
      }
    },
    {
      "name": "rank_sites",
      "description": "Shortlist top-ranked 1 km areas inside one UK council or borough for a business type.",
      "inputSchema": {
        "type": "object",
        "required": [
          "city_id",
          "business_type"
        ],
        "properties": {
          "city_id": {
            "type": "string"
          },
          "business_type": {
            "type": "string",
            "enum": [
              "cafe",
              "convenience",
              "restaurant",
              "takeaway",
              "bar"
            ]
          },
          "top": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10
          },
          "radius_m": {
            "type": "integer",
            "enum": [
              250,
              500,
              1000
            ],
            "default": 500
          }
        }
      }
    },
    {
      "name": "compare_places",
      "description": "Compare 2 to 5 Great Britain locations side by side using consistent release data.",
      "inputSchema": {
        "type": "object",
        "required": [
          "places"
        ],
        "properties": {
          "city_id": {
            "type": "string"
          },
          "day_type": {
            "type": "string",
            "enum": [
              "weekday",
              "weekend",
              "holiday"
            ],
            "default": "weekday"
          },
          "date": {
            "type": "string"
          },
          "radius_m": {
            "type": "integer",
            "enum": [
              250,
              500,
              1000
            ],
            "default": 500
          },
          "places": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": [
                "lat",
                "lon"
              ],
              "properties": {
                "lat": {
                  "type": "number"
                },
                "lon": {
                  "type": "number"
                },
                "label": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "get_place_context",
      "description": "Inspect nearby commercial context, 2026 VOA Business Rates (Rateable Value, Zone A GBP/m2, Small Business Rate Relief), competitors, flood/heritage constraints, EPC/MEES, affluence and road traffic for a UK coordinate.",
      "inputSchema": {
        "type": "object",
        "required": [
          "point"
        ],
        "properties": {
          "city_id": {
            "type": "string"
          },
          "point": {
            "type": "object",
            "required": [
              "lat",
              "lon"
            ],
            "properties": {
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              }
            }
          },
          "radius_m": {
            "type": "integer",
            "enum": [
              250,
              500,
              1000
            ],
            "default": 500
          }
        }
      }
    },
    {
      "name": "create_report",
      "description": "Generate an exportable Markdown or CSV commercial brief for a UK location and return a temporary download URL.",
      "inputSchema": {
        "type": "object",
        "required": [
          "point"
        ],
        "properties": {
          "city_id": {
            "type": "string"
          },
          "point": {
            "type": "object",
            "required": [
              "lat",
              "lon"
            ],
            "properties": {
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              }
            }
          },
          "label": {
            "type": "string"
          },
          "day_type": {
            "type": "string",
            "enum": [
              "weekday",
              "weekend",
              "holiday"
            ],
            "default": "weekday"
          },
          "date": {
            "type": "string"
          },
          "radius_m": {
            "type": "integer",
            "enum": [
              250,
              500,
              1000
            ],
            "default": 500
          },
          "format": {
            "type": "string",
            "enum": [
              "markdown",
              "csv"
            ],
            "default": "markdown"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "vip.siteflow/uk-commercial-location",
    "version": "1.0.1",
    "remoteUrl": "https://siteflow.vip/mcp",
    "publishedAt": "2026-11-25T16:11:34.402334Z",
