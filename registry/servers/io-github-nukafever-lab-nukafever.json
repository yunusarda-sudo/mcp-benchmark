{
  "$schema": "../schema.json",
  "name": "io.github.nukafever-lab/nukafever",
  "title": "Nukafever Photography",
  "category": "AI, LLMs & Agents",
  "description": "Search and license documentary photos. AI agents pay on their own with a prepaid wallet key.",
  "tools": [
    {
      "name": "search_photos",
      "description": "Search editorial photos (real places, real dates). Exact matches first, then close matches, each result marked 'exact' or 'close'. Filters can be written in the query: 'street, Japan, night, vertical, no people'.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "maximum": 100
          },
          "offset": {
            "type": "integer"
          },
          "include_close": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "get_photo",
      "description": "One photo with its price and licence terms.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "photo_id": {
            "type": "string"
          }
        },
        "required": [
          "photo_id"
        ]
      }
    },
    {
      "name": "get_quote",
      "description": "Fixed-price quote for one or more photos (same prices and 5-photo discount as the website).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "photo_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "description": "Photo ids like NKF-ABCD1234"
          },
          "licence": {
            "type": "string",
            "enum": [
              "editorial",
              "commercial"
            ]
          }
        },
        "required": [
          "photo_ids"
        ]
      }
    },
    {
      "name": "create_order",
      "description": "Order one or more photos in one request. The person or organisation that pays must accept the licence terms and the immediate-delivery waiver. With a wallet_key (or an 'Authorization: Bearer nkfw_...' header), the order is paid at once from the agent wallet and the answer holds the download links, licences and invoice. Without one, it returns a card payment link for a person, and an order_token.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "quote": {
            "type": "string"
          },
          "photo_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "description": "Photo ids like NKF-ABCD1234"
          },
          "accept_terms": {
            "type": "boolean"
          },
          "immediate_delivery_waiver": {
            "type": "boolean"
          },
          "licensee": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          },
          "wallet_key": {
            "type": "string",
            "description": "Agent wallet key nkfw_... (secret)"
          }
        },
        "required": [
          "accept_terms",
          "immediate_delivery_waiver"
        ]
      }
    },
    {
      "name": "get_order_status",
      "description": "Order status: pending, paid, refunded or cancelled.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string"
          },
          "order_token": {
            "type": "string"
          }
        },
        "required": [
          "order_id",
          "order_token"
        ]
      }
    },
    {
      "name": "get_license",
      "description": "Licences of a paid order.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string"
          },
          "order_token": {
            "type": "string"
          }
        },
        "required": [
          "order_id",
          "order_token"
        ]
      }
    },
    {
      "name": "get_download_links",
      "description": "Signed links to the original files of a paid order (valid a few minutes).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string"
          },
          "order_token": {
            "type": "string"
          }
        },
        "required": [
          "order_id",
          "order_token"
        ]
      }
    },
    {
      "name": "create_wallet",
      "description": "Open a prepaid agent wallet (EUR 10 to 500). A person pays the returned payment_url once by card; then the returned wallet_key lets the agent pay orders on its own (daily limit EUR 50 by default). The owner accepts the licence terms for orders placed with the key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "minimum": 10,
            "maximum": 500
          },
          "licensee": {
            "type": "string"
          },
          "accept_terms": {
            "type": "boolean"
          }
        },
        "required": [
          "amount",
          "accept_terms"
        ]
      }
    },
    {
      "name": "get_wallet",
      "description": "Agent wallet balance, daily limit and today's spending.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "wallet_key": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "top_up_wallet",
      "description": "Card payment link (for a person) to add EUR 10 to 500 to the agent wallet.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "wallet_key": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        },
        "required": [
          "amount"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.nukafever-lab/nukafever",
    "version": "2.1.0",
    "remoteUrl": "https://nukafever.com/mcp",
    "publishedAt": "2026-11-19T15:54:37.641037Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "ec559d7a220fa51ee893490fcc741297f5b33f616690b170ff33c37307fdf548"
  }
}
