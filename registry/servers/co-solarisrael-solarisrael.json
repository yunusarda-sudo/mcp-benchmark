{
  "$schema": "../schema.json",
  "name": "co.solarisrael/solarisrael",
  "title": "Solar Israel (סולאר ישראל)",
  "category": "Design, UI & 3D Media",
  "description": "Read-only solar guides, calculator, facts, and installer directory for Israel.",
  "tools": [
    {
      "name": "search_guides",
      "description": "Search visible Hebrew solar guides. חיפוש מדריכים סולאריים גלויים. Returns titles, summaries, dates, and source URLs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "description": "Hebrew or English words. Minimum 2 characters."
          },
          "category": {
            "type": "string",
            "maxLength": 80,
            "description": "Optional exact article category."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Max 20. Default 8."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_guide",
      "description": "Read one visible guide, including Markdown. קריאת מדריך גלוי אחד, כולל Markdown. A hidden guide returns not found.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Guide slug. Hebrew slugs are accepted."
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "estimate_system",
      "description": "Estimate a solar system with the site calculator formulas. הערכת מערכת לפי נוסחאות המחשבון באתר. The electricity rate is a site assumption, not the official tariff.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "roof_sqm": {
            "type": "number",
            "minimum": 8,
            "maximum": 5000,
            "description": "Roof area in square meters."
          },
          "monthly_kwh": {
            "type": "number",
            "minimum": 1,
            "maximum": 200000,
            "description": "Monthly use in kWh. One of kWh or bill is required."
          },
          "monthly_bill_ils": {
            "type": "number",
            "minimum": 1,
            "maximum": 200000,
            "description": "Monthly bill in ILS. One of kWh or bill is required."
          },
          "direction": {
            "type": "string",
            "enum": [
              "south",
              "southeast",
              "southwest",
              "east",
              "west",
              "east-west",
              "northeast",
              "northwest",
              "north",
              "flat"
            ],
            "description": "Roof direction. Default south."
          },
          "residential": {
            "type": "boolean",
            "description": "Default true."
          },
          "city": {
            "type": "string",
            "maxLength": 40,
            "description": "Hebrew city name. Optional."
          }
        },
        "required": [
          "roof_sqm"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "list_companies",
      "description": "List visible solar companies. רשימת חברות סולאריות גלויות. Returns the public name, city, phone, rating, and company page URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "maxLength": 80,
            "description": "Hebrew city name, for example עפולה."
          },
          "region": {
            "type": "string",
            "maxLength": 40,
            "description": "צפון, מרכז, דרום, north, center, or south."
          },
          "q": {
            "type": "string",
            "maxLength": 120,
            "description": "Search the public name, city, and description."
          },
          "min_rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "sort": {
            "type": "string",
            "enum": [
              "reviews",
              "rating"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Max 50. Default 20."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_company",
      "description": "Read one visible company profile and its approved reviews. קריאת פרופיל חברה גלויה וביקורות מאושרות. Reviewer email and phone are not returned.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Company slug."
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_solar_facts",
      "description": "Return verified 2026 price ranges, the feed-in text, and the calculator assumptions. טווחי מחיר מאומתים, טקסט התעריף, והנחות המחשבון. Missing tax or VAT figures stay null.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_whatsapp_consultation_link",
      "description": "Build a WhatsApp link to נגה, a site link, and a /go/wa handoff. בניית קישור לוואטסאפ של נגה, קישור לאתר, וקישור /go/wa. Do not send a name, phone, or email. The text does not name an installer and does not promise a number of quotes. Read-only link generation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "roof_sqm": {
            "type": "number",
            "minimum": 1,
            "maximum": 5000,
            "description": "Roof area in square meters."
          },
          "monthly_bill_ils": {
            "type": "number",
            "minimum": 1,
            "maximum": 200000,
            "description": "Monthly bill in ILS."
          },
          "city": {
            "type": "string",
            "maxLength": 40,
            "description": "Hebrew city name. Optional."
          },
          "intent": {
            "type": "string",
            "enum": [
              "home",
              "business",
              "general"
            ],
            "description": "home, business, or general."
          },
          "agent_name": {
            "type": "string",
            "maxLength": 32,
            "description": "Optional caller label for the site link. It is not written into the WhatsApp text."
          }
        },
        "additionalProperties": true,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "co.solarisrael/solarisrael",
    "version": "1.0.0",
    "remoteUrl": "https://www.solarisrael.co/mcp",
    "publishedAt": "2026-11-26T05:02:27.977453Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "9f0218438744ddae03cc3b9484d07d085e527123f7ffb4ec4577746d9539e6a4"
  }
}
