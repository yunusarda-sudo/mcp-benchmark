{
  "$schema": "../schema.json",
  "name": "Google Sheets MCP",
  "category": "Payments, CRM & Finance",
  "description": "Google Sheets MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "append_row",
      "description": "Append row of string values to the end of a Google Spreadsheet worksheet tab.",
      "inputSchema": {
        "type": "object",
        "required": [
          "spreadsheetId",
          "range",
          "values"
        ],
        "properties": {
          "spreadsheetId": {
            "type": "string",
            "description": "Google Sheets document ID."
          },
          "range": {
            "type": "string",
            "description": "A1 notation sheet range (e.g. Sheet1!A:C)."
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Array of cell values to append."
          }
        }
      }
    }
  ]
}
