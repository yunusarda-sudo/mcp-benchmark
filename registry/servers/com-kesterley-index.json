{
  "$schema": "../schema.json",
  "name": "com.kesterley/index",
  "title": "Kesterley Index",
  "category": "Other",
  "description": "Who AI names first in 20 markets, brand by brand.",
  "tools": [
    {
      "name": "list_markets",
      "description": "The twenty public markets: metadata only, no pooled or cross-market counts.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_market",
      "description": "Public counts for exactly one market, separately from memory and with web search. Not market shares.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_brand",
      "description": "Public counts for one named brand in exactly one market.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "brand": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "slug",
          "brand"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_methodology",
      "description": "Three public summary paragraphs and their source page.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {},
        "additionalProperties": false
      }
    }
  ],
