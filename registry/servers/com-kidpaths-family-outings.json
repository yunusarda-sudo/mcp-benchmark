{
  "$schema": "../schema.json",
  "name": "com.kidpaths/family-outings",
  "title": "KidPaths Family Outings",
  "category": "Other",
  "description": "Read-only family outing search and plans: Denver, San Diego, Chicago, Seattle, DC, NYC, Boston.",
  "tools": [
    {
      "name": "search_family_activities",
      "description": "Search family records for Denver, San Diego, Chicago, Seattle, Washington DC, New York City or Boston. Cities other than Denver and San Diego cover venues with official-page verified fields only. Use query for a named venue (for example Midway) instead of loading every result. Ask for adult count and every child age before a budget or age-fit request. Budget is USD admission only, never total outing cost. Unknown hard constraints are excluded. Follow next_offset for pagination.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "description": "Search only; case-insensitive venue-name substring."
          },
          "city": {
            "enum": [
              "denver",
              "san-diego",
              "chicago",
              "seattle",
              "washington-dc",
              "new-york-city",
              "boston"
            ]
          },
          "party": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "adults",
              "child_ages",
              "ticket_category"
            ],
            "properties": {
              "adults": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "child_ages": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 17
                }
              },
              "ticket_category": {
                "const": "standard"
              }
            }
          },
          "filters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stroller": {
                "const": true
              },
              "indoor": {
                "const": true
              },
              "all_children_suitable": {
                "const": true
              },
              "max_admission_usd": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000,
                "multipleOf": 0.01
              }
            }
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "city"
        ]
      }
    },
    {
      "name": "get_activity_details",
      "description": "Get one activity using an ID returned by search. Includes dated sources, uncertainty and optional disclosed external attraction-admission referrals. No live inventory, reservations, payment or paid digital products.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "city": {
            "enum": [
              "denver",
              "san-diego",
              "chicago",
              "seattle",
              "washington-dc",
              "new-york-city",
              "boston"
            ]
          },
          "party": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "adults",
              "child_ages",
              "ticket_category"
            ],
            "properties": {
              "adults": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "child_ages": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 17
                }
              },
              "ticket_category": {
                "const": "standard"
              }
            }
          },
          "ids": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,160}$"
            }
          },
          "filters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stroller": {
                "const": true
              },
              "indoor": {
                "const": true
              },
              "all_children_suitable": {
                "const": true
              },
              "max_admission_usd": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000,
                "multipleOf": 0.01
              }
            }
          }
        },
        "required": [
          "city",
          "ids"
        ]
      }
    },
    {
      "name": "compare_family_options",
      "description": "Compare 2-4 IDs returned by search in the same city. Preserve failed and unknown constraints; do not present unknown facts as confirmed. Published admission subtotals are not checkout quotes.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "city": {
            "enum": [
              "denver",
              "san-diego",
              "chicago",
              "seattle",
              "washington-dc",
              "new-york-city",
              "boston"
            ]
          },
          "party": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "adults",
              "child_ages",
              "ticket_category"
            ],
            "properties": {
              "adults": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "child_ages": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 17
                }
              },
              "ticket_category": {
                "const": "standard"
              }
            }
          },
          "ids": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,160}$"
            }
          },
          "filters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stroller": {
                "const": true
              },
              "indoor": {
                "const": true
              },
              "all_children_suitable": {
                "const": true
              },
              "max_admission_usd": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000,
                "multipleOf": 0.01
              }
            }
          }
        },
        "required": [
          "city",
          "ids"
        ]
      }
    },
    {
      "name": "plan_family_outing",
      "description": "Recommend one outing and a distinct sheltered backup when evidence and constraints allow. Requires complete party. Filters remain strict; editorial suitability must fit every child. visit_date records intent only: opening, reservations and availability remain unverified. No travel-time or whole-outing-budget support. Return shortages honestly. No booking is performed.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "visit_date": {
            "type": "string",
            "format": "date",
            "description": "Plan only. Requested date, not verified opening or availability."
          },
          "city": {
            "enum": [
              "denver",
              "san-diego",
              "chicago",
              "seattle",
              "washington-dc",
              "new-york-city",
              "boston"
            ]
          },
          "party": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "adults",
              "child_ages",
              "ticket_category"
            ],
            "properties": {
              "adults": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "child_ages": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 17
                }
              },
              "ticket_category": {
                "const": "standard"
              }
            }
          },
          "filters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stroller": {
                "const": true
              },
              "indoor": {
                "const": true
              },
              "all_children_suitable": {
                "const": true
              },
              "max_admission_usd": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000,
                "multipleOf": 0.01
              }
            }
          },
          "include_kidpaths_resources": {
            "const": true,
            "description": "Plan only. Set only when the family explicitly asks for a printable or offline city guide, or for a weekly email of outing ideas. Returns KidPaths' own resources for guide cities, labeled as such; some hosts never receive them."
          }
        },
        "required": [
          "city",
          "party"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
