{
  "$schema": "../schema.json",
  "name": "app.rosmaryn/encyclopedia",
  "title": "Rosmaryn",
  "category": "Other",
  "description": "Search the Rosmaryn encyclopedia of Human Design, astrology and numerology, in six languages.",
  "tools": [
    {
      "name": "search_encyclopedia",
      "description": "Find pages of the Rosmaryn encyclopedia (Human Design, astrology, numerology, mirror hours) and return their titles, types and links. Use it to cite a reference page on rosmaryn.app.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Words to look for, e.g. \"gate 34\", \"Mars in Leo\", \"life path 7\"."
          },
          "language": {
            "type": "string",
            "enum": [
              "fr",
              "en",
              "de",
              "es",
              "it",
              "pt"
            ],
            "description": "Language of the results (default en)."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "list_calculators",
      "description": "List the free online calculators of Rosmaryn (Human Design Body Graph, birth chart, transits, numerology, and more) with their links.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "fr",
              "en",
              "de",
              "es",
              "it",
              "pt"
            ],
            "description": "Language of the results (default en)."
          }
        }
      }
    },
    {
      "name": "upcoming_sky_events",
      "description": "Upcoming Moon phases, eclipses, planets entering signs and retrograde stations (tropical zodiac, times in UTC), as published in the Rosmaryn sky calendar.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "fr",
              "en",
              "de",
              "es",
              "it",
              "pt"
            ],
            "description": "Language of the results (default en)."
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365,
            "description": "How many days ahead (default 30)."
          },
          "moon_only": {
            "type": "boolean",
            "description": "Only Moon phases and eclipses."
          }
        }
      }
    }
  ],
