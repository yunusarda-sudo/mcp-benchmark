{
  "$schema": "../schema.json",
  "name": "ae.discond/discond",
  "title": "Discond",
  "category": "Other",
  "description": "UAE restaurant picks and live discounts across Fazaa, The Entertainer, Talabat and more.",
  "tools": [
    {
      "name": "discond_find_discounts",
      "description": "Search UAE merchants with live discounts on Discond by free text, place (emirate or area such as \"Dubai Marina\"), coordinates, discount provider, or category. Returns merchants with links; when the user is signed in to Discond it also returns their best current offers.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 200,
            "description": "Merchant name or part of it (matches names only). A bare kind of place such as \"spa\", \"gym\" or \"dinner\" is searched as its category."
          },
          "place": {
            "type": "string",
            "maxLength": 200,
            "description": "Emirate (e.g. Dubai, Abu Dhabi) or a UAE area (e.g. \"Dubai Marina\", \"JBR\", \"Business Bay\", \"Yas Island\"). Known areas search around the area centre; other areas fall back to their emirate. lat/lng overrides."
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "Latitude to search around (with lng). Overrides place."
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "Longitude to search around (with lat)."
          },
          "radius_m": {
            "type": "integer",
            "minimum": 500,
            "maximum": 25000,
            "description": "Nearby radius in meters (500–25000)"
          },
          "provider": {
            "type": "string",
            "maxLength": 200,
            "description": "Provider name e.g. Entertainer, Fazaa, Talabat"
          },
          "provider_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "maxItems": 20,
            "description": "Provider ids from discond_list_providers. Use instead of provider when you already have ids."
          },
          "category": {
            "type": "string",
            "maxLength": 200,
            "description": "One of Discond's 13 broad categories, e.g. \"Restaurants & Cafés\", \"Beauty & Spa\", \"Fitness & Sports\", \"Travel & Hotels\". There are no cuisine categories."
          },
          "category_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "maxItems": 20,
            "description": "Category ids from discond_list_categories. Use instead of category when you already have ids."
          },
          "online_only": {
            "type": "boolean",
            "description": "true: only merchants with online offers (delivery, e-shop)."
          },
          "with_active_offers": {
            "type": "boolean",
            "default": true,
            "description": "Only merchants with at least one live offer (default true)."
          },
          "sort": {
            "type": "string",
            "enum": [
              "discover",
              "nearby"
            ],
            "description": "nearby: closest first (used when a place or lat/lng is given). discover: a mixed list. Chosen automatically from the location."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 10,
            "description": "Max results (1–25, default 10)"
          },
          "cursor": {
            "type": "string",
            "maxLength": 512,
            "description": "Pagination cursor from a previous response meta.next_cursor"
          },
          "response_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ],
            "default": "markdown",
            "description": "markdown (default, human-readable) or json (structured)"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "discond_find_venues",
      "description": "Find UAE restaurants, cafés and other venues near an area or landmark (e.g. \"Burj Khalifa\", \"Dubai Marina\", \"Yas Island\") that fit a cuisine, a budget per person and must-haves such as alcohol, kids or outdoor seating. Each venue says which asks are confirmed and which are not known, with a short description when we have one, price per person, rating, photos, any live Discond deal and a link. A whole emirate is too wide: the result then names what is missing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "place": {
            "type": "string",
            "maxLength": 200,
            "description": "Area or landmark, e.g. \"Burj Khalifa\", \"Downtown Dubai\", \"JBR\", \"Dubai Mall\". lat/lng overrides."
          },
          "lat": {
            "type": "number",
            "minimum": 22,
            "maximum": 27,
            "description": "Latitude to search around (with lng). Overrides place."
          },
          "lng": {
            "type": "number",
            "minimum": 51,
            "maximum": 57,
            "description": "Longitude to search around (with lat)."
          },
          "radius_m": {
            "type": "integer",
            "minimum": 300,
            "maximum": 10000,
            "description": "Search radius in meters (default: the area size, about 1.5 km)"
          },
          "cuisines": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "maxItems": 6,
            "description": "Cuisines or families, e.g. [\"European\"], [\"Italian\", \"French\"], [\"sushi\"]"
          },
          "must_have": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "serves_alcohol",
                "good_for_kids",
                "kids_menu",
                "high_chairs",
                "good_for_groups",
                "private_dining",
                "accepts_reservations",
                "outdoor_seating",
                "live_music",
                "wheelchair_accessible",
                "parking",
                "valet_parking",
                "vegetarian_options",
                "halal",
                "breakfast",
                "brunch",
                "lunch",
                "dinner",
                "has_a_view",
                "serves_shisha",
                "rooftop"
              ]
            },
            "maxItems": 8,
            "description": "Requirements: a venue that is known not to meet one is left out"
          },
          "budget_per_person": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000,
            "description": "Budget per person"
          },
          "currency": {
            "type": "string",
            "enum": [
              "AED",
              "USD"
            ],
            "default": "AED",
            "description": "Currency of budget_per_person"
          },
          "adults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "description": "Number of adults in the group."
          },
          "kids": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Number of children. More than 0 also asks for kid-friendly venues."
          },
          "kind": {
            "type": "string",
            "enum": [
              "dining",
              "any"
            ],
            "default": "dining",
            "description": "dining (restaurants and cafés, default) or any venue type"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 6,
            "description": "How many venues to return (1–10, default 6)."
          },
          "response_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ],
            "default": "markdown",
            "description": "markdown (default, human-readable) or json (structured)"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "discond_autocomplete_businesses",
      "description": "Typo-tolerant autocomplete of UAE merchant names on Discond. Returns matching merchant ids and names for partial or misspelled input.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "description": "Partial merchant name"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 8,
            "description": "How many suggestions (1–20, default 8)."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Skip this many results, for the next page."
          },
          "response_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ],
            "default": "markdown",
            "description": "markdown (default, human-readable) or json (structured)"
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "discond_get_business",
      "description": "Get one Discond merchant by id: name, a short description when we have one, categories, providers, link and its branches. Pass the user's lat/lng when known so branches come nearest first, with distance. When the user is signed in to Discond, its top live offers are included.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "business_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Merchant id from discond_find_discounts or discond_autocomplete_businesses."
          },
          "include_offers": {
            "type": "boolean",
            "description": "Include live offers (signed-in users only). Default: true when signed in."
          },
          "offer_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 10,
            "description": "Max results (1–25, default 10)"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "User's latitude (with lng). Branches are then sorted nearest first."
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "User's longitude (with lat)."
          },
          "response_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ],
            "default": "markdown",
            "description": "markdown (default, human-readable) or json (structured)"
          }
        },
        "required": [
          "business_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "discond_list_offers",
      "description": "List live Discond offers, filtered by merchant, branch, provider, category, validity or online-only, sorted by newest, expiring or biggest discount. Has no place filter: filter by merchant id instead. Requires the user to be signed in to Discond.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 200,
            "description": "Words in the offer or merchant name."
          },
          "business_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Only offers of this merchant (id from discond_find_discounts)."
          },
          "business_branch_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Only offers valid at this branch of the merchant."
          },
          "include_all_branches": {
            "type": "boolean",
            "description": "With business_branch_id: also include offers valid at all of the merchant's branches."
          },
          "provider_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "maxItems": 20,
            "description": "Provider ids from discond_list_providers."
          },
          "category_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "maxItems": 20,
            "description": "Category ids from discond_list_categories."
          },
          "valid_now": {
            "type": "boolean",
            "default": true,
            "description": "Only offers valid today (default true)."
          },
          "online_only": {
            "type": "boolean",
            "description": "true: only online offers (delivery, e-shop)."
          },
          "sort": {
            "type": "string",
            "enum": [
              "newest",
              "expiring",
              "discount"
            ],
            "default": "discount",
            "description": "discount: biggest first (default). newest: most recently added. expiring: ending soonest."
          },
          "benefit": {
            "type": "string",
            "enum": [
              "off",
              "cashback"
            ],
            "description": "Client-side filter on benefit_type"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 10,
            "description": "Max results (1–25, default 10)"
          },
          "cursor": {
            "type": "string",
            "maxLength": 512,
            "description": "Pagination cursor from a previous response meta.next_cursor"
          },
          "response_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ],
            "default": "markdown",
            "description": "markdown (default, human-readable) or json (structured)"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "discond_get_offer",
      "description": "Get one Discond offer by id: headline, terms, validity and redeem links. Requires the user to be signed in to Discond.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "offer_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Offer id from discond_list_offers, discond_get_business or discond_find_discounts."
          },
          "response_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ],
            "default": "markdown",
            "description": "markdown (default, human-readable) or json (structured)"
          }
        },
        "required": [
          "offer_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "discond_list_categories",
      "description": "List Discond merchant categories with ids, optionally filtered by name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 200,
            "description": "Part of the name to filter by."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 30,
            "description": "How many to return (1–100, default 30)."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Skip this many results, for the next page."
          },
          "response_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ],
            "default": "markdown",
            "description": "markdown (default, human-readable) or json (structured)"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "discond_list_providers",
      "description": "List the discount providers Discond covers (for example Fazaa, The Entertainer, Talabat) with ids and offer counts, optionally filtered by name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 200,
            "description": "Part of the name to filter by."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 30,
            "description": "How many to return (1–100, default 30)."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Skip this many results, for the next page."
          },
          "response_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ],
            "default": "markdown",
            "description": "markdown (default, human-readable) or json (structured)"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "discond_resolve_place",
      "description": "Resolve a UAE place name to Discond place ids (emirate, community, settlement) or to a known area. A known area or landmark (Burj Khalifa, Dubai Mall…) has level \"area\" or \"landmark\" and id 0; its name works as the place filter of discond_find_discounts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "description": "Place name to resolve"
          },
          "level": {
            "type": "string",
            "enum": [
              "region",
              "community",
              "settlement",
              "area",
              "landmark",
              "auto"
            ],
            "default": "auto",
            "description": "What kind of place to look for. auto (default) tries all."
          },
          "region_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Only places inside this emirate (region id from an earlier result)."
          },
          "community_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "Only places inside this community (id from an earlier result)."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 15,
            "description": "How many matches (1–50, default 15)."
          },
          "response_format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ],
            "default": "markdown",
            "description": "markdown (default, human-readable) or json (structured)"
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
