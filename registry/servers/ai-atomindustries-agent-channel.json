    {
      "name": "request_quote",
      "description": "Send Atom Industries a quote request on behalf of a person. Returns an automated acknowledgement and the booking link. Set consent to true only if the person agreed to be contacted. A person on the team answers; nothing is emailed automatically.",
      "inputSchema": {
        "type": "object",
        "required": [
          "need",
          "contact",
          "consent",
          "on_behalf_of"
        ],
        "properties": {
          "need": {
            "type": "string",
            "minLength": 10,
            "maxLength": 4000,
            "description": "What the person needs, in their words: the problem, scope, roles or volumes."
          },
          "company": {
            "type": "string",
            "maxLength": 160,
            "description": "The organization the person represents."
          },
          "contact": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "description": "The person to answer. An email or a phone is required.",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 120
              },
              "role": {
                "type": "string",
                "maxLength": 160,
                "description": "Job title or role."
              },
              "email": {
                "type": "string",
                "format": "email",
                "maxLength": 200
              },
              "phone": {
                "type": "string",
                "maxLength": 32,
                "description": "International format, e.g. +1 212 555 0100."
              }
            }
          },
          "budget": {
            "type": "string",
            "maxLength": 200,
            "description": "Budget or range, free text (e.g. \"$20k-30k a month\")."
          },
          "timeline": {
            "type": "string",
            "maxLength": 200,
            "description": "When they want to start or decide."
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "es",
              "pt"
            ],
            "description": "Language for the answer."
          },
          "consent": {
            "type": "boolean",
            "const": true,
            "description": "True only if the person named in contact agreed to be contacted by this company about this inquiry."
          },
          "on_behalf_of": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Who the agent acts for: the person and, if any, their organization."
          },
          "agent": {
            "type": "object",
            "additionalProperties": false,
            "description": "The agent sending this (optional but recommended). The User-Agent header is recorded too.",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 120
              },
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 300
              },
              "operator": {
                "type": "string",
                "maxLength": 160,
                "description": "Who runs the agent."
              }
            }
          },
          "test": {
            "type": "boolean",
            "description": "True to test an integration: recorded and marked as a test, nobody follows up."
          }
        }
      }
    },
