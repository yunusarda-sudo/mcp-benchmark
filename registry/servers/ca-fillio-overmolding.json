{
  "$schema": "../schema.json",
  "name": "ca.fillio/overmolding",
  "title": "Fillio · electronics overmolding",
  "category": "Design, UI & 3D Media",
  "description": "Overmolding design guide, part feasibility checks, resin selectors, potting cost, harness template.",
  "tools": [
    {
      "name": "get_design_guide",
      "description": "Returns Fillio's design reference for low-pressure overmolding of electronics (boards, connectors, cable junctions): when the process fits, resins, values to aim for, 3D file preparation, what the portal's analysis checks. Useful when designing or reviewing a part to be overmolded.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lang": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ],
            "description": "Language of the answer: “fr” or “en”."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_capabilities",
      "description": "Returns as data what Fillio makes, the resins, the design values to aim for (size, resin volume and thickness, cables, draft), the accepted file formats and the body names it recognizes. Values are read from the analysis rules currently in force.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lang": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ],
            "description": "Language of the answer: “fr” or “en”."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_upload_link",
      "description": "Returns the address of Fillio's portal, where the user uploads a 3D file, gets the feasibility analysis and requests a quote, with the steps and what to have at hand. Read-only: nothing is created or sent.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lang": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ],
            "description": "Language of the answer: “fr” or “en”."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "estimate_in_house_potting_cost",
      "description": "Returns the real cost per working part of one year of in-house potting (epoxy or resin encapsulation), comparable with a quote: labour, engineering, rejects, returns, resin, curing space, equipment, health and safety, and delays. Same calculation as the calculator on www.fillio.ca; a missing argument takes the calculator's default value. Nothing is stored or sent.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lang": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ],
            "description": "Language of the answer: “fr” or “en”."
          },
          "parts_per_year": {
            "type": "number",
            "minimum": 0,
            "default": 500,
            "description": "Parts produced per year (parts)"
          },
          "potting_minutes_per_part": {
            "type": "number",
            "minimum": 0,
            "default": 12,
            "description": "Potting time per part (min)"
          },
          "operator_rate_per_hour": {
            "type": "number",
            "minimum": 0,
            "default": 45,
            "description": "Loaded hourly rate, operator ($/h)"
          },
          "engineering_hours_per_month": {
            "type": "number",
            "minimum": 0,
            "default": 4,
            "description": "Engineering hours on potting (h/month)"
          },
          "engineering_rate_per_hour": {
            "type": "number",
            "minimum": 0,
            "default": 95,
            "description": "Loaded hourly rate, engineering ($/h)"
          },
          "rejected_parts_pct": {
            "type": "number",
            "minimum": 0,
            "default": 8,
            "description": "Rejected parts (%)"
          },
          "assembly_value": {
            "type": "number",
            "minimum": 0,
            "default": 60,
            "description": "Full value of one assembly ($)"
          },
          "customer_returns_per_year": {
            "type": "number",
            "minimum": 0,
            "default": 5,
            "description": "Customer returns per year (returns)"
          },
          "cost_per_return": {
            "type": "number",
            "minimum": 0,
            "default": 250,
            "description": "Cost of one return ($)"
          },
          "parts_potted_per_day": {
            "type": "number",
            "minimum": 0,
            "default": 20,
            "description": "Parts potted per day (parts)"
          },
          "cure_time_hours": {
            "type": "number",
            "minimum": 0,
            "default": 24,
            "description": "Cure time (h)"
          },
          "floor_space_per_curing_part_ft2": {
            "type": "number",
            "minimum": 0,
            "default": 0.5,
            "description": "Floor space per curing part (ft²)"
          },
          "space_cost_per_ft2_year": {
            "type": "number",
            "minimum": 0,
            "default": 15,
            "description": "Annual cost of space ($/ft²)"
          },
          "resin_cost_per_part": {
            "type": "number",
            "minimum": 0,
            "default": 2.5,
            "description": "Resin per part ($)"
          },
          "resin_wasted_pct": {
            "type": "number",
            "minimum": 0,
            "default": 25,
            "description": "Wasted or expired resin (%)"
          },
          "equipment_per_year": {
            "type": "number",
            "minimum": 0,
            "default": 1500,
            "description": "Amortized equipment and upkeep ($/yr)"
          },
          "health_safety_per_year": {
            "type": "number",
            "minimum": 0,
            "default": 800,
            "description": "Health and safety, waste, training ($/yr)"
          },
          "weeks_added": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "description": "Weeks added to the project (wk)"
          },
          "delay_value_per_week": {
            "type": "number",
            "minimum": 0,
            "default": 2000,
            "description": "Value of a one-week delay ($)"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "recommend_overmolding_resin",
      "description": "Returns the low-pressure overmolding polyamide family best suited to a part's service temperatures, exposures, hardness and needs, with its service range, hardness, colours, what remains to confirm with Fillio and another compatible family. Same choices and same answer as the selector on www.fillio.ca.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lang": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ],
            "description": "Language of the answer: “fr” or “en”."
          },
          "min_service_temp_c": {
            "type": "integer",
            "enum": [
              -40,
              -25,
              10
            ],
            "default": -40
          },
          "max_service_temp_c": {
            "type": "integer",
            "enum": [
              80,
              105,
              125,
              175,
              200
            ],
            "default": 125
          },
          "exposures": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "normal",
                "uv",
                "solvents",
                "oils",
                "humidity",
                "abrasion"
              ]
            }
          },
          "hardness": {
            "type": "string",
            "enum": [
              "any",
              "soft",
              "firm",
              "rigid"
            ],
            "default": "any"
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "led_window",
                "cable_strain_relief",
                "difficult_substrate"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "recommend_3d_printing_resin",
      "description": "Returns the SLA 3D printing resin best suited to a part's use, behaviour, service temperature and requirements, with its properties, the reasons for the choice, what remains to confirm and another option. Same choices and same answer as the selector on www.fillio.ca.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lang": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ],
            "description": "Language of the answer: “fr” or “en”."
          },
          "use": {
            "type": "string",
            "enum": [
              "functional_prototype",
              "shop_jig_or_fixture",
              "mold_or_hot_tooling",
              "end_use_part_small_batch",
              "seal_bumper_or_grip"
            ],
            "default": "functional_prototype"
          },
          "behavior": {
            "type": "string",
            "enum": [
              "rigid_and_precise",
              "withstand_impacts",
              "bend_without_breaking",
              "flexible_80a",
              "very_soft_40a_to_50a"
            ],
            "default": "rigid_and_precise"
          },
          "max_service_temp": {
            "type": "string",
            "enum": [
              "room_temperature",
              "up_to_60c",
              "up_to_100c",
              "above_100c"
            ],
            "default": "room_temperature"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "maximum_stiffness",
                "flame_retardant_ul94_v0",
                "static_dissipative_esd"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "send_harness_quote_template",
      "description": "Returns a check of a wire harness connection list (unknown references, contacts beyond the number of positions, duplicate contacts or wires, connectors with no wire or no length) and what the project still needs for a quote, and writes to the given address: a confirmation email, then, once its recipient clicks the link, Fillio's Excel quote request template, filled in with the project, connectors, connections (from-to) and lengths. The file goes to that address only; Fillio is then notified (address, company, part). Useful when preparing a wire harness assembly quote request.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Email address that receives the filled-in file (that of the person requesting the quote)."
          },
          "project": {
            "type": "object",
            "description": "Project: company, part, quantities, target date, who supplies the components, overmolding of a junction; every field is optional.",
            "properties": {
              "company": {
                "type": "string",
                "maxLength": 200,
                "description": "Company"
              },
              "part": {
                "type": "string",
                "maxLength": 200,
                "description": "Part name or number"
              },
              "revision": {
                "type": "string",
                "maxLength": 200,
                "description": "Drawing revision"
              },
              "application": {
                "type": "string",
                "maxLength": 200,
                "description": "Application and environment"
              },
              "standard": {
                "type": "string",
                "maxLength": 200,
                "description": "Required standard or class"
              },
              "prototype_quantity": {
                "type": [
                  "string",
                  "number"
                ],
                "maxLength": 200,
                "minimum": 0,
                "description": "Prototype quantity"
              },
              "first_run_quantity": {
                "type": [
                  "string",
                  "number"
                ],
                "maxLength": 200,
                "minimum": 0,
                "description": "First production run quantity"
              },
              "annual_volume": {
                "type": [
                  "string",
                  "number"
                ],
                "maxLength": 200,
                "minimum": 0,
                "description": "Expected annual volume"
              },
              "prototype_date": {
                "type": "string",
                "maxLength": 200,
                "description": "Target date for prototypes"
              },
              "supplied_by": {
                "type": "string",
                "enum": [
                  "fillio",
                  "customer",
                  "discuss"
                ],
                "description": "Components supplied by (fillio, customer, discuss)"
              },
              "overmolding": {
                "type": "string",
                "maxLength": 200,
                "description": "Overmolding of a junction or connector?"
              },
              "comments": {
                "type": "string",
                "maxLength": 2000,
                "description": "Comments"
              }
            },
            "additionalProperties": false
          },
          "connectors": {
            "type": "array",
            "maxItems": 100,
            "description": "Connectors: one row per end of the harness (ref. J1, J2…), with the manufacturer, housing and contact part numbers and number of positions.",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Ref."
                },
                "manufacturer": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Manufacturer"
                },
                "housing": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Housing P/N"
                },
                "contacts": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Contact P/N"
                },
                "positions": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "No. of positions"
                },
                "accessories": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Accessories (seal, plug, lock)"
                },
                "equivalent_accepted": {
                  "type": "boolean",
                  "description": "Equivalent accepted?"
                },
                "notes": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Notes"
                }
              },
              "additionalProperties": false
            }
          },
          "connections": {
            "type": "array",
            "maxItems": 500,
            "description": "Connections (from-to): one row per wire, from one reference and contact to another, with the gauge, colour and wire type.",
            "items": {
              "type": "object",
              "properties": {
                "wire": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Wire no."
                },
                "from_ref": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "From: ref."
                },
                "from_contact": {
                  "type": [
                    "string",
                    "number"
                  ],
                  "maxLength": 200,
                  "minimum": 0,
                  "description": "From: contact"
                },
                "to_ref": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "To: ref."
                },
                "to_contact": {
                  "type": [
                    "string",
                    "number"
                  ],
                  "maxLength": 200,
                  "minimum": 0,
                  "description": "To: contact"
                },
                "gauge_awg": {
                  "type": [
                    "string",
                    "number"
                  ],
                  "maxLength": 200,
                  "minimum": 0,
                  "description": "Gauge (AWG)"
                },
                "color": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Color"
                },
                "wire_type": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Wire type"
                },
                "signal": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Signal or function"
                },
                "notes": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Notes (shield, twisted pair...)"
                }
              },
              "additionalProperties": false
            }
          },
          "lengths": {
            "type": "array",
            "maxItems": 100,
            "description": "Lengths: one row per branch, between its two ends (reference or junction), with the length and tolerance in millimetres.",
            "items": {
              "type": "object",
              "properties": {
                "branch": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Branch"
                },
                "from": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "From"
                },
                "to": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "To"
                },
                "length_mm": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Length (mm)"
                },
                "tolerance_mm": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Tolerance (± mm)"
                },
                "sleeving": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Sleeving or protection"
                },
                "label": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Label to print"
                },
                "notes": {
                  "type": "string",
                  "maxLength": 200,
                  "description": "Notes"
                }
              },
              "additionalProperties": false
            }
          },
          "lang": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ],
            "description": "Language of the answer: “fr” or “en”."
          }
        },
        "required": [
          "email"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "start_part_check",
      "description": "Returns a one-time upload address for the 3D file (STEP, STL or 3MF) of a part to be overmolded. Once the file is uploaded to that address, the portal analyzes it in a draft project of the connected Fillio account; nothing is sent to Fillio until the project is submitted (submit_part_check, or by the user in the portal). Requires the user's Fillio account to be connected (authorization given in the portal, or a token). Useful to check a design before handing it to the user.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "file_name": {
            "type": "string",
            "maxLength": 200,
            "description": "Name of the 3D file, with its extension (.step, .stp, .stl or .3mf)."
          },
          "project": {
            "type": "string",
            "maxLength": 200,
            "description": "Number of a project already checked with this account (DEM-…), to upload a new version to it. Empty for a new project."
          },
          "project_name": {
            "type": "string",
            "maxLength": 200,
            "description": "Project name, for a new project. Defaults to the file name."
          },
          "resin": {
            "type": "string",
            "maxLength": 200,
            "description": "Overmolding resin: polyamide, urethane, silicone, or advise (Fillio's choice, the default).",
            "enum": [
              "polyamide",
              "urethane",
              "silicone",
              "advise"
            ]
          },
          "lang": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ],
            "description": "Language of the answer: “fr” or “en”."
          }
        },
        "required": [
          "file_name"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_part_check",
      "description": "Returns the feasibility analysis of a part uploaded with start_part_check: the outcome, the points to revisit with their location in millimetres, what was checked without remark and the recognized role of each body. Pending while the analysis is running. Requires the same connected Fillio account.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "maxLength": 200,
            "description": "Project number returned by the upload (DEM-…)."
          },
          "lang": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ],
            "description": "Language of the answer: “fr” or “en”."
          }
        },
        "required": [
          "project"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_submission_summary",
      "description": "Returns the summary of sending a project checked with start_part_check to Fillio: files, analysis outcome, answers and those still missing, and, when nothing is missing, a time-limited confirmation that submit_part_check takes to send the project. Read-only: nothing is sent or saved. An answer left out takes the one already entered in the portal, if any. Useful to show the user what would be sent, before they decide to send their part. Requires the same connected Fillio account.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "maxLength": 200,
            "description": "Number of the checked project to send (DEM-…)."
          },
          "resin": {
            "type": "string",
            "maxLength": 200,
            "description": "Overmolding resin: polyamide, urethane, silicone or advise (Fillio's choice). Defaults to the one of the check.",
            "enum": [
              "polyamide",
              "urethane",
              "silicone",
              "advise"
            ]
          },
          "supply": {
            "type": "string",
            "maxLength": 200,
            "description": "Who supplies the components to overmold (cable, connectors, board): client (the user supplies them), fillio (Fillio sources them), mixed or unknown (to be discussed).",
            "enum": [
              "client",
              "fillio",
              "mixed",
              "unknown"
            ]
          },
          "quantity": {
            "type": "string",
            "maxLength": 100,
            "description": "First-batch quantity, prototypes included; a range is an answer."
          },
          "annual_volume": {
            "type": "string",
            "maxLength": 100,
            "description": "Expected annual volume in production; a range or “to be determined” are answers."
          },
          "target_date": {
            "type": "string",
            "maxLength": 200,
            "description": "Target date for the first parts: a date, a month, “as soon as possible” or “to be determined”."
          },
          "notes": {
            "type": "string",
            "maxLength": 4000,
            "description": "Project notes for Fillio (optional)."
          },
          "lang": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ],
            "description": "Language of the answer: “fr” or “en”."
          }
        },
        "required": [
          "project"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "submit_part_check",
      "description": "Returns the outcome of sending a project checked with start_part_check to Fillio: the request carries the confirmation returned by get_submission_summary and the same answers; Fillio receives the request like a submission made in the portal, and the user an acknowledgement by email. If the project or the answers have changed since the summary, the submission is refused. Without a confirmation, only that summary is returned, and nothing is sent or saved. An answer left out takes the one already entered in the portal, if any. Useful when the user has decided to send their part for a quote. Requires the same connected Fillio account.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "maxLength": 200,
            "description": "Number of the checked project to send (DEM-…)."
          },
          "resin": {
            "type": "string",
            "maxLength": 200,
            "description": "Overmolding resin: polyamide, urethane, silicone or advise (Fillio's choice). Defaults to the one of the check.",
            "enum": [
              "polyamide",
              "urethane",
              "silicone",
              "advise"
            ]
          },
          "supply": {
            "type": "string",
            "maxLength": 200,
            "description": "Who supplies the components to overmold (cable, connectors, board): client (the user supplies them), fillio (Fillio sources them), mixed or unknown (to be discussed).",
            "enum": [
              "client",
              "fillio",
              "mixed",
              "unknown"
            ]
          },
          "quantity": {
            "type": "string",
            "maxLength": 100,
            "description": "First-batch quantity, prototypes included; a range is an answer."
          },
          "annual_volume": {
            "type": "string",
            "maxLength": 100,
            "description": "Expected annual volume in production; a range or “to be determined” are answers."
          },
          "target_date": {
            "type": "string",
            "maxLength": 200,
            "description": "Target date for the first parts: a date, a month, “as soon as possible” or “to be determined”."
          },
          "notes": {
            "type": "string",
            "maxLength": 4000,
            "description": "Project notes for Fillio (optional)."
          },
          "confirmation": {
            "type": "string",
            "maxLength": 200,
            "description": "Confirmation returned by get_submission_summary; without it, only the summary is returned and nothing is sent."
          },
          "lang": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ],
            "description": "Language of the answer: “fr” or “en”."
          }
        },
        "required": [
          "project"
        ],
        "additionalProperties": false
      }
    }
  ],
