    {
      "name": "get_methodology",
      "description": "Use when asked how Expat Checked selects, scores and ranks providers or how often it checks them. Returns inclusion criteria, the rubric with point rules, the ranking rule, the check cadence and the disclosure, with a link to the methodology page and the generation time of the data export.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "category": {
            "description": "Limit criteria and rubric to one category. Default: all categories.",
            "type": "string",
            "enum": [
              "mortgage-advisors",
              "relocation-agencies",
              "tax-advisors"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_ai_research",
      "description": "Use when asked which providers AI assistants name for expats in the Netherlands. Returns the latest Expat Checked measurement for the category: date, configuration, cell counts, the most named providers and directories, and the most cited domains. This is a measurement of AI answers, not the Expat Checked ranking.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "mortgage-advisors",
              "relocation-agencies",
              "tax-advisors"
            ]
          }
        },
        "required": [
          "category"
        ],
        "additionalProperties": false
      }
    }
