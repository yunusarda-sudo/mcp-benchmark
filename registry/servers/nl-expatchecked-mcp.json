{
  "$schema": "../schema.json",
  "name": "nl.expatchecked/mcp",
  "title": "Expat Checked",
  "category": "Finance, Crypto & Web3",
  "description": "Sourced facts on expat tax, relocation and mortgage advisors in the Netherlands, from Expat Checked.",
  "tools": [
    {
      "name": "find_providers",
      "description": "Use when someone looks for an expat tax advisor, relocation agency or expat mortgage advisor in the Netherlands with specific services, a city or English service. Returns the providers that meet every requirement, in the ranking order of the Expat Checked guide, with score, profile URL and the sourced facts that show each requirement is met. With no match it names the closest providers and what they lack. Needs per category: mortgage-advisors: 30_ruling, temporary_contract, non_eu_residence, foreign_income; relocation-agencies: immigration, home_search, registration, school_search, orientation, departure; tax-advisors: 30_ruling, m_form, zzp, foreign_assets, partner_return.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "mortgage-advisors",
              "relocation-agencies",
              "tax-advisors"
            ]
          },
          "needs": {
            "description": "Services the provider must offer; each must be valid for the category.",
            "maxItems": 14,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "30_ruling",
                "temporary_contract",
                "non_eu_residence",
                "foreign_income",
                "immigration",
                "home_search",
                "registration",
                "school_search",
                "orientation",
                "departure",
                "m_form",
                "zzp",
                "foreign_assets",
                "partner_return"
              ]
            }
          },
          "city": {
            "description": "City the provider must have an office in or list as covered; \"nationwide\" coverage counts for every city.",
            "type": "string",
            "enum": [
              "'s-Hertogenbosch",
              "Aalsmeer",
              "Alblasserdam",
              "Almere",
              "Alphen aan den Rijn",
              "Amersfoort",
              "Amstelveen",
              "Amsterdam",
              "Assen",
              "Breda",
              "Delft",
              "Den Haag",
              "Dordrecht",
              "Eindhoven",
              "Groningen",
              "Haarlem",
              "Hilversum",
              "Hoofddorp",
              "Houten",
              "Landsmeer",
              "Leiden",
              "Leiderdorp",
              "Mijdrecht",
              "Nootdorp",
              "Oostzaan",
              "Rijswijk",
              "Rotterdam",
              "Schiphol",
              "The Hague",
              "Utrecht",
              "Valkenswaard",
              "Vlierden",
              "Vlissingen",
              "Voorburg",
              "Voorhout",
              "Wassenaar",
              "Weesp",
              "Zaamslag",
              "Zaandam",
              "Zwolle"
            ]
          },
          "english_required": {
            "description": "Only providers that list English as a service language.",
            "type": "boolean"
          },
          "limit": {
            "description": "Maximum providers to return, 1 to 10. Default 5.",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "category"
        ],
        "additionalProperties": false
      }
    },
    {
