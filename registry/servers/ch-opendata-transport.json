{
 "$schema": "../schema.json",
 "name": "ch.opendata/transport",
 "title": "Swiss public transport",
 "category": "Other",
 "description": "Stations, connections and departures of Swiss public transport, with real-time delays.",
 "repository": "https://gitlab.com/opendata.ch/Transport",
 "tools": [
  {
   "name": "find_stations",
   "description": "Find stations and stops by name. Returns their exact names and ids, best match first.",
   "inputSchema": {
    "properties": {
     "query": {
      "description": "Name or part of a name, e.g. 'Bern' or 'Basel, Bank'.",
      "title": "Query",
      "type": "string"
     }
    },
    "required": [
     "query"
    ],
    "type": "object",
    "title": "find_stationsArguments"
   }
  },
  {
   "name": "stations_nearby",
   "description": "The stops closest to a point, with their distance in metres.",
   "inputSchema": {
    "properties": {
     "latitude": {
      "description": "WGS84 latitude, e.g. 46.9488.",
      "title": "Latitude",
      "type": "number"
     },
     "longitude": {
      "description": "WGS84 longitude, e.g. 7.4391.",
      "title": "Longitude",
      "type": "number"
     }
    },
    "required": [
     "latitude",
     "longitude"
    ],
    "type": "object",
    "title": "stations_nearbyArguments"
   }
  },
  {
   "name": "connections",
   "description": "Public transport connections from A to B: times, platforms, delays, changes, lines.",
   "inputSchema": {
    "properties": {
     "origin": {
      "description": "Start: station name or id, address or place.",
      "title": "Origin",
      "type": "string"
     },
     "destination": {
      "description": "Destination, like origin.",
      "title": "Destination",
      "type": "string"
     },
     "date": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "YYYY-MM-DD; today if left out.",
      "title": "Date"
     },
     "time": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "hh:mm, Swiss local time; now if left out.",
      "title": "Time"
     },
     "arrive_by": {
      "default": false,
      "description": "True if `time` is the latest arrival rather than departure.",
      "title": "Arrive By",
      "type": "boolean"
     },
     "via": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Up to two stations the journey must pass.",
      "title": "Via"
     },
     "limit": {
      "default": 4,
      "description": "Number of connections.",
      "maximum": 8,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
     }
    },
    "required": [
     "origin",
     "destination"
    ],
    "type": "object",
    "title": "connectionsArguments"
   }
  },
  {
   "name": "departures",
   "description": "The departure (or arrival) board of a station, with platforms, delays and cancellations.",
   "inputSchema": {
    "properties": {
     "station": {
      "description": "Station name or id.",
      "title": "Station",
      "type": "string"
     },
     "when": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "'YYYY-MM-DD hh:mm', Swiss local time; now if left out.",
      "title": "When"
     },
     "limit": {
      "default": 10,
      "description": "Number of entries.",
      "maximum": 40,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
     },
     "arrivals": {
      "default": false,
      "description": "True for arrivals instead of departures.",
      "title": "Arrivals",
      "type": "boolean"
     }
    },
    "required": [
     "station"
    ],
    "type": "object",
    "title": "departuresArguments"
   }
  }
 ],
 "source": {
  "type": "registry",
  "registry": "registry.modelcontextprotocol.io",
