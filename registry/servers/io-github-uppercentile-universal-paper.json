{
  "$schema": "../schema.json",
  "name": "io.github.Uppercentile/universal-paper",
  "title": "Universal Paper",
  "category": "Developer Tools & DevOps",
  "description": "Validate, simulate and render GPO, supplier and member agreements. Read-only; holds no keys.",
  "repository": "https://github.com/Uppercentile/universal-paper",
  "tools": [
    {
      "name": "validate_bundle",
      "description": "Check every agreement and event in a Universal Paper bundle against the axioms (signatures, hashes, Mandates, Term typing). `bundle` is a bundle object or JSON text. Returns per-event accept/reject with the rule that rejected it.",
      "inputSchema": {
        "properties": {
          "bundle": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "string"
              }
            ],
            "title": "Bundle"
          }
        },
        "required": [
          "bundle"
        ],
        "type": "object",
        "title": "validate_bundleArguments"
      }
    },
    {
      "name": "derive_state",
      "description": "Derive each agreement's status, tiers, contract prices and open obligations at time `at` (RFC 3339 UTC, default: the latest event).",
      "inputSchema": {
        "properties": {
          "bundle": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "string"
              }
            ],
            "title": "Bundle"
          },
          "at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "At"
          }
        },
        "required": [
          "bundle"
        ],
        "type": "object",
        "title": "derive_stateArguments"
      }
    },
    {
      "name": "check_event",
      "description": "Dry-run one signed Event against its chain's current state, without writing anything. Returns whether it would be accepted and every check performed.",
      "inputSchema": {
        "properties": {
          "bundle": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "string"
              }
            ],
            "title": "Bundle"
          },
          "event": {
            "additionalProperties": true,
            "title": "Event",
            "type": "object"
          }
        },
        "required": [
          "bundle",
          "event"
        ],
        "type": "object",
        "title": "check_eventArguments"
      }
    },
    {
      "name": "simulate_events",
      "description": "Run hypothetical events forward. Each event is {chain, kind, by, at, body, cosigners?, agent?: {key, mandate}}. Signatures are not required, but Mandate limits still apply, so an agent can test whether an action is within its authority before anyone signs.",
      "inputSchema": {
        "properties": {
          "bundle": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "string"
              }
            ],
            "title": "Bundle"
          },
          "events": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Events",
            "type": "array"
          },
          "at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "At"
          }
        },
        "required": [
          "bundle",
          "events"
        ],
        "type": "object",
        "title": "simulate_eventsArguments"
      }
    },
    {
      "name": "render_text",
      "description": "Render agreements as the human-readable text fixed by their hash. `chain` picks one chain by position; `hashes_only` ignores disclosures, showing what an outsider sees of sealed values.",
      "inputSchema": {
        "properties": {
          "bundle": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "string"
              }
            ],
            "title": "Bundle"
          },
          "chain": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Chain"
          },
          "hashes_only": {
            "default": false,
            "title": "Hashes Only",
            "type": "boolean"
          }
        },
        "required": [
          "bundle"
        ],
        "type": "object",
        "title": "render_textArguments"
      }
    },
    {
      "name": "hash_object",
      "description": "Content hash (RFC 8785 JCS + SHA-256, signatures stripped) of any JSON value.",
      "inputSchema": {
        "properties": {
          "obj": {
            "title": "Obj"
          }
        },
        "required": [
          "obj"
        ],
        "type": "object",
        "title": "hash_objectArguments"
      }
    },
    {
      "name": "list_terms",
      "description": "List the standard Universal Paper Term library.",
      "inputSchema": {
        "properties": {},
        "type": "object",
        "title": "list_termsArguments"
      }
    },
    {
      "name": "explain_term",
      "description": "Explain one Term, e.g. 'UP:Admin-Fee': parameters, claims, rendering template, provenance and hash.",
      "inputSchema": {
        "properties": {
          "term_id": {
            "title": "Term Id",
            "type": "string"
          }
        },
        "required": [
          "term_id"
        ],
        "type": "object",
        "title": "explain_termArguments"
      }
    },
    {
      "name": "get_example",
      "description": "Load a worked example bundle: one of conventional, generative, confidential, overlay. All parties and values are hypothetical.",
      "inputSchema": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object",
        "title": "get_exampleArguments"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.Uppercentile/universal-paper",
    "version": "0.1.0",
    "remoteUrl": "https://mcp.universalpaper.org/mcp",
    "publishedAt": "2026-11-24T06:22:06.119157Z",
    "fetchedAt": "2026-11-24T12:15:48.059Z",
    "toolsSha256": "d15169a15e310de32ad9a884c2d5985a0e462409dac2249f3ad3b765df781ad8"
  }
}
