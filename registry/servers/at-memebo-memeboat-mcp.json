{
  "$schema": "../schema.json",
  "name": "at.memebo/memeboat-mcp",
  "title": "Memeboat",
  "category": "Other",
  "description": "Search 30,000+ meme templates and make shareable memes on memebo.at. Free, no sign-in, no key.",
  "repository": "https://github.com/memebo-at/memeboat-mcp",
  "tools": [
    {
      "name": "search_meme_templates",
      "description": "Search memebo.at's catalog of 30,000+ meme templates by name, other names or topic (e.g. \"drake\", \"distracted boyfriend\", \"cat\"). Returns matching templates with their slug (use it with create_meme), image URL and a suggested caption count.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Search terms, e.g. \"surprised pikachu\""
          },
          "limit": {
            "description": "Max results (default 10)",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_meme_template",
      "description": "Fetch one meme template by its slug (from search_meme_templates or a memebo.at/templates/<slug> URL): dimensions, image URL, suggested caption count and, when it has one, the meaning and origin of the meme with its sources.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Template slug, e.g. \"x-x-everywhere\""
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "create_meme",
      "description": "Create a real, shareable meme on memebo.at by captioning a template. texts are placed top-to-bottom: 1 caption = bottom text, 2 captions = classic top/bottom, N captions fill the template's boxes in order (match suggestedCaptionCount when possible). Returns the meme page URL and a direct image URL. Rate-limited per IP — space out repeated calls.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "template": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Template slug, e.g. \"x-x-everywhere\""
          },
          "texts": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "color": {
                      "description": "Caption fill color: hex or white/black/red/yellow/blue/green",
                      "type": "string"
                    },
                    "outline": {
                      "description": "Caption outline color; omit for an auto-picked readable outline",
                      "type": "string"
                    },
                    "font": {
                      "description": "Caption font, one of: impact, arial, helvetica, times, courier, titillium, thick, kalam, comic, notosans, notosanshebrew",
                      "type": "string"
                    }
                  },
                  "required": [
                    "text"
                  ]
                }
              ]
            },
            "description": "Captions, top-to-bottom. Each is a string or { text, color?, outline?, font? } for per-caption styling. At least one must be non-empty."
          },
          "font": {
            "description": "Default font for all captions, one of: impact, arial, helvetica, times, courier, titillium, thick, kalam, comic, notosans, notosanshebrew",
            "type": "string"
          },
          "layout": {
            "description": "layout:'top' puts captions in a white bar above the image; 'default' overlays them on the image",
            "type": "string",
            "enum": [
              "default",
              "top"
            ]
          },
          "style": {
            "description": "Alternate background style name from get_meme_template's availableStyles, e.g. 'maga'",
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "deepFry": {
            "description": "Deep-fry the template picture (1 light, 2 medium, 3 extra); captions stay crisp",
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "effects": {
            "description": "Up to 3 picture effects, applied in order to the template picture only: deep-fry, nuked, needs-more-jpeg, potato (144p), bulge, magik, swirl, triggered, intensifies, vaporwave, doomer, cursed, jail, glitch, vhs. A name, or {name, strength 1-3, x, y, radius} for nuked, bulge, swirl (x and y 0-1 across and down). Captions stay crisp. Not together with deepFry.",
            "maxItems": 3,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    },
                    "strength": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3
                    },
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "center": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "y": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    },
                    "radius": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 1
                    },
                    "label": {
                      "type": "boolean"
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 99
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "wide": {
            "description": "Stretch the picture sideways: 1 is 1.5 times, 2 is 2 times, 3 is 3 times as wide",
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        },
        "required": [
          "template",
          "texts"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "at.memebo/memeboat-mcp",
    "version": "0.4.0",
    "remoteUrl": "https://memebo.at/mcp",
    "publishedAt": "2026-11-26T21:55:05.000716Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "f593cb11aa054d72a21b30176032d017aa9c1ad1da036612e96486f1a4b6b21a"
  }
}
