{
  "$schema": "../schema.json",
  "name": "com.treatyway/directory",
  "title": "Treatyway",
  "category": "Other",
  "description": "Find Bay Area and Paris businesses and send them requests. Free. Search needs no key.",
  "tools": [
    {
      "name": "search_businesses",
      "description": "Find Bay Area and Paris businesses. Put the job in query. not_covered is true when that job is outside the directory. A mixed query keeps the covered matches, and the note names the part that was not served. Set demo: true to get only the demo and practice listings. Example arguments: {\"query\":\"machine shop in San Jose\"}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "The job in plain words."
          },
          "category": {
            "type": "string",
            "description": "Category."
          },
          "city": {
            "type": "string",
            "description": "City."
          },
          "county": {
            "type": "string",
            "description": "County."
          },
          "near": {
            "type": "string",
            "description": "City to rank from."
          },
          "contactable": {
            "type": "boolean",
            "description": "Only an email on file."
          },
          "demo": {
            "type": "boolean",
            "description": "Demo and practice only."
          },
          "channel": {
            "type": "string",
            "description": "email, information, api, mcp, or openapi."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Page size, 1 to 20."
          },
          "cursor": {
            "type": "string",
            "description": "Pass next_cursor back."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_business",
      "description": "Read one listing: what it sells, and whether a request would be delivered. Example arguments: {\"business_id\":\"ba-0123abcd\"}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "business_id": {
            "type": "string",
            "description": "Full id, or a unique ba- prefix of at least 8 hex digits."
          }
        },
        "required": [
          "business_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "create_workspace",
      "description": "Get a Bearer key. Omit organization and operator_name for Level 0. Pass either for Level 1, Owner named (not verified). Send it as Authorization: Bearer. Example arguments: {}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "organization": {
            "type": "string",
            "description": "Company. Omit for Level 0."
          },
          "operator_name": {
            "type": "string",
            "description": "Person. Omit for Level 0."
          },
          "website": {
            "type": "string",
            "description": "Company https URL."
          },
          "agent_name": {
            "type": "string",
            "description": "Optional agent name."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "upgrade_workspace",
      "description": "Raise this workspace's trust tier. Needs the Bearer key. organization or operator_name names the owner. website plus prove (dns_txt or well_known) checks the site. Not a listing claim. Example arguments: {\"organization\":\"Northwind\",\"website\":\"https://northwind.example\"}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "organization": {
            "type": "string",
            "description": "Company name."
          },
          "operator_name": {
            "type": "string",
            "description": "Person's name."
          },
          "website": {
            "type": "string",
            "description": "Company https URL."
          },
          "agent_name": {
            "type": "string",
            "description": "Optional agent name."
          },
          "prove": {
            "type": "string",
            "enum": [
              "dns_txt",
              "well_known"
            ],
            "description": "dns_txt or well_known."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "verify_owner",
      "description": "Prove an X handle, a GitHub handle, or a domain. Needs the Bearer key. Omit proof_url to get a code, publish it, then call again. prove is well_known or dns_txt. dns is an alias. remove true drops that proof. Example arguments: {\"method\":\"github\",\"handle\":\"octocat\"}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "x",
              "github",
              "domain"
            ],
            "description": "x, github, or domain."
          },
          "handle": {
            "type": "string",
            "description": "Handle or domain."
          },
          "proof_url": {
            "type": "string",
            "description": "Public URL. Omit to start a code."
          },
          "prove": {
            "type": "string",
            "enum": [
              "dns_txt",
              "dns",
              "well_known"
            ],
            "description": "dns_txt or well_known. dns is an alias."
          },
          "remove": {
            "type": "boolean",
            "description": "True removes that proof."
          }
        },
        "required": [
          "method"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "create_request",
      "description": "Record one request. delivered_to_business is false when the business was not contacted. category is information or quotation. Example arguments: {\"business_id\":\"ba-from-search\",\"category\":\"information\",\"subject\":\"20 brackets\",\"message\":\"Can you make 20 brackets in Oakland?\",\"idempotency_key\":\"brackets-1\",\"authorized\":true}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "business_id": {
            "type": "string",
            "description": "Id from search or get_business."
          },
          "category": {
            "type": "string",
            "enum": [
              "information",
              "quotation"
            ],
            "description": "information or quotation."
          },
          "subject": {
            "type": "string",
            "description": "3 to 160 characters."
          },
          "message": {
            "type": "string",
            "description": "10 to 5000 characters."
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 100,
            "description": "8 to 100 characters. Same input returns the same request."
          },
          "authorized": {
            "type": "boolean",
            "description": "True only if the user asked you to contact this business."
          },
          "quantity": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional, 1 to 100000."
          },
          "destination": {
            "type": "string",
            "description": "Optional place."
          }
        },
        "required": [
          "business_id",
          "category",
          "subject",
          "message",
          "idempotency_key"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_request",
      "description": "Read one request for this key, including delivered_to_business. Example arguments: {\"request_id\":\"req_0123abcd\"}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "description": "Request id. Example: req_0123abcd."
          }
        },
        "required": [
          "request_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "add_message",
      "description": "Add a follow-up. The result says whether it was delivered. Example arguments: {\"request_id\":\"req_0123abcd\",\"message\":\"6061 aluminium.\",\"idempotency_key\":\"brackets-2\"}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "description": "Request id."
          },
          "message": {
            "type": "string",
            "description": "1 to 5000 characters."
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 100,
            "description": "8 to 100 characters. New key per follow-up."
          }
        },
        "required": [
          "request_id",
          "message",
          "idempotency_key"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "cancel_request",
      "description": "Cancel your request. The history is kept. Example arguments: {\"request_id\":\"req_0123abcd\"}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "description": "Request id."
          }
        },
        "required": [
          "request_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "tell_treatyway",
      "description": "Tell Treatyway what you could not do. Call this when search_businesses is not useful. It does not contact a business. No key is required. Optional: task, outcome, stuck_at, suggestion, client. Limits are 8 per hour per client, 200 per hour overall, and the same note twice a day. Example arguments: {\"needed\":\"Lunch for 40 on Friday\",\"could_not\":\"No prices\",\"outcome\":\"gave_up\"}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "needed": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000
          },
          "could_not": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "description": "What failed."
          },
          "query": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "description": "Search you tried."
          },
          "business_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "description": "Listing id, if any."
          },
          "task": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "done",
              "partly",
              "failed",
              "gave_up"
            ]
          },
          "stuck_at": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          },
          "client": {
            "type": "string"
          }
        },
        "required": [
          "needed"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_pass",
      "description": "For level 1 or 2. A 10-minute pass for one seller. Send seller_domain or business_id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "seller_domain": {
            "type": "string",
            "description": "Seller domain, or send business_id."
          },
          "business_id": {
            "type": "string",
            "description": "Seller id, or send seller_domain."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "report_outcome",
      "description": "outcome is completed, no_show, or cancelled. completed needs a reply from the business. Send pass_jti or request_id, not both. One report per party. A workspace key reports as the buyer. A business key reports as the seller. No free text.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pass_jti": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "completed",
              "no_show",
              "cancelled"
            ]
          }
        },
        "required": [
          "outcome"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.treatyway/directory",
    "version": "0.2.0",
    "remoteUrl": "https://treatyway.com/mcp",
    "publishedAt": "2026-11-26T14:59:10.921006Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "bf89561338de46ddd729346e7054ffcf21fe21927b98d1fe8804a0a7ba77740a"
  }
}
