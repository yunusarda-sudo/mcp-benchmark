{
  "$schema": "../schema.json",
  "name": "de.kernelterrasse/terrassenplaner",
  "title": "Kernel Terrassenplaner",
  "category": "Other",
  "description": "WPC-Terrassen planen: Material, Preis inkl. MwSt., Link. Plan WPC decks: materials, price, link.",
  "tools": [
    {
      "name": "list_board_options",
      "description": "Lists the WPC decking boards Kernel Terrasse sells (model, colour, profile, price per metre incl. VAT). Call this before choosing a board.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    {
      "name": "create_terrace_plan",
      "description": "Creates a terrace plan in the Kernel Terrassenplaner and returns the exact material list (boards, substructure, clips, pedestals, trim) with prices incl. 19 % VAT, delivery terms, warnings and a link that opens the plan on kernelterrasse.de. Only plans the planner can build are accepted; errors say what to change. No personal data needed. Nothing is ordered.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "outline": {
            "type": "object",
            "additionalProperties": false,
            "description": "Deck outline in metres. x runs along the house wall (left to right), y away from the house (y = 0 is the house edge, 'back'; the largest y is 'front').",
            "properties": {
              "shape": {
                "type": "string",
                "enum": [
                  "rectangle",
                  "circle",
                  "polygon"
                ]
              },
              "widthM": {
                "type": "number",
                "minimum": 1,
                "maximum": 30,
                "description": "Rectangle width along the house (x)."
              },
              "depthM": {
                "type": "number",
                "minimum": 1,
                "maximum": 30,
                "description": "Rectangle depth away from the house (y)."
              },
              "diameterM": {
                "type": "number",
                "minimum": 1,
                "maximum": 30,
                "description": "Circle diameter."
              },
              "points": {
                "type": "array",
                "minItems": 3,
                "maxItems": 40,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                },
                "description": "Polygon corners [[x, y], ...] in metres, in order. Use for L, T, U shapes, cut corners."
              }
            },
            "required": [
              "shape"
            ]
          },
          "cutouts": {
            "type": "array",
            "maxItems": 12,
            "description": "Openings in the deck (tree, planter, shaft). Replaces existing cut-outs when given.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "shape": {
                  "type": "string",
                  "enum": [
                    "rectangle",
                    "circle"
                  ]
                },
                "centerX": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 30,
                  "description": "Centre x."
                },
                "centerY": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 30,
                  "description": "Centre y."
                },
                "widthM": {
                  "type": "number",
                  "minimum": 0.2,
                  "maximum": 20,
                  "description": "Width, or the diameter of a circle."
                },
                "depthM": {
                  "type": "number",
                  "minimum": 0.2,
                  "maximum": 20,
                  "description": "Depth (rectangles only)."
                }
              },
              "required": [
                "shape",
                "centerX",
                "centerY",
                "widthM"
              ]
            }
          },
          "board": {
            "type": "object",
            "additionalProperties": false,
            "description": "Decking board. Use an id from list_board_options; otherwise kind and colour pick the closest offer.",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "massiv",
                  "hohlkammer",
                  "hohlkammer_3d"
                ],
                "description": "massiv = solid profile, hohlkammer = hollow, hohlkammer_3d = hollow with embossed wood grain."
              },
              "colour": {
                "type": "string",
                "maxLength": 40,
                "description": "Board colour name from list_board_options (e.g. Anthrazit, Grau). Omit for the board's own colour."
              }
            }
          },
          "design": {
            "type": "object",
            "additionalProperties": false,
            "description": "Laying design: direction, frame, zones with divider boards, steps. Only given parts change.",
            "properties": {
              "direction": {
                "type": "string",
                "enum": [
                  "laengs",
                  "quer",
                  "diagonal"
                ],
                "description": "laengs = boards parallel to the house wall (x), quer = away from the house (y), diagonal = 45°."
              },
              "frame": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "rows": {
                    "type": "integer",
                    "enum": [
                      0,
                      1,
                      2
                    ]
                  },
                  "colour": {
                    "type": "string",
                    "maxLength": 40,
                    "description": "Board colour name from list_board_options (e.g. Anthrazit, Grau). Omit for the board's own colour."
                  }
                },
                "required": [
                  "rows"
                ]
              },
              "zones": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "axis": {
                    "type": "string",
                    "enum": [
                      "x",
                      "y"
                    ],
                    "description": "x = zones side by side, y = zones behind each other."
                  },
                  "splits": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "share": {
                          "type": "number",
                          "minimum": 0.15,
                          "maximum": 0.85,
                          "description": "Divider position as a share of the extent along the axis."
                        },
                        "direction": {
                          "type": "string",
                          "enum": [
                            "laengs",
                            "quer",
                            "diagonal"
                          ],
                          "description": "laengs = boards parallel to the house wall (x), quer = away from the house (y), diagonal = 45°."
                        },
                        "colour": {
                          "type": "string",
                          "maxLength": 40,
                          "description": "Board colour name from list_board_options (e.g. Anthrazit, Grau). Omit for the board's own colour."
                        }
                      },
                      "required": [
                        "share",
                        "direction"
                      ]
                    }
                  }
                },
                "required": [
                  "axis",
                  "splits"
                ]
              },
              "steps": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 6,
                    "description": "0 removes the steps."
                  },
                  "edge": {
                    "type": "string",
                    "enum": [
                      "front",
                      "back",
                      "left",
                      "right"
                    ]
                  },
                  "widthM": {
                    "type": "number",
                    "minimum": 0.6,
                    "maximum": 12,
                    "description": "Step width (at most the length of that edge)."
                  },
                  "riseMm": {
                    "type": "integer",
                    "minimum": 120,
                    "maximum": 200
                  },
                  "depthMm": {
                    "type": "integer",
                    "minimum": 250,
                    "maximum": 450
                  },
                  "colour": {
                    "type": "string",
                    "maxLength": 40,
                    "description": "Board colour name from list_board_options (e.g. Anthrazit, Grau). Omit for the board's own colour."
                  }
                },
                "required": [
                  "count"
                ]
              }
            }
          },
          "substructure": {
            "type": "object",
            "additionalProperties": false,
            "description": "Unterbau: what the deck stands on.",
            "properties": {
              "ground": {
                "type": "string",
                "enum": [
                  "slab",
                  "pedestals",
                  "footings",
                  "ground-screws"
                ],
                "description": "slab = existing concrete/paving, pedestals = adjustable pedestals (Stelzlager) on paving, footings = concrete point footings, ground-screws."
              },
              "mounting": {
                "type": "string",
                "enum": [
                  "ground-level",
                  "house-attached",
                  "freestanding"
                ]
              },
              "heightMm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3000,
                "description": "Finished height above ground."
              },
              "edgeFinish": {
                "type": "string",
                "enum": [
                  "auto",
                  "trim",
                  "boards",
                  "none"
                ],
                "description": "Open sides: auto (board cladding once more than 5 cm sit below the substructure, else trim), trim (Abschlussleiste), boards (side cladding from deck boards on battens), none."
              }
            }
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "clips": {
                "type": "string",
                "enum": [
                  "plastic",
                  "steel"
                ],
                "description": "Hidden fastening clips (default plastic)."
              },
              "edgeTrim": {
                "type": "boolean",
                "description": "Edge trim on the open sides (default true)."
              }
            }
          },
          "name": {
            "type": "string",
            "maxLength": 60,
            "description": "Short plan name, e.g. 'Terrasse Garten'. No personal data (names, addresses, e-mail)."
          }
        },
        "required": [
          "outline"
        ]
      }
    },
