    {
      "name": "get_materials_and_price",
      "description": "Returns the plan's material list, total price incl. VAT (current prices) and delivery terms.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "planId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{24,64}$",
            "description": "planId returned by create_terrace_plan (valid 30 days from creation)."
          }
        },
        "required": [
          "planId"
        ]
      }
    },
    {
      "name": "get_share_link",
      "description": "Returns the link that opens the plan in the Kernel Terrassenplaner, where the person can view and edit it.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "planId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{24,64}$",
            "description": "planId returned by create_terrace_plan (valid 30 days from creation)."
          }
        },
        "required": [
          "planId"
        ]
      }
    },
    {
      "name": "create_checkout_link",
      "description": "Creates a quotation for the plan's materials and returns a link where the person reviews it, enters delivery address and pays. The assistant never pays or enters personal data; give the link to the person.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "planId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{24,64}$",
