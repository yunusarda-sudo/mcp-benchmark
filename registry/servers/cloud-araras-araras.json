{
  "$schema": "../schema.json",
  "name": "cloud.araras/araras",
  "title": "Araras",
  "category": "Other",
  "description": "View an Araras project and update its description.",
  "tools": [
    {
      "name": "get_current_project",
      "description": "The project of the key you call with: its details, the organizationSlug and projectSlug that other calls take, and what the key may do. Takes no arguments. Needs a project key or an app sign-in. Signed-in accounts use get_project.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_project",
      "description": "Read the saved details of one project. Requires membership or a project key with project:read.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "update_project_description",
      "description": "Replace the saved description. Requires owner or maintainer access, or a project key with project:write.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug",
          "description"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_services",
      "description": "Each service with its state and the release that serves. Requires project:read.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_service",
      "description": "Its manifest, reservations, desired and observed state, serving release and URLs. Requires project:read.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "serviceSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug",
          "serviceSlug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_service_domains",
      "description": "Lists custom domains separately from the app's default Araras URL. Includes current DNS instructions and the last evidence. Requires project:read.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "serviceSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug",
          "serviceSlug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "add_service_domain",
      "description": "Saves one of up to 3 custom names without reserving ownership or changing DNS. CNAME is the default. Choose address explicitly for A + TXT. Create the returned DNS records, then request a check. Requires project:write.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "serviceSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "hostname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "method": {
            "default": "cname",
            "type": "string",
            "enum": [
              "cname",
              "address"
            ]
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug",
          "serviceSlug",
          "hostname"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "check_service_domain",
      "description": "Queues a check using two DNS servers. A confirmed name may receive a route; HTTPS is active only after a trusted certificate handshake. Requires project:write.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "serviceSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "domainId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug",
          "serviceSlug",
          "domainId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "remove_service_domain",
      "description": "Confirms its route is removed before releasing its claim. Does not change customer DNS. The default Araras URL and other domains keep working. Requires project:write.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "serviceSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "domainId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug",
          "serviceSlug",
          "domainId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_releases",
      "description": "The 50 most recent, newest first. Requires project:read.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "serviceSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug",
          "serviceSlug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_project_operation",
      "description": "Its state, result or error, and its progress events, oldest first. Requires project:read.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "operationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug",
          "operationId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "rollback_service",
      "description": "Serves an earlier release again, by default the one before the current one. Migrations are not undone. Answers with the operation. Requires project:write.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "serviceSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "releaseNumber": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug",
          "serviceSlug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "start_service",
      "description": "Starts the serving release again, with the current variables. When manifestPending is true, it restarts every process, as a restart does. Answers with the operation. Requires project:write.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "serviceSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug",
          "serviceSlug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "stop_service",
      "description": "Stops every process after its drain. Its URLs answer 503 until it starts again. Answers with the operation. Requires project:write.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "serviceSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug",
          "serviceSlug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "restart_service",
      "description": "Restarts every process with the current variables. Web processes that allow two copies switch with no downtime. Answers with the operation. Requires project:write.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "serviceSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug",
          "serviceSlug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_database",
      "description": "Its state, its API URL and its publishable key. createRequested is false for a database an import or a restore reserved: they start it themselves, so no create is on the way while its state is creating. Signed-in members also get the anon key. Secret keys are never returned here. Requires project:read.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "pause_database",
      "description": "Stops every service and keeps the data. Its API answers 503 until it resumes. Answers with the operation. Requires project:write.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "resume_database",
      "description": "Starts the paused services with the same data, usually within a minute. Answers with the operation. Requires project:write.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_project_server",
      "description": "The project's own server, if it has one: its state, size, memory, what the project reserves on it, the last step of its creation, the operation working on it, why its last create, delete, sleep or wake failed, and refusals: the error code a sleep or a wake would answer now, or null when an owner may ask it. server is null for a project with no server. sizes are the ones its organization may create, and allowance says how many servers it may have and has. Requires project:read.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_backups",
      "description": "The 100 most recent, newest first, with their state, size and the latest restore check. Requires project:read.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_backup",
      "description": "Its state, its parts with their size and SHA-256, its counts and its latest restore or drill report. A signed-in member also gets restores: every project restored from it and every drill, with their results. A project key gets an empty list there, because it reads only its own project. Requires project:read.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "backupId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug",
          "backupId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_project_import",
      "description": "Where the project came from, the analysis report with blockers apart from warnings, the rehearsal's checks and timings, and whether the copy is still closed. Never the credentials. Requires project:read.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "rehearse_import",
      "description": "Restores the analyzed source into the project's own stack, which stays closed: no public address, no outbound network, no cron launches, no Functions and no SMTP. Then the checks run. The import must be analyzed with no blocker, within 24 hours of its start. Requires owner or maintainer access, or a project key with project:write.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "organizationSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "projectSlug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "organizationSlug",
          "projectSlug"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
