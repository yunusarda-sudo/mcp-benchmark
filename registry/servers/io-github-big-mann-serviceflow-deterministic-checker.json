{
  "$schema": "../schema.json",
  "name": "io.github.Big-mann/serviceflow-deterministic-checker",
  "title": "ServiceFlow Deterministic Checker",
  "category": "Developer Tools & VCS",
  "description": "Deterministic PASS/FAIL deliverable checks with objective evidence and repair instructions.",
  "tools": [
    {
      "name": "sample_deliverable",
      "description": "Run a fixed free demonstration with PASS or one known missing-section defect; rate limited",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string",
            "enum": [
              "pass",
              "defect"
            ]
          }
        }
      }
    },
    {
      "name": "check_deliverable",
      "description": "Deterministic PASS/FAIL deliverable validation with objective evidence and repair instructions; charges exactly $1.00 in Base Sepolia test USDC per completed check",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "deliverable_format": {
            "type": "string",
            "enum": [
              "text",
              "json"
            ]
          },
          "deliverable": {
            "type": "string"
          },
          "schema": {
            "anyOf": [
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          },
          "required_sections": {
            "anyOf": [
              {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "source_text": {
            "type": "string"
          },
          "sources": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "text"
                  ]
                }
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          },
          "evidence_spans": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "source_id": {
                      "type": "string"
                    },
                    "span": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "source_id",
                    "span"
                  ]
                }
              ]
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "span": {
                  "type": "string"
                }
              },
              "required": [
                "source_id",
                "span"
              ]
            }
          },
          "line_items": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "amount": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              },
              "required": [
                "id",
                "amount"
              ]
            }
          },
          "expected_total": {
            "type": [
              "string",
              "number"
            ]
          },
          "urls": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_rules": {
            "type": "object",
            "properties": {
              "check_urls": {
                "type": "boolean"
              },
              "allowed_hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "placeholders": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "forbidden_claims": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "deliverable"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.Big-mann/serviceflow-deterministic-checker",
    "version": "1.0.0",
    "remoteUrl": "https://earnest-creation-production-b041847a.up.railway.app/mcp",
    "publishedAt": "2026-11-23T02:43:44.536936Z",
    "fetchedAt": "2026-11-23T16:50:40.239Z",
    "toolsSha256": "05001c9f5541620dad0d6aef9e54bbddaad4d7efe5176c4d3cb6843c5fcea3a1"
  }
}
