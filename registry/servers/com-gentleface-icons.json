{
  "$schema": "../schema.json",
  "name": "com.gentleface/icons",
  "title": "Gentleface icons",
  "category": "Developer Tools & VCS",
  "description": "Find MIT pixel-aligned icons by meaning; get SVG, React, SwiftUI or Compose code.",
  "repository": "https://github.com/andaja/gentleface-icons",
  "tools": [
    {
      "name": "search_icons",
      "description": "Find icons for a meaning or a UI action (\"delete\", \"turn camera off\", \"invite user\"). Ranked by the same engine as gentleface.com: names, meanings, synonyms and user phrasings, with notes on which icon to prefer. Search once per meaning you need.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "What the icon should mean or do, in plain words"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 8
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_icon",
      "description": "One icon in one style and format, with what it means, which icons to use instead, what it is confused with, file URLs (SVG, PNG 16/32/48), its family and, when it has one, its animated version (motion).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Icon name, kebab-case (from search_icons)"
          },
          "style": {
            "type": "string",
            "enum": [
              "line-round",
              "line-soft",
              "line-sharp",
              "solid-round",
              "solid-soft",
              "solid-sharp"
            ],
            "default": "line-round"
          },
          "format": {
            "type": "string",
            "enum": [
              "svg",
              "react",
              "vue",
              "svelte",
              "img",
              "css",
              "data",
              "sprite",
              "swiftui",
              "compose",
              "android",
              "flutter"
            ],
            "default": "svg"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "get_icons",
      "description": "Up to 30 icons in one style and format in one call: the way to fetch every icon a screen needs once you have picked them.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 30
          },
          "style": {
            "type": "string",
            "enum": [
              "line-round",
              "line-soft",
              "line-sharp",
              "solid-round",
              "solid-soft",
              "solid-sharp"
            ],
            "default": "line-round"
          },
          "format": {
            "type": "string",
            "enum": [
              "svg",
              "react",
              "vue",
              "svelte",
              "img",
              "css",
              "data",
              "sprite",
              "swiftui",
              "compose",
              "android",
              "flutter"
            ],
            "default": "svg"
          }
        },
        "required": [
          "names"
        ]
      }
    },
    {
      "name": "list_categories",
      "description": "The categories of the set, with what each covers and how many icons it has.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_category",
      "description": "Every icon in one category (slug from list_categories), with what each is for.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "slug"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.gentleface/icons",
    "version": "0.7.0",
    "remoteUrl": "https://gentleface.com/mcp",
    "publishedAt": "2026-11-20T13:23:53.950948Z",
    "fetchedAt": "2026-11-22T12:49:37.224Z",
    "toolsSha256": "59453d8a03d25877b3e4abed930efc2eb72472c17500855b810564f1fd680da8"
  }
}
