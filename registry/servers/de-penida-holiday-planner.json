          },
          "slug": {
            "description": "Exakter Slug, z.B. 'kelingking-secret-view'.",
            "type": "string",
            "maxLength": 120
          },
          "query": {
            "description": "Alternativ: Namenssuche, wenn der Slug unbekannt ist.",
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "category"
        ]
      }
    },
    {
      "name": "check_travel_conditions",
      "description": "Prüft für einen Zeitraum die Überfahrtsbedingungen nach Nusa Penida: Wellenhöhe und Wind in der Badung-Straße, Wetter auf der Insel sowie Zeremonien, Feiertage (z.B. Nyepi) und Reisewarnungen. Datenquellen: Open-Meteo (frei) und die penida.de-Eventdatenbank.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "from_date": {
            "description": "Startdatum (default heute).",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "days": {
            "description": "Anzahl Tage der Vorschau (1-14, default 7).",
            "type": "integer",
            "minimum": 1,
            "maximum": 14
          }
        }
      }
    }
