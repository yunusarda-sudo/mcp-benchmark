    {
      "name": "subscribe_newsletter",
      "description": "Trägt eine E-Mail-Adresse in den penida.de-Newsletter ein (deutschsprachige Reise-Updates zu Nusa Penida). Nutze diesen Tool NUR mit ausdrücklicher Zustimmung des Endnutzers.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "source": {
            "description": "Herkunft/Kanal, z.B. 'chatgpt', 'claude'.",
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "language": {
            "type": "string",
            "enum": [
              "de",
              "en"
            ]
          },
          "user_consent": {
            "type": "boolean",
            "const": true,
            "description": "Muss true sein — bestätigt die ausdrückliche Zustimmung des Endnutzers."
          }
        },
        "required": [
          "email",
          "user_consent"
        ]
      }
    },
    {
      "name": "plan_trip",
      "description": "Erstellt einen Tagesplan für Nusa Penida (1–7 Tage) inklusive Fähre, Unterkunft, Touren und Sehenswürdigkeiten – mit Preisen und Quell-URLs auf penida.de.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7,
            "description": "Aufenthaltsdauer in Tagen (1-7)."
          },
          "budget": {
            "description": "Budgetniveau, default 'mid'.",
            "type": "string",
            "enum": [
              "low",
              "mid",
              "high"
            ]
          },
          "interests": {
            "description": "Interessen zur Gewichtung der Touren.",
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "strand",
                "schnorcheln",
                "tauchen",
                "kultur",
                "wandern",
                "fotografie"
              ]
            }
          },
          "from_location": {
            "description": "Abfahrtsort auf Bali, z.B. 'Sanur'.",
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "days"
        ]
      }
    },
    {
      "name": "get_best_price",
      "description": "Liefert für ein Hotel, eine Tour oder eine Fähre den günstigsten bekannten Preis über alle Partnerplattformen (Booking, Agoda, GetYourGuide, Viator, Klook) inklusive Quell-URL.",
