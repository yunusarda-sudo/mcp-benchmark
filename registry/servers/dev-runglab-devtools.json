{
  "$schema": "../schema.json",
  "name": "dev.runglab/devtools",
  "title": "RungLab DevTools MCP",
  "category": "Security & Identity",
  "description": "Free domain/AEO, AI Act 50, OpenAPI, SBOM, PCI, headers, MCPDiet, SPF/DMARC & SPDX audits.",
  "tools": [
    {
      "name": "audit_domain_readiness",
      "description": "Audit a public domain for AI search (AEO), SPF/DMARC email, and security headers via ReadyCheck.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 3,
            "maxLength": 253,
            "description": "Public hostname or URL to audit (e.g. stripe.com)."
          },
          "refresh": {
            "type": "boolean",
            "description": "Bypass 10-minute edge cache when true."
          }
        },
        "required": [
          "domain"
        ]
      }
    },
    {
      "name": "profile_mcp_tools",
      "description": "Analyze MCP tool schemas for pre-prompt token cost ($4.50/1M), bloat, and schema hygiene.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tools": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "description": "Array of MCP tool objects from tools/list.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "title": {
                  "type": "string",
                  "maxLength": 128
                },
                "description": {
                  "type": "string",
                  "maxLength": 8000
                },
                "inputSchema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "outputSchema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "annotations": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "turnsPerDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "description": "Daily turns for monthly cost estimate (default 1000)."
          }
        },
        "required": [
          "tools"
        ]
      }
    },
    {
      "name": "check_spf_dmarc_syntax",
      "description": "Validate RFC 7208 SPF and RFC 7489 DMARC TXT records for 10-lookup limits and PermError risks.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "spf": {
            "type": "string",
            "maxLength": 2048,
            "description": "Raw SPF TXT record(s) (e.g. v=spf1 include:_spf.google.com ~all)."
          },
          "dmarc": {
            "type": "string",
            "maxLength": 2048,
            "description": "Raw DMARC TXT record (e.g. v=DMARC1; p=quarantine; rua=mailto:sec@example.com)."
          },
          "domain": {
            "type": "string",
            "maxLength": 253,
            "description": "Optional domain label for tailored fix advice."
          }
        }
      }
    },
    {
      "name": "check_spdx_license_pair",
      "description": "Check directional SPDX license compatibility when adding a dependency to a host project.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dependencyLicense": {
            "type": "string",
            "enum": [
              "MIT",
              "Apache-2.0",
              "BSD-3-Clause",
              "ISC",
              "MPL-2.0",
              "LGPL-3.0-only",
              "GPL-3.0-only",
              "AGPL-3.0-only",
              "Proprietary",
              "BSL-1.1"
            ],
            "description": "SPDX license ID of the third-party dependency."
          },
          "projectLicense": {
            "type": "string",
            "enum": [
              "MIT",
              "Apache-2.0",
              "BSD-3-Clause",
              "ISC",
              "MPL-2.0",
              "LGPL-3.0-only",
              "GPL-3.0-only",
              "AGPL-3.0-only",
              "Proprietary",
              "BSL-1.1"
            ],
            "description": "SPDX license ID of the host project."
          }
        },
        "required": [
          "dependencyLicense",
          "projectLicense"
        ]
      }
    },
    {
      "name": "audit_openapi_spec",
      "description": "Audit JSON OpenAPI 2.0/3.0/3.1 specs for OWASP API security hygiene and MCP/LLM token footprint.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "spec": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200000,
            "description": "Raw JSON OpenAPI 2.0, 3.0, or 3.1 document."
          },
          "maxIssues": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Max prioritized findings returned (1-50, default 20)."
          }
        },
        "required": [
          "spec"
        ]
      }
    },
    {
      "name": "check_security_headers",
      "description": "Audit HTTP response headers for HSTS/CSP/CORS flaws and generate stack-specific hardened snippets.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "headersText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000,
            "description": "Raw HTTP response headers (Header-Name: value per line)."
          },
          "targetStack": {
            "type": "string",
            "enum": [
              "cloudflare",
              "nginx",
              "vercel",
              "nextjs",
              "generic"
            ],
            "description": "Target stack for hardened snippet (default generic)."
          }
        },
        "required": [
          "headersText"
        ]
      }
    },
    {
      "name": "audit_sbom_manifest",
      "description": "Audit package.json, requirements.txt, go.mod, CycloneDX, or SPDX manifests for pinning, copyleft risk & readiness.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "manifest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000,
            "description": "Raw text of package.json, requirements.txt, go.mod, or CycloneDX/SPDX JSON."
          },
          "distribution": {
            "type": "string",
            "enum": [
              "saas",
              "distributed",
              "proprietary"
            ],
            "default": "saas",
            "description": "Software distribution model for copyleft risk (default saas)."
          },
          "format": {
            "type": "string",
            "enum": [
              "auto",
              "package.json",
              "requirements.txt",
              "go.mod",
              "cyclonedx",
              "spdx"
            ],
            "default": "auto",
            "description": "Manifest format override (default auto)."
          }
        },
        "required": [
          "manifest"
        ]
      }
    },
    {
      "name": "audit_checkout_pci_html",
      "description": "Audit checkout HTML for PCI DSS 4.0.1 Req 6.4.3/11.6.1 scripts, SRI, trackers, CSP & SAQ scope.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "html": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256000,
            "description": "Checkout HTML or <head>/<body> snippet (max 256 KB)."
          },
          "pageUrl": {
            "type": "string",
            "maxLength": 2048,
            "description": "Page URL for resolving relative script/form/iframe origins."
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 8192
            },
            "description": "Optional HTTP response headers (CSP, HSTS, X-Frame-Options, etc.)."
          }
        },
        "required": [
          "html"
        ]
      }
    },
    {
      "name": "audit_ai_transparency_html",
      "description": "Audit HTML/headers for EU AI Act Art. 50 AI widgets, disclosure links, C2PA provenance & TDM tags.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "html": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256000,
            "description": "Page HTML snapshot (max 256 KB)."
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "description": "Page URL for resolving links and origin."
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 8192
            },
            "description": "Optional HTTP headers (X-AI-Generated, Content-Signal, HSTS)."
          }
        },
        "required": [
          "html"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "dev.runglab/devtools",
    "version": "1.4.0",
    "remoteUrl": "https://mcp-server.runglab.dev/mcp",
    "publishedAt": "2026-11-27T07:26:50.206443Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
