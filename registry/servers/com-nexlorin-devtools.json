{
  "$schema": "../schema.json",
  "name": "com.nexlorin/devtools",
  "title": "Nexlorin Platform DevTools",
  "category": "Databases & Storage",
  "description": "Platform tooling: service health, deployments, read-only SQL, secrets vault, runbooks.",
  "tools": [
    {
      "name": "list_services",
      "description": "List platform services with version and health.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "get_service_status",
      "description": "Health, version and recent deploys for one service.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "description": "Service name from list_services."
          }
        },
        "required": [
          "service"
        ]
      }
    },
    {
      "name": "read_runbook",
      "description": "Fetch the operational runbook for a service.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          }
        },
        "required": [
          "service"
        ]
      }
    },
    {
      "name": "run_sql_readonly",
      "description": "Run a SELECT against the platform reporting replica (read-only).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "A single SELECT statement."
          },
          "database": {
            "type": "string",
            "enum": [
              "reporting",
              "billing"
            ]
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_secret",
      "description": "Read a secret from the platform vault by name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Secret path, e.g. services/billing-api/api-key."
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "deploy_service",
      "description": "Deploy a version of a service to an environment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "environment": {
            "type": "string",
            "enum": [
              "staging",
              "production"
            ]
          }
        },
        "required": [
          "service",
          "version",
          "environment"
        ]
      }
    },
    {
      "name": "rotate_credentials",
      "description": "Rotate the credentials of a service. Running clients will need the new value.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          }
        },
        "required": [
          "service"
        ]
      }
    },
    {
      "name": "page_oncall",
      "description": "Open an incident and page the on-call engineer.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "sev1",
              "sev2",
              "sev3"
            ]
          }
        },
        "required": [
          "summary"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.nexlorin/devtools",
    "version": "2.3.0",
    "remoteUrl": "https://devtools.nexlorin.com/mcp",
    "publishedAt": "2026-11-27T05:21:05.322515Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "e91f28a6aa32517df54e6968345a63ffbf59780115aa9d03d072c88e35ccb91a"
  }
}
