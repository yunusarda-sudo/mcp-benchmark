{
  "$schema": "../schema.json",
  "name": "Discord MCP",
  "category": "Communication & Alerting",
  "description": "Discord MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "send_channel_message",
      "description": "Publish message into a Discord text channel via bot client.",
      "inputSchema": {
        "type": "object",
        "required": [
          "channelId",
          "content"
        ],
        "properties": {
          "channelId": {
            "type": "string",
            "description": "Discord snowflake channel ID."
          },
          "content": {
            "type": "string",
            "description": "Text message content."
          }
        }
      }
    }
  ]
}
