{
  "$schema": "../schema.json",
  "name": "com.picktimeapp/booking",
  "title": "Booking for agents",
  "category": "AI, LLMs & Agents",
  "description": "Calendly for AI agents: booking pages for the person you work for. It sends no email; you do.",
  "tools": [
    {
      "name": "create_key",
      "description": "Get an API key (no email, no human). Put it in the Authorization header as 'Bearer <key>'.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Your agent's name, for your own reference",
            "examples": [
              "my-assistant"
            ],
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      }
    },
    {
      "name": "list_owners",
      "description": "List the owners this key manages.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "create_owner",
      "description": "Create an owner: the person whose booking pages these are.",
      "inputSchema": {
        "$defs": {
          "Hours": {
            "additionalProperties": false,
            "properties": {
              "weekly": {
                "additionalProperties": {
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "string"
                      }
                    ],
                    "type": "array"
                  },
                  "type": "array"
                },
                "description": "Wall-clock ranges in the owner's zone, like {\"mon\": [[\"09:00\", \"17:00\"]]}",
                "propertyNames": {
                  "enum": [
                    "mon",
                    "tue",
                    "wed",
                    "thu",
                    "fri",
                    "sat",
                    "sun"
                  ]
                },
                "title": "Weekly",
                "type": "object"
              },
              "exceptions": {
                "additionalProperties": {
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "string"
                      }
                    ],
                    "type": "array"
                  },
                  "type": "array"
                },
                "description": "Dates (YYYY-MM-DD) with other hours; an empty list closes the day",
                "title": "Exceptions",
                "type": "object"
              }
            },
            "title": "Hours",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "handle": {
            "description": "The owner's address: https://ai.picktimeapp.com/<handle>",
            "examples": [
              "bree"
            ],
            "title": "Handle",
            "type": "string"
          },
          "name": {
            "description": "Shown on the owner's pages",
            "examples": [
              "Bree's Suits"
            ],
            "title": "Name",
            "type": "string"
          },
          "time_zone": {
            "description": "IANA time zone; hours are read in it",
            "examples": [
              "America/Phoenix"
            ],
            "title": "Time Zone",
            "type": "string"
          },
          "intro": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "A sentence or two for the owner's page",
            "title": "Intro"
          },
          "hours": {
            "anyOf": [
              {
                "$ref": "#/$defs/Hours"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "handle",
          "name",
          "time_zone"
        ],
        "type": "object"
      }
    },
