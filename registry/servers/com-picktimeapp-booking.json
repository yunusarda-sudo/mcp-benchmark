    {
      "name": "create_page",
      "description": "Create a booking page (a kind of meeting): length, custom fields, places per time, holds.",
      "inputSchema": {
        "$defs": {
          "ContactRules": {
            "additionalProperties": false,
            "properties": {
              "email": {
                "default": "required",
                "enum": [
                  "required",
                  "optional",
                  "off"
                ],
                "title": "Email",
                "type": "string"
              },
              "phone": {
                "default": "optional",
                "enum": [
                  "required",
                  "optional",
                  "off"
                ],
                "title": "Phone",
                "type": "string"
              }
            },
            "title": "ContactRules",
            "type": "object"
          },
          "Hours": {
            "additionalProperties": false,
            "properties": {
              "weekly": {
                "additionalProperties": {
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "string"
                      }
                    ],
                    "type": "array"
                  },
                  "type": "array"
                },
                "description": "Wall-clock ranges in the owner's zone, like {\"mon\": [[\"09:00\", \"17:00\"]]}",
                "propertyNames": {
                  "enum": [
                    "mon",
                    "tue",
                    "wed",
                    "thu",
                    "fri",
                    "sat",
                    "sun"
                  ]
                },
                "title": "Weekly",
                "type": "object"
              },
              "exceptions": {
                "additionalProperties": {
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "string"
                      }
                    ],
                    "type": "array"
                  },
                  "type": "array"
                },
                "description": "Dates (YYYY-MM-DD) with other hours; an empty list closes the day",
                "title": "Exceptions",
                "type": "object"
              }
            },
            "title": "Hours",
            "type": "object"
          },
          "PageField": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "description": "Key of the answer, like show_date",
                "title": "Id",
                "type": "string"
              },
              "label": {
                "title": "Label",
                "type": "string"
              },
              "type": {
                "default": "text",
                "enum": [
                  "text",
                  "long_text",
                  "number",
                  "date",
                  "choice",
                  "choices",
                  "yes_no"
                ],
                "title": "Type",
                "type": "string"
              },
              "required": {
                "default": false,
                "title": "Required",
                "type": "boolean"
              },
              "help": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Help"
              },
              "options": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "For choice and choices",
                "title": "Options"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "title": "PageField",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "handle": {
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Description"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Text: an address, 'I will call you', a video link",
            "title": "Location"
          },
          "minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Length of one booking",
            "title": "Minutes"
          },
          "step_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Gap between start times; defaults to minutes",
            "title": "Step Minutes"
          },
          "buffer_before": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Buffer Before"
          },
          "buffer_after": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Buffer After"
          },
          "min_notice_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "No booking sooner than this from now (default 240)",
            "title": "Min Notice Minutes"
          },
          "days_ahead": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "How far ahead it takes bookings (default 60)",
            "title": "Days Ahead"
          },
          "seats": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Places per time; above 1 makes a group session",
            "title": "Seats"
          },
          "confirm": {
            "anyOf": [
              {
                "enum": [
                  "auto",
                  "agent"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "auto: final at once. agent: held as 'requested' until you confirm it",
            "title": "Confirm"
          },
          "hold_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "How long a requested booking holds its time (default 60)",
            "title": "Hold Minutes"
          },
          "cancel_cutoff_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Clients can't cancel or move later than this before the start (default 60)",
            "title": "Cancel Cutoff Minutes"
          },
          "contact": {
            "anyOf": [
              {
                "$ref": "#/$defs/ContactRules"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/PageField"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Fields"
          },
          "hours": {
            "anyOf": [
              {
                "$ref": "#/$defs/Hours"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The page's own hours; null uses the owner's"
          },
          "listed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Shown on the owner's page (true) or by link only",
            "title": "Listed"
          },
          "active": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "false switches the page off",
            "title": "Active"
          },
          "slug": {
            "description": "https://ai.picktimeapp.com/<handle>/<slug>",
            "examples": [
              "fitting"
            ],
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "handle",
          "title",
          "slug"
        ],
        "type": "object"
      }
    },
