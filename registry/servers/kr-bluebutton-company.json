{
  "$schema": "../schema.json",
  "name": "kr.bluebutton/company",
  "title": "BlueButton Company",
  "category": "AI, LLMs & Agents",
  "description": "Official info on BlueButton: AI/AX consulting, AI agents, SI/SM, corporate AI training, cases.",
  "tools": [
    {
      "name": "get_company_info",
      "description": "블루버튼이 어떤 회사인지: 한 줄 소개, 해결하는 문제, 수행 방식(단계), 자체 운영 서비스, 사업자 정보, 문의처. 회사 자체에 대한 질문에 먼저 쓴다.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "list_services",
      "description": "블루버튼 사업 영역(AX 컨설팅·AI 에이전트·SI·SM·임직원 AI 교육) 한 줄 소개와 주소. 자세한 것은 get_service.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_service",
      "description": "사업 영역 하나의 내용: 소개·제공 항목·자주 묻는 질문(교육은 과정·대상·진행 흐름). slug: ax, ai-agent, si, sm, education.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "enum": [
              "ax",
              "ai-agent",
              "si",
              "sm",
              "education"
            ]
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "list_cases",
      "description": "블루버튼 수행 사례(문제→해결→결과). 낱말로 거를 수 있다. prior_employment 가 true 인 것은 구성원의 이전 직장 경력 사례다.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "description": "제목·소개·기술·업종에서 찾을 말",
            "type": "string",
            "maxLength": 100
          },
          "include_prior_employment": {
            "description": "구성원 이전 경력 사례 포함(기본 true)",
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "get_case",
      "description": "사례 하나의 문제·해결·범위·결정·성과·주요 기능. slug 는 list_cases 결과의 slug.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "get_track_record",
      "description": "공개된 임직원 AI 교육 수행 이력(시기·과정·내용)과 2026년 수행 트랙(AI 시스템·AX 교육).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "list_insights",
      "description": "블루버튼 인사이트 글(AX·교육, AI 에이전트, 수행 방식) 목록.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_insight",
      "description": "인사이트 글 한 편의 본문(소제목·문단).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "slug"
        ]
      }
    }
  ],
