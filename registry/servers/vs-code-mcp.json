{
  "$schema": "../schema.json",
  "name": "VS Code MCP",
  "category": "Developer Tools & VCS",
  "description": "VS Code MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "open_document",
      "description": "Open a file in VS Code editor at the specified line and column.",
      "inputSchema": {
        "type": "object",
        "required": [
          "filePath"
        ],
        "properties": {
          "filePath": {
            "type": "string",
            "description": "File path to open."
          },
          "line": {
            "type": "integer",
            "description": "Target 1-based line number."
          },
          "column": {
            "type": "integer",
            "description": "Target 1-based column number."
          }
        }
      }
    }
  ]
}
