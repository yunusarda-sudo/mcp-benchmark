          "state_code": {
            "description": "2-letter US state or DC code.",
            "type": "string"
          },
          "table_style": {
            "description": "Line items and rent schedule table style (standard, minimal_lines, bordered_ledger, modern_cards, compact_mono).",
            "type": "string"
          },
          "tax_rate": {
