    {
      "name": "calculate_totals",
      "description": "Compute subtotal, tax, discount, grand total, and balance due from document items. Stateless.",
      "inputSchema": {
        "examples": [
          {
            "document": {
              "items": [
                {
                  "description": "Service",
                  "quantity": 2,
                  "unit_price": 50
                }
              ]
            }
          }
        ],
        "properties": {
          "document": {
            "description": "Document JSON with items, tax_rate, discount_amount, and optional amount_paid.",
            "type": "object"
          }
        },
        "required": [
          "document"
        ],
        "type": "object"
      }
    },
    {
      "name": "convert_document",
      "description": "Convert document details to an invoice, estimate, receipt, credit note, or refund PDF. HTTP calls can return a temporary download link.",
      "inputSchema": {
        "examples": [
          {
            "document": {
              "doc_type": "estimate",
              "from": {
                "name": "Acme"
              },
              "to": {
                "name": "Client"
              }
            },
            "target_type": "invoice"
          }
        ],
        "properties": {
          "credit_reason": {
            "description": "Credit note or refund reason.",
            "type": "string"
          },
          "document": {
            "description": "Stateless input document JSON payload to transform.",
            "type": "object"
          },
          "due_days": {
            "description": "Days until payment due.",
            "type": "integer"
          },
          "payment_link": {
            "description": "HTTPS link supplied by the user to include in the document.",
            "type": "string"
          },
          "payment_qr_code": {
            "description": "Embed SVG vector QR code.",
            "type": "boolean"
          },
          "target_type": {
            "description": "Target type (invoice, receipt, estimate, credit_note, refund).",
            "enum": [
              "invoice",
              "receipt",
              "estimate",
              "credit_note",
              "refund"
            ],
            "type": "string"
          }
        },
        "required": [
          "document",
          "target_type"
        ],
        "type": "object"
      }
    },
    {
      "name": "record_payment",
      "description": "Create a receipt or updated invoice from supplied payment details. Does not charge or verify payment. HTTP calls can return a temporary download link.",
      "inputSchema": {
        "examples": [
          {
            "amount_paid": 100,
            "document": {
              "doc_type": "invoice",
              "from": {
                "name": "Acme"
              },
              "to": {
                "name": "Client"
              }
            }
          }
        ],
        "properties": {
          "amount_paid": {
            "description": "Amount paid toward balance.",
            "type": "number"
          },
          "document": {
            "description": "Stateless input invoice JSON payload.",
            "type": "object"
          },
          "paid_date": {
            "description": "Payment date (YYYY-MM-DD).",
            "type": "string"
          },
          "payment_method": {
            "description": "Payment method (Stripe, Apple Pay, Wire).",
            "type": "string"
          },
          "transaction_reference": {
            "description": "Transaction reference ID.",
            "type": "string"
          }
        },
        "required": [
          "document"
        ],
        "type": "object"
      }
    },
    {
      "name": "submit_feedback",
      "description": "Send a bug report, feature request, or general feedback to the private Pressmark inbox when the user asks. Include only details they choose to share; omit documents, passwords, and tokens.",
      "inputSchema": {
        "additionalProperties": false,
        "examples": [
          {
            "description": "When exporting with custom font tokens, preview returns fallback styling.",
            "kind": "bug",
            "request_id": "a0000000-0000-0000-0000-000000000001",
            "summary": "Preview rendering error on custom font"
          }
        ],
        "properties": {
          "actual": {
            "maxLength": 1500,
            "type": "string"
          },
          "description": {
            "maxLength": 6000,
            "minLength": 1,
            "type": "string"
          },
          "expected": {
            "maxLength": 1500,
            "type": "string"
          },
          "kind": {
            "enum": [
              "bug",
              "feature",
              "general"
            ],
            "type": "string"
          },
          "reply_email": {
            "description": "Optional email supplied by the user for feedback follow-up.",
            "maxLength": 254,
            "type": "string"
          },
          "request_id": {
            "description": "A new UUID for this report. Reuse it when retrying unchanged feedback.",
            "format": "uuid",
            "type": "string"
          },
          "steps": {
            "maxLength": 3000,
            "type": "string"
          },
          "summary": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "maxLength": 80,
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "kind",
          "summary",
          "description"
        ],
        "type": "object"
      }
    },
    {
      "name": "get_feedback_status",
      "description": "Check one Pressmark report using its report ID and private access key. Returns its review status without exposing the report text or contact details.",
      "inputSchema": {
        "additionalProperties": false,
        "examples": [
          {
            "access_key": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "report_id": "a0000000-0000-0000-0000-000000000001"
          }
        ],
        "properties": {
          "access_key": {
            "maxLength": 64,
            "minLength": 64,
            "type": "string"
          },
          "report_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "report_id",
          "access_key"
        ],
        "type": "object"
      }
    }
