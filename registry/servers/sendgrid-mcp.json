{
  "$schema": "../schema.json",
  "name": "SendGrid MCP",
  "category": "Communication & Alerting",
  "description": "SendGrid MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "send_email",
      "description": "Deliver transactional email via SendGrid API with HTML template support.",
      "inputSchema": {
        "type": "object",
        "required": [
          "to",
          "subject",
          "html"
        ],
        "properties": {
          "to": {
            "type": "string",
            "description": "Recipient email address."
          },
          "subject": {
            "type": "string",
            "description": "Email subject line."
          },
          "html": {
            "type": "string",
            "description": "Email HTML body content."
          }
        }
      }
    }
  ]
}
