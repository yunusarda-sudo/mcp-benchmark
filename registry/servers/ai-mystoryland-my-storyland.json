{
  "$schema": "../schema.json",
  "name": "ai.mystoryland/my-storyland",
  "title": "My Storyland: Books and Travel",
  "category": "Travel, Maps & Navigation",
  "description": "Find places behind a book, grouped by region. View a route on a map and divide its stops into days.",
  "tools": [
    {
      "name": "search_book_places",
      "description": "Use when asked for places behind a book or a map of them. Takes a book title and optional author; returns regions, estimated trip days, cities with countries, highlights, and a link to the book's map on mystoryland.ai.",
      "inputSchema": {
        "properties": {
          "title": {
            "title": "Title",
            "type": "string"
          },
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Author"
          }
        },
        "required": [
          "title"
        ],
        "type": "object",
        "title": "search_book_placesArguments"
      }
    },
    {
      "name": "get_literary_route",
      "description": "Use when asked for a book route, stops, or itinerary. Takes a book title with optional author and region, or a public mystoryland.ai/i/ link alone. Returns stops by city in order, book connections, and a link. If region choices are returned, ask the reader to choose one and call again.",
