              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Permalink"
          }
        },
        "type": "object",
        "title": "get_literary_routeArguments"
      }
    },
    {
      "name": "plan_trip",
      "description": "Use when asked to plan a trip around a book. Takes days, pace, optional start, and a book title with optional author and region, or a public mystoryland.ai/i/ link. Returns a day-by-day plan of stops and a link. If region choices are returned, ask the reader to choose one and call again.",
