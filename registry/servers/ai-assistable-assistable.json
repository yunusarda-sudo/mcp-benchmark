    {
      "name": "tools_list",
      "description": "List tools visible to a subaccount. Pass includePrebuilt=false for only custom tools.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "subAccountId": {
            "type": "string"
