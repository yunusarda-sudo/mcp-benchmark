{
  "$schema": "../schema.json",
  "name": "ai.assistable/assistable",
  "title": "Assistable",
  "category": "Other",
  "description": "Give any AI agent a phone: make and answer calls, get through phone menus, and send texts.",
  "tools": [
    {
      "name": "search_tools",
      "description": "Search Assistable's registered MCP tools by the task the user wants to do. Returns up to 5 exact tool definitions with JSON input schemas and annotations. Use this first when you need to choose a tool; the result is not authorization to call it.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 240,
            "description": "A short description of the task or capability needed."
          },
          "limit": {
            "description": "How many matching tools to return. Defaults to 5.",
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "assistants_list",
      "description": "List assistants in a subaccount (excludes archived by default). Note: voice_settings and platform_tools are returned only by assistants_get, not in the list.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "subAccountId": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string"
          },
          "includeArchived": {
            "type": "boolean"
          }
        },
        "required": [
          "subAccountId"
        ]
      }
    },
    {
      "name": "assistants_get",
      "description": "Fetch an assistant's full configuration by ID. The response includes voice_settings (greeting mode, opening messages, voicemail) and platform_tools (attached platform-catalog tool names).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "assistantId": {
            "type": "string"
          }
        },
        "required": [
          "assistantId"
        ]
      }
    },
    {
      "name": "assistants_create",
      "description": "Create an assistant. Required: name and a subaccount selected by subAccountId, subaccount_id, location_id, or the request header/key scope (an explicit selector on the call takes precedence over the connection default and is authorized against the key). llmConfig supports prompt, model, temperature (0–2); voiceId and assistantType are aliases for voice_id and assistant_type. Flat v3 fields are also accepted; conflicting aliases are rejected. voiceConfig/chatConfig records and unknown llmConfig keys are unsupported and return errors. Use voice_settings or flat inbound_greeting/outbound_greeting for greetings; platform_tools declaratively replaces platform-catalog attachments.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Display name for the assistant."
          },
          "description": {
            "type": "string"
          },
          "prompt": {
            "description": "System prompt. If omitted, a minimal default prompt is generated from the name.",
            "type": "string"
          },
          "model": {
            "description": "LLM model. Defaults to KIMI_K2_6 when omitted.",
            "type": "string",
            "enum": [
              "QWEN_3_235B_A22B",
              "GPT_6_LUNA",
              "GPT_5_6_LUNA",
              "GPT_5_4",
              "GPT_5_2",
              "GPT_5_1",
              "GPT_5",
              "GPT_5_MINI",
              "GPT_5_NANO",
              "GPT_4_1",
              "GPT_4_1_MINI",
              "GPT_4_1_NANO",
              "GPT_4O",
              "GPT_4O_MINI",
              "GPT_4_TURBO",
              "GPT_4",
              "GPT_3_5_TURBO",
              "CLAUDE_4_1_OPUS",
              "CLAUDE_4_SONNET",
              "CLAUDE_3_7_SONNET",
              "CLAUDE_HAIKU_5_5",
              "CLAUDE_HAIKU_4_5",
              "CLAUDE_3_5_HAIKU",
              "CLAUDE_3_SONNET",
              "CLAUDE_3_HAIKU",
              "GEMINI_2_5_FLASH",
              "GEMINI_2_0_FLASH",
              "GEMINI_2_0_FLASH_LITE",
              "KIMI_K2_5",
              "KIMI_K2_6",
              "GLM_5_2",
              "GLM_5_3_FLASH",
              "CUSTOM"
            ]
          },
          "temperature": {
            "description": "Sampling temperature 0–2 (default 0).",
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "voice_id": {
            "description": "Voice PK (the `id` from GET /v3/voices). Defaults to the system default voice when omitted.",
            "type": "string"
          },
          "assistant_type": {
            "type": "string",
            "enum": [
              "STANDARD",
              "FLOW_BUILDER"
            ],
            "description": "Assistant type. STANDARD (default) is a prompt-driven assistant; FLOW_BUILDER is node/flow driven."
          },
          "language": {
            "description": "BCP-47 language code (default 'en').",
            "type": "string"
          },
          "voice_enabled": {
            "description": "Whether voice calling is enabled (default true).",
            "type": "boolean"
          },
          "inbound_greeting": {
            "type": "string"
          },
          "outbound_greeting": {
            "type": "string"
          },
          "platform_tools": {
            "description": "Platform tool names to attach, e.g. [\"book_appointment\", \"send_email\"]. Declarative within the platform catalog: tools in the list are attached, catalog tools missing from the list are detached, custom tools are never touched. Omit for no change; [] detaches all platform tools. See GET /v3/tools for the catalog; custom tools attach via POST /v3/tools/{id}/assign.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "voice_settings": {
            "type": "object",
            "properties": {
              "greeting_mode": {
                "description": "How the assistant opens a call: `dynamic` (AI-generated opener; default), `fixed` (speaks the configured opening message verbatim), or `contact_first` (stays silent until the contact speaks).",
                "type": "string",
                "enum": [
                  "dynamic",
                  "fixed",
                  "contact_first"
                ]
              },
              "inbound_opening_message": {
                "description": "Spoken opener for inbound calls. Only valid in `fixed` greeting mode. Template variables (e.g. a contact first-name placeholder) are allowed and resolve per call. `null` clears this direction.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outbound_opening_message": {
                "description": "Spoken opener for outbound calls. Only valid in `fixed` greeting mode. Template variables are allowed and resolve per call. `null` clears this direction.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "voicemail_message": {
                "description": "Played when voicemail is detected, after which the assistant stops. Empty or `null` means the assistant hangs up on voicemail instead.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "enable_voicemail_detection": {
                "description": "Records intent only: persisted and returned on read, but voicemail detection is currently platform-managed and this flag does not yet gate runtime behavior.",
                "type": "boolean"
              }
            }
          },
          "subaccount_id": {
            "description": "Target subaccount id. Prefer the X-Subaccount-Id header; this body field is a fallback.",
            "type": "string"
          },
          "location_id": {
            "description": "Alias for subaccount_id (GHL location id).",
            "type": "string"
          },
          "subAccountId": {
            "description": "Target subaccount id. Prefer the X-Subaccount-Id header; this body field is a fallback.",
            "type": "string"
          },
          "voiceId": {
            "anyOf": [
              {
                "description": "Voice PK (the `id` from GET /v3/voices). Defaults to the system default voice when omitted.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "assistantType": {
            "type": "string",
            "enum": [
              "STANDARD",
              "FLOW_BUILDER"
            ],
            "description": "Assistant type. STANDARD (default) is a prompt-driven assistant; FLOW_BUILDER is node/flow driven."
          },
          "llmConfig": {
            "type": "object",
            "properties": {
              "prompt": {
                "type": "string"
              },
              "model": {
                "type": "string",
                "enum": [
                  "QWEN_3_235B_A22B",
                  "GPT_6_LUNA",
                  "GPT_5_6_LUNA",
                  "GPT_5_4",
                  "GPT_5_2",
                  "GPT_5_1",
                  "GPT_5",
                  "GPT_5_MINI",
                  "GPT_5_NANO",
                  "GPT_4_1",
                  "GPT_4_1_MINI",
                  "GPT_4_1_NANO",
                  "GPT_4O",
                  "GPT_4O_MINI",
                  "GPT_4_TURBO",
                  "GPT_4",
                  "GPT_3_5_TURBO",
                  "CLAUDE_4_1_OPUS",
                  "CLAUDE_4_SONNET",
                  "CLAUDE_3_7_SONNET",
                  "CLAUDE_HAIKU_5_5",
                  "CLAUDE_HAIKU_4_5",
                  "CLAUDE_3_5_HAIKU",
                  "CLAUDE_3_SONNET",
                  "CLAUDE_3_HAIKU",
                  "GEMINI_2_5_FLASH",
                  "GEMINI_2_0_FLASH",
                  "GEMINI_2_0_FLASH_LITE",
                  "KIMI_K2_5",
                  "KIMI_K2_6",
                  "GLM_5_2",
                  "GLM_5_3_FLASH",
                  "CUSTOM"
                ],
                "description": "LLM model, one of the AIModel enum values (e.g. KIMI_K2_6 — the default, GPT_5_6_LUNA, GPT_5, CLAUDE_4_SONNET, GEMINI_2_5_FLASH). Resolved to the provider model at agent-sync time."
              },
              "temperature": {
                "description": "Sampling temperature 0–2 (default 0).",
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            },
            "additionalProperties": false
          },
          "voiceConfig": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "chatConfig": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "assistants_update",
      "description": "Patch an assistant. Only supplied fields change, including individual llmConfig prompt/model/temperature keys; temperature must be 0–2. Flat v3 fields and the voiceId/assistantType/subAccountId aliases are accepted; conflicting aliases are rejected; an explicit subaccount selector on the call takes precedence over the connection default and is authorized against the key. voiceConfig/chatConfig records and unknown llmConfig keys are unsupported and return errors. Use voice_settings or flat inbound_greeting/outbound_greeting for greetings; platform_tools declaratively replaces platform-catalog attachments ([] detaches all).",
