{
  "$schema": "../schema.json",
  "name": "cc.partyworld/party",
  "title": "Party (BachWknd)",
  "category": "Design, UI & 3D Media",
  "description": "Map-first group weekend & party planner across 31 cities. Build itineraries, split costs & invite.",
  "tools": [
    {
      "name": "bachwknd.cities.list",
      "description": "Curated cities with pre-loaded spots. Use geo in later calls.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "bachwknd.destinations.search",
      "description": "Search any city or destination worldwide (curated or geocoded). Use the returned geo in bachwknd.party.create.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "City or region name, e.g. Austin or Scottsdale."
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "bachwknd.places.search",
      "description": "Search the public directory for spots in one city. Use the returned id in bachwknd.plan.set.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "geo": {
            "type": "string",
            "description": "City id from bachwknd.cities.list, such as nashville-tn."
          },
          "q": {
            "type": "string",
            "description": "Optional name or vibe search."
          },
          "category": {
            "type": "string",
            "enum": [
              "food",
              "drink",
              "stay",
              "spa",
              "shows",
              "boats",
              "buses",
              "parks",
              "airports"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        },
        "required": [
          "geo"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "bachwknd.parties.list",
      "description": "List all parties the signed-in host created or belongs to, with site URLs.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "bachwknd.party.create",
      "description": "Create the weekend and its website for the signed-in host. Returns the site URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "geo": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "description": "Weekend name, shown on the site."
          },
          "startsOn": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "endsOn": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "password": {
            "type": "string",
            "description": "Optional site password. Omit for an open invite link."
          }
        },
        "required": [
          "geo",
          "title",
          "startsOn",
          "endsOn"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "bachwknd.party.get",
      "description": "The weekend, its itinerary, costs, crew invites, and website URLs. Pass partyId or slug.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "partyId": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "bachwknd.party.update",
      "description": "Update the weekend title, dates, description, or housing (locationName, link, notes, price) on the website.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "partyId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "startsOn": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "endsOn": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "locationName": {
            "type": "string"
          },
          "housingUrl": {
            "type": "string"
          },
          "housingNotes": {
            "type": "string"
          },
          "housingPriceCents": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "partyId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "bachwknd.party.delete",
      "description": "Delete a weekend website permanently.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "partyId": {
            "type": "string"
          }
        },
        "required": [
          "partyId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "bachwknd.plan.set",
      "description": "Add spots to the itinerary. Each stop needs a place id from search, a day label, and a startsAt time.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "partyId": {
            "type": "string"
          },
          "stops": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "placeId": {
                  "type": "string"
                },
                "day": {
                  "type": "string",
                  "description": "Friday, or a YYYY-MM-DD inside the weekend."
                },
                "startsAt": {
                  "type": "string",
                  "description": "ISO local time, such as 2026-12-05T19:00:00."
                }
              },
              "required": [
                "placeId",
                "day",
                "startsAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "partyId",
          "stops"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "bachwknd.plan.remove",
      "description": "Take one spot off the itinerary.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "partyId": {
            "type": "string"
          },
          "placeId": {
            "type": "string"
          }
        },
        "required": [
          "partyId",
          "placeId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "bachwknd.costs.add",
      "description": "Add a shared cost / expense to the party budget.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "partyId": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "description": "Expense name, e.g. Boat rental or House deposit."
          },
          "amountCents": {
            "type": "integer",
            "minimum": 1,
            "description": "Total amount in cents."
          }
        },
        "required": [
          "partyId",
          "title",
          "amountCents"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "bachwknd.costs.remove",
      "description": "Remove a shared cost from the party budget.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "partyId": {
            "type": "string"
          },
          "billId": {
            "type": "string"
          }
        },
        "required": [
          "partyId",
          "billId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "bachwknd.invites.add",
      "description": "Invite the crew. Each person gets a private invite link on the website.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "partyId": {
            "type": "string"
          },
          "people": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "email"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "partyId",
          "people"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "bachwknd.invites.remove",
      "description": "Remove an invited guest from the party by inviteId or email.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "partyId": {
            "type": "string"
          },
          "inviteId": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "partyId"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "cc.partyworld/party",
    "version": "1.0.0",
    "remoteUrl": "https://partyworld.cc/mcp",
    "publishedAt": "2026-11-26T19:24:56.267888Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "a4349cd02e95617630b4686be772dc5213e4b49bfd7a3e4917de366d473507ef"
  }
}
