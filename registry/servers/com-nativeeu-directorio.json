{
  "$schema": "../schema.json",
  "name": "com.nativeeu/directorio",
  "title": "NativeEU",
  "category": "Other",
  "description": "European software alternatives: country of origin, verified compliance and user votes.",
  "tools": [
    {
      "name": "buscar_alternativas",
      "description": "Busca alternativas europeas a una herramienta o por texto libre. Úsala cuando alguien quiera dejar un software de fuera de Europa. Ejemplo: herramienta=\"slack\".",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "herramienta": {
            "description": "Clave de la herramienta que se quiere sustituir, en minúsculas.",
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,60}$"
          },
          "q": {
            "description": "Texto libre, por ejemplo \"facturación\".",
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "pais": {
            "description": "País de la empresa, ISO alfa-2.",
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "limite": {
            "default": 10,
            "description": "Cuántos resultados devolver (1-20).",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      }
    },
    {
      "name": "listar_categoria",
      "description": "Lista las aplicaciones de una categoría del directorio, de más a menos votadas. Ejemplo: categoria=\"facturacion\".",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "categoria": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,60}$",
            "description": "Slug de la categoría."
          },
          "limite": {
            "default": 10,
            "description": "Cuántos resultados devolver (1-20).",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "categoria"
        ]
      }
    },
    {
      "name": "obtener_producto",
      "description": "Devuelve la ficha pública de una aplicación: país, precio desde, modelo de precio y cumplimientos aceptados.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,80}$",
            "description": "Identificador de la ficha, por ejemplo \"holded\"."
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "comprobar_cumplimiento",
      "description": "Dice qué normas (RGPD, Verifactu, etc.) tiene aceptadas una aplicación, o si cumple una concreta. Solo cuentan las revisadas por NativeEU.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,80}$",
            "description": "Identificador de la ficha, por ejemplo \"holded\"."
          },
          "norma": {
            "description": "Clave de la norma a comprobar; sin ella, todas las aceptadas.",
            "type": "string",
            "enum": [
              "verifactu",
              "sii",
              "factura_espana",
              "ticketbai",
              "sepa",
              "cfdi",
              "carta_porte",
              "dian",
              "boleta_electronica",
              "afip",
              "sunat",
              "rgpd",
              "servidores_ue",
              "sin_transferencias",
              "dora",
              "nis2",
              "eidas",
              "accesibilidad",
              "iso27001",
              "soc2",
              "exportar_datos",
              "sso"
            ]
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "listar_paises",
      "description": "Lista los países de origen del directorio y cuántas aplicaciones tiene cada uno.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.nativeeu/directorio",
    "version": "1.2.0",
    "remoteUrl": "https://nativeeu.com/mcp",
    "publishedAt": "2026-11-19T10:44:16.069968Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "22ff447f79f03ddfa6e4cae16cf701117540ef3713b334000f33a8cb28e464fe"
  }
}
