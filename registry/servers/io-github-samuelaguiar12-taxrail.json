              "base",
              "ethereum",
              "arbitrum",
              "solana"
            ]
          },
          "walletAddress": {
            "type": "string"
          },
          "targetAsset": {
            "type": "string",
            "minLength": 1
          },
          "sellQuantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "targetProceedsUsd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "currentPriceUsd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "targetQuoteAsset": {
            "type": "string",
            "minLength": 1
          },
          "lots": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lotId": {
                  "type": "string",
                  "minLength": 1
                },
                "asset": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "costBasisUsd": {
                  "type": "number",
                  "minimum": 0
                },
                "acquiredAt": {
                  "type": "string",
                  "minLength": 4
                },
                "custodyLocation": {
                  "type": "string",
                  "enum": [
                    "DOMESTIC",
                    "OFFSHORE",
                    "SELF_CUSTODY"
                  ]
                }
              },
              "required": [
                "lotId",
                "asset",
                "quantity",
                "costBasisUsd",
                "acquiredAt",
                "custodyLocation"
              ]
            }
          },
