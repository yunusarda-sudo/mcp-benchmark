                "type": "number",
                "minimum": 0
              },
              "monthlyGrossSalesBrl": {
                "type": "number",
                "minimum": 0
              },
              "usdBrlRate": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "marginalOrdinaryRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.5
              },
              "applyNiit": {
                "type": "boolean"
              },
              "carryforwardLossesUsd": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "referrerWallet": {
            "type": "string"
          },
          "pricingTier": {
            "type": "string",
            "enum": [
              "STANDARD",
              "VOLUME",
              "ENTERPRISE"
            ]
          },
          "asOfDate": {
            "type": "string"
          }
        },
        "required": [
