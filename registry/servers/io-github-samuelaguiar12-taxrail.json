{
  "$schema": "../schema.json",
  "name": "io.github.SamuelAguiar12/taxrail",
  "category": "Developer Tools & DevOps",
  "description": "$0-upfront 1-click US & BR crypto/DeFi tax MCP (10% fee from swap/Aave + x402 USDC).",
  "repository": "https://github.com/SamuelAguiar12/taxrail",
  "tools": [
    {
      "name": "check_tax_impact",
      "description": "Free pre-execution tax analysis before any crypto swap or sale. Evaluates US (IRS 1099-DA, Form 8949, HIFO/SpecID, TLH) and Brazil (Lei 14.754, R$35k rule, Lucro Real, DeCripto) impact using explicit lots or an EVM walletAddress scan. Returns verified taxSavedUsd, $0-upfront 10%-from-operation quote, and planId. Supports 20% referrerWallet revshare.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "jurisdiction": {
            "type": "string",
            "enum": [
              "US",
              "BR"
            ]
          },
          "regime": {
            "type": "string",
            "enum": [
              "INDIVIDUAL",
              "LLC_PASS_THROUGH",
              "C_CORP",
              "PF_LEI_14754",
              "PF_DOMESTIC",
              "PJ_LUCRO_REAL",
              "PJ_SIMPLES_EXPORT"
            ]
          },
          "chain": {
            "type": "string",
            "enum": [
              "base",
              "ethereum",
              "arbitrum",
              "solana"
            ]
          },
          "walletAddress": {
            "type": "string"
          },
          "targetAsset": {
            "type": "string",
            "minLength": 1
          },
          "sellQuantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "targetProceedsUsd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "currentPriceUsd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "targetQuoteAsset": {
            "type": "string",
            "minLength": 1
          },
          "lots": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lotId": {
                  "type": "string",
                  "minLength": 1
                },
                "asset": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "costBasisUsd": {
                  "type": "number",
                  "minimum": 0
                },
                "acquiredAt": {
                  "type": "string",
                  "minLength": 4
                },
                "custodyLocation": {
                  "type": "string",
                  "enum": [
                    "DOMESTIC",
                    "OFFSHORE",
                    "SELF_CUSTODY"
                  ]
                }
              },
              "required": [
                "lotId",
                "asset",
                "quantity",
                "costBasisUsd",
                "acquiredAt",
                "custodyLocation"
              ]
            }
          },
          "context": {
            "type": "object",
            "properties": {
              "realizedGainsYtdUsd": {
                "type": "number",
                "minimum": 0
              },
              "realizedLossesYtdUsd": {
                "type": "number",
                "minimum": 0
              },
              "monthlyGrossSalesBrl": {
                "type": "number",
                "minimum": 0
              },
              "usdBrlRate": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "marginalOrdinaryRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.5
              },
              "applyNiit": {
                "type": "boolean"
              },
              "carryforwardLossesUsd": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "referrerWallet": {
            "type": "string"
          },
          "pricingTier": {
            "type": "string",
            "enum": [
              "STANDARD",
              "VOLUME",
              "ENTERPRISE"
            ]
          },
          "asOfDate": {
            "type": "string"
          }
        },
        "required": [
          "jurisdiction",
          "regime",
          "targetAsset"
        ]
      }
    },
    {
      "name": "compare_borrow_vs_sell",
      "description": "Free pre-execution comparison before selling appreciated crypto for liquidity. Compares capital gains tax from selling against borrowing USDC on Aave v3 (Base, Ethereum, or Arbitrum), reporting LTV liquidation safety, net APR, corporate tax shield, and planId for $0-upfront Aave batch calldata. Supports 20% referrerWallet revshare.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "jurisdiction": {
            "type": "string",
            "enum": [
              "US",
              "BR"
            ]
          },
          "regime": {
            "type": "string",
            "enum": [
              "INDIVIDUAL",
              "LLC_PASS_THROUGH",
              "C_CORP",
              "PF_LEI_14754",
              "PF_DOMESTIC",
              "PJ_LUCRO_REAL",
              "PJ_SIMPLES_EXPORT"
            ]
          },
          "chain": {
            "type": "string",
            "enum": [
              "base",
              "ethereum",
              "arbitrum"
            ]
          },
          "borrowerAddress": {
            "type": "string"
          },
          "collateralAsset": {
            "type": "string",
            "minLength": 1
          },
          "collateralAmount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "collateralPriceUsd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "collateralCostBasisUsd": {
            "type": "number",
            "minimum": 0
          },
          "holdingDays": {
            "type": "number",
            "minimum": 0
          },
          "liquidityNeededUsd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "borrowApr": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "horizonDays": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "marginalOrdinaryRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.5
          },
          "referrerWallet": {
            "type": "string"
          },
          "pricingTier": {
            "type": "string",
            "enum": [
              "STANDARD",
              "VOLUME",
              "ENTERPRISE"
            ]
          }
        },
        "required": [
          "jurisdiction",
          "regime",
          "collateralAsset",
          "collateralAmount",
          "collateralPriceUsd",
          "collateralCostBasisUsd",
          "holdingDays",
          "liquidityNeededUsd"
        ]
      }
    },
    {
      "name": "classify_deductible_expense",
      "description": "Free pre-payment classification for AI, cloud, SaaS, or contractor invoices. Quantifies tax deductions across US LLC/C-Corp and Brazil Lucro Real (34% IRPJ/CSLL, PIS/COFINS, IBS/CBS credits, IOF savings) and returns a QuickBooks or Omie/SPED compliance checklist with planId.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "jurisdiction": {
            "type": "string",
            "enum": [
              "US",
              "BR"
            ]
          },
          "regime": {
            "type": "string",
            "enum": [
              "INDIVIDUAL",
              "LLC_PASS_THROUGH",
              "C_CORP",
              "PF_LEI_14754",
              "PF_DOMESTIC",
              "PJ_LUCRO_REAL",
              "PJ_SIMPLES_EXPORT"
            ]
          },
          "vendorName": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "amountUsd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "BRL"
            ]
          },
          "paidWithInternationalCard": {
            "type": "boolean"
          },
          "hasFiscalDocument": {
            "type": "boolean"
          },
          "fiscalDocumentId": {
            "type": "string"
          },
          "usdBrlRate": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "referrerWallet": {
            "type": "string"
          },
          "pricingTier": {
            "type": "string",
            "enum": [
              "STANDARD",
              "VOLUME",
              "ENTERPRISE"
            ]
          }
        },
        "required": [
          "jurisdiction",
          "regime",
          "vendorName",
          "description",
          "amountUsd"
        ]
      }
    },
    {
      "name": "unlock_tax_plan",
      "description": "Unlocks exact SpecID/HIFO selectedLots, unsigned 0x v2/Jupiter swapIntent or Aave v3 calldata, and IRS Form 8949 / BR Lei 14.754 / QuickBooks / Omie-SPED accounting dossier for a planId. Unlocks free if taxSavedUsd equals 0; otherwise settles 10% of verified tax savings via x402 USDC on Base.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "planId": {
            "type": "string",
            "minLength": 1
          },
          "paymentSignature": {
            "description": "Optional x402 v2 PAYMENT-SIGNATURE / X-PAYMENT base64 payload to settle dynamic fee",
            "type": "string"
          }
        },
        "required": [
          "planId"
        ]
      }
    },
    {
      "name": "scan_wallet_tlh",
      "description": "Scans up to 25 volatile tokens in an EVM wallet (Base, Ethereum, or Arbitrum) for year-end Tax-Loss Harvesting candidates and HIFO/SpecID tax savings. Requires $0.01 USDC x402 paymentSignature on Base.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "walletAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "description": "EVM wallet address (0x...) to scan for year-end TLH and HIFO tax savings"
          },
          "chain": {
            "description": "EVM network to scan (base, ethereum, or arbitrum; defaults to base)",
            "type": "string",
            "enum": [
              "base",
              "ethereum",
              "arbitrum"
            ]
          },
          "asset": {
            "description": "Token symbol or ALL (default ALL, scans up to 25 tokens)",
            "type": "string"
          },
          "jurisdiction": {
            "description": "Tax jurisdiction ruleset (US for IRS 1099-DA/Form 8949, BR for Lei 14.754/DeCripto)",
            "type": "string",
            "enum": [
              "US",
              "BR"
            ]
          },
          "referrerWallet": {
            "description": "Optional EVM affiliate wallet (0x...) to earn 20% revshare on TaxRail's 10% fee",
            "type": "string"
          },
          "paymentSignature": {
            "description": "x402 v2 PAYMENT-SIGNATURE payload ($0.01 USDC on Base)",
            "type": "string"
          }
        },
        "required": [
          "walletAddress"
        ]
      }
    },
    {
      "name": "pre_trade_check",
      "description": "Checks HIFO vs FIFO savings, 366-day US short-to-long-term capital gains cliffs, and Aave v3 borrow-vs-sell comparisons immediately before a DEX swap or sell. Requires $0.01 USDC x402 paymentSignature on Base.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "walletAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "description": "EVM wallet address (0x...) holding the token to sell or swap"
          },
          "sellAsset": {
            "type": "string",
            "minLength": 1,
            "description": "Token symbol to sell or swap (e.g. ETH, AERO, WBTC)"
          },
          "sellAmount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Decimal token quantity planned for disposal"
          },
          "chain": {
            "description": "EVM network where the swap will execute (base, ethereum, or arbitrum)",
            "type": "string",
            "enum": [
              "base",
              "ethereum",
              "arbitrum"
            ]
          },
          "jurisdiction": {
            "description": "Tax jurisdiction ruleset (US or BR)",
            "type": "string",
            "enum": [
              "US",
              "BR"
            ]
          },
          "referrerWallet": {
            "description": "Optional EVM affiliate wallet (0x...) to earn 20% revshare on TaxRail's fee",
            "type": "string"
          },
          "paymentSignature": {
            "description": "x402 v2 PAYMENT-SIGNATURE payload ($0.01 USDC on Base)",
            "type": "string"
          }
        },
        "required": [
          "walletAddress",
          "sellAsset",
          "sellAmount"
        ]
      }
    },
    {
      "name": "check_br_35k_status",
      "description": "Calculates remaining R$35,000 monthly domestic crypto exemption versus Lei 14.754 15% flat offshore/DEX tax and maximum tax-free USD sale size for Brazil taxpayers. Requires $0.005 USDC x402 paymentSignature on Base.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "monthlySalesBrl": {
            "default": 0,
            "description": "Total BRL value of crypto disposals already executed in the current calendar month",
            "type": "number",
            "minimum": 0
          },
          "plannedSaleUsd": {
            "default": 1000,
            "description": "USD value of the next planned crypto sale or swap",
            "type": "number",
            "minimum": 0
          },
          "custodyLocation": {
            "default": "DOMESTIC",
            "description": "DOMESTIC (Brazilian exchange) or OFFSHORE (self-custody, DEX, or foreign exchange under Lei 14.754)",
            "type": "string",
            "enum": [
              "DOMESTIC",
              "OFFSHORE"
            ]
          },
          "usdBrlRate": {
            "description": "Optional USD/BRL exchange rate override (defaults to current reference rate)",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "paymentSignature": {
            "description": "x402 v2 PAYMENT-SIGNATURE payload ($0.005 USDC on Base)",
            "type": "string"
          }
        }
      }
    },
    {
      "name": "prepare_execution",
      "description": "Free pre-execution step: builds ready-to-sign 0x v2 / Jupiter swap calldata or an Aave v3 atomic borrow batch with TaxRail's 10% verified-savings fee embedded inside the operation ($0 upfront cost). After broadcasting the transaction, call claim_dossier with txHash to unlock SpecID lots and IRS Form 8949 / DeCripto CSV.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "planId": {
            "type": "string",
            "minLength": 1
          },
          "takerAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          },
          "buyAsset": {
            "type": "string",
            "minLength": 1
          },
          "borrowerAddress": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{40}$"
          }
        },
        "required": [
          "planId"
        ]
      }
    },
    {
      "name": "claim_dossier",
      "description": "Verifies the settled swap or Aave borrow txHash on-chain (confirming TaxRail's 10% fee transfer from the operation) and returns SpecID selectedLots plus the IRS Form 8949 or Brazil DeCripto accounting dossier.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "planId": {
            "type": "string",
            "minLength": 1
          },
          "txHash": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{64}$"
          },
          "chain": {
            "type": "string",
            "enum": [
              "base",
              "ethereum",
              "arbitrum"
            ]
          },
          "feeTxHash": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{64}$"
          },
          "paymentSignature": {
            "description": "Optional dev-bypass token for automated testing",
            "type": "string"
          }
        },
        "required": [
          "planId",
          "txHash"
        ]
      }
    }
  ],
