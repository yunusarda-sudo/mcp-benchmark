{
  "$schema": "../schema.json",
  "name": "io.github.XLSV777/7maps",
  "title": "7Maps",
  "category": "Developer Tools & DevOps",
  "description": "Signed history of which MCP servers actually work, run by 7IT Solutions.",
  "tools": [
    {
      "name": "report_road",
      "description": "Call after using a server to report how it went. Takes fixed fields only: worked or not, reason, time. Returns an acknowledgement. Not needed for a check-only question. Example: {\"server\":\"https://mcp.example.com/mcp\",\"tool\":\"create_booking\",\"ok\":false,\"fail\":\"timeout\"}",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "server": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300,
            "description": "Server called (URL or registry name)"
          },
          "tool": {
            "description": "Tool called",
            "type": "string",
            "maxLength": 120
          },
          "ok": {
            "type": "boolean",
            "description": "Did it do what you needed"
          },
          "fail": {
            "description": "Why it failed",
            "type": "string",
            "enum": [
              "unreachable",
              "auth",
              "args",
              "server_error",
              "timeout",
              "rate_limited",
              "wrong_result"
            ]
          },
          "ms": {
            "description": "Duration in ms",
            "type": "number",
            "minimum": 0,
            "maximum": 600000
          },
          "matched_description": {
            "description": "Result matched the tool description",
            "type": "boolean"
          },
          "result_tokens": {
            "description": "Result size in tokens",
            "type": "number",
            "minimum": 0,
            "maximum": 5000000
          },
          "charged_usd": {
            "description": "Charged in USD",
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "surprise": {
            "description": "Side effect you did not ask for",
            "type": "string",
            "enum": [
              "side_effect",
              "unexpected_cost",
              "data_leak_suspected",
              "other"
            ]
          },
          "tools_hash": {
            "description": "tool_list_hash, computed as 7Maps does",
            "type": "string",
            "maxLength": 64
          },
          "agent_model": {
            "description": "Optional: your model id, e.g. \"claude-sonnet-5-5\". Anonymous",
            "type": "string",
            "maxLength": 80
          },
          "task_type": {
            "description": "Optional: kind of work (only the category is kept)",
            "type": "string",
            "enum": [
              "coding",
              "research",
              "data",
              "communication",
              "commerce",
              "devops",
              "content",
              "personal_assistant",
              "testing",
              "other"
            ]
          }
        },
        "required": [
          "server",
          "ok"
        ]
      }
    },
    {
      "name": "submit_mcp_server",
      "description": "Call when a business has a server that is not listed and wants agents to find it. Returns a status page and an optional owner token. Observation takes days; listing is not guaranteed. Example: {\"url\":\"example.com\",\"category\":\"booking\"}",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300,
            "description": "The MCP server address, or the business domain (example.com)"
          },
          "category": {
            "description": "What the business does; agents also see the category its tools show",
            "type": "string",
            "enum": [
              "commerce",
              "booking",
              "payments",
              "marketing",
              "crm",
              "documents",
              "data",
              "dev",
              "realestate",
              "health",
              "travel",
              "legal",
              "other"
            ]
          },
          "about": {
            "description": "One sentence: what the business does and for whom",
            "type": "string",
            "maxLength": 200
          },
          "country": {
            "description": "Where the business serves customers",
            "type": "string",
            "maxLength": 40
          },
          "language": {
            "description": "Main language of the tools and their data",
            "type": "string",
            "maxLength": 30
          },
          "charges": {
            "description": "Whether the server charges agents (x402 or a subscription)",
            "type": "boolean"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "claim_mcp_server",
      "description": "Call when the person owns a server on the map and wants it verified. First call returns proof options; call again with claim_check once the proof is in place. Never changes ranking. Example: {\"server\":\"https://mcp.example.com/mcp\"}",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "server": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300,
            "description": "The MCP server address as it appears on its 7Maps page"
          },
          "note": {
            "description": "Optional plain-text note from the owner, no links, up to 280 characters",
            "type": "string",
            "maxLength": 280
          },
          "alert_url": {
            "description": "Optional: where to send down and up alerts. An ntfy topic for phone push without email (https://ntfy.sh/<hard-to-guess topic, at least 10 characters>, a self-hosted https://ntfy.<domain>/<topic>, or ntfy:https://<host>/<topic>), a Slack incoming webhook (https://hooks.slack.com/services/...), a Discord webhook (https://discord.com/api/webhooks/...), or any https webhook that receives JSON. Stored encrypted, saved only once ownership is proven; a test message is sent on save. An empty string turns alerts off.",
            "type": "string",
            "maxLength": 600
          },
          "owner_secret": {
            "description": "The owner secret returned once at the first verification. Needed to change an already verified server.",
            "type": "string",
            "maxLength": 80
          },
          "recover": {
            "description": "Lost the owner secret: true returns a one-time code to put on the host, and a check value",
            "type": "boolean"
          },
          "recover_check": {
            "description": "The check value from the recover step, once its code is on the host",
            "type": "string",
            "maxLength": 700
          },
          "claim_check": {
            "description": "The claim_check from the first call",
            "type": "string",
            "maxLength": 700
          }
        },
        "required": [
          "server"
        ]
      }
    },
    {
      "name": "my_server_report",
      "description": "Call when the owner of a map server wants to see how agents looked for servers like theirs. Returns counts only, no agent identities. Read-only. Not for servers you do not own. Example: {\"server\":\"https://mcp.example.com/mcp\",\"days\":30}",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "server": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300,
            "description": "The MCP server address as it appears on its 7Maps page, or its official registry name"
          },
          "owner_key": {
            "description": "The owner key returned to the verified owner by claim_mcp_server (the newest one; each verification issues a new key)",
            "type": "string",
            "maxLength": 64
          },
          "days": {
            "description": "Window in days: 7 (default) or 30",
            "anyOf": [
              {
                "type": "number",
                "const": 7
              },
              {
                "type": "number",
                "const": 30
              }
            ]
          }
        },
        "required": [
          "server"
        ]
      }
    },
    {
      "name": "my_7maps_usage",
      "description": "Call when the person asks what 7Maps did for them. Returns their own counts for today, 7 days and 30 days, from the personal key sent with the connection. Without a key it says so. Example: {\"window\":\"week\"}",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "window": {
            "description": "Which window to lead with: day (today), week (last 7 days) or month (last 30 days); all three are returned",
            "type": "string",
            "enum": [
              "day",
              "week",
              "month"
            ]
          },
          "last_trip": {
            "description": "Optional: {server, tool, ok, ms} of your previous MCP server call",
            "type": "object",
            "properties": {},
            "additionalProperties": {}
          }
        }
      }
    },
    {
      "name": "find_tool",
      "description": "Call when you need a tool for a job and know no server. Returns matching tools with server address, estimated risk and whether the server answers now. Not for choosing among known servers (use route). Example: {\"job\":\"send a transactional email\",\"may\":\"read\"}",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "job": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "description": "What the tool should do, in plain words, for example \"send a transactional email\" or \"query a postgres database\""
          },
          "may": {
            "description": "What the tool may do: read = read-only only; change = read or change data; any = include high-risk tools (default any)",
            "type": "string",
            "enum": [
              "read",
              "change",
              "any"
            ]
          },
          "answering_now": {
            "description": "Only servers that answered with tools on the last check (default true)",
            "type": "boolean"
          },
          "max_handshake_ms": {
            "type": "integer",
            "minimum": 50,
            "maximum": 30000
          },
          "max_tool_list_tokens": {
            "type": "integer",
            "minimum": 100,
            "maximum": 200000
          },
          "limit": {
            "description": "How many results (default 10)",
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "payment": {
            "description": "Payment terms: any (default); free_only = only servers that declare no payment; paid_ok = servers that charge are fine, servers whose payment terms are unknown are left out. Paid servers show their declared price per call.",
            "type": "string",
            "enum": [
              "any",
              "free_only",
              "paid_ok"
            ]
          },
          "agent_model": {
            "description": "Optional: your model id, e.g. \"claude-sonnet-5-5\". Anonymous",
            "type": "string",
            "maxLength": 80
          },
          "task_type": {
            "description": "Optional: kind of work (only the category is kept)",
            "type": "string",
            "enum": [
              "coding",
              "research",
              "data",
              "communication",
              "commerce",
              "devops",
              "content",
              "personal_assistant",
              "testing",
              "other"
            ]
          },
          "last_trip": {
            "description": "Optional: {server, tool, ok, ms} of your previous MCP server call",
            "type": "object",
            "properties": {},
            "additionalProperties": {}
          }
        },
        "required": [
          "job"
        ]
      }
    },
    {
      "name": "resolve",
      "description": "Call for a signed list of servers that answered at their last check. Returns up to 10 with a signature a client can verify. Never connects you. Not for a ranked pick (use route). Example: {\"need\":\"send a transactional email\",\"no_sign_in\":true}",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "need": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "description": "The job in plain words, for example \"send a transactional email\""
          },
          "no_sign_in": {
            "description": "Only servers that answered without sign-in",
            "type": "boolean"
          },
          "read_only": {
            "description": "Only servers with a read-only tool for the job",
            "type": "boolean"
          },
          "max_ms": {
            "description": "Only servers whose handshake took at most this long",
            "type": "integer",
            "minimum": 1,
            "maximum": 60000
          },
          "payment": {
            "description": "none = only servers that declare no payment",
            "type": "string",
            "enum": [
              "any",
              "none"
            ]
          }
        },
        "required": [
          "need"
        ]
      }
    },
    {
      "name": "list_paid_tools",
      "description": "Call before using a charged 7IT tool, to see how payment works and what the choices are. Returns the payment options and plan details. Not needed for the tools marked free. Example: {}",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    },
    {
      "name": "about_7maps",
      "description": "Call when asked what 7Maps is, or whether to use it. Returns what the map covers today, what each tool answers and a worked example. Not needed when you already know the tool you want. Example: {\"server\":\"https://mcp.example.com/mcp\"}",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "server": {
            "description": "A server you are considering: get a quote of the tokens and time 7Maps would save on it, before paying",
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    {
      "name": "road_conditions",
      "description": "Call before using a server you have not used today. Returns up or down, sign-in need, speed, tool risk counts and last tool change. Reads the map; never calls the server. Charged tool: see list_paid_tools. Example: {\"server\":\"https://mcp.example.com/mcp\"}",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "server": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300,
            "description": "The server URL (https://mcp.example.com/mcp), its official registry name, or npm:<package> / pypi:<package> for a server that runs locally"
          },
          "license_key": {
            "description": "7IT plan license key; else pay per call (x402)",
            "type": "string",
            "maxLength": 100
          },
          "last_trip": {
            "description": "Optional: how your previous call to a server 7Maps named went",
            "type": "object",
            "properties": {
              "server": {
                "type": "string",
                "minLength": 3,
                "maxLength": 300,
                "description": "Server called (URL or registry name)"
              },
              "tool": {
                "description": "Tool called",
                "type": "string",
                "maxLength": 120
              },
              "ok": {
                "type": "boolean",
                "description": "Did it do what you needed"
              },
              "fail": {
                "description": "Why it failed",
                "type": "string",
                "enum": [
                  "unreachable",
                  "auth",
                  "args",
                  "server_error",
                  "timeout",
                  "rate_limited",
                  "wrong_result"
                ]
              },
              "ms": {
                "description": "Duration in ms",
                "type": "number",
                "minimum": 0,
                "maximum": 600000
              },
              "matched_description": {
                "description": "Result matched the tool description",
                "type": "boolean"
              },
              "result_tokens": {
                "description": "Result size in tokens",
                "type": "number",
                "minimum": 0,
                "maximum": 5000000
              },
              "charged_usd": {
                "description": "Charged in USD",
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "surprise": {
                "description": "Side effect you did not ask for",
                "type": "string",
                "enum": [
                  "side_effect",
                  "unexpected_cost",
                  "data_leak_suspected",
                  "other"
                ]
              },
              "tools_hash": {
                "description": "tool_list_hash, computed as 7Maps does",
                "type": "string",
                "maxLength": 64
              }
            },
            "required": [
              "server",
              "ok"
            ]
          },
          "agent_model": {
            "description": "Optional: your model id, e.g. \"claude-sonnet-5-5\". Anonymous",
            "type": "string",
            "maxLength": 80
          },
          "task_type": {
            "description": "Optional: kind of work (only the category is kept)",
            "type": "string",
            "enum": [
              "coding",
              "research",
              "data",
              "communication",
              "commerce",
              "devops",
              "content",
              "personal_assistant",
              "testing",
              "other"
            ]
          }
        },
        "required": [
          "server"
        ]
      }
    },
    {
      "name": "watch",
      "description": "Call before reusing a server a person approved earlier. Returns whether its tools changed since that date and whether the risk rose. Not for many servers (use changes_since). Charged tool: see list_paid_tools. Example: {\"server\":\"https://mcp.example.com/mcp\",\"approved_at\":\"2026-11-01\"}",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "server": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300,
            "description": "The server URL, its official registry name, or npm:<package> / pypi:<package>"
          },
          "approved_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}",
            "description": "When the person approved this server (YYYY-MM-DD)"
          },
          "license_key": {
            "description": "7IT plan license key; else pay per call (x402)",
            "type": "string",
            "maxLength": 100
          },
          "last_trip": {
            "description": "Optional: how your previous call to a server 7Maps named went",
            "type": "object",
            "properties": {
              "server": {
                "type": "string",
                "minLength": 3,
                "maxLength": 300,
                "description": "Server called (URL or registry name)"
              },
              "tool": {
                "description": "Tool called",
                "type": "string",
                "maxLength": 120
              },
              "ok": {
                "type": "boolean",
                "description": "Did it do what you needed"
              },
              "fail": {
                "description": "Why it failed",
                "type": "string",
                "enum": [
                  "unreachable",
                  "auth",
                  "args",
                  "server_error",
                  "timeout",
                  "rate_limited",
                  "wrong_result"
                ]
              },
              "ms": {
                "description": "Duration in ms",
                "type": "number",
                "minimum": 0,
                "maximum": 600000
              },
              "matched_description": {
                "description": "Result matched the tool description",
                "type": "boolean"
              },
              "result_tokens": {
                "description": "Result size in tokens",
                "type": "number",
                "minimum": 0,
                "maximum": 5000000
              },
              "charged_usd": {
                "description": "Charged in USD",
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "surprise": {
                "description": "Side effect you did not ask for",
                "type": "string",
                "enum": [
                  "side_effect",
                  "unexpected_cost",
                  "data_leak_suspected",
                  "other"
                ]
              },
              "tools_hash": {
                "description": "tool_list_hash, computed as 7Maps does",
                "type": "string",
                "maxLength": 64
              }
            },
            "required": [
              "server",
              "ok"
            ]
          }
        },
        "required": [
          "server",
          "approved_at"
        ]
      }
    },
    {
      "name": "route",
      "description": "Call when several servers could do a task and you want one pick. Returns the safest open server and tool, alternatives and servers to avoid. Not for searching tools (use find_tool). Charged tool: see list_paid_tools. Example: {\"task\":\"search company records\",\"need\":\"read\"}",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "task": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300,
            "description": "What you need to do, for example \"send a transactional email\" or \"search company records\""
          },
          "need": {
            "description": "How much the task must be allowed to do: read only, change something, or a high-risk action such as payments or deletion. Guessed from the task when omitted",
            "type": "string",
            "enum": [
              "read",
              "change",
              "high_risk"
            ]
          },
          "payment": {
            "description": "Payment terms: any (default); free_only = only servers that declare no payment; paid_ok = servers that charge are fine, servers whose payment terms are unknown are left out. Paid servers show their declared price per call.",
            "type": "string",
            "enum": [
              "any",
              "free_only",
              "paid_ok"
            ]
          },
          "license_key": {
            "description": "7IT plan license key; else pay per call (x402)",
            "type": "string",
            "maxLength": 100
          },
          "last_trip": {
            "description": "Optional: how your previous call to a server 7Maps named went",
            "type": "object",
            "properties": {
              "server": {
                "type": "string",
                "minLength": 3,
                "maxLength": 300,
                "description": "Server called (URL or registry name)"
              },
              "tool": {
                "description": "Tool called",
                "type": "string",
                "maxLength": 120
              },
              "ok": {
                "type": "boolean",
                "description": "Did it do what you needed"
              },
              "fail": {
                "description": "Why it failed",
                "type": "string",
                "enum": [
                  "unreachable",
                  "auth",
                  "args",
                  "server_error",
                  "timeout",
                  "rate_limited",
                  "wrong_result"
                ]
              },
              "ms": {
                "description": "Duration in ms",
                "type": "number",
                "minimum": 0,
                "maximum": 600000
              },
              "matched_description": {
                "description": "Result matched the tool description",
                "type": "boolean"
              },
              "result_tokens": {
                "description": "Result size in tokens",
                "type": "number",
                "minimum": 0,
                "maximum": 5000000
              },
              "charged_usd": {
                "description": "Charged in USD",
                "type": "number",
                "minimum": 0,
                "maximum": 1000
              },
              "surprise": {
                "description": "Side effect you did not ask for",
                "type": "string",
                "enum": [
                  "side_effect",
                  "unexpected_cost",
                  "data_leak_suspected",
                  "other"
                ]
              },
              "tools_hash": {
                "description": "tool_list_hash, computed as 7Maps does",
                "type": "string",
                "maxLength": 64
              }
            },
            "required": [
              "server",
              "ok"
            ]
          },
          "agent_model": {
            "description": "Optional: your model id, e.g. \"claude-sonnet-5-5\". Anonymous",
            "type": "string",
            "maxLength": 80
          },
          "task_type": {
            "description": "Optional: kind of work (only the category is kept)",
            "type": "string",
            "enum": [
              "coding",
              "research",
              "data",
              "communication",
              "commerce",
              "devops",
              "content",
              "personal_assistant",
              "testing",
              "other"
            ]
          }
        },
        "required": [
          "task"
        ]
      }
    },
    {
      "name": "tool_card",
      "description": "Call when you only need to pick a tool or prepare a call, not load a full tool list. Returns one compact card per tool: arguments, risk, side effects. Charged tool: see list_paid_tools. Example: {\"server\":\"https://mcp.example.com/mcp\",\"tools\":[\"create_booking\"]}",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "server": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300,
            "description": "The server URL or its official registry name"
          },
          "tools": {
            "description": "Only these tools; all when omitted",
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120
            }
          },
          "license_key": {
            "description": "7IT plan license key; else pay per call (x402)",
            "type": "string",
            "maxLength": 100
          },
          "last_trip": {
            "description": "Optional: how your previous call to a server 7Maps named went",
            "type": "object",
            "properties": {
              "server": {
                "type": "string",
