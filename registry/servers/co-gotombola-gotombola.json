{
  "$schema": "../schema.json",
  "name": "co.gotombola/gotombola",
  "title": "GoTombola",
  "category": "Security & Identity",
  "description": "Charitable raffles: rules per country, filing authority, estimates; organisers read their campaigns.",
  "tools": [
    {
      "name": "get_legal_frame",
      "description": "Returns the legal frame of a raffle in one country: the coverage level of our content (structured, indication or not_covered), the regimes that apply with who may organise, the kind of authority, the lead time and the documents, a one-sentence legal basis, and the official sources with the date they were checked. A country without content returns not_covered. Every answer carries a notice that it is a general indication, not legal advice.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "country": {
            "type": "string",
            "pattern": "^[A-Za-z]{2}$",
            "description": "ISO 3166-1 alpha-2 country code, for example FR."
          },
          "language": {
            "description": "Language of the notice.",
            "type": "string",
            "enum": [
              "fr",
              "en"
            ]
          }
        },
        "required": [
          "country"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "find_authority",
      "description": "Returns the French authority a raffle is filed with for a postcode (the town hall of the commune, or the Préfecture de police for Paris): name, public address, e-mail, phone, website, online form, and the public directory source with the date it was read. When a postcode covers several communes, the commune name selects one.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "postcode": {
            "type": "string",
            "pattern": "^\\d{5}$",
            "description": "French postcode of the head office, five digits."
          },
          "commune": {
            "description": "Commune name, when the postcode covers several.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "language": {
            "description": "Language of the notice.",
            "type": "string",
            "enum": [
              "fr",
              "en"
            ]
          }
        },
        "required": [
          "postcode"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "estimate_campaign",
      "description": "Estimates the money of a campaign from its ticket price and the number of tickets expected: gross amount, plan fee, Flex fee beyond the plan caps, payment provider fee, net amount after the value of the prizes, and the cheapest plan. Amounts are integers in minor units (cents) of the pricing currency. The result is an estimate, dated by the prices it uses.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "ticket_price_minor": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 10000000
          },
          "tickets_expected": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 10000000
          },
          "tickets_per_sale": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "prizes_value_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000000
          },
          "plan": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
          },
          "language": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ]
          }
        },
        "required": [
          "ticket_price_minor",
          "tickets_expected"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_my_campaigns",
      "description": "Lists the campaigns the signed-in organiser chose to share with this assistant: public code, name, status and draw date.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_campaign_overview",
      "description": "Returns the overview of one shared campaign by its public code: name, status, start and draw dates, ticket price, number of prizes, modules turned on, and the links to its public page and to its console.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^G[A-Z]{3}[0-9]{3}$",
            "description": "Public campaign code, for example GABC123."
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_campaign_figures",
      "description": "Returns the aggregated sales figures of one shared campaign: tickets sold, amount collected, and a daily series over the requested number of days. The figures are totals only, with no detail per sale or per buyer.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^G[A-Z]{3}[0-9]{3}$",
            "description": "Public campaign code, for example GABC123."
          },
          "days": {
            "description": "Length of the daily series, 1 to 90 days.",
            "type": "integer",
            "minimum": 1,
            "maximum": 90
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_todo",
      "description": "Returns the to-do list of one shared campaign: each item with its phase, whether it blocks the campaign or is recommended, its label, and the console link where it is done.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^G[A-Z]{3}[0-9]{3}$",
            "description": "Public campaign code, for example GABC123."
          },
          "language": {
            "description": "Language of the labels, French by default.",
            "type": "string",
            "enum": [
              "fr",
              "en"
            ]
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_launch_readiness",
      "description": "Returns whether one shared campaign can be launched, the items still missing with their console links, and the status code of its authorisation.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^G[A-Z]{3}[0-9]{3}$",
            "description": "Public campaign code, for example GABC123."
          },
          "language": {
            "description": "Language of the labels, French by default.",
            "type": "string",
            "enum": [
              "fr",
              "en"
            ]
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_share_kit",
      "description": "Returns the sharing kit of one shared campaign: its short link and its tracked links, with their sale counts when available.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^G[A-Z]{3}[0-9]{3}$",
            "description": "Public campaign code, for example GABC123."
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "prepare_campaign_draft",
      "description": "Stores a draft of a new campaign (kind, name, country, dates, ticket price, prizes, description) for the signed-in organiser and returns the console link where the organiser reviews it and creates the campaign. The draft itself creates, launches and charges nothing, and it expires after 7 days. The same proposal_key with the same draft returns the same proposal.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "proposal_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{8,128}$",
            "description": "Idempotency key chosen by the client, 8 to 128 characters."
          },
          "draft": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "RAFFLE",
                  "DONATION"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "country": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "locale": {
                "type": "string",
                "pattern": "^[a-z]{2}_[A-Z]{2}$"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "organizationKind": {
                "type": "string",
                "enum": [
                  "association",
                  "school",
                  "club",
                  "company",
                  "municipality",
                  "other"
                ]
              },
              "entryPriceMinor": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 10000000
              },
              "plannedEntries": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 10000000
              },
              "plannedStartsAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "closesAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "drawAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "prizes": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "quantity": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 100000
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                }
              },
              "beneficiaryText": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "kind",
              "name",
              "country",
              "closesAt"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "proposal_key",
          "draft"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "co.gotombola/gotombola",
    "version": "1.0.1",
