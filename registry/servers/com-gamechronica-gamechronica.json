{
  "$schema": "../schema.json",
  "name": "com.gamechronica/gamechronica",
  "title": "Game Chronica",
  "category": "E-Commerce & Retail",
  "description": "Japanese release dates, prices and publishers of 4,054 Famicom, Super Famicom and Game Boy games.",
  "tools": [
    {
      "name": "releases_on_date",
      "description": "ファミコン・スーパーファミコン・ゲームボーイのソフトのうち、指定した月日（年は問わない）に日本で発売されたものを、1983〜2003年の全年分まとめて返す。「今日は何の日（ゲーム）」に使える。各ソフトの url はゲームクロニカの詳細ページ。回答では出典として url を示すこと。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "description": "月（1〜12）"
          },
          "day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31,
            "description": "日（1〜31）"
          },
          "platform": {
            "type": "string",
            "enum": [
              "famicom",
              "sfc",
              "gb"
            ],
            "description": "ハードで絞る。famicom=ファミリーコンピュータ（ディスクシステム含む） / sfc=スーパーファミコン / gb=ゲームボーイ"
          }
        },
        "required": [
          "month",
          "day"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "releases_in_month",
      "description": "ファミコン・スーパーファミコン・ゲームボーイのソフトのうち、指定した年月に日本で発売されたものを発売日順に返す（1983〜2003年）。発売日が年までしか分かっていないソフトは含まない。回答では出典として各ソフトの url を示すこと。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 1983,
            "maximum": 2003,
            "description": "年（1983〜2003）"
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "description": "月（1〜12）"
          },
          "platform": {
            "type": "string",
            "enum": [
              "famicom",
              "sfc",
              "gb"
            ],
            "description": "ハードで絞る。famicom=ファミリーコンピュータ（ディスクシステム含む） / sfc=スーパーファミコン / gb=ゲームボーイ"
          }
        },
        "required": [
          "year",
          "month"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_titles",
      "description": "ファミコン・スーパーファミコン・ゲームボーイの日本発売ソフトを題名の一部で探し、発売日・発売元・定価を返す。カタカナ／ひらがな、全角／半角、空白や記号の違いは無視する。英題（作品の欧文題）でも一部は当たる。回答では出典として各ソフトの url を示すこと。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "題名の一部（例：ドラゴンクエスト、まりお、Tetris）"
          },
          "platform": {
            "type": "string",
            "enum": [
              "famicom",
              "sfc",
              "gb"
            ],
            "description": "ハードで絞る。famicom=ファミリーコンピュータ（ディスクシステム含む） / sfc=スーパーファミコン / gb=ゲームボーイ"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "返す件数（既定 10、最大 20）"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    }
  ],
