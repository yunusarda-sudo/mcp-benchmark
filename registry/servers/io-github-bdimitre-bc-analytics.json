{
  "$schema": "../schema.json",
  "name": "io.github.bdimitre/bc-analytics",
  "title": "BC Analytics",
  "category": "Developer Tools & DevOps",
  "description": "Manual USD portfolio stress and staged exit calculations. No live prices, forecasts or trades.",
  "tools": [
    {
      "name": "analyze_portfolio",
      "description": "Calculate manual USD portfolio allocation, concentration, hypothetical uniform/per-asset price shock, cost basis and mathematical recovery. No market prices, predictions or trades. Requires user-provided holdings and assumptions; remote data transfer differs from browser-only calculator.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assets"
        ],
        "properties": {
          "assets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "symbol",
                "quantity",
                "costPerUnit",
                "price"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,40}$",
                  "description": "Unique user-assigned portfolio ID"
                },
                "symbol": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9 ._-]{1,24}$",
                  "description": "Manually entered label, not verified against a market catalog"
                },
                "quantity": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000000000
                },
                "costPerUnit": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000,
                  "description": "Average USD acquisition cost per unit"
                },
                "price": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000,
                  "description": "Manually supplied USD reference price"
                },
                "shockPct": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": -100,
                  "maximum": 300,
                  "description": "Optional asset-specific percentage change"
                }
              }
            }
          },
          "marketChangePct": {
            "type": "number",
            "minimum": -100,
            "maximum": 300,
            "default": -40,
            "description": "Hypothetical portfolio-wide price move in percent, not a probability"
          }
        }
      }
    },
    {
      "name": "plan_portfolio_exits",
      "description": "Calculate sequential proposed sales using manual unit targets, fees and average-cost accounting. Returns hypothetical proceeds, remaining holdings and recovery of cost. No orders, timing recommendations, market feed or tax accounting. Input holdings are transmitted to the service.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assets"
        ],
        "properties": {
          "assets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "symbol",
                "quantity",
                "costPerUnit",
                "price"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,40}$",
                  "description": "Unique user-assigned portfolio ID"
                },
                "symbol": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9 ._-]{1,24}$",
                  "description": "Manually entered label, not verified against a market catalog"
                },
                "quantity": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000000000
                },
                "costPerUnit": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000,
                  "description": "Average USD acquisition cost per unit"
                },
                "price": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000,
                  "description": "Manually supplied USD reference price"
                },
                "shockPct": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": -100,
                  "maximum": 300,
                  "description": "Optional asset-specific percentage change"
                }
              }
            }
          },
          "sales": {
            "type": "array",
            "minItems": 0,
            "maxItems": 60,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assetId",
                "quantity",
                "targetPrice"
              ],
              "properties": {
                "assetId": {
                  "type": "string",
                  "description": "ID of existing asset"
                },
                "quantity": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000000000
                },
                "targetPrice": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "fee": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000000000,
                  "default": 0
                }
              }
            },
            "default": []
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.bdimitre/bc-analytics",
    "version": "1.1.0",
    "remoteUrl": "https://blockchaincompound.com/mcp",
    "publishedAt": "2026-11-23T18:45:51.115812Z",
