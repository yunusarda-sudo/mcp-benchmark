{
  "$schema": "../schema.json",
  "name": "site.chatgpt.wildoakdigital.mega-ultimate-job-search/mega-ultimate-job-search",
  "title": "Mega Ultimate Job Search",
  "category": "AI, LLMs & Agents",
  "description": "Search remote, hybrid and on-site jobs by role, location, employer and advertised pay.",
  "tools": [
    {
      "name": "search_jobs",
      "description": "Find remote, hybrid and on-site jobs across feeds and employer boards. Combine role, company, country, city or region, work mode, source, date window and annual salary target. Returns paginated, deduplicated leads with links, evidence and source coverage.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 100,
            "description": "Job title, skills, employer or sector. A verified employer sector can match a keyword. Leave blank to browse recent listings."
          },
          "company": {
            "type": "string",
            "maxLength": 100,
            "description": "Optional employer name or whole-word name fragment. Matches the employer field only."
          },
          "country": {
            "type": "string",
            "enum": [
              "ANY",
              "GB",
              "US",
              "CA",
              "DE",
              "NL",
              "FR",
              "IE",
              "AU",
              "IN",
              "AE",
              "AR",
              "AT",
              "BE",
              "BG",
              "BR",
              "CH",
              "CL",
              "CO",
              "CY",
              "CZ",
              "DK",
              "EE",
              "ES",
              "FI",
              "HK",
              "HU",
              "IL",
              "IT",
              "JP",
              "KR",
              "LT",
              "MX",
              "NO",
              "NZ",
              "PE",
              "PL",
              "PT",
              "RO",
              "SE",
              "SG",
              "ZA"
            ],
            "description": "Country you need to work from. ANY searches across countries."
          },
          "require_country": {
            "type": "boolean",
            "default": false,
            "description": "Return only listings that name the selected country in their location fields. Requires a specific country. Excludes worldwide, regional and unconfirmed locations."
          },
          "location": {
            "type": "string",
            "maxLength": 80,
            "description": "Optional city or region combined with the country and work mode filters. Europe includes explicitly listed European countries."
          },
          "work_mode": {
            "type": "string",
            "enum": [
              "any",
              "remote",
              "hybrid",
              "on-site"
            ],
            "default": "any"
          },
          "source": {
            "type": "string",
            "enum": [
              "any",
              "Ashby",
              "Greenhouse",
              "Lever",
              "Workable",
              "SmartRecruiters",
              "Recruitee",
              "Teamtailor",
              "Careers",
              "Jobicy",
              "We Work Remotely",
              "Remote OK",
              "Arbeitnow",
              "CryptoJobsList",
              "Hunt"
            ],
            "default": "any"
          },
          "days": {
            "type": "integer",
            "minimum": 0,
            "maximum": 90,
            "default": 30,
            "description": "Days since the source posting date. Use 0 for any date on fresh employer boards and up to 90 days on other sources."
          },
          "since": {
            "type": "string",
            "maxLength": 24,
            "description": "Only include postings with a source date after this UTC timestamp (ISO 8601, with milliseconds)."
          },
          "minimum_salary": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000000,
            "description": "Minimum annual advertised salary in the selected currency."
          },
          "require_salary": {
            "type": "boolean",
            "default": false,
            "description": "Return only listings with an advertised annual salary or range that reaches the target in the selected currency. Requires minimum_salary and currency."
          },
          "currency": {
            "type": "string",
            "enum": [
              "GBP",
              "USD",
              "EUR",
              "CAD",
              "AUD",
              "INR"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 15
          },
          "include_source_details": {
            "type": "boolean",
            "default": false,
            "description": "Include the full source-by-source coverage report in structured MCP output. For diagnostics only."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 1,
            "description": "Results page. Use the pagination metadata to navigate."
          }
        }
      }
    },
