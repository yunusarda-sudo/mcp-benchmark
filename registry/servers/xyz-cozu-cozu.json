{
  "$schema": "../schema.json",
  "name": "xyz.cozu/cozu",
  "title": "Cozu free 3D models",
  "category": "AI, LLMs & Agents",
  "description": "Search and download free, game-ready 3D models (GLB, OBJ) under CC BY 4.0 with credit lines. No key.",
  "repository": "https://github.com/y0av/cozu",
  "tools": [
    {
      "name": "search_assets",
      "description": "Find free 3D models by words, category and format. Returns each match with its page, licence, credit line and main download URLs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Words to match, for example \"semi truck\" or \"rigged vehicle\""
          },
          "category": {
            "type": "string",
            "description": "A category id, for example \"vehicles\" (see list_categories)"
          },
          "format": {
            "type": "string",
            "enum": [
              "GLB",
              "OBJ"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_asset",
      "description": "The full record of one model: every file with its URL, size and SHA-256, stats, previews and the credit line.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The model id, for example \"ravenhall-tractor\""
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_attribution",
      "description": "The credit line to add to a project that uses a model, as text, HTML or Markdown. The link must be kept.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "text",
              "html",
              "markdown"
            ]
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "list_categories",
      "description": "The model categories and how many models each holds.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "xyz.cozu/cozu",
    "version": "1.0.0",
    "remoteUrl": "https://cozu.xyz/mcp",
    "publishedAt": "2026-11-24T07:07:03.258556Z",
    "fetchedAt": "2026-11-24T12:15:48.059Z",
    "toolsSha256": "470cbad5cbed335f3de48e9d88c81ea6957b6e515c4b314b1691ffeee1f4429d"
  }
}
