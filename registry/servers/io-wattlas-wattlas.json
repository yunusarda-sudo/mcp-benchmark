    {
      "name": "get_campus_dossier",
      "description": "Retrieve a detailed campus dossier by campus ID (c_...) or public slug, including modular sections for grid/utility, water/energy use, backup diesel/EPA, parcel/site facts, satellite aerial vision, opposition, jobs, and cleared filings. Three public sample campuses work without sign-in; all other campuses require Wattlas Pro.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "campus_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "pattern": "^(c_[a-zA-Z0-9_-]{1,64}|[a-zA-Z0-9-]+)$",
            "description": "Canonical campus ID (e.g. c_1c0224764f) or public wattlas.io slug."
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "core",
                "grid",
                "water_energy",
                "diesel_epa",
                "parcel_site",
                "satellite",
                "opposition",
                "filings",
                "jobs",
                "all"
              ]
            },
            "maxItems": 10,
            "description": "Optional data sections to include. Defaults to core, grid, water_energy, opposition, filings."
          }
        },
        "required": [
          "campus_id"
        ],
        "additionalProperties": false
      }
    },
