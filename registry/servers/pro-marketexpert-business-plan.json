{
  "$schema": "../schema.json",
  "name": "pro.marketexpert/business-plan",
  "title": "MarketExpert Business Plan Calculator",
  "category": "Other",
  "description": "Find Russian business niches and compare costs, break-even sales and payback in RUB.",
  "tools": [
    {
      "name": "find_niche",
      "description": "Найти подходящие ниши бизнес-плана по названию, виду деятельности или ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_niche_facts",
      "description": "Ответить на вопрос по материалам выбранной ниши. Возвращает выдержки и их источники.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "niche_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "topic": {
            "type": "string",
            "enum": [
              "faq",
              "products",
              "startup_costs",
              "fixed_costs",
              "team",
              "operations",
              "benchmarks"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "required": [
          "niche_id",
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "calculate_scenario",
      "description": "Рассчитать показатели бизнес-плана штатным движком MarketExpert. Укажите месячную аренду в рублях и график в днях в неделю. Средний чек меняется с согласия пользователя. Для сравнения повторите вызов с изменёнными условиями.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "niche_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "scenario": {
            "type": "object",
            "properties": {
              "format": {
                "type": "string",
                "enum": [
                  "standard",
                  "small"
                ]
              },
              "city_type": {
                "type": "string",
                "enum": [
                  "small",
                  "medium",
                  "large"
                ]
              },
              "start_month": {
                "type": "string",
                "pattern": "^(202[4-9]|2030)-(0[1-9]|1[0-2])$"
              },
              "intent": {
                "type": "string",
                "enum": [
                  "launch",
                  "personal",
                  "bank",
                  "investor",
                  "grant",
                  "sockontrakt"
                ]
              },
              "rent_monthly_rub": {
                "type": "number",
                "minimum": 0,
                "maximum": 100000000,
                "multipleOf": 0.01
              },
              "rent_cost_id": {
                "$ref": "#/properties/niche_id"
              },
              "average_check_rub": {
                "type": "number",
                "minimum": 0,
                "maximum": 100000000,
                "multipleOf": 0.01,
                "exclusiveMinimum": 0
              },
              "confirm_price_scaling": {
                "type": "boolean"
              },
              "workdays_per_week": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              }
            },
            "additionalProperties": false
          },
          "include_continue_url": {
            "type": "boolean",
            "description": "Передайте true, только если человек попросил ссылку на анкету. На этапе пилота ссылка открывает нишу и цель, финансовые условия вводятся вручную."
          },
          "expected_result_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "niche_id",
          "scenario"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "pro.marketexpert/business-plan",
    "version": "1.0.0",
    "remoteUrl": "https://marketexpert.pro/api/mcp",
    "publishedAt": "2026-11-24T10:43:33.700817Z",
    "fetchedAt": "2026-11-24T12:15:48.059Z",
    "toolsSha256": "67c5d0397e03a1c281f815e40fc2ba63ab9d0b955a6255edfb0973dd8bcec359"
  }
}
