  "$schema": "../schema.json",
  "name": "com.dataxapi/mcp",
  "title": "DataXAPI",
  "category": "AI, LLMs & Agents",
  "description": "Market data for AI agents: WeChat, Xiaohongshu, Douyin, TikTok, X and 16 more. Pay per call.",
  "repository": "https://github.com/data-x-api/dataxapi-mcp",
  "tools": [
    {
      "name": "find",
      "description": "Find capabilities for a need in plain words, English or Chinese: up to 5, each with required parameters, price and a ready call. Free, no key. Given a post's link or share text, the capabilities that take it as url: its files for words like download, its transcript for transcript, else its detail. With no match on a named platform it lists all that platform has; never substitute another platform's.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "e.g. \"小红书笔记详情\""
          },
          "platform": {
            "type": "string",
            "description": "By ID or name; alone, lists all it has"
          },
          "category": {
            "type": "string",
            "enum": [
              "ads",
              "commerce",
              "creator",
              "social"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "describe",
      "description": "The contract of 1 to 5 capabilities: each parameter's meaning and values, fields per view, paging, price and the most a call can cost, examples. Free, no key. Use when unsure of a parameter.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 5,
            "description": "Capability IDs"
          }
        },
        "required": [
          "ids"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "call",
      "description": "One page from one capability, charged per call, per item or per minute; errors are free. Give only the parameters `describe` lists for it. Its first line gives the charge, the balance and how to go on: `cursor` for the next page (charged), `read_more` for the rest of a result cut at 20 KB (free). Needs an API key. Reads DataXAPI's REST API: https://dataxapi.com/docs/",
