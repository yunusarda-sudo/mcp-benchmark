{
  "$schema": "../schema.json",
  "name": "Chroma MCP",
  "category": "Vector DBs & AI Search",
  "description": "Chroma MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "query_collection",
      "description": "Query document collection in Chroma using text embeddings or raw embeddings.",
      "inputSchema": {
        "type": "object",
        "required": [
          "collection",
          "queryTexts"
        ],
        "properties": {
          "collection": {
            "type": "string",
            "description": "Chroma collection identifier."
          },
          "queryTexts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of query strings to match."
          }
        }
      }
    }
  ]
}
