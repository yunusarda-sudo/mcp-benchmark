{
  "$schema": "../schema.json",
  "name": "ai.qonvert/qonvert",
  "title": "Qonvert Marketing AI",
  "category": "AI, LLMs & Agents",
  "description": "Marketing tools for AI agents: free Google Ads UTM checks and authorized project workflows.",
  "tools": [
    {
      "name": "get_qonvert_connect_guide",
      "description": "Learn how to use Qonvert Connect's set of MCP tools with saved project sources. Get example questions, matching read tools and setup links for Google Analytics, Google Ads and MongoDB orders. Public documentation. No project data is accessed.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "language": {
            "default": "en",
            "enum": [
              "en",
              "ru",
              "es"
            ],
            "title": "Language",
            "type": "string"
          }
        },
        "title": "ConnectGuide",
        "type": "object"
      }
    },
    {
      "name": "get_marketing_setup_guide",
      "description": "Get a first analytics and search setup checklist tailored to the market and conversion goal. Works without a Qonvert account.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "market": {
            "enum": [
              "ru",
              "global"
            ],
            "title": "Market",
            "type": "string"
          },
          "language": {
            "enum": [
              "en",
              "ru"
            ],
            "title": "Language",
            "type": "string"
          },
          "goal": {
            "enum": [
              "leads",
              "sales",
              "signups"
            ],
            "title": "Goal",
            "type": "string"
          }
        },
        "required": [
          "market",
          "language",
          "goal"
        ],
        "title": "MarketingSetup",
        "type": "object"
      }
    },
    {
      "name": "check_marketing_tracking_url",
      "description": "Inspect tracking parameter names in one supplied HTTP(S) URL without opening it. Works without a Qonvert account.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "description": "Example link with any sensitive values removed.",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          },
          "language": {
            "enum": [
              "en",
              "ru"
            ],
            "title": "Language",
            "type": "string"
          }
        },
        "required": [
          "url",
          "language"
        ],
        "title": "TrackingURL",
        "type": "object"
      }
    },
    {
      "name": "get_free_placement_guidance",
      "description": "Get free curated placement guidance. Provide the business type, stage, market, language and goal using the listed choices. Provide public_mcp for an MCP server or in_person for a local service.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "business_type": {
            "type": "string",
            "enum": [
              "saas",
              "local_service",
              "online_service",
              "mcp",
              "other"
            ]
          },
          "business_stage": {
            "type": "string",
            "enum": [
              "idea",
              "building",
              "public"
            ]
          },
          "market": {
            "type": "string",
            "enum": [
              "ru",
              "global"
            ]
          },
          "language": {
            "type": "string",
            "enum": [
              "ru",
              "en",
              "es"
            ]
          },
          "goal": {
            "type": "string",
            "enum": [
              "visibility",
              "feedback",
              "discovery"
            ]
          },
          "public_mcp": {
            "type": "boolean",
            "description": "Required for a business of type mcp. Confirm whether the server is public and usable."
          },
          "in_person": {
            "type": "boolean",
            "description": "Required for a local_service. Confirm whether the business meets customers in person."
          }
        },
        "required": [
          "business_type",
          "business_stage",
          "market",
          "language",
          "goal"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "business_type": {
                  "const": "mcp"
                }
              },
              "required": [
                "business_type"
              ]
            },
            "then": {
              "required": [
                "public_mcp"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "business_type": {
                  "const": "local_service"
                }
              },
              "required": [
                "business_type"
              ]
            },
            "then": {
              "required": [
                "in_person"
              ]
            }
          }
        ],
        "additionalProperties": false,
        "examples": [
          {
            "business_type": "saas",
            "business_stage": "public",
            "goal": "feedback",
            "market": "global",
            "language": "en"
          },
          {
            "business_type": "local_service",
            "business_stage": "public",
            "goal": "visibility",
            "market": "ru",
            "language": "ru",
            "in_person": true
          },
          {
            "business_type": "mcp",
            "business_stage": "public",
            "goal": "discovery",
            "market": "global",
            "language": "en",
            "public_mcp": true
          }
        ]
      }
    },
    {
      "name": "get_project",
      "description": "Get the project authorized by the user. Additional consent required: qonvert.read",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "qonvert_connect",
      "description": "Start here after MCP authorization. Get example questions, project sources, read permissions, one missing source and any capacity offer. Share the Qonvert confirmation link for payment or provider sign-in. Additional consent required: qonvert.read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "source": {
            "type": "string",
            "enum": [
              "website",
              "google_ads",
              "yandex_direct",
              "google_analytics",
              "yandex_metrika",
              "google_search_console",
              "yandex_webmaster",
              "app_store",
              "google_play"
            ]
          },
          "scenario_id": {
            "type": "string",
            "enum": [
              "google_ads_optimization",
              "yandex_ads_optimization",
              "google_ads_creation",
              "yandex_ads_creation"
            ]
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "ru",
              "es"
            ],
            "default": "en"
          }
        },
        "not": {
          "required": [
            "source",
            "scenario_id"
          ]
        },
        "additionalProperties": false
      }
    },
    {
      "name": "list_connections",
      "description": "List connected sources for the authorized project. Additional consent required: qonvert.read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_marketing_measurement_readiness",
      "description": "Check authorized marketing sources and observed click-ID gaps. Optionally inspect supplied URL tags without visiting those URLs. Never changes tracking or budgets. Additional consent required: qonvert.read",
      "inputSchema": {
        "$defs": {
          "ObservedVisit": {
            "additionalProperties": false,
            "properties": {
              "clicked_url": {
                "maxLength": 2048,
                "minLength": 1,
                "title": "Clicked Url",
                "type": "string"
              },
              "landing_url": {
                "anyOf": [
                  {
                    "maxLength": 2048,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Landing Url"
              },
              "analytics_provider": {
                "anyOf": [
                  {
                    "enum": [
                      "ga4",
                      "metrika"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Analytics Provider"
              },
              "analytics_consent": {
                "anyOf": [
                  {
                    "enum": [
                      "granted",
                      "denied"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Analytics Consent"
              },
              "analytics_fields": {
                "anyOf": [
                  {
                    "items": {
                      "enum": [
                        "utm_source",
                        "utm_medium",
                        "utm_campaign",
                        "utm_term",
                        "utm_content",
                        "gclid",
                        "gbraid",
                        "wbraid",
                        "yclid"
                      ],
                      "type": "string"
                    },
                    "maxItems": 9,
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Analytics Fields"
              },
              "event": {
                "anyOf": [
                  {
                    "enum": [
                      "signup",
                      "paid_checkout"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Event"
              },
              "events_for_single_action": {
                "anyOf": [
                  {
                    "maximum": 20,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Events For Single Action"
              }
            },
            "required": [
              "clicked_url"
            ],
            "title": "ObservedVisit",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "sample_urls": {
            "items": {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 6,
            "title": "Sample Urls",
            "type": "array"
          },
          "observed_visits": {
            "items": {
              "$ref": "#/$defs/ObservedVisit"
            },
            "maxItems": 3,
            "title": "Observed Visits",
            "type": "array"
          }
        },
        "title": "ReadinessInput",
        "type": "object"
      }
    },
    {
      "name": "adsy_campaign_request",
      "description": "Ask Qonvert to start or continue a Google Ads request using a website URL or the saved project site. Reuse the same request_id on each follow-up; provide only confirmed answers. Saves a brief for native approval; never runs research or ads. Additional consent required: qonvert.campaigns, qonvert.read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "description": "Reuse for every continuation of this request."
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "description": "Exact HTTPS page; omit for the saved project site."
          },
          "provider": {
            "type": "string",
            "enum": [
              "google_ads"
            ]
          },
          "brief": {
            "type": "object",
            "description": "Only confirmed answers; instance_id identifies the selected account scenario.",
            "properties": {
              "instance_id": {
                "type": "string",
                "format": "uuid"
              },
              "offering": {
                "type": "string",
                "maxLength": 160
              },
              "geography": {
                "type": "string",
                "maxLength": 160
              },
              "country_code": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "language": {
                "type": "string",
                "enum": [
                  "en",
                  "ru",
                  "es"
                ]
              },
              "monthly_budget_minor": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000000000,
                "description": "Monthly budget in the selected account currency's minor units."
              },
              "eu_political_advertising": {
                "type": "string",
                "enum": [
                  "CONTAINS_EU_POLITICAL_ADVERTISING",
                  "DOES_NOT_CONTAIN_EU_POLITICAL_ADVERTISING"
                ]
              },
              "start_date": {
                "type": "string",
                "format": "date"
              },
              "end_date": {
                "type": "string",
                "format": "date"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "request_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_campaign_brief_status",
      "description": "Read the status of a campaign brief prepared by this grant. Additional consent required: qonvert.campaigns, qonvert.read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "brief_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "brief_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "google_ads_mcp",
      "description": "Start Google Ads MCP in the authorized project. Start here after MCP authorization. Get example questions, project sources, read permissions, one missing source and any capacity offer. Share the Qonvert confirmation link for payment or provider sign-in. Additional consent required: qonvert.read",
      "inputSchema": {
