              "warehouse",
              "supplier_site"
            ]
          },
          "sampleChecks": {
            "description": "Number of agreed standard sample checks at the warehouse. For a supplier-site visit, you can give the count if known and request a separate quote.",
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "units": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "orders": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "cubicMeters": {
            "description": "Estimated stored volume in CBM, up to three decimal places; not a warehouse measurement.",
            "type": "number",
            "minimum": 0.001,
            "maximum": 10000
          },
          "months": {
            "description": "Total planned duration in 30-day periods. Do not also provide storageDays.",
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "storageDays": {
            "description": "Planned additional storage days. Prefer days for precise free-period estimates.",
            "type": "integer",
            "minimum": 1,
            "maximum": 3650
          },
          "alreadyStoredDays": {
            "description": "Days already elapsed since actual receipt of this same batch. Defaults to zero for a new batch.",
            "type": "integer",
            "minimum": 0,
            "maximum": 36500
          }
        },
