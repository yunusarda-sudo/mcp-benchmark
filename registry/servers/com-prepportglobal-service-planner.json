    {
      "name": "plan_prepport_first_job",
      "description": "Plan a first sourcing, inspection, prep, storage or fulfillment job. Return requirements, steps, a no-account quote form and a registration link. The channel identifies the seller platform; it does not connect it. No account, inquiry, order or store connection is created. Do not send contact details or private customer records.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "sourcing",
              "inspection",
              "prep",
              "storage",
              "fulfillment"
            ],
            "description": "The first service the customer wants to plan; more services can be added later."
          },
          "inspectionTask": {
            "description": "Choose report_before_release for inspection findings before final supplier payment, factory release or warehouse dispatch.",
            "type": "string",
            "enum": [
              "report_before_release"
            ]
          },
          "sourcingTask": {
            "description": "For sourcing, choose buy_and_measure_one_sample when the buyer wants one item purchased, measured and weighed with and without its retail packaging.",
            "type": "string",
            "enum": [
              "buy_and_measure_one_sample"
            ]
          },
          "channel": {
            "description": "Seller platform for the plan, not proof of a supported or authorized native integration.",
            "type": "string",
            "enum": [
              "amazon",
              "shopify",
              "ebay",
              "walmart",
              "etsy",
              "woocommerce",
              "tiktok",
              "bigcommerce",
              "other"
            ]
          }
        },
        "required": [
          "service"
        ],
        "additionalProperties": false
      }
    }
