{
  "$schema": "../schema.json",
  "name": "io.github.theguysaccount/creditable",
  "title": "Creditable",
  "category": "Developer Tools & VCS",
  "description": "Find sourced investor pitch routes and founder resources. Send approved projects for review.",
  "repository": "https://github.com/theguysaccount/mcp-catalog",
  "tools": [
    {
      "name": "search_investor_routes",
      "description": "Find public firm-level pitch instructions in the First Check Atlas by investor name, keyword, historical stage or channel. Returns official sources and check dates. A historical investment does not establish current eligibility.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 120,
            "description": "Firm name or keyword, such as Seedcamp. Omit to browse."
          },
          "stage": {
            "type": "string",
            "enum": [
              "pre-seed",
              "seed"
            ],
            "description": "Stage of a documented previous investment."
          },
          "channel": {
            "type": "string",
            "enum": [
              "application",
              "pitch_email",
              "accelerator_application"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8,
            "default": 5
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "find_builder_resources",
      "description": "Find an appropriate starting point for meeting investors, exploring a cofounder or early-team conversation, or checking startup credits. Returns public guides and opt-in SyncedIn links. No personal profiles, job vacancies or offers are searched.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "goal": {
            "type": "string",
            "enum": [
              "meet_investors",
              "find_cofounder",
              "join_startup",
              "startup_credits"
            ]
          }
        },
        "required": [
          "goal"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "read_program",
      "description": "Read Creditable’s published builder offer and submission rules. No cash check size, duration, funding guarantee or review deadline is published. Applying creates no commitment.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "validate_submission",
      "description": "Check founder-approved project details against the existing intake schema without saving or sending an application. Does not return the applicant’s personal details.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "submission": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "applicant": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 200,
                    "minLength": 1
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email"
                  }
                },
                "required": [
                  "name",
                  "email"
                ]
              },
              "project": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 200,
                    "minLength": 1
                  },
                  "summary": {
                    "type": "string",
                    "maxLength": 8000,
                    "minLength": 10
                  },
                  "website": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2000,
                    "pattern": "^https?://"
                  }
                },
                "required": [
                  "name",
                  "summary"
                ]
              },
              "materials": {
                "type": "array",
                "maxItems": 10,
                "default": [],
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "enum": [
                        "deck",
                        "demo",
                        "video",
                        "other"
                      ]
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "maxLength": 2000,
                      "pattern": "^https?://"
                    }
                  },
                  "required": [
                    "type",
                    "url"
                  ]
                }
              },
              "context": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "stage": {
                    "type": "string",
                    "maxLength": 100,
                    "default": ""
                  },
                  "sector": {
                    "type": "string",
                    "maxLength": 200,
                    "default": ""
                  },
                  "country": {
                    "type": "string",
                    "maxLength": 100,
                    "default": ""
                  }
                },
                "required": [],
                "default": {}
              },
              "submitted_by": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "agent"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 200,
                    "default": ""
                  },
                  "founder_authorized": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                },
                "required": [
                  "type",
                  "founder_authorized"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "agent"
                        }
                      },
                      "required": [
                        "type"
                      ]
                    },
                    "then": {
                      "properties": {
                        "founder_authorized": {
                          "const": true
                        }
                      },
                      "required": [
                        "founder_authorized"
                      ]
                    }
                  }
                ]
              },
              "consent": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "review_and_contact": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                },
                "required": [
                  "review_and_contact"
                ]
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "platform": {
                    "type": "string",
                    "maxLength": 200,
                    "default": ""
                  },
                  "medium": {
                    "type": "string",
                    "maxLength": 100,
                    "default": ""
                  },
                  "campaign": {
                    "type": "string",
                    "maxLength": 200,
                    "default": ""
                  },
                  "referrer": {
                    "type": "string",
                    "maxLength": 300,
                    "default": ""
                  }
                },
                "required": [],
                "default": {}
              },
              "contactWebsite": {
                "type": "string",
                "maxLength": 1000,
                "default": "",
                "description": "Honeypot: omit or leave empty."
              }
            },
            "required": [
              "applicant",
              "project",
              "submitted_by",
              "consent"
            ],
            "description": "All strings are trimmed. Agent submissions must set submitted_by.founder_authorized=true after the founder approves review and follow-up. No eligibility restrictions on stage, sector or country."
          }
        },
        "required": [
          "submission"
        ],
        "additionalProperties": false
      }
    },
