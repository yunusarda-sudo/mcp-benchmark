{
  "$schema": "../schema.json",
  "name": "com.fcushoecare/procurement",
  "title": "FCU AI Procurement Gateway",
  "category": "E-Commerce & Retail",
  "description": "Read-only FCU private label and Reflex wholesale catalogue, formats and public safety documents.",
  "tools": [
    {
      "name": "search_catalog",
      "description": "Search public FCU private-label and Reflex wholesale offers. Use code for exact matching.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 120
          },
          "code": {
            "type": "string",
            "maxLength": 40
          },
          "channel": {
            "type": "string",
            "enum": [
              "fcu_private_label",
              "reflex_wholesale"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "accessori-kit",
              "base-acqua",
              "basic",
              "cleaners",
              "creams-waxes",
              "creme-cere",
              "dyes-colourants",
              "grasso-foca",
              "greases-oils",
              "insoles",
              "kits-accessories",
              "liquidi",
              "nero-inferno",
              "new",
              "novita",
              "professional",
              "professionali",
              "solette",
              "solette-basic",
              "spray",
              "sprays-protectors",
              "tinture",
              "water-based"
            ]
          },
          "lang": {
            "type": "string",
            "enum": [
              "it",
              "en",
              "es",
              "fr",
              "de",
              "ar",
              "zh"
            ],
            "default": "it"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "default": 0
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_offer",
      "description": "Get public names, available formats, product page and reviewed safety documents for an offer ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100
          },
          "lang": {
            "type": "string",
            "enum": [
              "it",
              "en",
              "es",
              "fr",
              "de",
              "ar",
              "zh"
            ],
            "default": "it"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.fcushoecare/procurement",
    "version": "0.2.0",
    "remoteUrl": "https://fcushoecare.com/procurement/mcp",
    "publishedAt": "2026-11-25T15:38:42.076818Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "e78d3b172c112605ee4252dd19a6a72673c1f1fc61707fd26b331b24eadb8f05"
  }
}
