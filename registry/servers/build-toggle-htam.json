{
  "$schema": "../schema.json",
  "name": "build.toggle/htam",
  "title": "HTAM",
  "category": "E-Commerce & Retail",
  "description": "Search and inspect the HTAM catalog and prepare seller checkout links through MCP.",
  "tools": [
    {
      "name": "search_items",
      "description": "Search all approved catalog products using a shopping description and optional requirements. Matches use attributed listing facts; unknown constraints are never confirmed. Use prepare_checkout to request a seller route. Synthetic test data is explicitly labeled.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "budget": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            },
            "required": [
              "amount",
              "currency"
            ],
            "additionalProperties": false
          },
          "deadline": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "brand": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "designer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "material": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "color": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "size": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "era": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "description"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_item",
      "description": "Inspect the requested product facts, seller claims, price, measurements, source evidence and photographs. Use prepare_checkout to request a seller route. Unknown IDs return not_found; no private records are exposed.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          }
        },
        "required": [
          "item_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "ask_seller",
      "description": "Ask a bounded product question using its item_id, or submit structured shopping requirements. With multiple items, item-specific questions require an item_id; none is assumed. Answers only supported questions from attributed catalog facts; otherwise not_known/no_match. A persisted receipt is not an answer or promise of a later reply. Free text is not retained, only generic categories and structured requirements. Payment capability is self-reported, never payment authority.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "condition",
              "measurements",
              "price",
              "availability",
              "shipping",
              "returns",
              "provenance",
              "other"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "shopping_brief": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "item_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "budget": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            },
            "required": [
              "amount",
              "currency"
            ],
            "additionalProperties": false
          },
          "deadline": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "payment_rail_capability": {
            "type": "string",
            "enum": [
              "stripe_token",
              "grok_vault",
              "x402",
              "other",
              "unknown"
            ]
          },
          "owner_approval_needed": {
            "type": "boolean"
          }
        },
        "required": [
          "topic"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "prepare_checkout",
      "description": "Record explicit purchase intent for one unit of a catalog item. When enabled and approved, return the seller checkout link. Obtain buyer approval before proceeding. This creates no order or payment and does not verify checkout was reached.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "purchase_intent": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "item_id",
          "purchase_intent"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "build.toggle/htam",
    "version": "0.2.1",
    "remoteUrl": "https://htam.toggle.build/api/mcp",
    "publishedAt": "2026-11-27T12:37:04.168129Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "e5a54ee7e38fbdd66ea8989466800662b5bcc8440390af099aef5bbf0053ec33"
  }
}
