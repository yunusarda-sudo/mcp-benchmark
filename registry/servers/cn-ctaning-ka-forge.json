{
  "$schema": "../schema.json",
  "name": "cn.ctaning/ka-forge",
  "title": "KA-Forge",
  "category": "Developer Tools & VCS",
  "description": "中文 AI 文本去 AI 腔改写：5 档强度，只改句子不改事实，网页 / API / MCP 三入口",
  "tools": [
    {
      "name": "rewrite",
      "description": "把一段中文改写成更自然、更像人写的版本（去 AI 腔）。返回改写后的正文。不带密钥也可调用，走匿名额度（站长可在后台关闭）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "要改写的原文，至少 10 字"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "改写强度：1 润色、2 轻改、3 中度、4 深度、5 重写。默认 1"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "quota",
      "description": "查今天还剩多少字：带密钥按账号/密钥额度，不带密钥按匿名额度（与免密钥 GET 接口共用）。",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "cn.ctaning/ka-forge",
    "version": "1.0.1",
