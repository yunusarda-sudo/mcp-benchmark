{
  "$schema": "../schema.json",
  "name": "com.swgbar/swg-bar",
  "title": "SWG bar",
  "category": "Design, UI & 3D Media",
  "description": "Search macOS corporate SWG and HTTPS/SSL inspection guides, release metadata, and license pricing.",
  "tools": [
    {
      "name": "search_documentation",
      "description": "Search SWG bar's published documentation in one of its 12 website languages. Returns source links and excerpts; cannot inspect a Mac or private data.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "locale": {
            "default": "en",
            "type": "string",
            "enum": [
              "en",
              "de",
              "es",
              "fr",
              "it",
              "ja",
              "ko",
              "pt-BR",
              "ru",
              "zh-CN",
              "zh-TW",
              "id"
            ]
          },
          "limit": {
            "default": 3,
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_documentation",
      "description": "Read a published SWG bar page as Markdown. Use a canonical page path returned by search_documentation, such as /en/install/. Only published public pages are available.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^\\/[A-Za-z0-9/-]+\\/$"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_latest_release",
      "description": "Get the current SWG bar installer version, download URL and SHA-256 checksum from the published release manifest.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_product_catalog",
      "description": "Read SWG bar Personal and Team license prices, supported quantities and browser purchase links. Does not create an order, charge payment or access a license.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "locale": {
            "default": "en",
            "type": "string",
            "enum": [
              "en",
              "de",
              "es",
              "fr",
              "it",
              "ja",
              "ko",
              "pt-BR",
              "ru",
              "zh-CN",
              "zh-TW",
              "id"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.swgbar/swg-bar",
    "version": "1.0.0",
    "remoteUrl": "https://swgbar.com/mcp",
    "publishedAt": "2026-11-25T03:54:02.863455Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "114173fde47968a4f5089901630c0f66e8ddf0b8c9c78161eff8e8774bb23015"
  }
}
