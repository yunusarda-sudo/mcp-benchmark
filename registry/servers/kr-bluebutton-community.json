{
  "$schema": "../schema.json",
  "name": "kr.bluebutton/community",
  "title": "BlueButton Community",
  "category": "Other",
  "description": "Search public posts of BlueButton Community (Korean AI/AX practitioners): titles, excerpts, links.",
  "tools": [
    {
      "name": "get_community_info",
      "description": "블루버튼 커뮤니티가 어떤 곳인지: 다루는 주제, 글 유형(질문·답변, AX 도입 사례, AI 개발·자동화 등), 이용 방법, 관련 서비스, 문의처.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "list_boards",
      "description": "커뮤니티 게시판(주제별)의 이름·설명·주소.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "list_posts",
      "description": "공개 글을 최신 순으로. 글 유형(kind)·게시판(board, list_boards 의 english_name)으로 거른다.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "kind": {
            "description": "question 질문·답변, case-study AX 도입 사례, tutorial AI 개발·자동화, showcase 만든 것, discussion 토론",
            "type": "string",
            "enum": [
              "question",
              "case-study",
              "tutorial",
              "showcase",
              "discussion"
            ]
          },
          "board": {
            "type": "string",
            "maxLength": 60,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "limit": {
            "description": "기본 10",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      }
    },
    {
      "name": "search_posts",
      "description": "공개 글을 제목·내용 낱말로 찾는다(예: \"RAG\", \"나라장터 AI 사업\", \"에이전트 권한\"). 결과는 제목·발췌·주소.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "kind": {
            "type": "string",
            "enum": [
              "question",
              "case-study",
              "tutorial",
              "showcase",
              "discussion"
            ]
          },
          "limit": {
            "description": "기본 8",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_post",
      "description": "공개 글 하나의 제목·유형·게시판·날짜·댓글/추천 수·평문 발췌(500자)·원문 주소. 본문 전체는 원문에서 읽는다.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "post_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "required": [
          "post_id"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "kr.bluebutton/community",
    "version": "1.0.0",
    "remoteUrl": "https://community.bluebutton.kr/mcp",
    "publishedAt": "2026-11-26T06:22:25.567263Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "0e60d06e56127daaf95c2b1b0e975f72ca7406ecd66abdbbbc8b0b18d7b78ead"
  }
}
