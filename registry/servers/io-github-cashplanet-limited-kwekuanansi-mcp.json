{
  "$schema": "../schema.json",
  "name": "io.github.CashPlanet-Limited/kwekuanansi-mcp",
  "title": "Kweku Anansi",
  "category": "Developer Tools & DevOps",
  "description": "African Living Memory, botanical names and recorded plant-compound associations.",
  "repository": "https://github.com/CashPlanet-Limited/kwekuanansi-mcp",
  "tools": [
    {
      "name": "search_living_memory",
      "description": "Use when the user asks to search Kweku Anansi or wants African historical, cultural, geographic or ecological context about named places, peoples, figures or events. Searches an editorial collection. Does not provide live jobs, clinical advice, current regulations or unrestricted web search.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500,
            "description": "Named African place, person, event, people or ecological topic to find."
          },
          "kind": {
            "type": "string",
            "enum": [
              "country",
              "place",
              "people",
              "water",
              "spiritual",
              "history",
              "market-norm",
              "hero",
              "event",
              "ecology"
            ]
          },
          "country": {
            "type": "string",
            "enum": [
              "algeria",
              "Algeria",
              "egypt",
              "Egypt",
              "libya",
              "Libya",
              "morocco",
              "Morocco",
              "sudan",
              "Sudan",
              "tunisia",
              "Tunisia",
              "benin",
              "Benin",
              "burkina-faso",
              "Burkina Faso",
              "cabo-verde",
              "Cabo Verde",
              "cote-divoire",
              "Côte d’Ivoire",
              "gambia",
              "The Gambia",
              "ghana",
              "Ghana",
              "guinea",
              "Guinea",
              "guinea-bissau",
              "Guinea-Bissau",
              "liberia",
              "Liberia",
              "mali",
              "Mali",
              "mauritania",
              "Mauritania",
              "niger",
              "Niger",
              "nigeria",
              "Nigeria",
              "senegal",
              "Senegal",
              "sierra-leone",
              "Sierra Leone",
              "togo",
              "Togo",
              "angola",
              "Angola",
              "cameroon",
              "Cameroon",
              "central-african-republic",
              "Central African Republic",
              "chad",
              "Chad",
              "dr-congo",
              "Democratic Republic of the Congo",
              "equatorial-guinea",
              "Equatorial Guinea",
              "gabon",
              "Gabon",
              "republic-of-the-congo",
              "Republic of the Congo",
              "sao-tome-and-principe",
              "São Tomé and Príncipe",
              "burundi",
              "Burundi",
              "comoros",
              "Comoros",
              "djibouti",
              "Djibouti",
              "eritrea",
              "Eritrea",
              "ethiopia",
              "Ethiopia",
              "kenya",
              "Kenya",
              "madagascar",
              "Madagascar",
              "malawi",
              "Malawi",
              "mauritius",
              "Mauritius",
              "mozambique",
              "Mozambique",
              "rwanda",
              "Rwanda",
              "seychelles",
              "Seychelles",
              "somalia",
              "Somalia",
              "south-sudan",
              "South Sudan",
              "tanzania",
              "Tanzania",
              "uganda",
              "Uganda",
              "zambia",
              "Zambia",
              "zimbabwe",
              "Zimbabwe",
              "botswana",
              "Botswana",
              "eswatini",
              "Eswatini",
              "lesotho",
              "Lesotho",
              "namibia",
              "Namibia",
              "south-africa",
              "South Africa"
            ],
            "description": "Optional exact displayed country name or lowercase slug; for example Ghana or ghana, Nigeria or nigeria."
          },
          "limit": {
            "default": 5,
            "description": "Number of records to return, from 1 to 10. Maximum 10; defaults to 5.",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_memory_entry",
      "description": "Read an exact public editorial entry using an id returned by search_living_memory. Do not invent entry IDs.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 180
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "get_collection_coverage",
      "description": "Check the size, categories and source version of the public Kweku Anansi collection. Does not imply clinical validation, current events coverage or live translation support.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "search_herbarium",
      "description": "Find botanical name records by scientific name, vernacular name or family in the Kweku Anansi Herbarium. Returns source-record identity and toxicity-flag status, never a safety clearance. Not for specimen identification, symptoms, treatment, dosing, preparation or clinical advice.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200,
            "description": "Scientific name, common/vernacular name or botanical family."
          },
          "limit": {
            "default": 5,
            "description": "Return 1 to 10 records; maximum 10, default 5.",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_plant_record",
      "description": "Read an exact Herbarium botanical identity record from a slug returned by search_herbarium. Common names are ambiguous. Not a specimen identification or medical advice service.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 150,
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "compare_plant_records",
      "description": "Compare two to four distinct botanical records using slugs returned by search_herbarium. Shows names, families, source toxicity flags and missing records side by side. Does not compare clinical efficacy or recommend plant substitution, ingestion or treatment.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slugs": {
            "minItems": 2,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 150,
              "pattern": "^[a-z0-9-]+$"
            }
          }
        },
        "required": [
          "slugs"
        ]
      }
    },
    {
      "name": "search_compound_records",
      "description": "Search public Duke CC0 compound associations projected from Kweku Anansi Herbarium source cards by compound name or InChIKey. For botanical/phytochemical reference research only. These are not new lab results, target predictions, clinical evidence or evidence of concentration, safety, dose or therapeutic effect.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200,
            "description": "Compound name, such as CATALPOL, or exact InChIKey."
          },
          "limit": {
            "default": 5,
            "description": "Return 1 to 10 associations. Maximum 10, default 5. totalMatches reports the full match count even when results are truncated.",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "lookup_language_term",
      "description": "Look up an exact Ga or Twi word or English meaning in source-checked lexical records. This does not verify pronunciation, translate arbitrary sentences or provide audio. Retain source rights and context.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "Ga",
              "Twi"
            ]
          },
          "term": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "limit": {
            "default": 3,
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "required": [
          "language",
          "term"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_language_entry",
      "description": "Read an exact lexical record ID returned by lookup_language_term. No guessed IDs, private recordings or bulk downloads.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_reviewed_opportunities",
      "description": "Search fresh reviewed public opportunities by explicit ISO country and topic. Distinguish sector signals, verified openings and published application routes; a route with unknown deadline is not an open cohort. No country inference from phone, personal profiling or eligibility decisions.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "kind": {
            "type": "string",
            "enum": [
              "sector_signal",
              "verified_opening",
              "verified_application_route"
            ]
          },
          "limit": {
            "default": 3,
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "required": [
          "country",
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_reviewed_opportunity",
      "description": "Read a returned opportunity ID only while its review is fresh and application deadline has not expired. Pass the explicit country when known; mismatches return not found. Stale, closed and withdrawn entries are withheld.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
