{
  "$schema": "../schema.json",
  "name": "network.moonbeam.next/api-onesource-io",
  "title": "api.onesource.io",
  "category": "Finance, Crypto & Web3",
  "description": "ERC20 token balance for any Ethereum wallet - USDC, USDT, DAI, or any token - via balanceOf (eth_cal",
  "tools": [
    {
      "name": "api_onesource_io_chain_erc20_balance",
      "description": "ERC20 token balance for any Ethereum wallet - USDC, USDT, DAI, or any token - via balanceOf (eth_call) on OneSource live Ethereum RPC 0.003 USDC a call.",
      "inputSchema": {
        "properties": {
          "address": {
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "type": "string"
          },
          "contract": {
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "type": "string"
          },
          "network": {
            "default": "ethereum",
            "enum": [
              "ethereum",
              "sepolia",
              "robinhood"
            ],
            "type": "string"
          }
        },
        "required": [
          "address",
          "contract"
        ],
        "type": "object"
      }
    },
    {
      "name": "api_onesource_io_chain_block_number",
      "description": "Latest Ethereum block height - current chain tip via eth_blockNumber 0.001 USDC a call.",
      "inputSchema": {
        "properties": {
          "network": {
            "default": "ethereum",
            "enum": [
              "ethereum",
              "sepolia",
              "robinhood"
            ],
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "api_onesource_io_chain_live_balance",
      "description": "Live wallet balance - native ETH plus up to 20 caller-supplied ERC20 tokens in one bounded RPC batch 0.003 USDC a call.",
      "inputSchema": {
        "properties": {
          "address": {
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "type": "string"
          },
          "network": {
            "default": "ethereum",
            "enum": [
              "ethereum",
              "sepolia",
              "robinhood"
            ],
            "type": "string"
          },
          "tokens": {
            "maxLength": 859,
            "pattern": "^0x[a-fA-F0-9]{40}(,0x[a-fA-F0-9]{40}){0,19}$",
            "type": "string"
          }
        },
        "required": [
          "address"
        ],
        "type": "object"
      }
    },
    {
      "name": "api_onesource_io_contract_address",
      "description": "Best-effort contract introspection via batched RPC - bytecode presence, token metadata, and ERC20-like/ERC721/ERC1155 classification 0.005 USDC a call.",
      "inputSchema": {
        "type": "object"
      }
    },
    {
      "name": "api_onesource_io_chain_erc20_transfers",
      "description": "ERC20 Transfer logs via eth_getLogs - raw Transfer events for a token or wallet 0.005 USDC a call.",
      "inputSchema": {
        "properties": {
          "address": {
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "type": "string"
          },
          "contract": {
            "pattern": "^0x[a-fA-F0-9]{40}$",
            "type": "string"
          },
          "from_block": {
            "oneOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "enum": [
                  "latest",
                  "pending",
                  "earliest",
                  "safe",
                  "finalized"
                ],
                "type": "string"
              },
              {
                "pattern": "^0[xX][a-fA-F0-9]+$",
                "type": "string"
              }
            ]
          },
          "network": {
            "default": "ethereum",
            "enum": [
              "ethereum",
              "sepolia",
              "robinhood"
            ],
            "type": "string"
          },
          "to_block": {
            "oneOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "enum": [
                  "latest",
                  "pending",
                  "earliest",
                  "safe",
                  "finalized"
                ],
                "type": "string"
              },
              {
                "pattern": "^0[xX][a-fA-F0-9]+$",
                "type": "string"
              }
            ]
          }
        },
        "type": "object"
      }
    }
  ],
