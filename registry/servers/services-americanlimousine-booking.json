{
  "$schema": "../schema.json",
  "name": "services.americanlimousine/booking",
  "title": "AmericanLimousine.Services",
  "category": "Travel, Maps & Navigation",
  "description": "Fixed-fare black car, limo, SUV, Sprinter and motorcoach service across the United States.",
  "tools": [
    {
      "name": "search_coverage",
      "description": "Find AmericanLimousine.Services pages for a city, airport, venue, event, service or topic. Returns titles, summaries and URLs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 8
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_page",
      "description": "Return the text of a page on www.americanlimousine.services (Markdown when available). Accepts a full URL or a path.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "get_booking_options",
      "description": "Services, vehicles, coverage, pricing rules, contact channels, the online booker link and booking policies.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "request_booking",
      "description": "Send a chauffeured transportation request to AmericanLimousine.Services for the traveller. Only call when the traveller explicitly asked to book. Returns a reference (ALS-XXXXXXX); the team confirms price, vehicle and chauffeur by email or phone. Not confirmed until then; nothing is charged.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Lead passenger full name"
          },
          "email": {
            "type": "string",
            "description": "Email (email or phone required)"
          },
          "phone": {
            "type": "string",
            "description": "Mobile with country code"
          },
          "service": {
            "type": "string",
            "enum": [
              "Airport transfer",
              "Private aviation / FBO",
              "Cruise port",
              "Train station",
              "Hourly / as directed",
              "Point to point",
              "City to city",
              "Corporate / road show",
              "Meetings and groups",
              "Wedding / event",
              "VIP / discreet"
            ]
          },
          "pickup": {
            "type": "string",
            "description": "Address, hotel, airport + terminal or venue"
          },
          "dropoff": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "description": "Local pickup date YYYY-MM-DD"
          },
          "time": {
            "type": "string",
            "description": "Local pickup time HH:MM"
          },
          "hours": {
            "type": "string",
            "description": "Hours needed for hourly / as-directed service"
          },
          "flight": {
            "type": "string"
          },
          "passengers": {
            "type": "integer",
            "minimum": 1
          },
          "bags": {
            "type": "integer",
            "minimum": 0
          },
          "vehicle": {
            "type": "string",
            "enum": [
              "Executive sedan",
              "Luxury sedan",
              "Executive SUV",
              "Luxury SUV",
              "Electric sedan/SUV",
              "Stretch limousine",
              "Stretch SUV limousine",
              "Executive Sprinter",
              "Party Sprinter",
              "Mini bus",
              "Motorcoach",
              "Wheelchair-accessible (WAV)"
            ]
          },
          "return": {
            "type": "string"
          },
          "notes": {
            "type": "string",
            "description": "Occasion, child seats, accessibility, stops"
          },
          "agent": {
            "type": "string",
            "description": "Name of your assistant or app"
          },
          "consent": {
            "type": "string",
            "enum": [
              "yes"
            ],
            "description": "The traveller explicitly asked for this booking"
          }
        },
        "required": [
          "name",
          "pickup",
          "dropoff",
          "date",
          "time",
          "consent"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "services.americanlimousine/booking",
    "version": "1.0.0",
    "remoteUrl": "https://www.americanlimousine.services/agent-api/mcp.php",
    "publishedAt": "2026-11-24T13:55:23.935421Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "db8bfcc0698f9f0eb12db52727ea3e165a4fcdf7ca9f461e9a97ce055e7fb4f2"
  }
}
