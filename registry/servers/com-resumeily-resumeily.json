{
  "$schema": "../schema.json",
  "name": "com.resumeily/resumeily",
  "title": "Resumeily",
  "category": "Communication & Alerting",
  "description": "Build ATS-friendly resumes in chat with 19 templates, preview them and save to Resumeily.",
  "tools": [
    {
      "name": "list_templates",
      "description": "Lists the Resumeily resume templates with their id, name, description and layout. The template ids are the accepted values of the `template` field.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "create_resume",
      "description": "Creates a temporary resume draft on Resumeily from structured resume content. Returns a preview of the first page, a private draft_token that identifies the draft, and an 'Open & Save on Resumeily' link where the resume can be saved to a Resumeily account.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "resume": {
            "type": "object",
            "properties": {
              "basic": {
                "type": "object",
                "properties": {
                  "firstName": {
                    "type": "string",
                    "maxLength": 100,
                    "description": "First name."
                  },
                  "lastName": {
                    "type": "string",
                    "maxLength": 100,
                    "description": "Last name."
                  },
                  "role": {
                    "type": "string",
                    "maxLength": 150,
                    "description": "Headline / target job title."
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "description": "Email address shown on the resume."
                  },
                  "phone": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "Phone number shown on the resume."
                  },
                  "location": {
                    "type": "string",
                    "maxLength": 150,
                    "description": "City, country."
                  },
                  "linkedIn": {
                    "type": "string",
                    "maxLength": 300,
                    "description": "LinkedIn profile URL."
                  },
                  "website": {
                    "type": "string",
                    "maxLength": 300,
                    "description": "Personal website or portfolio URL."
                  }
                }
              },
              "summary": {
                "type": "string",
                "maxLength": 6000,
                "description": "Professional summary, 3–6 sentences."
              },
              "experience": {
                "maxItems": 15,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "position": {
                      "type": "string",
                      "maxLength": 200,
                      "description": "Job title."
                    },
                    "company": {
                      "type": "string",
                      "maxLength": 200,
                      "description": "Employer name."
                    },
                    "location": {
                      "type": "string",
                      "maxLength": 200,
                      "description": "City, country or 'Remote'."
                    },
                    "startDate": {
                      "type": "string",
                      "maxLength": 20,
                      "description": "Start date. Format YYYY-MM (or YYYY)."
                    },
                    "endDate": {
                      "type": "string",
                      "maxLength": 20,
                      "description": "End date. Omit when current is true. Format YYYY-MM (or YYYY)."
                    },
                    "current": {
                      "description": "True if this is the current job.",
                      "type": "boolean"
                    },
                    "bullets": {
                      "description": "Achievement bullet points (preferred). Plain text, one achievement each.",
                      "maxItems": 30,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 600
                      }
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 6000,
                      "description": "Alternative to bullets: description as plain text or simple HTML (<p>, <ul>, <li>, <strong>, <em>)."
                    }
                  }
                }
              },
              "education": {
                "maxItems": 15,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "school": {
                      "type": "string",
                      "maxLength": 200,
                      "description": "School or university."
                    },
                    "degree": {
                      "type": "string",
                      "maxLength": 200,
                      "description": "Degree, e.g. 'B.Sc.'."
                    },
                    "field": {
                      "type": "string",
                      "maxLength": 200,
                      "description": "Field of study."
                    },
                    "location": {
                      "type": "string",
                      "maxLength": 200,
                      "description": "City, country."
                    },
                    "startDate": {
                      "type": "string",
                      "maxLength": 20,
                      "description": "Start date. Format YYYY-MM (or YYYY)."
                    },
                    "endDate": {
                      "type": "string",
                      "maxLength": 20,
                      "description": "End or expected graduation date. Format YYYY-MM (or YYYY)."
                    },
                    "gpa": {
                      "type": "string",
                      "maxLength": 40,
                      "description": "Grade / GPA, if the user wants it shown."
                    }
                  }
                }
              },
              "skills": {
                "maxItems": 60,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 80
                }
              },
              "languages": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "language": {
                      "type": "string",
                      "maxLength": 80,
                      "description": "Language name."
                    },
                    "level": {
                      "type": "string",
                      "maxLength": 80,
                      "description": "Proficiency, e.g. Native, Fluent, B2."
                    }
                  },
                  "required": [
                    "language"
                  ]
                }
              },
              "projects": {
                "maxItems": 15,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "maxLength": 200,
                      "description": "Project name."
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 6000,
                      "description": "What it does, tech used and outcome. Plain text or simple HTML."
                    },
                    "bullets": {
                      "maxItems": 30,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 600
                      }
                    },
                    "link": {
                      "type": "string",
                      "maxLength": 300,
                      "description": "Public URL of the project, if any."
                    }
                  },
                  "required": [
                    "title"
                  ]
                }
              },
              "courses": {
                "maxItems": 15,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "courseName": {
                      "type": "string",
                      "maxLength": 200,
                      "description": "Course or certification name."
                    },
                    "institute": {
                      "type": "string",
                      "maxLength": 200,
                      "description": "Issuing organisation."
                    },
                    "startDate": {
                      "type": "string",
                      "maxLength": 20,
                      "description": "Start date. Format YYYY-MM (or YYYY)."
                    },
                    "endDate": {
                      "type": "string",
                      "maxLength": 20,
                      "description": "Completion date. Format YYYY-MM (or YYYY)."
                    }
                  },
                  "required": [
                    "courseName"
                  ]
                }
              },
              "hobbies": {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 80
                }
              }
            },
            "description": "Resume content. Every section is optional."
          },
          "title": {
            "description": "Resume title, e.g. 'Jane Doe – Frontend Developer'.",
            "type": "string",
            "maxLength": 120
          },
          "template": {
            "description": "Template id, such as 'classic', 'modern' or 'slate'. Defaults to 'classic'.",
            "type": "string",
            "maxLength": 40
          },
          "colors": {
            "type": "object",
            "properties": {
              "primary": {
                "description": "Accent colour, hex like #4A6CF7.",
                "type": "string",
                "maxLength": 9
              },
              "secondary": {
                "type": "string",
                "maxLength": 9
              },
              "text": {
                "type": "string",
                "maxLength": 9
              }
            }
          },
          "font": {
            "description": "One of: Arial, Helvetica, Times New Roman, Georgia, Verdana, Courier New, Roboto, Open Sans, Lato, Montserrat, Poppins, Rubik, Inter, Playfair Display, Merriweather.",
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "resume"
        ]
      }
    },
