{
  "$schema": "../schema.json",
  "name": "net.hyppe/mcp",
  "title": "Hyppe — find a business that can do the job",
  "category": "E-Commerce & Retail",
  "description": "Find local bike shops and services in Colombia and Germany; talk to one for a human.",
  "tools": [
    {
      "name": "find_tenants",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 300,
            "description": "What the business should be able to do, e.g. \"chain change for a road bike\"."
          },
          "city": {
            "type": "string",
            "maxLength": 120,
            "description": "City name, e.g. \"Bogotá\"."
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "description": "ISO 3166-1 alpha-2 country code, e.g. \"CO\"."
          },
          "vertical": {
            "type": "string",
            "maxLength": 60,
            "description": "Canonical business category slug, when the agent already knows it, e.g. \"bicycle_shop\"."
          },
          "radius_km": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Search radius in kilometres. Defaults to 25, capped at 100."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "Maximum number of results. Defaults to 10."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_tenant",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tenant_ref": {
            "type": "string",
            "maxLength": 120,
            "description": "The tenant reference returned by find_tenants."
          }
        },
        "required": [
          "tenant_ref"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "chat_with_tenant",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tenant_ref": {
            "type": "string",
            "maxLength": 120,
            "description": "The tenant reference returned by find_tenants or get_tenant."
          },
          "session_id": {
            "type": "string",
            "maxLength": 200,
            "description": "A stable id for THIS agent conversation. The same session_id continues the same thread; a new one starts a new thread."
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "The message to send to the business's assistant."
          }
        },
        "required": [
          "tenant_ref",
          "session_id",
          "message"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "capture_lead",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tenant_ref": {
            "type": "string",
            "maxLength": 120,
            "description": "The tenant reference returned by find_tenants or get_tenant."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "The person's full name, as they gave it."
          },
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "The person's phone number, exactly as they gave it."
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "The person's email, when they gave one."
          },
          "summary": {
            "type": "string",
            "maxLength": 600,
            "description": "A short, factual summary of what the person needs. Never include credentials or card numbers."
          },
          "session_id": {
            "type": "string",
            "maxLength": 200,
            "description": "The session_id of a chat_with_tenant conversation, when this capture continues one."
          }
        },
        "required": [
          "tenant_ref",
          "name",
          "phone"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "create_booking_request",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tenant_ref": {
            "type": "string",
            "maxLength": 120,
            "description": "The tenant reference returned by find_tenants or get_tenant."
          },
          "service": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "The service or item to book, as the business lists it."
          },
          "date": {
            "type": "string",
            "description": "The requested date, ISO format YYYY-MM-DD."
          },
          "time": {
            "type": "string",
            "description": "The requested time, 24-hour format HH:MM."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "The person's full name."
          },
          "phone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "The person's phone number."
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "The person's email, when they gave one."
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of people or guests, for a service that takes a count."
          },
          "end_date": {
            "type": "string",
            "description": "For a stay or range booking, the check-out date in ISO format YYYY-MM-DD."
          },
          "session_id": {
            "type": "string",
            "maxLength": 200,
            "description": "The session_id of a chat_with_tenant conversation, when this request continues one."
          }
        },
        "required": [
          "tenant_ref",
          "service",
          "date",
          "time",
          "name",
          "phone"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_booking_status",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tenant_ref": {
            "type": "string",
            "maxLength": 120,
            "description": "The tenant reference returned by find_tenants or get_tenant."
          },
          "request_id": {
            "type": "integer",
            "description": "The request_id returned by create_booking_request."
          }
        },
        "required": [
          "tenant_ref",
          "request_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "net.hyppe/mcp",
    "version": "0.1.0",
    "remoteUrl": "https://mcp.hyppe.net/mcp",
    "publishedAt": "2026-11-26T18:32:50.196473Z",
