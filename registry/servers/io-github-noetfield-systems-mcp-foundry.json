{
  "$schema": "../schema.json",
  "name": "io.github.Noetfield-Systems/mcp-foundry",
  "title": "MCP Foundry — Build, Test & Publish MCP Servers",
  "category": "Developer Tools & DevOps",
  "description": "Build, test, publish and manage real MCP servers from APIs with a live developer studio.",
  "repository": "https://github.com/Noetfield-Systems/MCP",
  "tools": [
    {
      "name": "open_foundry_app",
      "description": "Open interactive Foundry directory and authenticated Builder workspace in a compatible MCP Apps host.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    },
    {
      "name": "search_servers",
      "description": "Search published public MCP servers in MCP Foundry",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    {
      "name": "get_server_tools",
      "description": "List tools published by one MCP Foundry server",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "get_commercial_offers",
      "description": "Read native Foundry integration offers, scope, prices and purchase links. No purchase or order is created.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    },
    {
      "name": "recommend_commercial_offer",
      "description": "Match a self-reported API scope to existing Foundry offers or scope review. No purchase, contact submission or guaranteed compatibility.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "public_https": {
            "type": "boolean"
          },
          "requires_auth": {
            "type": "boolean"
          },
          "requires_write": {
            "type": "boolean"
          },
          "get_tools": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "api_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "prefer_self_serve": {
            "type": "boolean"
          }
        },
        "required": [
          "public_https",
          "requires_auth",
          "requires_write",
          "get_tools",
          "api_count"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.Noetfield-Systems/mcp-foundry",
    "version": "0.1.0",
    "remoteUrl": "https://mcp-foundry-web-production.up.railway.app/mcp/foundry",
    "publishedAt": "2026-11-18T02:57:35.992642Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "07a21552e40ecab8ad677246b194cc6cf2168fcee2687e4c7b839045cdd8725b"
  }
}
