{
  "$schema": "../schema.json",
  "name": "com.rvchess/mcp",
  "title": "RV Chess",
  "category": "AI, LLMs & Agents",
  "description": "Interactive Stockfish 19 chess review & boards for MCP Apps hosts (Claude, ChatGPT).",
  "tools": [
    {
      "name": "list_games",
      "description": "Find up to five recent public games for a confirmed Chess.com or Lichess username. Use for review-my-game onboarding or a saved chess account. Returns newest-first choices and game links for review_game; it does not review games, save a username or establish that either player is the user.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "site": {
            "type": "string",
            "enum": [
              "chesscom",
              "lichess"
            ]
          },
          "username": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 5
          }
        },
        "required": [
          "site",
          "username"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "review_game",
      "description": "Use when the user asks to review or analyse a chess game, including a pasted Chess.com link. Accepts a Chess.com/Lichess game URL or PGN. Imports using the existing RV Chess adapter and opens its interactive board, which automatically runs RV Chess analysis and sends results back into the chat. The server does not run Stockfish.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "ply": {
            "type": "integer",
            "minimum": 0,
            "maximum": 160
          },
          "depth": {
            "type": "integer",
            "minimum": 12,
            "maximum": 25,
            "default": 18
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "open_mode",
      "description": "Open the original RV Chess play view for Drawfish or another named bot/rule mode. With no name, open the mode directory. Returns the existing mode catalog; do not invent modes or claim a game has started before the user starts it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "open_opening",
      "description": "Open a named chess opening or variation from the existing RV Chess opening bank, such as French Defense, Sicilian Defense or French Defense: Advance Variation. Returns its actual book move order, variations and website guide link, and opens that line on the RV Chess interactive board. Browser Stockfish evaluates the final book position; book moves are not a played game and must not be graded as mistakes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "depth": {
            "type": "integer",
            "minimum": 12,
            "maximum": 25,
            "default": 18
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "analyze_position",
      "description": "Open the RV Chess interactive board for a FEN and optional SAN history. RV Chess runs its existing browser engine and gives the resulting evaluation and lines to the conversation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fen": {
            "type": "string",
            "maxLength": 200,
            "default": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
          },
          "moves": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            "maxItems": 600,
            "default": []
          },
          "expectedFen": {
            "type": "string",
            "maxLength": 200
          },
          "depth": {
            "type": "integer",
            "minimum": 12,
            "maximum": 25,
            "default": 18
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "compare_moves",
      "description": "Answer why a move is better using 2–5 legal SAN candidates from the exact selected position. Supply initial FEN, SAN history and expectedFen from board context. RV Chess searches requested alternatives and engine choices together at the same root and depth and sends scores and legal continuations back to chat.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fen": {
            "type": "string",
            "maxLength": 200,
            "default": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
          },
          "moves": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            "maxItems": 600,
            "default": []
          },
          "expectedFen": {
            "type": "string",
            "maxLength": 200
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            "minItems": 2,
            "maxItems": 5
          },
          "depth": {
            "type": "integer",
            "minimum": 12,
            "maximum": 25,
            "default": 18
          }
        },
        "required": [
          "candidates"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "evaluate_hypothesis",
      "description": "Answer what changes if a specified piece were on another empty square. Supply exact selected history and expectedFen, explicit source square, destination and piece role. This is a hypothetical setup, not a played move: preserves side to move, resets castling/en-passant/repetition and rejects illegal setups. RV Chess searches both original and edited positions and displays the edited board.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "fen": {
            "type": "string",
            "maxLength": 200,
            "default": "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
          },
          "moves": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            "maxItems": 600,
            "default": []
          },
          "expectedFen": {
            "type": "string",
            "maxLength": 200
          },
          "edit": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^[a-h][1-8]$"
              },
              "to": {
                "type": "string",
                "pattern": "^[a-h][1-8]$"
              },
              "piece": {
                "type": "string",
                "enum": [
                  "pawn",
                  "knight",
                  "bishop",
                  "rook",
                  "queen",
                  "king"
                ]
              }
            },
            "required": [
              "from",
              "to",
              "piece"
            ],
            "additionalProperties": false
          },
          "depth": {
            "type": "integer",
            "minimum": 12,
            "maximum": 25,
            "default": 18
          }
        },
        "required": [
          "edit"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "review_move",
      "description": "Open the selected played move on the RV Chess board. RV Chess runs its existing same-root verifier and returns its assessment and board-proven explanation to chat. Input full PGN plus 1-based half-move index from the board context.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pgn": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "ply": {
            "type": "integer",
            "minimum": 1,
            "maximum": 160
          },
          "depth": {
            "type": "integer",
            "minimum": 12,
            "maximum": 25,
            "default": 18
          }
        },
        "required": [
          "pgn",
          "ply"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.rvchess/mcp",
    "version": "0.3.0",
    "remoteUrl": "https://rvchess.com/api/chess-mcp",
    "publishedAt": "2026-11-27T22:03:31.445376Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "590cc779383cb147cbe1c32aa3f1e67b749b1728c6ef26415d4c4ab9aaa94efe"
  }
}
