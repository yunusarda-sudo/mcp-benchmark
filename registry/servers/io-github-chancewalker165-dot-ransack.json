{
  "$schema": "../schema.json",
  "name": "io.github.chancewalker165-dot/ransack",
  "title": "Ransack",
  "category": "Vector DBs & AI Search",
  "description": "Web search, page fetch and cited research for AI agents: 26 engines, 8 tools, one key, from $15/mo.",
  "repository": "https://github.com/chancewalker165-dot/ransack-server",
  "tools": [
    {
      "name": "ransack",
      "description": "Search, fetch, and research the live web. Modes: search, fetch, discover, hosts (7 keyless sources), shop, verify, help. format=markdown|json|hybrid. Every result is tagged with the engine that found it. Run mode='help' for the full manual (parameters, limits, error codes, data caveats) before guessing.",
      "inputSchema": {
        "properties": {
          "query": {
            "default": "",
            "title": "Query",
            "type": "string"
          },
          "url": {
            "default": "",
            "title": "Url",
            "type": "string"
          },
          "mode": {
            "default": "search",
            "title": "Mode",
            "type": "string"
          },
          "max_results": {
            "default": 5,
            "title": "Max Results",
            "type": "integer"
          },
          "format": {
            "default": "markdown",
            "title": "Format",
            "type": "string"
          },
          "freshness": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Freshness"
          },
          "compress": {
            "default": false,
            "title": "Compress",
            "type": "boolean"
          },
          "max_chars": {
            "default": 200000,
            "title": "Max Chars",
            "type": "integer"
          },
          "max_urls": {
            "default": 50,
            "title": "Max Urls",
            "type": "integer"
          },
          "verbose": {
            "default": true,
            "title": "Verbose",
            "type": "boolean"
          },
          "crypto": {
            "default": true,
            "title": "Crypto",
            "type": "boolean"
          },
          "detail": {
            "default": "concise",
            "title": "Detail",
            "type": "string"
          },
          "background": {
            "default": false,
            "title": "Background",
            "type": "boolean"
          },
          "must_contain": {
            "default": "",
            "title": "Must Contain",
            "type": "string"
          }
        },
        "type": "object",
        "title": "ransackArguments"
      }
    },
    {
      "name": "youtube",
      "description": "Retrieve the transcript from a YouTube video URL or 11-character video ID (not a keyword search). start/end (seconds or mm:ss) keep only that window of a long transcript. Summaries and chapters are not offered. Limits: 120/min. See ransack(mode='help').",
      "inputSchema": {
        "properties": {
          "url": {
            "title": "Url",
            "type": "string"
          },
          "start": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start"
          },
          "end": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "End"
          }
        },
        "required": [
          "url"
        ],
        "type": "object",
        "title": "_youtube_trackedArguments"
      }
    },
    {
      "name": "tasks_get",
      "description": "Retrieve the status and result of an asynchronous task started by ransack(mode='fetch', background=true). Limits: 120/min. Error -32029 = rate limited, wait retry_after_s. See ransack(mode='help').",
      "inputSchema": {
        "properties": {
          "taskId": {
            "title": "Taskid",
            "type": "string"
          }
        },
        "required": [
          "taskId"
        ],
        "type": "object",
        "title": "tasks_getArguments"
      }
    },
    {
      "name": "get_report",
      "description": "Retrieve a persisted research report and its citation map by report_id (legacy: reports produced before the research lane was retired 2026-09-20). Limits: 120/min. See ransack(mode='help').",
      "inputSchema": {
        "properties": {
          "report_id": {
            "title": "Report Id",
            "type": "string"
          }
        },
        "required": [
          "report_id"
        ],
        "type": "object",
        "title": "get_reportArguments"
      }
    },
    {
      "name": "search_memory",
      "description": "Query the semantic index of prior fetched web content (pages, articles, transcripts). NOT conversational history: it recalls indexed content by meaning and keywords, not your past queries. Limits: 120/min. See ransack(mode='help').",
      "inputSchema": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "limit": {
            "default": 5,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "type": "object",
        "title": "search_memoryArguments"
      }
    },
    {
      "name": "search",
      "description": "Search the live web. Thin alias of ransack(mode='search') for hosts that require tools literally named search and fetch (ChatGPT Deep Research); results carry the engine that found each one. Run ransack(mode='help') for the full manual.",
      "inputSchema": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "max_results": {
            "default": 5,
            "title": "Max Results",
            "type": "integer"
          },
          "freshness": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Freshness"
          }
        },
        "required": [
          "query"
        ],
        "type": "object",
        "title": "search_aliasArguments"
      }
    },
    {
      "name": "fetch",
      "description": "Fetch a URL and return its readable content. Thin alias of ransack(mode='fetch') for hosts that require tools literally named search and fetch (ChatGPT Deep Research). Run ransack(mode='help') for the full manual.",
      "inputSchema": {
        "properties": {
          "url": {
            "title": "Url",
            "type": "string"
          },
          "max_chars": {
            "default": 200000,
            "title": "Max Chars",
            "type": "integer"
          }
        },
        "required": [
          "url"
        ],
        "type": "object",
        "title": "fetch_aliasArguments"
      }
    }
  ],
