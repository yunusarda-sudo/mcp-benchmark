{
  "$schema": "../schema.json",
  "name": "io.github.Joe-You-Know/constructive-runtime-evaluation",
  "title": "ConstructiveRT Evaluation",
  "category": "Developer Tools & DevOps",
  "description": "Free byte-exact CRTG4 vs gzip-6 research evaluation, benchmarks and experimental runtime discovery.",
  "repository": "https://github.com/Joe-You-Know/constructive-runtime-methodology",
  "tools": [
    {
      "name": "crt_evaluation_mcp_evaluate_workload",
      "description": "Compare CRTG4 and gzip-6 on nonconfidential text/base64 or synthetic fixtures (max 64 KiB). No input storage by this app; public hosting may log requests.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "sparse-defects",
              "repeat",
              "mixed",
              "random",
              "text",
              "base64"
            ],
            "description": "",
            "default": "sparse-defects"
          },
          "payload": {
            "type": "string",
            "description": ""
          },
          "size_bytes": {
            "type": "integer",
            "description": "",
            "default": 65536
          },
          "seed": {
            "type": "integer",
            "description": "",
            "default": 54
          },
          "purpose": {
            "type": "string",
            "enum": [
              "unspecified",
              "external-evaluation",
              "operator-test"
            ],
            "description": "",
            "default": "unspecified"
          }
        }
      }
    },
    {
      "name": "crt_evaluation_mcp_verify_reconstruction",
      "description": "Reconstruct a fresh CRTG4 stream from public source bytes and compare an independently supplied SHA-256. Does not accept arbitrary encoded streams.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source_base64": {
            "type": "string",
            "description": ""
          },
          "expected_sha256": {
            "type": "string",
            "description": ""
          }
        }
      }
    },
    {
      "name": "crt_evaluation_mcp_calculate_storage_economics",
      "description": "Estimate storage-only cost from measured encoded sizes; decimal GB. Does not extrapolate codec speed or paid product benefits.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "gzip_bytes": {
            "type": "integer",
            "description": "",
            "default": 5731
          },
          "crtg4_bytes": {
            "type": "integer",
            "description": "",
            "default": 3129
          },
          "copies": {
            "type": "integer",
            "description": "",
            "default": 1
          },
          "usd_per_gb_month": {
            "type": "number",
            "description": "",
            "default": 0.02
          },
          "months": {
            "type": "integer",
            "description": "",
            "default": 1
          }
        }
      }
    },
    {
      "name": "crt_evaluation_mcp_assess_runtime_fit",
      "description": "Assess declared fit for the separate paid experimental compiler runtime, not CRTG4. Returns a storefront only for a compatible, explicitly authorized experimental evaluation. No order creation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "Windows x64",
              "other",
              "unknown"
            ],
            "description": "",
            "default": "unknown"
          },
          "compatible_compiler_workflow": {
            "type": "boolean",
            "description": ""
          },
          "toolchain_ready": {
            "type": "boolean",
            "description": ""
          },
          "accepts_experimental_limits": {
            "type": "boolean",
            "description": ""
          },
          "requires_production_security": {
            "type": "boolean",
            "description": "",
            "default": true
          },
          "buyer_authorized": {
            "type": "boolean",
            "description": ""
          },
          "wants_experimental_evaluation": {
            "type": "boolean",
            "description": ""
          },
          "purpose": {
            "type": "string",
            "enum": [
              "unspecified",
              "external-evaluation",
              "operator-test"
            ],
            "description": "",
            "default": "unspecified"
          }
        }
      }
    },
    {
      "name": "crt_evaluation_mcp_get_purchase_link",
      "description": "Return an attributed public storefront URL only if the fixed live offer reports purchasing available. Never posts to checkout.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "unspecified",
              "external-evaluation",
              "operator-test"
            ],
            "description": "",
            "default": "unspecified"
          }
        }
      }
    },
    {
      "name": "crt_evaluation_mcp_get_product_status",
      "description": "Read the fixed public live product-status endpoint. Never creates an order.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "crt_evaluation_mcp_get_benchmark_results",
      "description": "Get the pinned developer-run CRTG4 benchmark sizes, including losses and controls.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "crt_evaluation_mcp_get_purchase_requirements",
      "description": "Read the separate experimental runtime's purchase requirements and limits. No checkout initiation.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "crt_evaluation_mcp_get_usage_summary",
      "description": "Read anonymous process-lifetime event counters without incrementing them. Caller purpose is self-declared, not verified identity.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    }
  ],
