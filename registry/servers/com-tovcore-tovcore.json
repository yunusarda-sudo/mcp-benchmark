{
  "$schema": "../schema.json",
  "name": "com.tovcore/tovcore",
  "title": "TovCore",
  "category": "E-Commerce & Retail",
  "description": "Theologically reviewed worship catalog (42,986 songs), Scripture lookup & Sunday setlists.",
  "repository": "https://github.com/JoshLabs-App/tovcore-mcp",
  "tools": [
    {
      "name": "get_system_manifest",
      "description": "[Tier 0 · meta] Return TovCore capability domains, theological scoring rules (0-10 & D-428 Bethel guard), 5 core scenarios, and tool index.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "search_songs",
      "description": "[Tier 0 · catalog] Search worship songs by keyword, artist, language (zh/en/ko/ja), minimum theological score, tempo, or negative exclusions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Title, English title, artist, or theme keyword"
          },
          "lang": {
            "type": "string",
            "enum": [
              "zh",
              "en",
              "ko",
              "ja"
            ],
            "description": "Optional language filter"
          },
          "minScore": {
            "type": "number",
            "description": "Minimum theological score (0..10), e.g. 8.0"
          },
          "tempo": {
            "type": "string",
            "enum": [
              "fast",
              "slow"
            ],
            "description": "Optional tempo filter"
          },
          "includeBethel": {
            "type": "boolean",
            "description": "Defaults to false (D-428 guard)"
          },
          "excludeIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Song IDs to exclude"
          },
          "excludeKeywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Negative constraint keywords/artists to exclude"
          },
          "limit": {
            "type": "number",
            "description": "Max results (1..30, default 10)"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "search_by_scripture",
      "description": "[Tier 0 · catalog] Find worship songs anchored to a Bible book or scripture theme (e.g. 诗篇, Psalms, 罗马书, Romans, 约翰福音, 十字架).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scripture": {
            "type": "string",
            "description": "Bible book name (Chinese or English) or scripture reference"
          },
          "lang": {
            "type": "string",
            "enum": [
              "zh",
              "en",
              "ko",
              "ja"
            ],
            "description": "Optional language filter"
          },
          "minScore": {
            "type": "number",
            "description": "Minimum theological score (default 7.5)"
          },
          "limit": {
            "type": "number",
            "description": "Max results (1..30, default 10)"
          }
        },
        "required": [
          "scripture"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_song_detail",
      "description": "[Tier 0 · catalog] Get full song profile including R2 TOVPACK2 theological evaluation (summary, B/F/C/R scores, reasons, hits, focus Q&A, scripture refs), metadata, and canonical/Markdown URLs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "songId": {
            "type": "string",
            "description": "Song ID (e.g. t01, 20105, en-3c3cd582)"
          }
        },
        "required": [
          "songId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_popular_songs",
      "description": "[Tier 0 · insights] List popular worship songs and community vote totals from D1, enriched with title/artist/score.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Max items (1..50, default 15)"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "plan_worship_setlist",
      "description": "[Tier 0 · worship] Generate a deterministic worship setlist (opening fast -> proclamation -> response slow) honoring theological score, scripture, D-428 rules, and negativeConstraints.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "theme": {
            "type": "string",
            "description": "Optional worship theme keyword (e.g. 十字架, 恩典, 复兴)"
          },
          "scripture": {
            "type": "string",
            "description": "Optional Bible book/reference (e.g. 诗篇, 罗马书, Psalms)"
          },
          "lang": {
            "type": "string",
            "enum": [
              "zh",
              "en",
              "ko",
              "ja"
            ],
            "description": "Preferred language (default zh)"
          },
          "count": {
            "type": "number",
            "description": "Number of songs (2..8, default 4)"
          },
          "minScore": {
            "type": "number",
            "description": "Minimum theological score (default 8.0)"
          },
          "tempoPreference": {
            "type": "string",
            "enum": [
              "balanced",
              "fast",
              "slow"
            ],
            "description": "Overall tempo preference"
          },
          "excludeSongIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Song IDs to exclude"
          },
          "negativeConstraints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Hard negative constraints from user corrections (artists, titles, styles, or keywords to avoid)"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "audit_setlist",
      "description": "[Tier 0 · worship] Batch theological & tempo audit for 1-20 candidate songs (IDs or titles). Flags scores below threshold, D-428 Bethel hits, tempo balance, and suggests safer replacements.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "songs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ordered list of song IDs or song titles to audit (1..20)"
          },
          "minScore": {
            "type": "number",
            "description": "Recommended congregational floor (default 8.0)"
          }
        },
        "required": [
          "songs"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "find_similar_songs",
      "description": "[Tier 0 · worship] Find theologically solid alternative worship songs sharing theme, scripture, language, or tempo with a seed song (respecting D-428 guard).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "songId": {
            "type": "string",
            "description": "Seed song ID or title"
          },
          "minScore": {
            "type": "number",
            "description": "Minimum theological score for alternatives (default 8.0)"
          },
          "sameLang": {
            "type": "boolean",
            "description": "Restrict to same language (default true)"
          },
          "limit": {
            "type": "number",
            "description": "Max results (1..15, default 5)"
          }
        },
        "required": [
          "songId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_my_playlists",
      "description": "[Tier 0 · personal] Read the authenticated user playlists (requires Bearer JWT or Personal AI Token tvc_...) to avoid repeating recently sung songs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "Max playlists to return (1..30, default 10)"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "propose_setlist_save",
      "description": "[Tier 1 · worship] Stage a new worship setlist proposal card for 1-tap owner confirmation inside TovCore (persisted to owner inbox if authenticated; never mutates playlists directly).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Setlist title (e.g. 主日敬拜 2026-11-29)"
          },
          "songIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ordered list of song IDs (1..30)"
          },
          "idempotency_key": {
            "type": "string",
            "description": "Stable key per user intent"
          },
          "notes": {
            "type": "string",
            "description": "Optional worship leader notes"
          }
        },
        "required": [
          "title",
          "songIds",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "propose_playlist_patch",
      "description": "[Tier 1 · worship] Stage a proposal to update/replace songs in an existing user playlist (two-phase confirmation; never mutates directly).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "playlistId": {
            "type": "string",
            "description": "Target playlist ID from get_my_playlists"
          },
          "title": {
            "type": "string",
            "description": "Updated playlist title"
          },
          "songIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Proposed full ordered song IDs (1..30)"
          },
          "idempotency_key": {
            "type": "string",
            "description": "Stable key per user intent"
          },
          "reason": {
            "type": "string",
            "description": "Brief explanation of replacements/changes"
          }
        },
        "required": [
          "playlistId",
          "title",
          "songIds",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "propose_live_queue",
      "description": "[Tier 1 · worship] Stage a Group Live / TV Cast worship queue proposal so the worship leader can tap once in TovCore to launch live projection or group sync.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Live worship session title"
          },
          "songIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ordered song IDs for projection/live queue (1..20)"
          },
          "idempotency_key": {
            "type": "string",
            "description": "Stable key per session"
          },
          "notes": {
            "type": "string",
            "description": "Optional leader cues (transitions, scripture reading)"
          }
        },
        "required": [
          "title",
          "songIds",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_my_proposals",
      "description": "[Tier 0 · personal] List pending/recent proposals in the authenticated user inbox (requires Bearer JWT or Personal AI Token tvc_...).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "rejected",
              "all"
            ],
            "description": "Filter by status (default pending)"
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.tovcore/tovcore",
    "version": "2.1.11",
    "remoteUrl": "https://tovcore.com/api/mcp",
    "publishedAt": "2026-11-28T04:54:49.144859Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
