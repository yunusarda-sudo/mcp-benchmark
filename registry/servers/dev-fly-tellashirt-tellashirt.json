{
  "$schema": "../schema.json",
  "name": "dev.fly.tellashirt/tellashirt",
  "title": "Tellashirt",
  "category": "Design, UI & 3D Media",
  "description": "Design custom t-shirts and hoodies in conversation; printed and shipped on demand.",
  "tools": [
    {
      "name": "list_products",
      "description": "List the Tellashirt catalog (tee and hoodie) with locked retail prices, colors, sizes, size upcharges and print specs.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "create_design",
      "description": "Register customer artwork (URL or file reference), validate its resolution against the print spec, and screen it against the day-one IP rule. Returns a designId, or a refusal for third-party logos/characters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "artworkUrl": {
            "type": "string",
            "description": "Public URL of the artwork file (PNG preferred)."
          },
          "fileRef": {
            "type": "string",
            "description": "Reference to an uploaded artwork file."
          },
          "widthPx": {
            "type": "number"
          },
          "heightPx": {
            "type": "number"
          },
          "productId": {
            "type": "string",
            "enum": [
              "tee",
              "hoodie"
            ]
          },
          "description": {
            "type": "string",
            "description": "What the artwork depicts (used for the IP screen)."
          },
          "usesThirdPartyIp": {
            "type": "boolean",
            "description": "True if the design uses logos/characters owned by someone else."
          }
        }
      }
    },
    {
      "name": "render_mockup",
      "description": "Render a mockup preview of a design on a product/color. The customer MUST approve this mockup before place_order — it is the non-negotiable quality step.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "designId": {
            "type": "string"
          },
          "productId": {
            "type": "string",
            "enum": [
              "tee",
              "hoodie"
            ]
          },
          "color": {
            "type": "string"
          },
          "size": {
            "type": "string",
            "description": "Optional; pins the exact live variant used for the mockup."
          }
        },
        "required": [
          "designId"
        ]
      }
    },
    {
      "name": "quote",
      "description": "Exact delivered total for a product/size/color: retail price + size upcharge + US shipping + tax estimate, broken out line by line. No charge happens here.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "enum": [
              "tee",
              "hoodie"
            ]
          },
          "size": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "destinationCountry": {
            "type": "string"
          }
        },
        "required": [
          "productId",
          "size"
        ]
      }
    },
    {
      "name": "place_order",
      "description": "Place an order after explicit customer approval. Requires approved, mockupApproved and ipAttested to all be true. Creates a Stripe PaymentIntent (test mode) and a Printful DRAFT order — v1 never confirms a Printful order into production automatically.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "designId": {
            "type": "string"
          },
          "productId": {
            "type": "string",
            "enum": [
              "tee",
              "hoodie"
            ]
          },
          "size": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "approved": {
            "type": "boolean"
          },
          "mockupApproved": {
            "type": "boolean"
          },
          "ipAttested": {
            "type": "boolean"
          },
          "recipient": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "address1": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "state_code": {
                "type": "string"
              },
              "country_code": {
                "type": "string"
              },
              "zip": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "address1",
              "city",
              "zip"
            ]
          }
        },
        "required": [
          "designId",
          "size",
          "approved",
          "mockupApproved",
          "ipAttested",
          "recipient"
        ]
      }
    },
    {
      "name": "order_status",
      "description": "Production/shipping state and tracking for a Tellashirt order, from the Printful order.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          }
        },
        "required": [
          "orderId"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "dev.fly.tellashirt/tellashirt",
    "version": "0.1.0",
    "remoteUrl": "https://tellashirt.fly.dev/mcp",
    "publishedAt": "2026-11-27T16:49:28.426216Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "a0b89d4bba7efaf49291425586fcb3c63c570a22f97d6493831e746e60c830fd"
  }
}
