{
  "$schema": "../schema.json",
  "name": "Datadog MCP",
  "category": "Observability & Analytics",
  "description": "Datadog MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "query_metrics",
      "description": "Query time-series metric data points from Datadog infrastructure agent.",
      "inputSchema": {
        "type": "object",
        "required": [
          "query",
          "from",
          "to"
        ],
        "properties": {
          "query": {
            "type": "string",
            "description": "Datadog metric query string."
          },
          "from": {
            "type": "integer",
            "description": "Start epoch timestamp in seconds."
          },
          "to": {
            "type": "integer",
            "description": "End epoch timestamp in seconds."
          }
        }
      }
    }
  ]
}
