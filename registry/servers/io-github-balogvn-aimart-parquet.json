{
  "$schema": "../schema.json",
  "name": "io.github.balogvn/aimart-parquet",
  "title": "AImart Parquet",
  "category": "Developer Tools & DevOps",
  "description": "Messy CSV, JSON, Excel, SPSS/Stata/SAS and PDF tables to typed Parquet; inspect, query, join.",
  "repository": "https://github.com/balogvn/aimart",
  "tools": [
    {
      "name": "convert_to_parquet",
      "description": "Convert a messy data file into clean, typed, zstd-compressed Parquet.\n\nUse this first for any CSV/TSV, JSON/NDJSON, Excel, SPSS, Stata or SAS file, or a digital PDF with tables. It detects the format, encoding and delimiter; skips title rows; repairs broken JSON; pulls tables out of PDFs (merging tables that continue across pages); infers int/float/bool/date/timestamp columns (including 1.234,56 and $1,234 formats) while keeping IDs with leading zeros as text; normalizes column names to snake_case; keeps SPSS/Stata/SAS variable and value labels; and can validate against an expected_schema.\n\nReturns an artifact_id (pass it to inspect_parquet / preview_parquet / query_parquet), a download link, and a per-column report: type, null count, values that did not fit the chosen type, and warnings. Price: $0.02 USDC per successful call, paid via x402.",
      "inputSchema": {
        "properties": {
          "url": {
            "anyOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Public http(s) URL of the input file. Preferred for anything over ~3 MB.",
            "title": "Url"
          },
          "content_base64": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The file's raw bytes, base64-encoded (standard or URL-safe alphabet, '=' padding optional). Small files only (under ~3 MB).",
            "title": "Content Base64"
          },
          "artifact_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]{22,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "artifact_id returned by an earlier convert_to_parquet call: converts that stored Parquet file again, with these options (an expected_schema, say).",
            "title": "Artifact Id"
          },
          "filename": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Original filename, e.g. 'survey.sav'. The extension helps format detection.",
            "title": "Filename"
          },
          "options": {
            "anyOf": [
              {
                "$ref": "#/$defs/ConvertOptions"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "type": "object",
        "$defs": {
          "ConvertOptions": {
            "additionalProperties": false,
            "description": "How to read the input and shape the Parquet output. Every field is optional.",
            "properties": {
              "format": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/InputFormat"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Force the input format. Omit to auto-detect."
              },
              "sheet": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Excel/ODS sheet name or 0-based index. Default: first non-empty sheet.",
                "title": "Sheet"
              },
              "delimiter": {
                "anyOf": [
                  {
                    "maxLength": 1,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "CSV delimiter. Omit to sniff.",
                "title": "Delimiter"
              },
              "header": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Whether the first row is a header. Omit to auto-detect.",
                "title": "Header"
              },
              "encoding": {
                "anyOf": [
                  {
                    "maxLength": 64,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Text encoding as a Python codec name, e.g. 'latin-1', 'cp1252' or 'utf-16-le'. Omit to auto-detect.",
                "title": "Encoding"
              },
              "null_values": {
                "description": "Extra tokens to treat as null, in addition to '', NA, N/A, null, None, -.",
                "items": {
                  "type": "string"
                },
                "maxItems": 50,
                "title": "Null Values",
                "type": "array"
              },
              "normalize_column_names": {
                "default": true,
                "description": "Rewrite column names to unique snake_case.",
                "title": "Normalize Column Names",
                "type": "boolean"
              },
              "infer_types": {
                "default": true,
                "description": "Infer int/float/bool/date/timestamp columns from text. False keeps text.",
                "title": "Infer Types",
                "type": "boolean"
              },
              "date_order": {
                "$ref": "#/$defs/DateOrder",
                "default": "auto",
                "description": "Order for ambiguous dates like 03/04/2025. auto assumes day-first."
              },
              "pdf_pages": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "pattern": "^[0-9 ,\\-]+$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "PDF only: pages to read, e.g. '1-3,7'. Default: all (up to 300).",
                "title": "Pdf Pages"
              },
              "pdf_table": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "PDF only: which detected table to convert (see available_sheets). Default: the largest.",
                "title": "Pdf Table"
              },
              "json_records_path": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Dot path to the array of records inside a JSON document, e.g. 'data.items'.",
                "title": "Json Records Path"
              },
              "flatten_nested": {
                "default": false,
                "description": "Flatten nested JSON objects into parent__child columns; lists become JSON.",
                "title": "Flatten Nested",
                "type": "boolean"
              },
              "value_labels": {
                "$ref": "#/$defs/ValueLabelMode",
                "default": "metadata",
                "description": "SPSS/Stata/SAS value labels: 'metadata' keeps codes and stores labels in Parquet metadata; 'apply' replaces codes with label text; 'both' adds <col>_label columns."
              },
              "expected_schema": {
                "anyOf": [
                  {
                    "items": {
                      "$ref": "#/$defs/ExpectedColumn"
                    },
                    "maxItems": 2000,
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Validate and cast to this schema. Unknown columns are kept unless strict.",
                "title": "Expected Schema"
              },
              "strict": {
                "default": false,
                "description": "With expected_schema: fail on any value that does not fit, or extra columns.",
                "title": "Strict",
                "type": "boolean"
              },
              "sort_by": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 8,
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Sort rows by these columns so Parquet min/max stats prune well.",
                "title": "Sort By"
              },
              "compression": {
                "default": "zstd",
                "enum": [
                  "zstd",
                  "snappy",
                  "gzip",
                  "none"
                ],
                "title": "Compression",
                "type": "string"
              },
              "row_group_size": {
                "default": 122880,
                "maximum": 10000000,
                "minimum": 1000,
                "title": "Row Group Size",
                "type": "integer"
              }
            },
            "title": "ConvertOptions",
            "type": "object"
          },
          "DateOrder": {
            "enum": [
              "auto",
              "dmy",
              "mdy",
              "ymd"
            ],
            "title": "DateOrder",
            "type": "string"
          },
          "ExpectedColumn": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "description": "Column name after normalization (snake_case by default).",
                "minLength": 1,
                "title": "Name",
                "type": "string"
              },
              "type": {
                "enum": [
                  "string",
                  "int64",
                  "float64",
                  "bool",
                  "date",
                  "timestamp",
                  "timestamptz",
                  "decimal"
                ],
                "title": "Type",
                "type": "string"
              },
              "nullable": {
                "default": true,
                "title": "Nullable",
                "type": "boolean"
              },
              "precision": {
                "anyOf": [
                  {
                    "maximum": 38,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "decimal only: total digits. Default 18.",
                "title": "Precision"
              },
              "scale": {
                "anyOf": [
                  {
                    "maximum": 38,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "decimal only: digits after the point, at most precision. Default 2; 0 for whole numbers. A value that would round to fit is a counted reject, never rounded.",
                "title": "Scale"
              }
            },
            "required": [
              "name",
              "type"
            ],
            "title": "ExpectedColumn",
            "type": "object"
          },
          "InputFormat": {
            "enum": [
              "csv",
              "tsv",
              "json",
              "ndjson",
              "xlsx",
              "xls",
              "ods",
              "sav",
              "zsav",
              "por",
              "dta",
              "sas7bdat",
              "xpt",
              "parquet",
              "pdf"
            ],
            "title": "InputFormat",
            "type": "string"
          },
          "ValueLabelMode": {
            "enum": [
              "metadata",
              "apply",
              "both"
            ],
            "title": "ValueLabelMode",
            "type": "string"
          }
        },
        "title": "convert_remoteArguments"
      }
    },
    {
      "name": "inspect_parquet",
      "description": "Describe a Parquet file from its footer without reading rows: row count, columns, types, null counts, min/max per column, and SPSS/Stata/SAS labels. The cheapest way to understand a dataset before querying it. Input: artifact_id from convert_to_parquet, or a url to a .parquet file. Price: $0.002 USDC per successful call, paid via x402.",
      "inputSchema": {
        "properties": {
          "artifact_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]{22,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "artifact_id returned by an earlier convert_to_parquet call.",
            "title": "Artifact Id"
          },
          "url": {
            "anyOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Public http(s) URL of the input file. Preferred for anything over ~3 MB.",
            "title": "Url"
          }
        },
        "type": "object",
        "title": "inspect_remoteArguments"
      }
    },
    {
      "name": "preview_parquet",
      "description": "Return a slice of rows from a Parquet file (default 20, max 500), optionally only some columns, as JSON rows, a Markdown table, or CSV. Use to eyeball data; use query_parquet to filter or aggregate. Long cells are truncated. Price: $0.002 USDC per successful call, paid via x402.",
      "inputSchema": {
        "properties": {
          "artifact_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]{22,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "artifact_id returned by an earlier convert_to_parquet call.",
            "title": "Artifact Id"
          },
          "url": {
            "anyOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Public http(s) URL of the input file. Preferred for anything over ~3 MB.",
            "title": "Url"
          },
          "columns": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 200,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only these columns.",
            "title": "Columns"
          },
          "offset": {
            "default": 0,
            "description": "Rows to skip.",
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          },
          "limit": {
            "default": 20,
            "description": "Rows to return.",
            "maximum": 500,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "format": {
            "default": "json",
            "description": "json rows (default), a Markdown table, or CSV text.",
            "enum": [
              "json",
              "markdown",
              "csv"
            ],
            "title": "Format",
            "type": "string"
          }
        },
        "type": "object",
        "title": "preview_remoteArguments"
      }
    },
    {
      "name": "query_parquet",
      "description": "Run one read-only DuckDB SELECT over a Parquet file, available as table `data`; join more files by passing `tables` ({name: artifact_id}, up to 7 besides data), e.g. a GL against a bank statement. Supports aggregates, window functions, CTEs, DESCRIBE data and SUMMARIZE data. Up to 1000 rows are returned; `truncated` says if more matched. Writes, file access and multiple statements are rejected. Example: SELECT region, sum(units) FROM data GROUP BY 1 ORDER BY 2 DESC. Price: $0.005 USDC per successful call, paid via x402.",
      "inputSchema": {
        "properties": {
          "sql": {
            "description": "One DuckDB SELECT statement over table `data`.",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Sql",
            "type": "string"
          },
          "artifact_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]{22,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "artifact_id returned by an earlier convert_to_parquet call.",
            "title": "Artifact Id"
          },
          "url": {
            "anyOf": [
              {
                "maxLength": 4096,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Public http(s) URL of the input file. Preferred for anything over ~3 MB.",
            "title": "Url"
          },
          "tables": {
            "anyOf": [
              {
                "additionalProperties": {
                  "pattern": "^[A-Za-z0-9_-]{22,64}$",
                  "type": "string"
                },
                "maxProperties": 7,
                "propertyNames": {
                  "pattern": "^[a-z_][a-z0-9_]{0,62}$"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Extra tables for joins: {name: artifact_id}, up to 7 besides data. The main input is `data`.",
            "title": "Tables"
          },
          "limit": {
            "default": 100,
            "description": "Maximum rows to return.",
            "maximum": 1000,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "format": {
            "default": "json",
            "description": "json rows (default), a Markdown table, or CSV text.",
            "enum": [
              "json",
              "markdown",
              "csv"
            ],
            "title": "Format",
            "type": "string"
          }
        },
        "required": [
          "sql"
        ],
        "type": "object",
        "title": "query_remoteArguments"
      }
    },
    {
      "name": "verify_provenance",
      "description": "Free. Check that a file this service produced is authentic and unaltered: verifies the post-quantum ML-DSA-65 (NIST FIPS 204) signature in an artifact's `provenance`, and with artifact_id also re-checks the stored file's hash and size against the signed manifest.",
      "inputSchema": {
        "properties": {
          "manifest": {
            "additionalProperties": true,
            "description": "provenance.manifest exactly as received.",
            "title": "Manifest",
            "type": "object"
          },
          "signature": {
            "description": "provenance.signature (base64).",
            "maxLength": 8192,
            "title": "Signature",
            "type": "string"
          },
          "artifact_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]{22,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "artifact_id returned by an earlier convert_to_parquet call.",
            "title": "Artifact Id"
          }
        },
        "required": [
          "manifest",
          "signature"
        ],
        "type": "object",
        "title": "verify_provenanceArguments"
      }
    },
    {
      "name": "request_capability",
      "description": "Free. If none of these tools does what you need — a file type we reject, an output we do not produce, a missing operation — describe the task, the formats involved, and the most you would pay per call. The operator reads these to decide what to build next. Do not include personal or confidential data.",
      "inputSchema": {
        "properties": {
          "request": {
            "$ref": "#/$defs/CapabilityRequest"
          }
        },
        "required": [
          "request"
        ],
        "type": "object",
        "$defs": {
          "CapabilityRequest": {
            "additionalProperties": false,
            "description": "What an agent needed and could not get. Never include personal or confidential data.",
            "properties": {
              "task": {
                "description": "What you were trying to do, in a sentence or two.",
                "maxLength": 1000,
                "minLength": 3,
                "title": "Task",
                "type": "string"
              },
              "input_formats": {
                "description": "File types involved, e.g. ['pdf', 'xml'].",
                "items": {
                  "type": "string"
                },
                "maxItems": 10,
                "title": "Input Formats",
                "type": "array"
              },
              "desired_output": {
                "anyOf": [
                  {
                    "maxLength": 300,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "What you wanted back.",
                "title": "Desired Output"
              },
              "max_price_usd": {
                "anyOf": [
                  {
                    "maximum": 1000,
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "The most you would pay per call.",
                "title": "Max Price Usd"
              },
              "calls_per_month": {
                "anyOf": [
                  {
                    "maximum": 100000000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Rough expected volume.",
                "title": "Calls Per Month"
              },
              "agent": {
                "anyOf": [
                  {
                    "maxLength": 100,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Your agent or platform name (optional).",
                "title": "Agent"
              }
            },
            "required": [
              "task"
            ],
            "title": "CapabilityRequest",
            "type": "object"
          }
        },
        "title": "request_capabilityArguments"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.balogvn/aimart-parquet",
    "version": "0.2.0",
    "remoteUrl": "https://balogvn--aimart-parquet.us-east.modal.run/mcp",
