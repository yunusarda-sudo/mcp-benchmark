{
  "$schema": "../schema.json",
  "name": "io.github.VrilLabs/vercel-oss-registry",
  "title": "Vercel OSS Registry",
  "category": "Developer Tools & DevOps",
  "description": "Search all 138 projects funded by the Vercel Open Source Program: repos, descriptions, topics.",
  "repository": "https://github.com/VrilLabs/vercel-oss-registry-mcp",
  "tools": [
    {
      "name": "search_projects",
      "description": "Full-text search (fuzzy, prefix) over Vercel OSS Program projects by name, topics and description, with optional filters. Returns compact hits; call get_project for full details. Omit query to browse by filters.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "description": "Keywords, e.g. \"animated react components\" or \"auth\"",
            "type": "string",
            "maxLength": 200
          },
          "topic": {
            "description": "Exact GitHub topic (see list_facets)",
            "type": "string",
            "maxLength": 60
          },
          "language": {
            "description": "Primary language, e.g. TypeScript",
            "type": "string",
            "maxLength": 40
          },
          "cohort": {
            "description": "e.g. \"Spring 2026\"",
            "type": "string",
            "maxLength": 20
          },
          "minStars": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sort": {
            "description": "Default: relevance with query, stars without",
            "type": "string",
            "enum": [
              "relevance",
              "stars",
              "recent"
            ]
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "includeUnavailable": {
            "default": false,
            "description": "Include repos that are gone or flagged",
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "get_project",
      "description": "Full catalog record(s) for one or more project ids (owner/repo) returned by search_projects.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "ids": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 140
            },
            "description": "owner/repo ids, case-insensitive; a full GitHub URL also works"
          }
        },
        "required": [
          "ids"
        ]
      }
    },
    {
      "name": "list_facets",
      "description": "Values (with project counts) for a filter: topic, language or cohort. Use to pick valid search_projects filters.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "facet": {
            "type": "string",
            "enum": [
              "topic",
              "language",
              "cohort"
            ]
          },
          "limit": {
            "default": 40,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "facet"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.VrilLabs/vercel-oss-registry",
    "version": "0.1.0",
    "remoteUrl": "https://vercel-oss.vril.dev/mcp",
    "publishedAt": "2026-11-17T14:35:29.417717Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "3090418bbdab1a694b0899c3c023e8bc0e989b1e9806da57209e7c7c2bdfe2d4"
  }
}
