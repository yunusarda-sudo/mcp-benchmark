{
  "$schema": "../schema.json",
  "name": "com.codemate/website",
  "title": "Codemate website",
  "category": "Developer Tools & VCS",
  "description": "Read-only Codemate search, MCP Apps views, articles, case studies, company facts, contacts and jobs.",
  "tools": [
    {
      "name": "search_site",
      "description": "Search Codemate's website: service pages, client case studies and articles. Returns the best-matching titles with their URLs and a one-line summary. Use this to find out what Codemate does, which industries and technologies it has delivered in, or whether it has written about a topic.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "description": "Words to search for."
          },
          "limit": {
            "default": 5,
            "description": "Maximum results, 1-10.",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "kind": {
            "description": "Restrict to one kind: \"reference\" for client case studies, \"article\" for published articles, \"page\" for service and product pages. Omit to search all three.",
            "type": "string",
            "enum": [
              "page",
              "reference",
              "article"
            ]
          },
          "lang": {
            "default": "en",
            "description": "Which language edition of the site to answer from. Defaults to English. Answers stay in that language; call again with the other value to search the other edition.",
            "type": "string",
            "enum": [
              "en",
              "fi"
            ]
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "list_references",
      "description": "List Codemate's client case studies (called references on the site), with the client name, industries, services, a summary and the URL. Filter by industry, service or client. Use this when asked what Codemate has delivered, for whom, or for proof of experience in a sector — search_site only returns the closest few matches and mixes in articles.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "industry": {
            "description": "Industry filter, e.g. \"Finance and insurance\" or just \"finance\".",
            "type": "string"
          },
          "service": {
            "description": "Service filter, e.g. \"AI and data\", \"Software development\", \"Testing\".",
            "type": "string"
          },
          "client": {
            "description": "Client name filter, e.g. \"Restel\".",
            "type": "string"
          },
          "lang": {
            "default": "en",
            "description": "Which language edition of the site to answer from. Defaults to English. Answers stay in that language; call again with the other value to search the other edition.",
            "type": "string",
            "enum": [
              "en",
              "fi"
            ]
          }
        }
      }
    },
    {
      "name": "list_articles",
      "description": "List Codemate's published articles, newest first, with date, category, summary and URL. Filter by category or by date. Use this when asked what Codemate has written or published about something, or for recent news — search_site only returns the closest few matches.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "category": {
            "description": "Category filter, matching the site's own article filter tabs.",
            "type": "string",
            "enum": [
              "codemate-life",
              "mates-behind-the-code",
              "news",
              "other",
              "recordings",
              "guide"
            ]
          },
          "since": {
            "description": "Only articles published on or after this date. A year (\"2026\") or an ISO date.",
            "type": "string"
          },
          "limit": {
            "default": 20,
            "description": "Maximum articles, 1-50.",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "lang": {
            "default": "en",
            "description": "Which language edition of the site to answer from. Defaults to English. Answers stay in that language; call again with the other value to search the other edition.",
            "type": "string",
            "enum": [
              "en",
              "fi"
            ]
          }
        }
      }
    },
    {
      "name": "get_topic",
      "description": "Read the full text of one of Codemate's main pages. Valid ids: what-we-do, design, code, care, how-we-deliver, ai-transformation, solutions, paimen-ai, about, google-partnership. Returns the page summary, its sections and any FAQ. Use this to answer questions about Codemate's services, delivery model, AI transformation offering or the Paimen agentic UX platform.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "what-we-do",
              "design",
              "code",
              "care",
              "how-we-deliver",
              "ai-transformation",
              "solutions",
              "paimen-ai",
              "about",
              "google-partnership"
            ],
            "description": "Which page to read."
          },
          "lang": {
            "default": "en",
            "description": "Which language edition of the site to answer from. Defaults to English. Answers stay in that language; call again with the other value to search the other edition.",
            "type": "string",
            "enum": [
              "en",
              "fi"
            ]
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "list_open_positions",
      "description": "List the jobs Codemate is currently hiring for, with location, the job page URL and the application link. Use this when asked whether Codemate is hiring, or about careers and open roles.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "location": {
            "description": "Optional city or country filter, e.g. \"Helsinki\".",
            "type": "string"
          },
          "lang": {
            "default": "en",
            "description": "Which language edition of the site to answer from. Defaults to English. Answers stay in that language; call again with the other value to search the other edition.",
            "type": "string",
            "enum": [
              "en",
              "fi"
            ]
          }
        }
      }
    },
    {
      "name": "get_company_info",
      "description": "Get authoritative facts about Codemate as a company: what it does, its legal entities, and whatever else it publishes about itself. Use this when asked to describe or introduce Codemate, rather than assembling an answer from service pages and articles. Only states facts Codemate has verified — if something is not returned, it is not published, so do not infer it.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "lang": {
            "default": "en",
            "description": "Which language edition of the site to answer from. Defaults to English. Answers stay in that language; call again with the other value to search the other edition.",
            "type": "string",
            "enum": [
              "en",
              "fi"
            ]
          }
        }
      }
    },
    {
      "name": "get_contact_info",
      "description": "Get how to reach Codemate: office addresses with map links, named people with their role, email, phone, LinkedIn and photo, plus the general sales email and phone numbers. Filter by role or office. Use this when asked how to contact Codemate, who to speak to about something, or where its offices are.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "role": {
            "description": "Role filter, e.g. \"sales\", \"CEO\", \"recruit\". Matches part of the job title.",
            "type": "string"
          },
          "office": {
            "description": "Office filter, e.g. \"Helsinki\", \"Oulu\".",
            "type": "string"
          },
          "lang": {
            "default": "en",
            "description": "Which language edition of the site to answer from. Defaults to English. Answers stay in that language; call again with the other value to search the other edition.",
            "type": "string",
            "enum": [
              "en",
              "fi"
            ]
          }
        }
      }
    },
    {
      "name": "get_page_data",
      "description": "Read the full text of a codemate.com article or client case study, given the URL that search_site, list_articles or list_references returned. Returns the title, date, metadata and the page's prose. Use this after a search to actually read a result — search only returns a summary. For Codemate's main service and product pages, use get_topic instead.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "url": {
            "type": "string",
            "description": "The codemate.com URL (or path) of an article or case study, from a search or list result."
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "search_view",
      "description": "Create or refine a view of Codemate pages, case studies, articles, jobs and people. For a replacement search use input {type:\"message\",mode:\"new\",text:\"your question\"}; use mode:\"refine\" with the returned context only for an explicit follow-up. Language defaults to English. Typed read-only actions operate on the context plan, or an empty plan if omitted. Repeated narrow actions require every selected facet (AND); use restore to replace the plan or a facet selection. Returns grounded text plus an interactive view in MCP Apps hosts. No model call, writes or submissions.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "v": {
            "default": 1,
            "type": "number",
            "const": 1
          },
          "lang": {
            "default": "en",
            "type": "string",
            "enum": [
              "en",
              "fi"
            ]
          },
          "input": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "message"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "new",
                      "refine"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": [
                  "type",
                  "mode",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "action"
                  },
                  "action": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "narrow"
                          },
                          "facet": {
                            "type": "string",
                            "enum": [
                              "industry",
                              "service"
                            ]
                          },
                          "slug": {
                            "type": "string",
                            "pattern": "^[a-z0-9-]{1,40}$"
                          }
                        },
                        "required": [
                          "type",
                          "facet",
                          "slug"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "exclude"
                          },
                          "facet": {
                            "type": "string",
                            "enum": [
                              "industry",
                              "service"
                            ]
                          },
                          "slug": {
                            "type": "string",
                            "pattern": "^[a-z0-9-]{1,40}$"
                          }
                        },
                        "required": [
                          "type",
                          "facet",
                          "slug"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "removeFilter"
                          },
                          "facet": {
                            "type": "string",
                            "enum": [
                              "industry",
                              "service"
                            ]
                          },
                          "slug": {
                            "type": "string",
                            "pattern": "^[a-z0-9-]{1,40}$"
                          }
                        },
                        "required": [
                          "type",
                          "facet",
                          "slug"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "removeTerm"
                          },
                          "term": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 40
                          }
                        },
                        "required": [
                          "type",
                          "term"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "setKinds"
                          },
                          "kinds": {
                            "maxItems": 5,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "topic",
                                "reference",
                                "article",
                                "position",
                                "person"
                              ]
                            }
                          }
                        },
                        "required": [
                          "type",
                          "kinds"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "showMore"
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "reset"
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "restore"
                          },
                          "plan": {
                            "type": "object",
                            "properties": {
                              "kinds": {
                                "maxItems": 5,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "enum": [
                                    "topic",
                                    "reference",
                                    "article",
                                    "position",
                                    "person"
                                  ]
                                }
                              },
                              "industries": {
                                "type": "object",
                                "properties": {
                                  "require": {
                                    "maxItems": 4,
                                    "type": "array",
                                    "items": {
                                      "type": "string",
                                      "pattern": "^[a-z0-9-]{1,40}$"
                                    }
                                  },
                                  "prefer": {
                                    "maxItems": 6,
                                    "type": "array",
                                    "items": {
                                      "type": "string",
                                      "pattern": "^[a-z0-9-]{1,40}$"
                                    }
                                  },
                                  "exclude": {
                                    "maxItems": 6,
                                    "type": "array",
                                    "items": {
                                      "type": "string",
                                      "pattern": "^[a-z0-9-]{1,40}$"
                                    }
                                  }
                                },
                                "required": [
                                  "require",
                                  "prefer",
                                  "exclude"
                                ],
                                "additionalProperties": false
                              },
                              "services": {
                                "type": "object",
                                "properties": {
                                  "require": {
                                    "maxItems": 4,
                                    "type": "array",
                                    "items": {
                                      "type": "string",
                                      "pattern": "^[a-z0-9-]{1,40}$"
                                    }
                                  },
                                  "prefer": {
                                    "maxItems": 6,
                                    "type": "array",
                                    "items": {
                                      "type": "string",
                                      "pattern": "^[a-z0-9-]{1,40}$"
                                    }
                                  },
                                  "exclude": {
                                    "maxItems": 6,
                                    "type": "array",
                                    "items": {
                                      "type": "string",
                                      "pattern": "^[a-z0-9-]{1,40}$"
                                    }
                                  }
                                },
                                "required": [
