                                "items": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 40
                                }
                              },
                              "limit": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 18
                              }
                            },
                            "required": [
                              "kinds",
                              "industries",
                              "services",
                              "terms",
                              "limit"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
