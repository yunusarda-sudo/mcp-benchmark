{
  "$schema": "../schema.json",
  "name": "ae.mrk/dubai-property",
  "title": "MRK Dubai Property",
  "category": "Developer Tools & VCS",
  "description": "Dubai real estate data: 2,400+ projects, developers, communities, purchase costs and Golden Visa.",
  "tools": [
    {
      "name": "ask",
      "description": "Answer a free-text Dubai property question (e.g. '2 bed off-plan in Dubai Hills under 3M handover 2027'). Parses community, developer, bedrooms, price, stage, handover year and type, then returns schema.org-typed results with mrk.ae URLs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "The question in plain language"
          },
          "limit": {
            "type": "integer",
            "description": "Max results (1-25)",
            "minimum": 1,
            "maximum": 25,
            "default": 10
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_projects",
      "description": "Search ~2,400 Dubai residential projects (DLD-registered plus MRK-researched new launches). Filter by community, developer, stage, handover year, starting-price range, bedrooms and type. Returns compact summaries with canonical URLs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Free text matched against name, developer, community and summary"
          },
          "community": {
            "type": "string",
            "description": "Community name or slug, e.g. 'Dubai Hills Estate' or 'business-bay'"
          },
          "developer": {
            "type": "string",
            "description": "Developer name or slug, e.g. 'Emaar' or 'sobha-realty'"
          },
          "status": {
            "type": "string",
            "description": "Construction stage",
            "enum": [
              "off-plan",
              "ready"
            ]
          },
          "handoverYear": {
            "type": "integer",
            "description": "Handover / completion year, e.g. 2027",
            "minimum": 1990,
            "maximum": 2040
          },
          "minPriceAed": {
            "type": "number",
            "description": "Minimum developer starting price in AED (projects without a price are excluded when set)",
            "minimum": 0
          },
          "maxPriceAed": {
            "type": "number",
            "description": "Maximum developer starting price in AED",
            "minimum": 0
          },
          "bedrooms": {
            "type": "integer",
            "description": "Bedroom count offered (0 = studio)",
            "minimum": 0,
            "maximum": 10
          },
          "type": {
            "type": "string",
            "description": "Property type",
            "enum": [
              "apartment",
              "villa",
              "townhouse",
              "penthouse"
            ]
          },
          "sort": {
            "type": "string",
            "description": "Sort order",
            "enum": [
              "relevance",
              "price_asc",
              "price_desc",
              "handover_asc",
              "handover_desc",
              "name"
            ],
            "default": "relevance"
          },
          "limit": {
            "type": "integer",
            "description": "Max results (1-50)",
            "minimum": 1,
            "maximum": 50,
            "default": 10
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_project",
      "description": "Full facts for one project by slug or exact name: developer, community, status, handover, starting prices by unit type, payment plan, highlights, considerations and cited sources.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "Project slug (from search_projects) or exact project name"
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "compare_projects",
      "description": "Side-by-side comparison of 2 to 5 projects by slug: developer, community, stage, handover, starting price, unit types, payment plan.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slugs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 5,
            "description": "Project slugs"
          }
        },
        "required": [
          "slugs"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_developers",
      "description": "List Dubai developers with project counts (off-plan vs ready), optionally filtered by name text. Sorted by project count.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Optional name filter"
          },
          "limit": {
            "type": "integer",
            "description": "Max results (1-200)",
            "minimum": 1,
            "maximum": 200,
            "default": 25
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_developer",
      "description": "Developer profile: project count, off-plan/ready split, communities, starting-price statistics and its top projects.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "developer": {
            "type": "string",
            "description": "Developer name or slug"
          },
          "projectLimit": {
            "type": "integer",
            "description": "Projects to include (0-50)",
            "minimum": 0,
            "maximum": 50,
            "default": 15
          }
        },
        "required": [
          "developer"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_communities",
      "description": "List Dubai communities with project counts and lowest starting price, optionally filtered by name text. Sorted by project count.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Optional name filter"
          },
          "limit": {
            "type": "integer",
            "description": "Max results (1-300)",
            "minimum": 1,
            "maximum": 300,
            "default": 25
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_community",
      "description": "Community stats: project count, off-plan/ready split, developers, starting-price bands (lowest/median/highest) and top projects.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "community": {
            "type": "string",
            "description": "Community name or slug"
          },
          "projectLimit": {
            "type": "integer",
            "description": "Projects to include (0-50)",
            "minimum": 0,
            "maximum": 50,
            "default": 15
          }
        },
        "required": [
          "community"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_listings",
      "description": "Search MRK Real Estate's live sale listings (from the MRK CRM, refreshed every 5 minutes). Filter by text, location, type, price and bedrooms.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Free text matched against title, location, type and features"
          },
          "location": {
            "type": "string",
            "description": "Locality text, e.g. 'Palm Jumeirah'"
          },
          "type": {
            "type": "string",
            "description": "Property type text, e.g. 'Villa', 'Apartment'"
          },
          "minPriceAed": {
            "type": "number",
            "description": "Minimum price in AED",
            "minimum": 0
          },
          "maxPriceAed": {
            "type": "number",
            "description": "Maximum price in AED",
            "minimum": 0
          },
          "bedrooms": {
            "type": "integer",
            "description": "Exact bedrooms",
            "minimum": 0,
            "maximum": 20
          },
          "limit": {
            "type": "integer",
            "description": "Max results (1-50)",
            "minimum": 1,
            "maximum": 50,
            "default": 10
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_listing",
      "description": "Full details of one live MRK sale listing by web slug or reference.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "Listing web slug or reference"
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "calculate_purchase_costs",
      "description": "Itemised one-off costs of buying in Dubai using MRK's verified fee schedule: DLD 4% transfer fee, DLD admin fee, title deed, registration trustee fee (+VAT), mortgage registration, agency commission (+VAT) and developer NOC range.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "priceAed": {
            "type": "number",
            "description": "Purchase price in AED",
            "exclusiveMinimum": 0
          },
          "offPlan": {
            "type": "boolean",
            "description": "True for an off-plan (Oqood) purchase from the developer: no trustee fee, admin charge set by developer, no agency fee by default"
          },
          "loanAed": {
            "type": "number",
            "description": "Mortgage amount in AED, if financed",
            "minimum": 0
          },
          "includeAgencyFee": {
            "type": "boolean",
            "description": "Include 2% agency commission + VAT (default true for ready/resale, false for off-plan)"
          }
        },
        "required": [
          "priceAed"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "calculate_mortgage",
      "description": "Monthly repayment, total interest and loan-to-value for a repayment mortgage. Pure arithmetic on the rate you supply; UAE Central Bank base rate is returned for context only, not as a quote.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "priceAed": {
            "type": "number",
            "description": "Property price in AED",
            "exclusiveMinimum": 0
          },
          "downPaymentPct": {
            "type": "number",
            "description": "Down payment as % of price (default 20)",
            "minimum": 0,
            "maximum": 100,
            "default": 20
          },
          "annualRatePct": {
            "type": "number",
            "description": "Annual interest rate in % (e.g. 4.25)",
            "minimum": 0,
            "maximum": 30
          },
          "years": {
            "type": "integer",
            "description": "Term in years (default 25, UAE max 25)",
            "minimum": 1,
            "maximum": 30,
            "default": 25
          }
        },
        "required": [
          "priceAed",
          "annualRatePct"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "rental_yield_estimate",
      "description": "ESTIMATE of gross and net rental yield from a price and an annual rent you supply (plus optional service charge and other annual costs). MRK does not supply the rent figure; result is labelled as an estimate.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "priceAed": {
            "type": "number",
            "description": "Purchase price in AED",
            "exclusiveMinimum": 0
          },
          "annualRentAed": {
            "type": "number",
            "description": "Expected annual rent in AED",
            "exclusiveMinimum": 0
          },
          "serviceChargeAed": {
            "type": "number",
            "description": "Annual service charge in AED",
            "minimum": 0
          },
          "otherAnnualCostsAed": {
            "type": "number",
            "description": "Other annual costs (management, maintenance, insurance) in AED",
            "minimum": 0
          },
          "includePurchaseCosts": {
            "type": "boolean",
            "description": "Add DLD 4% + admin + trustee to the cost base (default true)"
          }
        },
        "required": [
          "priceAed",
          "annualRentAed"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "golden_visa_eligibility",
      "description": "Indicative check against the UAE 10-year Golden Visa real-estate route (property value of at least AED 2 million). Returns shortfall and conditions to confirm with ICP / GDRFA Dubai.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "propertyValueAed": {
            "type": "number",
            "description": "Total value of the property (or properties combined) in AED",
            "minimum": 0
          },
          "mortgaged": {
            "type": "boolean",
            "description": "Is the property financed with a mortgage?"
          },
          "offPlan": {
            "type": "boolean",
            "description": "Is the property off-plan?"
          }
        },
        "required": [
          "propertyValueAed"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_insights",
      "description": "Search MRK's sourced Dubai market insights (original commentary with linked sources). Filter by text and category.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Free text"
          },
          "category": {
            "type": "string",
            "description": "Category",
            "enum": [
              "Market data",
              "Supply",
              "Demand",
              "Rents",
              "Luxury",
              "Regulation",
              "Investors"
            ]
          },
          "limit": {
            "type": "integer",
            "description": "Max results (1-30)",
            "minimum": 1,
            "maximum": 30,
            "default": 8
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_insight",
      "description": "Full insight article by slug: summary, key numbers with sources, body sections, FAQs and source list.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "Insight slug"
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "submit_enquiry",
      "description": "Send a buyer/seller enquiry to MRK Real Estate's advisory team on the user's behalf. Only call with the user's explicit consent. Requires name plus email or phone. Rate limited.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Full name",
            "minLength": 2,
            "maxLength": 200
          },
          "email": {
            "type": "string",
            "description": "Email address",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "description": "Phone with country code, e.g. +44 7700 900000"
          },
          "message": {
            "type": "string",
            "description": "What the user is looking for",
            "maxLength": 5000
          },
          "projectSlug": {
            "type": "string",
            "description": "Related project slug, if any"
          },
          "listingSlug": {
            "type": "string",
            "description": "Related listing slug, if any"
          },
          "language": {
            "type": "string",
            "description": "Preferred language code, e.g. 'en', 'ar'"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_glossary",
      "description": "Search the MRK Dubai real estate glossary for a term definition. Returns matching terms with definitions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Term to search for (e.g., 'Ejari', 'Golden Visa', 'DLD')"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_dubai_community_facts",
      "description": "Get key facts about a Dubai community including price per sqft, rental yield and Golden Visa qualifying status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "community": {
            "type": "string",
            "description": "Community slug, e.g., 'dubai-marina', 'palm-jumeirah'"
          }
        },
        "required": [
          "community"
        ]
      }
    },
    {
      "name": "calculate_dld_buying_costs",
      "description": "Calculate Dubai Land Department transfer fees and total buying costs for a Dubai property purchase.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "priceAed": {
            "type": "number",
            "description": "Property price in AED"
          },
          "withMortgage": {
            "type": "boolean",
            "description": "Whether the purchase uses a mortgage"
          }
        },
        "required": [
          "priceAed"
        ]
      }
    },
    {
      "name": "check_golden_visa_eligibility",
      "description": "Check if a Dubai property investment qualifies for UAE Golden Visa (10-year residency). Minimum threshold is AED 2 million.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "propertyValueAed": {
            "type": "number",
            "description": "Property price in AED"
          },
          "financed": {
            "type": "boolean",
            "description": "Whether purchase is financed/mortgaged"
          }
        },
        "required": [
          "propertyValueAed"
        ]
      }
    },
    {
      "name": "get_rent_cap_increase",
      "description": "Calculate the maximum legal rent increase in Dubai per RERA Decree 43/2013 rent cap tiers based on how far current rent is below market average.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "currentRentAed": {
            "type": "number",
            "description": "Current annual rent in AED"
          },
          "marketAverageAed": {
            "type": "number",
            "description": "Market average annual rent in AED"
          }
        },
        "required": [
          "currentRentAed",
          "marketAverageAed"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "ae.mrk/dubai-property",
    "version": "1.0.0",
    "remoteUrl": "https://mrk.ae/api/mcp",
    "fetchedAt": "2026-11-22T10:21:23.861Z",
