{
  "$schema": "../schema.json",
  "name": "io.github.kashmirz/addie-property-research",
  "title": "Addie – Australian Property Research",
  "category": "Developer Tools & DevOps",
  "description": "Search Australian property listings, compare homes, and get sales history and suburb market data.",
  "tools": [
    {
      "name": "get_capabilities",
      "description": "Check currently available research features and source coverage before requesting data.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "resolve_location",
      "description": "Resolve an Australian place to explicit geography choices. Clarify ambiguous names rather than guessing.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "state": {
            "type": "string",
            "maxLength": 3
          },
          "limit": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "resolve_property",
      "description": "Resolve a shared Addie property URL to its exact listing campaign with subject.kind property_url and subject.url. For an address, preserve unit and level numbers and clarify incomplete addresses.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "subject": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "property_url"
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                },
                "required": [
                  "kind",
                  "url"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "address_id"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "gnaf_pid"
                  },
                  "pid": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "kind",
                  "pid"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "reference_id"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "source_alias"
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "asOf": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  }
                },
                "required": [
                  "kind",
                  "source",
                  "reference",
                  "asOf"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "exact_address"
                  },
                  "address": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "suburb": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "NSW",
                      "VIC",
                      "QLD",
                      "WA",
                      "SA",
                      "TAS",
                      "ACT",
                      "NT",
                      "OT"
                    ]
                  },
                  "postcode": {
                    "type": "string",
                    "pattern": "^\\d{4}$"
                  }
                },
                "required": [
                  "kind",
                  "address",
                  "suburb",
                  "state"
                ],
                "additionalProperties": false
              }
            ]
          },
          "limit": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "search_properties",
      "description": "Search Addie's listings with explicit hard filters and an optional visual description or architectural styles (ids from get_capabilities). Every filter is enforced and none is relaxed; criteria outside this schema are not supported. Get locations from resolve_location first (STATE, CITY, SA4, SA3, SA2, SUBURB or POSTCODE). Status defaults to ACTIVE (for sale). Frontage is the direction the street frontage faces. A visual description or style ranks the most similar listings within the filters, excludes none, and cannot be counted.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "plan": {
            "type": "object",
            "properties": {
              "version": {
                "type": "number",
                "const": 1
              },
              "criteria": {
                "type": "object",
                "properties": {
                  "inventory": {
                    "default": "listings",
                    "type": "string",
                    "const": "listings"
                  },
                  "locations": {
                    "description": "Places from resolve_location. A listing matches any one of them.",
                    "minItems": 1,
                    "maxItems": 30,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "STATE",
                            "CITY",
                            "SA4",
                            "SA3",
                            "SA2",
                            "SUBURB",
                            "POSTCODE"
                          ]
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "state": {
                          "type": "string",
                          "enum": [
                            "NSW",
                            "VIC",
                            "QLD",
                            "WA",
                            "SA",
                            "TAS",
                            "ACT",
                            "NT"
                          ]
                        }
                      },
                      "required": [
                        "kind",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "includeSurrounding": {
                    "description": "Also match suburbs around each SUBURB or POSTCODE location.",
                    "type": "boolean"
                  },
                  "lifecycle": {
                    "description": "Listing statuses to include. Defaults to ACTIVE (for sale).",
                    "minItems": 1,
                    "maxItems": 6,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "ACTIVE",
                        "UNDER_OFFER",
                        "SOLD",
                        "WITHDRAWN",
                        "FOR_RENT",
                        "LEASED"
                      ]
                    }
                  },
                  "marketingStages": {
                    "description": "Only Pre-Market listings.",
                    "minItems": 1,
                    "maxItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "const": "pre_market"
                    }
                  },
                  "price": {
                    "description": "AUD. Asking price for ACTIVE/UNDER_OFFER; with priceBasis last_sale, the sold price of SOLD listings; with priceBasis weekly_rent, the weekly asking rent of FOR_RENT listings (last_sale and weekly_rent are not combinable with visual). Listings that withhold their price can match on Addie's estimated price range, except on some visual-search pages.",
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 2000000000
                      },
                      "max": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 2000000000
                      }
                    },
                    "additionalProperties": false
                  },
                  "priceCurrency": {
                    "default": "AUD",
                    "type": "string",
                    "const": "AUD"
                  },
                  "priceBasis": {
                    "default": "asking",
                    "type": "string",
                    "enum": [
                      "asking",
                      "last_sale",
                      "weekly_rent"
                    ]
                  },
                  "bedrooms": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 50
                      }
                    },
                    "required": [
                      "min"
                    ],
                    "additionalProperties": false
                  },
                  "bathrooms": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 50
                      }
                    },
                    "required": [
                      "min"
                    ],
                    "additionalProperties": false
                  },
                  "parking": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 50
                      }
                    },
                    "required": [
                      "min"
                    ],
                    "additionalProperties": false
                  },
                  "landAreaSqm": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100000000
                      },
                      "max": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100000000
                      }
                    },
                    "additionalProperties": false
                  },
                  "buildingCoveragePercent": {
                    "description": "Minimum share of the lot covered by buildings.",
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      }
                    },
                    "required": [
                      "min"
                    ],
                    "additionalProperties": false
                  },
                  "propertyTypes": {
                    "minItems": 1,
                    "maxItems": 7,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "HOUSE",
                        "APARTMENT",
                        "TOWNHOUSE",
                        "VILLA",
                        "LAND",
                        "RURAL",
                        "OTHER"
                      ]
                    }
                  },
                  "hasPool": {
                    "description": "Pool detected in aerial imagery.",
                    "type": "boolean",
                    "const": true
                  },
                  "hasSolar": {
                    "description": "Solar panels detected in aerial imagery.",
                    "type": "boolean",
                    "const": true
                  },
                  "frontageDirections": {
                    "description": "Direction the lot's street frontage faces.",
                    "minItems": 1,
                    "maxItems": 8,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "north",
                        "northeast",
                        "east",
                        "southeast",
                        "south",
                        "southwest",
                        "west",
                        "northwest"
                      ]
                    }
                  },
                  "isCornerLot": {
                    "type": "boolean",
                    "const": true
                  },
                  "hasRearAccess": {
                    "type": "boolean",
                    "const": true
                  },
                  "geoCircle": {
                    "type": "object",
                    "properties": {
                      "lat": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "lng": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      },
                      "radiusKm": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 100
                      }
                    },
                    "required": [
                      "lat",
                      "lng",
                      "radiusKm"
                    ],
                    "additionalProperties": false
                  },
                  "geoPolygon": {
                    "type": "object",
                    "properties": {
                      "points": {
                        "minItems": 3,
                        "maxItems": 200,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "lat": {
                              "type": "number",
                              "minimum": -90,
                              "maximum": 90
                            },
                            "lng": {
                              "type": "number",
                              "minimum": -180,
                              "maximum": 180
                            }
                          },
                          "required": [
                            "lat",
                            "lng"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "points"
                    ],
                    "additionalProperties": false
                  },
                  "visual": {
                    "description": "Describe how the home looks. Ranks the most visually similar listings within the other filters; such results cannot be counted. With ACTIVE, no other lifecycle may be included.",
                    "type": "object",
                    "properties": {
                      "query": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "query"
                    ],
                    "additionalProperties": false
                  },
                  "styles": {
                    "description": "Architectural styles by id (get_capabilities lists them). A style ranks listings by how much they look like it, as a visual description does: it excludes no listing, and such results cannot be counted.",
                    "minItems": 1,
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "historic",
                        "historic.colonial",
                        "historic.victorian",
                        "historic.federation",
                        "historic.queen_anne",
                        "historic.interwar",
                        "historic.art_nouveau",
                        "historic.queenslander",
                        "historic.adelaide_bluestone",
                        "modern",
                        "modern.art_deco",
                        "modern.mid_century",
                        "modern.brutalist",
                        "contemporary",
                        "contemporary.contemporary",
                        "contemporary.minimalist",
                        "australiana",
                        "australiana.fibro",
                        "australiana.postwar_brick_veneer",
                        "australiana.workers_cottage",
                        "australiana.pole_home",
                        "australiana.queenslander",
                        "australiana.murcutt_influenced",
                        "australiana.pavilion",
                        "australiana.tropical_modern",
                        "australiana.bush_retreat",
                        "australiana.country_homestead",
                        "international",
                        "international.spanish_mission",
                        "international.hamptons",
                        "international.mediterranean",
                        "international.french_provincial",
                        "international.scandinavian",
                        "international.japanese_influenced",
                        "international.balinese_influenced",
                        "conversion",
                        "conversion.barn",
                        "conversion.warehouse",
                        "conversion.church",
                        "conversion.shopfront",
                        "typology",
                        "typology.terrace",
                        "typology.duplex",
                        "typology.dual_occupancy",
                        "typology.detached_villa",
                        "typology.split_level",
                        "biophilia",
                        "biophilia.biophilic_modern",
                        "industrial",
                        "industrial.industrial"
                      ]
                    }
                  }
                },
                "additionalProperties": false
              },
              "sort": {
                "default": {
                  "field": "relevance",
                  "direction": "desc"
                },
                "description": "relevance: visual similarity for visual searches (the only sort they support), otherwise Addie's ranking. price: asking price, or sold price for SOLD listings (ranked together when both are included). listed_at: when Addie first saw the listing.",
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "const": "relevance"
                      },
                      "direction": {
                        "type": "string",
                        "const": "desc"
                      }
                    },
                    "required": [
                      "field",
                      "direction"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "const": "price"
                      },
                      "direction": {
                        "type": "string",
                        "enum": [
                          "asc",
                          "desc"
                        ]
                      }
                    },
                    "required": [
                      "field",
                      "direction"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "const": "listed_at"
                      },
                      "direction": {
                        "type": "string",
                        "enum": [
                          "asc",
                          "desc"
                        ]
                      }
                    },
                    "required": [
                      "field",
                      "direction"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "version",
              "criteria"
            ],
            "additionalProperties": false
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "includeCount": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "plan"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_properties",
      "description": "Read or compare at most eight properties from search or property resolution: each listing card plus the detail shown on its Addie property page (full description, features, sizes, price, status and dates, agency and agent contact) with the photos and floor plans the page shows. Unreadable references are listed as unavailable.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "propertyRefs": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "required": [
          "propertyRefs"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_property_history",
      "description": "Read a bounded page of dated sales and asking-price events for a resolved subject. Withheld prices remain unknown.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "propertyRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "types": {
            "default": [
              "sale"
            ],
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "sale",
                "asking_price",
                "listing",
                "withdrawal",
                "rental"
              ]
            }
          },
          "asOf": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "propertyRef"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "query_market",
      "description": "Read qualified market metrics by geography, cohort and ended reference period. Supply state for local names/postcodes. Use full UTC calendar periods at the metric's supported grain. Return cohort, units, sample, provenance and freshness; do not average medians.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "geographies": {
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "NATIONAL",
                    "STATE",
                    "CITY",
                    "LGA",
                    "SA4",
                    "SA3",
                    "SA2",
                    "SUBURB",
                    "POSTCODE"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "state": {
                  "type": "string",
                  "maxLength": 3
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "metricIds": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "market.medianPrice",
                "market.avgPrice",
                "market.medianPricePerSqm",
                "market.salesVolume",
                "market.totalValue",
                "market.medianDaysOnMarket",
                "market.avgDaysOnMarket",
                "market.priceChangeYear",
                "market.medianAskingPrice",
                "market.priceRevisionCount",
                "market.medianPriceRevision",
                "market.priceReductionShare",
                "rental.medianRent",
                "rental.avgRent",
                "rental.newBonds",
                "rental.totalBondsHeld",
                "rental.turnoverRate",
                "inventory.activeCount",
                "inventory.newListings",
                "inventory.soldCount",
                "inventory.withdrawnCount",
                "inventory.absorptionRate",
                "inventory.monthsOfSupply"
              ]
            }
          },
          "from": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "to": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "granularity": {
            "type": "string",
            "enum": [
              "DAILY",
              "MONTHLY",
              "QUARTERLY",
              "YEARLY"
            ]
          },
          "cohorts": {
            "type": "object",
            "properties": {
              "sales": {
                "type": "object",
                "properties": {
                  "propertyType": {
                    "type": "string",
                    "enum": [
                      "ALL",
                      "HOUSE",
                      "APARTMENT",
                      "TOWNHOUSE"
                    ]
                  }
                },
                "required": [
                  "propertyType"
                ],
                "additionalProperties": false
              },
              "rentals": {
                "type": "object",
                "properties": {
                  "dwellingType": {
                    "type": "string",
                    "enum": [
                      "ALL",
                      "HOUSE",
                      "FLAT",
                      "APARTMENT",
                      "TOWNHOUSE",
                      "TERRACE",
                      "SEMI",
                      "OTHER"
                    ]
                  },
                  "bedrooms": {
                    "type": "string",
                    "pattern": "^(ALL|(?:[0-9]|1[0-9]|20)\\+?)$"
                  }
                },
                "required": [
                  "dwellingType",
                  "bedrooms"
                ],
                "additionalProperties": false
              },
              "inventory": {
                "type": "object",
                "properties": {
                  "propertyType": {
                    "type": "string",
