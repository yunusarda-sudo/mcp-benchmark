{
  "$schema": "../schema.json",
  "name": "io.github.ChristopherLaughlin/mcp-sec-edgar",
  "title": "SEC EDGAR Financials",
  "category": "Developer Tools & DevOps",
  "description": "Live SEC EDGAR XBRL financials and filings. Pay per call in USDC via x402, or a Pro API key.",
  "repository": "https://github.com/ChristopherLaughlin/factory-mcp-docs",
  "tools": [
    {
      "name": "get_company_financials",
      "description": "Reported financial values from SEC EDGAR XBRL company facts. metrics accepts aliases (revenue, net_income, operating_income, gross_profit, eps_basic, eps_diluted, total_assets, total_liabilities, stockholders_equity, cash, operating_cash_flow, capex, long_term_debt, shares_outstanding) or raw XBRL concepts like 'us-gaap:Revenues'. Values are exactly as filed; nothing is estimated.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "ticker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10,
            "description": "Stock ticker, e.g. AAPL"
          },
          "metrics": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "periods": {
            "default": 4,
            "description": "Number of most recent periods",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "frequency": {
            "default": "annual",
            "type": "string",
            "enum": [
              "annual",
              "quarterly"
            ]
          }
        },
        "required": [
          "ticker",
          "metrics"
        ]
      }
    },
    {
      "name": "get_latest_filings",
      "description": "Most recent EDGAR filings for a ticker, filtered by form type (e.g. 10-K, 10-Q, 8-K, 4). Empty form_types = all forms.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "ticker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10
          },
          "form_types": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            }
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "ticker"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.ChristopherLaughlin/mcp-sec-edgar",
    "version": "0.1.1",
    "remoteUrl": "https://mcp-sec-edgar.scorematic.workers.dev/mcp",
    "publishedAt": "2026-11-26T06:16:14.974795Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "86e6c81f9fbc3a98c8f6bf8be177cd219b7413ea2c887e44c02e632e5fb22dab"
  }
}
