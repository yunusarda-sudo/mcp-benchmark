{
  "$schema": "../schema.json",
  "name": "io.github.kushkillerjsixx66/vara-mcp-server",
  "title": "Vara MCP — Field Intelligence Scan Server",
  "category": "AI, LLMs & Agents",
  "description": "Governed weak-signal scanning for AI agents: multi-plane harvest, per-signal lineage, intel reports.",
  "tools": [
    {
      "name": "vara_run_scan",
      "description": "Run a live scan of public sources for weak signals on a topic. Searches the selected planes (source categories) over the last sweep_depth_hours for the given keywords and target entities, scores what it finds for novelty, and returns a scan report whose signals each carry their source and retrieval time, plus a scan_id for follow-up calls. The only tool that changes state; it makes live network requests and can take a while.",
      "inputSchema": {
        "properties": {
          "keywords": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Keywords"
          },
          "active_planes": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "social",
                    "scientific",
                    "tech",
                    "adjacent_possible",
                    "economic",
                    "dark",
                    "geopolitical",
                    "persons",
                    "firecrawl"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Active Planes"
          },
          "sweep_depth_hours": {
            "default": 24,
            "title": "Sweep Depth Hours",
            "type": "integer"
          },
          "scan_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Scan Label"
          },
          "enable_dual_track": {
            "default": true,
            "title": "Enable Dual Track",
            "type": "boolean"
          },
          "high_novelty_floor": {
            "default": 0.15,
            "title": "High Novelty Floor",
            "type": "number"
          },
          "weak_novelty_floor": {
            "default": 0.05,
            "title": "Weak Novelty Floor",
            "type": "number"
          },
          "enable_multi_timescale": {
            "default": true,
            "title": "Enable Multi Timescale",
            "type": "boolean"
          },
          "use_firecrawl": {
            "default": false,
            "title": "Use Firecrawl",
            "type": "boolean"
          },
          "generate_fir": {
            "default": false,
            "title": "Generate Fir",
            "type": "boolean"
          },
          "extra_rss_feeds": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Extra Rss Feeds"
          },
          "extra_substacks": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Extra Substacks"
          },
          "target_entities": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Target Entities"
          }
        },
        "title": "vara_run_scanArguments",
        "type": "object"
      }
    },
    {
      "name": "vara_list_scans",
      "description": "List previous scans, newest first (metadata only). History is kept in an archive local to the running server instance, so older scans may no longer be listed.",
      "inputSchema": {
        "properties": {
          "limit": {
            "default": 20,
            "title": "Limit",
            "type": "integer"
          },
          "since": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Since"
          },
          "label_contains": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Label Contains"
          }
        },
        "title": "vara_list_scansArguments",
        "type": "object"
      }
    },
    {
      "name": "vara_get_scan",
      "description": "Get the complete report of a previous scan by its scan_id (a unique prefix works too), including the signals it found.",
      "inputSchema": {
        "properties": {
          "scan_id": {
            "title": "Scan Id",
            "type": "string"
          },
          "include_signals": {
            "default": true,
            "title": "Include Signals",
            "type": "boolean"
          }
        },
        "required": [
          "scan_id"
        ],
        "title": "vara_get_scanArguments",
        "type": "object"
      }
    },
    {
      "name": "vara_query_signals",
      "description": "Search the signals collected by past scans. Filter by plane (source category), minimum novelty score, entity, or date range. Set include_veil_hold to also search signals that were held back as too weak (see vara_get_veil_state).",
      "inputSchema": {
        "properties": {
          "plane": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Plane"
          },
          "min_novelty": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Min Novelty"
          },
          "entity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Entity"
          },
          "since": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Since"
          },
          "until": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Until"
          },
          "origin": {
            "default": "any",
            "enum": [
              "passed",
              "veil_promoted",
              "any"
            ],
            "title": "Origin",
            "type": "string"
          },
          "canonized_only": {
            "default": false,
            "title": "Canonized Only",
            "type": "boolean"
          },
          "include_veil_hold": {
            "default": false,
            "title": "Include Veil Hold",
            "type": "boolean"
          },
          "limit": {
            "default": 50,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "vara_query_signalsArguments",
        "type": "object"
      }
    },
    {
      "name": "vara_get_veil_state",
      "description": "Show the Veil: signals Vara judged too weak to pass when first seen, kept on a watch list and re-checked over time. Trajectories show whether a held signal is strengthening or fading. Held signals are unverified — being in the Veil is not a result.",
      "inputSchema": {
        "properties": {
          "plane": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Plane"
          },
          "signal_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Signal Id"
          },
          "include_trajectories": {
            "default": true,
            "title": "Include Trajectories",
            "type": "boolean"
          }
        },
        "title": "vara_get_veil_stateArguments",
        "type": "object"
      }
    },
    {
      "name": "vara_generate_fir",
      "description": "Turn a scan into a Field Intel Report: a readable intelligence brief built from the scan's signals, with provenance attached. format 'operator_tier' is the full report; 'lightweight' is a short brief.",
      "inputSchema": {
        "properties": {
          "scan_id": {
            "title": "Scan Id",
            "type": "string"
          },
          "series": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Series"
          },
          "baseline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Baseline"
          },
          "format": {
            "default": "operator_tier",
            "enum": [
              "operator_tier",
              "lightweight"
            ],
            "title": "Format",
            "type": "string"
          },
          "next_cycle_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Next Cycle Hint"
          }
        },
        "required": [
          "scan_id"
        ],
        "title": "vara_generate_firArguments",
        "type": "object"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.kushkillerjsixx66/vara-mcp-server",
    "version": "1.30.1",
    "remoteUrl": "https://vara-mcp-server.vercel.app/api/mcp",
    "publishedAt": "2026-11-26T20:44:30.956447Z",
