{
 "$schema": "../schema.json",
 "name": "cc.map-maker/map-maker",
 "title": "Map Maker",
 "category": "Design, UI & 3D Media",
 "description": "Create styled world maps from Natural Earth country boundaries and export editable SVG.",
 "tools": [
  {
   "name": "create_map_session",
   "description": "Create a temporary flat map draft.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
     }
    },
    "required": [],
    "additionalProperties": false
   }
  },
  {
   "name": "search_countries",
   "description": "Find Natural Earth country IDs by name or code.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
     },
     "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
     }
    },
    "required": [
     "query"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "get_map_session",
   "description": "Read the draft settings, styles, and assignments.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
     }
    },
    "required": [
     "session_id"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "delete_map_session",
   "description": "Delete a draft and free its capacity.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
     }
    },
    "required": [
     "session_id"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "create_style",
   "description": "Create a reusable style. Colors are hexadecimal CSS colors.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
     },
     "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
     },
     "fill": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
     },
     "pattern": {
      "type": "string",
      "enum": [
       "solid",
       "diagonal-stripes",
       "dots",
       "crosshatch"
      ]
     },
     "stroke": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
     },
     "stroke_width": {
      "type": "number",
      "minimum": 0,
      "maximum": 20
     }
    },
    "required": [
     "session_id",
     "name",
     "fill"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "assign_style_to_countries",
   "description": "Apply a style to Natural Earth country IDs.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
     },
     "style_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
     },
     "country_ids": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1,
       "maxLength": 12
      },
      "minItems": 1,
      "maxItems": 250,
      "uniqueItems": true
     }
    },
    "required": [
     "session_id",
     "style_id",
     "country_ids"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "set_projection",
   "description": "Select a flat-map projection.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
     },
     "projection": {
      "type": "string",
      "enum": [
       "equirectangular",
       "sinusoidal",
       "mollweide"
      ]
     }
    },
    "required": [
     "session_id",
     "projection"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "set_center",
   "description": "Set map center in degrees.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
     },
     "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
     },
     "latitude": {
      "type": "number",
      "minimum": -85,
      "maximum": 85
     }
    },
    "required": [
     "session_id",
     "longitude",
     "latitude"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "set_zoom",
   "description": "Set the map viewport zoom. Use 1 to show the full map.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
     },
     "zoom": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
     }
    },
    "required": [
     "session_id",
     "zoom"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "set_legend",
   "description": "Update the legend. Position is measured from the top-left of the viewport.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
     },
     "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
     },
     "visible": {
      "type": "boolean"
     },
     "show_country_counts": {
      "type": "boolean"
     },
     "appearance": {
      "type": "string",
      "enum": [
       "glass",
       "paper",
       "slate"
      ]
     },
     "x": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
     },
     "y": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
     },
     "scale": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 3
     }
    },
    "required": [
     "session_id"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "export_svg",
   "description": "Create a downloadable standalone SVG snapshot of the current map.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
     }
    },
    "required": [
     "session_id"
    ],
    "additionalProperties": false
   }
  }
 ],
 "source": {
  "type": "registry",
  "registry": "registry.modelcontextprotocol.io",
  "name": "cc.map-maker/map-maker",
  "version": "0.1.0",
  "remoteUrl": "https://map-maker.cc/mcp",
  "publishedAt": "2026-11-21T11:47:35.017238Z",
