              "moneyline",
              "spread",
              "total"
            ]
          },
          "min_drop_pct": {
            "default": 1,
            "type": "number",
            "minimum": 0.1,
            "exclusiveMaximum": 100
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_leagues",
      "description": "Discover leagues present in retained events, with retained and upcoming scheduled event counts. Counts do not guarantee current live coverage. Stored DraftKings via ESPN only. Offset pages are not a frozen snapshot.",
      "inputSchema": {
