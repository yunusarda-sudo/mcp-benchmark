    {
      "name": "search_events",
      "description": "Search retained home/away team names by literal case-insensitive text. May include past scheduled events. Stored DraftKings via ESPN only. Keep capture timestamps; offset pages are not a frozen snapshot.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "q": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "sport": {
            "type": "string",
            "enum": [
              "NFL",
              "NBA",
              "NHL",
              "NCAAF",
              "NCAAB",
              "MLB",
              "EPL",
              "MLS"
            ]
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_event",
      "description": "Read one retained source event by id, or EVENT_NOT_FOUND. IDs are source-specific, not canonical across bookmakers. Stored DraftKings via ESPN only. Keep capture timestamps; offset pages are not a frozen snapshot.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[-A-Za-z0-9_:]{1,180}$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_multiple_event_odds",
      "description": "Read a combined page of stored offers for up to 20 distinct comma-separated event_ids. Missing events are not invented. Stored DraftKings via ESPN only. Keep capture timestamps; offset pages are not a frozen snapshot.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "event_ids": {
            "type": "string"
          },
          "sport": {
            "type": "string",
            "enum": [
              "NFL",
              "NBA",
              "NHL",
              "NCAAF",
              "NCAAB",
              "MLB",
              "EPL",
              "MLS"
            ]
          },
          "market": {
            "type": "string",
            "enum": [
              "moneyline",
              "spread",
              "total"
            ]
          },
          "fresh_only": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "event_ids"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_updated_odds",
      "description": "Read current offers with retained changes strictly after since, within the last seven days. Not durable replay or complete change history. Stored DraftKings via ESPN only. Keep capture timestamps; offset pages are not a frozen snapshot.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "since": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "sport": {
            "type": "string",
            "enum": [
              "NFL",
              "NBA",
              "NHL",
              "NCAAF",
              "NCAAB",
              "MLB",
              "EPL",
              "MLS"
            ]
          },
          "market": {
            "type": "string",
            "enum": [
              "moneyline",
              "spread",
              "total"
            ]
          },
          "fresh_only": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "since"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_dropping_odds",
      "description": "Read same-line decimal-price decreases across the latest two retained changes within 24 hours. Requires fresh captures and an upcoming scheduled event. Not a value or arbitrage signal. Stored DraftKings via ESPN only. Keep capture timestamps; offset pages are not a frozen snapshot.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "sport": {
