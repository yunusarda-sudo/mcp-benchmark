        "type": "object",
        "properties": {
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "after": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,180}$"
          },
          "event_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,180}$"
          },
          "league": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,180}$"
          },
          "sport": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,180}$"
          }
        },
        "additionalProperties": false
      }
    },
