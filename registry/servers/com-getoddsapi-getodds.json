        "additionalProperties": false
      }
    },
    {
      "name": "get_historical_events",
      "description": "Read retained scheduled events in [from,to), a maximum 31-day interval ending no later than now. UTC Z timestamps required. Completion state is unknown; not a complete finished-event archive. Stored DraftKings via ESPN only. Offset pages are not a frozen snapshot.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
