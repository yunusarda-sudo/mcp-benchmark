{
  "$schema": "../schema.json",
  "name": "com.getoddsapi/getodds",
  "title": "GetOdds",
  "category": "Developer Tools & VCS",
  "description": "Odds API: bet365, DraftKings, FanDuel, Pinnacle, BetRivers, Novig, PrizePicks, Underdog, Pick6.",
  "repository": "https://github.com/getoddsapi/getodds-mcp",
  "tools": [
    {
      "name": "get_prediction_markets",
      "description": "Read Kalshi or Polymarket player-prop contracts (best ask, dollars per $1 contract) with implied probability, American and decimal odds, the venue no-vig probability, matched BetRivers US-PA prices and edge versus the sportsbook no-vig probability. Available to every key. Edge is not a guaranteed profit; fees and fills are not modeled.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "source": {
            "default": "kalshi",
            "type": "string",
            "enum": [
              "kalshi",
              "polymarket"
            ]
          },
          "league": {
            "type": "string",
            "enum": [
              "NBA",
              "NFL",
              "NHL"
            ]
          },
          "player": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "stat": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_pinnacle_markets",
      "description": "Read Pinnacle pregame prices (international book, not US-licensed): moneyline, spread, total, team total and specials (player props, futures and other Pinnacle specials with their native category) for NFL, NCAAF, NBA, NCAAB, NHL, EPL, MLS, UCL and Bundesliga. Available to every key. Read through at request time (reused up to 20 seconds); no Pinnacle history is stored.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "league": {
            "default": "NFL",
            "type": "string",
            "enum": [
              "NFL",
              "NCAAF",
              "NBA",
              "NCAAB",
              "NHL",
              "EPL",
              "MLS",
              "UCL",
              "BUNDESLIGA"
            ]
          },
          "market": {
            "type": "string",
            "enum": [
              "moneyline",
              "spread",
              "total",
              "team_total",
              "special"
            ]
          },
          "matchup_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,14}$"
          },
          "alternates": {
            "default": false,
            "type": "boolean"
          },
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_player_props",
      "description": "Read pregame player props at every book GetOdds carries for one sport, merged per player, stat and game day: FanDuel, DraftKings, BetRivers, Pinnacle and Novig prices (American odds; Novig is the exchange ask), PrizePicks, Underdog and DK Pick6 lines, the median line, best over and under, a no-vig fair price and pick’em gaps. Available to every key. Quotes with history=true work with get_prop_history.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "sport": {
            "type": "string",
            "enum": [
              "nba",
              "nfl",
              "nhl",
              "ncaaf",
              "ncaab"
            ]
          },
          "books": {
            "description": "Comma list of fanduel, draftkings, betrivers, pinnacle, novig, prizepicks, underdog, pick6",
            "type": "string",
            "pattern": "^[a-z0-9,]{2,120}$"
          },
          "player": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "stat": {
            "type": "string",
            "pattern": "^[a-z_]{2,40}$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "min_books": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "required": [
          "sport"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_prop_history",
      "description": "Read the recorded line and price changes for one player-prop quote, oldest first, with its open and its close (the last quote before the start). Books with history: fanduel, draftkings, prizepicks, novig, underdog, pick6. Pass the book and the quote id from get_player_props.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "book": {
            "type": "string",
            "enum": [
              "fanduel",
              "draftkings",
              "prizepicks",
              "novig",
              "underdog",
              "pick6"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{3,80}$"
          },
          "limit": {
            "default": 200,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "book",
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_novig_markets",
      "description": "Read Novig exchange pregame prices: moneyline, spread, total, team total and player props, with the ask (the price a taker gets) in American and decimal odds, the bid, and the no-vig fair price. is_main marks the most balanced strike; alternates=true returns every strike. Available to every key.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "league": {
            "default": "NFL",
            "type": "string",
            "enum": [
              "NFL",
              "NBA",
              "NHL",
              "NCAAF",
              "NCAAB",
              "MLB",
              "EPL",
              "MLS",
              "LA_LIGA",
              "BUNDESLIGA",
              "SERIE_A",
              "LIGUE_1",
              "ATP",
              "WTA"
            ]
          },
          "market": {
            "type": "string",
            "enum": [
              "moneyline",
              "spread",
              "total",
              "team_total",
              "player_prop"
            ]
          },
          "event_id": {
            "type": "string",
            "pattern": "^[0-9a-f-]{8,64}$"
          },
          "player": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "alternates": {
            "default": false,
            "type": "boolean"
          },
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_bet365_markets",
      "description": "Read bet365 pregame prices: moneyline, spread, total and team total for NFL, NCAAF, NBA, NCAAB, NHL and MLS, and match result, double chance, goal line and goalscorer markets for EPL, Bundesliga, Serie A, Ligue 1 and the Champions League, in American, decimal and fractional odds. Not bet365’s own feed: bet365 prices republished from public odds aggregators, US leagues re-read as often as every 60 seconds; each row names its republisher. Goalscorer markets need market=. Available to every key.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "league": {
            "default": "NFL",
            "type": "string",
            "enum": [
              "NFL",
              "NCAAF",
              "NBA",
              "NCAAB",
              "NHL",
              "MLB",
              "MLS",
              "EPL",
              "BUNDESLIGA",
              "SERIE_A",
              "LIGUE_1",
              "UCL",
              "LA_LIGA"
            ]
          },
          "market": {
            "type": "string",
            "enum": [
              "moneyline",
              "spread",
              "total",
              "team_total",
              "match_result",
              "double_chance",
              "goal_line",
              "anytime_goalscorer",
              "first_goalscorer",
              "last_goalscorer"
            ]
          },
          "event_id": {
            "type": "string",
            "pattern": "^(an|espn)-[0-9A-Za-z]{1,30}$"
          },
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_prediction_market_history",
      "description": "Read stored price changes for one Kalshi or Polymarket contract id from get_prediction_markets, newest first, last 14 days.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "source": {
            "default": "kalshi",
            "type": "string",
            "enum": [
              "kalshi",
              "polymarket"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8,64}$"
          },
          "limit": {
            "default": 100,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_markets",
      "description": "Read partial player thresholds from a granted source: PrizePicks, Underdog, DraftKings Pick6 or FanDuel props. odds is null; preserve observation timestamps.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "source": {
            "default": "prizepicks",
            "type": "string",
            "enum": [
              "prizepicks",
              "underdog",
              "draftkings",
              "fanduel"
            ]
          },
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_events",
      "description": "Read stored DraftKings-via-ESPN events. Preserve capture time and source identifiers. Offset pages are not a frozen snapshot.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "limit": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "offset": {
            "default": 0,
