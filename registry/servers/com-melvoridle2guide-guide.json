{
  "$schema": "../schema.json",
  "name": "com.melvoridle2guide/guide",
  "title": "Melvor Idle 2 Guide",
  "category": "Productivity & Notes",
  "description": "Melvor Idle 2 wiki, calculators, and opt-in player progress comparisons.",
  "repository": "https://github.com/BenjaminHan123/MelvorIdle2_MCP",
  "tools": [
    {
      "name": "search_wiki",
      "description": "Search the published wiki by English name or keyword. Set type to Action or Income route to search that calculator’s published presets. For a Quest step, pass its questId and section ID to get_wiki_entry as a Quest.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "type": {
            "type": "string",
            "enum": [
              "Item",
              "Skill",
              "Quest",
              "Enemy",
              "Dungeon",
              "Hunting",
              "Guide",
              "Calculator",
              "Action",
              "Income route",
              "Quest step"
            ]
          },
          "limit": {
            "default": 8,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_wiki_entry",
      "description": "Read the published guide for a type and ID from search_wiki. Returns an outline and paginated text, table rows and source links. Pass a section ID from the outline for a specific topic, such as drops or recipes. Action and Income route return their published calculator presets.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Item",
              "Skill",
              "Quest",
              "Enemy",
              "Dungeon",
              "Hunting",
              "Guide",
              "Calculator",
              "Action",
              "Income route"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "section": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "limit": {
            "default": 8,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "required": [
          "type",
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "calculate_xp",
      "description": "Plan actions, time, XP and missing materials for a target level, remaining XP, or a batch of items. Use an Action ID from search_wiki or supply your measured action values. Stock defaults to zero. Results use base rates unless you supply measured values.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "action": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "preset"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                  },
                  "stock": {
                    "default": {},
                    "description": "Bank quantities keyed by material item ID, as returned by get_wiki_entry for the action.",
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000000
                    }
                  }
                },
                "required": [
                  "mode",
                  "id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "manual"
                  },
                  "xpPerAction": {
                    "type": "number",
                    "minimum": 0.001,
                    "maximum": 1000000000
                  },
                  "secondsPerAction": {
                    "type": "number",
                    "minimum": 0.001,
                    "maximum": 1000000000
                  },
                  "productsPerAction": {
                    "default": 1,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000000
                  },
                  "materials": {
                    "default": [],
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "perAction": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1000000000
                        },
                        "stock": {
                          "default": 0,
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000000
                        }
                      },
                      "required": [
                        "name",
                        "perAction"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "mode",
                  "xpPerAction",
                  "secondsPerAction"
                ],
                "additionalProperties": false
              }
            ]
          },
          "goal": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "level"
                  },
                  "targetLevel": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000000
                  },
                  "current": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "level": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 1000000000
                          }
                        },
                        "required": [
                          "level"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "xp": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1000000000
                          }
                        },
                        "required": [
                          "xp"
                        ],
                        "additionalProperties": false
                      }
                    ],
                    "description": "Total current skill XP, or the current level at its starting threshold."
                  }
                },
                "required": [
                  "mode",
                  "targetLevel",
                  "current"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "remaining"
                  },
                  "xp": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000000
                  }
                },
                "required": [
                  "mode",
                  "xp"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "craft"
                  },
                  "targetItems": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "existingItems": {
                    "default": 0,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "currentLevel": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000000
                  }
                },
                "required": [
                  "mode",
                  "targetItems"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "action",
          "goal"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "calculate_drop",
      "description": "Calculate the chance of at least one drop, expected items and GP from independent kills. Use an enemy and item ID for site presets or provide manual values. Chance inputs and numeric probability results are fractions from 0 to 1.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "kills": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "killsPerHour": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          },
          "costPerKillGp": {
            "default": 0,
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          },
          "drop": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "preset"
                  },
                  "enemyId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                  },
                  "itemId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                  }
                },
                "required": [
                  "mode",
                  "enemyId",
                  "itemId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "manual"
                  },
                  "chance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "quantityOnSuccess": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "sellGp": {
                    "default": 0,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "directGpPerKill": {
                    "default": 0,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "otherLootGpPerKill": {
                    "default": 0,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000000
                  }
                },
                "required": [
                  "mode",
                  "chance",
                  "quantityOnSuccess"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "kills",
          "drop"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "calculate_gp",
      "description": "Calculate net GP, GP per hour and time to a GP goal from a website Income route ID or a measured run. Input fields override preset values. Active time is required for a manual run.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "routeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "activeSeconds": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 1000000000
          },
          "gatheringSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          },
          "units": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          },
          "unitGp": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          },
          "directGp": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          },
          "otherGp": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          },
          "costsGp": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          },
          "stockValue": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          },
          "goalGp": {
            "default": 0,
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "check_idle_combat",
      "description": "Check whether a specified hit leaves the player alive before Auto Eat. Supply the largest HP loss after protection, including concurrent effects before the next check. Optionally estimate food from a measured test fight.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "maxHp": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "thresholdPercent": {
            "description": "Defaults to the value displayed on the website.",
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "incomingDamage": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "food": {
            "type": "object",
            "properties": {
              "available": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              },
              "usedPerMinute": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              },
              "minutes": {
                "type": "number",
                "minimum": 1,
                "maximum": 1000000
              }
            },
            "required": [
              "available",
              "usedPerMinute",
              "minutes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "maxHp",
          "incomingDamage"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "read_player_save",
      "description": "Read only the player snapshot JSON that the player explicitly shared from My character. Use itemIds to inspect selected bank counts, or compare a published recipe against the shared skill XP and bank. Never ask for a raw save string or a file path.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "snapshot": {
            "type": "object",
            "properties": {
              "format": {
                "type": "string",
                "const": "melvor2-guide-player-v1"
              },
              "source": {
                "type": "string",
                "enum": [
                  "game-save",
                  "guide-character"
                ]
              },
              "saveVersion": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "skills": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "level": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "xp": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "additionalProperties": false
                }
              },
              "bank": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "unmappedBankItems": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "totals": {
                "type": "object",
                "properties": {
                  "totalLevel": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "gp": {
                    "type": "string",
                    "pattern": "^\\d{1,19}$"
                  }
                },
                "required": [
                  "totalLevel",
                  "gp"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "format",
              "source"
            ],
            "additionalProperties": false
          },
          "itemIds": {
            "default": [],
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "compare": {
            "type": "object",
            "properties": {
              "actionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "targetItems": {
                "description": "Desired total in the bank. When omitted, compare the materials for one batch.",
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000
              }
            },
            "required": [
              "actionId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "snapshot"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.melvoridle2guide/guide",
    "version": "1.0.0",
