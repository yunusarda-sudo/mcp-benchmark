{
  "$schema": "../schema.json",
  "name": "com.gurify/signing",
  "title": "Signing for agents",
  "category": "AI, LLMs & Agents",
  "description": "E-signatures for AI agents: a signing link for each person, which you send. It sends no email.",
  "tools": [
    {
      "name": "create_account",
      "description": "Make an account and an API token, with no email and no human. Needs no token. Nothing is sent to the email address; it names the account. Returns api_token (and a generated password for the web app).",
      "inputSchema": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The account's name, e.g. your user's business."
          },
          "email": {
            "type": "string",
            "description": "The account's login. Nothing is ever sent to it."
          },
          "password": {
            "type": "string",
            "description": "Optional. 8 to 72 characters with upper and lower case, a digit and a symbol. Made for you if missing."
          },
          "token_name": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "send_for_signing",
      "description": "Upload a PDF, place the fields for each person, and get a signing link for each one. Nothing is emailed: send each signing_url to its own person yourself.",
      "inputSchema": {
        "type": "object",
        "required": [
          "title",
          "recipients"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "pdf_base64": {
            "type": "string",
            "description": "The PDF, base64. Or give pdf_url."
          },
          "pdf_url": {
            "type": "string",
            "description": "A public http(s) address of the PDF (15 MB at most)."
          },
          "recipients": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "name",
                "email"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "email": {
                  "type": "string",
                  "description": "Names the person in the audit log. Nothing is sent to it."
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "SIGNER",
                    "APPROVER",
                    "VIEWER",
                    "CC",
                    "ASSISTANT"
                  ],
                  "default": "SIGNER"
                },
                "signing_order": {
                  "type": "integer",
                  "description": "For SEQUENTIAL signing."
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "type",
                      "page",
                      "positionX",
                      "positionY",
                      "width",
                      "height"
                    ],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "SIGNATURE",
                          "FREE_SIGNATURE",
                          "INITIALS",
                          "NAME",
                          "EMAIL",
                          "DATE",
                          "TEXT",
                          "NUMBER",
                          "CHECKBOX",
                          "RADIO",
                          "DROPDOWN"
                        ]
                      },
                      "page": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Counts from 1."
                      },
                      "positionX": {
                        "type": "number",
                        "description": "Percent of the page width, from the left edge."
                      },
                      "positionY": {
                        "type": "number",
                        "description": "Percent of the page height, from the top edge."
                      },
                      "width": {
                        "type": "number",
                        "description": "Percent of the page width."
                      },
                      "height": {
                        "type": "number",
                        "description": "Percent of the page height."
                      },
                      "fieldMeta": {
                        "type": "object",
                        "description": "Choices and options for RADIO, CHECKBOX, DROPDOWN and TEXT fields, as in Documenso's API v2."
                      }
                    }
                  }
                }
              }
            }
          },
          "signing_order": {
            "type": "string",
            "enum": [
              "PARALLEL",
              "SEQUENTIAL"
            ],
            "default": "PARALLEL"
          },
          "timezone": {
            "type": "string",
            "description": "IANA zone for dates, e.g. America/Phoenix."
          },
          "date_format": {
            "type": "string",
            "description": "e.g. MM/dd/yyyy"
          },
          "redirect_url": {
            "type": "string",
            "description": "The page a person sees after signing."
          }
        }
      }
    },
    {
      "name": "get_envelope",
      "description": "The status of an envelope (DRAFT, PENDING, COMPLETED, REJECTED, CANCELLED), each person's signing and read status, and the signing link of each person who has not signed yet.",
      "inputSchema": {
        "type": "object",
        "required": [
          "envelope_id"
        ],
        "properties": {
          "envelope_id": {
            "type": "string",
            "description": "As returned by send_for_signing."
          }
        }
      }
    },
    {
      "name": "list_envelopes",
      "description": "Your envelopes, newest first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PENDING",
              "COMPLETED",
              "REJECTED"
            ]
          },
          "query": {
            "type": "string",
            "description": "Search the titles."
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    {
      "name": "download_document",
      "description": "Download a PDF of an envelope: the signed document (once COMPLETED), the original, the signing certificate or the audit log. Returned as an embedded PDF resource.",
      "inputSchema": {
        "type": "object",
        "required": [
          "envelope_id"
        ],
        "properties": {
          "envelope_id": {
            "type": "string"
          },
          "which": {
            "type": "string",
            "enum": [
              "signed",
              "original",
              "certificate",
              "audit_log"
            ],
            "default": "signed"
          }
        }
      }
    },
    {
      "name": "cancel_envelope",
      "description": "Cancel a pending envelope: its signing links stop working. Nobody is told; tell them yourself.",
      "inputSchema": {
        "type": "object",
        "required": [
          "envelope_id"
        ],
        "properties": {
          "envelope_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "delete_envelope",
      "description": "Delete an envelope.",
      "inputSchema": {
        "type": "object",
        "required": [
          "envelope_id"
        ],
        "properties": {
          "envelope_id": {
            "type": "string",
            "description": "As returned by send_for_signing."
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.gurify/signing",
    "version": "1.0.0",
    "remoteUrl": "https://sign.gurify.com/mcp",
    "publishedAt": "2026-11-24T16:00:28.407736Z",
