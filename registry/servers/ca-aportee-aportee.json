{
  "$schema": "../schema.json",
  "name": "ca.aportee/aportee",
  "title": "à portée",
  "category": "Developer Tools & DevOps",
  "description": "Walking, cycling and transit times to everyday places from any point in Canada.",
  "repository": "https://github.com/ammil-industries/aportee-mcp",
  "tools": [
    {
      "name": "travel_times",
      "description": "Counts 1 request per point, whatever the modes; a batch needs a key. Minutes to the nearest place of each amenity type by each mode asked, with basis (block or hexagon) and links.map. points answers a batch in rows, failed points in errors. Next: nearby_places for names, get_catalog for types and coverage.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "description": "Latitude, decimal degrees (Canada 41.6 to 83.2)."
          },
          "lon": {
            "type": "number",
            "description": "Longitude, decimal degrees (Canada -141.1 to -52.6)."
          },
          "points": {
            "description": "1–100 points in place of lat, lon (key); a label comes back with its row.",
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lat": {
                  "type": "number"
                },
                "lon": {
                  "type": "number"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "lat",
                "lon"
              ],
              "additionalProperties": false
            }
          },
          "modes": {
            "description": "Default walk.",
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "walk",
                "bike",
                "transit",
                "bike_transit"
              ]
            }
          },
          "period": {
            "description": "Transit modes; default weekday_peak, others need a key.",
            "type": "string",
            "enum": [
              "weekday_peak",
              "weekday_night",
              "saturday_midday",
              "sunday_midday"
            ]
          },
          "statistic": {
            "description": "Transit modes: p50 typical (default), p90 worst case (key).",
            "type": "string",
            "enum": [
              "p50",
              "p90"
            ]
          },
          "types": {
            "description": "Default every type.",
            "minItems": 1,
            "maxItems": 35,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "grocery",
                "pharmacy",
                "bakery",
                "restaurant",
                "cafe",
                "bar",
                "school",
                "library",
                "park",
                "playground",
                "childcare",
                "community_centre",
                "hospital",
                "clinic",
                "nursing_home",
                "bookstore",
                "hardware",
                "bike_shop",
                "post_secondary",
                "convenience_store",
                "post_office",
                "bank",
                "dentist",
                "laundromat",
                "dog_park",
                "place_of_worship",
                "pool",
                "ice_rink",
                "sports_field",
                "gym",
                "cinema",
                "liquor_store",
                "dollar_store",
                "recreation_centre",
                "fire_station"
              ]
            }
          },
          "include": {
            "description": "One point only. walk_counts: places within walk_budget on foot, routed cities only.",
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "population",
                "place",
                "walk_counts"
              ]
            }
          },
          "walk_budget": {
            "description": "walk_counts' walk, 5–55 min (default 15); also the map link's budget. It does not filter the times.",
            "type": "integer",
            "minimum": 5,
            "maximum": 55
          },
          "lang": {
            "description": "en or fr.",
            "type": "string",
            "enum": [
              "en",
              "fr"
            ]
          },
          "api_key": {
            "type": "string",
            "description": "Key from check_sign_in, if this client sends none."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "nearby_places",
      "description": "Counts 1 request. By default for each of the eight everyday trips: the nearest place on foot with walking minutes, compass direction and whether within the trip's limit, then up to two more within 30 minutes. types may also ask school, elementary_school, secondary_school, childcare, playground or hospital where the release has them (limits 15, 15, 15, 15, 10, 30 min), else it refuses with the types it has; school includes a few driving schools, so for a child ask elementary_school or secondary_school. Walking only, from the point's H3 cell (basis). links.map opens the map's compass; picture adds it as an image (1 more request). Next: walking_routes for a path (key), travel_times for other modes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "description": "Latitude, decimal degrees (Canada 41.6 to 83.2)."
          },
          "lon": {
            "type": "number",
            "description": "Longitude, decimal degrees (Canada -141.1 to -52.6)."
          },
          "types": {
            "description": "Default the eight everyday trips; the six others where the release has them.",
            "minItems": 1,
            "maxItems": 14,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "grocery",
                "pharmacy",
                "convenience_store",
                "bank",
                "park",
                "cafe",
                "library",
                "clinic",
                "school",
                "elementary_school",
                "secondary_school",
                "childcare",
                "playground",
                "hospital"
              ]
            }
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "fr"
            ],
            "description": "en or fr."
          },
          "picture": {
            "description": "Also the compass as a PNG.",
            "type": "boolean"
          },
          "api_key": {
            "type": "string",
            "description": "Key from check_sign_in, if this client sends none."
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "walking_routes",
      "description": "Needs a key; counts 1 request per type. The walked path to the nearest place of 1–5 types, routed live in the routed cities: a GeoJSON line per type with minutes, metres and seconds at each vertex; types without one are in missing with a reason. Only when the path itself is needed. Next: travel_times.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "description": "Latitude, decimal degrees (Canada 41.6 to 83.2)."
          },
          "lon": {
            "type": "number",
            "description": "Longitude, decimal degrees (Canada -141.1 to -52.6)."
          },
          "types": {
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "1–5 types. As travel_times' types."
          },
          "api_key": {
            "type": "string",
            "description": "Key from check_sign_in, if this client sends none."
          }
        },
        "required": [
          "lat",
          "lon",
          "types"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "check_trip",
      "description": "Reach: needs a member's key; counts 1 of 50 Reach answers a day. Whether a trip fits between depart and arrive: spare_minutes or short_minutes; by transit, on how many of 7 departures (3 min apart, depart ± 9 min) it fits, and the worst. stop: when to be there; stop_types: the roomiest places to stop at. Next: reach_area or find_meeting_area.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              }
            },
            "required": [
              "lat",
              "lon"
            ],
            "additionalProperties": false,
            "description": "Start."
          },
          "to": {
            "description": "End; omit for a round trip.",
            "type": "object",
            "properties": {
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              }
            },
            "required": [
              "lat",
              "lon"
            ],
            "additionalProperties": false
          },
          "depart": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "description": "HH:MM, 24-hour."
          },
          "arrive": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "description": "HH:MM, at most 300 min after depart."
          },
          "day": {
            "default": "weekday",
            "description": "Mon–Fri is weekday; no holidays, period or statistic.",
            "type": "string",
            "enum": [
              "weekday",
              "saturday",
              "sunday"
            ]
          },
          "mode": {
            "default": "transit",
            "description": "Default transit; no bike_transit.",
            "type": "string",
            "enum": [
              "transit",
              "bike",
              "walk"
            ]
          },
          "max_transfers": {
            "description": "Transit: most changes each way; default 4.",
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "stop": {
            "description": "A place to stop at, and minutes there.",
            "type": "object",
            "properties": {
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              },
              "stay_minutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60
              }
            },
            "required": [
              "lat",
              "lon",
              "stay_minutes"
            ],
            "additionalProperties": false
          },
          "stop_types": {
            "description": "In place of stop: types to stop at one of. As travel_times' types.",
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stay_minutes": {
            "default": 5,
            "description": "With stop_types: least minutes there.",
            "type": "integer",
            "minimum": 5,
            "maximum": 60,
            "multipleOf": 5
          },
          "lang": {
            "default": "en",
            "description": "en or fr.",
            "type": "string",
            "enum": [
              "en",
              "fr"
            ]
          },
          "api_key": {
            "type": "string",
            "description": "Key from check_sign_in, if this client sends none."
          }
        },
        "required": [
          "from",
          "depart",
          "arrive"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "reach_area",
      "description": "Reach: needs a member's key; counts 1 of 50 Reach answers a day. The area within minutes of a point by each mode: km², how many places of each type it holds, and the nearest few by name; by transit, typical (most of 7 departures) and worst case. Next: check_trip to test one trip.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "description": "Latitude, decimal degrees (Canada 41.6 to 83.2)."
          },
          "lon": {
            "type": "number",
            "description": "Longitude, decimal degrees (Canada -141.1 to -52.6)."
          },
          "modes": {
            "default": [
              "transit"
            ],
            "description": "Default transit.",
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "transit",
                "bike",
                "walk"
              ]
            }
          },
          "minutes": {
            "default": 30,
            "description": "5–120; default 30.",
            "type": "integer",
            "minimum": 5,
            "maximum": 120
          },
          "time": {
            "default": {
              "kind": "leave",
              "at": "08:00",
              "day": "weekday"
            },
            "description": "Transit: leave from or arrive at the point then; default leave 08:00.",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "leave",
                  "arrive"
                ]
              },
              "at": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "day": {
                "default": "weekday",
                "description": "Mon–Fri is weekday; no holidays, period or statistic.",
                "type": "string",
                "enum": [
                  "weekday",
                  "saturday",
                  "sunday"
                ]
              }
            },
            "required": [
              "kind",
              "at"
            ],
            "additionalProperties": false
          },
          "types": {
            "default": [
              "grocery",
              "pharmacy",
              "convenience_store",
              "bank",
              "park",
              "cafe",
              "library",
              "clinic"
            ],
            "description": "Default the eight everyday types. As travel_times' types.",
            "minItems": 1,
            "maxItems": 35,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lang": {
            "default": "en",
            "description": "en or fr.",
            "type": "string",
            "enum": [
              "en",
              "fr"
            ]
          },
          "api_key": {
            "type": "string",
            "description": "Key from check_sign_in, if this client sends none."
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "find_meeting_area",
      "description": "Reach: needs a member's key; counts 1 of 50 Reach answers a day. Where everyone, each by their own mode between depart and arrive, could be together at least together_minutes: whether they can, the longest time together, km², and the best places of each type with their shared window. Everyone must be in one routing region. Next: check_trip for one person.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "people": {
            "minItems": 2,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lat": {
                  "type": "number"
                },
                "lon": {
                  "type": "number"
                },
                "mode": {
                  "default": "transit",
                  "description": "Default transit; no bike_transit.",
                  "type": "string",
                  "enum": [
                    "transit",
                    "bike",
                    "walk"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "required": [
                "lat",
                "lon"
              ],
              "additionalProperties": false
            },
            "description": "2–4 people, each from and back to their own point."
          },
          "depart": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "description": "HH:MM, 24-hour."
          },
          "arrive": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "description": "HH:MM, at most 300 min after depart."
          },
          "day": {
            "default": "weekday",
            "description": "Mon–Fri is weekday; no holidays, period or statistic.",
            "type": "string",
            "enum": [
              "weekday",
              "saturday",
              "sunday"
            ]
          },
          "together_minutes": {
            "default": 30,
            "description": "Least time together; default 30.",
            "type": "number",
            "enum": [
              5,
              15,
              30
            ]
          },
          "types": {
            "default": [
              "grocery",
              "pharmacy",
              "convenience_store",
              "bank",
              "park",
              "cafe",
              "library",
              "clinic"
            ],
            "description": "Default the eight everyday types. As travel_times' types.",
            "minItems": 1,
            "maxItems": 35,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lang": {
            "default": "en",
            "description": "en or fr.",
            "type": "string",
            "enum": [
              "en",
              "fr"
            ]
          },
          "api_key": {
            "type": "string",
            "description": "Key from check_sign_in, if this client sends none."
          }
        },
        "required": [
          "people",
          "depart",
          "arrive"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "find_place",
      "description": "Counts 1 request. Up to five towns by name, each with its centre lat and lon, prov and population. Neighbourhoods and suburbs (Kanata, Orléans in Ottawa) are not towns here, and a similar name may be a town elsewhere, so check prov. With lat, lon and a key: places of that name within walk_budget on foot of the point (routed cities). Next: travel_times with a town's point to map it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "A town, such as Toronto; with lat and lon, part of a place's name."
          },
          "province": {
            "description": "To choose between namesakes.",
            "type": "string",
            "enum": [
              "AB",
              "BC",
              "MB",
              "NB",
              "NL",
              "NS",
              "NT",
              "NU",
              "ON",
              "PE",
              "QC",
              "SK",
              "YT"
            ]
          },
          "lat": {
            "type": "number",
            "description": "Latitude, decimal degrees (Canada 41.6 to 83.2)."
          },
          "lon": {
            "type": "number",
            "description": "Longitude, decimal degrees (Canada -141.1 to -52.6)."
          },
          "walk_budget": {
            "description": "With lat and lon: 5–55 min; default 15.",
            "type": "integer",
            "minimum": 5,
            "maximum": 55
          },
          "api_key": {
            "type": "string",
            "description": "Key from check_sign_in, if this client sends none."
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_catalog",
      "description": "Free, not counted. Types with English and French labels, modes and where each works, periods, statistics, reason codes, what needs a key, coverage (with Reach's), the method and the data version; also the aportee:// resources. Next: travel_times.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "account_status",
      "description": "Free, not counted. This connection's tier, daily limit and requests left, key_unlocks, free_without_key, and reach (allowed, remaining, or why not). Next: start_sign_in when a key is needed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "api_key": {
            "type": "string",
            "description": "Key from check_sign_in, if this client sends none."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "start_sign_in",
      "description": "Free, not counted. A sign-in the person approves in their browser: show them verification_url_complete and user_code (valid expires_in seconds). The key is a free member's key: a higher daily limit and every keyed feature (account_status lists them), Reach included. Next: check_sign_in with device_code every interval seconds.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Your name on the approval page.",
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "check_sign_in",
      "description": "Free, not counted. status: pending (ask again after interval), slow_down, denied, expired, or approved with api_key, shown once (then already_issued). Next: repeat the call that needed a key, with api_key as its api_key argument.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "device_code": {
            "type": "string",
            "minLength": 20,
            "maxLength": 100,
            "description": "From start_sign_in."
          }
        },
        "required": [
          "device_code"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
