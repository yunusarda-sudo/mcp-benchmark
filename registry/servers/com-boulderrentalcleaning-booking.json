                  },
                  "addons": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "restock",
                        "linen",
                        "trash",
                        "steam",
                        "snow",
                        "staging",
                        "lockbox",
                        "ownerprep"
