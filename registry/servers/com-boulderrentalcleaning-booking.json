  "title": "Boulder Rental Cleaning",
  "category": "Other",
  "description": "Prices, instant quotes and open dates for short-term and festival rental cleaning in Boulder, CO.",
  "tools": [
    {
      "name": "get_services_and_prices",
      "description": "List Boulder Rental Cleaning's three cleans for short-term and festival rentals in Boulder, CO (prep before guests, mid-stay refresh, clean-out), prices by bedroom count, add-ons, discounts, surcharges, time windows and how to book.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_quote",
      "description": "Price one or more cleans for a Boulder rental home. Uses the same price engine as the booking page. Dates are optional for a ballpark; include date and window for exact festival or rush pricing.",
      "inputSchema": {
        "type": "object",
        "required": [
          "bedrooms",
          "baths",
          "cleans"
        ],
        "properties": {
          "bedrooms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "baths": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "checkIn": {
            "type": "string",
            "description": "Guests' check-in date, YYYY-MM-DD"
          },
          "checkOut": {
            "type": "string",
            "description": "Guests' check-out date, YYYY-MM-DD"
          },
          "cleans": {
            "type": "object",
            "description": "Pick any of prep, mid, out. All three together take the bundle discount.",
            "properties": {
              "prep": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "description": "YYYY-MM-DD (America/Denver)"
                  },
                  "window": {
                    "type": "string",
                    "enum": [
                      "am",
                      "pm"
                    ],
                    "description": "am = crew arrives 8-9 AM, pm = 12-1 PM"
                  },
                  "addons": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "restock",
                        "linen",
                        "trash",
                        "steam",
                        "snow",
                        "staging",
                        "lockbox",
