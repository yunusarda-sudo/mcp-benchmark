{
  "$schema": "../schema.json",
  "name": "com.mardenyard/permits",
  "title": "Marden Yard Permits",
  "category": "Vector DBs & AI Search",
  "description": "Daily US building permits, cleaned: search by area, trade and value, with coverage and freshness.",
  "tools": [
    {
      "name": "search_permits",
      "description": "Permits by area (jurisdiction, ZIP, community area), trade, minimum permit-declared value, date range and confidence floor, with a short brief.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "jurisdiction": {
            "type": "string",
            "description": "Jurisdiction slug: chicago, austin, los-angeles, seattle"
          },
          "zip": {
            "type": "string",
            "description": "5-digit site ZIP (not available for Chicago)"
          },
          "community_area": {
            "type": "string",
            "description": "Chicago community area number"
          },
          "trade": {
            "type": "string",
            "enum": [
              "roofing",
              "solar",
              "hvac",
              "pool",
              "demolition",
              "windows",
              "electrical",
              "plumbing"
            ]
          },
          "min_value": {
            "type": "number",
            "description": "Minimum permit-declared value; only permits with a reliable value match"
          },
          "from": {
            "type": "string",
            "description": "Issued on or after, YYYY-MM-DD"
          },
          "to": {
            "type": "string",
            "description": "Issued on or before, YYYY-MM-DD"
          },
          "days": {
            "type": "integer",
            "description": "Issued in the last N days (default 7; anonymous max 7)"
          },
          "min_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Trade confidence floor, 0-1"
          },
          "limit": {
            "type": "integer",
            "description": "Max rows (anonymous 5, keyed 50)"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "permit_detail",
      "description": "Scope, permit-declared value, status, dates, contractor and the raw source fields for one permit.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "jurisdiction/source permit id, e.g. chicago/B200517005"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "coverage",
      "description": "Which jurisdictions are covered, how fresh each is, and approximate weekly permit volume.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "jurisdiction": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "watch_area",
      "description": "A standing watch on the same criteria that delivers each day's new permits.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "jurisdiction": {
            "type": "string",
            "description": "Jurisdiction slug: chicago, austin, los-angeles, seattle"
          },
          "zip": {
            "type": "string",
            "description": "5-digit site ZIP (not available for Chicago)"
          },
          "community_area": {
            "type": "string",
            "description": "Chicago community area number"
          },
          "trade": {
            "type": "string",
            "enum": [
              "roofing",
              "solar",
              "hvac",
              "pool",
              "demolition",
              "windows",
              "electrical",
              "plumbing"
            ]
          },
          "min_value": {
            "type": "number",
            "description": "Minimum permit-declared value; only permits with a reliable value match"
          },
          "from": {
            "type": "string",
            "description": "Issued on or after, YYYY-MM-DD"
          },
          "to": {
            "type": "string",
            "description": "Issued on or before, YYYY-MM-DD"
          },
          "days": {
            "type": "integer",
            "description": "Issued in the last N days (default 7; anonymous max 7)"
          },
          "min_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Trade confidence floor, 0-1"
          },
          "limit": {
            "type": "integer",
            "description": "Max rows (anonymous 5, keyed 50)"
          },
          "name": {
            "type": "string"
          },
          "trades": {
            "type": "array",
            "items": {
              "$ref": "#/properties/trade"
            }
          },
          "delivery": {
            "type": "string",
            "enum": [
              "email",
              "none"
            ]
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
