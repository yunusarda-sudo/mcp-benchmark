{
  "$schema": "../schema.json",
  "name": "ai.anysoft.share/anyshare",
  "title": "AnyShare by Anysoft",
  "category": "Productivity & Notes",
  "description": "Upload documents, create protected links, and read page engagement. OAuth required.",
  "tools": [
    {
      "name": "get_connection",
      "description": "Check the connected organization, permissions, upload limit and billing access. Explain the returned billing state, reason and dates when an action is blocked. can_use=false pauses uploads and sharing; existing document and engagement reads remain available with the required permissions. This does not switch organizations.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "list_documents",
      "description": "Search document names in the connected organization. Results are paginated; use next_cursor for subsequent pages.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "default": "",
            "type": "string",
            "maxLength": 160
          },
          "cursor": {
            "type": "string",
            "maxLength": 1000
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        }
      }
    },
    {
      "name": "get_document",
      "description": "Read metadata and processing status for an existing document. Does not open the shared viewer or count a view.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "document_id"
        ]
      }
    },
    {
      "name": "list_data_rooms",
      "description": "Search existing data rooms and their folder names in the connected organization.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "default": "",
            "type": "string",
            "maxLength": 160
          },
          "cursor": {
            "type": "string",
            "maxLength": 1000
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        }
      }
    },
    {
      "name": "get_data_room",
      "description": "List the documents and folders in one existing data room.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "room_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "room_id"
        ]
      }
    },
    {
      "name": "request_document_upload",
      "description": "Reserve a document up to 100 MB. Returns a signed URL for PUT of original file bytes, plus a user upload page if your client cannot transfer the file. Complete the upload afterward; completion may expose it to existing room recipients. Adding to a room also requires rooms:write.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "idempotency_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,100}$",
            "description": "Unique key for this requested action; reuse unchanged on retry."
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Original filename, including its supported extension; no directory path."
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 104857600
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "room_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Existing data room in the connected organization."
          },
          "folder": {
            "default": "General",
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "idempotency_key",
          "filename",
          "size"
        ]
      }
    },
    {
      "name": "upload_document",
      "description": "Import the original bytes of a user-provided file using its temporary download_url. Use a stable file_id and idempotency_key for retries. If the source cannot be fetched, request_document_upload provides an upload page. May place content in an existing room and expose it to its recipients (requires rooms:write). Does not create a link; wait for conversion before sharing.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "idempotency_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,100}$",
            "description": "Unique key for this requested action; reuse unchanged on retry."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "room_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Existing data room in the connected organization."
          },
          "folder": {
            "default": "General",
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "file": {
            "type": "object",
            "properties": {
              "download_url": {
                "type": "string",
                "maxLength": 8000,
                "format": "uri",
                "description": "Host-provided temporary HTTPS URL for the exact original bytes."
              },
              "file_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "description": "Stable host file identifier; retain it across retries."
              },
              "mime_type": {
                "type": "string",
                "maxLength": 150,
                "description": "MIME type supplied by the host, when available."
              },
              "file_name": {
                "type": "string",
                "maxLength": 255,
                "description": "Original filename supplied by the host, when available."
              }
            },
            "required": [
              "download_url",
              "file_id"
            ]
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "idempotency_key",
          "file"
        ]
      }
    },
    {
      "name": "complete_document_upload",
      "description": "Confirm the bytes have been uploaded, queue conversion and apply reserved room placement, exposing content to existing room recipients. Safe to retry. Returns processing status; queued does not mean ready.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "upload_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "upload_id"
        ]
      }
    },
    {
      "name": "get_upload_status",
      "description": "Read the status of an upload initiated by this connection. Check again in a few seconds while queued or processing.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "upload_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "upload_id"
        ]
      }
    },
    {
      "name": "create_share_link",
      "description": "Create a persistent recipient link for exactly one document or data room. Verified email on and downloads off by default. Set weaker access only when the user explicitly requests it. Reuse idempotency_key only for the same requested link. Recipients can access content once ready. Never supply a password; use authenticated AnyShare controls. Returns actual settings; does not send email.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "document_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "room_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "require_email": {
            "default": true,
            "type": "boolean"
          },
          "verify_email": {
            "default": true,
            "type": "boolean"
          },
          "allowed_emails": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "format": "email",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            }
          },
          "expires_at": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "allow_download": {
            "default": false,
            "type": "boolean"
          },
          "watermark": {
            "default": false,
            "type": "boolean"
          },
          "require_agreement": {
            "default": false,
            "type": "boolean"
          },
          "idempotency_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,100}$"
          }
        },
        "required": [
          "name",
          "idempotency_key"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "add_document_to_data_room",
      "description": "Add an existing document to an existing data room and folder. If already present, preserve its current folder. Existing room recipients may gain access to this document. Does not create a new link.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "room_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "folder": {
            "default": "General",
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "document_id",
          "room_id"
        ]
      }
    },
    {
      "name": "get_document_analytics",
      "description": "Read aggregate recorded engagement for exactly one document_id, share_link_id or room_id. Use share_link_id for a recipient link; the host may reserve link_id for connected-account selection. Default summary has no sessions or emails. Choose detail=sessions for visit/page detail; include_viewer_identities=true only when the user explicitly asks about recorded viewers. Captured emails are not necessarily verified; anonymous visits do not identify people. Does not record views.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "detail": {
            "default": "summary",
            "description": "Summary by default; choose sessions only for requested visit/page detail.",
            "type": "string",
            "enum": [
              "summary",
              "sessions"
            ]
          },
          "include_viewer_identities": {
            "default": false,
            "description": "Return recorded emails and verification status only for an explicit viewer identity request; requires detail=sessions.",
            "type": "boolean"
          },
          "document_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "share_link_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Recipient share-link ID returned by create_share_link; not the host's connected-account ID."
          },
          "link_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Legacy recipient-link selector. Prefer share_link_id; some hosts reserve link_id for account selection."
          },
          "room_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Existing data room in the connected organization."
          },
          "since": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "until": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "cursor": {
            "type": "string",
            "maxLength": 1000
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
