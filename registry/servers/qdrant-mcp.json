{
  "$schema": "../schema.json",
  "name": "Qdrant MCP",
  "category": "Vector DBs & AI Search",
  "description": "Qdrant MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "search_collection",
      "description": "Search dense and sparse vector points with payload filtering in Qdrant.",
      "inputSchema": {
        "type": "object",
        "required": [
          "collectionName",
          "vector"
        ],
        "properties": {
          "collectionName": {
            "type": "string",
            "description": "Name of the Qdrant collection."
          },
          "vector": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Dense query vector."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum points to return."
          }
        }
      }
    }
  ]
}
