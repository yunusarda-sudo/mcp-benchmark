{
  "$schema": "../schema.json",
  "name": "com.pebblelaunch/launches",
  "title": "PebbleLaunch",
  "category": "E-Commerce & Retail",
  "description": "Submit your product to PebbleLaunch daily launches, track its status, and read launches.",
  "tools": [
    {
      "name": "list_launches",
      "description": "Products launching on PebbleLaunch on a given UTC day (default today), ranked by human votes. Featured items are labelled.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "date": {
            "description": "UTC day, YYYY-MM-DD",
            "type": "string"
          }
        }
      }
    },
    {
      "name": "get_launch",
      "description": "One launched/scheduled product by slug: details, launch day, votes, rank, and the badge snippet once live.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "get_launch_calendar",
      "description": "Seats left per upcoming UTC day (free queue, premium, featured) and the next day with a free seat.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "from": {
            "type": "string"
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          }
        }
      }
    },
    {
      "name": "submit_product",
      "description": "Submit the user's own product for a free launch day on PebbleLaunch. Only submit products the user owns and has asked you to list. Returns an id, a one-time status_key (save it) and ownership-proof options. Next: add ONE proof on the product's domain (a .well-known file, a meta tag, or a DNS TXT record), then call check_status. The maker then confirms by email; nothing is listed before a human confirms. Rules: https://pebblelaunch.com/rules.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "name": {
            "type": "string",
            "description": "Product name, ≤40 chars"
          },
          "tagline": {
            "type": "string",
            "description": "≤60 chars, plain text, no links"
          },
          "description": {
            "type": "string",
            "description": "≤600 chars, plain text, no links; claims must match the site"
          },
          "url": {
            "type": "string",
            "description": "https:// product URL on the maker's own domain"
          },
          "categories": {
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "developer-tools",
                "ai",
                "productivity",
                "design",
                "marketing",
                "finance",
                "health",
                "education",
                "games",
                "mobile",
                "mac",
                "data-api",
                "faith",
                "sports",
                "other"
              ]
            }
          },
          "pricing": {
            "type": "string",
            "enum": [
              "free",
              "freemium",
              "paid",
              "open-source"
            ]
          },
          "logo_url": {
            "type": "string"
          },
          "screenshots": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maker_name": {
            "type": "string",
            "description": "Person or company shown as maker"
          },
          "maker_email": {
            "type": "string",
            "description": "The maker's email; we send ONE confirmation link to it. Never shown publicly."
          },
          "preferred_date": {
            "description": "Optional UTC day YYYY-MM-DD, tomorrow or later",
            "type": "string"
          }
        },
        "required": [
          "name",
          "tagline",
          "description",
          "url",
          "categories",
          "pricing",
          "maker_name",
          "maker_email"
        ]
      }
    },
    {
      "name": "check_status",
      "description": "Status of a submission you made (needs its id + status_key). While ownership is pending this re-checks the proof (at most once a minute). Set resend_email to re-send the maker's confirmation link.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "status_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "resend_email": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "status_key"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.pebblelaunch/launches",
    "version": "0.1.0",
    "remoteUrl": "https://pebblelaunch.com/mcp",
    "publishedAt": "2026-11-19T17:02:30.157199Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "e5ba757f26d97c85346a93d88e2c34d309bcbc968fd08d29ea1aeec9182658e4"
  }
}
