  "description": "Live Surplus market prices and what unused Claude, OpenAI or OpenRouter API credit could return.",
  "tools": [
    {
      "name": "market_snapshot",
      "description": "What AI models actually sold for on the Surplus Intelligence market in the last 24 hours: buyer spend, the share of list price buyers paid, list and cheapest quoted prices per 1M tokens, and healthy seller counts. Use it to check whether anyone is buying a given model (filter by model name) or what sells through a provider's keys. Whole-market figures, not any seller's earnings.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "venice",
              "capminal",
              "openrouter",
              "openai",
              "anthropic",
