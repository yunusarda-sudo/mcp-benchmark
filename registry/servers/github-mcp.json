{
  "$schema": "../schema.json",
  "name": "GitHub MCP",
  "category": "Developer Tools & VCS",
  "description": "GitHub MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "create_issue",
      "description": "Open a new issue in a GitHub repository with title, markdown body, and labels.",
      "inputSchema": {
        "type": "object",
        "required": [
          "owner",
          "repo",
          "title"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner (user or org)."
          },
          "repo": {
            "type": "string",
            "description": "Repository name."
          },
          "title": {
            "type": "string",
            "description": "Title summary of the issue."
          },
          "body": {
            "type": "string",
            "description": "Detailed markdown description."
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Issue label tags."
          }
        }
      }
    },
    {
      "name": "get_pull_request",
      "description": "Retrieve pull request metadata, review status, and mergeable state.",
      "inputSchema": {
        "type": "object",
        "required": [
          "owner",
          "repo",
          "pullNumber"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "description": "Repository owner."
          },
          "repo": {
            "type": "string",
            "description": "Repository name."
          },
          "pullNumber": {
            "type": "integer",
            "description": "Pull request number."
          }
        }
      }
    }
  ]
}
