{
  "$schema": "../schema.json",
  "name": "com.thenetworktools/network-tools",
  "title": "The Network Tools",
  "category": "Security & Identity",
  "description": "Read-only DNS, MX routing, SPF, DMARC, HTTP security headers, and ICANN RDAP diagnostics.",
  "tools": [
    {
      "name": "dns_lookup",
      "description": "Query authoritative DNS records (A, AAAA, MX, TXT, CNAME, NS, SOA) for a domain via RFC-compliant DNS-over-HTTPS.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "Target domain name (e.g. \"github.com\")"
          },
          "recordType": {
            "default": "ALL",
            "description": "DNS record type to look up. Default is ALL.",
            "type": "string",
            "enum": [
              "A",
              "AAAA",
              "MX",
              "TXT",
              "CNAME",
              "NS",
              "SOA",
              "ALL"
            ]
          }
        },
        "required": [
          "domain"
        ]
      }
    },
    {
      "name": "mx_lookup",
      "description": "Query designated mail exchange (MX) servers, priority ranking, and target IP addresses for an email domain.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "Target email domain name (e.g. \"stripe.com\")"
          }
        },
        "required": [
          "domain"
        ]
      }
    },
    {
      "name": "spf_check",
      "description": "Inspect domain Sender Policy Framework (SPF) TXT records, parsed mechanisms, include counts, and RFC 7208 lookup limits.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "Target domain name (e.g. \"cloudflare.com\")"
          }
        },
        "required": [
          "domain"
        ]
      }
    },
    {
      "name": "dmarc_check",
      "description": "Inspect domain DMARC email spoofing policy (none, quarantine, reject), percentage enforcement, and aggregate reporting tags.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "Target domain name (e.g. \"google.com\")"
          }
        },
        "required": [
          "domain"
        ]
      }
    },
    {
      "name": "security_headers_check",
      "description": "Audit HTTP security response headers including HSTS, Content-Security-Policy (CSP), X-Frame-Options, and Permissions-Policy with posture scoring.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Target HTTP/HTTPS URL (e.g. \"https://example.com\")"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "whois_lookup",
      "description": "Query authoritative ICANN RDAP domain registration date, expiry date, registrar name, nameservers, and status codes.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "Target domain name (e.g. \"amazon.com\")"
          }
        },
        "required": [
          "domain"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.thenetworktools/network-tools",
    "version": "1.0.0",
    "remoteUrl": "https://thenetworktools.com/mcp",
    "publishedAt": "2026-11-26T11:35:22.22333Z",
