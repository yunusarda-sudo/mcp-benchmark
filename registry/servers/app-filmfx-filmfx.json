{
  "$schema": "../schema.json",
  "name": "app.filmfx/filmfx",
  "title": "FilmFX Photo Filters",
  "category": "Other",
  "description": "Find film looks and apply them on your device with a filter card, Studio, or local editing tools.",
  "tools": [
    {
      "name": "list_filters",
      "description": "Find supported looks by scene, effect or name. An empty search lists all presets and recommended strengths.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 100
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_filter_recipe",
      "description": "Prepare a filter with its recommended strength. Returns a Studio link and, in compatible hosts, a private interactive filter card. Takes no image.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "preset": {
            "type": "string",
            "enum": [
              "after-dark-tungsten",
              "gold-200",
              "portra-warm",
              "tri-x-400",
              "vhs",
              "pocket-ccd",
              "light-leak",
              "soft-glow"
            ],
            "description": "FilmFX preset ID from list_filters."
          },
          "strength": {
            "description": "Percent. Omit to use the preset default.",
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "preset"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "app.filmfx/filmfx",
    "version": "0.1.0",
    "remoteUrl": "https://filmfx.app/mcp",
    "publishedAt": "2026-11-23T08:16:53.777171Z",
    "fetchedAt": "2026-11-23T16:50:40.239Z",
    "toolsSha256": "69de7e6cd71cdb1f3b7b13bf7d745b6fa6148d5efbac1ae3402c1981c6f18485"
  }
}
