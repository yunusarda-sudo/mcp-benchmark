{
  "$schema": "../schema.json",
  "name": "xyz.tolsey/mcp",
  "title": "Tolsey",
  "category": "AI, LLMs & Agents",
  "description": "Web tools for AI agents: read, screenshot, tables, links, seal, extract, diff. Pay per call, x402.",
  "tools": [
    {
      "name": "read",
      "description": "Read a web page or a PDF as clean Markdown (title, byline, main text, word count; PDFs up to 100 pages).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Public http(s) page"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "shot",
      "description": "Screenshot a web page as PNG (desktop 1440×900 or mobile 390×844; full page up to 8000 px).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Public http(s) page"
          },
          "device": {
            "type": "string",
            "enum": [
              "desktop",
              "mobile"
            ]
          },
          "full": {
            "type": "boolean"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "table",
      "description": "Extract every <table> on a page as JSON arrays (or CSV).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Public http(s) page"
          },
          "format": {
            "type": "string",
            "enum": [
              "json",
              "csv"
            ]
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "links",
      "description": "Check every link on a page: HTTP status, final URL after redirects, ok/broken (max 200).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Public http(s) page"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "seal",
      "description": "Read a page as Markdown AND screenshot it from the same page load (JSON with markdown and a base64 PNG). Returns a responseHash you can pass to diff later.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Public http(s) page"
          },
          "device": {
            "type": "string",
            "enum": [
              "desktop",
              "mobile"
            ]
          },
          "full": {
            "type": "boolean"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "extract",
      "description": "Read a page or PDF and return the requested fields as JSON, each with the exact quote it came from (unknown fields come back null, never guessed).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Public http(s) page"
          },
          "fields": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        },
        "required": [
          "url",
          "fields"
        ]
      }
    },
    {
      "name": "diff",
      "description": "What changed on a page since an earlier seal of it: added and removed lines of the main text. Seal the page first, then pass that responseHash as since.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Public http(s) page"
          },
          "since": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          }
        },
        "required": [
          "url",
          "since"
        ]
      }
    },
    {
      "name": "token",
      "description": "Facts about a Robinhood Chain token at one block: supply, owner(), burns, Pons stage and creator tax, deployer and its other launches, holder count and top 10 holders. No score, no advice.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ca": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          }
        },
        "required": [
          "ca"
        ]
      }
    },
    {
      "name": "launches",
      "description": "The newest token launches on Pons (Robinhood Chain) with deployer history, stage, holders and biggest wallet. No score, no advice.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "xyz.tolsey/mcp",
    "version": "0.2.0",
    "remoteUrl": "https://tolsey.xyz/v1/mcp",
    "publishedAt": "2026-11-26T04:23:46.419389Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "802311ad3708638420590bc29b8b5e3b3d7c344687d0b967189eb71a59cd48e9"
  }
}
