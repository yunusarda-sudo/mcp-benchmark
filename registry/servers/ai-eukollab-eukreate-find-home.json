{
  "$schema": "../schema.json",
  "name": "ai.eukollab/eukreate-find-home",
  "title": "EuKreate Find Home",
  "category": "Other",
  "description": "EuKreate Find Home finds active for-sale single-family homes, condos and townhouses in the United…",
  "tools": [
    {
      "name": "find-an-area",
      "description": "Which area a place's name means, among those where EuKreate has homes for sale: a city (with its state), a 5-digit ZIP code, a county or a region such as \"the East Bay\". status matched: search areas[0]. choose: ask which of areas was meant.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "description": "The place as the person named it.",
            "maxLength": 80,
            "minLength": 2,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "find_areaArguments",
        "type": "object"
      }
    },
    {
      "name": "find-homes-from-a-request-in-words",
      "description": "Homes for a request in the person's own words: the area, budget, beds and baths become hard filters; wishes such as a big yard, a view, a good lot, an easy commute or a drive under 30 minutes to a named city rank the homes by fit.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "area": {
            "anyOf": [
              {
                "maxLength": 100,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The area when it is known: an area_ref from find_area or the place's name.",
            "title": "Area"
          },
          "limit": {
            "default": 10,
            "maximum": 25,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "request": {
            "description": "What the person wants, in their own words.",
            "maxLength": 600,
            "minLength": 3,
            "title": "Request",
            "type": "string"
          }
        },
        "required": [
          "request"
        ],
        "title": "find_homes_by_requestArguments",
        "type": "object"
      }
    },
    {
      "name": "get-one-home-s-details",
      "description": "Everything EuKreate can share about one active home for sale: price and facts, HOA and taxes when on record, assigned public schools, access to amenities and commutes, flood zone and hazard ratings for its Census tract (not the home itself), crime rates for its police agency with the state and…",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The home's street address, with city or ZIP when known.",
            "title": "Address"
          },
          "listing_ref": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "listing_ref from a EuKreate result.",
            "title": "Listing Ref"
          }
        },
        "title": "get_homeArguments",
        "type": "object"
      }
    },
    {
