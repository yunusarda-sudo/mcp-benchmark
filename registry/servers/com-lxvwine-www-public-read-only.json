{
  "$schema": "../schema.json",
  "name": "com.lxvwine.www/public-read-only",
  "title": "LXV Wine - public read-only",
  "category": "AI, LLMs & Agents",
  "description": "Read-only LXV Wine catalog, events and visit info for AI assistants. Cannot order or book.",
  "tools": [
    {
      "name": "search_wines",
      "description": "Search the wines currently for sale. Returns price, size, tasting notes, accolades and scores, spice pairings, vineyards and the product URL. Read-only; to buy, use the wine's url.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 80,
            "description": "Free-text search across the wine record."
          },
          "varietal": {
            "type": "string",
            "maxLength": 80,
            "description": "Varietal or blend component, e.g. Cabernet Franc."
          },
          "vintage": {
            "type": "string",
            "maxLength": 16,
            "description": "Vintage year, e.g. 2022."
          },
          "max_price": {
            "type": "number",
            "minimum": 0,
            "description": "Maximum price in USD."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10,
            "description": "Maximum results (1-20)."
          }
        }
      }
    },
    {
      "name": "get_wine",
      "description": "Get one wine by its slug (from search_wines). Read-only.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 80,
            "description": "The wine slug, e.g. 2022-cabernet-franc."
          }
        }
      }
    },
    {
      "name": "list_events",
      "description": "List upcoming public events and tastings with dates, venue, cost and a booking link. Read-only; it cannot reserve anything: book at the booking_url (Tock).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "format": "date",
            "description": "Earliest date YYYY-MM-DD (default today)."
          },
          "to": {
            "type": "string",
            "format": "date",
            "description": "Latest date YYYY-MM-DD."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10,
            "description": "Maximum results (1-20)."
          }
        }
      }
    },
    {
      "name": "get_visit_info",
      "description": "Address, hours, phone, how reservations work, and the wine club link. Read-only.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.lxvwine.www/public-read-only",
    "version": "1.0.0",
    "remoteUrl": "https://www.lxvwine.com/mcp",
    "publishedAt": "2026-11-25T22:37:08.014827Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "949db72232fe3829e147616fc8ea89c3588d111ee457cde6cc81990c6ee61850"
  }
}
