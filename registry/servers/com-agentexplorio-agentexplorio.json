{
  "$schema": "../schema.json",
  "name": "com.agentexplorio/agentexplorio",
  "title": "AgentExplorio",
  "category": "AI, LLMs & Agents",
  "description": "Search 1,700+ AI agents and MCP servers by task. Pricing, setup, reviews, verification. Read-only.",
  "tools": [
    {
      "name": "search_agents",
      "description": "Find AI agents, MCP servers and agent tools that do a job. Describe the task in plain words (e.g. 'reply to customer emails for a dental clinic'). Optional filters narrow by industry, type, price, setup and integration. Results come from the AgentExplorio index with verification labels; unverified listings are labeled.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200,
            "description": "What you need done"
          },
          "industry": {
            "type": "string",
            "description": "Industry slug, e.g. legal, healthcare, ecommerce-retail"
          },
          "type": {
            "type": "string",
            "enum": [
              "agent",
              "assistant",
              "mcp_tool",
              "builder_tool",
              "workflow_template"
            ]
          },
          "price": {
            "type": "string",
            "enum": [
              "free",
              "freemium",
              "paid",
              "open_source"
            ]
          },
          "setup": {
            "type": "string",
            "enum": [
              "no_code",
              "developer"
            ]
          },
          "works_with": {
            "type": "string",
            "description": "Integration or protocol, e.g. Slack, HubSpot, WhatsApp, MCP"
          },
          "verified_only": {
            "type": "boolean",
            "default": false
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 8
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_agent",
      "description": "Full public listing for one agent by slug: pricing, setup, integrations, industries, tasks, uptime, likes, reviews and verification.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "compare_agents",
      "description": "Side-by-side facts for 2 or 3 agents by slug.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slugs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 3
          }
        },
        "required": [
          "slugs"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.agentexplorio/agentexplorio",
    "version": "1.0.1",
    "remoteUrl": "https://agentexplorio.com/mcp",
    "publishedAt": "2026-11-19T18:50:19.198848Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "3dab500fe094fb34ed51ec0f0ab245eb61813ed6a9f569c5b92d384af734ec22"
  }
}
