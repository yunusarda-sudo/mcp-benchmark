{
  "$schema": "../schema.json",
  "name": "xyz.quantumatlas/white-label-exchange",
  "title": "Quantum Atlas White-Label Capability Exchange",
  "category": "Design, UI & 3D Media",
  "description": "Tenant-skinned capability exchange MCP + ui://exchange/directory App + 1-line WebMCP site embed.",
  "tools": [
    {
      "name": "exchange_search_capabilities",
      "description": "Search across sovereign AI services, MCP hubs, physical businesses, Overture GERS places, UCP merchants, marine/harbor sensor oracles, ShoreKey stays, and federated x402 Bazaar endpoints.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 160
          },
          "network": {
            "type": "string",
            "maxLength": 48
          },
          "protocol": {
            "type": "string",
            "maxLength": 24
          },
          "destination": {
            "type": "string",
            "maxLength": 48
          },
          "gers_id": {
            "type": "string",
            "maxLength": 128
          },
          "max_price_usd": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "include_bazaar": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "exchange_get_profile",
      "description": "Retrieve the complete machine-readable Executable Capability Profile (input/output schemas, exact pricing, ERC-8004 identity, spatial license layer, and live operational reputation) for a profile_id.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 128
          }
        },
        "required": [
          "profile_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "exchange_evaluate_reputation",
      "description": "Evaluate measured operational reliability (successful_execution_rate, p50/p95 latency, verified_transactions, repeat_agent_cohorts, endpoint_availability, and dispute_and_failure_receipts) before spending.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "profile_id": {
            "description": "Optional profile_id; omit for full tracked ledger.",
            "type": "string",
            "maxLength": 128
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "exchange_quote_scenario",
      "description": "Quote a multi-step physical/digital commerce plan (e.g. harbor state + dining brief + compliance rules + Switchboard translation) against an authorized budget ceiling in cents.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "items": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "capability_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "order": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "capability_id"
              ],
              "additionalProperties": false
            }
          },
          "budget_ceiling_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "exchange_execute_capability",
      "description": "Execute a priced capability using a Stripe-funded spend key (sbk_*/sbd_*) and optional Google AP2 mandate budget guard, returning structured output and an execution receipt.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "capability_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "arguments": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "max_spend_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "spend_key": {
            "type": "string",
            "maxLength": 128
          },
          "ap2_mandate": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "capability_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "exchange_verify_receipt",
      "description": "Verify a detached Ed25519 JWS execution attestation (`atlas.x402.execution_attestation.v1`) against its canonical RFC 8785 JCS payload and public key.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "attestation": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "public_jwk": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "jwks": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "require_signed": {
            "type": "boolean"
          }
        },
        "required": [
          "attestation"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "exchange_list_business_templates",
      "description": "List standardized Agentification-as-a-Service schemas, protocols, payment rails, and safety gates across 10 physical-world business verticals (restaurant, marina, hotel, parking, studio, venue, rental, EV, retail, municipality).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "vertical": {
            "type": "string",
            "maxLength": 48
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "xyz.quantumatlas/white-label-exchange",
    "version": "1.0.0",
    "remoteUrl": "https://x402.quantumatlas.xyz/exchange/mcp",
    "publishedAt": "2026-11-25T16:36:49.90242Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "15c01eddb7ef7ebdc914bac9ea271e0277f47de507b12e5de7938952ded653ca"
  }
}
