{
  "$schema": "../schema.json",
  "name": "com.getagentdepot/agent-provider-depot",
  "title": "Agent Provider Depot",
  "category": "AI, LLMs & Agents",
  "description": "One no-key call picks your agent's LLM, sandbox, search, email or DB provider, with sourced prices.",
  "tools": [
    {
      "name": "session_brief",
      "description": "Stack changes since your last cursor (retired models, prices, packages, picks). Send provider, model and package ids (never a manifest) plus that cursor. Returns clear|changed|attention, ≤3 sourced actions, a new cursor.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "packages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "policies": {
            "type": "object",
            "properties": {
              "maxMonthlyUsd": {
                "type": "number",
                "minimum": 0
              },
              "requireVerifiedOutcome": {
                "type": "boolean"
              }
            }
          },
          "cursor": {
            "type": "string",
            "description": "From your last brief"
          },
          "stackFingerprint": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "rescue",
      "description": "Live API errors: paste the exact error (429, 402, 529, insufficient_quota, model_not_found) and provider id. Returns cause, fix, fallback or checks.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "Error text, status or SKU"
          },
          "sku": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "jtbd": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "decide",
      "description": "First pick, no key, before integration code (LLM, sandbox, search, email, DB). First call: {task:'run untrusted Python in a sandbox', roleId:'<your-role-id>'} (or X-Agent-Id; pick comes back either way, only labelled calls are counted; use a role, never a person's name). Returns Depot Pick, runner-up, price, skip rule, reportOutcome, recheck (since=recheck.since). After acting: report_outcome.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "description": "What you need, in words"
          },
          "jtbd": {
            "type": "string"
          },
          "roleId": {
            "type": "string",
            "description": "e.g. <your-role-id>"
          },
          "constraints": {
            "type": "string",
            "description": "e.g. eu-region"
          },
          "existing": {
            "type": "string"
          },
          "failing": {
            "type": "string"
          },
          "since": {
            "type": "string",
            "description": "Last recheck.since"
          },
          "maxMonthly": {
            "type": "number",
            "minimum": 0
          },
          "full": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "depot",
      "description": "Read-only catalog ops: quotes, compare, audit, freshness. Not for picks, API errors, stack changes or outcome reports. Ops: prices: quote estimate compare free. Audit: check audit_repo freshness changes stack_delta coverage failures. Map: stack bundle search kit answer. op=help lists args.",
      "inputSchema": {
        "type": "object",
        "required": [
          "op"
        ],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "answer",
              "estimate",
              "search",
              "stack",
              "quote",
              "bundle",
              "kit",
              "compare",
              "free",
              "failures",
              "coverage",
              "changes",
              "check",
              "freshness",
              "audit_repo",
              "stack_delta",
              "help"
            ]
          },
          "args": {
            "type": "object",
            "description": "Args for that op; see op=help"
          }
        }
      }
    },
    {
      "name": "report_outcome",
      "description": "The only write: after acting on a pick, store worked/failed (self-report; never changes picks or scores; deletes nothing). decision = decide's reportOutcome.decision.",
      "inputSchema": {
        "type": "object",
        "required": [
          "provider"
        ],
        "properties": {
          "decision": {
            "type": "string"
          },
          "jtbd": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "worked": {
            "type": "boolean"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "worked",
              "failed",
              "evaluated"
            ]
          },
          "note": {
            "type": "string"
          },
          "agent": {
            "type": "string",
            "description": "Role id"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.getagentdepot/agent-provider-depot",
    "version": "0.17.64",
    "remoteUrl": "https://getagentdepot.com/mcp",
    "publishedAt": "2026-11-25T00:26:09.66407Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "21f47f1d0e7e3447854526fc6f40949fff2aad518db17a9e5396928afb25a6bf"
  }
}
