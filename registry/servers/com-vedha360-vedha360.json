{
  "$schema": "../schema.json",
  "name": "com.vedha360/vedha360",
  "title": "Vedha360",
  "category": "Travel, Maps & Navigation",
  "description": "Hindu scripture verses, daily panchang, festivals, stories, temple towns and yatra routes.",
  "tools": [
    {
      "name": "get_panchang",
      "description": "The Hindu calendar day (pañcāṅga) for a date at a place: vāra (weekday), tithi (lunar day) and when it ends, pakṣa, nakṣatra and when it ends, sunrise, sunset, moonrise, moonset and the day's observances. Times are ISO-8601 in the place's time zone.",
      "inputSchema": {
        "properties": {
          "lat": {
            "description": "Latitude of the place",
            "maximum": 90,
            "minimum": -90,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "description": "Longitude of the place",
            "maximum": 180,
            "minimum": -180,
            "title": "Lon",
            "type": "number"
          },
          "tz": {
            "default": "Asia/Kolkata",
            "description": "IANA time zone, e.g. 'Asia/Kolkata'",
            "maxLength": 64,
            "title": "Tz",
            "type": "string"
          },
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "YYYY-MM-DD; default today at the place",
            "title": "Date"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "type": "object",
        "title": "get_panchangArguments"
      }
    },
    {
      "name": "get_daily_verse",
      "description": "Vedha360's verse of the day — one scripture verse, the same for everyone on a given day — in Sanskrit, transliteration and a translation.",
      "inputSchema": {
        "properties": {
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "YYYY-MM-DD within 7 days of today; default today",
            "title": "Date"
          },
          "tz": {
            "default": "Asia/Kolkata",
            "description": "IANA time zone deciding 'today'",
            "maxLength": 64,
            "title": "Tz",
            "type": "string"
          },
          "lang": {
            "default": "en",
            "description": "Language of the translation: en, hi, bn, mr, te, ta, gu, kn, ml, or, pa; 'sa' = Sanskrit (Devanāgarī), 'iast' = transliteration.",
            "pattern": "^(en|sa|iast|hi|bn|mr|te|ta|gu|kn|ml|or|pa)$",
            "title": "Lang",
            "type": "string"
          }
        },
        "type": "object",
        "title": "get_daily_verseArguments"
      }
    },
    {
      "name": "search_scripture",
      "description": "Search the Vedha360 library of Hindu scripture (Bhagavad Gītā, Upaniṣads, Purāṇas, Itihāsas and more). A verse reference such as 'BG 2.47' or 'Bhagavad Gita 2.47' is looked up exactly; any other text (a question or theme, e.g. 'duty without attachment to results') is semantic search. Results outside a work's free preview keep their reference but have no text (locked: true).",
      "inputSchema": {
        "properties": {
          "query": {
            "description": "Question, theme or verse reference",
            "maxLength": 200,
            "minLength": 2,
            "title": "Query",
            "type": "string"
          },
          "collection": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Limit to one collection: bhagavad-gita, upanishads, vedas, puranas, itihasas, smritis, yoga, stotras",
            "title": "Collection"
          },
          "limit": {
            "default": 10,
            "description": "Maximum results",
            "maximum": 25,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "lang": {
            "default": "en",
            "description": "Language of the translation: en, hi, bn, mr, te, ta, gu, kn, ml, or, pa; 'sa' = Sanskrit (Devanāgarī), 'iast' = transliteration.",
            "pattern": "^(en|sa|iast|hi|bn|mr|te|ta|gu|kn|ml|or|pa)$",
            "title": "Lang",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object",
        "title": "search_scriptureArguments"
      }
    },
    {
      "name": "get_verse",
      "description": "One scripture verse by its canonical reference (e.g. 'BG 2.47', 'BhP 10.14.1'): Sanskrit, IAST transliteration and a translation, with the work's source and licence.",
      "inputSchema": {
        "properties": {
          "ref": {
            "description": "Verse reference, e.g. 'BG 2.47'",
            "maxLength": 120,
            "minLength": 2,
            "title": "Ref",
            "type": "string"
          },
          "lang": {
            "default": "en",
            "description": "Language of the translation: en, hi, bn, mr, te, ta, gu, kn, ml, or, pa; 'sa' = Sanskrit (Devanāgarī), 'iast' = transliteration.",
            "pattern": "^(en|sa|iast|hi|bn|mr|te|ta|gu|kn|ml|or|pa)$",
            "title": "Lang",
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "type": "object",
        "title": "get_verseArguments"
      }
    },
    {
      "name": "list_works",
      "description": "The scripture works available (title, collection, verse count, completeness), each with its Sanskrit source and licence and whether it is readable in full ('full') or as a free preview ('preview').",
      "inputSchema": {
        "properties": {
          "collection": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional collection filter",
            "title": "Collection"
          }
        },
        "type": "object",
        "title": "list_worksArguments"
      }
    },
    {
      "name": "list_stories",
      "description": "Short stories from the scriptures (Vedha360 retellings): title, one-line lead, deity, cover image and credit. Use get_story for the full text.",
      "inputSchema": {
        "properties": {
          "offset": {
            "default": 0,
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "deity": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "e.g. Krishna, Shiva, Rama, Devi",
            "title": "Deity"
          }
        },
        "type": "object",
        "title": "list_storiesArguments"
      }
    },
    {
      "name": "get_story",
      "description": "One scripture story with its full retelling, cover-image credit and where the episode is in the Library.",
      "inputSchema": {
        "properties": {
          "story_id": {
            "description": "Story id from list_stories",
            "maxLength": 80,
            "title": "Story Id",
            "type": "string"
          }
        },
        "required": [
          "story_id"
        ],
        "type": "object",
        "title": "get_storyArguments"
      }
    },
    {
      "name": "find_temple_towns",
      "description": "Pilgrimage towns of India and Nepal (e.g. Tirupati, Varanasi, Kāñcīpuram): search by town or temple name, state or deity, or find towns near a point. Returns coordinates, main temple and a one-line highlight.",
      "inputSchema": {
        "properties": {
          "query": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Town or temple name",
            "title": "Query"
          },
          "state": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Indian state or country region",
            "title": "State"
          },
          "deity": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "e.g. Shiva, Vishnu, Devi",
            "title": "Deity"
          },
          "near_lat": {
            "anyOf": [
              {
                "maximum": 90,
                "minimum": -90,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Near Lat"
          },
          "near_lng": {
            "anyOf": [
              {
                "maximum": 180,
                "minimum": -180,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Near Lng"
          },
          "radius_km": {
            "default": 100,
            "maximum": 2000,
            "minimum": 1,
            "title": "Radius Km",
            "type": "number"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "type": "object",
        "title": "find_temple_townsArguments"
      }
    },
    {
      "name": "get_temple_town",
      "description": "One temple town: introduction, its temples (deity, significance), festivals, best time to visit, how to reach, related stories and yātrās, and sources.",
      "inputSchema": {
        "properties": {
          "slug": {
            "description": "Town slug from find_temple_towns, e.g. 'tirupati'",
            "maxLength": 80,
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "slug"
        ],
        "type": "object",
        "title": "get_temple_townArguments"
      }
    },
    {
      "name": "list_festivals",
      "description": "Major Hindu festivals and vratas between two dates, with the deity, a one-line meaning and what to do. The calendar is curated; see `coverage` for the dates it covers.",
      "inputSchema": {
        "properties": {
          "from_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "YYYY-MM-DD; default today",
            "title": "From Date"
          },
          "to_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "YYYY-MM-DD; default from_date + 90 days",
            "title": "To Date"
          },
          "type": {
            "anyOf": [
              {
                "enum": [
                  "festival",
                  "vrat"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only festivals or only vratas",
            "title": "Type"
          }
        },
        "type": "object",
        "title": "list_festivalsArguments"
      }
    },
    {
      "name": "get_yatra_routes",
      "description": "Yātrā (pilgrimage) routes through the sacred geography of the epics — Rāmāyaṇa, Kṛṣṇa, Śiva, Devī and more. Without route_id: every route; with route_id: that route's ordered stops (place, coordinates, scripture, note, linked stories).",
      "inputSchema": {
        "properties": {
          "route_id": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "e.g. 'ramayana'",
            "title": "Route Id"
          }
        },
        "type": "object",
        "title": "get_yatra_routesArguments"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.vedha360/vedha360",
    "version": "1.0.1",
    "remoteUrl": "https://mcp.vedha360.com/mcp",
    "publishedAt": "2026-11-20T11:00:58.293147Z",
