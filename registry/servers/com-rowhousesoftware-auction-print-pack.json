            "type": "string",
            "enum": [
              "csv",
              "text"
            ]
          },
          "project": {
            "type": "object",
            "description": "Auction version 1: auctionId (8 to 80 letters, numbers, - or _), name, date (YYYY-MM-DD), startLot and items. Items use string fields: id, title, description, donor, donorEmail, donorAddress, value (USD), category, restrictions, expiry (YYYY-MM-DD or none), certificateId, lotKey, minimumBid and raiseStep.",
