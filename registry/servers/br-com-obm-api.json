{
  "$schema": "../schema.json",
  "name": "br.com.obm/api",
  "title": "OBM - Open Brazil Market",
  "category": "Developer Tools & VCS",
  "description": "Fundos, ativos da B3 e renda fixa (CRI, CRA, debêntures, Tesouro) com fonte e data de referência.",
  "tools": [
    {
      "name": "obm_get_asset",
      "description": "Identidade e indicadores principais de um ativo; para fundos, view=metrics traz os indicadores. Bonds cobre CRI, CRA, debêntures e Tesouro; o cadastro não traz preços, consulte obm_get_price_history para PU e taxas. Para descobrir Tesouro use obm_list_assets com asset_type=bonds e kind=tesouro; demais ativos podem usar obm_search.",
      "inputSchema": {
        "properties": {
          "asset_type": {
            "enum": [
              "funds",
              "equities",
              "bdrs",
              "fiis",
              "etfs",
              "indices",
              "bonds"
            ],
            "type": "string"
          },
          "identifier": {
            "description": "Ticker, CNPJ ou código do título; Tesouro pode conter espaço, como NTN-B PRINCIPAL_2035-05-15.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._ -]+$",
            "type": "string"
          },
          "view": {
            "default": "detail",
            "description": "detail: ficha; metrics: indicadores de fundo (só fundos).",
            "enum": [
              "detail",
              "metrics"
            ],
            "type": "string"
          }
        },
        "required": [
          "asset_type",
          "identifier"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "obm_get_data_status",
      "description": "Datas de referência por dataset, catálogo de fontes ou, com chave, plano e cota restante. Status é isento de cota como na API REST.",
      "inputSchema": {
        "properties": {
          "view": {
            "default": "status",
            "description": "status: datas por dataset (sem cota); sources: fontes; account: plano e cota restante (exige chave).",
            "enum": [
              "status",
              "sources",
              "account"
            ],
            "type": "string"
          }
        },
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "obm_get_financials",
      "description": "Indicadores fundamentalistas por período e demonstrações financeiras de ações, com o link do documento na CVM. Estreite com statement_type ou period_end.",
      "inputSchema": {
        "properties": {
          "asset_type": {
            "const": "equities",
            "default": "equities",
            "type": "string"
          },
          "identifier": {
            "description": "Ticker, código de índice ou CNPJ de 14 dígitos (fundos), como na API.",
            "maxLength": 32,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "type": "string"
          },
          "view": {
            "default": "fundamentals",
            "description": "fundamentals: indicadores por período; statements: demonstrações, com o link do documento na CVM.",
            "enum": [
              "fundamentals",
              "statements"
            ],
            "type": "string"
          },
          "periods": {
            "anyOf": [
              {
                "maximum": 80,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Períodos de fundamentals (padrão 12)."
          },
          "statement_type": {
            "anyOf": [
              {
                "enum": [
                  "income_statement",
                  "balance_sheet",
                  "cash_flow"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Demonstração específica; só em statements."
          },
          "period_end": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Data-base da demonstração; só em statements."
          },
          "page": {
            "anyOf": [
              {
                "description": "Página; continue daqui se houver mais.",
                "maximum": 10000,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "page_size": {
            "anyOf": [
              {
                "description": "Linhas por página (máximo 100).",
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "identifier"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "obm_get_fund_filings",
      "description": "Classes, séries e documentos de fundos (cada documento traz source_url) e informes de FIIs. Para séries, descubra class_cnpj com view=classes.",
      "inputSchema": {
        "properties": {
          "asset_type": {
            "enum": [
              "funds",
              "fiis"
            ],
            "type": "string"
          },
          "identifier": {
            "description": "Ticker, código de índice ou CNPJ de 14 dígitos (fundos), como na API.",
            "maxLength": 32,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "type": "string"
          },
          "view": {
            "anyOf": [
              {
                "enum": [
                  "classes",
                  "series",
                  "documents",
                  "reports"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Fundos: classes, series (exige class_cnpj) ou documents, com source_url (padrão). FIIs: reports (padrão)."
          },
          "class_cnpj": {
            "anyOf": [
              {
                "pattern": "^[0-9]{14}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "CNPJ da classe, para series; veja view=classes."
          },
          "subclass": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Subclasse, em series."
          },
          "start": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Início; em series e reports. Padrão: 12 meses."
          },
          "end": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Fim; em series e reports."
          },
          "page": {
            "anyOf": [
              {
                "description": "Página; continue daqui se houver mais.",
                "maximum": 10000,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "page_size": {
            "anyOf": [
              {
                "description": "Linhas por página (máximo 100).",
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "asset_type",
          "identifier"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "obm_get_holdings",
      "description": "Carteira de ETF, composição de índice ou imóveis de FII. Use limit para estreitar.",
      "inputSchema": {
        "properties": {
          "asset_type": {
            "enum": [
              "etfs",
              "indices",
              "fiis"
            ],
            "type": "string"
          },
          "identifier": {
            "description": "Ticker, código de índice ou CNPJ de 14 dígitos (fundos), como na API.",
            "maxLength": 32,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "type": "string"
          },
          "limit": {
            "anyOf": [
              {
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Itens: top N da carteira (ETF) ou linhas por página (índice); padrão 50."
          },
          "as_of": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Data da composição; só índices."
          },
          "page": {
            "anyOf": [
              {
                "description": "Página; continue daqui se houver mais.",
                "maximum": 10000,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "asset_type",
          "identifier"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "obm_get_income_events",
      "description": "Dividendos, juros sobre capital e desdobramentos de ações, ou rendimentos de FIIs, nos últimos months meses (padrão 12). Bonds: agenda de juros e amortização, sem months.",
      "inputSchema": {
        "properties": {
          "asset_type": {
            "enum": [
              "equities",
              "fiis",
              "bonds"
            ],
            "type": "string"
          },
          "identifier": {
            "description": "Ticker ou código do título.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._ -]+$",
            "type": "string"
          },
          "months": {
            "anyOf": [
              {
                "maximum": 120,
                "minimum": 12,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Meses até hoje; padrão 12."
          },
          "page": {
            "default": 1,
            "description": "Página; continue daqui se houver mais.",
            "maximum": 10000,
            "minimum": 1,
            "type": "integer"
          },
          "page_size": {
            "default": 25,
            "description": "Linhas por página (máximo 100).",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "asset_type",
          "identifier"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "obm_get_price_history",
      "description": "Série diária de preço, cota ou pontos do índice. Bonds: PU sem arredondamento; bid é mercado comprador (Tesouro: Taxa Venda), ask é mercado vendedor (Tesouro: Taxa Compra); sem datas, última cotação; start/end até 366 dias inclusivos, sem paginação, ordem decrescente. Cite source e reference_date, nunca hoje se a referência for anterior. Demais classes: padrão 12 meses; até 100 linhas por página, em ordem cronológica. Use start e end para estreitar ou page para continuar.",
      "inputSchema": {
        "properties": {
          "asset_type": {
            "enum": [
              "funds",
              "equities",
              "bdrs",
              "fiis",
              "etfs",
              "indices",
              "bonds"
            ],
            "type": "string"
          },
          "identifier": {
            "description": "Ticker, CNPJ ou código do título; Tesouro pode conter espaço, como NTN-B PRINCIPAL_2035-05-15.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._ -]+$",
            "type": "string"
          },
          "start": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Início (AAAA-MM-DD). Padrão: 12 meses; bonds sem start/end devolve só a última cotação."
          },
          "end": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Fim (AAAA-MM-DD). Padrão: o dado mais recente."
          },
          "page": {
            "default": 1,
            "description": "Página; continue daqui se houver mais.",
            "maximum": 10000,
            "minimum": 1,
            "type": "integer"
          },
          "page_size": {
            "default": 100,
            "description": "Linhas por página (máximo 100).",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "asset_type",
          "identifier"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "obm_get_returns",
      "description": "Retorno total de ação por período, ou retornos mensais de fundo, em 1, 3, 5 anos ou máximo. Padrão: 1 ano.",
      "inputSchema": {
        "properties": {
          "asset_type": {
            "enum": [
              "equities",
              "funds"
            ],
            "type": "string"
          },
          "identifier": {
            "description": "Ticker, código de índice ou CNPJ de 14 dígitos (fundos), como na API.",
            "maxLength": 32,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "type": "string"
          },
          "period": {
            "default": "1y",
            "description": "Janela: ações usam o retorno total do período; fundos, os retornos mensais dos últimos N anos.",
            "enum": [
              "1y",
              "3y",
              "5y",
              "max"
            ],
            "type": "string"
          }
        },
        "required": [
          "asset_type",
          "identifier"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "obm_list_assets",
      "description": "Lista e filtra ativos de uma classe (bonds: CRI, CRA, debêntures e Tesouro; filtre kind), o ranking de fundos por ano ou as maiores altas e baixas de um índice. Até 100 linhas por página; estreite com filtros ou continue com page.",
      "inputSchema": {
        "properties": {
          "asset_type": {
            "enum": [
              "funds",
              "equities",
              "bdrs",
              "fiis",
              "etfs",
              "indices",
              "bonds"
            ],
            "type": "string"
          },
          "view": {
            "default": "list",
            "description": "list: ativos da classe; ranking: só fundos (exige year); movers: só índices (exige identifier).",
            "enum": [
              "list",
              "ranking",
              "movers"
            ],
            "type": "string"
          },
          "query": {
            "anyOf": [
              {
                "maxLength": 50,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Texto de busca no nome ou ticker."
          },
          "kind": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Tipo: FI, FIDC, FIP, FII ou FIIM (fundos); tipo do papel (ações, FIIs); cri,cra,debenture,tesouro separados por vírgula (bonds)."
          },
          "group": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Setor (ações), programa (BDRs), segmento (FIIs), classe (fundos, ETFs) ou família (índices)."
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "active",
                  "matured",
                  "redeemed",
                  "defaulted",
                  "suspended",
                  "cancelled"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Status do título; só bonds. Use active para títulos vigentes."
          },
          "manager": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Gestora; só fundos."
          },
          "year": {
            "anyOf": [
              {
                "maximum": 2100,
                "minimum": 2000,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Ano do ranking de fundos."
          },
          "identifier": {
            "anyOf": [
              {
                "maxLength": 32,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9._-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Código do índice, para movers."
          },
          "page": {
            "anyOf": [
              {
                "description": "Página; continue daqui se houver mais.",
                "maximum": 10000,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "page_size": {
            "anyOf": [
              {
                "description": "Linhas por página (máximo 100).",
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "asset_type"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "obm_search",
      "description": "Busque ticker, nome ou CNPJ nas classes públicas, respeitando seu plano; sem chave, somente os 9 ativos da demonstração. Use page para continuar e estreite query quando houver muitos resultados.",
      "inputSchema": {
        "properties": {
          "query": {
            "description": "Ticker, nome ou CNPJ.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "asset_type": {
            "anyOf": [
              {
                "enum": [
                  "funds",
                  "equities",
                  "bdrs",
                  "fiis",
                  "etfs",
                  "indices",
                  "bonds"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "page": {
            "default": 1,
            "description": "Página; continue daqui se houver mais.",
            "maximum": 10000,
            "minimum": 1,
            "type": "integer"
          },
          "page_size": {
            "default": 20,
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "type": "object",
        "additionalProperties": false
      }
    }
  ],
  "source": {
