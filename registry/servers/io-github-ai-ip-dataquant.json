{
  "$schema": "../schema.json",
  "name": "io.github.ai-ip/dataquant",
  "category": "Developer Tools & DevOps",
  "description": "Six-market financial data (A/US/HK stocks, crypto, indices, ETFs): symbols, klines, macro.",
  "tools": [
    {
      "name": "search_symbols",
      "description": "Search tradable symbols in one of DataQuant's six markets (ashare=A-shares, usstock=US stocks, hkstock=HK stocks, crypto, indices, etfs) by code or name keyword. Returns matching symbol codes. Market data only; no investment advice is provided.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market": {
            "type": "string",
            "enum": [
              "ashare",
              "usstock",
              "hkstock",
              "crypto",
              "indices",
              "etfs"
            ],
            "description": "Market to search"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Code or name keyword, e.g. 600519, AAPL, BTC"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10,
            "description": "Max results"
          }
        },
        "required": [
          "market",
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_klines",
      "description": "Get historical daily kline rows (open, high, low, close, volume, amount, adj_factor) for one symbol in a DataQuant market, between start and end dates (YYYY-MM-DD). Returns published market data rows; data may be delayed and is not investment advice.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market": {
            "type": "string",
            "enum": [
              "ashare",
              "usstock",
              "hkstock",
              "crypto",
              "indices",
              "etfs"
            ],
            "description": "Market the symbol belongs to"
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "description": "Symbol code, e.g. sh600519, usAAPL, hk00700, BTCUSDT"
          },
          "start": {
            "type": "string",
            "description": "Start date YYYY-MM-DD"
          },
          "end": {
            "type": "string",
            "description": "End date YYYY-MM-DD"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100,
            "description": "Max rows"
          }
        },
        "required": [
          "market",
          "symbol",
          "start",
          "end"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_macro_overview",
      "description": "List global macroeconomic indicator data published by DataQuant, covering regions such as US, China, euro area, Japan and others. Returns indicator rows as published; no analysis or advice is added.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50,
            "description": "Max rows"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.ai-ip/dataquant",
    "version": "1.0.0",
    "remoteUrl": "https://mcp.dataquant.trade/mcp",
    "publishedAt": "2026-11-24T14:02:25.225185Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
