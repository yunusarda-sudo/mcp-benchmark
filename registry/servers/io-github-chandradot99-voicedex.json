                  "Characters & gaming",
                  "Customer service",
                  "Ads & social",
                  "Education",
                  "Podcasts",
                  "News",
                  "Meditation"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Use Case"
          },
          "age": {
            "anyOf": [
              {
                "enum": [
                  "Young",
                  "Adult",
                  "Middle-aged",
                  "Older",
                  "Teen",
                  "Child"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Age"
          },
          "accent": {
