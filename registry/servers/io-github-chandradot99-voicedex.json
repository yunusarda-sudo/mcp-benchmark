            ],
            "default": null,
            "title": "Accent"
          },
          "emotion": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Emotion"
          },
          "multilingual": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Multilingual"
          },
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Query"
          },
          "limit": {
            "default": 20,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "title": "Offset",
            "type": "integer"
          }
        },
        "type": "object",
        "title": "search_voicesArguments"
      }
    },
    {
      "name": "list_providers",
      "description": "Providers in the catalog with model and voice counts, headquarters, access model and compliance. Retired\n    providers (shut down or no longer sold) are included only when include_retired=true, with their retirement\n    date. compliance: providers must list ALL of them (e.g. [\"hipaa\"]); a provider that doesn't publish its\n    certifications never matches. headquarters: ISO 3166-1 alpha-2 country code, e.g. \"US\", \"IN\".\n    framework: providers with a first-party integration in that voice-agent framework's docs; every result lists\n    its integrations (framework, the model types covered, the framework's docs url).",
      "inputSchema": {
        "properties": {
          "type": {
            "anyOf": [
              {
                "enum": [
                  "stt",
                  "tts",
                  "sts"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Type"
          },
          "include_retired": {
            "default": false,
            "title": "Include Retired",
            "type": "boolean"
          },
          "compliance": {
