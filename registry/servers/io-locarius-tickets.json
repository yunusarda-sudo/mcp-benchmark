{
  "$schema": "../schema.json",
  "name": "io.locarius/tickets",
  "title": "Locarius Tickets",
  "category": "Other",
  "description": "Find and buy tickets for concerts, shows, theatre, festivals and live events on Locarius.",
  "repository": "https://github.com/Three-Hippies/locarius-mcp",
  "tools": [
    {
      "name": "search_events",
      "description": "Find upcoming concerts, shows, theatre, festivals, sports and other live events on Locarius. Filter by city, province/state and start-date range; the optional query matches event, organizer, venue and city names only (there is no genre). Returns summaries with a display label, all-in prices (taxes and fees included) and an eventId for get_event.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "description": "Optional name text: event, organizer, venue or city. Not a genre - omit words like \"concert\".",
            "type": "string",
            "maxLength": 200
          },
          "city": {
            "type": "string",
            "maxLength": 100
          },
          "province": {
            "description": "Province or state, e.g. \"ON\" or \"Ontario\"",
            "type": "string",
            "maxLength": 100
          },
          "startDateFrom": {
            "description": "Earliest start date, YYYY-MM-DD",
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "startDateTo": {
            "description": "Latest start date, YYYY-MM-DD",
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "page": {
            "description": "1-based page number",
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    },
    {
      "name": "get_event",
      "description": "Get an event: dates, venue, description, and the ticket types (ticketTypeId, all-in price with taxes and fees included, availability) that can be bought through this server. purchasableByAgent=false means the user must finish on eventUrl; waitlistAvailable=true means it is sold out but the user can join the waitlist on eventUrl.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "eventId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "eventId"
        ]
      }
    },
    {
      "name": "start_checkout",
      "description": "Reserve tickets for a buyer and get a secure payment link. Only call after the user has confirmed the event, ticket types, quantities, and their name and email. No payment is taken until the user completes the checkoutUrl; tickets are held briefly and emailed to the buyer after payment.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "eventId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "tickets": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ticketTypeId": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                }
              },
              "required": [
                "ticketTypeId",
                "quantity"
              ]
            }
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "description": "Buyer's email; tickets are sent here"
          },
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "promoCode": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "eventId",
          "tickets",
          "email",
          "firstName",
          "lastName"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.locarius/tickets",
    "version": "1.0.1",
    "remoteUrl": "https://api.prod.locarius.io/v1/mcp",
    "publishedAt": "2026-11-27T15:48:20.359071Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "215cbc3eaabafa5b399d510496b4ecfa437c83eb49fc4def0d0dc3042a4778c3"
  }
}
