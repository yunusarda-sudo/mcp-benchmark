{
  "$schema": "../schema.json",
  "name": "com.stocksandvibes/public-data",
  "title": "Stocks and Vibes",
  "category": "Finance, Crypto & Web3",
  "description": "Read-only Stocks and Vibes data: glossary, blog, pricing, and stored SEC filings and insider trades.",
  "tools": [
    {
      "name": "get_product_overview",
      "description": "What Stocks and Vibes is, what it is not (a simulator, never a broker), and its public pages.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_pricing",
      "description": "What is free, the AI credit packs and the Live Data plans with their USD prices and renewal terms.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "search_glossary",
      "description": "Search the options, stock and risk glossary by word or category; returns terms with their definitions.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "description": "Word or phrase to match in a term or its definition",
            "type": "string",
            "maxLength": 80
          },
          "category": {
            "description": "Only terms in this category",
            "type": "string",
            "enum": [
              "options",
              "stocks",
              "strategy",
              "risk",
              "greek",
              "indicator",
              "crypto"
            ]
          },
          "limit": {
            "description": "Most terms to return (default 20)",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        }
      }
    },
    {
      "name": "get_glossary_term",
      "description": "One glossary term by slug or name, with its definition, example and page link.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Slug (implied-volatility) or name (Implied Volatility)"
          }
        },
        "required": [
          "term"
        ]
      }
    },
    {
      "name": "list_blog_posts",
      "description": "Blog posts newest first, optionally by tag: title, date, summary, tags and link.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "tag": {
            "description": "Only posts with this tag",
            "type": "string",
            "maxLength": 60
          },
          "limit": {
            "description": "Most posts to return (default 20)",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        }
      }
    },
    {
      "name": "get_blog_post",
      "description": "One blog post by slug, with its markdown body (long posts are cut at a fixed length and say so).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Post slug, from list_blog_posts"
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "list_sec_filings",
      "description": "SEC EDGAR filings this site has stored for a US-listed symbol, newest first, with links to sec.gov. Read from storage, never fetched per call.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "maxLength": 16,
            "description": "US ticker symbol, e.g. XOM or BRK.B"
          },
          "limit": {
            "description": "Most filings to return (default 20)",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "symbol"
        ]
      }
    },
    {
      "name": "list_insider_trades",
      "description": "Insider transactions from the Forms 3, 4 and 5 this site has stored for a US-listed symbol, newest filing first. Read from storage, never fetched per call.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "maxLength": 16,
            "description": "US ticker symbol, e.g. XOM or BRK.B"
          },
          "limit": {
            "description": "Most filings to read (default 10)",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "symbol"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.stocksandvibes/public-data",
    "version": "1.0.1",
    "remoteUrl": "https://stocksandvibes.com/api/mcp",
    "publishedAt": "2026-11-25T19:02:52.720518Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "d8d3517319558041dc77aabdad447edf71d9c08d18321add1040f8308625ad50"
  }
}
