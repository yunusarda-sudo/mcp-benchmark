{
  "$schema": "../schema.json",
  "name": "io.github.TJLDC/inkspira-mcp",
  "title": "Inkspira MCP",
  "category": "Developer Tools & DevOps",
  "description": "Plan a tattoo with printable sizing samples, a placement preview, and prefills.",
  "repository": "https://github.com/TJLDC/inkspira-mcp",
  "tools": [
    {
      "name": "list_tattoo_options",
      "description": "Return the style, placement and color identifiers accepted by the Inkspira generator.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    },
    {
      "name": "create_tattoo_preview_link",
      "description": "Build a prefilled Inkspira generator link from a non-identifying tattoo motif. The link opens a form for review. Image generation happens only after the user signs in and chooses to generate. Do not send names, exact personal dates, contact details, image URLs, or other identifying details.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Tattoo motif and composition without identifying details."
          },
          "style": {
            "type": "string",
            "enum": [
              "Fine Line",
              "Minimalistisch",
              "Blackwork",
              "Dotwork",
              "Old School",
              "Aquarell",
              "Geometrisch",
              "Maori / Tribal",
              "Japanisch",
              "Realistisch",
              "Chicano",
              "Lettering",
              "Mandala",
              "Sketch",
              "Trash Polka",
              "Neo-Traditional",
              "New School",
              "Anime",
              "Biomechanical",
              "Ignorant Style",
              "Surrealismus"
            ]
          },
          "placement": {
            "type": "string",
            "enum": [
              "Arm",
              "Unterarm",
              "Ärmel (Sleeve)",
              "Finger",
              "Hand",
              "Nacken",
              "Rücken",
              "Bein",
              "Schulter",
              "Brust"
            ]
          },
          "color": {
            "type": "string",
            "enum": [
              "sw",
              "farbig"
            ]
          }
        },
        "required": [
          "prompt"
        ]
      }
    },
    {
      "name": "list_tattoo_planning_resources",
      "description": "Return the public Inkspira links for actual-size printable examples and the photo placement preview.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    }
  ],
