{
  "$schema": "../schema.json",
  "name": "io.github.ChristopherLaughlin/mcp-uspto-trademark",
  "title": "USPTO Trademark Status",
  "category": "Developer Tools & DevOps",
  "description": "USPTO trademark status by serial or registration number. Pay per call in USDC (x402) or Pro key.",
  "repository": "https://github.com/ChristopherLaughlin/factory-mcp-docs",
  "tools": [
    {
      "name": "check_trademark_conflicts",
      "description": "Not billed. USPTO has no official public trademark search API, so this returns a structured explanation and the manual search link instead of guessing.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "mark_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "international_class": {
            "type": "integer",
            "minimum": 1,
            "maximum": 45
          }
        },
        "required": [
          "mark_name"
        ]
      }
    },
    {
      "name": "get_trademark_status",
      "description": "Live status, owner, dates and goods/services for a USPTO trademark by 8-digit serial number OR registration number (provide exactly one). Set include_history for the prosecution history (office actions, filings, notices).",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "serial_number": {
            "description": "8-digit application serial number",
            "type": "string",
            "minLength": 8,
            "maxLength": 12
          },
          "registration_number": {
            "description": "Registration number (up to 7 digits)",
            "type": "string",
            "minLength": 1,
            "maxLength": 10
          },
          "include_history": {
            "default": false,
            "description": "Include prosecution history events, newest first",
            "type": "boolean"
          },
          "history_limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.ChristopherLaughlin/mcp-uspto-trademark",
    "version": "0.1.1",
    "remoteUrl": "https://mcp-uspto-trademark.scorematic.workers.dev/mcp",
    "publishedAt": "2026-11-26T06:16:21.020198Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "52f603aa5b289418f38811180cc34eff8a8f960ac7ed0b5ca334b47ca408e9bf"
  }
}
