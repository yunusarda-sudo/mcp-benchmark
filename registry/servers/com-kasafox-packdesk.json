{
  "$schema": "../schema.json",
  "name": "com.kasafox/packdesk",
  "title": "PackDesk",
  "category": "Developer Tools & VCS",
  "description": "Cited fault codes and fluid cross-references for industrial coding and marking equipment.",
  "tools": [
    {
      "name": "diagnose_coding_fault",
      "description": "Diagnose a packaging/coding/marking printer fault code and return the normalised row (meaning, likely causes, checks, parts, consumables) with sources.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "brand": {
            "type": "string",
            "enum": [
              "Domino",
              "Videojet"
            ]
          },
          "code": {
            "type": "string",
            "description": "The fault code or message shown on the printer"
          },
          "model": {
            "type": "string",
            "description": "Optional model or series"
          },
          "symptom": {
            "type": "string",
            "description": "Optional free-text symptom"
          }
        },
        "required": [
          "brand",
          "code"
        ]
      }
    },
    {
      "name": "lookup_code",
      "description": "Return one PackDesk fault-code row without the related-code expansion.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "brand": {
            "type": "string",
            "enum": [
              "Domino",
              "Videojet"
            ]
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "brand",
          "code"
        ]
      }
    },
    {
      "name": "list_brands",
      "description": "List the printer brands in the PackDesk dataset.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
