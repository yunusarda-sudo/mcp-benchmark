{
  "$schema": "../schema.json",
  "name": "GitLab MCP",
  "category": "Developer Tools & VCS",
  "description": "GitLab MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "list_merge_requests",
      "description": "List merge requests in a GitLab project filtered by state and milestone.",
      "inputSchema": {
        "type": "object",
        "required": [
          "projectId"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "description": "GitLab project ID or path."
          },
          "state": {
            "type": "string",
            "enum": [
              "opened",
              "closed",
              "merged",
              "all"
            ],
            "description": "Merge request state filter."
          }
        }
      }
    }
  ]
}
