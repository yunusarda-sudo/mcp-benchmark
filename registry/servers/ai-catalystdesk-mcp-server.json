{
  "$schema": "../schema.json",
  "name": "ai.catalystdesk/mcp-server",
  "title": "CatalystDesk",
  "category": "Observability & Analytics",
  "description": "Descriptive market regime analytics. Free preview, synthetic without a data key; paid compute.",
  "tools": [
    {
      "name": "list_curated_symbols",
      "description": "List the supported ticker symbols.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "get_delayed_regime_lite",
      "description": "Get free 15-minute-delayed context. synthetic_showcase true marks generated sample values, not market data.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "maxLength": 12
          }
        },
        "required": [
          "ticker"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_session_status",
      "description": "Read prepaid balance, paid usage, and billing documents.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "get_polygon_data_status",
      "description": "Check the request's market-data mode and Polygon key tier.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "get_regime_snapshot",
      "description": "Get a regime summary using caller-defined periods. data_tier and delay_seconds give the data freshness.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "maxLength": 12
          },
          "fast_period": {
            "type": "integer",
            "minimum": 2,
            "maximum": 199
          },
          "slow_period": {
            "type": "integer",
            "minimum": 3,
            "maximum": 200
          }
        },
        "required": [
          "ticker",
          "fast_period",
          "slow_period"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "compute_dynamic_regime",
      "description": "Compute descriptive statistics over caller-defined non-time bars.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "maxLength": 12
          },
          "bar_type": {
            "type": "string",
            "enum": [
              "TIME_BAR",
              "VOLUME_BAR",
              "DOLLAR_BAR",
              "TICK_BAR"
            ]
          },
          "bar_threshold": {
            "type": "number",
            "minimum": 1
          },
          "fast_period": {
            "type": "integer",
            "minimum": 2,
            "maximum": 199
          },
          "slow_period": {
            "type": "integer",
            "minimum": 3,
            "maximum": 200
          },
          "include_overnight": {
            "type": "boolean"
          },
          "venue": {
            "type": "string",
            "enum": [
              "nyse",
              "nasdaq"
            ]
          },
          "max_bars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 512
          },
          "process_var_q": {
            "type": "number",
            "minimum": 1e-12,
            "maximum": 1000000000000
          },
          "measurement_var_r": {
            "type": "number",
            "minimum": 1e-12,
            "maximum": 1000000000000
          },
          "anchor": {
            "type": "string",
            "enum": [
              "RTH_OPEN",
              "OVERNIGHT_OPEN"
            ]
          },
          "anchor_epoch_s": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "ticker",
          "bar_type",
          "bar_threshold",
          "fast_period",
          "slow_period"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "compute_multiframe_resonance",
      "description": "Compare descriptive regime alignment across two to four frames.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "maxLength": 12
          },
          "include_overnight": {
            "type": "boolean"
          },
          "frames": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "bar_type": {
                  "type": "string",
                  "enum": [
                    "TIME_BAR",
                    "VOLUME_BAR",
                    "DOLLAR_BAR",
                    "TICK_BAR"
                  ]
                },
                "bar_threshold": {
                  "type": "number",
                  "minimum": 1
                },
                "fast_period": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 199
                },
                "slow_period": {
                  "type": "integer",
                  "minimum": 3,
                  "maximum": 200
                }
              },
              "required": [
                "bar_type",
                "bar_threshold",
                "fast_period",
                "slow_period"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "ticker",
          "frames"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "scan_parameter_surface",
      "description": "Describe in-sample risk and return across caller-defined period pairs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "maxLength": 12
          },
          "bar_type": {
            "type": "string",
            "enum": [
              "TIME_BAR",
              "VOLUME_BAR",
              "DOLLAR_BAR",
              "TICK_BAR"
            ]
          },
          "bar_threshold": {
            "type": "number",
            "minimum": 1
          },
          "include_overnight": {
            "type": "boolean"
          },
          "max_bars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 512
          },
          "period_pairs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 25,
            "items": {
              "type": "object",
              "properties": {
                "fast_period": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 199
                },
                "slow_period": {
                  "type": "integer",
                  "minimum": 3,
                  "maximum": 200
                }
              },
              "required": [
                "fast_period",
                "slow_period"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "ticker",
          "period_pairs"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "compute_execution_guardrail",
      "description": "Compute descriptive trade-liquidity and volatility guardrails.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "maxLength": 12
          },
          "include_overnight": {
            "type": "boolean"
          },
          "window_seconds": {
            "type": "integer",
            "minimum": 15,
            "maximum": 300
          },
          "max_volatility_bps": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 500
          },
          "min_dollar_vol": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000000000
          }
        },
        "required": [
          "ticker"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "scan_curated_universe_regimes",
      "description": "Rank curated symbols by caller-defined dimensionless regime dispersion.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "bar_type": {
            "type": "string",
            "enum": [
              "TIME_BAR",
              "VOLUME_BAR",
              "DOLLAR_BAR",
              "TICK_BAR"
            ]
          },
          "bar_threshold": {
            "type": "number",
            "minimum": 1
          },
          "fast_period": {
            "type": "integer",
            "minimum": 2,
            "maximum": 199
          },
          "slow_period": {
            "type": "integer",
            "minimum": 3,
            "maximum": 200
          },
          "include_overnight": {
            "type": "boolean"
          },
          "venue": {
            "type": "string",
            "enum": [
              "nyse",
              "nasdaq"
            ]
          },
          "max_bars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 512
          },
          "rank_by": {
            "type": "string",
            "enum": [
              "abs_tsma_spread_bps",
              "abs_kalman_z",
              "abs_vwap_z",
              "atr_bps"
            ]
          },
          "top_k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          }
        },
        "required": [
          "bar_type",
          "bar_threshold",
          "fast_period",
          "slow_period"
        ],
        "additionalProperties": false
      }
    }
  ],
