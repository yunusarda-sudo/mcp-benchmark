            "type": "string",
            "enum": [
              "BUY",
              "SELL"
            ]
          },
          "notional_usd": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100000000
          },
          "entry_price": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100000000
          },
          "stop_price": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "expected_edge_bps": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "fee_bps": {
            "type": "number",
            "minimum": 0,
            "maximum": 500
          },
          "reduce_only": {
            "type": "boolean"
          },
          "strategy_id": {
            "type": "string",
            "pattern": "^[!-~]{1,64}$"
          },
          "lease_ttl_seconds": {
            "type": "integer",
            "minimum": 10,
            "maximum": 300
          },
          "approved_event_id": {
            "type": "string",
            "pattern": "^ev_[a-f0-9]{24}$"
          },
          "orderbook": {
            "type": "object",
            "properties": {
              "bids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              "asks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 50,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            },
            "required": [
              "bids",
              "asks"
            ],
            "additionalProperties": false
          },
          "bars": {
            "type": "array",
            "minItems": 2,
            "maxItems": 256,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "required": [
          "symbol",
          "venue_type",
          "side",
          "notional_usd",
          "entry_price"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "reconcile_trade",
      "description": "Record a fill, close or cancellation. Submit filled_notional_usd as the per-fill increment. Every PARTIAL requires fill_seq (1..10,000, up to 64 partial sequences per lease). Leased terminal FILLED, CLOSED, or CANCELLED may omit fill_seq or use a fresh sequence, even after 64 partials. An identical PARTIAL retry with the same fill_seq returns 409 lease_already_reconciled at zero charge. Changed parameters on a retained sequence return 400 invalid_arguments. Leased calls reject report_id and report_seq with 400 invalid_arguments. Retrying a terminal or exhausted lease returns 409 lease_already_reconciled while its receipt exists (24 hours, 512 tombstones), then 400 invalid_arguments after expiry or eviction. Unleased CLOSED (positive or flat-book amount-zero) and unleased CANCELLED require report_id and a strictly increasing workspace report_seq. Read metrics.report_seq in get_workspace_state for the last accepted sequence. Retry with the original ID and sequence. Retry matching treats bbb and BBB alike, and 100.0 and 100 alike. Identical retries return 409 lease_already_reconciled at zero charge within the separate 24-hour, 512-report receipt map. After eviction or expiry the report_seq high-water mark returns 400 invalid_arguments.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:/-]{1,32}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "FILLED",
              "PARTIAL",
              "CANCELLED",
              "CLOSED"
            ]
          },
          "lease_id": {
            "type": "string",
            "pattern": "^lease_[a-f0-9]{24}$"
          },
          "side": {
            "type": "string",
            "enum": [
              "BUY",
              "SELL"
            ]
          },
          "filled_notional_usd": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000000
          },
          "fill_seq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "report_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,64}$"
          },
          "report_seq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "expected_price": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "fill_price": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "fees_usd": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "realized_pnl_usd": {
            "type": "number",
            "minimum": -100000000,
            "maximum": 100000000
          },
          "strategy_id": {
            "type": "string",
            "pattern": "^[!-~]{1,64}$"
          },
          "exit_reason": {
            "type": "string",
            "pattern": "^[ -~]{0,64}$"
          }
        },
        "required": [
          "symbol",
          "status"
        ],
        "additionalProperties": false
      }
    },
