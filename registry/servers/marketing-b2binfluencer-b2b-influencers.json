{
  "$schema": "../schema.json",
  "name": "marketing.b2binfluencer/b2b-influencers",
  "title": "B2B Influencers",
  "category": "Other",
  "description": "Search 2,588 B2B creators by topic and followers, and see which creators mention a brand.",
  "tools": [
    {
      "name": "search_creators",
      "description": "Search B2B creators by words, topic and LinkedIn follower range. Returns a verdict and fit notes for each. Call list_topics for valid topic ids.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "Words that must all match"
          },
          "topic": {
            "type": "string"
          },
          "min_followers": {
            "type": "integer"
          },
          "max_followers": {
            "type": "integer"
          },
          "has_youtube": {
            "type": "boolean"
          },
          "has_partnership_info": {
            "type": "boolean"
          },
          "sort": {
            "type": "string",
            "enum": [
              "-followers",
              "followers",
              "name"
            ]
          },
          "limit": {
            "type": "integer",
            "maximum": 50
          },
          "offset": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "get_creator",
      "description": "Get one creator by id: ideas, takeaways, brands, fit, partnership options and similar creators.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "search_brands",
      "description": "Find brands discussed by B2B creators, with counts of disclosed deals and organic mentions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "min_creators": {
            "type": "integer"
          },
          "has_deals": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "maximum": 50
          },
          "offset": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "get_brand",
      "description": "Get the creators linked to a brand, grouped by disclosed deals, partners, customers, organic mentions and insiders, each with a quote and post link. Use to find who to approach.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "search_publications",
      "description": "Find active B2B newsletters and podcasts: what each covers, who it suits, and sponsors found in recent issues with quotes. Podcasts include a Podscan audience estimate where matched; prices are not available.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "newsletter",
              "podcast"
            ]
          },
          "topic": {
            "type": "string"
          },
          "sponsor": {
            "type": "string"
          },
          "has_sponsors": {
            "type": "boolean"
          },
          "min_audience": {
            "type": "integer",
            "description": "Podcasts only: minimum Podscan audience estimate"
          },
          "limit": {
            "type": "integer",
            "maximum": 50
          },
          "offset": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "list_topics",
      "description": "List topic ids with creator counts.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
