{
  "$schema": "../schema.json",
  "name": "com.digitalbusinessportal/eu-procurement",
  "title": "EU Tender Radar (TED)",
  "category": "Other",
  "description": "Free, read-only: open EU public tenders and single-bid EU contract awards from TED.",
  "tools": [
    {
      "name": "search_eu_open_tenders",
      "description": "Open EU public tenders (TED contract notices whose deadline has not passed), newest first. Filters: EU/EEA countries (ISO alpha-3), CPV prefix, keyword, days back. Source: TED (c) European Union, reused under Commission Decision 2011/833/EU. Not affiliated with the EU.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "countries": {
            "items": {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            "maxItems": 10,
            "type": "array"
          },
          "cpv": {
            "pattern": "^[0-9]{2,8}$",
            "type": "string"
          },
          "days": {
            "maximum": 90,
            "minimum": 1,
            "type": "integer"
          },
          "keyword": {
            "maxLength": 40,
            "type": "string"
          },
          "limit": {
            "maximum": 25,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "search_eu_single_bidder_awards",
      "description": "EU contracts awarded after only ONE tender was received (single-lot TED contract award notices), newest first, with the winning company and value. Looks at the newest 100 matching award notices only. Source: TED (c) European Union, reused under Commission Decision 2011/833/EU. Not affiliated with the EU.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "countries": {
            "items": {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            "maxItems": 10,
            "type": "array"
          },
          "cpv": {
            "pattern": "^[0-9]{2,8}$",
            "type": "string"
          },
          "days": {
            "maximum": 90,
            "minimum": 1,
            "type": "integer"
          },
          "keyword": {
            "maxLength": 40,
            "type": "string"
          },
          "limit": {
            "maximum": 25,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  ],
