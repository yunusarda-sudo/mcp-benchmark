    {
      "name": "buy_pass_credits",
      "description": "Start a card payment for prepaid pass credits, for users without an x402 crypto wallet.\n\n    Packs: \"100\" (100 passes for $1), \"500\" (500 for $5), \"2000\" (2000 for $20). Nothing is charged\n    by this call: it returns a checkout_url that the user opens and pays themselves. Only call it\n    when the user asked to pay by card or agreed to buy a pack.\n\n    Args:\n        pack: \"100\", \"500\" or \"2000\".\n        contact_email: the user's email; the checkout and receipt use it. Ask the user for it.\n        credit_key: to top up an existing credit_key; leave out to get a new one.\n\n    Returns {credit_key (new keys only: shown once, give it to the user to keep), checkout_url,\n    pack, credits_left, next_steps}. Credits are added within a minute of payment; then pass\n    credit_key to create_wallet_pass or update_wallet_pass.\n    ",
      "inputSchema": {
        "properties": {
          "pack": {
            "enum": [
              "100",
              "500",
              "2000"
            ],
            "title": "Pack",
            "type": "string"
          },
          "contact_email": {
            "title": "Contact Email",
            "type": "string"
          },
          "credit_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Credit Key"
          }
        },
        "required": [
          "pack",
          "contact_email"
        ],
        "type": "object",
        "title": "buy_pass_creditsArguments"
      }
    },
    {
      "name": "check_pass_credits",
      "description": "Credits left on a credit_key from buy_pass_credits, and its recent purchases\n    (status pending until the card payment succeeds, then paid).\n\n    Returns {credits_left, purchases: [{pack, passes, status, created, paid_at}]}.\n    ",
      "inputSchema": {
        "properties": {
          "credit_key": {
            "title": "Credit Key",
            "type": "string"
          }
        },
        "required": [
          "credit_key"
        ],
        "type": "object",
        "title": "check_pass_creditsArguments"
      }
    }
