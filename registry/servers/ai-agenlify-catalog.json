{
  "$schema": "../schema.json",
  "name": "ai.agenlify/catalog",
  "title": "Agenlify AI Agent Directory",
  "category": "Productivity & Notes",
  "description": "Find AI tools by task, with pricing context, setup steps, limitations and official sources.",
  "tools": [
    {
      "name": "search_agents",
      "description": "Search the public Agenlify catalog by English or Chinese task, product name or official domain. Filter by pricing, setup, category, task and evidence. Returns dated catalog summaries and source links; empty results mean no documented match.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "default": "",
            "description": "Task, product name or official website domain. Empty lists products.",
            "type": "string",
            "maxLength": 300
          },
          "task": {
            "type": "string",
            "enum": [
              "research-a-topic",
              "monitor-websites",
              "build-a-website",
              "fix-code",
              "repurpose-long-videos",
              "generate-a-video",
              "create-content",
              "analyze-a-spreadsheet",
              "automate-follow-ups",
              "automate-work",
              "answer-customer-questions"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "infrastructure",
              "general",
              "research",
              "build",
              "create",
              "data",
              "automate",
              "support"
            ]
          },
          "pricing": {
            "type": "string",
            "enum": [
              "free",
              "trial",
              "paid",
              "unknown"
            ]
          },
          "setup": {
            "type": "string",
            "enum": [
              "direct",
              "configure"
            ]
          },
          "evidence": {
            "description": "checked: official-source review; tested: only products with a recorded case, not a general endorsement.",
            "type": "string",
            "enum": [
              "checked",
              "tested"
            ]
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    },
    {
      "name": "get_agent",
      "description": "Get a catalog product by exact slug, including inputs, outputs, setup steps, limitations, human review requirements, pricing review dates, official sources and any separately recorded case studies.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "list_tasks",
      "description": "List Agenlify task IDs, preparation checklists, expected outputs and review requirements. Each listed task has at least three catalog candidates. Optionally filter tasks by category.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "infrastructure",
              "general",
              "research",
              "build",
              "create",
              "data",
              "automate",
              "support"
            ]
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "ai.agenlify/catalog",
    "version": "1.0.0",
    "remoteUrl": "https://agenlify.ai/mcp",
    "fetchedAt": "2026-11-22T10:21:23.861Z",
    "toolsSha256": "26421106ee711dd6aa1a49b3b6eec30c0c6f7b2f0f6eda8059a9418ca2070a7d"
  }
}
