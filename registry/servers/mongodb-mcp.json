{
  "$schema": "../schema.json",
  "name": "MongoDB MCP",
  "category": "Databases & Storage",
  "description": "MongoDB MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "find_documents",
      "description": "Search documents in MongoDB collection matching BSON filter query.",
      "inputSchema": {
        "type": "object",
        "required": [
          "collection",
          "filter"
        ],
        "properties": {
          "collection": {
            "type": "string",
            "description": "Target MongoDB collection."
          },
          "filter": {
            "type": "object",
            "description": "JSON query filter expression."
          },
          "limit": {
            "type": "integer",
            "description": "Max documents to return."
          }
        }
      }
    }
  ]
}
