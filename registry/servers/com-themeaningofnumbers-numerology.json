  "description": "Numerology for AI agents: life path, destiny, soul urge, angel number meanings. Free, no auth.",
  "repository": "https://github.com/ellelion/themeaningofnumbers",
  "tools": [
    {
      "name": "get_site_guide",
      "description": "Return when-to-use guidance for The Meaning of Numbers: free vs paid, Markdown twins, and honest auth limits.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_page_markdown",
      "description": "Fetch the Markdown twin for a public path (for example /angel-numbers/444 or /). Returns 404 text for unknown paths.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Site path beginning with /"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "calculate_core_numbers",
      "description": "Free Pythagorean core numbers from a name and birth date (Life Path, Destiny, Soul Urge, Personality, Birthday). Returns the number and the short static teaser only. Does not write a paid AI reading.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "month",
          "day",
          "year"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Full name for Destiny, Soul Urge, Personality"
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          },
          "year": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "ask_site",
      "description": "NLWeb-style list search over published pages on this origin. Returns matching URLs and markdown twins. No paid reading.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "description": "Natural-language or keyword query"
          }
        },
        "additionalProperties": false
      }
    }
  ],
