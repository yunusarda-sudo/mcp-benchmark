{
  "$schema": "../schema.json",
  "name": "com.gruptalepleri/grup-ucus",
  "title": "GrupTalepleri",
  "category": "Travel, Maps & Navigation",
  "description": "Group air tickets & group bookings (Türkiye): search flights, airports; open a free group request.",
  "tools": [
    {
      "name": "havalimani_bul",
      "description": "Look up IATA airport codes by city or airport name (Turkish or English). Use this before ucus_ara when the user gives a city name instead of a 3-letter code.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sorgu": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60,
            "description": "City or airport name, e.g. 'Roma', 'Istanbul', 'Düsseldorf'"
          }
        },
        "required": [
          "sorgu"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ucus_ara",
      "description": "Search scheduled flight options between two airports on a date for a group trip, optionally including nearby airports. Returns airlines, flight numbers, times, duration and stops. Does not return prices; group fares are quoted by GrupTalepleri.com after a group request.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kalkis": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "description": "Departure IATA code, e.g. IST"
          },
          "varis": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "description": "Arrival IATA code, e.g. FCO"
          },
          "tarih": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Departure date YYYY-MM-DD"
          },
          "donus_tarihi": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Return date YYYY-MM-DD for a round trip"
          },
          "kisi": {
            "type": "integer",
            "minimum": 1,
            "maximum": 400,
            "description": "Number of passengers in the group, up to 400"
          },
          "kabin": {
            "type": "string",
            "enum": [
              "economy",
              "premium-economy",
              "business",
              "first"
            ],
            "default": "economy"
          },
          "yakin_havalimanlari": {
            "type": "boolean",
            "default": false,
            "description": "Also search nearby airports (e.g. Milan MXP + LIN + BGY)"
          }
        },
        "required": [
          "kalkis",
          "varis",
          "tarih",
          "kisi"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "duyuru_rehber_ara",
      "description": "Search GrupTalepleri.com announcements (airline news, strikes, new routes, events) and destination travel guides by keyword. Returns titles and links.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sorgu": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80,
            "description": "Keyword, e.g. 'Bangkok', 'grev', 'Paskalya', 'Amsterdam'"
          }
        },
        "required": [
          "sorgu"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "grup_talebi_olustur",
      "description": "Creates a group flight request for GrupTalepleri.com from the route, date and passenger count, plus the contact person's name, phone number and email address. The GrupTalepleri.com team handles the request and contacts the user; this does not automatically create an account or send a message. Before calling this tool, show the user the full request details and get their explicit confirmation. Only use a name, phone number and email address that the user gave you themselves in this conversation; never invent, guess or reuse placeholder contact details. Personal data is processed under the KVKK information text at https://gruptalepleri.com/kvkk. Prices are not returned.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kalkis": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "description": "Departure IATA code, e.g. IST"
          },
          "varis": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "description": "Arrival IATA code, e.g. FCO"
          },
          "tarih": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Departure date YYYY-MM-DD"
          },
          "donus_tarihi": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Return date YYYY-MM-DD"
          },
          "kisi": {
            "type": "integer",
            "minimum": 6,
            "maximum": 400,
            "description": "Number of passengers, from 6 to 400"
          },
          "ad_soyad": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "description": "Contact person's full name"
          },
          "telefon": {
            "type": "string",
            "minLength": 7,
            "maxLength": 25,
            "pattern": "^\\+?[0-9 ()\\-]{7,25}$",
            "description": "Contact phone number"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Contact email address"
          },
          "not": {
            "type": "string",
            "maxLength": 500,
            "description": "Optional note, up to 500 characters"
          }
        },
        "required": [
          "kalkis",
          "varis",
          "tarih",
          "kisi",
          "ad_soyad",
          "telefon",
          "email"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "ozel_ucus_talebi",
      "description": "Creates a private jet, helicopter or charter aircraft request for GrupTalepleri.com (1 to 400 passengers) with route, date, passenger count and the contact person's name, phone and email. Use havalimani_bul first to get IATA codes. The GrupTalepleri.com team handles the request and contacts the user; prices are not returned. Before calling this tool, show the user the full request details and get their explicit confirmation. Only use a name, phone number and email address that the user gave you themselves in this conversation; never invent, guess or reuse placeholder contact details. Personal data is processed under the KVKK information text at https://gruptalepleri.com/kvkk.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ucak_turu": {
            "type": "string",
            "enum": [
              "jet",
              "helikopter",
              "charter_ucak"
            ],
            "description": "jet = private jet, helikopter = helicopter, charter_ucak = charter airliner"
          },
          "kalkis": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "description": "Departure IATA code, e.g. IST"
          },
          "varis": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "description": "Arrival IATA code, e.g. AYT"
          },
          "tarih": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Departure date YYYY-MM-DD"
          },
          "donus_tarihi": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Return date YYYY-MM-DD"
          },
          "kisi": {
            "type": "integer",
            "minimum": 1,
            "maximum": 400,
            "description": "Number of passengers, 1 to 400"
          },
          "ad_soyad": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "description": "Contact person's full name"
          },
          "telefon": {
            "type": "string",
            "minLength": 7,
            "maxLength": 25,
            "pattern": "^\\+?[0-9 ()\\-]{7,25}$",
            "description": "Contact phone number with country code"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Contact email address"
          },
          "not": {
            "type": "string",
            "maxLength": 500,
            "description": "Optional note, up to 500 characters"
          }
        },
        "required": [
          "ucak_turu",
          "kalkis",
          "varis",
          "tarih",
          "kisi",
          "ad_soyad",
          "telefon",
          "email"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "talep_durumu",
      "description": "Returns the current status of a GrupTalepleri.com group flight request. Requires both the request number (e.g. UG-XXXXXX) and the phone number used in that request. Returns route, dates, passenger count and a status sentence; prices are not returned.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "talep_no": {
            "type": "string",
            "minLength": 4,
            "maxLength": 30,
            "description": "Request number, e.g. UG-AB12CD"
          },
          "telefon": {
            "type": "string",
            "minLength": 10,
            "maxLength": 20,
            "description": "Phone number used when the request was created"
          }
        },
        "required": [
          "talep_no",
          "telefon"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
  "source": {
