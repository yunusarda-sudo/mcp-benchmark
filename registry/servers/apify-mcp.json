{
  "$schema": "../schema.json",
  "name": "Apify MCP",
  "category": "Web Scraping & Automation",
  "description": "Apify MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "run_actor",
      "description": "Start execution of an Apify web scraper Actor with input JSON parameters.",
      "inputSchema": {
        "type": "object",
        "required": [
          "actorId"
        ],
        "properties": {
          "actorId": {
            "type": "string",
            "description": "Apify Actor identifier slug."
          },
          "input": {
            "type": "object",
            "description": "Actor configuration parameters."
          }
        }
      }
    }
  ]
}
