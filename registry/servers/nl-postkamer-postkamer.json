{
  "$schema": "../schema.json",
  "name": "nl.postkamer/postkamer",
  "title": "postkamer.nl",
  "category": "Finance, Crypto & Web3",
  "description": "Print a letter and deliver it by post to every address in an area of the Netherlands.",
  "tools": [
    {
      "name": "estimate_mailing",
      "description": "Count the addresses in an area of the Netherlands and price a letter to all of them (printing, envelope and postage included). Creates nothing. Use it to check the area with the user before create_print_job.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "area": {
            "type": "object",
            "properties": {
              "circles": {
                "description": "Circular areas around a place or coordinate. The simplest way to reach \"the neighbours around X\".",
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "place": {
                      "description": "Address, street, postcode or place in the Netherlands, e.g. \"Keizersgracht 100, Amsterdam\" or \"1015CV\".",
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 200
                    },
                    "lat": {
                      "description": "Latitude (WGS84) of the centre, used when `place` is absent.",
                      "type": "number",
                      "minimum": 50.6,
                      "maximum": 53.7
                    },
                    "lng": {
                      "description": "Longitude (WGS84) of the centre, used when `place` is absent.",
                      "type": "number",
                      "minimum": 3.2,
                      "maximum": 7.3
                    },
                    "radiusMeters": {
                      "type": "number",
                      "minimum": 25,
                      "maximum": 3000,
                      "description": "Radius in metres (25-3000)."
                    }
                  },
                  "required": [
                    "radiusMeters"
                  ]
                }
              },
              "polygons": {
                "description": "GeoJSON Polygons with [longitude, latitude] coordinates (WGS84), outer ring closed.",
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "Polygon"
                    },
                    "coordinates": {
                      "minItems": 1,
                      "maxItems": 50,
                      "type": "array",
                      "items": {
                        "maxItems": 5000,
                        "type": "array",
                        "items": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "number"
                            }
                          ],
                          "items": false,
                          "minItems": 2,
                          "maxItems": 2
                        }
                      }
                    }
                  },
                  "required": [
                    "type",
                    "coordinates"
                  ]
                }
              },
              "bufferMeters": {
                "description": "Extra margin in metres around every circle and polygon. Default 0.",
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              },
              "addresses": {
                "description": "Single addresses by postcode and house number, on top of or instead of an area.",
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "postalCode": {
                      "type": "string",
                      "minLength": 6,
                      "maxLength": 7,
                      "description": "Dutch postcode, e.g. \"1015CV\"."
                    },
                    "houseNumber": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20,
                      "description": "House number, optionally with letter or addition, e.g. \"100\", \"12A\", \"12-1\"."
                    },
                    "houseNumberSuffix": {
                      "description": "Letter or addition when not part of houseNumber.",
                      "type": "string",
                      "maxLength": 20
                    }
                  },
                  "required": [
                    "postalCode",
                    "houseNumber"
                  ]
                }
              }
            }
          },
          "pageCount": {
            "description": "Pages in the letter (A4). Omit for a 1-page letter.",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "area"
        ]
      }
    },
    {
      "name": "create_print_job",
      "description": "Prepare a print job with the area (and optionally the letter) and return reviewUrl: the link the user opens to see the area on the map, change it, upload or check the letter, and pay. Nothing is sent or charged until the user confirms there. The link is valid for 24 hours.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "area": {
            "type": "object",
            "properties": {
              "circles": {
                "description": "Circular areas around a place or coordinate. The simplest way to reach \"the neighbours around X\".",
