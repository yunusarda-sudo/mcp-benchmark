                  "properties": {
                    "place": {
                      "description": "Address, street, postcode or place in the Netherlands, e.g. \"Keizersgracht 100, Amsterdam\" or \"1015CV\".",
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 200
                    },
                    "lat": {
                      "description": "Latitude (WGS84) of the centre, used when `place` is absent.",
                      "type": "number",
                      "minimum": 50.6,
                      "maximum": 53.7
                    },
                    "lng": {
                      "description": "Longitude (WGS84) of the centre, used when `place` is absent.",
                      "type": "number",
                      "minimum": 3.2,
                      "maximum": 7.3
                    },
                    "radiusMeters": {
                      "type": "number",
                      "minimum": 25,
                      "maximum": 3000,
                      "description": "Radius in metres (25-3000)."
                    }
                  },
                  "required": [
                    "radiusMeters"
                  ]
                }
              },
              "polygons": {
                "description": "GeoJSON Polygons with [longitude, latitude] coordinates (WGS84), outer ring closed.",
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "Polygon"
                    },
                    "coordinates": {
                      "minItems": 1,
                      "maxItems": 50,
                      "type": "array",
                      "items": {
                        "maxItems": 5000,
                        "type": "array",
                        "items": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "number"
                            }
                          ],
                          "items": false,
                          "minItems": 2,
                          "maxItems": 2
                        }
                      }
                    }
                  },
                  "required": [
                    "type",
                    "coordinates"
                  ]
                }
              },
              "bufferMeters": {
                "description": "Extra margin in metres around every circle and polygon. Default 0.",
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              },
              "addresses": {
                "description": "Single addresses by postcode and house number, on top of or instead of an area.",
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "postalCode": {
                      "type": "string",
                      "minLength": 6,
                      "maxLength": 7,
                      "description": "Dutch postcode, e.g. \"1015CV\"."
                    },
                    "houseNumber": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20,
                      "description": "House number, optionally with letter or addition, e.g. \"100\", \"12A\", \"12-1\"."
                    },
                    "houseNumberSuffix": {
                      "description": "Letter or addition when not part of houseNumber.",
                      "type": "string",
                      "maxLength": 20
                    }
                  },
                  "required": [
                    "postalCode",
                    "houseNumber"
                  ]
                }
              }
            }
          },
          "name": {
            "description": "A name for the mailing the user recognises, e.g. \"Bewonersbrief verbouwing Dorpsstraat\".",
            "type": "string",
            "maxLength": 255
          },
          "letter": {
            "description": "The letter: A4 portrait, top-left address window empty. Omit to let the user upload it on the review page.",
            "type": "object",
            "properties": {
              "filename": {
                "type": "string",
                "minLength": 5,
                "maxLength": 200,
                "pattern": "\\.(pdf|docx?)$",
                "description": "File name with extension: .pdf, .docx or .doc."
              },
              "contentBase64": {
                "type": "string",
                "minLength": 100,
                "maxLength": 4194304,
                "description": "The file, base64 encoded (at most 3 MB before encoding)."
              }
            },
            "required": [
              "filename",
              "contentBase64"
            ]
          }
        },
        "required": [
          "area"
        ]
      }
    },
