{
  "$schema": "../schema.json",
  "name": "io.github.nudisco-ai/nudisco-api",
  "title": "NUDISCO AI — public reading API",
  "category": "Developer Tools & DevOps",
  "description": "Read-only discovery, search and retrieval of NUDISCO AI public writing in two editions.",
  "tools": [
    {
      "name": "search_nudisco",
      "description": "Find public NUDISCO writing by literal, case-insensitive text. Omit edition to search both.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "edition": {
            "type": "string",
            "enum": [
              "regular",
              "original"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 10
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_nudisco_record",
      "description": "Read one public record by its exact ID and edition. The default edition is regular.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "edition": {
            "type": "string",
            "enum": [
              "regular",
              "original"
            ]
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_nudisco_resources",
      "description": "List NUDISCO's public edition and discovery entrances with canonical URLs.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    }
  ],
