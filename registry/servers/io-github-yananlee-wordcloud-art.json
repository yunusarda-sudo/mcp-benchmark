{
  "$schema": "../schema.json",
  "name": "io.github.YananLee/wordcloud-art",
  "title": "WordCloud.art",
  "category": "Developer Tools & DevOps",
  "description": "Browse WordCloud.art templates, palettes, fonts, and segment text. Read-only and public.",
  "repository": "https://github.com/YananLee/wordcloud_v2",
  "tools": [
    {
      "name": "describe_capabilities",
      "description": "Summarize what this public WordCloud.art MCP can do and link to the website docs.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "list_templates",
      "description": "List public WordCloud.art shape/template presets. Filter by type, category, or query.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "type": {
            "description": "Optional template type filter such as classic, 3d, ios, or map.",
            "type": "string"
          },
          "category": {
            "description": "Optional category filter inside the selected type.",
            "type": "string"
          },
          "query": {
            "description": "Optional fuzzy match against template name or display name.",
            "type": "string"
          },
          "limit": {
            "default": 40,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    {
      "name": "list_color_palettes",
      "description": "List public WordCloud.art color schemes including basic, gradient, contrast, and dopamine groups.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "group": {
            "default": "all",
            "type": "string",
            "enum": [
              "basic",
              "gradient",
              "contrast",
              "dopamine",
              "all"
            ]
          },
          "limit": {
            "default": 80,
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        }
      }
    },
    {
      "name": "list_fonts",
      "description": "List fonts available on WordCloud.art, optionally filtered by language or name.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "language": {
            "description": "Optional language filter such as english, chinese, japanese, or korean.",
            "type": "string"
          },
          "query": {
            "description": "Optional fuzzy match against font label or file name.",
            "type": "string"
          },
          "limit": {
            "default": 40,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    {
      "name": "list_languages",
      "description": "List languages supported for text segmentation on WordCloud.art.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "recommend_options",
      "description": "Recommend templates, color palettes, and fonts from the WordCloud.art library based on text or visual requirements.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 8000
          },
          "requirement": {
            "type": "string",
            "maxLength": 1000
          },
          "language": {
            "default": "english",
            "type": "string",
            "enum": [
              "chinese",
              "english",
              "japanese",
              "korean",
              "french",
              "spanish",
              "portuguese",
              "german"
            ]
          },
          "count": {
            "default": 3,
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    {
      "name": "segment_text",
      "description": "Segment raw text into weighted words for a word cloud. Read-only helper; generation still happens on wordcloud.art.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "language": {
            "default": "english",
            "type": "string",
            "enum": [
              "chinese",
              "english",
              "japanese",
              "korean",
              "french",
              "spanish",
              "portuguese",
              "german"
            ]
          },
          "maxWords": {
            "default": 40,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "filterStopWords": {
            "default": true,
            "type": "boolean"
          },
          "useSystemSegmentation": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "text"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.YananLee/wordcloud-art",
    "version": "1.0.0",
    "remoteUrl": "https://www.wordcloud.art/mcp",
    "publishedAt": "2026-11-26T14:42:07.422508Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "9aa0e80b1f9c8497437f7abfd7b7d78dc47e98103c5f2c75973345237d8cc2ac"
  }
}
