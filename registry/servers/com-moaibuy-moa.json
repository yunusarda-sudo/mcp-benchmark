{
  "$schema": "../schema.json",
  "name": "com.moaibuy/moa",
  "title": "모아 — AI 쇼핑 비교·주문 창구",
  "category": "Other",
  "description": "질문 하나→링크 1개로 답 · 도매·쇼핑몰·가게 상품 13,217,010개를 배송비 포함 총액으로 비교 · 주문 링크까지 · 갈래 14개 · 가게 등록 무료",
  "tools": [
    {
      "name": "answer_link",
      "description": "추천·찾기 질문에 가장 먼저 — 비교 화면 링크 1개(link)·한 줄 요약(summary)·화면 차례 상품 번호(item_ids)를 줍니다(저장값). 사람에게는 이 링크 하나만 전하고, 사람이 고르면 그 번호로 start_order. 고른 이유까지는 recommend_top3, 후보 목록은 search_products.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "질문 — 사람 말 그대로 넣어도 됨(값 「3만원 이하·2만원대」·「무료배송」은 조건으로 알아듣고 「추천해줘」 같은 말은 뺌) · 예: 텀블러 · 사무실 의자 5만원 이하"
          },
          "price_max": {
            "type": "integer",
            "minimum": 0
          },
          "free_shipping": {
            "type": "boolean"
          },
          "category_id": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_products",
      "description": "후보 목록을 AI 가 직접 훑을 때 — 찾는 말·값·무료배송·정렬로 상품 20개까지(cursor 로 다음 쪽)를 값·배송비·총액과 줍니다. 골라 주는 건 recommend_top3, 링크만은 answer_link. 사람에게는 결과의 answer_link 하나만.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "찾는 말 예: \"텀블러\", \"캠핑 의자\" — 사람 말 그대로 넣어도 됨(값·무료배송은 조건으로 알아듣고 부탁 말은 뺌)"
          },
          "category_id": {
            "type": "integer",
            "minimum": 1,
            "description": "모아 갈래 번호(/api/v1/categories)"
          },
          "price_min": {
            "type": "integer",
            "minimum": 0,
            "description": "최저 값(원)"
          },
          "price_max": {
            "type": "integer",
            "minimum": 0,
            "description": "최고 값(원)"
          },
          "free_shipping": {
            "type": "boolean",
            "description": "true = 무료배송만"
          },
          "sort": {
            "type": "string",
            "enum": [
              "relevance",
              "price_asc",
              "price_desc",
              "newest"
            ],
            "default": "relevance"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10
          },
          "cursor": {
            "type": "string",
            "description": "앞 결과의 next_cursor(같은 조건일 때만)"
          },
          "response_format": {
            "type": "string",
            "enum": [
              "concise",
              "detailed"
            ],
            "default": "concise"
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_product",
      "description": "상품 하나의 규격·옵션·배송비·필수 표기 정보를 자세히 줍니다(저장값). 여러 개 값 견주기는 get_products, 사기 직전은 check_offer.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^[0-9a-z]{8}$",
            "description": "search_products 의 item_id(8글자)"
          }
        },
        "required": [
          "item_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_products",
      "description": "아는 상품 여러 개의 값·배송비·총액·값 확인 시각을 저장값으로 한 번에(도매처에 안 물어 빠름 · 10개 · 엠시피 주소에 공개 열쇠 key 를 붙이면 50개). 사기 직전은 check_offer. 없거나 안 보이는 번호는 missing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "item_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-z]{8}$"
            },
            "minItems": 1,
            "maxItems": 50,
            "description": "search_products 의 item_id(8글자) 목록"
          },
          "response_format": {
            "type": "string",
            "enum": [
              "concise",
              "detailed"
            ],
            "default": "concise",
            "description": "detailed = get_product 와 같은 전체 꼴(규격·옵션·필수 표기)"
          }
        },
        "required": [
          "item_ids"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "recommend_top3",
      "description": "모아가 골라 줄 때 — 국내 3개와 해외 발송 최대 2개(overseas_picks · 따로)를 총액·배송·공급사 등급으로 골라 이유·장단점·비교표·도착 예상을 줍니다. 링크만이면 answer_link, 후보 목록은 search_products. 고른 국내 상품 값이 오래됐으면 도매처에 다시 물어 느릴 수 있음. 딸린 물건·부품·반려동물·아이·차량용은 본체가 있으면 안 고름. link(= page_url)는 고른 상품만 보이는 화면 — 사람에게는 이 링크 하나만.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "price_max": {
            "type": "integer",
            "minimum": 0
          },
          "free_shipping": {
            "type": "boolean"
          },
          "category_id": {
            "type": "integer",
            "minimum": 1
          },
          "must_have": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 30
            },
            "maxItems": 5,
            "description": "상품 이름·키워드에 꼭 들어갈 말"
          },
          "avoid": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 30
            },
            "maxItems": 5,
            "description": "상품 이름·키워드에 들어가면 뺄 말"
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "check_offer",
      "description": "사기 직전에 상품의 지금 값·재고·배송비를 도매처에 다시 묻습니다(몇 분 안에 본 값·못 물으면 저장값 — source 로 알림). 견주기만은 get_products. 없거나 안 보이는 번호는 missing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "item_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-z]{8}$"
            },
            "minItems": 1,
            "maxItems": 10
          }
        },
        "required": [
          "item_ids"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "start_order",
      "description": "사람이 고른 상품으로 모아 주문서 링크(order_url · 24시간)와 주인에게 그대로 전할 보고 글(report)을 줍니다. 결제·받는 분 칸은 사람이 그 링크에서 — 이 도구는 결제·발주를 하지 않습니다. 바로 못 사는 상품은 사는 곳(buy_url)과 까닭. 상태는 get_order_status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^[0-9a-z]{8}$",
            "description": "상품 번호(answer_link 의 item_ids 등)"
          },
          "qty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999,
            "default": 1,
            "description": "수량(묶음 상품이면 묶음 수)"
          },
          "options": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 80
            },
            "description": "옵션 {\"옵션 이름\":\"값\"} — 옵션 있는 상품은 다(이름·값은 get_product 의 options)"
          }
        },
        "required": [
          "item_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_order_status",
      "description": "start_order 의 token(또는 주문번호 order_id + 받는 분 휴대폰 뒤 4자리 tel4)으로 결제 전·결제됨·발송(택배사·송장)·취소를 줍니다. report 를 주인에게 그대로. 도착은 송장으로 택배사에서.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^ot_[A-Za-z0-9_-]{22}$",
            "description": "start_order 가 준 token"
          },
          "order_id": {
            "type": "string",
            "pattern": "^MOA\\d{6}-[A-Z0-9]{8}$",
            "description": "주문번호(token 이 없을 때 · tel4 와 같이)"
          },
          "tel4": {
            "type": "string",
            "pattern": "^\\d{4}$",
            "description": "받는 분 휴대폰 뒤 4자리"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "connect_shop",
      "description": "가게를 올리는 쉬운 길 — 자사몰 주소만 주면 사이트맵·상품 쪽을 끝까지 읽어 읽는 대로 공개하고(갈래 못 정하면 「기타」) 매일 다시 읽습니다(무료 · 열쇠 없음). 자료를 AI 가 직접 넣으려면 register_seller(한 가게는 한 길만 · 다른 길로 등록된 주소는 거절). https://·www. 없이 적어도 같은 가게 · 스마트스토어는 대기줄에서 차례로. 상품목록 파일(네이버 EP·구글 쇼핑 피드)은 feed_url 로(먼저 읽음 · shop_url 도메인만 · 못 읽으면 사이트맵 · 이유는 note). 등록된 주소면 상태를 돌려줌(수만은 check_only: true).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "shop_url": {
            "type": "string",
            "description": "가게 자사몰 주소(예: 우리가게.com · https://smartstore.naver.com/가게이름)",
            "maxLength": 300
          },
          "shop_name": {
            "type": "string",
            "description": "가게 이름(선택 · 없으면 도메인)",
            "maxLength": 60
          },
          "email": {
            "type": "string",
            "description": "연락용 전자우편(선택)",
            "maxLength": 100
          },
          "category_id": {
            "type": "integer",
            "description": "상품 갈래를 못 알아볼 때 쓸 모아 작은 갈래 번호(선택 · 101~1499)",
            "minimum": 100
          },
          "feed_url": {
            "type": "string",
            "description": "상품목록 파일 주소(선택 · https · 네이버 쇼핑 EP 3.0·옛 EP·구글 쇼핑 피드 · 있으면 사이트맵보다 먼저 읽음 · 파일 하나 10만 개까지 · 파일 안 상품 주소는 shop_url 과 같은 도메인만 · 이미 등록된 가게에 보내면 파일 주소를 바꾸고 다시 읽음)",
            "maxLength": 500
          },
          "check_only": {
            "type": "boolean",
            "description": "true = 등록하지 않고 상태만 봄(없는 주소면 오류)"
          }
        },
        "required": [
          "shop_url"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "register_seller",
      "description": "가게를 올리는 직접 넣는 길 — 가게 열쇠(seller_key)를 한 번 받아 upsert_seller_products·update_seller_offers 로 AI 가 상품을 직접 넣고 고칩니다. 주소만으로는 connect_shop 이 쉽습니다(한 가게는 한 길만). 열쇠는 이 응답에만 나오니 가게 사장님께 전달해 보관하게. 무료 · 가게당 1회 · 결제는 모아가 아닌 가게 자사몰에서.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "shop_name": {
            "type": "string",
            "description": "가게 이름(1~60자)",
            "minLength": 1,
            "maxLength": 60
          },
          "shop_url": {
            "type": "string",
            "description": "가게 자사몰 주소(「가게.com」 처럼 https:// 없이 적어도 됨 · www. 있든 없든 같은 가게)",
            "maxLength": 300
          },
          "email": {
            "type": "string",
            "description": "연락용 전자우편(선택)",
            "maxLength": 100
          }
        },
        "required": [
          "shop_name",
          "shop_url"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "upsert_seller_products",
      "description": "상품을 올리거나 고칩니다(50개씩 · 가게당 1000개). 값·사진·상품 주소 필수 · 검사를 넘으면 바로 공개(아니면 review_note). 무료배송이면 free_shipping: true · ship_fee 0만 보내면 모름으로 봄. 값·재고만은 update_seller_offers.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "seller_key": {
            "type": "string",
            "description": "register_seller 로 받은 가게 열쇠(moa_sk_…)",
            "pattern": "^moa_sk_[0-9a-f]{32}$"
          },
          "products": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string",
                  "description": "가게 상품번호(영문·숫자·_-. 1~40자)",
                  "pattern": "^[A-Za-z0-9_.-]{1,40}$"
                },
                "title": {
                  "type": "string",
                  "description": "상품 이름(150자)"
                },
                "price": {
                  "type": "integer",
                  "description": "손님이 내는 값(원 · 1 이상)",
                  "minimum": 1
                },
                "ship_fee": {
                  "type": "integer",
                  "description": "배송비(원 · 빼거나 0이면 모름 = 「배송비 확인 필요」로 보임 · 무료배송은 free_shipping: true)",
                  "minimum": 0
                },
                "free_shipping": {
                  "type": "boolean",
                  "description": "무료배송이면 free_shipping: true · ship_fee 0만 보내면 모름으로 봄(「배송비 확인 필요」)"
                },
                "image": {
                  "type": "string",
                  "description": "대표 사진 https 주소"
                },
                "product_url": {
                  "type": "string",
                  "description": "가게 자사몰의 이 상품 주소(https · 등록한 가게 도메인)"
                },
                "description": {
                  "type": "string",
                  "description": "설명(사실만 · 1000자)"
                },
                "category_id": {
                  "type": "integer",
                  "description": "모아 작은 갈래 번호(GET /api/v1/categories · 선택 — 없으면 이름으로 짐작하고 못 정하면 「기타」로 공개)",
                  "minimum": 100
                },
                "keywords": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "찾기 낱말 · 모아 작은 갈래 이름(예: 여성신발)을 넣으면 그 갈래로",
                    "maxLength": 30
                  },
                  "maxItems": 10
                },
                "inventory": {
                  "type": "integer",
                  "description": "재고 수",
                  "minimum": 0
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "on",
                    "off"
                  ],
                  "description": "off = 안 보임"
                },
                "ship_days": {
                  "type": "integer",
                  "description": "평균 발송일(1~30)",
                  "minimum": 1,
                  "maximum": 30
                }
              },
              "required": [
                "sku",
                "title",
                "price",
                "image",
                "product_url"
              ]
            }
          }
        },
        "required": [
          "seller_key",
          "products"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "update_seller_offers",
      "description": "올린 상품의 값·재고·판매 여부만 바꿉니다(50개씩). 내리기 = status: off(지우는 도구 없음). 이름·사진·주소는 upsert_seller_products.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "seller_key": {
            "type": "string",
            "description": "register_seller 로 받은 가게 열쇠(moa_sk_…)",
            "pattern": "^moa_sk_[0-9a-f]{32}$"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,40}$"
                },
                "price": {
                  "type": "integer",
                  "minimum": 1
                },
                "inventory": {
                  "type": "integer",
                  "minimum": 0
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "on",
                    "off"
                  ]
                }
              },
              "required": [
                "sku"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "seller_key",
          "items"
        ],
        "additionalProperties": false
      }
    }
  ],
