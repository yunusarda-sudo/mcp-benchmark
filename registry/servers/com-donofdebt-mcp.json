{
  "$schema": "../schema.json",
  "name": "com.donofdebt/mcp",
  "title": "The Don of Debt portfolio tools",
  "category": "Other",
  "description": "Free checklists, diligence and judgment-interest tools for charged-off debt. Aggregate inputs only.",
  "repository": "https://github.com/donofdebt/donofdebt-mcp",
  "tools": [
    {
      "name": "sale_readiness_check",
      "description": "[lenders] For lenders and creditors preparing to sell charged-off accounts. Answer yes/no/unknown for each preparation item; returns a stage-by-stage checklist, the top gaps to fix first, and links to the matching Don of Debt guides. Process readiness only, not a valuation. Aggregate answers only; no account data.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "authority_to_sell": {
            "description": "Authority to sell is documented",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "transfer_restrictions_reviewed": {
            "description": "Transfer and disclosure restrictions reviewed",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "chain_of_title_complete": {
            "description": "Chain of title assembled from originator to seller",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "data_tape_ready": {
            "description": "Data tape prepared with cut-off date and row counts",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "field_dictionary_ready": {
            "description": "Field dictionary and exception log prepared",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "media_inventory_done": {
            "description": "Document (media) availability measured by type",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "scrubs_completed": {
            "description": "Bankruptcy, deceased, and dispute scrubs completed",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "sol_review_done": {
            "description": "Statute-of-limitations questions reviewed with counsel",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "nda_ready": {
            "description": "NDA and secure-transfer plan ready",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "sale_structure_decided": {
            "description": "Sale structure decided (one-time sale or forward flow)",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "data_tape_header_check",
      "description": "[lenders] Send ONLY the column header names of a data tape (no rows, no values). Maps each header to a standard field category, lists recommended fields that are missing (from the Don of Debt data tape checklist and Reg F itemization context), and flags columns holding sensitive personal data that should not be shared before an NDA and secure transfer.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "columns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 300,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "description": "Header names only, e.g. [\"acct_ref\",\"chargeoff_date\",\"chargeoff_balance\",\"state\"]"
          }
        },
        "required": [
          "columns"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "document_gap_check",
      "description": "[lenders] List which supporting documents you have for a charged-off pool (by category, not by account). Returns the documents buyers commonly ask for that are missing, why each matters, asset-specific extras, and links to the Don of Debt guides.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "asset_type": {
            "type": "string",
            "enum": [
              "credit-card",
              "prime-cc",
              "subprime-cc",
              "retail-card",
              "personal-loan",
              "installment-loan",
              "auto-deficiency",
              "bhph",
              "rto",
              "medical",
              "payday",
              "fintech",
              "telecom-utility",
              "mca",
              "commercial",
              "disputed-incomplete",
              "other"
            ],
            "description": "Asset class. Shared enum across all tools; legacy aliases accepted: auto→auto-deficiency, installments→installment-loan, installment-loans→installment-loan, auto-loan→auto-deficiency, store-card→retail-card, credit_card→credit-card, personal_loan→personal-loan, telecom→telecom-utility, utility→telecom-utility"
          },
          "documents_available": {
            "type": "array",
            "maxItems": 13,
            "items": {
              "type": "string",
              "enum": [
                "bill_of_sale_chain",
                "account_schedule",
                "original_agreements",
                "last_statements",
                "chargeoff_statements",
                "payment_history",
                "data_tape_field_dictionary",
                "dispute_log",
                "bankruptcy_deceased_scrub",
                "sol_review",
                "state_mix_summary",
                "seller_authority_docs",
                "nda_ready"
              ]
            }
          }
        },
        "required": [
          "asset_type",
          "documents_available"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "portfolio_snapshot",
      "description": "[lenders] Describe a charged-off portfolio in aggregate terms (asset type, total face value, age band, placement history, media level, documents available). Returns a factor summary, document gaps, and a file-completeness score. It does NOT estimate a price, a percent of face value, or cents on the dollar.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "side": {
            "type": "string",
            "enum": [
              "seller",
              "buyer"
            ]
          },
          "asset_type": {
            "type": "string",
            "enum": [
              "credit-card",
              "prime-cc",
              "subprime-cc",
              "retail-card",
              "personal-loan",
              "installment-loan",
              "auto-deficiency",
              "bhph",
              "rto",
              "medical",
              "payday",
              "fintech",
              "telecom-utility",
              "mca",
              "commercial",
              "disputed-incomplete",
              "other"
            ],
            "description": "Asset class. Shared enum across all tools; legacy aliases accepted: auto→auto-deficiency, installments→installment-loan, installment-loans→installment-loan, auto-loan→auto-deficiency, store-card→retail-card, credit_card→credit-card, personal_loan→personal-loan, telecom→telecom-utility, utility→telecom-utility"
          },
          "face_value_usd": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100000000000,
            "description": "Total face value (aggregate)"
          },
          "account_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "age_since_chargeoff": {
            "type": "string",
            "enum": [
              "0-12m",
              "1-3y",
              "3-6y",
              "6y+",
              "unknown"
            ]
          },
          "placement_history": {
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "tertiary",
              "unknown"
            ]
          },
          "media": {
            "type": "string",
            "enum": [
              "full",
              "partial",
              "none",
              "unknown"
            ]
          },
          "documents_available": {
            "type": "array",
            "maxItems": 13,
            "items": {
              "type": "string",
              "enum": [
                "bill_of_sale_chain",
                "account_schedule",
                "original_agreements",
                "last_statements",
                "chargeoff_statements",
                "payment_history",
                "data_tape_field_dictionary",
                "dispute_log",
                "bankruptcy_deceased_scrub",
                "sol_review",
                "state_mix_summary",
                "seller_authority_docs",
                "nda_ready"
              ]
            }
          },
          "top_state_share_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "in_statute_share_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "asset_type",
          "face_value_usd",
          "age_since_chargeoff",
          "placement_history",
          "media"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "chain_of_title_checklist",
      "description": "[lenders] Checklist for tracing charged-off accounts from the originator through each transfer to the current seller. Answer yes/no/unknown per item and give the number of known transfers; returns status, open questions, and the Don of Debt chain-of-title guide. A document-consistency review, not a legal conclusion.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "known_transfers": {
            "type": "integer",
            "minimum": 0,
            "maximum": 25,
            "description": "Number of known transfers after origination"
          },
          "originator_identified": {
            "description": "Originator (original creditor) identified for the pool",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "bill_of_sale_each_transfer": {
            "description": "Bill of sale for each known transfer",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "assignment_each_transfer": {
            "description": "Assignment documents for each known transfer",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "schedule_or_exhibit": {
            "description": "Schedule, exhibit, or account-level extract tied to each transfer document",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "account_references_reconcile": {
            "description": "Account references reconcile across schedules and the current tape",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "entity_changes_documented": {
            "description": "Name changes, mergers, or successor entities documented",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "transfer_dates_consistent": {
            "description": "Transfer and effective dates consistent across documents",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "gaps_explained": {
            "description": "Any apparent gaps explained in writing for counsel review",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "forward_flow_vs_spot",
      "description": "[lenders] Explains the two common sale structures for charged-off portfolios: a one-time (spot) sale and a forward-flow agreement, with seller and buyer considerations and the OCC Bulletin 2014-37 context. Educational only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "perspective": {
            "type": "string",
            "enum": [
              "seller",
              "buyer",
              "both"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "placement_readiness_check",
      "description": "[agencies] For collection agencies receiving placements, or creditors placing accounts with an agency. Answer yes/no/unknown per item (agreement, authority, validation-information fields, scrubs, SOL review, licensing, data security, complaints, remittance). Returns a checklist with primary-source links. Licensing items link to regulators only and never conclude whether a license is required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "agency_receiving",
              "creditor_placing"
            ]
          },
          "placement_agreement": {
            "description": "Written placement or servicing agreement (scope, fees, remittance, recall rights)",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "creditor_authority": {
            "description": "Documented authority from the account owner to place and collect",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "itemization_data": {
            "description": "Validation-information fields ready (itemization date, amounts, creditor names)",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "account_support": {
            "description": "Account support available on request (statements, agreements, payment history)",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "scrubs": {
            "description": "Bankruptcy, deceased, and dispute scrubs completed and documented",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "sol_review": {
            "description": "Statute-of-limitations review completed with counsel",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "licensing_confirmed": {
            "description": "State licensing and bonding confirmed with each regulator (links only; no conclusion here)",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "data_security": {
            "description": "Information-security program and secure file transfer in place",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "complaints_disputes": {
            "description": "Complaint and dispute handling process documented",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "reporting_remittance": {
            "description": "Reporting, remittance, and reconciliation schedule agreed",
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          }
        },
        "required": [
          "role"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "judgment_interest_estimate",
      "description": "[agencies] Illustrative simple-interest estimate of post-judgment interest. Computes automatically only for states whose fixed statutory rate was source-checked (CA, IL, MD, MO, NC, NY, OR, PA, RI, VA, and WA consumer debt). Every other state, variable-rate state, or federal judgment needs a user-supplied rate_override_pct and returns a warning. Cites the statute, source URL, and check date. Not an amount owed and not legal advice. Inputs: amount, dates, state, debt type only — no names or case numbers.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "AK",
              "AL",
              "AR",
              "AZ",
              "CA",
              "CO",
              "CT",
              "DC",
              "DE",
              "FL",
              "GA",
              "HI",
              "IA",
              "ID",
              "IL",
              "IN",
              "KS",
              "KY",
              "LA",
              "MA",
              "MD",
              "ME",
              "MI",
              "MN",
              "MO",
              "MS",
              "MT",
              "NC",
              "ND",
              "NE",
              "NH",
              "NJ",
              "NM",
              "NV",
              "NY",
              "OH",
              "OK",
              "OR",
              "PA",
              "RI",
              "SC",
              "SD",
              "TN",
              "TX",
              "UT",
              "VA",
              "VT",
              "WA",
              "WI",
              "WV",
              "WY",
              "US-FED"
            ]
          },
          "principal_usd": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000000
          },
          "judgment_date": {
            "type": "string",
            "format": "date",
            "description": "YYYY-MM-DD"
          },
          "as_of_date": {
            "type": "string",
            "format": "date",
            "description": "YYYY-MM-DD"
          },
          "debt_type": {
            "type": "string",
            "enum": [
              "consumer_personal",
              "consumer_medical",
              "residential_rent",
              "commercial_or_other",
              "unknown"
            ]
          },
          "defendant_type": {
            "type": "string",
            "enum": [
              "natural_person",
              "business_or_other",
              "unknown"
            ],
            "description": "Used for New York (CPLR 5004): consumer debt against a natural person accrues 2%, otherwise 9%."
          },
          "rate_override_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 30,
            "description": "Required for states without a source-checked fixed rate. Confirm the rate with the court record or counsel."
          },
          "payments": {
            "type": "array",
            "maxItems": 24,
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date",
                  "description": "YYYY-MM-DD"
                },
                "amount_usd": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000000
                }
              },
              "required": [
                "date",
                "amount_usd"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "state",
          "principal_usd",
          "judgment_date",
          "as_of_date"
        ],
        "additionalProperties": false
      }
    },
    {
