    {
      "name": "collection_net_recovery_calc",
      "description": "[agencies] Simple arithmetic on figures you supply: placed amount × your recovery rate, minus your contingency fee and other costs. It does not predict or suggest any recovery rate or fee.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "placed_amount_usd": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100000000000
          },
          "recovery_rate_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Your own assumption"
          },
          "contingency_fee_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Your agreed fee"
          },
          "other_costs_usd": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000000000
          }
        },
        "required": [
          "placed_amount_usd",
          "recovery_rate_pct",
          "contingency_fee_pct"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "buy_box_builder",
      "description": "[buyers] For debt buyers. Turns your stated criteria (asset types, age bands, placement levels, minimum media, size range, excluded states, structure) into a structured buy box, lists unanswered criteria and clarifying questions, and — if you also pass an aggregate portfolio profile — checks fit per criterion. Ends with an opt-in link to submit the buy box privately. No inventory is listed or implied.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "asset_types": {
            "type": "array",
            "minItems": 1,
            "maxItems": 17,
            "items": {
              "type": "string",
              "enum": [
                "credit-card",
                "prime-cc",
                "subprime-cc",
                "retail-card",
                "personal-loan",
                "installment-loan",
                "auto-deficiency",
                "bhph",
                "rto",
                "medical",
                "payday",
                "fintech",
                "telecom-utility",
                "mca",
                "commercial",
                "disputed-incomplete",
                "other"
              ],
              "description": "Asset class. Shared enum across all tools; legacy aliases accepted: auto→auto-deficiency, installments→installment-loan, installment-loans→installment-loan, auto-loan→auto-deficiency, store-card→retail-card, credit_card→credit-card, personal_loan→personal-loan, telecom→telecom-utility, utility→telecom-utility"
            }
          },
          "age_bands": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "enum": [
                "0-12m",
                "1-3y",
                "3-6y",
                "6y+"
              ]
            }
          },
          "placement_levels": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "enum": [
                "primary",
                "secondary",
                "tertiary"
              ]
            }
          },
          "min_media": {
            "type": "string",
            "enum": [
              "full",
              "partial",
              "none"
            ]
          },
          "face_value_min_usd": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000000000
          },
          "face_value_max_usd": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000000000
          },
          "account_count_min": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          },
          "account_count_max": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          },
          "excluded_states": {
            "type": "array",
            "maxItems": 51,
            "items": {
              "type": "string",
              "enum": [
                "AK",
                "AL",
                "AR",
                "AZ",
                "CA",
                "CO",
