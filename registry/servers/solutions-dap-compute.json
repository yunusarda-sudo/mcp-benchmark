{
  "$schema": "../schema.json",
  "name": "solutions.dap/compute",
  "title": "DAP Compute Market Index",
  "category": "E-Commerce & Retail",
  "description": "GPU rental prices, the cheapest GPU-hour, compute futures and regulator actions, sourced. $0.01.",
  "tools": [
    {
      "name": "search_compute_contracts",
      "description": "Use when you need to find compute derivative contracts. Searches futures and options on GPU rental indices by venue, status, index publisher, jurisdiction, settlement or name. 50 free calls a day, then $0.01 USDC on Base per call via x402.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Words matched against the contract name, code, venue and index, for example \"H100\" or \"NYMEX\"."
          },
          "venue": {
            "type": "string",
            "description": "Restrict to one venue by short name, for example NYMEX or ICE."
          },
          "status": {
            "type": "string",
            "enum": [
              "announced",
              "filed",
              "under-review",
              "approved",
              "listed",
              "not-approved",
              "withdrawn"
            ],
            "description": "Restrict to one status."
          },
          "index_publisher": {
            "type": "string",
            "description": "Restrict to contracts settling against one publisher's index, for example \"Silicon Data\"."
          },
          "jurisdiction": {
            "type": "string",
            "description": "Two letter country code of the listing venue, for example US."
          },
          "settlement": {
            "type": "string",
            "enum": [
              "cash",
              "physical"
            ],
            "description": "Restrict by settlement method."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25,
            "description": "Maximum contracts to return."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_compute_record",
      "description": "Use when you have a record id (ct-, ser-, ent- or ev-) and need it in full. Returns its classification, status history, held-back fields and every source. 50 free calls a day, then $0.01 USDC on Base per call via x402.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "A record id from a search, an event list or list_compute_coverage."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "compute_market_events",
      "description": "Use when you need dated events on compute derivatives. Lists announcements, filings, regulator actions and dates still to come, filtered by date, type or contract. 50 free calls a day, then $0.01 USDC on Base per call via x402.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "description": "ISO date, YYYY-MM-DD. Only events on or after this date."
          },
          "until": {
            "type": "string",
            "description": "ISO date, YYYY-MM-DD. Only events on or before this date."
          },
          "kind": {
            "type": "string",
            "enum": [
              "announced",
              "filed",
              "regulator",
              "regulator-due",
              "approved",
              "listed",
              "withdrawn"
            ],
            "description": "Restrict to one event type."
          },
          "contract": {
            "type": "string",
            "description": "Restrict to events about one contract id (ct-)."
          },
          "upcoming_only": {
            "type": "boolean",
            "description": "Only dates after the snapshot date."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25,
            "description": "Maximum events to return."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "compute_list_prices",
      "description": "Use when you need GPU rental list prices with their history. Every AWS and Azure line, one per region and instance, never averaged, per instance-hour and per GPU-hour, with every change since 2020. 50 free calls a day, then $0.01 USDC on Base per call via x402.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "gpu": {
            "type": "string",
            "description": "GPU family, for example H100, A100, H200, B200, B300 or GB200. Each line is the list price the provider publishes in its own feed (AWS Price List, one price list a month back to October 2020; Azure Retail Prices, with the date each price took effect), one line per region and instance, never averaged."
          },
          "provider": {
            "type": "string",
            "description": "Cloud provider, for example AWS or Azure."
          },
          "instance": {
            "type": "string",
            "description": "One instance type, for example p5.48xlarge or Standard_ND96isr_H100_v5. The price per GPU-hour is derived: the listed price per instance-hour divided by the GPUs on the provider's specification page."
          },
          "region": {
            "type": "string",
            "description": "One region, by code or name, for example us-east-1 or East US."
          },
          "price_type": {
            "type": "string",
            "enum": [
              "on-demand",
              "spot"
            ],
            "default": "on-demand",
            "description": "On-demand or Spot."
          },
          "since": {
            "type": "string",
            "description": "ISO date, YYYY-MM-DD. History from this date; the price holding on that date is included."
          },
          "until": {
            "type": "string",
            "description": "ISO date, YYYY-MM-DD. History up to this date."
          },
          "history": {
            "type": "boolean",
            "default": false,
            "description": "Include every price point in the window, not only the latest price and the changes."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "compute_query",
      "description": "Use when you need to filter, group, rank or chart compute market data in one call. Takes the console's query object and returns lines, headline numbers, a league table, contracts, events and sources. 50 free calls a day, then $0.01 USDC on Base per call via x402.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "object",
            "properties": {
              "v": {
                "default": 1,
                "type": "number",
                "const": 1
              },
              "filters": {
                "default": {
                  "op": "and",
                  "children": []
                },
                "$ref": "#/$defs/__schema0"
              },
              "groupBy": {
                "default": "line",
                "type": "string",
                "enum": [
                  "line",
                  "provider",
                  "chip",
                  "model",
                  "region",
                  "geo",
                  "price_type",
                  "venue",
                  "status",
                  "layer",
                  "control"
                ]
              },
              "metric": {
                "default": "usd_per_gpu_hour",
                "type": "string",
                "enum": [
                  "usd_per_gpu_hour",
                  "usd_per_instance_hour",
                  "usd_per_gib_hour",
                  "usd_per_m_tokens",
                  "price_per_mwh",
                  "usd_per_coin",
                  "rebased",
                  "drawdown",
                  "change_12m",
                  "lines",
                  "contracts",
                  "rented_share"
                ]
              },
              "range": {
                "default": {
                  "preset": "all"
                },
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "preset": {
                        "type": "string",
                        "enum": [
                          "30d",
                          "90d",
                          "1y",
                          "3y",
                          "5y",
                          "ytd",
                          "all"
                        ]
                      }
                    },
                    "required": [
                      "preset"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "from": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "to": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      }
                    },
                    "required": [
                      "from",
                      "to"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "sort": {
                "default": {
                  "by": "usd_per_gpu_hour",
                  "dir": "asc"
                },
                "type": "object",
                "properties": {
                  "by": {
                    "type": "string",
                    "enum": [
                      "name",
                      "usd_per_gpu_hour",
                      "usd_per_instance_hour",
                      "usd_per_gib_hour",
                      "price",
                      "change_30d",
                      "change_12m",
                      "since_launch",
                      "first_listed",
                      "gpus",
                      "gpu_memory_gib",
                      "lines",
                      "low",
                      "high",
                      "contracts"
                    ]
                  },
                  "dir": {
                    "type": "string",
                    "enum": [
                      "asc",
                      "desc"
                    ]
                  }
                },
                "required": [
                  "by",
                  "dir"
                ],
                "additionalProperties": false
              },
              "page": {
                "default": {
                  "index": 1,
                  "size": 25
                },
                "type": "object",
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 100
                  }
                },
                "required": [
                  "index",
                  "size"
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false,
            "description": "The console query object. {} is the default view: every line, all time. Filters are a tree of field, operator and value. Fields: provider, chip (GPU, e.g. h100-80), model (a model or its maker), region, geo, price_type, line, venue, status, layer (ids, with in or nin); usd_per_gpu_hour, usd_per_instance_hour, usd_per_gib_hour, gpus, gpu_memory_gib, change_30d, change_12m (gte, lte, between); first_listed (dates); text (contains). The result is what the console draws: matching list price lines (GPU rental per GPU-hour, model tokens per million, power per MWh; the metric chooses which), headline numbers with 30-day change, a league table, a chart series, contracts, events, index series, participants and every source. Any console URL can be turned into this object."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false,
