    {
      "name": "get-gpu-price",
      "description": "Use when you need what one cloud charges, or what hosts ask on a marketplace, to rent a GPU now. Returns the price per GPU-hour, its type, last change, source and read time; for an ask, the seller's rented share as reported. 50 free calls a day, then $0.01 USDC on Base per call via x402.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chip": {
            "type": "string",
            "description": "GPU family, for example H100, A100, H200, B200, B300 or GB200."
          },
          "provider": {
            "type": "string",
            "description": "Seller: a cloud such as AWS or Azure, or a marketplace such as Lium."
          },
          "region": {
            "type": "string",
            "description": "One region, by code or name, for example us-east-1, eastus or East US. A marketplace's lines are in region marketplace."
          },
          "price_type": {
            "type": "string",
            "enum": [
              "on-demand",
              "spot",
              "marketplace-ask-low",
              "marketplace-ask-high"
            ],
            "default": "on-demand",
            "description": "On-demand (default) or Spot list price, or a marketplace ask: the lowest (marketplace-ask-low) or highest (marketplace-ask-high) price one host lists that day on a marketplace. An ask is not a list price."
          }
        },
        "required": [
          "chip",
          "provider",
          "region"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "find-cheapest-gpu-hour",
      "description": "Use when you need the cheapest place to rent a given GPU. Compares USD list prices per GPU-hour, optionally in one region, and returns the cheapest with its source. Other currencies are named, not compared. Asks only when asked. 50 free calls a day, then $0.01 USDC on Base per call via x402.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "chip": {
            "type": "string",
            "description": "GPU family, for example H100, A100, H200, B200, B300 or GB200."
          },
          "region": {
            "type": "string",
            "description": "Only lines in this region, by code or name. Leave out to compare every region."
          },
          "price_type": {
            "type": "string",
            "enum": [
              "on-demand",
              "spot",
              "marketplace-ask-low",
              "marketplace-ask-high"
            ],
            "default": "on-demand",
            "description": "On-demand (default) or Spot list price, or a marketplace ask: the lowest (marketplace-ask-low) or highest (marketplace-ask-high) price one host lists that day on a marketplace. An ask is not a list price. Asks are compared only with asks."
          }
        },
        "required": [
          "chip"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list-price-changes",
      "description": "Use when you need to know whether GPU rental prices moved. Lists list-price changes since a date for one chip or provider, newest first, up to 100 rows, each with its source. 50 free calls a day, then $0.01 USDC on Base per call via x402.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "description": "ISO date, YYYY-MM-DD. Changes after this date."
          },
          "chip": {
            "type": "string",
            "description": "GPU family, for example H100. Give chip, provider or both."
          },
          "provider": {
            "type": "string",
            "description": "Cloud provider: AWS or Azure. Give chip, provider or both."
          },
          "price_type": {
            "type": "string",
            "enum": [
              "on-demand",
              "spot"
            ],
            "default": "on-demand",
            "description": "On-demand (default) or Spot."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 100,
            "description": "Most rows to return, newest first. At most 100."
          }
        },
        "required": [
          "since"
        ],
        "anyOf": [
          {
            "required": [
              "chip"
            ]
          },
          {
            "required": [
              "provider"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get-compute-contract",
      "description": "Use when you need one compute derivative contract in full. Returns its terms, status history, the index it settles against and its venue, with sources. Index values are not returned. 50 free calls a day, then $0.01 USDC on Base per call via x402.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "contract": {
            "type": "string",
            "description": "The contract id (ct-), its exchange code or its full name, for example ct-nymex-gpu1."
          }
        },
        "required": [
          "contract"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list-regulator-actions",
      "description": "Use when you need what regulators have done about traded compute. Lists regulator actions and due dates on compute derivatives since a date, newest first, with sources. 50 free calls a day, then $0.01 USDC on Base per call via x402.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "description": "ISO date, YYYY-MM-DD. Actions and due dates on or after this date."
          },
          "regulator": {
            "type": "string",
            "description": "Only actions by one regulator, by short name or full name, for example CFTC."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25,
            "description": "Most rows to return, newest first. At most 100."
          }
        },
        "required": [
          "since"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_compute_coverage",
      "description": "Use when you need to know what the DAP Compute Market Index covers before concluding something does not exist. Returns the snapshot date, counts and every source. Free.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
