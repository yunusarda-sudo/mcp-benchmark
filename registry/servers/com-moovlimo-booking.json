{
  "$schema": "../schema.json",
  "name": "com.moovlimo/booking",
  "title": "MoovLimo",
  "category": "Design, UI & 3D Media",
  "description": "Luxury chauffeur service for airports, FBOs, events, venues and resorts worldwide.",
  "tools": [
    {
      "name": "search_coverage",
      "description": "Find MoovLimo pages for an airport (IATA code or name), FBO, city, event, venue, festival, Grand Prix, fair, resort or travel topic. Returns titles, summaries and URLs (with Markdown versions).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "e.g. \"Monaco Grand Prix\", \"Cannes\", \"Heathrow\", \"Art Basel\", \"Courchevel\", \"Le Bourget FBO\""
          },
          "section": {
            "type": "string",
            "enum": [
              "airports",
              "fbo-private-jet",
              "galas",
              "film-festivals-awards",
              "concerts",
              "sporting-events",
              "corporate-summits",
              "art-fairs-auctions",
              "yacht-shows",
              "concours-motoring",
              "luxury-weddings",
              "alpine-resorts",
              "travel-desk",
              "fleet",
              "blog"
            ],
            "description": "Optional filter"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 8
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_page",
      "description": "Return the Markdown text of a MoovLimo page: venues, access rules, timings, vehicles, tips and FAQ. Accepts a full URL or a path such as /sporting-events/ or /airports/london-heathrow/.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "get_booking_options",
      "description": "Services, vehicle classes, what is included, contact channels, the flat-fare reservation page link, the payment page and booking policies.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "request_booking",
      "description": "Send a chauffeur reservation request to the MoovLimo 24/7 dispatch desk for the traveller. Only call when the traveller explicitly asked to book. Returns a reference (ML-XXXXXXX); the desk then confirms the flat fare, vehicle and chauffeur by email, phone or WhatsApp. It is not a confirmed booking until then, and no payment is taken.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Lead passenger full name, or an alias for Prive bookings"
          },
          "email": {
            "type": "string",
            "description": "Email (email or phone required)"
          },
          "phone": {
            "type": "string",
            "description": "Mobile with country code"
          },
          "service": {
            "type": "string",
            "enum": [
              "Airport transfer",
              "FBO / private jet",
              "Hourly / as directed",
              "Gala / premiere / red carpet",
              "Film festival / awards",
              "Concert / tour",
              "Grand Prix / sporting event",
              "Corporate summit / roadshow",
              "Art fair / auction",
              "Yacht show",
              "Concours / motoring week",
              "Wedding",
              "Alpine resort transfer",
              "Multi-day itinerary",
              "Film / TV production"
            ]
          },
          "pickup": {
            "type": "string",
            "description": "Airport code + terminal, FBO (+ tail number), hotel, venue or full address"
          },
          "dropoff": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "description": "Local pickup date YYYY-MM-DD"
          },
          "time": {
            "type": "string",
            "description": "Local pickup time HH:MM (for arrivals, the scheduled landing time)"
          },
          "flight": {
            "type": "string",
            "description": "Flight number or private-jet tail number"
          },
          "passengers": {
            "type": "integer",
            "minimum": 1
          },
          "bags": {
            "type": "integer",
            "minimum": 0
          },
          "vehicle": {
            "type": "string",
            "enum": [
              "Luxury sedan (S-Class or similar)",
              "Executive sedan",
              "Luxury SUV (Escalade, Navigator or similar)",
              "Large SUV (Yukon XL or similar)",
              "Sprinter",
              "Stretch limousine",
              "Rolls-Royce / Maybach (on request)",
              "Armored vehicle (on request)",
              "Multiple vehicles"
            ]
          },
          "return": {
            "type": "string",
            "description": "Return trip details, if any"
          },
          "notes": {
            "type": "string",
            "description": "Child seats, accessibility, sign name, NDA / alias, security team, multi-day schedule, etc."
          },
          "agent": {
            "type": "string",
            "description": "Name of your assistant or app"
          },
          "consent": {
            "type": "string",
            "enum": [
              "yes"
            ],
            "description": "The traveller explicitly asked for this booking"
          }
        },
        "required": [
          "name",
          "pickup",
          "dropoff",
          "date",
          "time",
          "consent"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.moovlimo/booking",
    "version": "1.0.0",
    "remoteUrl": "https://moovlimo.com/api/mcp.php",
    "publishedAt": "2026-11-24T13:54:09.390414Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "e70572b5d48c83de3ab47daea144213df7845c721b66252598284433368ebd78"
  }
}
