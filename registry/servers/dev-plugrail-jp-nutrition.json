{
  "$schema": "../schema.json",
  "name": "dev.plugrail/jp-nutrition",
  "title": "PlugRail JP Nutrition",
  "category": "Other",
  "description": "Search Japanese foods and nutrition facts from Japan's Standard Tables of Food Composition.",
  "repository": "https://github.com/plugrail/servers",
  "tools": [
    {
      "name": "search_foods",
      "description": "食品名で日本食品標準成分表（八訂）増補2023年の食品を検索します。食品番号・食品名のみ返します。入力例: {\"query\": \"アマランサス\", \"limit\": 5}",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "description": "検索文字列（部分一致）。例: \"アマランサス\""
          },
          "limit": {
            "description": "取得件数（省略時は10）。例: 5",
            "type": "number"
          },
          "offset": {
            "description": "先頭からの飛ばし件数（省略時は0）。例: 20",
            "type": "number"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "lookup_nutrition",
      "description": "食品番号で可食部100g当たりの成分値を返します。指定した栄養素コードのみ返します。入力例: {\"food_id\": \"01001\", \"nutrient_codes\": [\"ENERC_KCAL\", \"PROT-\"]}",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "food_id": {
            "type": "string",
            "description": "5桁の食品番号。例: \"01001\""
          },
          "nutrient_codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "栄養素コードの配列。例: [\"ENERC_KCAL\"]"
          }
        },
        "required": [
          "food_id",
          "nutrient_codes"
        ]
      }
    },
    {
      "name": "calc_nutrition",
      "description": "食品番号とg数で分量換算値を返します。100g換算の転記ミスを防ぎます（hosted 版は月100件まで無料・超過時はPro案内）。入力例: {\"food_id\": \"01001\", \"grams\": 50, \"nutrient_codes\": [\"ENERC_KCAL\"]}",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "food_id": {
            "type": "string",
            "description": "5桁の食品番号。例: \"01001\""
          },
          "grams": {
            "type": "number",
            "description": "分量（g）。例: 50"
          },
          "nutrient_codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "栄養素コードの配列。例: [\"ENERC_KCAL\"]"
          }
        },
        "required": [
          "food_id",
          "grams",
          "nutrient_codes"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "dev.plugrail/jp-nutrition",
    "version": "0.1.0",
    "remoteUrl": "https://jp-nutrition.plugrail.dev/mcp",
    "publishedAt": "2026-11-22T22:23:57.643296Z",
    "fetchedAt": "2026-11-23T16:50:40.239Z",
    "toolsSha256": "b5f06920022912f0ed7ee34e96a663064bcce624c35331b1a22e4e51552bed3c"
  }
}
