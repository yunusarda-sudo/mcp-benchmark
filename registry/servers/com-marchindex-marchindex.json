{
  "$schema": "../schema.json",
  "name": "com.marchindex/marchindex",
  "title": "MarchIndex",
  "category": "AI, LLMs & Agents",
  "description": "Tracks what's changing in AI: models, laws and connectors, with official sources. Read-only.",
  "tools": [
    {
      "name": "search_models",
      "description": "Search published AI model releases by name, vendor or family. Needs a query (2+ letters) or a vendor.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 100
          },
          "vendor": {
            "type": "string",
            "maxLength": 60
          },
          "limit": {
            "description": "Page size, default 10, max 20",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "offset": {
            "description": "Result offset, max 80",
            "type": "integer",
            "minimum": 0,
            "maximum": 80
          }
        }
      }
    },
    {
      "name": "get_model",
      "description": "One published AI model record by slug (from search_models), with release date, regions and official source.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "list_recent_models",
      "description": "AI models released in the last N days (default 30, max 90), newest first.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90
          },
          "limit": {
            "description": "Page size, default 10, max 20",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "offset": {
            "description": "Result offset, max 80",
            "type": "integer",
            "minimum": 0,
            "maximum": 80
          }
        }
      }
    },
    {
      "name": "search_laws",
      "description": "Search published privacy, cybersecurity and AI laws by name/topic, with optional jurisdiction, category, status filters. Not legal advice.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 100
          },
          "jurisdiction": {
            "type": "string",
            "maxLength": 60
          },
          "category": {
            "type": "string",
            "maxLength": 60
          },
          "status": {
            "type": "string",
            "maxLength": 60
          },
          "limit": {
            "description": "Page size, default 10, max 20",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "offset": {
            "description": "Result offset, max 80",
            "type": "integer",
            "minimum": 0,
            "maximum": 80
          }
        }
      }
    },
    {
      "name": "get_law",
      "description": "One published law by slug: citation, status, effective date, official source link and provision headings. Not legal advice.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "upcoming_effective_dates",
      "description": "Laws taking effect in the next N days (default 180, max 365), soonest first. Not legal advice.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          },
          "jurisdiction": {
            "type": "string",
            "maxLength": 60
          },
          "limit": {
            "description": "Page size, default 10, max 20",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "offset": {
            "description": "Result offset, max 80",
            "type": "integer",
            "minimum": 0,
            "maximum": 80
          }
        }
      }
    },
    {
      "name": "pending_bills",
      "description": "Pending privacy/AI bills tracked by LawMarch, with last action and the legislature's page. Not legal advice.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 100
          },
          "jurisdiction": {
            "type": "string",
            "maxLength": 60
          },
          "limit": {
            "description": "Page size, default 10, max 20",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "offset": {
            "description": "Result offset, max 80",
            "type": "integer",
            "minimum": 0,
            "maximum": 80
          }
        }
      }
    },
    {
      "name": "search_connectors",
      "description": "Search published AI connectors and MCP servers by name or publisher.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 100
          },
          "limit": {
            "description": "Page size, default 10, max 20",
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "offset": {
            "description": "Result offset, max 80",
            "type": "integer",
            "minimum": 0,
            "maximum": 80
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_connector",
      "description": "One published connector record by slug, with publisher, transport, version and official link.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "about_marchindex",
      "description": "What this server covers, data dates, licences, bulk-download links and usage limits.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.marchindex/marchindex",
    "version": "0.1.0",
