{
 "$schema": "../schema.json",
 "name": "uk.co.sellltd/marketplace",
 "title": "Sell Ltd Marketplace",
 "category": "Security & Identity",
 "description": "Browse UK businesses for sale, research companies and prepare owner-authorised business adverts.",
 "tools": [
  {
   "name": "search_companies",
   "description": "Search UK company register information, not businesses advertised for sale. Research is free while the API-key gate is disabled; when enabled, the applicable allowance and prepaid tariff apply. Requires a Sell Ltd API key. Research requests are metered under the current allowance and prepaid tariff. Use a unique idempotencyKey and retry the identical operation with the same key.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string"
     },
     "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
     }
    },
    "required": [
     "query"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "get_company",
   "description": "Retrieve a cache-first company dossier with register profile, officers, ownership, filings, charges, insolvency and available cached financials. Register sections may be incomplete; inspect availability and partial flags. No paid enrichment or AI analysis. Requires a Sell Ltd API key. Research requests are metered under the current allowance and prepaid tariff. Use a unique idempotencyKey and retry the identical operation with the same key.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "number": {
      "type": "string"
     }
    },
    "required": [
     "number"
    ],
    "additionalProperties": false
   }
  },
  {
   "name": "calculate_valuation",
   "description": "Calculate an indicative valuation from supplied financials. Research is free while the API-key gate is disabled; when enabled, the applicable allowance and prepaid tariff apply. Does not confirm or save listing figures. Requires a Sell Ltd API key. Research requests are metered under the current allowance and prepaid tariff. Use a unique idempotencyKey and retry the identical operation with the same key.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "companyName": {
      "type": "string"
     },
     "companyNumber": {
      "type": "string"
     },
     "turnover": {
      "type": "number"
     },
     "adjustedEbitda": {
      "type": "number"
     },
     "cash": {
      "type": "number"
     },
     "interestBearingDebt": {
      "type": "number"
     },
     "sicCodes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "periodEnd": {
      "type": "string"
     }
    },
    "required": [],
    "additionalProperties": false
   }
  },
