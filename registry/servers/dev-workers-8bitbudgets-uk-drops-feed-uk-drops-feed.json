        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "franchise": {
            "type": "string",
            "enum": [
              "pokemon-tcg",
              "mtg",
              "one-piece",
              "lorcana",
              "yugioh",
              "star-wars-unlimited",
              "lego",
              "video-game",
              "retail-sale",
              "jellycat",
              "needoh",
              "other"
