{
  "$schema": "../schema.json",
  "name": "dev.workers.8bitbudgets.uk-drops-feed/uk-drops-feed",
  "title": "UK Drops Feed",
  "category": "AI, LLMs & Agents",
  "description": "Official TCG pre-orders, restocks and dates for agents. $0.01 x402 on Base; 10 free trial calls.",
  "tools": [
    {
      "name": "next_drops",
      "description": "Free: the next 3 collectibles drops across categories (Pokémon, One Piece, Lorcana, Yu-Gi-Oh!, Star Wars: Unlimited, MTG, LEGO, games including GTA 6). Default region is UK; pass region=US or all. Includes dated releases and high-demand restock-watches still waiting for a confirmed day (e.g. a Pokémon Ultra-Premium Collection).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "region": {
            "description": "UK (default), US, CA, AU, EU, JP, comma-separated, or all",
            "type": "string"
          }
        }
      }
    },
    {
      "name": "upcoming_drops",
