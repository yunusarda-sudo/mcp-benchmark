{
  "$schema": "../schema.json",
  "name": "io.github.Joshuv-AI/tower-of-babel",
  "title": "Tower of Babel",
  "category": "Developer Tools & DevOps",
  "description": "Search and read 2.5M+ public-domain full texts from the Tower of Babel library. No key required.",
  "repository": "https://github.com/Joshuv-AI/tower-of-babel-catalog",
  "tools": [
    {
      "name": "search_works",
      "description": "Search the Tower of Babel public-domain library by title or creator. Results are in catalog order, not relevance-ranked; follow next_cursor until it is null to cover more of the catalog. Read-only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search text, matched as words against title and/or creator."
          },
          "field": {
            "type": "string",
            "enum": [
              "title",
              "author",
              "any"
            ],
            "default": "any"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "cursor": {
            "type": "string",
            "description": "Opaque continuation cursor from a previous call."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_work",
      "description": "Get one work's metadata by its id (artifact id, e.g. us-declaration-of-independence). Read-only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The work's artifact id."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_collection",
      "description": "List works in one collection (PAPERS, DECLASSIFIED, BOOKS, REFERENCE, DOCUMENTS, PODCASTS) in catalog order. Follow next_cursor until null. Read-only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "enum": [
              "PAPERS",
              "DECLASSIFIED",
              "LAW",
              "BOOKS",
              "REFERENCE",
              "DOCUMENTS",
              "PODCASTS"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "cursor": {
            "type": "string",
            "description": "Opaque continuation cursor from a previous call."
          }
        },
        "required": [
          "collection"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_group",
      "description": "List works in a precomputed group: a sacred tradition, a declassified programme, a top author, or a course group. Use the collections endpoint (or the library's group lists) for valid keys. Read-only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "group": {
            "type": "string",
            "enum": [
              "traditions",
              "programmes",
              "authors",
              "course"
            ]
          },
          "key": {
            "type": "string",
            "description": "Tradition/programme key, author slug, or course-group slug."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          }
        },
        "required": [
          "group",
          "key"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.Joshuv-AI/tower-of-babel",
    "version": "1.0.0",
    "remoteUrl": "https://antarctic-labs.com/mcp",
    "publishedAt": "2026-11-24T00:10:10.109087Z",
    "fetchedAt": "2026-11-24T12:15:48.059Z",
    "toolsSha256": "b90545cb40beb34e52cef3b9f8b96805b60bad419a80b65ab457c25216c1865a"
  }
}
