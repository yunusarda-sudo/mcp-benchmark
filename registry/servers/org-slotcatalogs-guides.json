{
  "$schema": "../schema.json",
  "name": "org.slotcatalogs/guides",
  "title": "SlotCatalog Guides",
  "category": "E-Commerce & Retail",
  "description": "Read-only app and brand guides for India, Brazil, and Mexico, with sources and review dates.",
  "tools": [
    {
      "name": "search_guides",
      "description": "Search the editorial catalogue by brand, alias, or market. Results include market-specific guide IDs and available reviewed topics.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "description": "A brand name or alias. Omit to browse the catalogue.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "[\\p{L}\\p{N}]"
          },
          "market": {
            "description": "IN (India), BR (Brazil), or MX (Mexico).",
            "type": "string",
            "enum": [
              "IN",
              "BR",
              "MX"
            ]
          },
          "limit": {
            "description": "Maximum matches. Defaults to 10.",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_guide",
      "description": "Read a documented answer, sources, dates, and evidence limitations for a market-specific guide ID and topic. Undocumented topics return no answer.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^(?:in|br|mx):[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "A market-qualified guide ID returned by search_guides."
          },
          "topic": {
            "description": "A topic listed for this guide. Defaults to overview.",
            "type": "string",
            "maxLength": 48,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "org.slotcatalogs/guides",
    "version": "0.2.0",
    "remoteUrl": "https://slotcatalog-guides-mcp.ws2seomm.workers.dev/mcp",
    "publishedAt": "2026-11-24T02:40:11.085345Z",
    "fetchedAt": "2026-11-24T12:15:48.059Z",
    "toolsSha256": "5eb101b0f2d9887dc7eeefa4307882c7ae97d47d142362292d7edb655bf7f6b1"
  }
}
