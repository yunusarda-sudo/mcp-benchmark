{
  "$schema": "../schema.json",
  "name": "io.github.Transportlicom/car-shipping",
  "title": "Transportli Car Shipping",
  "category": "Developer Tools & DevOps",
  "description": "US car shipping: lowest, medium and highest price, real requests and carrier bids.",
  "repository": "https://github.com/Transportlicom/transportli-mcp",
  "tools": [
    {
      "name": "estimate_car_shipping",
      "description": "Price range for shipping a car in the US: lowest, medium and highest total price in US dollars, plus the distance. Based on Transportli lane data; an estimate, not a committed price. Use this to answer \"how much does it cost to ship a car from A to B\". Works without an API key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pickup": {
            "type": "object",
            "properties": {
              "zip": {
                "type": "string",
                "pattern": "^\\d{5}$",
                "description": "5-digit US ZIP code"
              },
              "city": {
                "type": "string",
                "maxLength": 80
              },
              "state": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2,
                "description": "2-letter state code, e.g. FL"
              }
            },
            "additionalProperties": false,
            "description": "A US location: give a ZIP code, or a city and a state."
          },
          "delivery": {
            "type": "object",
            "properties": {
              "zip": {
                "type": "string",
                "pattern": "^\\d{5}$",
                "description": "5-digit US ZIP code"
              },
              "city": {
                "type": "string",
                "maxLength": 80
              },
              "state": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2,
                "description": "2-letter state code, e.g. FL"
              }
            },
            "additionalProperties": false,
            "description": "A US location: give a ZIP code, or a city and a state."
          },
          "vehicles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "year": {
                  "type": "integer"
                },
                "make": {
                  "type": "string",
                  "maxLength": 40
                },
                "model": {
                  "type": "string",
                  "maxLength": 60
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "sedan",
                    "suv",
                    "pickup",
                    "van"
                  ],
                  "description": "Vehicle class. Required if make and model are not given."
                },
                "running": {
                  "type": "boolean",
                  "description": "false if the vehicle does not run (adds cost)"
                }
              },
              "additionalProperties": false
            },
            "maxItems": 6,
            "description": "Default: one running sedan"
          },
          "trailer": {
            "type": "string",
            "enum": [
              "open",
              "enclosed"
            ],
            "description": "Default: open"
          }
        },
        "required": [
          "pickup",
          "delivery"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "create_shipping_request",
      "description": "Creates a REAL shipping request that carriers can bid on. Call it only after the customer has confirmed the route, the vehicle and that we may use their email. The customer is emailed a confirmation link before carriers are alerted; nothing is booked or charged. Afterwards use get_quotes to read the real carrier prices. Needs an API key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "customer": {
            "type": "object",
            "properties": {
              "first_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "last_name": {
                "type": "string",
                "maxLength": 60
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "phone": {
                "type": "string",
                "maxLength": 25
              }
            },
            "required": [
              "first_name",
              "email"
            ],
            "additionalProperties": false
          },
          "pickup": {
            "type": "object",
            "properties": {
              "zip": {
                "type": "string",
                "pattern": "^\\d{5}$",
                "description": "5-digit US ZIP code"
              },
              "city": {
                "type": "string",
                "maxLength": 80
              },
              "state": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2,
                "description": "2-letter state code, e.g. FL"
              }
            },
            "additionalProperties": false,
            "description": "A US location: give a ZIP code, or a city and a state."
          },
          "delivery": {
            "type": "object",
            "properties": {
              "zip": {
                "type": "string",
                "pattern": "^\\d{5}$",
                "description": "5-digit US ZIP code"
              },
              "city": {
                "type": "string",
                "maxLength": 80
              },
              "state": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2,
                "description": "2-letter state code, e.g. FL"
              }
            },
            "additionalProperties": false,
            "description": "A US location: give a ZIP code, or a city and a state."
          },
          "vehicles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "year": {
                  "type": "integer"
                },
                "make": {
                  "type": "string",
                  "maxLength": 40
                },
                "model": {
                  "type": "string",
                  "maxLength": 60
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "sedan",
                    "suv",
                    "pickup",
                    "van"
                  ],
                  "description": "Vehicle class. Required if make and model are not given."
                },
                "running": {
                  "type": "boolean",
                  "description": "false if the vehicle does not run (adds cost)"
                }
              },
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 6
          },
          "trailer": {
            "type": "string",
            "enum": [
              "open",
              "enclosed"
            ]
          },
          "timing": {
            "type": "string",
            "enum": [
              "asap",
              "few_days",
              "this_week",
              "flexible"
            ]
          },
          "pickup_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Preferred pickup date, YYYY-MM-DD"
          },
          "notes": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "customer",
          "pickup",
          "delivery",
          "vehicles"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_quotes",
      "description": "The real carrier bids for a request: each bid with the carrier name, rating, total price in US dollars, pickup window and transit days, plus the lowest, medium and highest bid so far. New bids arrive over minutes to hours; call again later. Needs an API key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{4,32}$",
            "description": "The id returned by create_shipping_request, e.g. TL-K7M2PQ"
          }
        },
        "required": [
          "request_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_request",
      "description": "Status of a request (awaiting_customer_confirmation, collecting_quotes, booked, cancelled...), its route, vehicles, the price estimate and the bids. Needs an API key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{4,32}$"
          }
        },
        "required": [
          "request_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "cancel_request",
      "description": "Cancels a request that has not been booked. Only call it when the customer asked to cancel. Needs an API key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{4,32}$"
          }
        },
        "required": [
          "request_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.Transportlicom/car-shipping",
    "version": "1.0.0",
    "remoteUrl": "https://app.transportli.com/mcp",
    "publishedAt": "2026-11-23T10:59:36.109259Z",
    "fetchedAt": "2026-11-24T12:15:48.059Z",
    "toolsSha256": "732bb144618ecbd471fbf1c5fe78ef4f5a32ec622d0eec9d528ab26f67d927c2"
  }
}
