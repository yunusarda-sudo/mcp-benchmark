{
  "$schema": "../schema.json",
  "name": "com.scendira/dira",
  "title": "Dira by Scendira",
  "category": "Vector DBs & AI Search",
  "description": "Dira, Your Fragrance Finder: recommends, finds alternatives, compares and looks up perfumes.",
  "tools": [
    {
      "name": "recommend_perfumes",
      "description": "Recommend up to 3 perfumes for a person's taste. Give any structured preferences you know (scent families, loved and avoided notes, perfumes they love, gender, budget, strength, occasion, climate) and optionally the person's own short request text. Supports gifts: set gift=true (or gift_recipient_gender / gift_occasion / gift_budget_max_usd, or a gendered gift_recipient) and describe the recipient's taste; the gift_ fields take the recipient's lean, the relationship, the occasion and the gift budget. Each pick returns notes, longevity and projection scores, price where known, how much community evidence backs it, reasons, honest trade-offs against a named perfume, a buy-or-sample advice, and a scendira.com product page link.",
      "inputSchema": {
        "properties": {
          "scent_families": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "sweet",
                    "fresh",
                    "floral",
                    "fruity",
                    "warm",
                    "woody"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Scent families the person likes. woody covers woody, oud, leather and smoky.",
            "title": "Scent Families"
          },
          "notes_loved": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Specific notes the person wants, e.g. ['vanilla', 'pistachio'] (max 8).",
            "title": "Notes Loved"
          },
          "notes_avoided": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Notes or materials to avoid, e.g. ['oud', 'patchouli'] (max 8).",
            "title": "Notes Avoided"
          },
          "sensitivities": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "too_sweet",
                    "too_strong",
                    "too_smoky",
                    "synthetic"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Broad dislikes: too_sweet, too_strong, too_smoky, synthetic.",
            "title": "Sensitivities"
          },
          "loves_perfumes": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Perfumes the person already loves (brand + name), used as the reference for similar picks (max 3).",
            "title": "Loves Perfumes"
          },
          "gender_lean": {
            "anyOf": [
              {
                "enum": [
                  "feminine",
                  "masculine",
                  "unisex",
                  "any"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Who it is for: feminine, masculine, unisex (unisex scents only) or any. For a gift, the recipient's.",
            "title": "Gender Lean"
          },
          "budget_max_usd": {
            "anyOf": [
              {
                "maximum": 2000,
                "minimum": 1,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Highest bottle price in USD.",
            "title": "Budget Max Usd"
          },
          "strength": {
            "anyOf": [
              {
                "enum": [
                  "subtle",
                  "moderate",
                  "strong",
                  "beast"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "How strongly it should project.",
            "title": "Strength"
          },
          "occasion": {
            "anyOf": [
              {
                "enum": [
                  "date_night",
                  "everyday",
                  "office"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Main occasion.",
            "title": "Occasion"
          },
          "climate": {
            "anyOf": [
              {
                "enum": [
                  "hot_humid",
                  "hot_dry",
                  "mild",
                  "cold"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Climate it will be worn in.",
            "title": "Climate"
          },
          "gift": {
            "default": false,
            "description": "True when choosing for someone else.",
            "title": "Gift",
            "type": "boolean"
          },
          "gift_recipient": {
            "anyOf": [
              {
                "enum": [
                  "partner",
                  "parent",
                  "sibling",
                  "child",
                  "friend",
                  "colleague",
                  "other",
                  "wife",
                  "husband",
                  "girlfriend",
                  "boyfriend",
                  "mother",
                  "father",
                  "sister",
                  "brother",
                  "daughter",
                  "son",
                  "grandmother",
                  "grandfather",
                  "aunt",
                  "uncle"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The recipient's relationship to the person (optional). wife, husband, mother, son ... make the ask a gift and set the recipient's lean when none is given.",
            "title": "Gift Recipient"
          },
          "gift_recipient_gender": {
            "anyOf": [
              {
                "enum": [
                  "feminine",
                  "masculine",
                  "unisex",
                  "any"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The recipient's lean: feminine, masculine, unisex (unisex scents only) or any. Wins over gender_lean and over the relationship.",
            "title": "Gift Recipient Gender"
          },
          "gift_occasion": {
            "anyOf": [
              {
                "enum": [
                  "birthday",
                  "anniversary",
                  "wedding",
                  "holiday",
                  "graduation",
                  "thank_you",
                  "just_because",
                  "date_night",
                  "everyday",
                  "office"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The gift's occasion. date_night, everyday and office steer the picks; birthday, anniversary and the other moments are noted only.",
            "title": "Gift Occasion"
          },
          "gift_budget_max_usd": {
            "anyOf": [
              {
                "maximum": 2000,
                "minimum": 1,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Highest bottle price in USD for the gift. Wins over budget_max_usd.",
            "title": "Gift Budget Max Usd"
          },
          "request_text": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The person's own short request, read for stated preferences only (not stored).",
            "title": "Request Text"
          }
        },
        "title": "recommend_perfumesArguments",
        "type": "object"
      }
    },
    {
      "name": "find_alternatives",
      "description": "Find up to 3 perfumes that smell similar to a named perfume: alternatives, dupes, 'smells like' picks, optionally cheaper than it or within a budget. Uses Scendira's reviewed similarity links and community 'smells like' evidence where they exist, and returns trade-offs against the original (longevity, projection, price).",
      "inputSchema": {
        "properties": {
          "perfume": {
            "description": "Brand and name, e.g. 'Lattafa Khamrah'.",
            "maxLength": 120,
            "minLength": 2,
            "title": "Perfume",
            "type": "string"
          },
          "cheaper": {
            "default": false,
            "description": "Only alternatives priced below the named perfume.",
            "title": "Cheaper",
            "type": "boolean"
          },
          "budget_max_usd": {
            "anyOf": [
              {
                "maximum": 2000,
                "minimum": 1,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Highest bottle price in USD.",
            "title": "Budget Max Usd"
          },
          "gender_lean": {
            "anyOf": [
              {
                "enum": [
                  "feminine",
                  "masculine",
                  "unisex",
                  "any"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Who it is for: feminine, masculine, unisex (unisex scents only) or any. For a gift, the recipient's.",
            "title": "Gender Lean"
          },
          "notes_avoided": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Notes or materials to avoid, e.g. ['oud', 'patchouli'] (max 8).",
            "title": "Notes Avoided"
          },
          "sensitivities": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "too_sweet",
                    "too_strong",
                    "too_smoky",
                    "synthetic"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Broad dislikes: too_sweet, too_strong, too_smoky, synthetic.",
            "title": "Sensitivities"
          }
        },
        "required": [
          "perfume"
        ],
        "title": "find_alternativesArguments",
        "type": "object"
      }
    },
    {
      "name": "compare_perfumes",
      "description": "Compare 2 to 4 named perfumes side by side: notes, longevity, projection, blind-buy safety, price and community evidence. Optionally pick a winner on chosen criteria, or say which is closer in scent to a third perfume. A winner is named only when every perfume was found and measured on every criterion and one is clearly ahead.",
      "inputSchema": {
        "properties": {
          "perfumes": {
            "description": "Perfume names (brand + name), 2 to 4.",
            "items": {
              "type": "string"
            },
            "maxItems": 4,
            "minItems": 2,
            "title": "Perfumes",
            "type": "array"
          },
          "criteria": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "longevity",
                    "projection",
                    "blind_buy_safety",
                    "price"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "What to compare on: longevity, projection, blind_buy_safety, price.",
            "title": "Criteria"
          },
          "budget_max_usd": {
            "anyOf": [
              {
                "maximum": 2000,
                "minimum": 1,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Highest bottle price in USD.",
            "title": "Budget Max Usd"
          },
          "closer_to": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "A third perfume: which candidate smells closer to it.",
            "title": "Closer To"
          }
        },
        "required": [
          "perfumes"
        ],
        "title": "compare_perfumesArguments",
        "type": "object"
      }
    },
    {
      "name": "lookup_perfume",
      "description": "Look up one perfume by name: concentration, scent family, notes pyramid, main accords, a one-line scent description, longevity, projection and blind-buy safety scores, price where known, community evidence and its scendira.com page. Returns close catalogue matches when the name is not found.",
      "inputSchema": {
        "properties": {
          "name": {
            "description": "Brand and name, e.g. 'Kayali Vanilla 28'.",
            "maxLength": 120,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "lookup_perfumeArguments",
        "type": "object"
      }
    }
  ],
