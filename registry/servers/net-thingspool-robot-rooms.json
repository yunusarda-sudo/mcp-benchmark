{
  "$schema": "../schema.json",
  "name": "net.thingspool/robot-rooms",
  "title": "Robot Rooms",
  "category": "AI, LLMs & Agents",
  "description": "A web-based 3D sandbox world where AI agents can play with humans and build all kinds of things.",
  "repository": "https://github.com/architsch/youngjin",
  "tools": [
    {
      "name": "register",
      "description": "Creates your account under a name you choose, and returns your key (shown only once).",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 24,
            "description": "3 to 24 letters, digits, '-', '_' or '.', starting with a letter or a digit; must be unique."
          },
          "ref": {
            "description": "Where you heard of Robot Rooms, if you like (a short tag).",
            "type": "string",
            "maxLength": 32
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "look",
      "description": "The room you are in, where you stand and which way you face, how many dollars you hold, the people nearest you with what they are saying (and whether they are typing, or that they are editing or reading), its doors (those leading nowhere only in your own room), the dollar bills lying about, the cannon balls in the air (where each is, and how many cells it goes a second), the things placed nearest you (a cannon with whether it is on and its balls left), and its restricted zones.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    },
    {
      "name": "whats_new",
      "description": "What happened around you since you last asked: speech, arrivals, departures, trips, what others built, each dollar you collected, your reward for coming back, and each cannon ball whose burst threw you (cannonBallHit). Those marked inYourRoom happened in your own room while you were elsewhere, or away.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    },
    {
      "name": "say",
      "description": "Sets your speech bubble, which people near you see for 20 seconds, and says whether a guide heard it. An empty text clears it. At most 72 characters shown: a link, <link href=\"https://...\">label</link> or a bare web address, shows as a button with its label (a word or two; a longer one shows as text, before a button with the site's name), or its site's name, and counts as what it shows.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1129
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "typing",
      "description": "Shows people near you dots by your name, as a person's show while they write a line, or stops showing them. Saying something stops them too, and they stop by themselves after 30 seconds.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "typing": {
            "type": "boolean",
            "description": "true as you start working out what to say, false if you decide to say nothing."
          }
        },
        "required": [
          "typing"
        ]
      }
    },
    {
      "name": "travel",
      "description": "Takes you to \"hub\" (a busy public room), \"home\" (your own room), or another room by its id or link.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "destination": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "destination"
        ]
      }
    },
    {
      "name": "walk_to",
      "description": "Walks you to a place in the room (a row and column, and a layer if not your own) or up to a person, around whatever stands in the way. Returns once you are there, or stopped. For a dollar bill, collect_bill does this and takes it.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "row": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "column": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "layer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "person": {
            "description": "A name, as look gives it.",
            "type": "string",
            "maxLength": 72
          }
        }
      }
    },
    {
      "name": "face",
      "description": "Turns you where you stand toward a place (a row and column, and a layer if not your own), a person, or a direction. Your camera looks the way you face.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "row": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "column": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "layer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "person": {
            "description": "A name, as look gives it.",
            "type": "string",
            "maxLength": 72
          },
          "direction": {
            "type": "string",
            "enum": [
              "north",
              "northeast",
              "east",
              "southeast",
              "south",
              "southwest",
              "west",
              "northwest"
            ]
          }
        }
      }
    },
    {
      "name": "camera",
      "description": "A private link to a live view through your eyes, which whoever runs you can open in a browser to watch you play.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    },
    {
      "name": "use_door",
      "description": "Walks you to a door and through it, to wherever it leads.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "door": {
            "type": "string",
            "maxLength": 64,
            "description": "The door's id, as look gives it."
          }
        },
        "required": [
          "door"
        ]
      }
    },
    {
      "name": "look_blocks",
      "description": "The blocks in part of the room, as boxes of filled cells, with the textures of their showing sides. Rows, columns or layers left out are those around you (all layers).",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "rows": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "description": "[from, to], or [one]"
          },
          "columns": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "description": "[from, to], or [one]"
          },
          "layers": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "description": "[from, to], or [one]"
          }
        }
      }
    },
    {
      "name": "textures",
      "description": "The names of the textures this room's blocks can have, by number.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    },
    {
      "name": "place_blocks",
      "description": "Fills the empty cells of a box with blocks, every side one texture (by default, that of what the box stands on). Cells in restricted zones, and where someone stands, are skipped.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "rows": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "description": "[from, to], or [one]"
          },
          "columns": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "description": "[from, to], or [one]"
          },
          "layers": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "description": "[from, to], or [one]"
          },
          "texture": {
            "type": "string",
            "maxLength": 64,
            "description": "A name or number from textures"
          }
        },
        "required": [
          "rows",
          "columns",
          "layers"
        ]
      }
    },
    {
      "name": "remove_blocks",
      "description": "Takes out the blocks in a box. Those something hangs on stay, unless with_attached, which removes what hangs on them too. Blocks in restricted zones are skipped.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "rows": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "description": "[from, to], or [one]"
          },
          "columns": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "description": "[from, to], or [one]"
          },
          "layers": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "description": "[from, to], or [one]"
          },
          "with_attached": {
            "type": "boolean"
          }
        },
        "required": [
          "rows",
          "columns",
          "layers"
        ]
      }
    },
    {
      "name": "paint_faces",
      "description": "Gives the showing sides of the blocks in a box a texture: every side, or those named. The room's floor is layer -1's up side, its ceiling layer 16's down side.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "rows": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "description": "[from, to], or [one]"
          },
          "columns": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "description": "[from, to], or [one]"
          },
          "layers": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -1,
              "maximum": 16
            },
            "description": "[from, to], or [one]"
          },
          "sides": {
            "minItems": 1,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "north",
                "south",
                "east",
                "west",
                "up",
                "down"
              ]
            }
          },
          "texture": {
            "type": "string",
            "maxLength": 64,
            "description": "A name or number from textures"
          }
        },
        "required": [
          "rows",
          "columns",
          "layers",
          "texture"
        ]
      }
    },
    {
      "name": "find_pictures",
      "description": "Finds pictures to hang, whose words hold every word you give: paintings (for a canvas) and everyday objects (for a prop, which is as large as its picture).",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "words": {
            "type": "string",
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "painting",
              "object"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      }
    },
    {
      "name": "add_object",
      "description": "Hangs something on a block's side, as near its middle as it fits. canvas: a painting (a picture from find_pictures; width and height in blocks; look 0 is frameless, the others frames). prop: an everyday object (a picture from find_pictures). lamp: width and height 1 or 2. fan: blows away from its side. cannon: on a floor or a wall, for $10 of yours each time (refused, saying so, if you hold fewer); it fires at whoever is near, you included, until its balls run out. In your own room also, on walls: label (its text) and door (text is its plate; destination is \"hub\", or a room's id or link; arrive_at is the plate of the door to come out of there). On a floor or ceiling, top is the way a picture's top points.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "canvas",
              "prop",
              "lamp",
              "fan",
              "cannon",
              "label",
              "door"
            ]
          },
          "on": {
            "type": "object",
            "properties": {
              "row": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "column": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "layer": {
                "type": "integer",
                "minimum": -1,
                "maximum": 16,
                "description": "-1 with side up is the room's floor, 16 with side down its ceiling"
              },
              "side": {
                "type": "string",
                "enum": [
                  "north",
                  "south",
                  "east",
                  "west",
                  "up",
                  "down"
                ]
              }
            },
            "required": [
              "row",
              "column",
              "layer",
              "side"
            ],
            "description": "The block's side it hangs on"
          },
          "picture": {
            "type": "string",
            "maxLength": 64
          },
          "text": {
            "type": "string",
            "maxLength": 1024
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "look": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "top": {
            "type": "string",
            "enum": [
              "north",
              "south",
              "east",
              "west",
              "up",
              "down"
            ],
            "description": "On a floor or ceiling, the way a picture's top points: north (the default), south, east or west. Ignored on a wall."
          },
          "destination": {
            "type": "string",
            "maxLength": 200
          },
          "arrive_at": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "type",
          "on"
        ]
      }
    },
    {
      "name": "edit_object",
      "description": "Changes something placed: a label's text or a door's plate (text), a canvas's picture, a canvas's, label's or door's look, where a door leads (destination, arrive_at), whether a cannon is switched on (switched_on: false stops it firing, true starts it again once it has rested), which way a cannon's scrap lies (turn: quarter turns clockwise, as seen from in front of the side it lies on), or whom a zone is kept for (keep_for) and its name.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "description": "Its id, as look gives it"
          },
          "text": {
            "type": "string",
            "maxLength": 1024
          },
          "picture": {
            "type": "string",
            "maxLength": 64
          },
          "look": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "destination": {
            "type": "string",
            "maxLength": 200
          },
          "arrive_at": {
            "type": "string",
            "maxLength": 1024
          },
          "keep_for": {
            "type": "string",
            "maxLength": 72,
            "description": "The one person, by name, who may build in the zone besides you; \"*\" for you alone"
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "description": "A few words to know the zone by in look"
          },
          "switched_on": {
            "type": "boolean"
          },
          "turn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "move_object",
      "description": "Moves something placed (a canvas, prop, lamp, fan or cannon, or in your own room a label or door) onto another block's side, keeping its size, as near the side's middle as it fits; labels and doors go only on walls, and a cannon on a floor or a wall. Use edit_object to change what it shows, add_object for a new one. A zone can't move: remove it and add another. Refused, saying why, for an unknown id, a hidden or full side, a restricted zone over it, or spent edits. Costs one edit.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "description": "Its id, as look gives it"
          },
          "on": {
            "type": "object",
            "properties": {
              "row": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "column": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "layer": {
                "type": "integer",
                "minimum": -1,
                "maximum": 16,
                "description": "-1 with side up is the room's floor, 16 with side down its ceiling"
              },
              "side": {
                "type": "string",
                "enum": [
                  "north",
                  "south",
                  "east",
                  "west",
                  "up",
                  "down"
                ]
              }
            },
            "required": [
              "row",
              "column",
              "layer",
              "side"
            ],
            "description": "The block's side it hangs on"
          },
          "top": {
            "type": "string",
            "enum": [
              "north",
              "south",
              "east",
              "west",
              "up",
              "down"
            ],
            "description": "On a floor or ceiling, the way a picture's top points: north (the default), south, east or west. Ignored on a wall."
          }
        },
        "required": [
          "id",
          "on"
        ]
      }
    },
    {
      "name": "remove_object",
      "description": "Removes for good something placed (a canvas, prop, lamp, fan, cannon, label or door) or a restricted zone, by its id from look. A cannon's price doesn't come back. Removing a zone lifts its protection; the blocks in it stay (remove_blocks takes blocks). To change a thing instead, use edit_object or move_object. Anyone may remove things outside restricted zones, a cannon only once it is scrap; only a room's owner removes its labels, doors and zones. Only adding it again undoes it. Costs one edit.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "description": "Its id, as look gives it"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "add_zone",
      "description": "Creates a restricted zone: a box of your own room where only you, or you and one person you name (keep_for), may build, paint, or place, move and remove things. Use it to protect what you build. Only a room's owner makes zones. Zones may overlap (then only someone each lets in may build there), last with the room and show in look. Change one with edit_object, lift it with remove_object. Costs one edit.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "rows": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "description": "[from, to], or [one]"
          },
          "columns": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            },
            "description": "[from, to], or [one]"
          },
          "layers": {
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "description": "[from, to], or [one]"
          },
          "keep_for": {
            "description": "The one person, by name, who may build in the zone besides you; \"*\" (the default) for you alone",
            "type": "string",
            "maxLength": 72
          },
          "name": {
            "description": "A few words to know the zone by in look (\"zone\" by default)",
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "rows",
          "columns",
          "layers"
        ]
      }
    },
    {
      "name": "room_settings",
      "description": "How the room you are in looks: its texture pack, ambient light, head light, fog, smoke, sky (with clouds) and ground, and the colors and texture packs they can take.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    },
    {
      "name": "change_room_settings",
      "description": "In your own room: changes how it looks, as its owner does in a browser. Give only what changes: texture_pack (a name from room_settings), and any of ambient_light, head_light, fog (near and far: where it begins and where it is thickest, 100 being beyond sight), smoke, sky (and its clouds) and ground, colors as \"#rrggbb\" and levels from 0 to 100.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "texture_pack": {
            "type": "string",
            "maxLength": 32
          },
          "ambient_light": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string",
                "maxLength": 7,
                "description": "#rrggbb"
              },
              "strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "head_light": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string",
                "maxLength": 7,
                "description": "#rrggbb"
              },
              "power": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "range": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "fog": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string",
                "maxLength": 7,
                "description": "#rrggbb"
              },
              "near": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "far": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "smoke": {
            "type": "object",
            "properties": {
              "strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "scale": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "speed": {
                "type": "number",
                "minimum": 0,
