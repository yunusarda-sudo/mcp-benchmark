{
  "$schema": "../schema.json",
  "name": "io.github.pat-the-cat-cat/part-guide-ai",
  "title": "Part Guide AI Catalog",
  "category": "Developer Tools & VCS",
  "description": "AI model & tool popularity rankings: search, compare, and best-in-category, from live data.",
  "repository": "https://github.com/pat-the-cat-cat/parts.guide",
  "tools": [
    {
      "name": "search_products",
      "description": "Search the AI catalog by product name or ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Product name or part of it"
          },
          "limit": {
            "type": "number",
            "description": "Max results (default 10)",
            "minimum": 1,
            "maximum": 25
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_product",
      "description": "Read a product’s documented attributes and sources.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product": {
            "type": "string",
            "description": "Product id or name"
          },
          "asOf": {
            "type": "string",
            "description": "UTC date for freshness checks (YYYY-MM-DD). Defaults to today.",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "product"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "compare_products",
      "description": "Compare sourced attributes within one shared category.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "products": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 5,
            "description": "Product ids or names"
          },
          "category": {
            "type": "string",
            "description": "Catalog category ID, such as models or editors"
          },
          "asOf": {
            "type": "string",
            "description": "UTC date for freshness checks (YYYY-MM-DD). Defaults to today.",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "products"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_categories",
      "description": "List available AI catalog categories.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.pat-the-cat-cat/part-guide-ai",
    "version": "1.0.0",
    "remoteUrl": "https://part.guide/ai/mcp",
    "publishedAt": "2026-11-22T13:09:02.751571Z",
    "fetchedAt": "2026-11-23T16:50:40.239Z",
    "toolsSha256": "2326628308fd954f6d8d6d56845322eca441384dffb59ef09ea74a0d3da1d742"
  }
}
