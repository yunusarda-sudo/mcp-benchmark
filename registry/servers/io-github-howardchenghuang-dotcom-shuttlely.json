{
  "$schema": "../schema.json",
  "name": "io.github.howardchenghuang-dotcom/shuttlely",
  "title": "Shuttlely private charters",
  "category": "Developer Tools & DevOps",
  "description": "Price and book private cars with a driver from Toronto, Vancouver, Calgary/Banff, Halifax.",
  "tools": [
    {
      "name": "list_routes",
      "description": "Private-charter routes by departure city (Toronto, Vancouver, Calgary · Banff, Halifax), with lengths and the from-price for Toronto routes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "en",
              "zh"
            ],
            "description": "Language of route titles: en (default) or zh"
          }
        }
      }
    },
    {
      "name": "get_quote",
      "description": "Instant per-vehicle price range (CAD, tax included) for Toronto routes, airport transfers or a custom route, from the public price book. Read-only: books nothing.",
      "inputSchema": {
        "type": "object",
        "required": [
          "startDate",
          "guests"
        ],
        "properties": {
          "routes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Toronto route slugs from list_routes, in travel order. Use routes or customDays, not both."
          },
          "customDays": {
            "type": "array",
            "maxItems": 14,
            "items": {
              "type": "string",
              "maxLength": 120
            },
            "description": "A custom route from Toronto: one short line per day in the traveller's words. Always a written quote."
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "First service day, YYYY-MM-DD, Toronto time; up to about 18 months ahead"
          },
          "guests": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60,
            "description": "Guests including children; 1-7 can price instantly"
          },
          "vehicleClass": {
            "type": "string",
            "enum": [
              "sedan",
              "suv",
              "minivan"
            ],
            "description": "Optional; defaults to the smallest class that fits"
          },
          "extraHoursPerDay": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4,
            "description": "Extra hours per touring day beyond the included 10"
          },
          "airportPickup": {
            "type": "object",
            "required": [
              "airport",
              "zone"
            ],
            "properties": {
              "airport": {
                "type": "string",
                "enum": [
                  "YYZ",
                  "YTZ"
                ],
                "description": "Toronto Pearson (YYZ) or Billy Bishop (YTZ)"
              },
              "zone": {
                "type": "string",
                "enum": [
                  "toronto-downtown",
                  "markham",
                  "north-york",
                  "other"
                ],
                "description": "Where in Toronto; \"other\" gets a written quote"
              }
            },
            "description": "Optional airport pickup on the start date; touring starts the next morning"
          },
          "airportDropoff": {
            "type": "object",
            "required": [
              "airport",
              "zone"
            ],
            "properties": {
              "airport": {
                "type": "string",
                "enum": [
                  "YYZ",
                  "YTZ"
                ],
                "description": "Toronto Pearson (YYZ) or Billy Bishop (YTZ)"
              },
              "zone": {
                "type": "string",
                "enum": [
                  "toronto-downtown",
                  "markham",
                  "north-york",
                  "other"
                ],
                "description": "Where in Toronto; \"other\" gets a written quote"
              }
            },
            "description": "Optional airport drop-off, by default the morning after the last touring day"
          },
          "dropoffDate": {
            "type": "string",
            "format": "date",
            "description": "With airportDropoff: the flight-home date if later than the standard drop-off"
          },
          "childAges": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            },
            "description": "Ages of the children among the guests; car seats are free"
          },
          "bags": {
            "type": "object",
            "properties": {
              "large": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20,
                "description": "Checked suitcases (large bags)"
              },
              "small": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20,
                "description": "Carry-ons and backpacks"
              }
            },
            "description": "Checked suitcases and carry-ons; helps pick a vehicle with room for them"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "zh"
            ],
            "description": "Language of titles and emails"
          }
        }
      }
    },
    {
      "name": "place_order",
      "description": "Submits an order for the traveller with their consent. No payment is taken: Shuttlely confirms availability by email, then sends a deposit link. Returns an order number.",
      "inputSchema": {
        "type": "object",
        "required": [
          "trip",
          "traveller",
          "travellerConsent"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid",
            "description": "Generate once per order; resending the same id never creates a second order"
          },
          "trip": {
            "type": "object",
            "required": [
              "startDate",
              "guests"
            ],
            "properties": {
              "routes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Toronto route slugs from list_routes, in travel order. Use routes or customDays, not both."
              },
              "customDays": {
                "type": "array",
                "maxItems": 14,
                "items": {
                  "type": "string",
                  "maxLength": 120
                },
                "description": "A custom route from Toronto: one short line per day in the traveller's words. Always a written quote."
              },
              "startDate": {
                "type": "string",
                "format": "date",
                "description": "First service day, YYYY-MM-DD, Toronto time; up to about 18 months ahead"
              },
              "guests": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60,
                "description": "Guests including children; 1-7 can price instantly"
              },
              "vehicleClass": {
                "type": "string",
                "enum": [
                  "sedan",
                  "suv",
                  "minivan"
                ],
                "description": "Optional; defaults to the smallest class that fits"
              },
              "extraHoursPerDay": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4,
                "description": "Extra hours per touring day beyond the included 10"
              },
              "airportPickup": {
                "type": "object",
                "required": [
                  "airport",
                  "zone"
                ],
                "properties": {
                  "airport": {
                    "type": "string",
                    "enum": [
                      "YYZ",
                      "YTZ"
                    ],
                    "description": "Toronto Pearson (YYZ) or Billy Bishop (YTZ)"
                  },
                  "zone": {
                    "type": "string",
                    "enum": [
                      "toronto-downtown",
                      "markham",
                      "north-york",
                      "other"
                    ],
                    "description": "Where in Toronto; \"other\" gets a written quote"
                  }
                },
                "description": "Optional airport pickup on the start date; touring starts the next morning"
              },
              "airportDropoff": {
                "type": "object",
                "required": [
                  "airport",
                  "zone"
                ],
                "properties": {
                  "airport": {
                    "type": "string",
                    "enum": [
                      "YYZ",
                      "YTZ"
                    ],
                    "description": "Toronto Pearson (YYZ) or Billy Bishop (YTZ)"
                  },
                  "zone": {
                    "type": "string",
                    "enum": [
                      "toronto-downtown",
                      "markham",
                      "north-york",
                      "other"
                    ],
                    "description": "Where in Toronto; \"other\" gets a written quote"
                  }
                },
                "description": "Optional airport drop-off, by default the morning after the last touring day"
              },
              "dropoffDate": {
                "type": "string",
                "format": "date",
                "description": "With airportDropoff: the flight-home date if later than the standard drop-off"
              },
              "childAges": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 12
                },
                "description": "Ages of the children among the guests; car seats are free"
              },
              "bags": {
                "type": "object",
                "properties": {
                  "large": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20,
                    "description": "Checked suitcases (large bags)"
                  },
                  "small": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20,
                    "description": "Carry-ons and backpacks"
                  }
                },
                "description": "Checked suitcases and carry-ons; helps pick a vehicle with room for them"
              },
              "language": {
                "type": "string",
                "enum": [
                  "en",
                  "zh"
                ],
                "description": "Language of titles and emails"
              }
            },
            "description": "The same trip that was priced with get_quote"
          },
          "traveller": {
            "type": "object",
            "required": [
              "name",
              "email"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 80,
                "description": "The traveller's name as they give it: a plain name, no links or email addresses"
              },
              "email": {
                "type": "string",
                "format": "email",
                "maxLength": 254,
                "description": "Confirmation and the deposit link go here"
              },
              "phone": {
                "type": "string",
                "maxLength": 40,
                "description": "Optional phone number with country code, for the driver on the day"
              },
              "pickup": {
                "type": "string",
                "maxLength": 160,
                "description": "Hotel or address"
              },
              "notes": {
                "type": "string",
                "maxLength": 1000,
                "description": "Flight numbers, luggage, anything else"
              }
            },
            "description": "Who is travelling and where Shuttlely should write"
          },
          "travellerConsent": {
            "type": "boolean",
            "const": true,
            "description": "True only after the traveller agreed to book and to https://shuttlely.ca/en/terms"
          },
          "agentName": {
            "type": "string",
            "maxLength": 80,
            "description": "Which assistant or agent is booking, for the operator"
          }
        }
      }
    },
    {
      "name": "request_quote",
      "description": "Routes from Vancouver, Calgary · Banff and Halifax, or anything custom: sends the request and Shuttlely emails a written per-vehicle price. No payment.",
      "inputSchema": {
        "type": "object",
        "required": [
          "region",
          "guests",
          "email",
          "travellerConsent"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid",
            "description": "Generate once per request"
          },
          "region": {
            "type": "string",
            "enum": [
              "toronto",
              "vancouver",
              "rockies",
              "halifax"
            ],
            "description": "Departure city: toronto, vancouver, rockies (Calgary · Banff) or halifax"
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Route slugs from that city (list_routes)"
          },
          "customRoute": {
            "type": "string",
            "maxLength": 360,
            "description": "Where else they want to go, in their words"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "Omit if not decided"
          },
          "guests": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60,
            "description": "Guests including children"
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "airport_pickup",
                "airport_dropoff",
                "child_seats",
                "lots_of_luggage",
                "ski_gear"
              ]
            },
            "description": "Anything the car or driver must allow for"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "The written quote is sent here"
          },
          "phone": {
            "type": "string",
            "maxLength": 40,
            "description": "Optional phone number with country code"
          },
          "travellerConsent": {
            "type": "boolean",
            "const": true,
            "description": "True only after the traveller agreed to be contacted about this trip"
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "zh"
            ],
            "description": "Language of the written quote email"
          },
          "agentName": {
            "type": "string",
            "maxLength": 80,
            "description": "Which assistant or agent is asking, for the operator"
          }
        }
      }
    }
  ],
  "source": {
