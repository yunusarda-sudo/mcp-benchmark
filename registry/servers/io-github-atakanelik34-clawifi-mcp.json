{
  "$schema": "../schema.json",
  "name": "io.github.atakanelik34/clawifi-mcp",
  "title": "Clawifi",
  "category": "AI, LLMs & Agents",
  "description": "Web search and page reading for AI agents: search, fetch, scrape, map and crawl, with sources.",
  "repository": "https://github.com/ReARCLabs/clawifi-mcp",
  "tools": [
    {
      "name": "fetch_url",
      "description": "Fetch one URL (page or PDF) as clean markdown with route diagnostics. query returns only the top_k passages that answer it. content_scope=\"full\" returns the whole page text, not just the main content. force_browser renders it in a browser (3 credits instead of 1); render=\"auto\" does that only for a JavaScript shell. Returns data.title, data.content_markdown, data.published_at/modified_at when the page gives them, data.fetched_at and content_status (ok, thin, blocked, needs_javascript, not_found); fields: https://clawifi.dev/docs/fetch.",
      "inputSchema": {
        "properties": {
          "url": {
            "title": "Url",
            "type": "string"
          },
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Query"
          },
          "top_k": {
            "default": 5,
            "title": "Top K",
            "type": "integer"
          },
          "timeout_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Timeout Seconds"
          },
          "force_browser": {
            "default": false,
            "title": "Force Browser",
            "type": "boolean"
          },
          "max_pages": {
            "default": 50,
            "title": "Max Pages",
            "type": "integer"
          },
          "target_selector": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Target Selector"
          },
          "content_scope": {
            "default": "main",
            "title": "Content Scope",
            "type": "string"
          },
          "render": {
            "default": "never",
            "title": "Render",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "fetch_urlArguments",
        "type": "object"
      }
    },
    {
      "name": "scrape_url",
      "description": "Scrape a URL into LLM-ready formats (markdown, text, links, metadata, html, screenshot, state_json). query keeps only the top_k passages of markdown and text that answer it. Returns formats.<name>, metadata (title, final_url, canonical_url, excerpt), published_at/modified_at and content_status.",
      "inputSchema": {
        "properties": {
          "url": {
            "title": "Url",
            "type": "string"
          },
          "formats": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Formats"
          },
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Query"
          },
          "top_k": {
            "default": 5,
            "title": "Top K",
            "type": "integer"
          },
          "mode": {
            "default": "auto",
            "title": "Mode",
            "type": "string"
          },
          "timeout_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Timeout Seconds"
          },
          "target_selector": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Target Selector"
          }
        },
        "required": [
          "url"
        ],
        "title": "scrape_urlArguments",
        "type": "object"
      }
    },
