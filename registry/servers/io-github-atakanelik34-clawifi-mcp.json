    {
      "name": "search_free",
      "description": "Search the web and return ranked results: url, title, snippet, rank, and published_at when the engine gives a date. No page text; read a result with fetch_url. Fields: https://clawifi.dev/docs/search.",
      "inputSchema": {
        "properties": {
          "query": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "max_results": {
            "default": 10,
            "title": "Max Results",
            "type": "integer"
          },
          "include_domains": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Include Domains"
          },
          "time_range": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Time Range"
          }
        },
        "required": [
          "query"
        ],
        "title": "search_freeArguments",
        "type": "object"
      }
    },
