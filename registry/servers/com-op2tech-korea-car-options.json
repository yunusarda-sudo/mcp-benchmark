{
  "$schema": "../schema.json",
  "name": "com.op2tech/korea-car-options",
  "title": "OptionTech — Korean car trims & options",
  "category": "E-Commerce & Retail",
  "description": "Korean new-car trim prices and options from official price lists, with as-of dates and sources.",
  "tools": [
    {
      "name": "search_cars",
      "description": "이름·별칭·제조사로 국내 판매 차종을 찾는다. 다른 도구의 car 인자에 쓸 slug 를 준다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "예: 쏘렌토, 기아 SUV, ev6"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_car",
      "description": "차종 하나의 트림별 기본가(원)·연료·기본/선택 품목 수·가격표 기준일·원문 PDF.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "car": {
            "type": "string",
            "description": "slug 또는 차종 이름"
          }
        },
        "required": [
          "car"
        ]
      }
    },
    {
      "name": "find_option",
      "description": "제조사마다 다르게 부르는 옵션 이름을 하나의 정규 개념으로 푼다(예: 현대 「2열 파워 윈도우」 = 기아 「뒷좌석 파워 윈도우」).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "옵션 이름(아무 제조사 표기)"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "option_in_car",
      "description": "차종 하나에서 그 옵션이 트림마다 STD(기본) · OPT(단독 선택, 만원) · PKG(패키지를 사야 함, 패키지 값 만원) · NONE(가격표에 없음) 중 무엇인지, 기본으로 들어가는 가장 싼 트림.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "car": {
            "type": "string"
          },
          "option": {
            "type": "string",
            "description": "옵션 이름 또는 find_option 의 id"
          }
        },
        "required": [
          "car",
          "option"
        ]
      }
    },
    {
      "name": "compare_option",
      "description": "차종 최대 5개에서 그 옵션이 기본으로 들어가는 가장 싼 트림과 가격을 견준다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cars": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 5
          },
          "option": {
            "type": "string"
          }
        },
        "required": [
          "cars",
          "option"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.op2tech/korea-car-options",
    "version": "1.0.0",
    "remoteUrl": "https://op2tech.com/api/mcp",
    "publishedAt": "2026-11-27T09:39:37.702777Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "05a6cc3f2bc54081c9fe7bd3b65a388657a5d5ee1c4e4dcaeb59ff06f52f319a"
  }
}
