    {
      "name": "get_zip_release",
      "description": "Get metadata for the forthcoming versioned downloadable ZIP products (different from the legacy JSON evaluation artifacts). Shows exact digest, price, status and checkout page. No payment is initiated.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "enum": [
              "brief-check",
              "qa-web",
              "tender-kit",
              "pro-suite"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
