{
  "$schema": "../schema.json",
  "name": "io.github.lonniev/tollbooth-shortlinks",
  "title": "Tollbooth Shortlinks",
  "category": "Developer Tools & DevOps",
  "description": "Ephemeral, human-friendly short URLs for Tollbooth MCP services",
  "repository": "https://github.com/lonniev/tollbooth-shortlinks",
  "tools": [
    {
      "name": "create_shortlink",
      "description": "Create an ephemeral short URL that expires after 24 hours.",
      "inputSchema": {
        "properties": {
          "url": {
            "type": "string",
            "description": "The target URL to redirect to."
          },
          "slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional custom slug. If omitted, a memorable phrase is generated\n  (e.g. ``brave-otter-finds-gold``)."
          }
        },
        "required": [
          "url"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "resolve_shortlink",
      "description": "Look up where a slug points without redirecting.",
      "inputSchema": {
        "properties": {
          "slug": {
            "type": "string",
            "description": "The shortlink slug to resolve."
          }
        },
        "required": [
          "slug"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "delete_shortlink",
      "description": "Delete a shortlink before it expires.",
      "inputSchema": {
        "properties": {
          "slug": {
            "type": "string",
            "description": "The shortlink slug to delete."
          }
        },
        "required": [
          "slug"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "shortlink_status",
      "description": "Health check — shows the number of active shortlinks and TTL.",
      "inputSchema": {
        "properties": {},
        "type": "object",
        "additionalProperties": false
      }
    }
  ],
  "source": {
