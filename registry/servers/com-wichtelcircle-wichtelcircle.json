{
  "$schema": "../schema.json",
  "name": "com.wichtelcircle/wichtelcircle",
  "title": "WichtelCircle: Secret Santa draws",
  "category": "Developer Tools & DevOps",
  "description": "Set up a Secret Santa group, add people and exclusions, draw names, get private links. Free.",
  "tools": [
    {
      "name": "create_group",
      "description": "Create a Secret Santa (Wichteln) group with its participants. Returns organizer_link (give it to the organizer, it is their private admin page) and group_token for the other tools. Sends no e-mail to participants.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "description": "Group name, e.g. 'Family Christmas 2026'"
          },
          "organizer_name": {
            "type": "string",
            "maxLength": 80
          },
          "organizer_email": {
            "type": "string",
            "description": "Optional. Gets one mail to confirm the address."
          },
          "organizer_participates": {
            "type": "boolean",
            "default": true
          },
          "participants": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              ]
            },
            "maxItems": 500,
            "description": "Everyone else who takes part: names, optionally with e-mail"
          },
          "budget_amount": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "description": "e.g. CHF, EUR, USD, GBP"
          },
          "exchange_date": {
            "type": "string",
            "description": "YYYY-MM-DD, the day presents are exchanged"
          },
          "no_reciprocal_pairs": {
            "type": "boolean",
            "description": "Nobody draws the person who draws them"
          },
          "locale": {
            "type": "string",
            "enum": [
              "de",
              "en"
            ],
            "default": "en",
            "description": "Language of the pages"
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "location": {
            "type": "string",
            "maxLength": 160
          }
        },
        "required": [
          "name",
          "organizer_name"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_group",
      "description": "Participants, exclusions, whether the draw can work (and why not), and the status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "group_token": {
            "type": "string",
            "description": "group_token from create_group (the part after /o/ in the organizer link)"
          }
        },
        "required": [
          "group_token"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "add_participants",
      "description": "Add people to a group that is not drawn yet.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "group_token": {
            "type": "string",
            "description": "group_token from create_group (the part after /o/ in the organizer link)"
          },
          "participants": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              ]
            },
            "maxItems": 500
          }
        },
        "required": [
          "group_token",
          "participants"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "add_exclusion",
      "description": "E.g. couples: neither draws the other. Use the exact names from get_group.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "group_token": {
            "type": "string",
            "description": "group_token from create_group (the part after /o/ in the organizer link)"
          },
          "person_a": {
            "type": "string"
          },
          "person_b": {
            "type": "string"
          }
        },
        "required": [
          "group_token",
          "person_a",
          "person_b"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "draw",
      "description": "Draw who gives a present to whom, following the exclusions. Nobody, including you, sees the result: each person sees only their own match through their private link (get_links).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "group_token": {
            "type": "string",
            "description": "group_token from create_group (the part after /o/ in the organizer link)"
          }
        },
        "required": [
          "group_token"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_links",
      "description": "After the draw: one private link per person to pass on. Do not open them yourself.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "group_token": {
            "type": "string",
            "description": "group_token from create_group (the part after /o/ in the organizer link)"
          }
        },
        "required": [
          "group_token"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.wichtelcircle/wichtelcircle",
    "version": "1.0.1",
    "remoteUrl": "https://wichtelcircle.com/mcp",
    "publishedAt": "2026-11-23T11:35:12.463203Z",
    "fetchedAt": "2026-11-24T12:15:48.059Z",
    "toolsSha256": "7158d8180037902f3b8dbe22cfc1f381df3d4750f50819750a24bd29759d6255"
  }
}
