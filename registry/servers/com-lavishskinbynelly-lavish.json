{
  "$schema": "../schema.json",
  "name": "com.lavishskinbynelly/lavish",
  "title": "Lavish Skin by Nelly",
  "category": "E-Commerce & Retail",
  "description": "Services, prices, FAQ and booking links of Lavish Skin by Nelly, a skin care spa in Mahopac, NY.",
  "tools": [
    {
      "name": "get_business_info",
      "description": "Name, address, phone, hours, map link, license line, new client offer and policies of Lavish Skin by Nelly.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "list_services",
      "description": "Services with their options, length, price, page and booking link. Filter by category, highest price or longest length.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "Skincare Services",
              "Facials",
              "Add-On Any service"
            ]
          },
          "max_price": {
            "type": "number",
            "minimum": 0
          },
          "max_minutes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_service",
      "description": "One service: summary, options, FAQ, who it may not suit under the spa's terms, and its booking link.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "acne-facial",
              "argireline-facial",
              "cold-treatment",
              "dermaplaning",
              "express-d-tox",
              "express-facial",
              "hydro-luxx",
              "hydrojelly-mask",
              "led-anti-aging",
              "led-light",
              "microcurrent",
              "oxygen-infusion",
              "signature-ultrasonic"
            ]
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_faq",
      "description": "Questions and answers from the site that match the words of a query, each with its source page.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_booking_link",
      "description": "The Square booking links for a service, or the free consultation link if no service is given. The person books on Square themselves; this server cannot book.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "service_id": {
            "type": "string",
            "enum": [
              "acne-facial",
              "argireline-facial",
              "cold-treatment",
              "dermaplaning",
              "express-d-tox",
              "express-facial",
              "hydro-luxx",
              "hydrojelly-mask",
              "led-anti-aging",
              "led-light",
              "microcurrent",
              "oxygen-infusion",
              "signature-ultrasonic"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.lavishskinbynelly/lavish",
    "version": "1.1.0",
    "remoteUrl": "https://lavishskinbynelly.com/mcp",
    "publishedAt": "2026-11-26T02:45:02.143883Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "b962e2f4fa1a0546bdc8f6e888282a46451f3ebccab63494b92f61dcdf78597e"
  }
}
