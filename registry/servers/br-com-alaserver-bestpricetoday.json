{
  "$schema": "../schema.json",
  "name": "br.com.alaserver/bestpricetoday",
  "title": "BestPriceToday Deals (x402)",
  "category": "E-Commerce & Retail",
  "description": "Paid Brazilian marketplace deals & product data via x402 (USDC per call).",
  "repository": "https://github.com/aletubegames/bestpricetoday",
  "tools": [
    {
      "name": "deals_sample",
      "description": "Free tool: 3 real deals from today's catalog, no payment required. Use to test your MCP integration, then upgrade to the paid tools (deals_search/feed/top/history) for full results.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "deals_search",
      "description": "Multi-marketplace product search: Mercado Livre daily catalog plus live AliExpress and Shopee. $0.001 USDC per call.",
      "inputSchema": {
        "type": "object",
        "required": [
          "q"
        ],
        "properties": {
          "q": {
            "type": "string",
            "description": "Search query"
          },
          "marketplace": {
            "type": "string",
            "enum": [
              "all",
              "ml",
              "aliexpress",
              "shopee"
            ],
            "default": "all"
          },
          "limit": {
            "type": "integer",
            "default": 20
          },
          "x_payment": {
            "type": "string",
            "description": "PAYMENT-SIGNATURE value after paying the returned quote"
          }
        }
      }
    },
    {
      "name": "deals_feed",
      "description": "Daily-refreshed Brazilian deals catalog with optional filters. Up to 100 items. $0.01 USDC per call.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "min_price": {
            "type": "number"
          },
          "max_price": {
            "type": "number"
          },
          "limit": {
            "type": "integer",
            "default": 50
          },
          "x_payment": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "deals_top",
      "description": "Products ranked by discount vs their price history max. $0.01 USDC per call.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "default": 20
          },
          "x_payment": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "deal_history",
      "description": "Full recorded price series for a product by its ml_code. $0.01 USDC per call.",
      "inputSchema": {
        "type": "object",
        "required": [
          "ml_code"
        ],
        "properties": {
          "ml_code": {
            "type": "string"
          },
          "x_payment": {
            "type": "string"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "br.com.alaserver/bestpricetoday",
    "version": "1.0.0",
    "remoteUrl": "https://api.alaserver.com.br/mcp",
    "publishedAt": "2026-11-25T23:53:58.511867Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "ae471476b29adbd1dcf5f5a797522cdcfbbace34713f217e9fa7e947db826d80"
  }
}
