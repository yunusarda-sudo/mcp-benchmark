{
  "$schema": "../schema.json",
  "name": "app.coinspay/docs",
  "title": "CoinsPay API Docs",
  "category": "Finance, Crypto & Web3",
  "description": "Search and read the CoinsPay crypto payments API docs: invoices, payouts, webhooks and test mode.",
  "tools": [
    {
      "name": "search_docs",
      "description": "Full-text search over the CoinsPay API docs: guides, methods, webhook events and objects. Returns the best matching parts with the section to read in full with get_doc.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "What to look for, e.g. \"verify webhook signature\" or \"POST /invoices\"."
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "ru"
            ],
            "description": "Language of the docs; by default Russian for a query in Cyrillic, otherwise English."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5,
            "description": "How many results to return."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_docs",
      "description": "The table of contents: every section of the CoinsPay API docs with a one-line summary, plus the key facts (API address, auth, test keys, webhooks).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "ru"
            ],
            "description": "Language of the docs: \"en\" (default) or \"ru\"."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_doc",
      "description": "One section of the CoinsPay API docs in Markdown: a guide, a group of methods with parameters, fields and errors, the webhook events or the objects.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string",
            "enum": [
              "quickstart",
              "sdk",
              "mcp",
              "api-key",
              "test-mode",
              "formats",
              "errors",
              "idempotency",
              "pagination",
              "limits",
              "webhooks",
              "states",
              "invoices",
              "addresses",
              "deposits",
              "payouts",
              "shop",
              "chains",
              "events",
              "objects"
            ],
            "description": "Section id from list_docs or search_docs."
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "ru"
            ],
            "description": "Language of the docs: \"en\" (default) or \"ru\"."
          }
        },
        "required": [
          "section"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "app.coinspay/docs",
    "version": "1.0.0",
    "remoteUrl": "https://coinspay.app/mcp",
    "publishedAt": "2026-11-24T17:11:52.590647Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "e341b7c79eae76db80b880f4e814861c56b472280ac41b8076103e116e433a7b"
  }
}
