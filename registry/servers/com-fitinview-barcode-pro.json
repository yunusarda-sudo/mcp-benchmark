{
  "$schema": "../schema.json",
  "name": "com.fitinview/barcode-pro",
  "title": "Barcode Pro: barcodes and QR codes",
  "category": "Design, UI & 3D Media",
  "description": "Make print-ready EAN-13, UPC, ITF-14, Code 128, Code 39 and QR codes as SVG and PNG. Free.",
  "tools": [
    {
      "name": "generate_barcode",
      "description": "Draw a barcode or QR code and return it as SVG (for print) and as a PNG preview. format: EAN13, EAN8, UPC (UPC-A), ITF14, CODE128, CODE39 or QR. value: the digits or text (QR: any text or URL up to 256 characters). Colours as #rrggbb; keep the bars dark on a light background so scanners can read it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "EAN13",
              "EAN8",
              "UPC",
              "ITF14",
              "CODE128",
              "CODE39",
              "QR"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "fg": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "default": "#0a0a0b",
            "description": "Bar colour"
          },
          "bg": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "default": "#ffffff",
            "description": "Background colour"
          },
          "height": {
            "type": "integer",
            "minimum": 40,
            "maximum": 200,
            "default": 100,
            "description": "Bar height (1D barcodes)"
          },
          "text": {
            "type": "boolean",
            "default": true,
            "description": "Print the number under 1D barcodes"
          },
          "png_width": {
            "type": "integer",
            "minimum": 200,
            "maximum": 2000,
            "default": 600,
            "description": "Width of the PNG preview in pixels"
          }
        },
        "required": [
          "format",
          "value"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "check_barcode_number",
      "description": "For EAN13, EAN8, UPC or ITF14: give the full number to check its check digit, or the number without the last digit to get the check digit and the full number.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "EAN13",
              "EAN8",
              "UPC",
              "ITF14"
            ]
          },
          "number": {
            "type": "string",
            "pattern": "^[0-9 -]+$"
          }
        },
        "required": [
          "format",
          "number"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.fitinview/barcode-pro",
    "version": "1.0.1",
    "remoteUrl": "https://barcode.fitinview.com/mcp",
    "publishedAt": "2026-11-23T11:35:11.130443Z",
    "fetchedAt": "2026-11-24T12:15:48.059Z",
    "toolsSha256": "43b6b7175b54f5a4423dd9ddc307c651185ad8dfa4607948100cd00e69bad95d"
  }
}
