{
  "$schema": "../schema.json",
  "name": "com.qadiva/agent-door",
  "title": "Qadiva — wholesale glassware (UAE & GCC)",
  "category": "Other",
  "description": "Wholesale glassware for hotels and restaurants (UAE & GCC): pieces, dimensions, quote requests.",
  "tools": [
    {
      "name": "list_glassware",
      "description": "List Qadiva's core wholesale glassware for hotels, restaurants, caterers and distributors in the UAE/GCC — goblets, tumblers, highballs, jugs and storage jars — with capacity (ml and oz), height, rim and base diameter, weight, typical use and PDF spec sheet. Optional filters: text, category (Stemware, Tumblers, Serveware), capacity range in ml. No prices.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "Stemware",
              "Tumblers",
              "Serveware"
            ]
          },
          "min_ml": {
            "type": "number"
          },
          "max_ml": {
            "type": "number"
          }
        }
      }
    },
    {
      "name": "get_piece",
      "description": "Detail of one reference (L3721, L6011, W15236, C1134, CH012, C2338, YZ02, MF1300ST).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "ref"
        ]
      }
    },
    {
      "name": "get_terms",
      "description": "Who Qadiva sells to, markets, how quotes work, samples, logo decoration, shipping and what is not offered today.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "request_quote",
      "description": "Send a quote request to Qadiva for a business buyer (hotel, restaurant, caterer, distributor or retailer): references or descriptions with quantities, optional samples and logo decoration. It reaches the same inbox as the website form; Qadiva replies by e-mail with a written quote per piece in AED or USD. It registers the buyer's contact details with Qadiva.",
      "inputSchema": {
        "type": "object",
        "required": [
          "buyer",
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "buyer": {
            "type": "object",
            "required": [
              "name",
              "company",
              "business",
              "country",
              "email"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "company": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "phone": {
                "type": "string"
              },
              "business": {
                "type": "string",
                "enum": [
                  "Hotel or resort",
                  "Restaurant or café",
                  "Catering or events",
                  "Distributor or wholesaler",
                  "Retailer or online store",
                  "Other"
                ]
              },
              "country": {
                "type": "string",
                "description": "Destination country (UAE or GCC)"
              }
            }
          },
          "samples": {
            "type": "boolean"
          },
          "logo_decoration": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "agent": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "platform": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
