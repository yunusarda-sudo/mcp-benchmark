{
  "$schema": "../schema.json",
  "name": "io.github.yashwant938/arch-guard-mc",
  "title": "ArchGuard MCP",
  "category": "Databases & Storage",
  "description": "Architecture drift auditor (Tarjan SCC), zero-downtime SQL guardian & distributed-systems math.",
  "repository": "https://github.com/yashwant938/arch-guard-mc",
  "tools": [
    {
      "name": "audit_code_snippet",
      "description": "Audit source files for circular dependencies (Tarjan SCC), coupling metrics (Ca/Ce/I), and 12 production reliability/security/SOLID anti-patterns (N+1 loops, missing HTTP timeouts, unbounded caches, check-then-act races, missing idempotency keys, SQL/command injection). Returns health score + Mermaid graph.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "content"
              ]
            },
            "minItems": 1
          },
          "maxFileLines": {
            "type": "integer"
          }
        },
        "required": [
          "files"
        ]
      }
    },
    {
      "name": "check_migration_safety",
      "description": "Audit PostgreSQL/MySQL/SQLite DDL migrations for production table locks and rolling-deploy breaks, generating a 3-phase Expand-Contract plan.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string"
          },
          "dialect": {
            "type": "string",
            "enum": [
              "postgres",
              "mysql",
              "sqlite"
            ]
          }
        },
        "required": [
          "sql"
        ]
      }
    },
    {
      "name": "estimate_system_capacity",
      "description": "Compute exact distributed systems capacity math: avg/peak QPS, storage, bandwidth Gbps, Redis RAM, shard count & bottleneck, Little's Law concurrency. Supports Big Tech presets or custom inputs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "preset": {
            "type": "string",
            "enum": [
              "tinyurl",
              "twitter",
              "whatsapp",
              "uber",
              "youtube",
              "stripe"
            ]
          },
          "dau": {
            "type": "number"
          },
          "writesPerUserPerDay": {
            "type": "number"
          },
          "readWriteRatio": {
            "type": "number"
          },
          "avgWriteBytes": {
            "type": "number"
          },
          "avgReadBytes": {
            "type": "number"
          },
          "mediaBytesPerWrite": {
            "type": "number"
          },
          "retentionYears": {
            "type": "number"
          },
          "replicationFactor": {
            "type": "number"
          },
          "peakMultiplier": {
            "type": "number"
          },
          "cacheHitRatio": {
            "type": "number"
          },
          "avgLatencyMs": {
            "type": "number"
          }
        }
      }
    },
    {
      "name": "simulate_quorum_and_tail_latency",
      "description": "Verify Dynamo quorum (W+R>N), Raft fault tolerance, and Jeff Dean fanout tail-latency amplification (1-(1-p)^K) with hedged RPC comparison.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "replicationFactor": {
            "type": "integer"
          },
          "writeQuorum": {
            "type": "integer"
          },
          "readQuorum": {
            "type": "integer"
          },
          "fanoutCount": {
            "type": "integer"
          },
          "singleNodeSlowProbability": {
            "type": "number"
          },
          "singleNodeP50Ms": {
            "type": "number"
          },
          "singleNodeP99Ms": {
            "type": "number"
          }
        }
      }
    },
    {
      "name": "simulate_consistent_hashing",
      "description": "Run deterministic FNV-1a+fmix32 consistent hashing ring simulation measuring load skew & scale-out key remapping % vs modulo hashing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "nodeCount": {
            "type": "integer"
          },
          "virtualNodes": {
            "type": "integer"
          },
          "sampleKeys": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "recommend_architecture",
      "description": "Generate a Staff-level distributed system architecture blueprint from workload traits (consistency, R/W ratio, contention, real-time need, latency SLO).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "consistency": {
            "type": "string",
            "enum": [
              "strong",
              "eventual"
            ]
          },
          "readWriteProfile": {
            "type": "string",
            "enum": [
              "read-heavy",
              "write-heavy",
              "balanced"
            ]
          },
          "scaleTier": {
            "type": "string",
            "enum": [
              "startup",
              "high",
              "global"
            ]
          },
          "dataModel": {
            "type": "string",
            "enum": [
              "relational",
              "document",
              "timeseries",
              "search",
              "graph"
            ]
          },
          "contentionLevel": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "extreme"
            ]
          },
          "realtimeNeed": {
            "type": "string",
            "enum": [
              "none",
              "one-way",
              "bidirectional",
              "media"
            ]
          },
          "latencySloMs": {
            "type": "number"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
