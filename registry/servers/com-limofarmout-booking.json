          },
          "vehicle_type": {
            "type": "string",
            "enum": [
              "sedan",
              "luxury_sedan",
              "suv",
              "luxury_suv",
              "minivan",
              "sprinter",
              "stretch_limo",
              "stretch_suv",
              "party_bus",
              "minibus",
              "coach",
              "jet_sprinter",
              "maybach",
              "rolls_royce",
              "classic_car",
              "other"
            ]
          },
          "pickup_local": {
            "type": "string",
            "description": "Pickup in local time, YYYY-MM-DDTHH:MM (no time zone)."
          },
          "timezone": {
            "type": "string",
            "description": "IANA time zone, e.g. America/Toronto."
          },
          "pickup_address": {
            "type": "string"
          },
          "dropoff_address": {
            "type": "string"
          },
          "hours": {
            "type": "number",
            "description": "For hourly services."
          },
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2, e.g. CA, US, GB, AE."
          },
          "payout": {
            "type": "number",
            "description": "What the chauffeur is paid, all in, in the currency's main unit. Optional on quotes."
          },
          "airport_fee": {
            "type": "number"
          },
          "passengers": {
            "type": "integer"
          },
          "luggage": {
            "type": "integer"
          },
          "passenger_name": {
            "type": "string"
          },
          "passenger_phone": {
            "type": "string",
            "description": "International format; reached through a private line, never shown to the driver."
          },
          "flight_number": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "order_ref": {
            "type": "string",
            "description": "Your own order reference (idempotency key)."
          },
          "pay_by": {
            "type": "string",
            "enum": [
              "limofarmout",
              "card"
            ],
            "description": "Only for a LimoFarmOut company account: its bookings are paid by LimoFarmOut after the trip (nothing charged now). Send 'card' to pay by card instead."
          }
        }
      }
    },
    {
      "name": "get_booking",
      "description": "One job with its status, driver, vehicle, plate and timeline once accepted.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "list_bookings",
      "description": "The account's jobs, newest first. Optional status filter, e.g. OPEN, ACCEPTED, COMPLETED, CANCELLED.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "cancel_booking",
      "description": "Cancel a job. The website's cancellation terms apply: once a job is published the platform fee is kept. Confirm with the user before calling.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    }
