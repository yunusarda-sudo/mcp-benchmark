{
  "$schema": "../schema.json",
  "name": "com.limofarmout/booking",
  "title": "LimoFarmOut",
  "category": "Travel, Maps & Navigation",
  "description": "Quote and book chauffeured trips through the LimoFarmOut operator network; check or cancel them.",
  "tools": [
    {
      "name": "quote_trip",
      "description": "Price a trip without booking it: the driver payout (given, or our local rate), the platform fee, the total the dispatcher pays (tax included) and, when addresses and time are given, the client price a passenger would pay. Nothing is saved.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The trip in plain words, e.g. \"Tomorrow 9:00 am, YYZ to Fairmont Royal York, SUV, $130\". Fields below win over what is read from the text."
          },
          "service_type": {
            "type": "string",
            "enum": [
              "transfer",
              "airport_pickup",
              "airport_dropoff",
              "cruise_port",
              "train_station",
              "long_distance",
              "hourly",
              "wedding",
              "prom",
              "corporate",
              "event",
              "night_out",
              "tour",
              "funeral"
            ]
          },
          "vehicle_type": {
            "type": "string",
            "enum": [
              "sedan",
              "luxury_sedan",
              "suv",
              "luxury_suv",
              "minivan",
              "sprinter",
              "stretch_limo",
              "stretch_suv",
              "party_bus",
              "minibus",
              "coach",
              "jet_sprinter",
              "maybach",
              "rolls_royce",
              "classic_car",
              "other"
            ]
          },
          "pickup_local": {
            "type": "string",
            "description": "Pickup in local time, YYYY-MM-DDTHH:MM (no time zone)."
          },
          "timezone": {
            "type": "string",
            "description": "IANA time zone, e.g. America/Toronto."
          },
          "pickup_address": {
            "type": "string"
          },
          "dropoff_address": {
            "type": "string"
          },
          "hours": {
            "type": "number",
            "description": "For hourly services."
          },
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2, e.g. CA, US, GB, AE."
          },
          "payout": {
            "type": "number",
            "description": "What the chauffeur is paid, all in, in the currency's main unit. Optional on quotes."
          },
          "airport_fee": {
            "type": "number"
          },
          "passengers": {
            "type": "integer"
          },
          "luggage": {
            "type": "integer"
          },
          "passenger_name": {
            "type": "string"
          },
          "passenger_phone": {
            "type": "string",
            "description": "International format; reached through a private line, never shown to the driver."
          },
          "flight_number": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "book_trip",
      "description": "Book a prepaid job for verified chauffeurs. Within the agent key's limits and with a saved card it is paid and published at once; otherwise it waits for the account holder (waiting_for says why, pay_url is their link). Always confirm the trip details and the total with the user before calling. order_ref makes it safe to retry: the same order_ref never books twice.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The trip in plain words, e.g. \"Tomorrow 9:00 am, YYZ to Fairmont Royal York, SUV, $130\". Fields below win over what is read from the text."
          },
          "service_type": {
            "type": "string",
            "enum": [
              "transfer",
              "airport_pickup",
