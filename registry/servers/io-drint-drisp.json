          "screenshot_url": {
            "type": "string",
            "description": "A public https link to the screenshot (PNG, JPEG or WebP)."
          },
          "screenshot_base64": {
            "type": "string",
            "description": "The screenshot itself, base64 (a data: URL is fine)."
          },
          "frame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "Frame colour: 0 the device's own (default), 1 the other of black / silver, 2 champagne gold, 3 midnight blue."
          },
          "background": {
            "type": "string",
            "description": "\"transparent\" for a cut-out PNG, or a colour like \"#ffffff\". Leave it out for a soft studio grey."
          },
          "size": {
            "type": "integer",
            "enum": [
              512,
              1024,
              1536,
              2048
            ],
            "description": "The square PNG's side in pixels (default 1024). 1536 and 2048 need a signed-in Drisp Pro account."
          },
          "clean": {
            "type": "boolean",
            "description": "true for a picture without the watermark grid. Needs a signed-in Drisp Pro account; a Pro account gets clean pictures anyway."
