  "name": "io.drint/drisp",
  "title": "Drisp",
  "category": "Design, UI & 3D Media",
  "description": "Put an app or website screenshot on a 3D device mockup (iPhone, iPad, MacBook, watch) as a PNG.",
  "repository": "https://github.com/drint-io/drisp-mcp",
  "tools": [
    {
      "name": "list_devices",
      "description": "The devices Drisp can put a screenshot on, each with the screenshot size in pixels that fills its screen exactly (portrait for phones, tablets and watches) and its page on drint.io.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "device_mockup",
      "description": "Put a screenshot of an app or website on a device mockup and get a PNG. The screenshot fills the screen edge to edge (cropped to the screen's shape if its proportions differ). Give the screenshot as screenshot_url (a public https link) or screenshot_base64 (PNG, JPEG or WebP, at most 10 MB).",
