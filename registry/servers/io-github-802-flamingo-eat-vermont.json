{
  "$schema": "../schema.json",
  "name": "io.github.802-Flamingo/eat-vermont",
  "title": "Eat Vermont",
  "category": "Developer Tools & DevOps",
  "description": "Vermont places to eat, farms, markets, food events and food trails from Eat Vermont. Read-only.",
  "tools": [
    {
      "name": "search_places",
      "description": "Find restaurants, cafes, bakeries, breweries, farms, farm stands, farmers markets and\nother food and drink places in Vermont, from Eat Vermont's reviewed directory. Filter by\nwords, town, kind of place, distance from a point, open right now, or Insider perks.\nWith `near`, results are nearest first and carry distance_km. Each result has a `url`\non eatvermont.com to share with the user. Use get_place for hours, address, website\nand upcoming events.",
      "inputSchema": {
        "properties": {
          "q": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Words to look for, e.g. 'maple creemee' or 'wood-fired pizza'.",
            "title": "Q"
          },
          "town": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Exact Vermont town name, e.g. 'Stowe'. See catalog_info for the list.",
            "title": "Town"
          },
          "type": {
            "anyOf": [
              {
                "enum": [
                  "business",
                  "landmark",
                  "farmers_market",
                  "chamber",
                  "festival"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Kind of listing. Most places are 'business'.",
            "title": "Type"
          },
          "subtype": {
            "anyOf": [
              {
                "maxLength": 40,
                "pattern": "^[a-z0-9_]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Kind of business, e.g. bakery, brewery, farm. See catalog_info.",
            "title": "Subtype"
          },
          "amenity": {
            "anyOf": [
              {
                "maxLength": 40,
                "pattern": "^[a-z0-9_]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "e.g. outdoor_seating. See catalog_info.",
            "title": "Amenity"
          },
          "near": {
            "anyOf": [
              {
                "maxLength": 40,
                "pattern": "^\\s*-?[0-9.]+\\s*,\\s*-?[0-9.]+\\s*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Search around a point, as 'lat,lng', e.g. '44.4759,-73.2121' (Burlington).",
            "title": "Near"
          },
          "radius_km": {
            "default": 25,
            "description": "With `near`: how far to look, in km (1-100).",
            "maximum": 100,
            "minimum": 1,
            "title": "Radius Km",
            "type": "number"
          },
          "open_now": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "true: only places open right now (Vermont time).",
            "title": "Open Now"
          },
          "has_perks": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "true: only places with an Eat Vermont Insider perk.",
            "title": "Has Perks"
          },
          "limit": {
            "default": 20,
            "description": "How many results (1-50).",
            "maximum": 50,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "description": "Skip this many results (use meta.next_offset).",
            "maximum": 5000,
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          }
        },
        "type": "object",
        "title": "search_placesArguments"
      }
    },
    {
      "name": "get_place",
      "description": "Full details of one place found with search_places: opening hours (Vermont time),\nstreet address, website and social links, amenities, season (for farmers markets),\nupcoming events there, and the food trails it is on. Includes its eatvermont.com `url`.",
      "inputSchema": {
        "properties": {
          "slug": {
            "description": "The `slug` from a search result.",
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9-]{1,78}[a-z0-9]$",
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "slug"
        ],
        "type": "object",
        "title": "get_placeArguments"
      }
    },
    {
      "name": "search_events",
      "description": "Upcoming food and drink events in Vermont (dinners, tastings, markets, festivals, live\nmusic at food venues), soonest first. Only today and later. Filter by date range, words,\ntown, category or distance from a point. Each result lists its upcoming dates and an\neatvermont.com `url`. Use get_event for the full description and address.",
      "inputSchema": {
        "properties": {
          "from_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "First day, YYYY-MM-DD. Default: today (Vermont time).",
            "title": "From Date"
          },
          "to_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Last day, YYYY-MM-DD. Default: 14 days after from_date. At most 62 days after it.",
            "title": "To Date"
          },
          "q": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Words to look for, e.g. 'maple creemee' or 'wood-fired pizza'.",
            "title": "Q"
          },
          "town": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Exact Vermont town name, e.g. 'Stowe'. See catalog_info for the list.",
            "title": "Town"
          },
          "category": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "e.g. Music, Market. See catalog_info.",
            "title": "Category"
          },
          "near": {
            "anyOf": [
              {
                "maxLength": 40,
                "pattern": "^\\s*-?[0-9.]+\\s*,\\s*-?[0-9.]+\\s*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Search around a point, as 'lat,lng', e.g. '44.4759,-73.2121' (Burlington).",
            "title": "Near"
          },
          "radius_km": {
            "default": 25,
            "description": "With `near`: how far to look, in km (1-100).",
            "maximum": 100,
            "minimum": 1,
            "title": "Radius Km",
            "type": "number"
          },
          "limit": {
            "default": 20,
            "description": "How many results (1-50).",
            "maximum": 50,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "description": "Skip this many results (use meta.next_offset).",
            "maximum": 5000,
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          }
        },
        "type": "object",
        "title": "search_eventsArguments"
      }
    },
    {
      "name": "get_event",
      "description": "Full details of one upcoming event found with search_events: all upcoming dates and\ntimes, venue and address, fee, host, a link for tickets or more information, and its\neatvermont.com `url`.",
      "inputSchema": {
        "properties": {
          "slug": {
            "description": "The `slug` from a search result.",
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9-]{1,78}[a-z0-9]$",
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "slug"
        ],
        "type": "object",
        "title": "get_eventArguments"
      }
    },
    {
      "name": "list_trails",
      "description": "Eat Vermont's food trails: themed routes of places to visit (for example creemee\nstands or breweries), with how many stops each has. Use get_trail for the stops.",
      "inputSchema": {
        "properties": {
          "category": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only trails in this category. See catalog_info.",
            "title": "Category"
          },
          "limit": {
            "default": 20,
            "description": "How many results (1-50).",
            "maximum": 50,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "description": "Skip this many results (use meta.next_offset).",
            "maximum": 5000,
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          }
        },
        "type": "object",
        "title": "list_trailsArguments"
      }
    },
    {
      "name": "get_trail",
      "description": "One food trail with its stops in order (each stop links to its place page), any\ncurrent challenge and reward, and its eatvermont.com `url`.",
      "inputSchema": {
        "properties": {
          "slug": {
            "description": "The `slug` from a search result.",
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9-]{1,78}[a-z0-9]$",
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "slug"
        ],
        "type": "object",
        "title": "get_trailArguments"
      }
    },
    {
      "name": "catalog_info",
      "description": "How many places, upcoming events and trails Eat Vermont lists, the exact values the\nfilters accept (towns, kinds of place, amenities, event and trail categories), and the\nterms of use. Call this to pick valid filter values.",
      "inputSchema": {
        "properties": {},
        "type": "object",
        "title": "catalog_infoArguments"
      }
    }
  ],
