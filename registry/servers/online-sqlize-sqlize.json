{
  "$schema": "../schema.json",
  "name": "online.sqlize/sqlize",
  "title": "sqlize.online",
  "category": "Databases & Storage",
  "description": "Run SQL on 30+ real database engines: MySQL, PostgreSQL, SQL Server, Oracle, SQLite and more.",
  "tools": [
    {
      "name": "list_databases",
      "description": "List every database engine and version sqlize.online can run SQL on, with the sql_version id to pass to other tools. Preloaded sample databases are marked and come with data; all others start empty.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "run_sql",
      "description": "Run a SQL script on a real database engine and return every result set and error. The database is fresh and empty (unless sql_version is a preloaded sample) and is dropped after the run, so include the CREATE TABLE and INSERT statements the queries need. Separate statements with semicolons. Results over 200 rows are cut. The answer links to the script on sqlize.online.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sql_version": {
            "type": "string",
            "enum": [
              "mariadb123",
              "mysql80",
              "mysql80_sakila",
              "mysql84",
              "mysql97",
              "mysql97_sakila",
              "mariadb114",
              "mariadb118",
              "mariadb118_university",
              "mariadb",
              "mariadb_sakila",
              "sqlite3",
              "sqlite3_data",
              "psql16",
              "psql17",
              "psql17postgis",
              "psql18",
              "psql18demo",
              "psql19",
              "mssql2017",
              "mssql2019",
              "mssql2022",
              "mssql2022aw",
              "mssql2025",
              "firebird4",
              "firebird4_employee",
              "firebird5",
              "rdb5",
              "rdb5_marketplace",
              "oracle21",
              "oracle23",
              "oracle23hr",
              "soqol",
              "clickhouse",
              "duckdb",
              "duckdb_data"
            ],
            "description": "Engine and version, from list_databases (e.g. psql18, mysql84, mssql2022)"
          },
          "code": {
            "type": "string",
            "description": "The SQL script: one or more statements"
          },
          "calculate_cost": {
            "type": "boolean",
            "description": "Also report the optimizer cost of each query, where the engine supports it",
            "default": false
          }
        },
        "required": [
          "sql_version",
          "code"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "describe_database",
      "description": "Show the tables, columns and foreign keys of a preloaded sample database, so queries against it can use the real names.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sql_version": {
            "type": "string",
            "enum": [
              "mysql80_sakila",
              "mysql97_sakila",
              "mariadb_sakila",
              "mariadb118_university",
              "sqlite3_data",
              "mssql2022aw",
              "firebird4_employee",
              "psql18demo",
              "psql17postgis",
              "oracle23hr",
              "duckdb_data",
              "rdb5_marketplace"
            ],
            "description": "A preloaded sample database, from list_databases"
          }
        },
        "required": [
          "sql_version"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "create_share_link",
      "description": "Save a SQL script on sqlize.online without running it and return a link where anyone can open, run and edit it. run_sql already returns such a link for the script it ran.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sql_version": {
            "type": "string",
            "enum": [
              "mariadb123",
              "mysql80",
              "mysql80_sakila",
              "mysql84",
              "mysql97",
              "mysql97_sakila",
              "mariadb114",
              "mariadb118",
              "mariadb118_university",
              "mariadb",
              "mariadb_sakila",
              "sqlite3",
              "sqlite3_data",
              "psql16",
              "psql17",
              "psql17postgis",
              "psql18",
              "psql18demo",
              "psql19",
              "mssql2017",
              "mssql2019",
              "mssql2022",
              "mssql2022aw",
              "mssql2025",
              "firebird4",
              "firebird4_employee",
              "firebird5",
              "rdb5",
              "rdb5_marketplace",
              "oracle21",
              "oracle23",
              "oracle23hr",
              "soqol",
              "clickhouse",
              "duckdb",
              "duckdb_data"
            ],
            "description": "Engine and version the link opens with, from list_databases"
          },
          "code": {
            "type": "string",
            "description": "The SQL script"
          }
        },
        "required": [
          "sql_version",
          "code"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
