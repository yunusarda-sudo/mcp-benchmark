{
  "$schema": "../schema.json",
  "name": "me.epi.hts/hts-lookup",
  "title": "HTS Lookup",
  "category": "Other",
  "description": "US tariff answers per paid call: exact HTS rates, landed cost, 301/232/AD-CVD with citations.",
  "repository": "https://github.com/HOIGO2025/hts-lookup-metadata",
  "tools": [
    {
      "name": "search_hts",
      "description": "Free search of the official USITC HTS text. Returns candidate codes and descriptions; rates are locked.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Product text or partial HTS code"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_hts_code",
      "description": "Paid exact HTS lookup. Returns description, MFN/special/other rates, units, and source. Requires x402 payment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "HTS code, e.g. 3304.10.00.00"
          }
        },
        "required": [
          "code"
        ]
      }
    },
    {
      "name": "estimate_duty",
      "description": "Paid MFN duty estimate for a customs value. Requires x402 payment. Does not include Section 301/AD-CVD.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "value_usd": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "code",
          "value_usd"
        ]
      }
    },
    {
      "name": "estimate_landed_cost",
      "description": "Paid landed-cost estimate: MFN duty, legacy Section 301 China, forced-labor 12.5%, Section 232 metals baseline, CBP MPF/HMF, freight, insurance, and other fees. AD/CVD cases are matched but rates are not auto-added. Excludes some exclusions and FTAs. Requires x402 payment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "HTS code, e.g. 6109.10.00"
          },
          "value_usd": {
            "type": "number",
            "minimum": 0,
            "description": "Goods value"
          },
          "freight_usd": {
            "type": "number",
            "minimum": 0
          },
          "insurance_usd": {
            "type": "number",
            "minimum": 0
          },
          "other_fees_usd": {
            "type": "number",
            "minimum": 0,
            "description": "Broker, handling, etc."
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Units, for per-unit cost"
          },
          "entry_type": {
            "type": "string",
            "enum": [
              "auto",
              "formal",
              "informal",
              "none"
            ]
          },
          "transport_mode": {
            "type": "string",
            "enum": [
              "ocean",
              "air",
              "other"
            ]
          },
          "origin_country": {
            "type": "string",
            "description": "ISO two-letter origin, for warnings"
          },
          "additional_duty_rate_percent": {
            "type": "number",
            "minimum": 0,
            "description": "Known extra duty rate, e.g. Section 232 or AD/CVD, applied to goods value"
          },
          "additional_duty_usd": {
            "type": "number",
            "minimum": 0,
            "description": "Known extra duty amount in USD"
          }
        },
        "required": [
          "code",
          "value_usd"
        ]
      }
    },
    {
      "name": "get_trade_actions",
      "description": "Paid combined lookup of legacy Section 301 China, forced-labor 12.5%, Section 232 metals, AD/CVD case matches, and IEEPA status. Includes citations. Requires x402 payment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "HTS code, e.g. 6109.10.00"
          },
          "origin_country": {
            "type": "string",
            "description": "ISO two-letter origin, e.g. CN"
          }
        },
        "required": [
          "code"
        ]
      }
    },
    {
      "name": "classify_product",
      "description": "Paid HTS classification candidates for a product description: ranked 8-digit lines with scores and Section 301/232/forced-labor flags. Candidates only, not a ruling. Requires x402 payment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Product description"
          },
          "origin_country": {
            "type": "string",
            "description": "ISO two-letter origin"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "estimate_landed_cost_batch",
      "description": "Paid batch landed-cost estimate for up to 200 rows in one call. Price is 0.003 USDC per row (minimum 0.01). Requires x402 payment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "value_usd": {
                  "type": "number",
                  "minimum": 0
                },
                "freight_usd": {
                  "type": "number",
                  "minimum": 0
                },
                "insurance_usd": {
                  "type": "number",
                  "minimum": 0
                },
                "other_fees_usd": {
                  "type": "number",
                  "minimum": 0
                },
                "quantity": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "origin_country": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "value_usd"
              ]
            }
          },
          "origin_country": {
            "type": "string",
            "description": "Default origin for rows"
          }
        },
        "required": [
          "rows"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "me.epi.hts/hts-lookup",
    "version": "0.5.0",
    "remoteUrl": "https://hts.epi.me/mcp",
    "publishedAt": "2026-11-27T18:54:53.709379Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "c9fc24df36006ed2852f56bd6be2fe01a09efb7f2b1b91d68cb23a850811ff4b"
  }
}
