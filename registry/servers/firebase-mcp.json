{
  "$schema": "../schema.json",
  "name": "Firebase MCP",
  "category": "Databases & Storage",
  "description": "Firebase MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "get_firestore_document",
      "description": "Fetch Firestore document data by collection and document path.",
      "inputSchema": {
        "type": "object",
        "required": [
          "collection",
          "docId"
        ],
        "properties": {
          "collection": {
            "type": "string",
            "description": "Firestore collection name."
          },
          "docId": {
            "type": "string",
            "description": "Target document identifier."
          }
        }
      }
    }
  ]
}
