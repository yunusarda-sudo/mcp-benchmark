{
 "$schema": "../schema.json",
 "name": "com.scamnav/scamnav",
 "title": "ScamNav",
 "category": "Security & Identity",
 "description": "Free anti-scam intelligence: search cases, check risk, list scam types, reporting channels.",
 "repository": "https://github.com/seo-seo/scamnav-site",
 "tools": [
  {
   "name": "search_scams",
   "description": "Search the ScamNav anti-scam knowledge base by keyword across titles, summaries, tags and scam types. Returns matching cases in the requested language.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string",
      "minLength": 1,
      "description": "Keyword, brand, domain or tactic to search"
     },
     "lang": {
      "type": "string",
      "enum": [
       "en",
       "zh",
       "zhtw",
       "es",
       "fr",
       "de",
       "pt",
       "ru",
       "ar",
       "ja",
       "ko",
       "hi",
       "vi",
       "id",
       "th",
       "he"
      ]
     }
    },
    "required": [
     "query"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
   }
  },
  {
   "name": "get_scam_case",
   "description": "Retrieve one scam case by slug, including sections and FAQs, in the requested language. Use search_scams first to find a slug.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "slug": {
      "type": "string",
      "minLength": 1,
      "description": "Case slug, e.g. ftc-impersonation"
     },
     "lang": {
      "type": "string",
      "enum": [
       "en",
       "zh",
       "zhtw",
       "es",
       "fr",
       "de",
       "pt",
       "ru",
       "ar",
       "ja",
       "ko",
       "hi",
       "vi",
       "id",
       "th",
       "he"
      ]
     }
    },
    "required": [
     "slug"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
   }
  },
  {
   "name": "check_scam_risk",
   "description": "Analyze a suspicious message, email or text for known scam red flags using deterministic rules. Returns a risk level (LOW/MEDIUM/HIGH/CRITICAL) and the matched warning signs.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "The message or text to evaluate"
     },
     "lang": {
      "type": "string",
      "enum": [
       "en",
       "zh",
       "zhtw",
       "es",
       "fr",
       "de",
       "pt",
       "ru",
       "ar",
       "ja",
       "ko",
       "hi",
       "vi",
       "id",
       "th",
       "he"
      ]
     }
    },
    "required": [
     "text"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
   }
  },
  {
   "name": "list_scam_types",
   "description": "List all distinct scam types currently covered in the knowledge base.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {}
   }
  },
  {
   "name": "get_reporting_resources",
   "description": "List official scam/cybercrime reporting channels. Optionally filter by region code. Only official authorities are included; no recovery or fund-recovery services.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "region": {
      "type": "string",
      "description": "Optional region code, e.g. US, HK, IN"
     },
     "lang": {
      "type": "string",
      "enum": [
       "en",
       "zh",
       "zhtw",
       "es",
       "fr",
       "de",
       "pt",
       "ru",
       "ar",
       "ja",
       "ko",
       "hi",
       "vi",
       "id",
       "th",
       "he"
      ]
     }
    },
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
   }
  }
 ],
