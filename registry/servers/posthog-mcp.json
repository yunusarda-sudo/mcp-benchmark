{
  "$schema": "../schema.json",
  "name": "PostHog MCP",
  "category": "Observability & Analytics",
  "description": "PostHog MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "get_feature_flag",
      "description": "Evaluate PostHog feature flag variant status for a distinct user ID.",
      "inputSchema": {
        "type": "object",
        "required": [
          "flagKey",
          "distinctId"
        ],
        "properties": {
          "flagKey": {
            "type": "string",
            "description": "Feature flag key name."
          },
          "distinctId": {
            "type": "string",
            "description": "User distinct ID identifier."
          }
        }
      }
    }
  ]
}
