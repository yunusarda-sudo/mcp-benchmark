{
  "$schema": "../schema.json",
  "name": "io.github.studioKR-0123/neatanswer",
  "title": "NeatAnswer",
  "category": "Developer Tools & DevOps",
  "description": "Official U.S. figures (IRS, SSA, CMS, HHS, USPS) with source links, plus exact calculators.",
  "tools": [
    {
      "name": "search_facts",
      "description": "Search current official U.S. figures (tax limits, Social Security, Medicare, postage, poverty guidelines). Returns answers with official source links.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Question or keywords, e.g. '401k limit 2027'"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_fact",
      "description": "Get one official figure by id, with details, effective date, previous value and official source.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Fact id from list_facts or search_facts"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "list_facts",
      "description": "List all available official figures. Optional category: retirement, tax, social-security, health, everyday.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "Optional category"
          }
        }
      }
    },
    {
      "name": "loan_payment",
      "description": "Monthly payment, total paid and total interest for a fixed-rate loan or mortgage (standard amortization).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "principal": {
            "type": "string",
            "description": "Loan amount"
          },
          "annual_rate_percent": {
            "type": "string",
            "description": "Yearly interest rate in percent, e.g. 6.5"
          },
          "years": {
            "type": "string",
            "description": "Loan term in years"
          }
        },
        "required": [
          "principal",
          "annual_rate_percent",
          "years"
        ]
      }
    },
    {
      "name": "compound_interest",
      "description": "Future value of savings with compound interest and optional monthly contributions (added at month end).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "principal": {
            "type": "string",
            "description": "Starting amount"
          },
          "annual_rate_percent": {
            "type": "string",
            "description": "Yearly rate in percent"
          },
          "years": {
            "type": "string",
            "description": "Number of years"
          },
          "compounds_per_year": {
            "type": "string",
            "description": "Default 12"
          },
          "monthly_contribution": {
            "type": "string",
            "description": "Default 0"
          }
        },
        "required": [
          "principal",
          "annual_rate_percent",
          "years"
        ]
      }
    },
    {
      "name": "percent_change",
      "description": "Percent change from one value to another.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "Old value"
          },
          "to": {
            "type": "string",
            "description": "New value"
          }
        },
        "required": [
          "from",
          "to"
        ]
      }
    },
    {
      "name": "percent_of",
      "description": "What is X percent of Y.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "string",
            "description": "Percent, e.g. 15"
          },
          "of": {
            "type": "string",
            "description": "Base value"
          }
        },
        "required": [
          "percent",
          "of"
        ]
      }
    },
    {
      "name": "unit_convert",
      "description": "Convert length, mass, volume (US units), area, speed, data size or temperature (c, f, k).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "Number to convert"
          },
          "from": {
            "type": "string",
            "description": "Unit, e.g. mi, kg, gal, f"
          },
          "to": {
            "type": "string",
            "description": "Unit, e.g. km, lb, l, c"
          }
        },
        "required": [
          "value",
          "from",
          "to"
        ]
      }
    },
    {
      "name": "date_difference",
      "description": "Days between two dates (YYYY-MM-DD), plus weeks and calendar months.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "end": {
            "type": "string",
            "description": "YYYY-MM-DD"
          }
        },
        "required": [
          "start",
          "end"
        ]
      }
    },
    {
      "name": "add_days",
      "description": "Add (or subtract) days to a date. Returns the date and weekday.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "days": {
            "type": "string",
            "description": "Number of days, negative to subtract"
          }
        },
        "required": [
          "date",
          "days"
        ]
      }
    },
    {
      "name": "poverty_level_percent",
      "description": "Household income as a percent of the 2026 HHS federal poverty guideline.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "income": {
            "type": "string",
            "description": "Yearly household income in USD"
          },
          "household_size": {
            "type": "string",
            "description": "Number of people"
          },
          "region": {
            "type": "string",
            "description": "contiguous (default), alaska or hawaii"
          }
        },
        "required": [
          "income",
          "household_size"
        ]
      }
    },
    {
      "name": "payroll_tax_2027",
      "description": "Employee Social Security (6.2% up to $192,300) and Medicare (1.45%) tax on 2027 wages. Excludes the 0.9% Additional Medicare Tax.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "wages": {
            "type": "string",
            "description": "Yearly wages in USD"
          }
        },
        "required": [
          "wages"
        ]
      }
    },
    {
      "name": "retirement_max_2027",
      "description": "Maximum 2027 employee 401(k)/403(b)/457 deferral and IRA contribution for a given age.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "age": {
            "type": "string",
            "description": "Age at end of 2027"
          }
        },
        "required": [
          "age"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.studioKR-0123/neatanswer",
    "version": "1.0.0",
