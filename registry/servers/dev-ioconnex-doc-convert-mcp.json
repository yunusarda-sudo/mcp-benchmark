{
  "$schema": "../schema.json",
  "name": "dev.ioconnex/doc-convert-mcp",
  "title": "doc-convert-mcp",
  "category": "AI, LLMs & Agents",
  "description": "Document conversion and OCR for AI agents: PDF, Office docs, images to text.",
  "repository": "https://github.com/Anon2052/doc-convert-mcp",
  "tools": [
    {
      "name": "pdf_to_markdown",
      "description": "Convert a PDF (base64-encoded bytes) to Markdown, one section per page.",
      "inputSchema": {
        "properties": {
          "pdf_base64": {
            "type": "string",
            "description": "The PDF file contents, base64-encoded."
          },
          "max_pages": {
            "default": 100,
            "type": "integer",
            "description": "Maximum pages to extract (default 100)."
          }
        },
        "required": [
          "pdf_base64"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "ocr_image",
      "description": "Run OCR on an image (base64-encoded bytes) and return recognized text.",
      "inputSchema": {
        "properties": {
          "image_base64": {
            "type": "string",
            "description": "The image file contents, base64-encoded."
          },
          "lang": {
            "default": "eng",
            "type": "string",
            "description": "Tesseract language code (default 'eng')."
          }
        },
        "required": [
          "image_base64"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "parse_spreadsheet",
      "description": "Parse a CSV or XLSX file (base64-encoded bytes) into Markdown tables.",
      "inputSchema": {
        "properties": {
          "file_base64": {
            "type": "string",
            "description": "The spreadsheet file contents, base64-encoded."
          },
          "filename": {
            "type": "string",
            "description": "Original filename (used to detect .csv vs .xlsx)."
          }
        },
        "required": [
          "file_base64",
          "filename"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "convert_document",
      "description": "Convert a document file (base64-encoded bytes) to Markdown or text.\n\nDispatches on the filename extension. Supported: PDF, images (OCR),\nspreadsheets (CSV, XLSX, XLSM, XLS, ODS), DOCX, PPTX, RTF, EPUB,\nTXT, MD, HTML, JSON, XML.",
      "inputSchema": {
        "properties": {
          "file_base64": {
            "type": "string",
            "description": "The file contents, base64-encoded."
          },
          "filename": {
            "type": "string",
            "description": "Original filename (its extension selects the converter)."
          }
        },
        "required": [
          "file_base64",
          "filename"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "url_to_clean_text",
      "description": "Fetch a public http(s) URL and return its main text content as plain text.",
      "inputSchema": {
        "properties": {
          "url": {
            "type": "string",
            "description": "The http(s) URL to fetch. Private/loopback hosts are rejected."
          }
        },
        "required": [
          "url"
        ],
        "type": "object",
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "dev.ioconnex/doc-convert-mcp",
    "version": "4.1.4",
    "remoteUrl": "https://convert.ioconnex.dev/mcp",
    "publishedAt": "2026-11-25T20:19:41.876436Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "647c16c0f4f287e6e3fe2ce59b605ec8a11756cff2c293d9f7697267d2b57a91"
  }
}
