{
  "$schema": "../schema.json",
  "name": "com.bluedoseapp/glp1-tools",
  "title": "Bluedose GLP-1 Tools",
  "category": "Other",
  "description": "Injection-site rotation, shot-day countdown and GLP-1 search data by country. No dosing advice.",
  "tools": [
    {
      "name": "next_injection_site",
      "description": "Suggest the least recently used of the six common subcutaneous injection sites from a history of sites (most recent last). Rotation helper only: it never recommends or calculates doses.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "history": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Abdomen, left",
                "Abdomen, right",
                "Thigh, left",
                "Thigh, right",
                "Upper arm, left",
                "Upper arm, right"
              ]
            },
            "description": "past sites, most recent last"
          },
          "enabled": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Abdomen, left",
                "Abdomen, right",
                "Thigh, left",
                "Thigh, right",
                "Upper arm, left",
                "Upper arm, right"
              ]
            }
          }
        }
      }
    },
    {
      "name": "shot_day_countdown",
      "description": "Days until the next weekly shot day (0 = today) for a weekday and a reference date. A countdown only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "shot_day": {
            "type": "string",
            "enum": [
              "sunday",
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday"
            ]
          },
          "today": {
            "type": "string",
            "description": "YYYY-MM-DD, default today (UTC)"
          }
        },
        "required": [
          "shot_day"
        ]
      }
    },
    {
      "name": "glp1_search_interest",
      "description": "Average monthly Google searches for Mounjaro, Ozempic, Wegovy, Zepbound, Saxenda, tirzepatide and semaglutide in a country (ISO code, e.g. US, BR, JP), from Bluedose's open dataset (Google Keyword Planner, Nov 2026). Searches show interest, not prescriptions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 code"
          }
        },
        "required": [
          "country"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.bluedoseapp/glp1-tools",
    "version": "1.0.0",
    "remoteUrl": "https://bluedoseapp.com/mcp",
    "publishedAt": "2026-11-21T07:46:13.555941Z",
    "fetchedAt": "2026-11-22T12:49:37.224Z",
    "toolsSha256": "71a18aaace4a1f4535e17bfa45f8b0ea18cfa4e9eaf8e41017a31b26f7c46194"
  }
}
