            "default": null,
            "title": "Cursor"
          },
          "limit": {
            "default": 25,
            "maximum": 50,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "ListJobsInput",
        "type": "object"
      }
    },
