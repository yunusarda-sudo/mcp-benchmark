      "name": "list_backtests",
      "description": "分页列出本人的历史回测任务。",
      "inputSchema": {
        "$defs": {
          "JobState": {
            "enum": [
              "queued",
              "preparing",
              "running",
              "publishing",
              "succeeded",
              "failed",
              "cancelled"
