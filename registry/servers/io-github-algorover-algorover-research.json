{
  "$schema": "../schema.json",
  "name": "io.github.algorover/algorover-research",
  "title": "AlgoRover Research",
  "category": "Developer Tools & DevOps",
  "description": "Discover trading strategies, run historical backtests, and inspect research reports.",
  "repository": "https://github.com/algorover/algorover-research",
  "tools": [
    {
      "name": "get_profile",
      "description": "读取当前已授权的 AlgoRover 账号资料。",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "title": "ProfileInput",
        "type": "object"
      }
    },
    {
      "name": "search_strategies",
      "description": "打开 AlgoRover Research 内嵌策略目录，搜索公开策略并返回精确版本。含连字符的完整策略 slug 精确匹配，普通关键词按相关性搜索。首次目录显式传入会话语言 locale：中文用 zh-CN，英文用 en；用户指定语言时优先采用。后续详情和目录保持相同语言。",
      "inputSchema": {
        "$defs": {
          "JsonValue": {}
        },
        "additionalProperties": false,
        "properties": {
          "query": {
            "default": "",
            "maxLength": 200,
            "title": "Query",
            "type": "string"
          },
          "filters": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "title": "Filters",
            "type": "object"
          },
          "sort": {
            "default": "relevance",
            "enum": [
              "relevance",
              "published",
              "return",
              "drawdown",
              "sharpe"
            ],
            "title": "Sort",
            "type": "string"
          },
          "cursor": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          },
          "limit": {
            "default": 25,
            "maximum": 25,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "locale": {
            "default": "en",
            "enum": [
              "en",
              "zh-CN"
            ],
            "title": "Locale",
            "type": "string"
          }
        },
        "title": "SearchInput",
        "type": "object"
      }
    },
    {
      "name": "get_strategy",
      "description": "读取公司已发布策略及其现有解析状态、预设和市场。",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "slug": {
            "maxLength": 128,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "title": "Slug",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9.!+_-]{0,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Version"
          },
          "locale": {
            "default": "en",
            "enum": [
              "en",
              "zh-CN"
            ],
            "title": "Locale",
            "type": "string"
          }
        },
        "required": [
          "slug"
        ],
        "title": "StrategyInput",
        "type": "object"
      }
    },
    {
      "name": "prepare_strategy",
      "description": "为指定的已发布策略版本安排预设解析，不启动回测。",
      "inputSchema": {
        "$defs": {
          "StrategyRef": {
            "additionalProperties": false,
            "properties": {
              "slug": {
                "maxLength": 128,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "title": "Slug",
                "type": "string"
              },
              "version": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9.!+_-]{0,63}$",
                "title": "Version",
                "type": "string"
              },
              "package_sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "title": "Package Sha256",
                "type": "string"
              }
            },
            "required": [
              "slug",
              "version",
              "package_sha256"
            ],
            "title": "StrategyRef",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "strategy_ref": {
            "$ref": "#/$defs/StrategyRef"
          },
          "locale": {
            "default": "en",
            "enum": [
              "en",
              "zh-CN"
            ],
            "title": "Locale",
            "type": "string"
          },
          "retry": {
            "default": false,
            "title": "Retry",
            "type": "boolean"
          }
        },
        "required": [
          "strategy_ref"
        ],
        "title": "PrepareStrategyInput",
        "type": "object"
      }
    },
    {
      "name": "prepare_backtest",
      "description": "准备固定版本、预设和历史窗口，返回预览；不创建回测。",
      "inputSchema": {
        "$defs": {
          "StrategyRef": {
            "additionalProperties": false,
            "properties": {
              "slug": {
                "maxLength": 128,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "title": "Slug",
                "type": "string"
              },
              "version": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9.!+_-]{0,63}$",
                "title": "Version",
                "type": "string"
              },
              "package_sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "title": "Package Sha256",
                "type": "string"
              }
            },
            "required": [
              "slug",
              "version",
              "package_sha256"
            ],
            "title": "StrategyRef",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "strategy_ref": {
            "$ref": "#/$defs/StrategyRef"
          },
          "preset": {
            "pattern": "^[A-Za-z0-9_-]{1,128}$",
            "title": "Preset",
            "type": "string"
          },
          "venue": {
            "pattern": "^[A-Z0-9_]{1,64}$",
            "title": "Venue",
            "type": "string"
          },
          "days": {
            "enum": [
              90,
              365
            ],
            "title": "Days",
            "type": "integer"
          },
          "locale": {
            "default": "en",
            "enum": [
              "en",
              "zh-CN"
            ],
            "title": "Locale",
            "type": "string"
          }
        },
        "required": [
          "strategy_ref",
          "preset",
          "venue",
          "days"
        ],
        "title": "PrepareInput",
        "type": "object"
      }
    },
    {
      "name": "get_strategy_download",
      "description": "取得确定版本的公开策略下载信息；不安装或执行文件。",
      "inputSchema": {
        "$defs": {
          "StrategyRef": {
            "additionalProperties": false,
            "properties": {
              "slug": {
                "maxLength": 128,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "title": "Slug",
                "type": "string"
              },
              "version": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9.!+_-]{0,63}$",
                "title": "Version",
                "type": "string"
              },
              "package_sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "title": "Package Sha256",
                "type": "string"
              }
            },
            "required": [
              "slug",
              "version",
              "package_sha256"
            ],
            "title": "StrategyRef",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "strategy_ref": {
            "$ref": "#/$defs/StrategyRef"
          },
          "locale": {
            "default": "en",
            "enum": [
              "en",
              "zh-CN"
            ],
            "title": "Locale",
            "type": "string"
          }
        },
        "required": [
          "strategy_ref"
        ],
        "title": "StrategyDownloadInput",
        "type": "object"
      }
    },
    {
      "name": "start_backtest",
      "description": "创建个人远端历史回测任务，返回任务标识。",
      "inputSchema": {
        "$defs": {
          "JsonValue": {},
          "Market": {
            "additionalProperties": false,
            "properties": {
              "instrument_id": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Instrument Id",
                "type": "string"
              },
              "bar_type": {
                "maxLength": 240,
                "minLength": 1,
                "title": "Bar Type",
                "type": "string"
              },
              "venue": {
                "pattern": "^[A-Z0-9_]{1,64}$",
                "title": "Venue",
                "type": "string"
              },
              "data_type": {
                "const": "bars",
                "default": "bars",
                "title": "Data Type",
                "type": "string"
              },
              "interval_seconds": {
                "exclusiveMinimum": 0,
                "maximum": 2592000,
                "title": "Interval Seconds",
                "type": "integer"
              }
            },
            "required": [
              "instrument_id",
              "bar_type",
              "venue",
              "interval_seconds"
            ],
            "title": "Market",
            "type": "object"
          },
          "PreparedInput": {
            "additionalProperties": false,
            "properties": {
              "strategy_ref": {
                "$ref": "#/$defs/StrategyRef"
              },
              "preset": {
                "pattern": "^[A-Za-z0-9_-]{1,128}$",
                "title": "Preset",
                "type": "string"
              },
              "venue": {
                "pattern": "^[A-Z0-9_]{1,64}$",
                "title": "Venue",
                "type": "string"
              },
              "days": {
                "enum": [
                  90,
                  365
                ],
                "title": "Days",
                "type": "integer"
              },
              "start": {
                "format": "date-time",
                "title": "Start",
                "type": "string"
              },
              "end": {
                "format": "date-time",
                "title": "End",
                "type": "string"
              },
              "descriptor_digest": {
                "pattern": "^[a-f0-9]{64}$",
                "title": "Descriptor Digest",
                "type": "string"
              },
              "configuration_digest": {
                "pattern": "^[a-f0-9]{64}$",
                "title": "Configuration Digest",
                "type": "string"
              },
              "schema_digest": {
                "pattern": "^[a-f0-9]{64}$",
                "title": "Schema Digest",
                "type": "string"
              },
              "configuration": {
                "anyOf": [
                  {
                    "additionalProperties": {
                      "$ref": "#/$defs/JsonValue"
                    },
                    "type": "object"
                  },
                  {
                    "contentMediaType": "application/json",
                    "contentSchema": {
                      "additionalProperties": {
                        "$ref": "#/$defs/JsonValue"
                      },
                      "type": "object"
                    },
                    "type": "string"
                  }
                ],
                "title": "Configuration"
              },
              "markets": {
                "items": {
                  "$ref": "#/$defs/Market"
                },
                "maxItems": 20,
                "minItems": 1,
                "title": "Markets",
                "type": "array"
              },
              "image_digest": {
                "pattern": "^sha256:[a-f0-9]{64}$",
                "title": "Image Digest",
                "type": "string"
              }
            },
            "required": [
              "strategy_ref",
              "preset",
              "venue",
              "days",
              "start",
              "end",
              "descriptor_digest",
              "configuration_digest",
              "schema_digest",
              "configuration",
              "markets",
              "image_digest"
            ],
            "title": "PreparedInput",
            "type": "object"
          },
          "StrategyRef": {
            "additionalProperties": false,
            "properties": {
              "slug": {
                "maxLength": 128,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "title": "Slug",
                "type": "string"
              },
              "version": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9.!+_-]{0,63}$",
                "title": "Version",
                "type": "string"
              },
              "package_sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "title": "Package Sha256",
                "type": "string"
              }
            },
            "required": [
              "slug",
              "version",
              "package_sha256"
            ],
            "title": "StrategyRef",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "locale": {
            "default": "en",
            "enum": [
              "en",
              "zh-CN"
            ],
            "title": "Locale",
            "type": "string"
          },
          "prepared_input": {
            "$ref": "#/$defs/PreparedInput"
          },
          "preparation_ticket": {
            "maxLength": 8192,
            "minLength": 20,
            "title": "Preparation Ticket",
            "type": "string"
          },
          "idempotency_key": {
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "title": "Idempotency Key",
            "type": "string"
          }
        },
        "required": [
          "prepared_input",
          "preparation_ticket",
          "idempotency_key"
        ],
        "title": "StartInput",
        "type": "object"
      }
    },
    {
      "name": "get_backtest",
