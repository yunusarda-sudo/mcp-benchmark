{
  "$schema": "../schema.json",
  "name": "io.github.islamad/islam.ad",
  "title": "All Islam Directory",
  "category": "Developer Tools & DevOps",
  "description": "Quran, hadith collections and tafsirs: browse books and chapters, read verses, full-text search",
  "repository": "https://github.com/islamad/website",
  "tools": [
    {
      "name": "get-chapter",
      "description": "Get full chapter content with all verses/hadiths (e.g., a surah from Quran, a chapter from hadith collection)",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "book": {
            "type": "string",
            "description": "Book slug (e.g., \"quran\", \"bukhari\", \"muslim\")"
          },
          "chapter": {
            "type": "string",
            "description": "Chapter number or slug (e.g., \"1\" for Al-Fatiha, \"2\" for Al-Baqara)"
          },
          "locale": {
            "default": "en",
            "description": "Language code for content (e.g., \"en\", \"ar\", \"fr\")",
            "type": "string"
          }
        },
        "required": [
          "book",
          "chapter"
        ]
      }
    },
    {
      "name": "get-part",
      "description": "Get a specific hadith or part by number from a chapter (for non-Quran books like Bukhari, Muslim)",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "book": {
            "type": "string",
            "description": "Book slug (e.g., \"bukhari\", \"muslim\", \"tirmidhi\")"
          },
          "chapter": {
            "type": "string",
            "description": "Chapter number or slug"
          },
          "part": {
            "type": "number",
            "description": "Part/hadith number within the chapter (1-indexed)"
          },
          "locale": {
            "default": "en",
            "description": "Language code for content (e.g., \"en\", \"ar\", \"fr\")",
            "type": "string"
          }
        },
        "required": [
          "book",
          "chapter",
          "part"
        ]
      }
    },
    {
      "name": "get-verse",
      "description": "Get a specific verse from a Quran surah",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "chapter": {
            "type": "string",
            "description": "Surah number (e.g., \"1\" for Al-Fatiha, \"2\" for Al-Baqara)"
          },
          "verse": {
            "type": "number",
            "description": "Verse (ayah) number within the surah (1-indexed)"
          },
          "locale": {
            "default": "en",
            "description": "Language code for content (e.g., \"en\", \"ar\", \"fr\")",
            "type": "string"
          }
        },
        "required": [
          "chapter",
          "verse"
        ]
      }
    },
    {
      "name": "list-books",
      "description": "List all available books and collections (Quran, hadith collections, tafsirs) with localized names",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "locale": {
            "default": "en",
            "description": "Language code for localized names (e.g., \"en\", \"ar\", \"fr\")",
            "type": "string"
          }
        }
      }
    },
    {
      "name": "list-chapters",
      "description": "List all chapters for a given book (e.g., surahs for Quran, books for hadith collections)",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "book": {
            "type": "string",
            "description": "Book slug (e.g., \"quran\", \"bukhari\", \"muslim\")"
          },
          "locale": {
            "default": "en",
            "description": "Language code for localized names (e.g., \"en\", \"ar\", \"fr\")",
            "type": "string"
          }
        },
        "required": [
          "book"
        ]
      }
    },
    {
      "name": "search-content",
      "description": "Full-text search across all Islamic content (Quran, hadith, tafsir)",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query text"
          },
          "locale": {
            "default": "en",
            "description": "Preferred language for results (e.g., \"en\", \"ar\", \"fr\")",
            "type": "string"
          },
          "limit": {
            "default": 10,
            "description": "Maximum number of results to return (1-20)",
            "type": "number",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "query"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.islamad/islam.ad",
    "version": "3.10.2",
    "remoteUrl": "https://islam.ad/mcp",
    "publishedAt": "2026-11-24T22:28:11.463185Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "45adf9da46c3e72012e99cf1c75ae604a55b560500cdccfded177ab61e2eaa87"
  }
}
