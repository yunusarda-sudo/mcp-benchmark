{
  "$schema": "../schema.json",
  "name": "com.limousineworldwideservices/booking",
  "title": "LimousineWorldwideServices.com",
  "category": "Vector DBs & AI Search",
  "description": "Worldwide chauffeur and limousine bookings: search coverage, read city guides, send ride requests.",
  "tools": [
    {
      "name": "search_coverage",
      "description": "Find LimousineWorldwideServices.com pages for a city, airport (IATA code or name), FBO, hotel, venue, event, cruise port, train station, service, vehicle or travel topic. Returns titles, summaries and URLs (with Markdown versions).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "e.g. \"New York\", \"JFK\", \"Monaco Grand Prix\", \"Teterboro\", \"monthly chauffeur\""
          },
          "section": {
            "type": "string",
            "enum": [
              "limo-service",
              "destinations",
              "airports",
              "fbo",
              "cruise-ports",
              "train-stations",
              "heliports",
              "hotels",
              "venues",
              "events",
              "attractions",
              "marinas",
              "ski-resorts",
              "services",
              "fleet",
              "packages",
              "travel-desk",
              "industries",
              "guides",
              "journal"
            ],
            "description": "Optional filter"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 8
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_page",
      "description": "Return the Markdown text of a LimousineWorldwideServices.com page: coverage, vehicles, meeting points, drive times, tips and FAQ. Accepts a full URL or a path such as /limo-service/new-york/.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "get_booking_options",
      "description": "Services, vehicle classes, what is included, contact channels, the instant-quote booking engine link and booking policies.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "request_booking",
      "description": "Send a chauffeur booking request to the 24/7 desk for the traveller. Only call when the traveller explicitly asked to book. Returns a reference (LWS-XXXXXXX); the desk then confirms price, vehicle and chauffeur by email or phone. It is not a confirmed booking until then, and no payment is taken.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Lead passenger full name"
          },
          "email": {
            "type": "string",
            "description": "Email (email or phone required)"
          },
          "phone": {
            "type": "string",
            "description": "Mobile with country code"
          },
          "service": {
            "type": "string",
            "enum": [
              "Airport transfer",
              "FBO / private jet",
              "Point to point",
              "Hourly / as directed",
              "Monthly chauffeur",
              "Corporate / roadshow",
              "Event / gala",
              "Wedding",
              "Delegation / group",
              "Cruise port",
              "Train station",
              "Travel Desk package"
            ]
          },
          "pickup": {
            "type": "string",
            "description": "Address, hotel, airport code + terminal or FBO"
          },
          "dropoff": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "description": "Local pickup date YYYY-MM-DD"
          },
          "time": {
            "type": "string",
            "description": "Local pickup time HH:MM (for arrivals, the scheduled landing time)"
          },
          "flight": {
            "type": "string",
            "description": "Flight, train or ship identifier"
          },
          "passengers": {
            "type": "integer",
            "minimum": 1
          },
          "bags": {
            "type": "integer",
            "minimum": 0
          },
          "vehicle": {
            "type": "string",
            "enum": [
              "Executive sedan",
              "S-Class / first class sedan",
              "Luxury SUV",
              "Sprinter",
              "Stretch limousine",
              "Minicoach / coach",
              "Multiple vehicles",
              "No preference"
            ]
          },
          "hours": {
            "type": "integer",
            "minimum": 1,
            "description": "For hourly / as-directed bookings"
          },
          "return": {
            "type": "string",
            "description": "Return trip details, if any"
          },
          "notes": {
            "type": "string",
            "description": "Child seats, accessibility, sign name, confidentiality, stops, etc."
          },
          "agent": {
            "type": "string",
            "description": "Name of your assistant or app"
          },
          "consent": {
            "type": "string",
            "enum": [
              "yes"
            ],
            "description": "The traveller explicitly asked for this booking"
          }
        },
        "required": [
          "name",
          "pickup",
          "dropoff",
          "date",
          "time",
          "consent"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.limousineworldwideservices/booking",
    "version": "1.0.0",
    "remoteUrl": "https://www.limousineworldwideservices.com/api/mcp.php",
    "publishedAt": "2026-11-24T13:54:02.641609Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "0b89d340182f6c7a850662db2624ca729a4a4034ca75f97d78f138c2de41e848"
  }
}
