{
  "$schema": "../schema.json",
  "name": "com.telmian/sms",
  "title": "Telmian SMS",
  "category": "Communication & Alerting",
  "description": "SMS for apps built with AI: OTP codes, reminders, two-way texts to 44 European countries.",
  "repository": "https://github.com/telmian/telmian-mcp",
  "tools": [
    {
      "name": "whoami",
      "description": "Start here. Shows who is connected, the organization, your role, the permissions (scopes) granted to this connection, the selected project and all projects. If a tool you need is missing, the human must reconnect granting that permission.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "projects",
      "description": "List your projects and environments. Production projects may send real SMS.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "create_project",
      "description": "Create a sandbox project: deliveries are simulated, no real SMS and no credit used. Production (real SMS) projects are created by a person in the Telmian panel after going live. Reuse the same idempotency key on retries.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "environment": {
            "default": "sandbox",
            "type": "string",
            "const": "sandbox"
          },
          "idempotency_key": {
            "type": "string",
            "pattern": "^[\\w.-]{8,128}$"
          }
        },
        "required": [
          "name",
          "idempotency_key"
        ]
      }
    },
    {
      "name": "select_project",
      "description": "Select one of your projects for subsequent MCP tools.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "project_id"
        ]
      }
    },
    {
      "name": "account_balance",
      "description": "Read prepaid balance and reserved credit in integer EUR micro-units.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "topup_link",
      "description": "Link for the human to add credit by card (Stripe) or set up automatic top-up. Real SMS start after the first paid top-up. Never ask for card details in chat.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "sender_profile",
      "description": "The business name shown inside your SMS text (the sender is a phone number) and the site links may point to, with its review status (none, pending, approved, rejected; reason when rejected). site.code is the proof of ownership: publish it as the whole content of site.file_url (or as a DNS TXT record on the domain), deploy, then call verify_site.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "set_sender_profile",
      "description": "Choose the business name shown inside your SMS text, e.g. \"Il tuo codice <name> è…\" (letters, digits and spaces, max 20; the sender stays a phone number) and optionally your site domain (e.g. example.com) for links. Ask the human first. It goes to review: usually decided in seconds, brand-like names wait for a Telmian reviewer. Real verification codes need it approved.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "app_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "domain": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 253
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "app_name"
        ]
      }
    },
    {
      "name": "verify_site",
      "description": "After publishing site.code from sender_profile at site.file_url (or as a DNS TXT record), check it: the site is then verified and templates may link to it. Error site_not_verified: the code is not reachable yet.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "project_policy",
      "description": "Read OTP and routing policy for the selected project.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "update_project_policy",
      "description": "Change the cooldown between verification codes, the blocked regions or the maximum cost of the selected project; other limits are fixed by Telmian. Send only the fields to change; the others (including sandbox test numbers) are kept. Requires an organization admin.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "policy": {
            "type": "object",
            "properties": {
              "ttlSeconds": {
                "type": "integer",
                "minimum": 30,
                "maximum": 600
              },
              "maxAttempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "cooldownSeconds": {
                "type": "integer",
                "minimum": 30,
                "maximum": 300
              },
              "recipientHourly": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "recipientDaily": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "maxCost": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000000
              },
              "allowedRegions": {
                "maxItems": 250,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                }
              },
              "deniedRegions": {
                "maxItems": 250,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                }
              },
              "allowVoice": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "policy"
        ]
      }
    },
    {
      "name": "api_key_creation_link",
      "description": "Link for the human to create an API key in the panel. Use it for live (sk_live_) keys, which never pass through this chat; for the sandbox use create_sandbox_key.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "webhook_creation_link",
      "description": "Link for the human to create a webhook in the panel and copy its signing secret.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "create_sandbox_key",
      "description": "Create an API key for the selected SANDBOX project (simulated SMS, no cost) and return it once. Write it to the app .env as TELMIAN_API_KEY and do not repeat it. Each call creates a new key. Live keys: api_key_creation_link.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "default": "Sandbox key",
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    {
      "name": "create_sandbox_webhook",
      "description": "Create a webhook for the selected SANDBOX project: Telmian POSTs signed events (delivery, replies, verifications) to this public HTTPS address. Returns the signing secret once: write it to the app .env as TELMIAN_WEBHOOK_SECRET and verify each request with verifyWebhook from the telmian SDK. Live projects: webhook_creation_link.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "setup_supabase_sms",
      "description": "Supabase phone sign-in without Twilio: connect the Supabase Send SMS hook to the selected SANDBOX project, so Supabase sends its login codes through Telmian. Returns the hook URL and signing secret once: set them in Supabase (Authentication > Hooks > Send SMS hook, type HTTPS) or, for local Supabase, in supabase/config.toml under [auth.hook.send_sms] (enabled = true, uri, secrets); never in client code. If the human already generated a secret in Supabase, pass it as secret. Live projects are connected by the human in the panel (Connections > Integrations). If the project is already connected, the existing hook is returned without a secret: pass rotate:true only to replace the secret (the old one stops working in Supabase at once).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "minLength": 20,
            "maxLength": 256
          },
          "rotate": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "revoke_api_key",
      "description": "Revoke an API key in the selected project. Applications using it stop working.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "key_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "key_id"
        ]
      }
    },
    {
      "name": "set_webhook_events",
      "description": "Change subscribed event types for a webhook in this project.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "webhook_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "events": {
            "minItems": 1,
            "maxItems": 22,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "delivery.accepted",
                "delivery.delivered",
                "delivery.failed",
                "challenge.verified",
                "challenge.expired",
                "challenge.locked",
                "message.sent",
                "message.delivered",
                "message.failed",
                "message.uncertain",
                "message.unconfirmed",
                "verify.completed",
                "message.reply",
                "message.received",
                "message.scheduled",
                "message.rescheduled",
                "message.cancelled",
                "appointment.created",
                "appointment.changed",
                "appointment.cancelled",
                "assistant.task_created",
                "assistant.task_completed"
              ]
            }
          }
        },
        "required": [
          "webhook_id",
          "events"
        ]
      }
    },
    {
      "name": "set_webhook_enabled",
      "description": "Enable or disable a webhook in this project.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "webhook_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "webhook_id",
          "enabled"
        ]
      }
    },
    {
      "name": "project_status",
      "description": "Read this project, environment, account credit and price per SMS segment (live projects; sandbox is free), all in EUR micro-units.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "api_keys",
      "description": "List this project API keys with their visible prefix (to match the key in .env); secret values are never returned.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "webhooks",
      "description": "List this project webhook status and event subscriptions without URLs or signing secrets.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "webhook_attempts",
      "description": "List recent delivery attempts for this project webhooks.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "messages",
      "description": "List recent messages with masked destination and delivery state.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "message_status",
      "description": "Read one message state without resending it: status and error_code. Final states: delivered; failed or expired (not charged, tell the user); sent with error_code delivery_unconfirmed (may have arrived, never resend automatically); unknown (never resend). Full table: /developer/quickstart.md, section 6.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "message_id"
        ]
      }
    },
    {
      "name": "message_replies",
      "description": "Read replies to a message. Personal numbers remain masked.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "message_id"
        ]
      }
    },
    {
      "name": "message_templates",
      "description": "List templates and variables available for SMS. Ready ones come in Italian, English, German, French and Spanish (locale): use the language of the people who receive them; your own templates have no locale. Field formats: data DD/MM/YYYY (21/11/2026), ora HH:MM 24-hour (15:30), importo 12,50 € or €12.50, nome letters only, ordine/codice letters, digits and dashes, attivita your business name, link/url only on the verified site.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "template_requests",
      "description": "Your templates and their review: approved (usable), pending (being reviewed, usually seconds, sometimes by a person), rejected (review_reason says what to change: tell the human and submit a new version).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "verified_numbers",
      "description": "List verified owner numbers in masked form.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "usage",
      "description": "Usage of this project: verification codes and, for this month, messages by type and state, with the account balance and budgets (EUR micro-units).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "owner_hooks",
      "description": "List owner notification hooks without secret URLs.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "revoke_owner_hook",
      "description": "Disable one owner notification hook.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "hook_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "hook_id"
        ]
      }
    },
    {
      "name": "verification_status",
      "description": "Read an OTP challenge status without revealing its code.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "challenge_id"
        ]
      }
    },
    {
      "name": "remove_verified_number",
      "description": "Remove a verified owner number.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "number_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "number_id"
        ]
      }
    },
    {
      "name": "scheduled_messages",
      "description": "List scheduled message plans and their status.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "submit_template",
      "description": "Create or update an SMS template. Every new version is reviewed before use, usually by AI in seconds. Prefer typed fields, checked at every send: {nome}/{name}, {attivita}/{business}, {indirizzo}/{address}, {ordine}/{order}, {codice}/{code}, {data}/{date} DD/MM/YYYY, {ora}/{time} HH:MM, {importo}/{amount}, {link}/{url} (only URLs on the verified site, see verify_site). Any other field name is free text and is reviewed (usually in seconds, sometimes by a person). No phone numbers: write \"reply to this SMS\" (in the message language), replies come back to you. status pending: being reviewed, check template_requests again after a few seconds; rejected: review_reason says what to change.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "variables": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z_]{1,40}$"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "body",
          "variables"
        ]
      }
    },
    {
      "name": "send_verification",
      "description": "Send a 6-digit OTP by SMS to a European mobile number (same as POST /v1/verify), after human approval. The code is never returned. Calling it again for the same number sends a new code and invalidates the previous one. In sandbox only the project test numbers receive it; +393000000001 always works with code 000000.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 8,
            "maxLength": 16
          },
          "idempotency_key": {
            "type": "string",
            "pattern": "^[\\w.-]{8,128}$"
          }
        },
        "required": [
          "phone",
          "idempotency_key"
        ]
      }
    },
    {
      "name": "check_verification",
      "description": "Check the code the end user typed for that number (same as POST /v1/verify/check). Returns {valid:true|false}; a wrong, expired or used code is valid:false. Never repeat the code in later messages.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 8,
            "maxLength": 16
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      }
    },
    {
      "name": "create_inverse_verification",
      "description": "Create a verification where the user sends an SMS. Show the generated code and service destination only to that user. phone (the number being verified) is required in production projects.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "maxLength": 16
          },
          "idempotency_key": {
            "type": "string",
            "pattern": "^[\\w.-]{8,128}$"
          }
        },
        "required": [
          "idempotency_key"
        ]
      }
    },
    {
      "name": "inverse_verification_status",
      "description": "Read status of an inverse SMS verification.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "verification_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
