{
  "$schema": "../schema.json",
  "name": "com.tracevero/registry",
  "title": "TraceVero",
  "category": "Other",
  "description": "Search and compare public MCP servers. Every value carries its source and collection date.",
  "tools": [
    {
      "name": "search",
      "description": "Find public MCP servers or coding agents by name, task, package coordinate or URL, using the same staged search as the website. Returns IDs for fetch.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Name, task, package coordinate or URL. Provider text is searched literally before broader fallback stages."
          },
          "locale": {
            "type": "string",
            "enum": [
              "de",
              "en"
            ],
            "default": "en"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000,
            "default": 0
          },
          "type": {
            "type": "string",
            "enum": [
              "mcp_server",
              "coding_agent"
            ]
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "fetch",
      "description": "Retrieve a public result from search. Every declared feature retains its source, collection date and explicit-empty indicator.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^(mcp|agenten)\\/[a-z0-9][a-z0-9-]*$"
          },
          "locale": {
            "type": "string",
            "enum": [
              "de",
              "en"
            ],
            "default": "en"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "compare",
      "description": "Compare two to four public entries. Missing observations remain separate from false and explicitly empty values. No safety or trust ranking.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 240,
              "pattern": "^(mcp|agenten)\\/[a-z0-9][a-z0-9-]*$"
            },
            "minItems": 2,
            "maxItems": 4
          },
          "locale": {
            "type": "string",
            "enum": [
              "de",
              "en"
            ],
            "default": "en"
          },
          "differences_only": {
            "type": "boolean",
            "default": false,
            "description": "Omit rows with identical declared values. Incomplete rows remain visible; matching values do not imply matching evidence."
          }
        },
        "required": [
          "ids"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "configure",
      "description": "Generate a local or remote connection configuration template for one public MCP entry using tracevero’s existing rules. Does not install or execute anything. Secret values are never requested; placeholders need to be filled locally.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^(mcp|agenten)\\/[a-z0-9][a-z0-9-]*$"
          },
          "client": {
            "type": "string",
            "enum": [
              "claude-desktop",
              "claude-code",
              "cursor",
              "vscode",
              "windsurf",
              "codex"
            ],
            "description": "Client receiving the selected connection template; supported transports differ by client."
          },
          "locale": {
            "type": "string",
            "enum": [
              "de",
              "en"
            ],
            "default": "en"
          },
          "connection": {
            "type": "string",
            "maxLength": 40,
            "default": "auto"
          }
        },
        "required": [
          "id",
          "client"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "plan_workflow",
      "description": "Decompose a documented task and find API operations for existing apps. Shows uncovered steps, permission alternatives, costs and untested connector boundaries. Never executes the workflow.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "enum": [
              "file-invoices",
              "invoice-amounts",
              "email-calendar",
              "meeting-tasks",
              "orders-erp",
              "save-research",
              "gmail-attachments-drive",
              "outlook-attachments-onedrive",
              "gmail-attachments-dropbox",
              "outlook-attachments-drive",
              "gmail-find",
              "outlook-find",
              "gmail-read",
              "outlook-read",
              "gmail-draft",
              "outlook-draft",
              "gmail-send",
              "outlook-send",
              "drive-search",
              "onedrive-search",
              "dropbox-search",
              "drive-upload",
              "onedrive-upload",
              "dropbox-upload",
              "drive-to-onedrive",
              "dropbox-to-drive",
              "drive-to-dropbox",
              "onedrive-to-dropbox",
              "google-events",
              "microsoft-events",
              "google-event-create",
              "microsoft-event-create",
              "google-availability",
              "microsoft-availability",
              "google-event-update",
              "microsoft-event-update",
              "sheets-append",
              "excel-append",
              "sheets-read",
              "excel-read",
              "sheets-update",
              "excel-update",
              "sheets-to-excel",
              "excel-to-sheets",
              "sheets-create",
              "github-issues",
              "github-issue-read",
              "github-issue-create",
              "github-releases",
              "github-issues-sheet"
            ]
          },
          "query": {
            "type": "string",
            "maxLength": 500,
            "default": ""
          },
          "apps": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "gmail",
                "google-drive",
                "google-calendar",
                "google-sheets",
                "outlook",
                "onedrive",
                "microsoft-calendar",
                "excel",
                "dropbox",
                "github"
              ]
            },
            "maxItems": 10,
            "default": []
          },
          "read_only": {
            "type": "boolean",
            "default": false
          },
          "runtime": {
            "type": "string",
            "enum": [
              "any",
              "local",
              "remote"
            ],
            "default": "any"
          },
          "granted_scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "maxItems": 50,
            "default": []
          },
          "evidence": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_connection_options",
      "description": "Inspect separate local and remote paths, declared secrets, documented authentication and verification limits for a public entry.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^(mcp|agenten)\\/[a-z0-9][a-z0-9-]*$"
          },
          "locale": {
            "type": "string",
            "enum": [
              "de",
              "en"
            ],
            "default": "en"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "validate_config",
      "description": "Check JSON structure and Docker environment forwarding for a client. Submit a locally sanitized configuration, never live tokens. Returns redacted repairs; no installation or execution.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "config": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 24000
              },
              {
                "type": "object",
                "additionalProperties": {}
              }
            ]
          },
          "client": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "config",
          "client"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.tracevero/registry",
    "version": "2.0.0",
    "remoteUrl": "https://api.tracevero.com/mcp",
    "publishedAt": "2026-11-19T16:42:53.259561Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "fa5e8d166c666bd6bc0b55165362acfd67ef1be81e127222f36c969f06c2e423"
  }
}
