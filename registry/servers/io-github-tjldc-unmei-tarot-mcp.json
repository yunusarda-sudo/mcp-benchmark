{
  "$schema": "../schema.json",
  "name": "io.github.TJLDC/unmei-tarot-mcp",
  "title": "Unmei Tarot",
  "category": "Developer Tools & DevOps",
  "description": "Draw tarot cards and look up 78 Rider–Waite–Smith meanings in Japanese or English.",
  "repository": "https://github.com/TJLDC/unmei-tarot-integrations",
  "tools": [
    {
      "name": "lookup_tarot_card",
      "description": "Find the upright and reversed meanings of a Rider–Waite–Smith card by English name, Japanese name or card ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "card": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "ja"
            ],
            "default": "en"
          }
        },
        "required": [
          "card"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "draw_tarot_cards",
      "description": "Draw one card or a past–present–future spread. Returns unique cards, their orientations and concise meanings.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "spread": {
            "type": "string",
            "enum": [
              "one-card",
              "past-present-future"
            ],
            "default": "one-card"
          },
          "includeReversals": {
            "type": "boolean",
            "default": false
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "ja"
            ],
            "default": "en"
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.TJLDC/unmei-tarot-mcp",
    "version": "0.1.1",
    "remoteUrl": "https://www.unmei-tarot.com/api/mcp",
    "publishedAt": "2026-11-26T21:21:04.730412Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "df6678f9dc394669442112486d96888d6aa29eabe6e6ecb6c0756f4e4aecf46e"
  }
}
