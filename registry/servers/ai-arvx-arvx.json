{
  "$schema": "../schema.json",
  "name": "ai.arvx/arvx",
  "title": "ARVX",
  "category": "Other",
  "description": "ARVX™ models both people in a relationship and reads its health area by area with every Reading.",
  "repository": "https://github.com/centricai/arvx-mcp",
  "tools": [
    {
      "name": "arvx_get_access",
      "description": "How to get access to ARVX: the signup link to give the person, what they must do themselves, the price, and how to add their key to this connector. Call this when there is no key, or when the person asks how to start. Costs nothing.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "arvx_run_reading",
      "description": "Run a Reading on two people from the emails between them. Send at least 3 emails written by the user and 3 by the other person, oldest first. From the second Reading on a pair, send the record from the last Reading exactly as it was returned. Costs one Reading (the first 3 are free). Save the record from the answer with this pair.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 100
              },
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                "description": "Ties the record to this pair. Never stored, never sent to an AI model."
              },
              "title": {
                "type": "string",
                "maxLength": 150
              },
              "company": {
                "type": "string",
                "maxLength": 150
              },
              "teamSize": {
                "description": "People on the account, counting the user.",
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "scores": {
                "type": "object",
                "properties": {
                  "ocean": {
                    "type": "object",
                    "properties": {
                      "extraversion": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      },
                      "agreeableness": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      },
                      "conscientiousness": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      },
                      "openness": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      },
                      "emotional_stability": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      }
                    }
                  },
                  "disc": {
                    "type": "object",
                    "properties": {
                      "dominance": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      },
                      "influence": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      },
                      "steadiness": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      },
                      "calculativeness": {
                        "description": "DISC's C goes here.",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      }
                    }
                  }
                },
                "description": "Only results from a personality assessment the person agreed to. At least 5 of the 9 traits, each 1 to 10. Never results collected for a hiring decision, and never clinical tests. Leave this out to have the person read from their emails."
              }
            },
            "required": [
              "name",
              "email"
            ],
            "description": "The person you work for."
          },
          "other": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 100
              },
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                "description": "Ties the record to this pair. Never stored, never sent to an AI model."
              },
              "title": {
                "type": "string",
                "maxLength": 150
              },
              "company": {
                "description": "Switches on company news.",
                "type": "string",
                "maxLength": 150
              },
              "country": {
                "description": "ARVX reads people in the United States only. US switches on U.S. holidays.",
                "type": "string",
                "const": "US"
              },
              "city": {
                "description": "With state, switches on severe weather warnings.",
                "type": "string"
              },
              "state": {
                "description": "Two-letter code, such as MI.",
                "type": "string",
                "minLength": 2,
                "maxLength": 2
              },
              "scores": {
                "type": "object",
                "properties": {
                  "ocean": {
                    "type": "object",
                    "properties": {
                      "extraversion": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      },
                      "agreeableness": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      },
                      "conscientiousness": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      },
                      "openness": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      },
                      "emotional_stability": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      }
                    }
                  },
                  "disc": {
                    "type": "object",
                    "properties": {
                      "dominance": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      },
                      "influence": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      },
                      "steadiness": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      },
                      "calculativeness": {
                        "description": "DISC's C goes here.",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                      }
                    }
                  }
                },
                "description": "Only results from a personality assessment the person agreed to. At least 5 of the 9 traits, each 1 to 10. Never results collected for a hiring decision, and never clinical tests. Leave this out to have the person read from their emails."
              }
            },
            "required": [
              "name",
              "email"
            ],
            "description": "The person the user works with."
          },
          "emails": {
            "minItems": 1,
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "enum": [
                    "user",
                    "other"
                  ]
                },
                "body": {
                  "type": "string",
                  "maxLength": 20000
                },
                "sentAt": {
                  "description": "Date and time sent, such as 2026-10-01T14:30:00Z.",
                  "type": "string"
                }
              },
              "required": [
                "from",
                "body"
              ]
            },
            "description": "Oldest first. Each person is read from their own latest 20 emails, the first 3,000 characters of each."
          },
          "record": {
            "description": "The record from the last Reading on these same two people, unchanged. Leave out on the first Reading.",
            "type": "string"
          }
        },
        "required": [
          "user",
          "other",
          "emails"
        ]
      }
    },
    {
      "name": "arvx_record_summary",
      "description": "When someone asks what is held about them: returns every item in a saved record in plain words. Needs the record and both people's emails. Never uses up a Reading; 10 a month per account.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "record": {
            "type": "string"
          },
          "user": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              }
            },
            "required": [
              "email"
            ]
          },
          "other": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              }
            },
            "required": [
              "email"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "access_request",
              "correction",
              "deletion_check"
            ]
          }
        },
        "required": [
          "record",
          "user",
          "other",
          "reason"
        ]
      }
    }
  ],
