{
  "$schema": "../schema.json",
  "name": "ai.skillsafe/skillsafe",
  "title": "SkillSafe",
  "category": "AI, LLMs & Agents",
  "description": "Search the SkillSafe registry of security-scanned agent skills and scan skill files for risks.",
  "repository": "https://github.com/skillsafe/skillsafe-plugin",
  "tools": [
    {
      "name": "search_skills",
      "description": "Search the SkillSafe registry for AI coding skills. Returns a compact list of matching skills with metadata.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Free-text search query"
          },
          "category": {
            "type": "string",
            "description": "Filter by category"
          },
          "tag": {
            "type": "string",
            "description": "Filter by tag"
          },
          "namespace": {
            "type": "string",
            "description": "Filter by @namespace"
          },
          "sort": {
            "type": "string",
            "description": "Sort order",
            "enum": [
              "popular",
              "recent",
              "verified",
              "trending",
              "hot",
              "stars",
              "newest",
              "eval_score",
              "relevance",
              "updated",
              "installs"
            ]
          },
          "limit": {
            "type": "number",
            "description": "Max results (1-100, default 20)"
          }
        }
      }
    },
    {
      "name": "recommend_skills",
      "description": "Given a task description, recommend the most relevant skills from the SkillSafe registry. Call this before attempting non-trivial tasks like creating presentations, building bots, or generating reports.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "description": "What the user wants to accomplish (max 500 chars)"
          },
          "limit": {
            "type": "number",
            "description": "Max results (1-20, default 5)"
          }
        },
        "required": [
          "task"
        ]
      }
    },
    {
      "name": "get_skill_info",
      "description": "Get detailed metadata for a specific skill by namespace and name (e.g. @anthropics/pptx).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "description": "Skill namespace (with or without @)"
          },
          "name": {
            "type": "string",
            "description": "Skill name"
          }
        },
        "required": [
          "namespace",
          "name"
        ]
      }
    },
    {
      "name": "get_install_commands",
      "description": "Get the commands to install a skill from the SkillSafe registry (npx skills add, or git clone), plus its version, file list, and scan verdict. Installs nothing itself: run one of the returned commands to install. Does not return file contents.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "description": "Skill namespace (with or without @)"
          },
          "name": {
            "type": "string",
            "description": "Skill name"
          },
          "version": {
            "type": "string",
            "description": "Semver version (omit for latest)"
          }
        },
        "required": [
          "namespace",
          "name"
        ]
      }
    },
    {
      "name": "scan_skill",
      "description": "Scan skill files for security issues. Provide file paths and contents to analyze for vulnerabilities, prompt injection, credential exposure, and other risks.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "description": "Files to scan",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Relative file path"
                },
                "content": {
                  "type": "string",
                  "description": "File content"
                }
              },
              "required": [
                "path",
                "content"
              ]
            }
          }
        },
        "required": [
          "files"
        ]
      }
    },
    {
      "name": "scan_mcp_config",
      "description": "Scan MCP tool definitions or server configurations for poisoning patterns (injection tags, credential theft, stealth instructions, exfiltration).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tools": {
            "type": "array",
            "description": "MCP tool definitions to scan (provide tools OR mcpServers, not both)",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "inputSchema": {
                  "type": "object"
                }
              },
              "required": [
                "name"
              ]
            }
          },
          "mcpServers": {
            "type": "object",
            "description": "MCP server config object to scan (e.g. from claude_desktop_config.json)"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "ai.skillsafe/skillsafe",
    "version": "1.0.0",
    "remoteUrl": "https://api.skillsafe.ai/mcp",
    "publishedAt": "2026-11-25T03:38:08.422444Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "ca115bd6d31c10a5c567d8c7ec38632363f24146139e5a8d5e12b180cc54e329"
  }
}
