{
  "$schema": "../schema.json",
  "name": "org.giftofparenthood.grant/grants",
  "title": "Gift of Parenthood Grant Program",
  "category": "Other",
  "description": "Check Gift of Parenthood fertility grant fees and dates, and start an application or gift.",
  "tools": [
    {
      "name": "get_grant_program_info",
      "description": "Eligibility, fees, the fee waiver, the current cycle's dates and how to apply for the Gift of Parenthood grant. Use this before telling someone about the program.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "start_grant_application",
      "description": "Prepare a Gift of Parenthood grant application for the person you're helping and email them a link to finish it. Send their email plus anything they've told you. They sign in with that email, review every answer, add date of birth, partner and medical details themselves, sign, and pay the $75 fee or use the fee waiver. Do not send signatures, consent, attestations, documents or payment details. Nothing is submitted by this tool.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "The applicant's own email address."
          },
          "first_name": {
            "type": "string",
            "maxLength": 100,
            "description": "Applicant's first name."
          },
          "last_name": {
            "type": "string",
            "maxLength": 100,
            "description": "Applicant's last name."
          },
          "phone": {
            "type": "string",
            "maxLength": 30,
            "description": "Applicant's phone number."
          },
          "country": {
            "type": "string",
            "enum": [
              "United States",
              "Canada",
              "United Kingdom",
              "Australia",
              "Other"
            ],
            "description": "Country of legal residence."
          },
          "state": {
            "type": "string",
            "maxLength": 60,
            "description": "State, province or region (US states as two-letter codes, e.g. CA)."
          },
          "grant_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "fertility",
                "adoption",
                "surrogacy",
                "medical",
                "other"
              ]
            },
            "description": "What the grant would help with."
          },
          "treatment_type": {
            "type": "string",
            "enum": [
              "IVF (In Vitro Fertilization)",
              "IUI (Intrauterine Insemination)",
              "Egg Freezing",
              "Embryo Freezing",
              "Donor Eggs",
              "Donor Sperm",
              "Surrogacy",
              "Adoption - Domestic",
              "Adoption - International",
              "Foster to Adopt",
              "Medication/Monitoring Only",
              "Other"
            ],
            "description": "Primary family-building path."
          },
          "journey_stage": {
            "type": "string",
            "enum": [
              "Just starting to explore options",
              "Researching and planning",
              "Actively pursuing treatment/process",
              "Currently in treatment cycle",
              "Between treatment attempts",
              "In adoption/surrogacy process",
              "On hold due to financial constraints",
              "Final stages before parenthood"
            ],
            "description": "Where they are in their journey."
          },
          "your_journey": {
            "type": "string",
            "maxLength": 5000,
            "description": "Their family-building story, in their own words."
          },
          "plan_next": {
            "type": "string",
            "maxLength": 2000,
            "description": "What they plan to do next."
          },
          "invested_so_far": {
            "type": "string",
            "maxLength": 2000,
            "description": "What they have invested so far."
          },
          "use_of_funds": {
            "type": "string",
            "maxLength": 2000,
            "description": "How they would use the grant."
          },
          "estimated_cost": {
            "type": "string",
            "enum": [
              "under_5k",
              "5k_10k",
              "10k_20k",
              "20k_50k",
              "50k_100k",
              "over_100k"
            ],
            "description": "Estimated total cost."
          },
          "funding_secured": {
            "type": "string",
            "enum": [
              "none",
              "under_1k",
              "1k_5k",
              "5k_10k",
              "10k_25k",
              "over_25k"
            ],
            "description": "Funding already secured."
          },
          "household_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Number of people in the household."
          },
          "annual_income_range": {
            "type": "string",
            "enum": [
              "under_25k",
              "25k_50k",
              "50k_75k",
              "75k_100k",
              "100k_150k",
              "over_150k",
              "prefer_not_to_say"
            ],
            "description": "Household annual income range."
          },
          "employment_status": {
            "type": "string",
            "enum": [
              "employed_full_time",
              "employed_part_time",
              "self_employed",
              "unemployed",
              "student",
              "retired",
              "prefer_not_to_say"
            ],
            "description": "Employment status."
          },
          "has_fundraising_page": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ],
            "description": "Whether they already have a fundraiser."
          },
          "fundraising_page_url": {
            "type": "string",
            "format": "uri",
            "description": "Link to their fundraiser, if any."
          },
          "amount_raised": {
            "type": "string",
            "enum": [
              "none",
              "under_1k",
              "1k_5k",
              "5k_10k",
              "10k_25k",
              "over_25k"
            ],
            "description": "Amount raised on their fundraiser."
          }
        },
        "required": [
          "email"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "start_gift",
      "description": "Prepare a gifted grant application (a nomination) for someone else and email the giver a link to review and pay. single_cycle pre-pays one application; four_cycle_pass pre-pays up to four over a year. The recipient is only invited after the giver pays. Nothing is paid by this tool.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "giver_email": {
            "type": "string",
            "format": "email",
            "description": "Email of the person paying for the gift."
          },
          "giver_name": {
            "type": "string",
            "maxLength": 120,
            "description": "Full name of the person paying for the gift."
          },
          "recipient_name": {
            "type": "string",
            "maxLength": 120,
            "description": "Full name of the person receiving the gift."
          },
          "recipient_email": {
            "type": "string",
            "maxLength": 254,
            "description": "Email address of the person receiving the gift."
          },
          "gift_type": {
            "type": "string",
            "enum": [
              "single_cycle",
              "four_cycle_pass"
            ],
            "description": "single_cycle pre-pays one application; four_cycle_pass pre-pays up to four over a year."
          },
          "personal_message": {
            "type": "string",
            "maxLength": 1000,
            "description": "Optional personal message to the recipient."
          }
        },
        "required": [
          "giver_email",
          "giver_name",
          "recipient_name",
          "recipient_email"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "org.giftofparenthood.grant/grants",
    "version": "1.0.0",
