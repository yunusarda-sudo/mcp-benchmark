{
  "$schema": "../schema.json",
  "name": "dev.ahmedshaikh/blog",
  "title": "Ahmed Shaikh's Blog",
  "category": "Security & Identity",
  "description": "Search and read Ahmed Shaikh's blog posts on AI, cybersecurity, data breaches and new tech tools.",
  "tools": [
    {
      "name": "search_posts",
      "description": "Full-text search across every blog post (title, description, headings, FAQs and body). Returns the best matches with URL, date, description and a snippet around the match.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Search terms, e.g. \"sql injection\" or \"CVE-2026-109618\"."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 5,
            "description": "Maximum results (default 5)."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_post",
      "description": "Returns one post in full as Markdown, including its FAQ section. Pass the slug from search_posts / list_posts, or the post's URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Post slug (e.g. \"what-is-ransomware\") or full post URL."
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_posts",
      "description": "Lists published posts, newest first, with URL, date and description.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "description": "Maximum posts (default 50)."
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "dev.ahmedshaikh/blog",
    "version": "1.0.0",
    "remoteUrl": "https://ahmedshaikh.dev/mcp",
    "publishedAt": "2026-11-22T07:31:46.046691Z",
    "fetchedAt": "2026-11-22T12:49:37.224Z",
    "toolsSha256": "a48f9a32d62f49877e59737e436e358c79cb06ee4c17ff632227b9378fb1c82f"
  }
}
