{
  "$schema": "../schema.json",
  "name": "com.lexopti/docs",
  "title": "LexOpti developer documentation",
  "category": "Vector DBs & AI Search",
  "description": "Search and read the LexOpti API, SDK and embedding documentation (en, fr).",
  "tools": [
    {
      "name": "search_docs",
      "description": "Searches the LexOpti developer documentation (guides, SDK, API operations). Returns the best sections with their URL and a snippet.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "lang": {
            "default": "en",
            "description": "Language of the documentation: en (default) or fr.",
            "type": "string",
            "enum": [
              "en",
              "fr"
            ]
          },
          "limit": {
            "default": 5,
            "description": "How many results, 1 to 10 (5 by default).",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "What to look for."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
