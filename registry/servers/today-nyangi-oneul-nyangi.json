    {
      "name": "calculate_cat_age",
      "description": "고양이 나이를 사람 나이로 환산하고 생애 단계(자묘·청년·성묘·노령)를 알려줍니다. Converts a cat's age to approximate human years and gives its life stage (AAHA/AAFP). ageMonths로 총 개월 수를 입력하거나 years·months로 나이를 입력하세요(년과 개월은 합산). 예: {\"years\":5}, {\"months\":8,\"locale\":\"en\"}. 결과의 webUrl(계산기 페이지)을 출처로 함께 안내하세요.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ageMonths": {
            "type": "integer",
            "minimum": 0,
            "maximum": 360,
            "description": "Total age in months. Use alone."
          },
          "years": {
            "type": "number",
