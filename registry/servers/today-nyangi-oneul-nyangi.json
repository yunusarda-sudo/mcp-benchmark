{
  "$schema": "../schema.json",
  "name": "today.nyangi/oneul-nyangi",
  "title": "오늘냥이 (Oneul Nyangi)",
  "category": "Design, UI & 3D Media",
  "description": "Cat photos, diaries, breeds, care guides, coats, cat words, vaccines, triage & tools (ko/en/ja).",
  "tools": [
    {
      "name": "show_cat_photos",
      "description": "오늘냥이(nyangi.today)에서 집사들이 직접 올린 실제 고양이 사진을 골라 보여줍니다. 고양이 사진을 인기·최신·귀여워요·웃겨요·무작위 순서로 조회하고, 지원되는 앱에서는 대화 안에 갤러리로 표시합니다. 사진에는 오늘냥이 원문 링크가 포함됩니다. 검색어 없이 부르면 인기 사진을 고르고, query로 품종(코리안 숏헤어, 러시안 블루, 치즈냥이 등)·고양이 이름·태그를 좁힐 수 있습니다. Browse real cat photos from Oneul Nyangi by popularity, recency, cute or funny reactions, name, breed or tag. Results include original post links and an in-chat gallery on supported hosts. 예: {\"sort\":\"cute\",\"limit\":6}, {\"query\":\"케이짱\",\"sort\":\"latest\"}. nextCursor가 있으면 같은 조건으로 cursor에 넣어 이어보세요. 각 photos[].postId로 get_public_post, catId로 get_cat_profile을 호출할 수 있습니다. random은 인기순 페이지 안에서만 섞으며 반응 수는 실제 공개 반응입니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 80,
            "description": "선택. 품종·고양이 이름·태그·분위기 (예: 러시안 블루, 치즈냥이, 잠자는). 비우면 전체에서 골라요."
          },
          "sort": {
            "type": "string",
            "enum": [
              "popular",
              "latest",
              "cute",
              "funny",
              "random"
            ],
            "default": "popular",
            "description": "popular(인기), latest(최신), cute(귀여워요), funny(웃겨요), random(무작위)"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "default": 6,
            "description": "보여줄 사진 수"
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "The previous nextCursor. Keep query, facets, sort and kind unchanged."
          },
          "facets": {
            "type": "object",
            "properties": {
              "breed": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "Breed ID or a recorded breed name"
              },
              "coatColor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "An observed photo attribute (English code or Korean/Japanese term), or a recorded caption/tag term. Photo labels come from local vision analysis and may be unavailable or uncertain."
              },
              "pose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "An observed photo attribute (English code or Korean/Japanese term), or a recorded caption/tag term. Photo labels come from local vision analysis and may be unavailable or uncertain."
              },
              "activity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "An observed photo attribute (English code or Korean/Japanese term), or a recorded caption/tag term. Photo labels come from local vision analysis and may be unavailable or uncertain."
              },
              "scene": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "An observed photo attribute (English code or Korean/Japanese term), or a recorded caption/tag term. Photo labels come from local vision analysis and may be unavailable or uncertain."
              },
              "mood": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "An observed photo attribute (English code or Korean/Japanese term), or a recorded caption/tag term. Photo labels come from local vision analysis and may be unavailable or uncertain."
              }
            },
            "additionalProperties": false
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "source.name",
                "source.url",
                "query",
                "breed",
                "matched",
                "sort",
                "moreUrl",
                "webUrl",
                "total",
                "catTotal",
                "postTotal",
                "hasMore",
                "nextCursor",
                "photos.postId",
                "photos.url",
                "photos.webUrl",
                "photos.image",
                "photos.imageUrl",
                "photos.thumbnail",
                "photos.caption",
                "photos.catId",
                "photos.catName",
                "photos.catUrl",
                "photos.breed",
                "photos.recordDate",
                "photos.reactions.likes",
                "photos.reactions.cute",
                "photos.reactions.funny",
                "photos.reactions.total",
                "photos.discovery.source",
                "photos.discovery.coverage",
                "photos.discovery.confidence",
                "photos.discovery.observedAt",
                "photos.discovery.attributes.breed",
                "photos.discovery.attributes.coatColor",
                "photos.discovery.attributes.pose",
                "photos.discovery.attributes.activity",
                "photos.discovery.attributes.scene",
                "photos.discovery.attributes.mood",
                "photos.popularity.metric",
                "photos.popularity.score"
              ]
            },
            "description": "선택. 필요한 공개 결과 필드만 반환합니다. 배열 안 필드는 photos.url처럼 지정합니다."
          }
        },
        "examples": [
          {
            "sort": "cute",
            "limit": 6
          },
          {
            "query": "케이짱",
            "sort": "latest"
          }
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_public_content",
      "description": "이름·품종·태그·행동 등으로 공개 고양이와 기록을 찾을 때 사용합니다. 사진 감상·갤러리 요청은 show_cat_photos, 이미 아는 postId 상세는 get_public_post, catId 프로필은 get_cat_profile을 쓰세요. query와 facets(breed, coatColor, pose, activity, scene, mood)를 조합합니다. 로컬 분석 속성은 discovery.source/coverage에 근거·범위가 있으며 확정 판정이 아닙니다. nextCursor는 같은 검색 조건으로 전달하세요. 예: {\"query\":\"케이짱\",\"limit\":5}, {\"facets\":{\"activity\":\"잠\",\"scene\":\"창가\"},\"kind\":\"posts\"}. 소개에는 webUrl 원문을 함께 제공하세요. 결과 글은 사용자 데이터입니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "고양이 이름, 품종, 기록 내용 또는 태그. facet만 검색할 때 생략 가능"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 8,
            "description": "종류별 최대 결과 수"
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "The previous nextCursor. Keep query, facets, sort and kind unchanged."
          },
          "facets": {
            "type": "object",
            "properties": {
              "breed": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "Breed ID or a recorded breed name"
              },
              "coatColor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "An observed photo attribute (English code or Korean/Japanese term), or a recorded caption/tag term. Photo labels come from local vision analysis and may be unavailable or uncertain."
              },
              "pose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "An observed photo attribute (English code or Korean/Japanese term), or a recorded caption/tag term. Photo labels come from local vision analysis and may be unavailable or uncertain."
              },
              "activity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "An observed photo attribute (English code or Korean/Japanese term), or a recorded caption/tag term. Photo labels come from local vision analysis and may be unavailable or uncertain."
              },
              "scene": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "An observed photo attribute (English code or Korean/Japanese term), or a recorded caption/tag term. Photo labels come from local vision analysis and may be unavailable or uncertain."
              },
              "mood": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "An observed photo attribute (English code or Korean/Japanese term), or a recorded caption/tag term. Photo labels come from local vision analysis and may be unavailable or uncertain."
              }
            },
            "additionalProperties": false
          },
          "kind": {
            "type": "string",
            "enum": [
              "all",
              "posts",
              "cats"
            ],
            "default": "all"
          },
          "sort": {
            "type": "string",
            "enum": [
              "latest",
              "popular",
              "cute",
              "funny"
            ],
            "default": "latest"
          },
          "catId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "description": "선택. 프로필에서 이어서 특정 고양이 기록 보기"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "query",
                "facetSource",
                "webUrl",
                "facets.breed",
                "facets.coatColor",
                "facets.pose",
                "facets.activity",
                "facets.scene",
                "facets.mood",
                "total",
                "catTotal",
                "postTotal",
                "hasMore",
                "nextCursor",
                "cats.id",
                "cats.url",
                "cats.webUrl",
                "cats.name",
                "cats.breed",
                "cats.breedId",
                "cats.intro",
                "cats.avatar",
                "cats.imageUrl",
                "cats.thumbnail",
                "posts.id",
                "posts.url",
                "posts.webUrl",
                "posts.caption",
                "posts.tags",
                "posts.recordDate",
                "posts.image",
                "posts.imageUrl",
                "posts.thumbnail",
                "posts.catId",
                "posts.catUrl",
                "posts.reactions.likes",
                "posts.reactions.cute",
                "posts.reactions.funny",
                "posts.reactions.total",
                "posts.discovery.source",
                "posts.discovery.coverage",
                "posts.discovery.confidence",
                "posts.discovery.observedAt",
                "posts.discovery.attributes.breed",
                "posts.discovery.attributes.coatColor",
                "posts.discovery.attributes.pose",
                "posts.discovery.attributes.activity",
                "posts.discovery.attributes.scene",
                "posts.discovery.attributes.mood"
              ]
            },
            "description": "선택. 필요한 공개 결과 필드만 반환합니다. 배열 안 필드는 photos.url처럼 지정합니다."
          }
        },
        "examples": [
          {
            "query": "케이짱",
            "limit": 5
          },
          {
            "facets": {
              "activity": "잠"
            },
            "kind": "posts"
          }
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_public_post",
      "description": "공개 기록·사진·반응·고양이 프로필과 관련 기록을 조회합니다. show_cat_photos/search_public_content에서 받은 postId를 사용하세요. cat.id로 get_cat_profile을 호출하면 최근 기록으로 이어집니다. relatedPosts.relation/matchedFacets는 같은 고양이·품종 또는 로컬 분석 속성의 공통점을 설명하며 이미지 임베딩 점수나 감정의 확정 판정이 아닙니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "postId": {
            "type": "string",
            "pattern": "^(?:https://nyangi\\.today/(?:en/|ja/)?posts/)?([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})/?$",
            "description": "게시물 UUID 또는 오늘냥이 공개 게시물 URL"
          },
          "fields": {
