    {
      "name": "estimate_cat_food",
      "description": "Estimate a healthy cat's daily calories, portions and total water including food moisture. Supports dry, mixed and wet-only feeding (건식·혼합·습식만). Use the food label. Wet-only requires calories and grams per pack; mixed uses the specified wet servings and calculates the remaining dry portion. The dry default is 3,800 kcal/kg. Cite webUrl and offer calculatorUrl to reopen the same settings when present. For weight loss, illness, pregnancy or therapeutic diets, refer the user to a veterinarian.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "weightKg": {
            "type": "number",
            "minimum": 0.3,
            "maximum": 20,
            "description": "고양이 몸무게(kg)"
          },
          "status": {
            "type": "string",
            "enum": [
              "neutered_adult",
              "intact_adult",
              "inactive_obese_prone",
              "growing_kitten"
            ],
            "default": "neutered_adult",
            "description": "neutered_adult 중성화 성묘 / intact_adult 중성화 안 한 성묘 / inactive_obese_prone 체중이 늘기 쉬운 성묘 / growing_kitten 성장기 자묘"
          },
          "mode": {
            "type": "string",
            "enum": [
              "dry",
              "mixed",
              "wet"
            ],
            "description": "dry 건식만 / mixed 건식과 습식 / wet 습식만. If omitted, a positive wetFoodPouches selects mixed; otherwise dry."
          },
          "dryFoodKcalPerKg": {
            "type": "number",
            "minimum": 2000,
            "maximum": 6000,
            "default": 3800,
            "description": "건식 사료 1kg당 열량(kcal). 포장 표기 기준"
          },
          "wetFoodPouches": {
            "type": "number",
            "minimum": 0,
