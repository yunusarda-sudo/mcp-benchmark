{
  "$schema": "../schema.json",
  "name": "com.blacklinelimousineservice/booking",
  "title": "BlackLine Limousine Service",
  "category": "Vector DBs & AI Search",
  "description": "BlackLine Limousine Service: search chauffeur coverage, read local guides and request bookings.",
  "tools": [
    {
      "name": "search_coverage",
      "description": "Find BlackLine Limousine Service pages for an airport (IATA code or name), FBO, hotel, train station, cruise port, city, country, event, service or travel topic. Returns titles, summaries and URLs (with Markdown versions).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "e.g. \"JFK\", \"Heathrow\", \"Ritz Paris\", \"Port of Miami\", \"Davos delegation\""
          },
          "section": {
            "type": "string",
            "enum": [
              "airports",
              "fbo-private-jet",
              "hotels",
              "train-stations",
              "cruise-ports",
              "events",
              "corporate",
              "government-delegations",
              "attractions",
              "services",
              "blog"
            ],
            "description": "Optional filter"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 8
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_page",
      "description": "Return the Markdown text of an BlackLine Limousine Service page: meeting points, terminals, drive times, tips and FAQ. Accepts a full URL or a path such as /airports/heathrow-airport-lhr/.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "get_booking_options",
      "description": "Services, vehicle classes, what is included, contact channels, the instant-quote web booker link and booking policies.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "request_booking",
      "description": "Send a chauffeured transfer request to the 24/7 dispatch desk for the traveller. Only call when the traveller explicitly asked to book. Returns a reference (BLS-XXXXXXX); the desk then confirms price, vehicle and chauffeur by email or phone. It is not a confirmed booking until then.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Lead passenger full name"
          },
          "email": {
            "type": "string",
            "description": "Email (email or phone required)"
          },
          "phone": {
            "type": "string",
            "description": "Mobile with country code"
          },
          "service": {
            "type": "string",
            "enum": [
              "Airport pickup",
              "Airport drop-off",
              "FBO / private jet",
              "Cruise port",
              "Train station",
              "Hourly / as directed",
              "Monthly chauffeur",
              "Film / TV production",
              "Celebrity / artist (discreet)",
              "HNWI / family office",
              "Government delegation",
              "Consulate / embassy",
              "Corporate / roadshow",
              "Event / gala",
              "Wedding",
              "Travel desk (air, hotel, package)"
            ]
          },
          "pickup": {
            "type": "string",
            "description": "Airport code + terminal, FBO, hotel name or full address"
          },
          "dropoff": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "description": "Local pickup date YYYY-MM-DD"
          },
          "time": {
            "type": "string",
            "description": "Local pickup time HH:MM (for arrivals, the scheduled landing time)"
          },
          "flight": {
            "type": "string",
            "description": "Flight, train or ship identifier"
          },
          "passengers": {
            "type": "integer",
            "minimum": 1
          },
          "bags": {
            "type": "integer",
            "minimum": 0
          },
          "vehicle": {
            "type": "string",
            "enum": [
              "Luxury sedan",
              "Executive sedan",
              "SUV",
              "Sprinter",
              "Stretch limousine",
              "Coach",
              "Multiple vehicles"
            ]
          },
          "return": {
            "type": "string",
            "description": "Return trip details, if any"
          },
          "notes": {
            "type": "string",
            "description": "Child seats, accessibility, sign name, confidentiality, etc."
          },
          "agent": {
            "type": "string",
            "description": "Name of your assistant or app"
          },
          "consent": {
            "type": "string",
            "enum": [
              "yes"
            ],
            "description": "The traveller explicitly asked for this booking"
          }
        },
        "required": [
          "name",
          "pickup",
          "dropoff",
          "date",
          "time",
          "consent"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.blacklinelimousineservice/booking",
    "version": "1.0.0",
    "remoteUrl": "https://blacklinelimousineservice.com/api/mcp.php",
    "publishedAt": "2026-11-24T13:54:12.880311Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "e9d1d80e6bc4af9a6897c3852effc960d232e56f3d992e659702f1fb0fe7bd89"
  }
}
