{
  "$schema": "../schema.json",
  "name": "io.github.Vizzie-org/vizzie",
  "title": "Vizzie",
  "category": "Developer Tools & DevOps",
  "description": "Find open government data for a place, identify area codes, and make maps that open in Vizzie.",
  "repository": "https://github.com/Vizzie-org/vizzie-mcp",
  "tools": [
    {
      "name": "search_datasets",
      "description": "Find open government datasets and census maps about a topic in a place, across hundreds of national, state and city data portals. Returns each dataset's licence (with how sure it is), whether Vizzie can map it, and a link to open it in Vizzie; census topics come first as ready-made map links. The place resolves most reliably with its country code.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "What the data is about, e.g. \"street trees\", \"median rent\", \"bike lanes\"."
          },
          "place": {
            "description": "A suburb, city, county or region, e.g. \"Fitzroy VIC\", \"Seattle WA\".",
            "type": "string"
          },
          "country": {
            "type": "string",
            "description": "Two-letter country code, e.g. \"AU\", \"US\", \"GB\"."
          },
          "licence": {
            "description": "\"open\" (default) hides datasets whose licence Vizzie may not pass on.",
            "type": "string",
            "enum": [
              "open",
              "any"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "describe_dataset",
      "description": "What a dataset from search_datasets contains: each column's meaning, type, role and unit, its licence, and the boundaries it joins to. Takes the result's `ref` unchanged.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "description": "The `ref` from a search_datasets result."
          }
        },
        "required": [
          "ref"
        ]
      }
    },
    {
      "name": "resolve_geography",
      "description": "Given a column of area codes (e.g. LSOA, SA2, census tract, LGA, NUTS), say which geography level and vintage they are, what share match, and whether Vizzie can provide the boundaries. Checks every code, not a sample.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "codes": {
            "maxItems": 5000,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The area codes, up to 5,000."
          },
          "country": {
            "type": "string",
            "description": "Two-letter country code, e.g. \"AU\", \"US\", \"GB\"."
          },
          "column_name": {
            "description": "The column's name, which helps tell similar code systems apart.",
            "type": "string"
          }
        },
        "required": [
          "codes"
        ]
      }
    },
    {
      "name": "get_boundaries",
      "description": "Boundary polygons as GeoJSON for a list of area codes or a bounding box, at a named level (from resolve_geography). Only for boundaries whose licence lets Vizzie pass them on; attribution included. Capped at 2,000 areas per call; create_map draws data on a map without transferring geometry.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "description": "Two-letter country code, e.g. \"AU\", \"US\", \"GB\"."
          },
          "level": {
            "type": "string",
            "description": "The level, e.g. \"SA2\", \"LSOA\", \"TRACT\", \"LGA\"."
          },
          "vintage": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "codes": {
            "maxItems": 2000,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bbox": {
            "description": "[west, south, east, north] in degrees.",
            "minItems": 4,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "detail": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "full"
            ]
          }
        },
        "required": [
          "country",
          "level"
        ]
      }
    },
    {
      "name": "get_catchment",
      "description": "The catchment around an address or a set of points or shapes: everywhere within a straight-line distance, or an isochrone — how far you can walk or drive along roads. Returns the polygons as GeoJSON (one per origin, or merged) and a map_url that opens the catchment in Vizzie. Up to 10 km (5 mi).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "address": {
            "description": "A place to measure from, e.g. \"1 Martin Place, Sydney\". Send this or `origins`.",
            "type": "string"
          },
          "country": {
            "description": "The address's country.",
            "type": "string"
          },
          "origins": {
            "description": "Points ({ lat, lon }) or GeoJSON geometries to measure from: up to 1,000, or 100 for isochrones. A polygon grows outward from its edge.",
            "maxItems": 1000,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "lat": {
                      "type": "number"
                    },
                    "lon": {
                      "type": "number"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "lat",
                    "lon"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "Point",
                        "MultiPoint",
                        "LineString",
                        "MultiLineString",
                        "Polygon",
                        "MultiPolygon"
                      ]
                    },
                    "coordinates": {
                      "type": "array",
                      "items": {}
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "coordinates"
                  ]
                }
              ]
            }
          },
          "method": {
            "description": "\"basic\" (default): straight-line distance. \"isochrone\": distance along roads.",
            "type": "string",
            "enum": [
              "basic",
              "isochrone"
            ]
          },
          "mode": {
            "description": "Isochrones: \"walk\" (default) or \"drive\".",
            "type": "string",
            "enum": [
              "walk",
              "drive"
            ]
          },
          "distance": {
            "type": "number",
            "description": "How far: 0.1–10 km or 0.1–5 mi."
          },
          "unit": {
            "description": "\"km\" (default) or \"mi\".",
            "type": "string",
            "enum": [
              "km",
              "mi"
            ]
          },
          "merge": {
            "description": "Merge overlapping catchments into one area.",
            "type": "boolean"
          },
          "title": {
            "description": "The map's title.",
            "type": "string"
          },
          "map": {
            "description": "Also make a map link (default true).",
            "type": "boolean"
          }
        },
        "required": [
          "distance"
        ]
      }
    },
    {
      "name": "create_map",
      "description": "Make a map someone can open in Vizzie with one link, and that edit_map can change afterwards. source \"census\": a census topic for a place. source \"rows\": your own table of area codes and values, joined to boundaries (the geography is worked out from the codes if you leave it out) — up to 5,000 rows, numbers in value_column. source \"layers\": up to five of those in one map, top first, each with its own place, level, colours and words. source \"dataset\": a dataset from search_datasets, opened in Vizzie to map (a link, not a kept map). A rows map can carry a `catchment` (as get_catchment) and crop to it. Returns map_url and the layers' ids. The map isn't saved to an account until save_map or edit_map.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "census",
              "rows",
              "layers",
              "dataset"
            ]
          },
          "title": {
            "description": "The map's title (needed for rows and layers).",
            "type": "string"
          },
          "topic": {
            "description": "census: the topic, e.g. \"median rent\".",
            "type": "string"
          },
          "place": {
            "description": "census: the place, e.g. \"Colorado\", \"Denver CO\".",
            "type": "string"
          },
          "bbox": {
            "description": "census: [west, south, east, north] instead of a place's own extent, e.g. a metro wider than its city. Needs country.",
            "minItems": 4,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "level": {
            "description": "census: a level to draw at, from the `levels` a census result lists (e.g. \"SA2\", \"COUNTY\", \"TRACT\", \"LSOA\"). Left out, Vizzie chooses.",
            "type": "string"
          },
          "country": {
            "description": "census: the place's country.",
            "type": "string"
          },
          "rows": {
            "description": "rows: the table, one object per area.",
            "maxItems": 5000,
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "null"
                ]
              }
            }
          },
          "code_column": {
            "description": "rows: the column holding area codes.",
            "type": "string"
          },
          "value_column": {
            "description": "rows: the numeric column to shade by.",
            "type": "string"
          },
          "geography": {
            "description": "rows: the boundary level, if known (resolve_geography).",
            "type": "object",
            "properties": {
              "country": {
                "type": "string"
              },
              "level": {
                "type": "string"
              },
              "vintage": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "country",
              "level"
            ]
          },
          "ref": {
            "description": "dataset: the `ref` from search_datasets. rows: the `ref` of the dataset the rows came from, if they came from one.",
            "type": "string"
          },
          "layers": {
            "description": "layers: the map's layers, top first.",
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "enum": [
                    "census",
                    "rows"
                  ]
                },
                "title": {
                  "description": "The layer's name in the key.",
                  "type": "string"
                },
                "topic": {
                  "description": "census: the topic, e.g. \"median rent\".",
                  "type": "string"
                },
                "place": {
                  "description": "census: the place, e.g. \"Colorado\", \"Denver CO\".",
                  "type": "string"
                },
                "bbox": {
                  "description": "census: [west, south, east, north] instead of a place's own extent, e.g. a metro wider than its city. Needs country.",
                  "minItems": 4,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "level": {
                  "description": "census: a level to draw at, from the `levels` a census result lists (e.g. \"SA2\", \"COUNTY\", \"TRACT\", \"LSOA\"). Left out, Vizzie chooses.",
                  "type": "string"
                },
                "country": {
                  "description": "census: the place's country.",
                  "type": "string"
                },
                "rows": {
                  "description": "rows: the table, one object per area.",
                  "maxItems": 5000,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "null"
                      ]
                    }
                  }
                },
                "code_column": {
                  "description": "rows: the column holding area codes.",
                  "type": "string"
                },
                "value_column": {
                  "description": "rows: the numeric column to shade by.",
                  "type": "string"
                },
                "geography": {
                  "description": "rows: the boundary level, if known (resolve_geography).",
                  "type": "object",
                  "properties": {
                    "country": {
                      "type": "string"
                    },
                    "level": {
                      "type": "string"
                    },
                    "vintage": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "country",
                    "level"
                  ]
                },
                "ref": {
                  "description": "rows: the `ref` of the dataset the rows came from, if they came from one.",
                  "type": "string"
                },
                "legend_title": {
                  "description": "What the colours measure, in the key, e.g. \"Median rent, $ a month\".",
                  "type": "string"
                },
                "note": {
                  "description": "A line in the key saying what to see (up to 120 characters).",
                  "type": "string"
                },
                "style": {
                  "type": "object",
                  "properties": {
                    "ramp": {
                      "type": "string",
                      "enum": [
                        "viridis",
                        "cividis",
                        "blues",
                        "greens",
                        "magma",
                        "cool-warm",
                        "blue-red",
                        "teal-brown"
                      ]
                    },
                    "colors": {
                      "description": "A two-colour gradient, low to high, e.g. [\"#f1eef6\", \"#810f7c\"]. Wins over ramp.",
                      "minItems": 2,
                      "maxItems": 2,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "classify": {
                      "type": "string",
                      "enum": [
                        "continuous",
                        "natural-breaks",
                        "fixed"
                      ]
                    },
                    "classes": {
                      "description": "How many classes, cut where the data separates.",
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 10
                    },
                    "breaks": {
                      "description": "The values the classes change at, low to high: four breaks make five classes.",
                      "minItems": 1,
                      "maxItems": 9,
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    },
                    "reverse": {
                      "type": "boolean"
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 1
                    }
                  },
                  "description": "Send only what changes."
                },
                "visible": {
                  "description": "false adds it switched off.",
                  "type": "boolean"
                }
              },
              "required": [
                "source"
              ]
            }
          },
          "legend_title": {
            "description": "What the colours measure, in the key, e.g. \"Median rent, $ a month\".",
            "type": "string"
          },
          "note": {
            "description": "A line in the key saying what to see (up to 120 characters).",
            "type": "string"
          },
          "catchment": {
            "description": "rows: a catchment drawn over the map — the same fields as get_catchment.",
            "type": "object",
            "properties": {
              "address": {
                "description": "A place to measure from, e.g. \"1 Martin Place, Sydney\". Send this or `origins`.",
                "type": "string"
              },
              "country": {
                "description": "The address's country.",
                "type": "string"
              },
              "origins": {
                "description": "Points ({ lat, lon }) or GeoJSON geometries to measure from: up to 1,000, or 100 for isochrones. A polygon grows outward from its edge.",
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "lat": {
                          "type": "number"
                        },
                        "lon": {
                          "type": "number"
                        },
                        "label": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "lat",
                        "lon"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "Point",
                            "MultiPoint",
                            "LineString",
                            "MultiLineString",
                            "Polygon",
                            "MultiPolygon"
                          ]
                        },
                        "coordinates": {
                          "type": "array",
                          "items": {}
                        },
                        "label": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "coordinates"
                      ]
                    }
                  ]
                }
              },
              "method": {
                "description": "\"basic\" (default): straight-line distance. \"isochrone\": distance along roads.",
                "type": "string",
                "enum": [
                  "basic",
                  "isochrone"
                ]
              },
              "mode": {
                "description": "Isochrones: \"walk\" (default) or \"drive\".",
                "type": "string",
                "enum": [
                  "walk",
                  "drive"
                ]
              },
              "distance": {
                "type": "number",
                "description": "How far: 0.1–10 km or 0.1–5 mi."
              },
              "unit": {
                "description": "\"km\" (default) or \"mi\".",
                "type": "string",
                "enum": [
                  "km",
                  "mi"
                ]
              },
              "merge": {
                "description": "Merge overlapping catchments into one area.",
                "type": "boolean"
              }
            },
            "required": [
              "distance"
            ]
          },
          "crop_to_catchment": {
            "description": "rows: keep only the areas that touch the catchment.",
            "type": "boolean"
          },
          "style": {
            "type": "object",
            "properties": {
              "ramp": {
                "type": "string",
                "enum": [
                  "viridis",
                  "cividis",
                  "blues",
                  "greens",
                  "magma",
                  "cool-warm",
                  "blue-red",
                  "teal-brown"
                ]
              },
              "colors": {
                "description": "A two-colour gradient, low to high, e.g. [\"#f1eef6\", \"#810f7c\"]. Wins over ramp.",
                "minItems": 2,
                "maxItems": 2,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "classify": {
                "type": "string",
                "enum": [
                  "continuous",
                  "natural-breaks",
                  "fixed"
                ]
              },
              "classes": {
                "description": "How many classes, cut where the data separates.",
                "type": "integer",
                "minimum": 2,
                "maximum": 10
              },
              "breaks": {
                "description": "The values the classes change at, low to high: four breaks make five classes.",
                "minItems": 1,
                "maxItems": 9,
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "reverse": {
                "type": "boolean"
              },
              "opacity": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 1
              }
            },
            "description": "Send only what changes."
          }
        },
        "required": [
          "source"
        ]
      }
    },
    {
      "name": "save_map",
      "description": "Keep a map made with create_map in the person's Vizzie account, so it doesn't expire after 30 days and is listed on their projects page. It counts as one of their plan's projects. Needs the person to sign in to Vizzie (free); the first call starts the sign-in.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "map": {
            "type": "string",
            "description": "The map's `token` or `map_url`, from create_map."
          }
        },
        "required": [
          "map"
        ]
      }
    },
    {
      "name": "edit_map",
      "description": "Change a map already made with create_map, in place — same link, and a Vizzie window with it open redraws within seconds. Its title; a layer's colours, classes or breaks, legend title and note; a census layer's topic, place, bbox or level; a table's values. add_layers puts new layers on top (up to five in a map), remove_layers and order change the rest. Send only what changes. Saves the map to the person's Vizzie account; needs them to sign in (free).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "map": {
            "type": "string",
            "description": "The map's `token` or `map_url`, from create_map."
          },
          "title": {
            "description": "The map's title, or with `layer` that layer's name in the key.",
            "type": "string"
          },
          "layer": {
            "description": "The id (from `layers`) of the layer the other fields change. A map of one layer doesn't need it.",
            "type": "string"
          },
          "style": {
            "type": "object",
            "properties": {
              "ramp": {
                "type": "string",
                "enum": [
                  "viridis",
                  "cividis",
                  "blues",
                  "greens",
                  "magma",
                  "cool-warm",
                  "blue-red",
                  "teal-brown"
                ]
              },
              "colors": {
                "description": "A two-colour gradient, low to high, e.g. [\"#f1eef6\", \"#810f7c\"]. Wins over ramp.",
