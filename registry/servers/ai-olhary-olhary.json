{
  "$schema": "../schema.json",
  "name": "ai.olhary/olhary",
  "title": "Olhary",
  "category": "E-Commerce & Retail",
  "description": "Search Brazil's public tenders, check company sanctions and find catalog codes on Olhary.",
  "tools": [
    {
      "name": "search_procurements",
      "description": "Search Olhary's PNCP index for tenders, price-register agreements and contracts. Sources may be incomplete or delayed. A text query is sent to Google's Gemini API to find similar results. Some of those calls may run on Google's free plan, where Google may use the text to improve its products. Leave query out and search with filters only to send no text. Each call counts toward your account's per-minute request limit.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500
          },
          "facets": {
            "type": "object",
            "properties": {
              "entityType": {
                "type": "string",
                "enum": [
                  "compra",
                  "ata",
                  "contrato"
                ]
              },
              "scope": {
                "type": "string",
                "enum": [
                  "objeto",
                  "item"
                ]
              },
              "lifecycleStatus": {
                "type": "string",
                "enum": [
                  "recebendo_proposta",
                  "em_julgamento",
                  "encerrada",
                  "suspensa",
                  "pre"
                ]
              },
              "vigenciaStatus": {
                "type": "string",
                "enum": [
                  "vigente",
                  "nao_vigente"
                ]
              },
              "uf": {
                "type": "string",
                "enum": [
                  "AC",
                  "AL",
                  "AP",
                  "AM",
                  "BA",
                  "CE",
                  "DF",
                  "ES",
                  "GO",
                  "MA",
                  "MT",
                  "MS",
                  "MG",
                  "PA",
                  "PB",
                  "PR",
                  "PE",
                  "PI",
                  "RJ",
                  "RN",
                  "RS",
                  "RO",
                  "RR",
                  "SC",
                  "SP",
                  "SE",
                  "TO"
                ]
              },
              "municipioIbge": {
                "type": "string",
                "pattern": "^\\d{7}$"
              },
              "raioKm": {
                "type": "number",
                "minimum": 0,
                "maximum": 300
              },
              "orgaoCnpj": {
                "type": "string"
              },
              "modalidadeId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "valorMin": {
                "type": "number",
                "minimum": 0
              },
              "valorMax": {
                "type": "number",
                "minimum": 0
              },
              "dataPublicacaoAfter": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "dataPublicacaoBefore": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "permiteAdesao": {
                "type": "boolean"
              },
              "srp": {
                "type": "boolean"
              },
              "beneficioMeEpp": {
                "type": "boolean"
              },
              "esferaId": {
                "type": "string",
                "enum": [
                  "F",
                  "E",
                  "M",
                  "D",
                  "N"
                ]
              },
              "excludeTerms": {
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                }
              },
              "excludeOrgaos": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "excludeModalidades": {
                "maxItems": 13,
                "type": "array",
                "items": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          },
          "sort": {
            "type": "string",
            "enum": [
              "relevance",
              "recent",
              "value"
            ]
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_company_sanctions",
      "description": "Read CEIS, CNEP, CEPIM and leniency records for one Brazilian company CNPJ. Check verificado and fontes before interpreting an empty result: unverified or stale source data does not prove a company is clear. Records are not a finding of wrongdoing. No person or CPF lookup.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "cnpj": {
            "type": "string"
          }
        },
        "required": [
          "cnpj"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_company_procurement_performance",
      "description": "Read one company CNPJ's recorded PNCP wins, awarded values and totals by period. lowData flags limited evidence. This is a summary of PNCP records, not a complete record of all government sales.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "cnpj": {
            "type": "string"
          }
        },
        "required": [
          "cnpj"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_catalog_items",
      "description": "Find materials or services in the federal purchasing catalogs by description or official item code. Returns catalog descriptions and source freshness, not supplier details or purchase prices.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "enum": [
              "material",
              "service"
            ]
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_legislation",
      "description": "Search Olhary's stored federal legislation by text, optionally within one normaId. Returns cited passages. Check the official text before relying on a passage for a legal decision.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500
          },
          "normaId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "limit": {
            "default": 12,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_municipalities",
      "description": "Find municipalities by name and optional state (UF) in Olhary's IBGE catalog. Use municipalityIbge from a result with get_municipality. No personal records.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "uf": {
            "type": "string",
            "enum": [
              "AC",
              "AL",
              "AP",
              "AM",
              "BA",
              "CE",
              "DF",
              "ES",
              "GO",
              "MA",
              "MT",
              "MS",
              "MG",
              "PA",
              "PB",
              "PR",
              "PE",
              "PI",
              "RJ",
              "RN",
              "RS",
              "RO",
              "RR",
              "SC",
              "SP",
              "SE",
              "TO"
            ]
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_municipality",
      "description": "Read a municipality by its seven-digit IBGE code, with the latest stored population and GDP when available. GDP is in thousands of Brazilian reais. Missing economic data is not zero.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "municipalityIbge": {
            "type": "string",
            "pattern": "^\\d{7}$"
          }
        },
        "required": [
          "municipalityIbge"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_cnae",
      "description": "Read an IBGE CNAE subclass and its activity descriptions. Accepts a seven-digit code or its formatted form. This reads the classification, not the companies or people using it.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{4}-?\\d\\/?\\d{2}$"
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "ai.olhary/olhary",
    "version": "1.0.1",
    "remoteUrl": "https://api.olhary.ai/mcp",
    "publishedAt": "2026-11-26T10:50:01.692792Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "77ccead3486976d752a084b30bf27d42019510d3725af6a24c5d079ebee2ef1d"
  }
}
