{
  "$schema": "../schema.json",
  "name": "dev.coinprice/mcp",
  "title": "coinprice.dev",
  "category": "Finance, Crypto & Web3",
  "description": "Crypto prices, candles, futures and prediction odds. Price lookups work without a key.",
  "tools": [
    {
      "name": "get_price",
      "description": "Current price of one or more coins. Example: ids [\"bitcoin\",\"ethereum\"], currency \"eur\".",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "currency": {
            "description": "usd (default), eur, btc, ...",
            "type": "string"
          },
          "ids": {
            "description": "Coin ids or tickers, e.g. bitcoin, eth",
            "items": {
              "type": "string"
            },
            "maxItems": 50,
            "type": "array"
          }
        },
        "required": [
          "ids"
        ],
        "type": "object"
      }
    },
    {
      "name": "list_coins",
      "description": "Coins ranked by 24h volume, or matching a search. Example: query \"sol\", limit 5.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "description": "Default 20",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "description": "Part of a name, id or ticker",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "get_history",
      "description": "Candles for one coin. Example: id \"bitcoin\", interval \"1d\", limit 30. Needs an API key. (Add an API key to use it: https://coinprice.dev/signup)",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "description": "ISO date or time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "interval": {
            "description": "Default 1d",
            "enum": [
              "1m",
              "5m",
              "15m",
              "1h",
              "4h",
              "1d"
            ],
            "type": "string"
          },
          "limit": {
            "description": "Default 100",
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "to": {
            "description": "ISO date or time",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    },
    {
      "name": "get_markets",
      "description": "Futures markets (price, funding, open interest) or crypto prediction markets (odds). Example: type \"predictions\", coin \"bitcoin\". Needs an API key. (Add an API key to use it: https://coinprice.dev/signup)",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "coin": {
            "description": "Coin id to filter by",
            "type": "string"
          },
          "limit": {
            "description": "Default 20",
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "symbol": {
            "description": "A futures symbol, e.g. BTC (futures only)",
            "type": "string"
          },
          "type": {
            "enum": [
              "futures",
              "predictions"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      }
    },
    {
      "name": "search_docs",
      "description": "Search the API documentation. Example: query \"rate limit\".",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "dev.coinprice/mcp",
    "version": "1.0.1",
    "remoteUrl": "https://api.coinprice.dev/mcp",
    "publishedAt": "2026-11-27T16:27:12.761448Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "9492d8310e60d8373db5cecef281a6321707f063f56256c83d97e8bdcee221bd"
  }
}
