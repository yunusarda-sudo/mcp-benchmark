{
  "$schema": "../schema.json",
  "name": "com.getcluebook/cluebook",
  "title": "ClueBook Group Crossword Keepsake Book",
  "category": "Other",
  "description": "Deterministic 13x13 group crossword solver and 100-page keepsake book generator",
  "tools": [
    {
      "name": "solve_crossword_preview",
      "description": "Pack 1-3 inside-joke answers into a verified 13x13 American-style interlocking crossword grid with clean SCOWL filler.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "answer": {
                  "type": "string"
                },
                "clue": {
                  "type": "string"
                }
              },
              "required": [
                "answer"
              ]
            }
          }
        },
        "required": [
          "entries"
        ]
      }
    },
    {
      "name": "estimate_book_pricing",
      "description": "Return transparent retail pricing, shipping upgrade options, and business-day delivery lead times for ClueBook keepsake editions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tier": {
            "type": "string",
            "enum": [
              "paperback_1",
              "hardcover_1",
              "family_5"
            ]
          },
          "shippingLevel": {
            "type": "string",
            "enum": [
              "MAIL",
              "GROUND_HD",
              "PRIORITY_MAIL",
              "EXPRESS"
            ]
          }
        }
      }
    },
    {
      "name": "get_lulu_print_specs",
      "description": "Return exact Lulu 6x9 US Trade interior bleed dimensions (450x666 pt) and paperback vs casewrap hardcover cover wrap dimensions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "binding": {
            "type": "string",
            "enum": [
              "paperback",
              "hardcover"
            ]
          },
          "pageCount": {
            "type": "number",
            "minimum": 32,
            "maximum": 104,
            "description": "Even book page count (32-104; defaults to 44 sample pages)"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.getcluebook/cluebook",
    "version": "1.0.0",
    "remoteUrl": "https://getcluebook.com/api/mcp",
    "publishedAt": "2026-11-27T09:24:50.045673Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "0e7dd43197a5221012e54bb5e4e9eaefdefb1f24d6f3717e5fa45fd2db8cfca8"
  }
}
