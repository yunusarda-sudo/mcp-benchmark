{
  "$schema": "../schema.json",
  "name": "app.randomcolorgenerator/color-palette",
  "title": "RandomColorGenerator — Accessible Palette & WCAG MCP",
  "category": "Other",
  "description": "Generate accessible 5-color UI palettes and verify WCAG 2.1 AA/AAA color contrast ratios.",
  "repository": "https://github.com/yueliao11/mcp-servers",
  "tools": [
    {
      "name": "generate_accessible_palette",
      "description": "Generate a harmonious 5-color UI palette (complementary, analogous, triadic, or monochrome) with HEX, HSL, and optimal WCAG text contrast pairings.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "base_hex": {
            "type": "string",
            "description": "Base HEX color (e.g. \"#0f172a\" or \"#60a5fa\")."
          },
          "harmony": {
            "type": "string",
            "enum": [
              "complementary",
              "analogous",
              "triadic",
              "monochrome"
            ],
            "description": "Color harmony mode."
          }
        },
        "required": [
          "base_hex"
        ]
      }
    },
    {
      "name": "check_wcag_contrast",
      "description": "Calculate exact WCAG 2.1 contrast ratio between a foreground and background HEX color, reporting AA and AAA compliance for normal and large text.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "foreground_hex": {
            "type": "string",
            "description": "Text / foreground HEX color (e.g. \"#ffffff\")."
          },
          "background_hex": {
            "type": "string",
            "description": "Background HEX color (e.g. \"#0f172a\")."
          }
        },
        "required": [
          "foreground_hex",
          "background_hex"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
