{
  "$schema": "../schema.json",
  "name": "com.vigil-compliance/vigil",
  "title": "Vigil Compliance — EU AI Act, GDPR Art. 30, CSRD & NIS2/DORA",
  "category": "Security & Identity",
  "description": "Deterministic EU AI Act risk classification, GDPR Art. 30/12(3) audits, CSRD iXBRL & NIS2/DORA.",
  "repository": "https://github.com/antica-labs/vigil-mcp",
  "tools": [
    {
      "name": "classify_ai_act_system_risk",
      "description": "Classifies AI systems under EU Reg. 2024/1689 across 60 models with Art. 5 & Art. 27 FRIA verdicts in p95 135 ms (0,22 EUR, 99.6% precision).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model_or_system_identifier": {
            "type": "string",
            "minLength": 2,
            "default": "gpt-4o-enterprise-rag"
          },
          "deployment_domain_code": {
            "type": "string",
            "minLength": 2,
            "default": "GENERAL_ENTERPRISE_WORKFLOW"
          },
          "processing_purpose_summary": {
            "type": "string",
            "minLength": 3
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "audit_cross_border_transfer_schrems",
      "description": "Audits cross-border data transfers across 22 jurisdictions with SCC 2021/914 & Schrems II TIA adequacy verdicts in p95 155 ms (0,28 EUR, 99.7% precision).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "exporter_jurisdiction_code": {
            "type": "string",
            "minLength": 2,
            "default": "EU"
          },
          "importer_jurisdiction_code": {
            "type": "string",
            "minLength": 2,
            "default": "US-CA"
          },
          "transfer_mechanism_code": {
            "type": "string",
            "minLength": 2,
            "default": "SCC_2021_914_MODULE_2"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "validate_csrd_esrs_ixbrl_taxonomy",
      "description": "Pre-validates CSRD ESRS Set 1 (1,227 datapoints) & Arelle iXBRL taxonomy rules in p95 140 ms at 0,00 EUR zero-charge with 15-minute quote_token.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "esrs_standard_code": {
            "type": "string",
            "minLength": 2,
            "default": "ESRS_E1_CLIMATE"
          },
          "reported_datapoints_count": {
            "type": "integer",
            "minimum": 0,
            "default": 1180
          },
          "xades_profile_code": {
            "type": "string",
            "enum": [
              "XADES_B",
              "XADES_T",
              "XADES_LTA"
            ],
            "default": "XADES_LTA"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "certify_nis2_dora_incident_readiness",
      "description": "Certifies NIS2 Dir. 2022/2555 & DORA Reg. 2022/2554 24h/72h incident notification & XAdES-LTA archival readiness in p95 145 ms (0,25 EUR, 99.8% accuracy).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity_sector_code": {
            "type": "string",
            "minLength": 2,
            "default": "BANKING_CRD_IV"
          },
          "early_warning_hours": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 24
          },
          "incident_notification_hours": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 72
          },
          "initial_incident_deadline_iso": {
            "type": "string",
            "minLength": 10
          },
          "extended_incident_deadline_iso": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "audit_ropa_and_dpia_posture_rls",
      "description": "Audits tenant-isolated GDPR Art. 30 traitements, Art. 35 AIPDs, Art. 12(3) deadlines, and SHA-256 chains in p95 165 ms (0,30 EUR, 99.9% RLS isolation).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "register_scope_code": {
            "type": "string",
            "minLength": 1
          },
          "matter_ref": {
            "type": "string",
            "minLength": 1
          },
          "initial_dsr_deadline_iso": {
            "type": "string",
            "minLength": 10
          },
          "extended_dsr_deadline_iso": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "stage_dpo_counsel_human_escalation",
      "description": "Stages an L22 B2A2H DPO & regulatory counsel review slot in p95 190 ms at 0,00 EUR zero-charge autonomous capture (KZ-076 opposable).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "regulatory_matter_summary": {
            "type": "string",
            "minLength": 3,
            "default": "Supervisory authority CNIL / AI Office DPO review"
          },
          "counterparty_entities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "preferred_slot_iso": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "subscribe_regulatory_enforcement_drift",
      "description": "Registers an SSRF-safe L24 CNIL, EDPB, and AI Office enforcement drift webhook (1,90 EUR/mo) in p95 115 ms (RFC 3161 & Ed25519 signed).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "authority_scope_code": {
            "type": "string",
            "minLength": 2,
            "default": "CNIL_EDPB_AI_OFFICE"
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          },
          "hmac_secret_ref": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          }
        },
        "required": [
          "webhook_url"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "search",
      "description": "Searches Vigil's 22-jurisdiction regulatory matrix, EU AI Act catalog, and ESRS Set 1 standards in p95 80 ms at 0,00 EUR zero-charge.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "default": "CNIL EDPB EU AI Act"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "fetch",
      "description": "Fetches a single Vigil regulatory benchmark or jurisdiction record by ID in p95 75 ms (0,05 EUR, 0,00 EUR on miss or reviewer).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
  "source": {
    "type": "registry",
