{
  "$schema": "../schema.json",
  "name": "io.github.petrkrulis2022/touchstone-mcp",
  "category": "Developer Tools & DevOps",
  "description": "Dated SIU, the daily benchmark price of verified AI work: free index; USDC quotes on Base and Arc.",
  "repository": "https://github.com/petrkrulis2022/dated-siu-inference",
  "tools": [
    {
      "name": "get_index",
      "description": "The signed Dated SIU print. Free — citation is the business.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "get_quote",
      "description": "SIU price, exchange rate and index refs for one task class and model. Price: $0.001 USDC (707 mSIU at the 2026-11-28 Commodity print).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "task_class": {
            "type": "string"
          },
          "model": {
            "type": "string"
          }
        },
        "required": [
          "task_class",
          "model"
        ]
      }
    },
    {
      "name": "convert",
      "description": "Convert a model call's token counts into SIU and USD. Price: $0.001 USDC (707 mSIU at the 2026-11-28 Commodity print).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "model",
          "input_tokens",
          "output_tokens"
        ]
      }
    },
    {
      "name": "verify_receipt",
      "description": "Reads an on-chain settlement and returns a signed attestation. Price: $0.01 USDC (7072 mSIU at the 2026-11-28 Commodity print).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "chain": {
            "type": "string"
          },
          "tx_hash": {
            "type": "string"
          },
          "quote": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "chain",
          "tx_hash",
          "quote"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.petrkrulis2022/touchstone-mcp",
    "version": "0.2.0",
    "remoteUrl": "https://mcp.touchstoneassay.com/mcp",
    "publishedAt": "2026-11-28T08:33:01.045451Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "e63cfca8ef9a1f098c132a69d71be940e73a03871a9044fe543bfba9d07a24fa"
  }
}
