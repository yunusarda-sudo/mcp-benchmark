{
  "$schema": "../schema.json",
  "name": "com.hopwithann/route-finder",
  "title": "Hop With Ann route finder",
  "category": "Design, UI & 3D Media",
  "description": "Philippines island-hopping routes, usual ferry times and trip enquiries",
  "tools": [
    {
      "name": "find_route",
      "description": "Island-hopping route from A to B in the Philippines: legs, usual departure times, notes and a pre-filled link for the traveller to request a quote. No prices, no live availability.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "Start place, e.g. \"Cebu City\", \"Panglao\", \"Mactan airport\""
          },
          "to": {
            "type": "string",
            "description": "End place, e.g. \"Siquijor\", \"Camiguin\""
          },
          "date": {
            "type": "string",
            "description": "Travel date, YYYY-MM-DD (optional). At least 7 days ahead."
          },
          "group_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Number of travellers (optional)"
          }
        },
        "required": [
          "from",
          "to"
        ]
      }
    },
    {
      "name": "send_enquiry",
      "description": "Send the traveller's trip plan to Ann for a free quote. ONLY use after the traveller has clearly agreed to share their name and contact details with Hop With Ann. Ann replies within 24 hours (usually the same day) by email or WhatsApp. This does not book or charge anything.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "traveller_consent": {
            "type": "boolean",
            "description": "true only if the traveller has explicitly agreed to send their details to Hop With Ann"
          },
          "name": {
            "type": "string",
            "description": "Traveller name"
          },
          "email": {
            "type": "string",
            "description": "Email (email or WhatsApp needed)"
          },
          "whatsapp": {
            "type": "string",
            "description": "WhatsApp number with country code, e.g. +44 7700 900123"
          },
          "reply_by": {
            "type": "string",
            "enum": [
              "Email",
              "WhatsApp"
            ],
            "description": "How the traveller wants Ann to reply"
          },
          "from": {
            "type": "string",
            "description": "Trip start, e.g. \"Cebu City\""
          },
          "to": {
            "type": "string",
            "description": "Trip end, e.g. \"Siquijor\""
          },
          "extra_stops": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Stops in between, in order (optional)"
          },
          "start_date": {
            "type": "string",
            "description": "YYYY-MM-DD (optional)"
          },
          "end_date": {
            "type": "string",
            "description": "YYYY-MM-DD (optional)"
          },
          "group_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "country": {
            "type": "string",
            "description": "Where the traveller is from (optional)"
          },
          "message": {
            "type": "string",
            "description": "Anything else: hotels, flight times, children, luggage, special needs"
          },
          "assistant": {
            "type": "string",
            "description": "Name of the AI assistant sending this, e.g. \"ChatGPT\""
          }
        },
        "required": [
          "traveller_consent",
          "name",
          "from",
          "to"
        ]
      }
    },
    {
      "name": "list_routes",
      "description": "Every route Hop With Ann has a page for, with door-to-door time.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.hopwithann/route-finder",
    "version": "1.0.0",
    "remoteUrl": "https://hopwithann.com/api/mcp/",
    "publishedAt": "2026-11-20T04:28:31.936432Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "ff4bc5a20e8711c1fb1bc24e6524b007e90fa550fe520188eaae233cddd725da"
  }
}
