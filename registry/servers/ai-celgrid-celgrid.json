            "maxLength": 120
          },
          "width": {
            "type": "integer",
            "minimum": 4,
            "maximum": 64
          },
          "height": {
            "type": "integer",
            "minimum": 4,
            "maximum": 64
          },
          "frames": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
