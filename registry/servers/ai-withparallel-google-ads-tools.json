{
  "$schema": "../schema.json",
  "name": "ai.withparallel/google-ads-tools",
  "title": "Parallel AI for Google Ads",
  "category": "Security & Identity",
  "description": "Zero-OAuth Google Ads MCP: 30.4x pacing, CSV waste, negatives, GA4, PMax, GAQL v26 & MIT scripts.",
  "tools": [
    {
      "name": "calculate_google_ads_budget_pacing",
      "description": "Calculate Google Ads 2x daily spending limits, 30.4x monthly charging limits, month-to-date pacing variance, remaining headroom, and mid-month budget edit ceilings using deterministic billing math.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "month",
          "dailyBudget",
          "asOfDay",
          "spentToDate"
        ],
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$",
            "description": "Calendar month in YYYY-MM format (e.g. '2026-11')."
          },
          "currency": {
            "type": "string",
            "default": "USD",
            "description": "ISO currency code (default 'USD')."
          },
          "dailyBudget": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Current average daily budget amount."
          },
          "asOfDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31,
            "description": "Current day of the month (1-31)."
          },
          "spentToDate": {
            "type": "number",
            "minimum": 0,
            "description": "Cumulative spend recorded month-to-date."
          },
          "monthlyPlan": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Optional target monthly spend plan to compute the daily budget needed to land on target."
          },
          "change": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "day",
              "newDailyBudget"
            ],
            "description": "Optional mid-month daily budget edit to compute remaining-month charging ceilings.",
            "properties": {
              "day": {
                "type": "integer",
                "minimum": 1,
                "maximum": 31,
                "description": "Day of month when the daily budget changes."
              },
              "newDailyBudget": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "New average daily budget effective on change.day."
              }
            }
          }
        }
      }
    },
    {
      "name": "check_google_ads_negative_collisions",
      "description": "Test proposed [exact], \"phrase\", and broad Google Ads negative keywords against active keywords and search terms. Flags collisions blocking active keywords or converting queries and catches singular/plural close-variant misses.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "negatives"
        ],
        "properties": {
          "keywords": {
            "type": "array",
            "description": "Active positive keywords in Google Ads notation (e.g. '[plumbing repair]', '\"emergency plumber\"', 'plumber near me') or structured objects.",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "text",
                    "matchType"
                  ],
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "matchType": {
                      "type": "string",
                      "enum": [
                        "EXACT",
                        "PHRASE",
                        "BROAD"
                      ]
                    },
                    "campaign": {
                      "type": "string"
                    },
                    "adGroup": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          },
          "negatives": {
            "type": "array",
            "minItems": 1,
            "description": "Candidate negative keywords in Google Ads notation (e.g. '[free]', '\"jobs\"', 'diy') or structured objects.",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "text",
                    "matchType"
                  ],
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "matchType": {
                      "type": "string",
                      "enum": [
                        "EXACT",
                        "PHRASE",
                        "BROAD"
                      ]
                    },
                    "level": {
                      "type": "string",
                      "enum": [
                        "ACCOUNT",
                        "CAMPAIGN",
                        "AD_GROUP",
                        "LIST"
                      ]
                    },
                    "campaign": {
                      "type": "string"
                    },
                    "adGroup": {
                      "type": "string"
                    },
                    "listName": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          },
          "searchTerms": {
            "type": "array",
            "description": "Optional search term performance rows to calculate conversions and spend at risk of being blocked.",
            "items": {
              "type": "object",
              "required": [
                "searchTerm"
              ],
              "properties": {
                "searchTerm": {
                  "type": "string"
                },
                "campaign": {
                  "type": "string"
                },
                "adGroup": {
                  "type": "string"
                },
                "clicks": {
                  "type": "number",
                  "minimum": 0
                },
                "cost": {
                  "type": "number",
                  "minimum": 0
                },
                "conversions": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "scope": {
            "type": "string",
            "enum": [
              "SAME_CAMPAIGN",
              "ALL"
            ],
            "default": "ALL",
            "description": "Whether to evaluate collisions across all campaigns ('ALL') or strictly matching campaign names ('SAME_CAMPAIGN')."
          }
        }
      }
    },
    {
      "name": "debug_ga4_vs_google_ads_conversions",
      "description": "Diagnose why GA4 key events and Google Ads conversions disagree across click-date vs. event-date reporting, attribution models, counting modes, lookback windows, consent modeling, auto-tagging, and time zones.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "range",
          "ads",
          "ga4",
          "site"
        ],
        "properties": {
          "range": {
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "Start date YYYY-MM-DD."
              },
              "end": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "End date YYYY-MM-DD."
              }
            }
          },
          "ads": {
            "type": "object",
            "required": [
              "conversions"
            ],
            "properties": {
              "conversions": {
                "type": "number",
                "minimum": 0
              },
              "attribution": {
                "type": "string",
                "enum": [
                  "DATA_DRIVEN",
                  "LAST_CLICK"
                ],
                "default": "DATA_DRIVEN"
              },
              "count": {
                "type": "string",
                "enum": [
                  "ONE",
                  "EVERY"
                ],
                "default": "ONE"
              },
              "clickWindowDays": {
                "type": "integer",
                "minimum": 1,
                "maximum": 90,
                "default": 30
              },
              "source": {
                "type": "string",
                "enum": [
                  "ADS_TAG",
                  "GA4_IMPORT"
                ],
                "default": "ADS_TAG"
              },
              "timeZone": {
                "type": "string",
                "default": "America/New_York"
              }
            }
          },
          "ga4": {
            "type": "object",
            "required": [
              "keyEvents"
            ],
            "properties": {
              "keyEvents": {
                "type": "number",
                "minimum": 0
              },
              "scope": {
                "type": "string",
                "enum": [
                  "GOOGLE_CPC",
                  "GOOGLE_ADS_CHANNEL",
                  "ALL_TRAFFIC"
                ],
                "default": "GOOGLE_CPC"
              },
              "attribution": {
                "type": "string",
                "enum": [
                  "DATA_DRIVEN",
                  "PAID_AND_ORGANIC_LAST_CLICK",
                  "GOOGLE_PAID_LAST_CLICK"
                ],
                "default": "DATA_DRIVEN"
              },
              "count": {
                "type": "string",
                "enum": [
                  "ONCE_PER_EVENT",
                  "ONCE_PER_SESSION"
                ],
                "default": "ONCE_PER_EVENT"
              },
              "lookbackDays": {
                "type": "integer",
                "enum": [
                  30,
                  60,
                  90
                ],
                "default": 90
              },
              "timeZone": {
                "type": "string",
                "default": "America/New_York"
              }
            }
          },
          "site": {
            "type": "object",
            "properties": {
              "autoTagging": {
                "type": "boolean",
                "default": true
              },
              "consentMode": {
                "type": "string",
                "enum": [
                  "NONE",
                  "BASIC",
                  "ADVANCED"
                ],
                "default": "NONE"
              },
              "consentRate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "medianLagDays": {
                "type": "number",
                "minimum": 0,
                "maximum": 45,
                "default": 3
              }
            }
          }
        }
      }
    },
    {
      "name": "estimate_pmax_waste_and_lead_quality",
      "description": "Grade Google Ads Performance Max placements and search terms (either structured rows or raw Google Ads UI CSV text) for mobile-app, gaming, foreign-language, Display, and off-topic bleed, and estimate recoverable monthly spend and CPA.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "account"
        ],
        "properties": {
          "placementsCsv": {
            "type": "string",
            "description": "Optional raw Google Ads UI PMax Placement CSV text (title rows and Total footers are stripped automatically)."
          },
          "searchTermsCsv": {
            "type": "string",
            "description": "Optional raw Google Ads UI PMax Search Term Insights CSV text."
          },
          "placements": {
            "type": "array",
            "description": "Optional structured PMax placement rows.",
            "items": {
              "type": "object",
              "required": [
                "placement",
                "type",
                "impressions"
              ],
              "properties": {
                "placement": {
                  "type": "string"
                },
                "displayName": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "WEBSITE",
                    "MOBILE_APPLICATION",
                    "YOUTUBE_VIDEO",
                    "GOOGLE_OWNED"
                  ]
                },
                "impressions": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "searchTerms": {
            "type": "array",
            "description": "Optional structured PMax search term rows.",
            "items": {
              "type": "object",
              "required": [
                "searchTerm",
                "clicks",
                "cost",
                "conversions"
              ],
              "properties": {
                "searchTerm": {
                  "type": "string"
                },
                "clicks": {
                  "type": "number",
                  "minimum": 0
                },
                "cost": {
                  "type": "number",
                  "minimum": 0
                },
                "conversions": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "account": {
            "type": "object",
            "required": [
              "days",
              "cost",
              "conversions"
            ],
            "properties": {
              "currency": {
                "type": "string",
                "default": "USD"
              },
              "days": {
                "type": "integer",
                "minimum": 1,
                "maximum": 365
              },
              "cost": {
                "type": "number",
                "minimum": 0
              },
              "conversions": {
                "type": "number",
                "minimum": 0
              },
              "qualifiedLeads": {
                "type": "number",
                "minimum": 0
              },
              "languages": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [
                  "en"
                ]
              }
            }
          }
        }
      }
    },
    {
      "name": "validate_google_ads_gaql_query",
      "description": "Build and validate Google Ads Query Language (GAQL) queries against the Google Ads API v26 field catalog across campaign, search_term_view, asset_group, shopping_performance_view, and change_event resources.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gaql": {
            "type": "string",
            "description": "Raw GAQL string to parse, format, and validate against the v26 catalog (e.g. 'SELECT campaign.name, metrics.cost_micros FROM campaign WHERE segments.date DURING LAST_30_DAYS')."
          },
          "resource": {
            "type": "string",
            "enum": [
              "campaign",
              "search_term_view",
              "asset_group",
              "shopping_performance_view",
              "change_event"
            ],
            "description": "Structured GAQL resource (used when 'gaql' is omitted)."
          },
          "select": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Fields to select when building a structured query."
          },
          "where": {
            "type": "array",
            "description": "WHERE filter conditions when building a structured query.",
            "items": {
              "type": "object",
              "required": [
                "field",
                "operator"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "operator": {
                  "type": "string"
                },
                "value": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                }
              }
            }
          },
          "orderBy": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "direction"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "ASC",
                    "DESC"
                  ]
                }
              }
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        }
      }
    },
    {
      "name": "audit_google_ads_search_terms_csv",
      "description": "Deterministically audit a pasted Google Ads Search Terms CSV/TSV export (or structured rows) for zero-conversion wasted spend, high-CPA outliers, brand vs. non-brand mix, top converting terms, and 1-gram/2-gram negative keyword candidates—zero OAuth required.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "csv": {
            "type": "string",
            "description": "Raw Google Ads Search Terms report CSV or TSV text (headers such as Search term, Campaign, Ad group, Clicks, Cost, Conversions)."
          },
          "rows": {
            "type": "array",
            "description": "Optional pre-parsed search term rows instead of raw CSV text.",
            "items": {
              "type": "object",
              "required": [
                "searchTerm"
              ],
              "properties": {
                "searchTerm": {
                  "type": "string"
                },
                "campaign": {
                  "type": "string"
                },
                "adGroup": {
                  "type": "string"
                },
                "clicks": {
                  "type": "number"
                },
                "cost": {
                  "type": "number"
                },
                "conversions": {
                  "type": "number"
                }
              }
            }
          },
          "targetCpa": {
            "type": "number",
            "description": "Optional target CPA/CPL threshold used to flag high-CPA outliers (>1.5x target)."
          },
          "minWasteSpend": {
            "type": "number",
            "default": 0,
            "description": "Minimum zero-conversion spend to surface in top wasted terms."
          },
          "minWasteClicks": {
            "type": "integer",
            "default": 1,
            "description": "Minimum clicks to surface in top wasted terms."
          },
          "brandTerms": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional list of brand names/tokens to compute brand vs. non-brand spend and CPA split."
          },
          "currency": {
            "type": "string",
            "default": "USD"
          }
        }
      }
    },
    {
      "name": "lookup_google_ads_platform_changes",
      "description": "Search Parallel AI's verified, official-source-cited 2026 Google Ads platform and API changelog (AI Max for Search, Performance Max controls, Demand Gen updates, API v23–v26.2 sunsets, measurement and bidding shifts).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "track": {
            "type": "string",
            "enum": [
              "all",
              "api",
              "search-ai-max",
              "pmax",
              "demand-gen",
              "measurement"
            ],
            "default": "all",
            "description": "Optional track filter."
          },
          "impacts": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "action",
                "control",
                "reporting"
              ]
            },
            "description": "Optional impact filters (defaults to all: action, control, reporting)."
          },
          "query": {
            "type": "string",
            "description": "Optional keyword search across titles, summaries, actions, API versions, and official quotes (e.g., 'v26', 'Demand Gen', 'AI Max', 'negative')."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 12
          }
        }
      }
    },
    {
      "name": "generate_google_ads_script",
      "description": "Generate a ready-to-paste, read-only MIT-licensed Google Ads Script (`AdsApp.search` only; never mutates Google Ads) with validated CONFIG parameters for PMax placement bleed, MCC 30.4x budget pacing, wasted search terms, Shopping zombie SKUs, or conversion-drop watchdogs. Omit `slug` to list all 5 scripts and their configurable options.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string",
            "enum": [
              "pmax-placement-bleed-monitor",
              "mcc-budget-pacing-guardrail",
              "wasted-spend-search-term-auditor",
              "shopping-zombie-sku-detector",
              "conversion-drop-watchdog"
            ],
            "description": "Script slug to render. Omit to list all 5 available read-only MIT scripts and their configurable fields."
          },
          "config": {
            "type": "object",
            "description": "Optional key-value overrides for CONFIG parameters (e.g., lookbackDays, minImpressions, minCost, sheetUrl, emailTo).",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "lookup_google_ads_2026_mechanics",
      "description": "Retrieve official-source-verified 2026 Google Ads platform mechanics and vertical-agnostic audit checks covering Search Journey Awareness Secondary signals, Demand Gen silent ad-level asset automation defaults, Video vs. Image channel isolation, PMax 2026 BudgetNetworkSettings vs. Demand Gen boundaries, portfolio bidding channel limits, and SEARCH vs. AUTO custom segment dilution.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "all",
              "bidding-signals",
              "demand-gen",
              "pmax",
              "search-keywords",
              "measurement-diagnostics"
            ],
            "default": "all"
          },
          "query": {
            "type": "string",
            "description": "Optional keyword filter (e.g., 'Demand Gen', 'Secondary', 'auto-generated', 'portfolio', 'custom segment', 'PMax')."
          }
        }
      }
    }
  ],
