{
  "$schema": "../schema.json",
  "name": "com.jobpostingsapi/jobs-ats-workday-greenhouse-lever-mcp",
  "title": "JobPostingsAPI — Workday, Greenhouse & Lever Jobs MCP. Zero-signup x402 USDC",
  "category": "Jobs, Career & Learning",
  "description": "Workday, Greenhouse & Lever Jobs MCP. Zero-signup x402 USDC ($0.001) on Base or free API key.",
  "tools": [
    {
      "name": "jobs_search",
      "description": "Search 19.8M+ active direct-employer ATS & career-site job postings across 434 sources (Greenhouse, Workday, Lever, Ashby, SmartRecruiters, etc.) with USD salary, skills, remote flags, and apply URLs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "Keyword or boolean query on job title & description (e.g. \"AI Engineer\")"
          },
          "company": {
            "type": "string",
            "description": "Company name or domain filter (e.g. \"Stripe\", \"anthropic.com\")"
          },
          "source": {
            "type": "string",
            "description": "ATS or career-site slug (e.g. \"greenhouse\", \"lever\", \"ashby\", \"workday\")"
          },
          "country": {
            "type": "string",
            "description": "ISO-2 country code (e.g. \"US\", \"GB\", \"DE\", \"CA\")"
          },
          "remote": {
            "type": "boolean",
            "description": "Set to true for remote-eligible roles only"
          },
          "employment_type": {
            "type": "string",
            "description": "Employment type (full_time, contract, part_time, internship)"
          },
          "experience_level": {
            "type": "string",
            "description": "Seniority level (entry, mid, senior, lead, executive)"
          },
          "salary_min": {
            "type": "number",
            "description": "Minimum annualized USD base salary"
          },
          "skills": {
            "type": "string",
            "description": "Comma-separated canonical skills (e.g. \"python,pytorch,kubernetes\")"
          },
          "posted_after": {
            "type": "string",
            "description": "ISO-8601 date filter (e.g. \"2026-10-15\")"
          },
          "include_attributed": {
            "type": "boolean",
            "description": "Include attributed global listings alongside direct-employer ATS postings",
            "default": false
          },
          "limit": {
            "type": "number",
            "description": "Results per page (1-100)",
            "default": 20
          },
          "cursor": {
            "type": "string",
            "description": "Opaque cursor for next page"
          }
        }
      }
    },
    {
      "name": "jobs_detail",
      "description": "Retrieve the complete 26-field job posting record by ID, including full HTML/plain-text description, salary breakdown, extracted skills, and direct ATS apply URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Job ID (e.g. \"j_gh_stripe_5601881\") or direct ATS job URL"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "jobs_count",
      "description": "Count matching active job postings for hiring velocity tracking, GTM territory scoring, or pre-flight query sizing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "Search keyword query"
          },
          "company": {
            "type": "string",
            "description": "Company name or domain filter"
          },
          "source": {
            "type": "string",
            "description": "ATS source slug (e.g. \"greenhouse\", \"workday\")"
          },
          "country": {
            "type": "string",
            "description": "ISO-2 country code (e.g. \"US\", \"DE\")"
          },
          "remote": {
            "type": "boolean",
            "description": "Filter remote-eligible jobs only"
          }
        }
      }
    },
    {
      "name": "jobs_feed_new",
      "description": "Stream newly discovered job postings across 434 ATS & career portals since a relative window or ISO-8601 timestamp.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "description": "Relative window (1h, 6h, 24h, 7d) or ISO-8601 timestamp",
            "default": "6h"
          },
          "source": {
            "type": "string",
            "description": "Optional ATS source filter (e.g. \"greenhouse\", \"ashby\")"
          },
          "country": {
            "type": "string",
            "description": "Optional ISO-2 country code (e.g. \"US\", \"PL\", \"DE\")"
          },
          "limit": {
            "type": "number",
            "description": "Number of events to return (1-100)",
            "default": 25
          }
        }
      }
    },
    {
      "name": "jobs_feed_updated",
      "description": "Stream recently updated job postings (salary band revisions, location changes, or description edits) across 434 ATS sources.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "description": "Relative window (1h, 6h, 24h, 7d) or ISO-8601 timestamp",
            "default": "6h"
          },
          "source": {
            "type": "string",
            "description": "Optional ATS source filter"
          },
          "limit": {
            "type": "number",
            "description": "Number of events to return (1-100)",
            "default": 25
          }
        }
      }
    },
    {
      "name": "jobs_feed_closed",
      "description": "Stream recently closed or filled job postings with closed_at timestamps so job boards and AI agents can immediately delist expired links.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "description": "Relative window (1h, 6h, 24h, 7d) or ISO-8601 timestamp",
            "default": "24h"
          },
          "source": {
            "type": "string",
            "description": "Optional ATS source filter"
          },
          "limit": {
            "type": "number",
            "description": "Number of events to return (1-100)",
            "default": 25
          }
        }
      }
    },
    {
      "name": "company_open_jobs",
      "description": "List all active job postings for a specific company slug or domain, with optional live ETag refresh from Greenhouse, Lever, or Ashby.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "Company slug or domain (e.g. \"stripe\", \"anthropic\", \"openai.com\")"
          },
          "refresh": {
            "type": "boolean",
            "description": "Set to true to trigger a live ETag check against the company ATS board",
            "default": false
          },
          "limit": {
            "type": "number",
            "description": "Max jobs to return (1-100)",
            "default": 25
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "get_company_job_count",
      "description": "Get real-time open job count, department/country/remote/seniority breakdowns, salary disclosure count, and 24h/7d/30d hiring velocity for any company slug, domain, LinkedIn URL, or ATS URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "Company slug, domain, LinkedIn URL, or ATS URL (e.g. \"stripe\", \"stripe.com\", \"https://boards.greenhouse.io/stripe\")"
          },
          "domain": {
            "type": "string",
            "description": "Optional corporate domain (e.g. \"stripe.com\", \"anthropic.com\")"
          },
          "linkedin_url": {
            "type": "string",
            "description": "Optional LinkedIn company URL or ID (e.g. \"https://www.linkedin.com/company/stripe/\")"
          },
          "refresh": {
            "type": "boolean",
            "description": "Set to true to trigger a live ETag check against Greenhouse/Lever/Ashby",
            "default": false
          }
        }
      }
    },
    {
      "name": "detect_company_ats",
      "description": "Detect which Applicant Tracking System (Greenhouse, Lever, Ashby, Workday, etc.) a company domain uses and preview its open roles.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "Company domain or slug (e.g. \"stripe.com\", \"anthropic.com\", \"vercel.com\")"
          }
        },
        "required": [
          "domain"
        ]
      }
    }
  ],
