{
  "$schema": "../schema.json",
  "name": "Milvus MCP",
  "category": "Vector DBs & AI Search",
  "description": "Milvus MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "milvus_search",
      "description": "Search vector collection in Milvus with similarity metric parameters.",
      "inputSchema": {
        "type": "object",
        "required": [
          "collectionName",
          "vectors"
        ],
        "properties": {
          "collectionName": {
            "type": "string",
            "description": "Collection name in Milvus cluster."
          },
          "vectors": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Query vector array."
          }
        }
      }
    }
  ]
}
