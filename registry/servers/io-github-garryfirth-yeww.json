{
  "$schema": "../schema.json",
  "name": "io.github.garryfirth/yeww",
  "title": "Yeww",
  "category": "Developer Tools & DevOps",
  "description": "Mountain-sports booking marketplace. Read-only MCP for instructor availability. Book on yeww.app",
  "tools": [
    {
      "name": "search_availability",
      "description": "Search real private ski, snowboard, and mountain-bike lessons on Yeww. Dates and times are Europe/Paris. price is the final amount the customer is charged, in euros with two decimal places. Resort matching ignores case and accents. Booking happens only on the returned Yeww booking URL.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "sport": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "resort": {
            "type": "string"
          },
          "duration": {
            "type": [
              "string",
              "number"
            ]
          },
          "language": {
            "type": "string"
          },
          "instructor": {
            "type": "string"
          },
          "party": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "additionalProperties": {}
      }
    },
    {
      "name": "get_instructor",
      "description": "Look up one public Yeww instructor by the slug in their profile URL. Returns only information shown on the public profile.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      }
    }
  ],
