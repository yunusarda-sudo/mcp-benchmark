{
  "$schema": "../schema.json",
  "name": "Segment MCP",
  "category": "Observability & Analytics",
  "description": "Segment MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "track_event",
      "description": "Emit customer behavioral track event into Segment CDP customer data pipeline.",
      "inputSchema": {
        "type": "object",
        "required": [
          "userId",
          "event"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "description": "Unique user identifier."
          },
          "event": {
            "type": "string",
            "description": "Event action name."
          },
          "properties": {
            "type": "object",
            "description": "Event properties map."
          }
        }
      }
    }
  ]
}
