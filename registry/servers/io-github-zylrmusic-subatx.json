{
  "$schema": "../schema.json",
  "name": "io.github.zylrmusic/subatx",
  "title": "SubATX",
  "category": "Developer Tools & DevOps",
  "description": "Verified electronic music events in Austin, TX: what's on tonight, this weekend and later.",
  "tools": [
    {
      "name": "whats_on_tonight",
      "description": "Verified electronic music events tonight in Austin (local time), with venue, lineup, tickets and each event's subatx.com link.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market": {
            "type": "string",
            "enum": [
              "austin"
            ],
            "description": "Which city. Default austin (Austin, TX)."
          },
          "dj": {
            "type": "string",
            "description": "A DJ's name, or part of it."
          },
          "venue": {
            "type": "string",
            "description": "A venue's name, or part of it."
          },
          "genre": {
            "type": "string",
            "description": "A genre, for example \"house\" or \"techno\"."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "this_weekend",
      "description": "Verified events from Friday to Sunday: this weekend, or the next one when asked from Monday to Thursday.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market": {
            "type": "string",
            "enum": [
              "austin"
            ],
            "description": "Which city. Default austin (Austin, TX)."
          },
          "dj": {
            "type": "string",
            "description": "A DJ's name, or part of it."
          },
          "venue": {
            "type": "string",
            "description": "A venue's name, or part of it."
          },
          "genre": {
            "type": "string",
            "description": "A genre, for example \"house\" or \"techno\"."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "search_events",
      "description": "Upcoming verified events, filtered by date range, DJ, venue, genre or free text. Soonest first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "First date to include, YYYY-MM-DD."
          },
          "to": {
            "type": "string",
            "description": "Last date to include, YYYY-MM-DD."
          },
          "market": {
            "type": "string",
            "enum": [
              "austin"
            ],
            "description": "Which city. Default austin (Austin, TX)."
          },
          "dj": {
            "type": "string",
            "description": "A DJ's name, or part of it."
          },
          "venue": {
            "type": "string",
            "description": "A venue's name, or part of it."
          },
          "genre": {
            "type": "string",
            "description": "A genre, for example \"house\" or \"techno\"."
          },
          "q": {
            "type": "string",
            "description": "Free text matched against the event name, venue, promoter, genres and DJs."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "At most this many (default 20)."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_event",
      "description": "Full details of one upcoming event by its id (from another tool or a subatx.com/events/<id> link).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The event id, or its subatx.com link."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
