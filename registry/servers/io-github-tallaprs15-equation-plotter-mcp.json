{
  "$schema": "../schema.json",
  "name": "io.github.tallaprs15/equation-plotter-mcp",
  "title": "Equation Plotter",
  "category": "Developer Tools & DevOps",
  "description": "Graph equations with exact analysis: intercepts, turning points, asymptotes, conics, and a PNG.",
  "repository": "https://github.com/tallaprs15/equation-plotter-mcp",
  "tools": [
    {
      "name": "plot_equations",
      "description": "Analyse and plot one or more equations on a single set of axes.\n\nAccepted inputs (one string per equation):\n- explicit: \"y = x^2 - 3x + 2\", \"f(x) = 1/(x-2)\", bare \"x^3 - x\"\n- implicit: \"x^2 + y^2 = 25\", \"x^2/9 - y^2/4 = 1\", \"xy = 1\"\n- parametric: \"x = cos(t), y = sin(t)\"   - polar: \"r = 1 + cos(theta)\", \"r^2 = 4cos(2theta)\"\n- inequalities (shaded): \"y > x^2\", \"x^2 + y^2 <= 9\"\n- LaTeX subset: \"y = \\frac{1}{x-2}\"\nSyntax: ^ for powers, implicit multiplication (3x, 2sin x), constants pi and e, functions sin cos\ntan sec csc cot asin acos atan sinh cosh tanh exp ln log (base 10) sqrt cbrt abs floor ceil.\n\nReturns JSON text (schema version \"1.0\"; errors come back as {\"error\": {code, message}}) plus\nthe graph as an image. Ranges are [min, max]; values may be numbers or strings like \"2pi\".",
      "inputSchema": {
        "properties": {
          "equations": {
            "description": "Equations to plot together (1-8)",
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Equations",
            "type": "array"
          },
          "x_range": {
            "anyOf": [
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "[min, max]; numbers or expressions like '-2pi'",
            "title": "X Range"
          },
          "y_range": {
            "anyOf": [
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "[min, max]; numbers or expressions like '-2pi'",
            "title": "Y Range"
          },
          "t_range": {
            "anyOf": [
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Parameter range for parametric curves",
            "title": "T Range"
          },
          "theta_range": {
            "anyOf": [
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Theta range for polar curves",
            "title": "Theta Range"
          },
          "image_format": {
            "default": "png",
            "description": "png (shown inline), svg (returned base64 inside the JSON), or none",
            "enum": [
              "png",
              "svg",
              "none"
            ],
            "title": "Image Format",
            "type": "string"
          },
          "timeout": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Symbolic analysis budget in seconds (max 15)",
            "title": "Timeout"
          }
        },
        "required": [
          "equations"
        ],
        "type": "object",
        "title": "plot_equationsArguments"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.tallaprs15/equation-plotter-mcp",
    "version": "1.0.0",
    "remoteUrl": "https://equation-plotter-mcp-912770876196.australia-southeast1.run.app/mcp",
    "publishedAt": "2026-11-26T05:36:07.032087Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "2c0a63c5d097ebe2d20ee74ed9489a493f874fe34cf551c3b721885da170b86c"
  }
}
