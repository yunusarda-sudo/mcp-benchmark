{
  "$schema": "../schema.json",
  "name": "PagerDuty MCP",
  "category": "Communication & Alerting",
  "description": "PagerDuty MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "trigger_incident",
      "description": "Trigger on-call incident alert in PagerDuty with severity and details.",
      "inputSchema": {
        "type": "object",
        "required": [
          "routingKey",
          "title",
          "severity"
        ],
        "properties": {
          "routingKey": {
            "type": "string",
            "description": "PagerDuty integration service key."
          },
          "title": {
            "type": "string",
            "description": "Incident summary title."
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "error",
              "warning",
              "info"
            ],
            "description": "Incident severity."
          }
        }
      }
    }
  ]
}
