{
  "$schema": "../schema.json",
  "name": "com.formatpaperback/kdp",
  "title": "formatPaperback KDP calculators",
  "category": "Social, Media & Knowledge",
  "description": "Amazon KDP paperback trim sizes, margins, cover and spine dimensions, and royalty calculations.",
  "tools": [
    {
      "name": "kdp_trim_sizes",
      "description": "List every Amazon KDP paperback trim size (inches, mm, 300 DPI pixels, size with bleed, large-trim flag, maximum page count per paper/ink) and the minimum margins.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    },
    {
      "name": "kdp_cover_dimensions",
      "description": "Full-wrap KDP paperback cover size (bleed included) and spine width from trim size, page count and paper, in inches, mm and 300 DPI pixels.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "trim_size": {
            "default": "6x9",
            "type": "string",
            "enum": [
              "5x8",
              "5.06x7.81",
              "5.25x8",
              "5.5x8.5",
              "6x9",
              "6.14x9.21",
              "6.69x9.61",
              "7x10",
              "7.44x9.69",
              "7.5x9.25",
              "8x10",
              "8.25x6",
              "8.25x8.25",
              "8.5x8.5",
              "8.5x11",
              "8.27x11.69"
            ],
            "description": "KDP trim size key, width x height in inches, e.g. \"6x9\" or \"5.5x8.5\""
          },
          "page_count": {
            "type": "integer",
            "minimum": 24,
            "maximum": 828,
            "description": "Interior page count (24–828)"
          },
          "paper": {
            "default": "bw-white",
            "description": "bw-white (black ink, white paper), bw-cream, std-color or premium-color",
            "type": "string",
            "enum": [
              "bw-white",
              "bw-cream",
              "std-color",
              "premium-color"
            ]
          }
        },
        "required": [
          "page_count"
        ]
      }
    },
    {
      "name": "kdp_royalty",
      "description": "KDP paperback printing cost and royalty per sale from list price, page count, marketplace and ink, using KDP's published formulas and 50%/60% rates.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "list_price": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Tax-exclusive list price in the marketplace's currency"
          },
          "page_count": {
            "type": "integer",
            "minimum": 24,
            "maximum": 828,
            "description": "Interior page count (24–828)"
          },
          "marketplace": {
            "default": "us",
            "description": "us (Amazon.com, USD), uk, eu, pl, se, jp, ca or au",
            "type": "string",
            "enum": [
              "us",
              "uk",
              "eu",
              "pl",
              "se",
              "jp",
              "ca",
              "au"
            ]
          },
          "ink": {
            "default": "bw",
            "description": "bw (black ink, white or cream), bw-groundwood, std-color or premium-color",
            "type": "string",
            "enum": [
              "bw",
              "bw-groundwood",
              "std-color",
              "premium-color"
            ]
          },
          "trim_size": {
            "default": "6x9",
            "description": "Trim size key; large trims (wider than 6.12 in or taller than 9 in) cost more to print",
            "type": "string",
            "enum": [
              "5x8",
              "5.06x7.81",
              "5.25x8",
              "5.5x8.5",
              "6x9",
              "6.14x9.21",
              "6.69x9.61",
              "7x10",
              "7.44x9.69",
              "7.5x9.25",
              "8x10",
              "8.25x6",
              "8.25x8.25",
              "8.5x8.5",
              "8.5x11",
              "8.27x11.69"
            ]
          },
          "expanded_distribution": {
            "default": false,
            "description": "Expanded Distribution (40% rate, Amazon.com only)",
            "type": "boolean"
          }
        },
        "required": [
          "list_price",
          "page_count"
        ]
      }
    },
    {
      "name": "kdp_margins",
      "description": "Inside (gutter) and outside margins KDP requires for a paperback page count, plus the largest text area at a trim size.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "page_count": {
            "type": "integer",
            "minimum": 24,
            "maximum": 828,
            "description": "Interior page count (24–828)"
          },
          "trim_size": {
            "default": "6x9",
            "type": "string",
            "enum": [
              "5x8",
              "5.06x7.81",
              "5.25x8",
              "5.5x8.5",
              "6x9",
              "6.14x9.21",
              "6.69x9.61",
              "7x10",
              "7.44x9.69",
              "7.5x9.25",
              "8x10",
              "8.25x6",
              "8.25x8.25",
              "8.5x8.5",
              "8.5x11",
              "8.27x11.69"
            ],
            "description": "KDP trim size key, width x height in inches, e.g. \"6x9\" or \"5.5x8.5\""
          }
        },
        "required": [
          "page_count"
        ]
      }
    }
  ],
