{
  "$schema": "../schema.json",
  "name": "com.discoverthetools/directory",
  "title": "Discover the Tools",
  "category": "Other",
  "description": "Find and compare AI tools, check pricing sources, and submit tools for private editorial review.",
  "tools": [
    {
      "name": "get_directory_info",
      "description": "Connection guidance, limits and submission workflow.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "list_categories",
      "description": "List public category slugs for search filters.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "search_tools",
      "description": "Search published, reviewed catalogue entries by task or name. Cite listing URLs. Not exhaustive; no held drafts, AI generation or paid ranking.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "category": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "pricing": {
            "type": "string",
            "enum": [
              "free",
              "freemium",
              "free-trial",
              "paid",
              "paid-inquire"
            ]
          },
          "limit": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_tool",
      "description": "Get one public listing, pricing evidence, dates and sponsorship disclosure. Does not freshly verify vendor claims.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "compare_tools",
      "description": "Retrieve up to three public listings side by side. Do not invent ratings, prices or recommendations.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "slugs": {
            "minItems": 2,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "slugs"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "check_tool_listing",
      "description": "Check a public website for existing published listings before submitting. Does not reveal private pending submissions.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "website_url": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": [
          "website_url"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "validate_tool_submission",
      "description": "Validate the same fields as the website without saving. Returns a new idempotency key. Show all details and the private email to the user before calling submit_tool.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "submission": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 12,
                "maxLength": 160
              },
              "description": {
                "type": "string",
                "minLength": 60,
                "maxLength": 900
              },
              "launchYear": {
                "type": "string",
                "maxLength": 4
              },
              "targetAudience": {
                "type": "string",
                "maxLength": 160
              },
              "useCases": {
                "type": "string",
                "maxLength": 240
              },
              "pricingUrl": {
                "type": "string",
                "maxLength": 350
              },
              "startingPrice": {
                "type": "string",
                "maxLength": 20
              },
              "currency": {
                "type": "string",
                "maxLength": 3
              },
              "billingPeriod": {
                "type": "string",
                "maxLength": 8
              },
              "freeAllowance": {
                "type": "string",
                "maxLength": 240
              },
              "demoUrl": {
                "type": "string",
                "maxLength": 350
              },
              "logoUrl": {
                "type": "string",
                "maxLength": 350
              },
              "contactName": {
                "type": "string",
                "maxLength": 80
              },
              "relationship": {
                "type": "string",
                "enum": [
                  "Founder / team member",
                  "Agency / partner",
                  "User / community recommendation"
                ]
              },
              "notes": {
                "type": "string",
                "maxLength": 300
              },
              "toolName": {
                "type": "string",
                "minLength": 2,
                "maxLength": 120
              },
              "websiteUrl": {
                "type": "string",
                "maxLength": 2048
              },
              "workEmail": {
                "type": "string",
                "maxLength": 320,
                "format": "email",
                "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              "categorySuggestion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "pricingModel": {
                "type": "string",
                "enum": [
                  "free",
                  "freemium",
                  "free-trial",
                  "paid",
                  "paid-inquire"
                ]
              },
              "platforms": {
                "maxItems": 7,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "Web app",
                    "API",
                    "Desktop app",
                    "Browser extension",
                    "iOS",
                    "Android",
                    "Self-hosted / open source"
                  ]
                }
              }
            },
            "required": [
              "summary",
              "description",
              "toolName",
              "websiteUrl",
              "workEmail",
              "categorySuggestion",
              "pricingModel"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "submission"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "submit_tool",
      "description": "WRITE: Save one free tool suggestion privately for editorial review. Requires explicit user confirmation of all submitted details, the private contact email and review conditions. No publication or email is triggered. Reuse the validation idempotency key unchanged for retries; keep the returned tracking secret private.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "submission": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 12,
                "maxLength": 160
              },
              "description": {
                "type": "string",
                "minLength": 60,
                "maxLength": 900
              },
              "launchYear": {
                "type": "string",
                "maxLength": 4
              },
              "targetAudience": {
                "type": "string",
                "maxLength": 160
              },
              "useCases": {
                "type": "string",
                "maxLength": 240
              },
              "pricingUrl": {
                "type": "string",
                "maxLength": 350
              },
              "startingPrice": {
                "type": "string",
                "maxLength": 20
              },
              "currency": {
                "type": "string",
                "maxLength": 3
              },
              "billingPeriod": {
                "type": "string",
                "maxLength": 8
              },
              "freeAllowance": {
                "type": "string",
                "maxLength": 240
              },
              "demoUrl": {
                "type": "string",
                "maxLength": 350
              },
              "logoUrl": {
                "type": "string",
                "maxLength": 350
              },
              "contactName": {
                "type": "string",
                "maxLength": 80
              },
              "relationship": {
                "type": "string",
                "enum": [
                  "Founder / team member",
                  "Agency / partner",
                  "User / community recommendation"
                ]
              },
              "notes": {
                "type": "string",
                "maxLength": 300
              },
              "toolName": {
                "type": "string",
                "minLength": 2,
                "maxLength": 120
              },
              "websiteUrl": {
                "type": "string",
                "maxLength": 2048
              },
              "workEmail": {
                "type": "string",
                "maxLength": 320,
                "format": "email",
                "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              "categorySuggestion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "pricingModel": {
                "type": "string",
                "enum": [
                  "free",
                  "freemium",
                  "free-trial",
                  "paid",
                  "paid-inquire"
                ]
              },
              "platforms": {
                "maxItems": 7,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "Web app",
                    "API",
                    "Desktop app",
                    "Browser extension",
                    "iOS",
                    "Android",
                    "Self-hosted / open source"
                  ]
                }
              }
            },
            "required": [
              "summary",
              "description",
              "toolName",
              "websiteUrl",
              "workEmail",
              "categorySuggestion",
              "pricingModel"
            ],
            "additionalProperties": false
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 47,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "confirmed": {
            "type": "boolean",
            "description": "True only after the user explicitly approves sharing these details and private contact email for editorial review."
          }
        },
        "required": [
          "submission",
          "idempotency_key",
          "confirmed"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_submission_status",
      "description": "Retrieve only your submission status using its private receipt and tracking secret. Never reveal or request other inbox records.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "receipt": {
            "type": "string",
            "maxLength": 47,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "tracking_secret": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "receipt",
          "tracking_secret"
        ],
        "additionalProperties": false
      }
    }
  ],
