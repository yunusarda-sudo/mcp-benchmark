      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "검색어 (3글자 이상이면 전문검색, 공백은 AND)"
          },
          "stock": {
            "description": "이 종목만",
            "type": "string"
          },
          "topic": {
            "description": "drivers=실적 변동 이유, mdna=경영진단, business=사업·산업 설명",
