{
  "$schema": "../schema.json",
  "name": "directory.limousine/booking",
  "title": "Limousine.Directory",
  "category": "Travel, Maps & Navigation",
  "description": "Book sedans, SUVs, Sprinters, stretch limos and party buses in the US, Canada and worldwide.",
  "tools": [
    {
      "name": "search_coverage",
      "description": "Find Limousine.Directory pages for a city, airport, venue, event, service or topic. Returns titles, summaries and URLs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 8
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_page",
      "description": "Return the text of a page on limousine.directory (Markdown when available). Accepts a full URL or a path.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "get_booking_options",
      "description": "Services, vehicles, coverage, pricing rules, contact channels, the online booker link and booking policies.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "request_booking",
      "description": "Send a chauffeured transportation request to Limousine.Directory for the traveller. Only call when the traveller explicitly asked to book. Returns a reference (LDR-XXXXXXX); the team confirms price, vehicle and chauffeur by email or phone. Not confirmed until then; nothing is charged.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Lead passenger full name"
          },
          "email": {
            "type": "string",
            "description": "Email (email or phone required)"
          },
          "phone": {
            "type": "string",
            "description": "Mobile with country code"
          },
          "service": {
            "type": "string",
            "enum": [
              "Hourly / as directed",
              "Airport transfer",
              "Point to point",
              "Wedding / prom / event",
              "Private tour",
              "Group / multiple vehicles"
            ]
          },
          "pickup": {
            "type": "string",
            "description": "Address, hotel, airport + terminal or venue"
          },
          "dropoff": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "description": "Local pickup date YYYY-MM-DD"
          },
          "time": {
            "type": "string",
            "description": "Local pickup time HH:MM"
          },
          "hours": {
            "type": "string",
            "description": "Hours needed for hourly / as-directed service"
          },
          "flight": {
            "type": "string"
          },
          "passengers": {
            "type": "integer",
            "minimum": 1
          },
          "bags": {
            "type": "integer",
            "minimum": 0
          },
          "vehicle": {
            "type": "string",
            "enum": [
              "First Class Sedan",
              "Business SUV",
              "Luxury SUV",
              "Business Van",
              "Executive Sprinter",
              "Jet Sprinter",
              "Stretch Limousine",
              "Party Bus"
            ]
          },
          "return": {
            "type": "string"
          },
          "notes": {
            "type": "string",
            "description": "Occasion, child seats, accessibility, stops"
          },
          "agent": {
            "type": "string",
            "description": "Name of your assistant or app"
          },
          "consent": {
            "type": "string",
            "enum": [
              "yes"
            ],
            "description": "The traveller explicitly asked for this booking"
          }
        },
        "required": [
          "name",
          "pickup",
          "dropoff",
          "date",
          "time",
          "consent"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "directory.limousine/booking",
    "version": "1.0.0",
    "remoteUrl": "https://limousine.directory/agent-api/mcp.php",
    "publishedAt": "2026-11-24T13:54:14.805521Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "eb49a824281d07ea0ab9dda9be4f8dce7c598fdc0ef361a01c5a769bb00aa2af"
  }
}
