{
  "$schema": "../schema.json",
  "name": "io.github.adrianabelarde/jiggicons",
  "title": "Jiggicons",
  "category": "Developer Tools & VCS",
  "description": "Search 6,010 animated icons with motion and sound, and get React, Vue or SVG code for them.",
  "tools": [
    {
      "name": "search_icons",
      "description": "Search the 6,010 Jiggicons by words (e.g. \"bell\", \"arrow left\", \"shopping cart\"). Returns icon ids, names, categories and whether each is free.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Words to search for"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          },
          "category": {
            "type": "string",
            "description": "Only this category (see list_categories)"
          },
          "free_only": {
            "type": "boolean",
            "description": "Only the 80 free icons"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "list_categories",
      "description": "The Jiggicons categories with how many icons each has.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_icon",
      "description": "The source of one icon, ready to save into the project: a React or Vue component, JS/TS data, JSON, or a plain SVG of one variant. Paid icons need the licence key the server was configured with.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Icon id from search_icons, e.g. \"bell\""
          },
          "format": {
            "type": "string",
            "enum": [
              "react",
              "vue",
              "js",
              "ts",
              "json",
              "svg"
            ],
            "default": "react"
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "outline",
                "solid",
                "duotone",
                "glass"
              ]
            },
            "description": "Variants to include (default all four; for svg, the first)"
          }
        },
        "required": [
          "id"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.adrianabelarde/jiggicons",
    "version": "0.1.1",
    "remoteUrl": "https://jiggicons.com/mcp",
    "publishedAt": "2026-11-23T04:11:54.383097Z",
    "fetchedAt": "2026-11-23T16:50:40.239Z",
    "toolsSha256": "b2b4a7d5b4e6c8365555e2a6ca833c57efddaf6293a51c0b2bc4dffa146fb0c4"
  }
}
