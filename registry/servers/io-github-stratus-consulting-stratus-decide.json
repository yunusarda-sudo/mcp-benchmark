{
  "$schema": "../schema.json",
  "name": "io.github.stratus-consulting/stratus-decide",
  "title": "DECIDE: Data Migration Discovery Risk Review",
  "category": "Developer Tools & DevOps",
  "description": "Reviews data migration discovery after each iteration: open risks, who to ask next, what changed.",
  "repository": "https://github.com/stratus-consulting/decide-mcp",
  "tools": [
    {
      "name": "validate_migration_discovery",
      "description": "Review a data migration's current discovery findings and return the open risks, highest severity first, each with a next step: who to ask and what to ask. Call after each discovery iteration with the full, cumulative findings (open questions with answer null) and the same engagement_id, to see which risks are new, still open or closed. Minimal example submission: {\"engagement_id\": \"acme-crm-2026\", \"sow\": {\"use_case\": \"Consolidate two legacy CRMs into one Salesforce org.\", \"scope\": [\"Account\", \"Contact\", \"Opportunity\"]}, \"project_items\": [{\"category\": \"process\", \"question\": \"Which team runs month-end invoicing in the legacy CRM?\", \"answer\": \"Finance operations, from a weekly export.\", \"source\": {\"who\": \"Finance operations lead\"}}], \"objects\": [{\"name\": \"Account\", \"criticality\": \"high\", \"has_hierarchy\": true, \"items\": [{\"category\": \"object_context\", \"question\": \"Do regional sales teams use separate Account layouts?\", \"answer\": null}], \"flags\": [{\"description\": \"Parent hierarchy source not provided\", \"owner\": \"Finance\"}]}]}",
      "inputSchema": {
        "properties": {
          "submission": {
            "$ref": "#/$defs/DiscoverySubmission"
          },
          "max_risks": {
            "default": 25,
            "title": "Max Risks",
            "type": "integer"
          }
        },
        "required": [
          "submission"
        ],
        "type": "object",
        "$defs": {
          "Criticality": {
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "title": "Criticality",
            "type": "string"
          },
          "DiscoveredOutsideScope": {
            "additionalProperties": false,
            "description": "Optional. An object or table Discovery found that isn't in scope. If it isn't clear whether\nsomething is in scope, ask the scope owner.",
            "properties": {
              "name": {
                "maxLength": 200,
                "title": "Name",
                "type": "string"
              },
              "usage": {
                "anyOf": [
                  {
                    "maxLength": 2000,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "How it is used.",
                "title": "Usage"
              },
              "data_stored": {
                "anyOf": [
                  {
                    "maxLength": 2000,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "What data it stores.",
                "title": "Data Stored"
              },
              "requested_by": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Role of whoever asked for it.",
                "title": "Requested By"
              },
              "reason": {
                "anyOf": [
                  {
                    "maxLength": 2000,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Why it is needed.",
                "title": "Reason"
              },
              "timing": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Timing"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Needed for go-live (day1) or after go-live (fast_follow)."
              }
            },
            "required": [
              "name"
            ],
            "title": "DiscoveredOutsideScope",
            "type": "object"
          },
          "DiscoverySubmission": {
            "additionalProperties": false,
            "properties": {
              "engagement_id": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Engagement Id"
              },
              "sow": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/SOW"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Scope baseline, if you have it. Without it, in-scope checks are skipped; scope is reviewed from your scope answers."
              },
              "project_items": {
                "default": [],
                "items": {
                  "$ref": "#/$defs/ProjectItem"
                },
                "maxItems": 300,
                "title": "Project Items",
                "type": "array"
              },
              "objects": {
                "default": [],
                "items": {
                  "$ref": "#/$defs/ObjectResult"
                },
                "maxItems": 100,
                "title": "Objects",
                "type": "array"
              },
              "discovered_outside_scope": {
                "default": [],
                "items": {
                  "$ref": "#/$defs/DiscoveredOutsideScope"
                },
                "maxItems": 200,
                "title": "Discovered Outside Scope",
                "type": "array"
              }
            },
            "title": "DiscoverySubmission",
            "type": "object"
          },
          "Flag": {
            "properties": {
              "description": {
                "maxLength": 2000,
                "title": "Description",
                "type": "string"
              },
              "waiting_on": {
                "anyOf": [
                  {
                    "maxLength": 2000,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "What the object is waiting on.",
                "title": "Waiting On"
              },
              "owner": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Who owns resolving it.",
                "title": "Owner"
              },
              "date_flagged": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Date Flagged"
              }
            },
            "required": [
              "description"
            ],
            "title": "Flag",
            "type": "object"
          },
          "ObjectCategory": {
            "description": "Object- or table-level topic. object_context: business meaning, ownership, usage and record\ntypes. object_source: source data characteristics, files, volumes and keys. dependencies: load\ndependencies and reference data. hierarchy: hierarchy structure, if applicable. migration_logic:\ndata selection and retention requirements.",
            "enum": [
              "object_context",
              "object_source",
              "dependencies",
              "hierarchy",
              "migration_logic"
            ],
            "title": "ObjectCategory",
            "type": "string"
          },
          "ObjectItem": {
            "properties": {
              "category": {
                "$ref": "#/$defs/ObjectCategory"
              },
              "question": {
                "maxLength": 2000,
                "title": "Question",
                "type": "string"
              },
              "answer": {
                "anyOf": [
                  {
                    "maxLength": 5000,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Answer"
              },
              "source": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Source"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "required": [
              "category",
              "question"
            ],
            "title": "ObjectItem",
            "type": "object"
          },
          "ObjectResult": {
            "properties": {
              "name": {
                "description": "Object or table name, e.g. Account.",
                "maxLength": 200,
                "title": "Name",
                "type": "string"
              },
              "criticality": {
                "$ref": "#/$defs/Criticality",
                "default": "medium"
              },
              "has_hierarchy": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Null = not yet known.",
                "title": "Has Hierarchy"
              },
              "items": {
                "default": [],
                "items": {
                  "$ref": "#/$defs/ObjectItem"
                },
                "maxItems": 150,
                "title": "Items",
                "type": "array"
              },
              "flags": {
                "default": [],
                "items": {
                  "$ref": "#/$defs/Flag"
                },
                "maxItems": 50,
                "title": "Flags",
                "type": "array"
              }
            },
            "required": [
              "name"
            ],
            "title": "ObjectResult",
            "type": "object"
          },
          "ProjectCategory": {
            "description": "Project-level topic. purpose: business drivers for the data migration. scope: scope\nboundaries, including go-live and subsequent requirements. use_case: intended outcomes and their\npriority. success: go-live, success criteria, validation and sign-off. people: stakeholders and\ndecision makers. data_landscape: current data environment, data ownership and governance.\nprocurement: purchased platform licenses and capacity (context only, if known). process: current\nbusiness processes and reporting.",
            "enum": [
              "purpose",
              "scope",
              "use_case",
              "success",
              "people",
              "data_landscape",
              "procurement",
              "process"
            ],
            "title": "ProjectCategory",
            "type": "string"
          },
          "ProjectItem": {
            "properties": {
              "category": {
                "$ref": "#/$defs/ProjectCategory"
              },
              "question": {
                "description": "The question as the agent asked it.",
                "maxLength": 2000,
                "title": "Question",
                "type": "string"
              },
              "answer": {
                "anyOf": [
                  {
                    "maxLength": 5000,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Null or empty = open question.",
                "title": "Answer"
              },
              "source": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Source"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "required": [
              "category",
              "question"
            ],
            "title": "ProjectItem",
            "type": "object"
          },
          "SOW": {
            "additionalProperties": false,
            "description": "The scope baseline, e.g. from the statement of work. Optional: leave it out if you don't have it.",
            "properties": {
              "provided": {
                "default": true,
                "title": "Provided",
                "type": "boolean"
              },
              "use_case": {
                "anyOf": [
                  {
                    "maxLength": 2000,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Use Case"
              },
              "scope": {
                "default": [],
                "description": "Objects or tables in scope.",
                "items": {
                  "maxLength": 200,
                  "type": "string"
                },
                "maxItems": 200,
                "title": "Scope",
                "type": "array"
              },
              "assumptions": {
                "default": [],
                "items": {
                  "maxLength": 2000,
                  "type": "string"
                },
                "maxItems": 100,
                "title": "Assumptions",
                "type": "array"
              },
              "out_of_scope": {
                "default": [],
                "items": {
                  "maxLength": 200,
                  "type": "string"
                },
                "maxItems": 200,
                "title": "Out Of Scope",
                "type": "array"
              },
              "success_definition": {
                "anyOf": [
                  {
                    "maxLength": 2000,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Success Definition"
              }
            },
            "title": "SOW",
            "type": "object"
          },
          "Source": {
            "properties": {
              "who": {
                "description": "Role of the person who gave the answer, e.g. 'VP Sales'. Use a role, not a name.",
                "maxLength": 200,
                "title": "Who",
                "type": "string"
              },
              "role": {
                "anyOf": [
                  {
                    "maxLength": 200,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Role"
              },
              "date": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Date"
              }
            },
            "required": [
              "who"
            ],
            "title": "Source",
            "type": "object"
          },
          "Timing": {
            "enum": [
              "day1",
              "fast_follow"
            ],
            "title": "Timing",
            "type": "string"
          }
        },
        "title": "validate_migration_discoveryArguments"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
