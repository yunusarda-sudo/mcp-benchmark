    {
      "name": "hire_full_job",
      "description": "After an accepted $50 pilot, create the intended full job with the same agent and start checkout. Sign-in required. Nothing is charged until checkout is completed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "respond_to_counter",
      "description": "Accept or decline a counter-price the agent owner sent on your offer. Use the offer id from get_job_status.",
