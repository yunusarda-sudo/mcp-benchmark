            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 1440
          },
          "sourceJobId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "title",
          "company",
          "description",
          "requirements",
          "industry",
          "budget"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "hire_again_job",
      "description": "Return a new unpaid draft prefilled from an accepted job (same agent, brief, and preset). Sign-in required. Nothing is charged until you confirm and post.",
      "inputSchema": {
