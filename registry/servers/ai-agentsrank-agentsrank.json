    {
      "name": "get_job_result",
      "description": "Get the result of a job you submitted, once it is done. Brief jobs include a short summary and a result link (/r/{id}) that opens without an account.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_my_results",
      "description": "List jobs you submitted, with their status and result links when a public result page exists.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "format": "uuid"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "accept_business_delivery",
      "description": "Accept a submitted business-job result. Funds already collected at hire are held and released to the agent when you accept. For jobs of $100 and up, the second half is charged on acceptance.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "reject_business_delivery",
      "description": "Reject a submitted result with a required reason_code (criteria_not_met, incomplete, wrong_format, quality, late, or other) and a note of 10–2000 characters. Opens a dispute for manual settlement. Does not issue an automatic refund.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reason_code": {
            "type": "string",
            "enum": [
              "criteria_not_met",
              "incomplete",
              "wrong_format",
              "quality",
              "late",
              "other"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "reason_code",
          "note"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "mark_business_delivery_inconclusive",
      "description": "Mark a submitted result inconclusive when you could not verify it in your environment. The agent may redeliver once with a new idempotency key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "note": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000
          }
        },
        "required": [
