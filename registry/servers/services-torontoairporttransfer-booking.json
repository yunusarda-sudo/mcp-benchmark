{
  "$schema": "../schema.json",
  "name": "services.torontoairporttransfer/booking",
  "title": "TorontoAirportTransfer.services",
  "category": "E-Commerce & Retail",
  "description": "Toronto airport transfers: Pearson, Billy Bishop and cross-border rides, plus worldwide airports.",
  "tools": [
    {
      "name": "search_coverage",
      "description": "Find TorontoAirportTransfer.services pages for a Toronto route, airport (IATA code or name), FBO, cruise port, train station, city, attraction, event, service or travel topic, in Ontario or worldwide. Returns titles, summaries and URLs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "e.g. \"Pearson to downtown\", \"Billy Bishop\", \"Niagara Falls\", \"JFK\", \"Heathrow private jet\", \"Port of Miami\""
          },
          "section": {
            "type": "string",
            "enum": [
              "about",
              "airports",
              "arrivals",
              "attractions",
              "blog",
              "book",
              "chauffeurs",
              "cities",
              "contact",
              "corporate",
              "events",
              "faq",
              "fleet",
              "guides",
              "home",
              "network",
              "occasions",
              "privacy",
              "private-aviation",
              "rates",
              "routes",
              "searches",
              "services",
              "stations",
              "terms",
              "tools",
              "travel-desk",
              "world-airports",
              "world-cruise-ports",
              "world-private-jets-fbo"
            ],
            "description": "Optional filter"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 8
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_page",
      "description": "Return the text of a TorontoAirportTransfer.services page: meeting points, terminals, drive times, planning fares, tips and FAQ. Accepts a full URL or a path such as /airports/toronto-pearson-yyz/.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "get_booking_options",
      "description": "Services, vehicle classes and capacity, planning fares from Pearson, what is included, contact channels, the fixed-fare reservation engine link and booking policies (cancellation, payment, confirmation).",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "request_booking",
      "description": "Send a chauffeured transfer request to the 24/7 dispatch desk for the traveller. Only call when the traveller explicitly asked to book. Returns a reference (TAT-XXXXXXX); dispatch then confirms the fixed fare, vehicle and chauffeur by email or phone. It is not a confirmed booking until then.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Lead passenger full name"
          },
          "email": {
            "type": "string",
            "description": "Email (email or phone required)"
          },
          "phone": {
            "type": "string",
            "description": "Mobile with country code"
          },
          "service": {
            "type": "string",
            "enum": [
              "Airport pickup",
              "Airport drop-off",
              "Point to point",
              "Hourly / as directed",
              "FBO / private jet",
              "Cruise port",
              "Train station",
              "Cross-border (USA)",
              "Wedding / event",
              "Corporate / roadshow",
              "Worldwide transfer (partner operator)"
            ]
          },
          "pickup": {
            "type": "string",
            "description": "Airport code + terminal (e.g. YYZ Terminal 1), FBO, hotel name or full address"
          },
          "dropoff": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "description": "Local pickup date YYYY-MM-DD"
          },
          "time": {
            "type": "string",
            "description": "Local pickup time HH:MM (for arrivals, the scheduled landing time)"
          },
          "flight": {
            "type": "string",
            "description": "Flight, train or ship identifier"
          },
          "passengers": {
            "type": "integer",
            "minimum": 1
          },
          "bags": {
            "type": "integer",
            "minimum": 0
          },
          "vehicle": {
            "type": "string",
            "enum": [
              "Business sedan",
              "First-class sedan",
              "Executive SUV",
              "Luxury minivan",
              "Executive Sprinter",
              "Stretch limousine",
              "Limo / party bus",
              "Rolls-Royce / Maybach",
              "Coach",
              "Multiple vehicles"
            ]
          },
          "return": {
            "type": "string",
            "description": "Return trip details, if any"
          },
          "notes": {
            "type": "string",
            "description": "Child seats, accessibility, sign name, confidentiality, etc."
          },
          "child_seats": {
            "type": "string",
            "description": "Infant, convertible or booster seats needed"
          },
          "agent": {
            "type": "string",
            "description": "Name of your assistant or app"
          },
          "consent": {
            "type": "string",
            "enum": [
              "yes"
            ],
            "description": "The traveller explicitly asked for this booking"
          }
        },
        "required": [
          "name",
          "pickup",
          "dropoff",
          "date",
          "time",
          "consent"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "services.torontoairporttransfer/booking",
    "version": "1.0.0",
    "remoteUrl": "https://torontoairporttransfer.services/api/mcp.php",
    "publishedAt": "2026-11-24T13:54:00.98453Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "961a5c4e7fbba754e915f5a2c89f80016147050a34f620a0b7b6993965bde2f3"
  }
}
