{
  "$schema": "../schema.json",
  "name": "top.web3project/mcp-audit",
  "title": "mcp-audit — MCP static scan (SARIF + CI)",
  "category": "E-Commerce & Retail",
  "description": "Static MCP server scan: injection, secrets, tool poisoning. SARIF + rules catalog.",
  "tools": [
    {
      "name": "scan_mcp_server",
      "description": "审计一个 MCP server 项目（本地路径）的安全风险，返回结构化风险清单",
      "inputSchema": {
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "include_tests": {
            "default": false,
            "title": "Include Tests",
            "type": "boolean"
          }
        },
        "required": [
          "path"
        ],
        "type": "object",
        "title": "scan_mcp_serverArguments"
      }
    },
    {
      "name": "scan_public_repo",
      "description": "扫描任意公开仓库（github.com / gitlab.com / gitee.com）里的 MCP server 安全风险。直接传仓库 URL，无需下载、无需本地路径。返回按严重度汇总的摘要 + 最多 3 条明细；完整报告（含修复建议/SARIF/CI 模板）见 https://web3project.top/mcp-audit",
      "inputSchema": {
        "properties": {
          "repo_url": {
            "title": "Repo Url",
            "type": "string"
          }
        },
        "required": [
          "repo_url"
        ],
        "type": "object",
        "title": "scan_public_repo_toolArguments"
      }
    },
    {
      "name": "list_rules",
      "description": "列出扫描器的全部规则（规则 id、严重度、说明、修复建议）",
      "inputSchema": {
        "properties": {},
        "type": "object",
        "title": "list_rules_toolArguments"
      }
    },
    {
      "name": "scan_to_sarif",
      "description": "扫描本地路径或公开仓库并直接返回 SARIF 2.1.0 文档，可上传 GitHub code scanning",
      "inputSchema": {
        "properties": {
          "path": {
            "default": "",
            "title": "Path",
            "type": "string"
          },
          "repo_url": {
            "default": "",
            "title": "Repo Url",
            "type": "string"
          },
          "include_tests": {
            "default": false,
            "title": "Include Tests",
            "type": "boolean"
          }
        },
        "type": "object",
        "title": "scan_to_sarif_toolArguments"
      }
    },
    {
      "name": "explain_rule",
      "description": "查询单条规则的严重度、含义与修复建议",
      "inputSchema": {
        "properties": {
          "rule": {
            "title": "Rule",
            "type": "string"
          }
        },
        "required": [
          "rule"
        ],
        "type": "object",
        "title": "explain_rule_toolArguments"
      }
    }
  ],
