          "phone_number": {
            "type": "string",
            "pattern": "^\\+?[1-9]\\d{6,14}$"
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "dashboard_id",
          "phone_number"
        ]
      }
    },
