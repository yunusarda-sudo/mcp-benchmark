{
  "$schema": "../schema.json",
  "name": "io.github.cheborotalco/alisac-it-mcp",
  "category": "Developer Tools & DevOps",
  "description": "AI & IT Specialist (PMP, PSPO I, AWS): Europe & Asia advisory, cases, and direct contact.",
  "repository": "https://github.com/cheborotalco/new-sito-ali",
  "tools": [
    {
      "name": "get_profile",
      "description": "Get Alisa Chebotarenko profile, certifications (PMP, PSPO I, AWS AI Practitioner), Europe & Asia availability, spoken languages (EN/RU/IT), equivalent roles, the 4 core domains, and direct contact details.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "ru"
            ],
            "description": "Preferred response language (en or ru)."
          }
        }
      }
    },
    {
      "name": "list_services",
      "description": "List Alisa Chebotarenko consulting & advisory services with durations and base starting prices, optionally filtered by client category.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "all",
              "private",
              "investor",
              "startup"
            ],
            "description": "Filter by client category."
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "ru"
            ],
            "description": "Preferred response language (en or ru)."
          }
        }
      }
    },
    {
      "name": "list_case_studies",
      "description": "List selected AI, IoT and product delivery case studies coordinated by Alisa Chebotarenko.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "ru"
            ],
            "description": "Preferred response language (en or ru)."
          }
        }
      }
    },
    {
      "name": "submit_inquiry",
      "description": "Submit a structured business or project inquiry to Alisa Chebotarenko on behalf of a user (requires explicit user confirmation and privacy consent).",
      "inputSchema": {
        "type": "object",
        "required": [
          "name",
          "request_reason",
          "preferred_contact",
          "message",
          "privacy_consent"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "request_reason": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "preferred_contact": {
            "type": "string",
            "enum": [
              "email",
              "whatsapp",
              "telegram"
            ]
          },
          "email": {
            "type": "string"
          },
          "phone_country_code": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "telegram_username": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 10,
            "maxLength": 5000
          },
          "privacy_consent": {
            "type": "boolean",
            "description": "Must be true after explicit user consent."
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.cheborotalco/alisac-it-mcp",
    "version": "1.0.0",
    "remoteUrl": "https://alisac.it/api/mcp",
