{
  "$schema": "../schema.json",
  "name": "ai.sleepgenic/sleepgenic",
  "title": "Sleepgenic",
  "category": "Finance, Crypto & Web3",
  "description": "Puts wearable sleep scores and HRV in context, using a non-diagnostic sleep method.",
  "tools": [
    {
      "name": "sleepgenic.sleepScore.contextualize",
      "description": "Compare a device-specific sleep score with the same person's baseline without assigning a diagnosis or universal quality grade.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Current wearable sleep score."
          },
          "baseline_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Representative score from the same person and device."
          },
          "baseline_window_days": {
            "type": "integer",
            "minimum": 3,
            "maximum": 90,
            "description": "Days represented by the baseline."
          }
        },
        "required": [
          "score",
          "baseline_score",
          "baseline_window_days"
        ]
      }
    },
    {
      "name": "sleepgenic.hrv.contextualize",
      "description": "Compare an overnight HRV value with a same-device personal baseline and report relative direction with explicit uncertainty.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hrv_ms": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 500,
            "description": "Current overnight HRV in milliseconds."
          },
          "baseline_hrv_ms": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 500,
            "description": "Representative personal baseline in milliseconds from the same device and metric."
          },
          "baseline_window_days": {
            "type": "integer",
            "minimum": 3,
            "maximum": 90,
            "description": "Days represented by the baseline."
          }
        },
        "required": [
          "hrv_ms",
          "baseline_hrv_ms",
          "baseline_window_days"
        ]
      }
    },
    {
      "name": "sleepgenic.methodology.lookup",
      "description": "Retrieve the public non-diagnostic interpretation methodology for a sleep or recovery topic.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "sleep_score",
              "hrv",
              "sleep_stages",
              "sleep_stage_classification_error",
              "sleep_timing",
              "recovery",
              "longitudinal_trends",
              "nocturnal_oxygen_and_breathing_disruption",
              "sleep_apnea_boundary",
              "sleep_screening_instruments",
              "polysomnography_and_hsat",
              "excessive_daytime_sleepiness"
            ]
          }
        },
        "required": [
          "topic"
        ]
      }
    },
    {
      "name": "sleepgenic.screening.lookup",
      "description": "Retrieve rights-safe purpose, population, recall-period, diagnostic-limit, official-source, and licensing metadata without reproducing questionnaire content.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "instrument": {
            "type": "string",
            "enum": [
              "psqi",
              "assq",
              "ess",
              "stop_bang",
              "isi"
            ]
          }
        },
        "required": [
          "instrument"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "ai.sleepgenic/sleepgenic",
    "version": "1.1.0",
    "remoteUrl": "https://mcp.sleepgenic.ai/mcp",
    "publishedAt": "2026-11-27T03:10:11.303399Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "a9ff089cbbbc0d8260d72912ea363c26f6e2cfcb3e432a6a68d7ffd420ba3309"
  }
}
