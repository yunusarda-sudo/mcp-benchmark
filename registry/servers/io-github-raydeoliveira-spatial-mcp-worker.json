{
  "$schema": "../schema.json",
  "name": "io.github.raydeoliveira/spatial-mcp-worker",
  "title": "Spatial 3D Display Oracle (Cloudflare Workers MCP)",
  "category": "Cloud & Hosting Platforms",
  "description": "Cloudflare Workers Streamable HTTP MCP for CVT-RB2 budgets, EDID patching, and lenticular optics.",
  "repository": "https://github.com/raydeoliveira/spatial-mcp-worker",
  "tools": [
    {
      "name": "spatial_list_quirks",
      "description": "Query Spatial 3D display and AR glasses quirk profiles (XREAL, VITURE, Rokid, RayNeo, Odyssey 3D). Free tier.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vendor_hex": {
            "type": "string"
          },
          "product_hex": {
            "type": "string"
          },
          "quirk_id": {
            "type": "string"
          },
          "query": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "spatial_link_budget",
      "description": "Solve VESA CVT-RB2 timing and check HDMI 1.4/2.0/2.1 FRL, DP 1.2/1.4/2.1 UHBR, and USB-C bandwidth with DSC 1.2 8bpp floor. Free tier.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "width",
          "height",
          "refresh_hz"
        ],
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 320,
            "maximum": 7680
          },
          "height": {
            "type": "integer",
            "minimum": 240,
            "maximum": 4320
          },
          "refresh_hz": {
            "type": "number",
            "minimum": 23,
            "maximum": 360
          },
          "bpc": {
            "type": "integer",
            "enum": [
              6,
              8,
              10,
              12
            ]
          },
          "chroma": {
            "type": "string",
            "enum": [
              "rgb444",
              "ycbcr422",
              "ycbcr420"
            ]
          },
          "link": {
            "type": "string"
          },
          "dsc": {
            "type": "boolean"
          },
          "precision": {
            "type": "string",
            "enum": [
              "khz10",
              "khz1"
            ]
          },
          "ntsc": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "spatial_edid_inspect",
      "description": "Decode base64 or hex EDID 1.4, CTA-861, and DisplayID 2.0/2.1 binaries, verify checksums, and match quirks. Metered ($0.005/call or Polar Pro).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edid"
        ],
        "properties": {
          "edid": {
            "type": "string",
            "description": "Base64 or hex-encoded EDID binary (>=128B, multiple of 128B)."
          },
          "strict_checksum": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "spatial_edid_patch",
      "description": "Synthesize checksum-valid Full-SBS 1080p60/120 or RGB 4:4:4 EDID patch + macOS DisplayOverride plist. Metered ($0.01/call or Polar Pro).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edid",
          "preset"
        ],
        "properties": {
          "edid": {
            "type": "string"
          },
          "preset": {
            "type": "string",
            "enum": [
              "full-sbs-1080p",
              "full-sbs-1080p-120",
              "force-rgb444"
            ]
          },
          "link": {
            "type": "string"
          },
          "dsc": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "spatial_lenticular_optics",
      "description": "Compute dynamic eye-tracked slanted-lenticular shader calibration uniforms for glasses-free 3D panels. Metered ($0.005/call or Polar Pro).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "display_width_px",
          "display_height_px",
          "pitch_lpi",
          "screen_width_inches",
          "slant_slope"
        ],
        "properties": {
          "display_width_px": {
            "type": "number"
          },
          "display_height_px": {
            "type": "number"
          },
          "pitch_lpi": {
            "type": "number"
          },
          "screen_width_inches": {
            "type": "number"
          },
          "slant_slope": {
            "type": "number"
          },
          "center_phase": {
            "type": "number"
          },
          "eye_x_normalized": {
            "type": "number"
          },
          "eye_z_mm": {
            "type": "number"
          },
          "nominal_viewing_distance_mm": {
            "type": "number"
          },
          "subpixel_order": {
            "type": "string",
            "enum": [
              "rgb",
              "bgr"
            ]
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.raydeoliveira/spatial-mcp-worker",
    "version": "0.1.0",
    "remoteUrl": "https://spatial-mcp-worker.raymond-deoliveira.workers.dev/mcp",
    "publishedAt": "2026-11-22T08:39:51.50831Z",
    "fetchedAt": "2026-11-22T12:49:37.224Z",
    "toolsSha256": "61cb6c708d1584006f3d7e73b7b5066a191bb734145b66c3fb234710d20488ae"
  }
}
