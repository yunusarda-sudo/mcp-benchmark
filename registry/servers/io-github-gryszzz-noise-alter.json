{
  "$schema": "../schema.json",
  "name": "io.github.gryszzz/noise-alter",
  "title": "Noise Alter",
  "category": "Developer Tools & DevOps",
  "description": "Create and revise stereo soundscapes. Download stems or edit in Remix Studio.",
  "tools": [
    {
      "name": "create_soundscape",
      "description": "Turn a description into synthesized ambience or effects. Use thunder, surf, fire, drips, footsteps, or engine for those sources. Specify timing, rate, stereo movement, distance and fades when requested. Return the WAV and editable recipe links. For follow-up changes, use revise_soundscape with the returned reference. Each layer also has its own downloadable stem. This generates textures, without recordings or voices.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "seconds": {
            "type": "number",
            "minimum": 1,
            "maximum": 20
          },
          "seed": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "layers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": [
                "texture"
              ],
              "additionalProperties": false,
              "properties": {
                "texture": {
                  "type": "string",
                  "enum": [
                    "drone",
                    "wind",
                    "rain",
                    "rumble",
                    "static",
                    "impact",
                    "sweep",
                    "thunder",
                    "surf",
                    "fire",
                    "drips",
                    "footsteps",
                    "engine"
                  ]
                },
                "start_seconds": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 19.95
                },
                "duration_seconds": {
                  "type": "number",
                  "minimum": 0.05,
                  "maximum": 20
                },
                "level": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 1
                },
                "tone": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Dark to bright, or low to high for a drone."
                },
                "pan": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1,
                  "description": "Left to right."
                },
                "attack_seconds": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 30,
                  "description": "Time for the layer to fade in, in seconds."
                },
                "release_seconds": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 30,
                  "description": "Time for the layer to fade out, in seconds."
                },
                "end_pan": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1,
                  "description": "End position for a continuous stereo pan from pan to end_pan."
                },
                "distance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Near (0) to distant (1). Distance softens and quiets the layer."
                },
                "width": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Direct mono image (0) to a wider stereo texture (1)."
                },
                "density": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Sparsity and intensity of events in thunder, surf, fire, drips, footsteps, or engine."
                },
                "rate_hz": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 12,
                  "description": "Events per second for drips, footsteps, surf swells, or engine pulses."
                }
              }
            }
          }
        },
        "required": [
          "layers"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "revise_soundscape",
      "description": "Edit specific layers by number, remove layers, add layers, adjust length, or change the seed. Use the reference from a previous Noise Alter result. Unedited layers keep their timing and seed unless you explicitly change the seed.",
