{
  "$schema": "../schema.json",
  "name": "io.github.GhazwanAlemara/erisaledger",
  "title": "ErisaLedger US 401(k) SECURE 2.0",
  "category": "Developer Tools & DevOps",
  "description": "Zero-PII US 401(k) SECURE 2.0 Roth catch-up, LTPT census audit, Form 8881 credits & VFCP math.",
  "repository": "https://github.com/GhazwanAlemara/sovereign-agent-skills",
  "tools": [
    {
      "name": "erisaledger_calculate_form_8881_credit",
      "description": "Calculates deterministic IRS Form 8881 Part I (Startup & Contribution) and Part II (Auto-Enrollment) credits across a 5-year window, including retroactive IRC Sec. 6511 amended return recovery and 51-100 employee phase-outs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "total_employees_5k_plus": {
            "type": "integer"
          },
          "nhce_count": {
            "type": "integer"
          },
          "eligible_startup_admin_costs": {
            "type": "number"
          },
          "employer_contributions_to_eligible_under_cap": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "plan_start_year": {
            "type": "integer"
          },
          "audit_tax_year": {
            "type": "integer",
            "default": 2026
          },
          "has_auto_enrollment": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "total_employees_5k_plus",
          "nhce_count",
          "eligible_startup_admin_costs",
          "employer_contributions_to_eligible_under_cap",
          "plan_start_year"
        ]
      }
    },
    {
      "name": "erisaledger_audit_secure2_census",
      "description": "Audits anonymized participant census records for 2026 SECURE 2.0 Sec. 603 mandatory Roth catch-up violations (>$150k prior FICA wages), Sec. 125 500-hour Long-Term Part-Time eligibility omissions, and 402(g)/415(c)/Super Catch-Up limits.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tax_year": {
            "type": "integer",
            "default": 2026
          },
          "plan_start_year": {
            "type": "integer",
            "default": 2023
          },
          "state_code": {
            "type": "string",
            "default": "CA"
          },
          "employees": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "employees"
        ]
      }
    },
    {
      "name": "erisaledger_evaluate_state_auto_ira",
      "description": "Evaluates US State Auto-IRA statutory compliance mandates and per-employee penalty exposure across 15 active state programs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "state_code": {
            "type": "string"
          },
          "employee_count": {
            "type": "integer"
          },
          "has_qualified_plan": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "state_code",
          "employee_count"
        ]
      }
    },
    {
      "name": "erisaledger_calculate_vfcp_late_deposit",
      "description": "Computes DOL Voluntary Fiduciary Correction Program (VFCP) lost earnings at IRC Sec. 6621 underpayment interest rates and IRC Sec. 4975 excise tax avoided on late participant deferral deposits.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "payroll_remittances": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "tax_year": {
            "type": "integer",
            "default": 2026
          },
          "safe_harbor_business_days": {
            "type": "integer"
          }
        },
        "required": [
          "payroll_remittances"
        ]
      }
    }
  ],
