{
  "$schema": "../schema.json",
  "name": "net.enroutz/booking",
  "title": "Enroutz Chauffeur Booking",
  "category": "Vector DBs & AI Search",
  "description": "Search Enroutz chauffeur coverage in Canada, the US and worldwide and send booking requests.",
  "tools": [
    {
      "name": "search_coverage",
      "description": "Find Enroutz pages for an airport (IATA code or name), FBO, hotel, train station, cruise port, city, country, event, service or travel topic. Returns titles, summaries and URLs (with Markdown versions).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "e.g. \"JFK\", \"Heathrow\", \"Ritz Paris\", \"Port of Miami\", \"Davos delegation\""
          },
          "section": {
            "type": "string",
            "enum": [
              "airports",
              "fbo-private-jet",
              "hotels",
              "train-stations",
              "cruise-ports",
              "events",
              "corporate",
              "government-delegations",
              "attractions",
              "services",
              "blog"
            ],
            "description": "Optional filter"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 8
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_page",
      "description": "Return the Markdown text of an Enroutz page: meeting points, terminals, drive times, tips and FAQ. Accepts a full URL or a path such as /airports/heathrow-airport-lhr/.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "get_booking_options",
      "description": "Services, vehicle classes, what is included, contact channels, the instant-quote web booker link and booking policies.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "request_booking",
      "description": "Send a chauffeured transfer request to the 24/7 dispatch desk for the traveller. Only call when the traveller explicitly asked to book. Returns a reference (ENZ-XXXXXXX); the desk then confirms price, vehicle and chauffeur by email or phone. It is not a confirmed booking until then.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Lead passenger full name"
          },
          "email": {
            "type": "string",
            "description": "Email (email or phone required)"
          },
          "phone": {
            "type": "string",
            "description": "Mobile with country code"
          },
          "service": {
            "type": "string",
            "enum": [
              "Hourly livery / as directed (half-day, full-day, multi-day, weekly, monthly)",
              "Airport pickup",
              "Airport drop-off",
              "City to city",
              "Canada-US cross-border",
              "FBO / private jet",
              "Cruise port",
              "Train station",
              "Hotel transfer",
              "Film / TV production",
              "Celebrity / artist (discreet)",
              "Private client / HNWI",
              "Government delegation / consulate",
              "Corporate account / roadshow",
              "Monthly dedicated chauffeur",
              "Wedding / gala / event",
              "Group / Sprinter / coach",
              "Travel Desk (flights, hotels, packages)"
            ]
          },
          "pickup": {
            "type": "string",
            "description": "Airport code + terminal, FBO, hotel name or full address"
          },
          "dropoff": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "description": "Local pickup date YYYY-MM-DD"
          },
          "time": {
            "type": "string",
            "description": "Local pickup time HH:MM (for arrivals, the scheduled landing time)"
          },
          "flight": {
            "type": "string",
            "description": "Flight, train or ship identifier"
          },
          "passengers": {
            "type": "integer",
            "minimum": 1
          },
          "bags": {
            "type": "integer",
            "minimum": 0
          },
          "vehicle": {
            "type": "string",
            "enum": [
              "Mercedes-Benz E-Class (or similar)",
              "Mercedes-Benz S-Class (or similar)",
              "Luxury SUV (Escalade / Yukon Denali / Navigator)",
              "Mercedes-Maybach (on request)",
              "Rolls-Royce (on request)",
              "Stretch limousine",
              "Mercedes-Benz Sprinter (up to 14)",
              "Mini coach / motor coach",
              "Multiple vehicles / motorcade"
            ]
          },
          "return": {
            "type": "string",
            "description": "Return trip details, if any"
          },
          "hours": {
            "type": "string",
            "description": "For hourly livery: hours or days needed, e.g. \"6 hours\", \"full day\", \"3 days\", \"weekly\", \"monthly\". Use dropoff \"As directed\"."
          },
          "notes": {
            "type": "string",
            "description": "Child seats, accessibility, sign name, confidentiality, etc."
          },
          "agent": {
            "type": "string",
            "description": "Name of your assistant or app"
          },
          "consent": {
            "type": "string",
            "enum": [
              "yes"
            ],
            "description": "The traveller explicitly asked for this booking"
          }
        },
        "required": [
          "name",
          "pickup",
          "dropoff",
          "date",
          "time",
          "consent"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "net.enroutz/booking",
    "version": "1.0.0",
    "remoteUrl": "https://enroutz.net/api/mcp.php",
    "publishedAt": "2026-11-24T13:46:05.523766Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "2cf540126e2adfb5478441ae0b56f4939e08609af5ea9fcb6ff3764f78d63f3c"
  }
}
