{
  "$schema": "../schema.json",
  "name": "io.github.AI-Chili/aichili",
  "title": "AI Chili Video Generation Studio & API",
  "category": "Developer Tools & DevOps",
  "description": "Generate 15s-30s AI videos & talking avatars via AI Chili REST API and estimate PAYG credit costs.",
  "repository": "https://github.com/AI-Chili/aichili",
  "tools": [
    {
      "name": "platform_overview",
      "description": "Return AI Chili (AIChili) platform capabilities, non-expiring credit pack prices, 5 model IDs, OpenAPI URL, and OnlyChili 80% creator streaming terms.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "list_video_models",
      "description": "Fetch the live AI Chili model registry (/v1/registry) with supported modes, durations, resolutions, aspect ratios, and credit rules.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "available",
              "api",
              "console"
            ],
            "description": "Registry scope (default: available)."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "estimate_video_cost",
      "description": "Calculate exact PAYG credits (including avatar-talk talk vs photo +10 base-clip credits), lowest-cost non-expiring credit pack combination, and optional OnlyChili 80% creator net revenue.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model_id": {
            "type": "string",
            "enum": [
              "h3-vdn",
              "h3-sol",
              "avatar-talk"
            ],
            "description": "Model family for local estimation (default: h3-vdn / h3-sol)."
          },
          "workflow": {
            "type": "string",
            "enum": [
              "talk",
              "photo"
            ],
            "description": "For avatar-talk: photo adds +10 base-clip credits."
          },
          "script_units": {
            "type": "number",
            "description": "Optional script units for avatar-talk (0.2 cr per 5 units)."
          },
          "seconds": {
            "type": "number",
            "description": "Total video seconds to generate (default: 90)."
          },
          "resolution": {
            "type": "string",
            "enum": [
              "480p",
              "768p",
              "1080p",
              "2k"
            ],
            "description": "Target H3-VDN resolution (default: 768p)."
          },
          "free_signup_credits_used": {
            "type": "boolean",
            "description": "Set true if the one-time 25 free sign-up credits have already been spent."
          },
          "subscribers": {
            "type": "number",
            "description": "Optional monthly OnlyChili channel subscribers."
          },
          "sub_price_usd": {
            "type": "number",
            "description": "Optional monthly membership price in USD ($2.99-$99.99)."
          },
          "sub_price": {
            "type": "number",
            "description": "Alias for sub_price_usd."
          },
          "ppv_unlocks": {
            "type": "number",
            "description": "Optional monthly PPV episode unlocks."
          },
          "ppv_count": {
            "type": "number",
            "description": "Alias for ppv_unlocks."
          },
          "ppv_price_usd": {
            "type": "number",
            "description": "Optional PPV unlock price in USD ($0.99-$500.00)."
          },
          "ppv_price": {
            "type": "number",
            "description": "Alias for ppv_price_usd."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_credit_balance",
      "description": "Check spendable non-expiring credits on an AI Chili account using a chili_sk_* API key.",
      "inputSchema": {
        "type": "object",
        "required": [
          "api_key"
        ],
        "properties": {
          "api_key": {
            "type": "string",
            "description": "AI Chili Bearer key prefixed with chili_sk_."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "plan_video_generation",
      "description": "Dry-run validate generation parameters and return exact total_credits at $0 charge via POST /v1/generations/plan.",
      "inputSchema": {
        "type": "object",
        "required": [
          "api_key",
          "mode",
          "model_id"
        ],
        "properties": {
          "api_key": {
            "type": "string",
            "description": "AI Chili Bearer key prefixed with chili_sk_."
          },
          "mode": {
            "type": "string",
            "enum": [
              "t2v",
              "i2v"
            ]
          },
          "model_id": {
            "type": "string",
            "enum": [
              "h3-vdn",
              "h3-sol",
              "wan3.0-video",
              "seedance-2.5",
              "minimax-h3-gmi",
              "avatar-talk"
            ]
          },
          "workflow": {
            "type": "string",
            "description": "Optional workflow (general, reference, photo, talk)."
          },
          "prompt": {
            "type": "string",
            "description": "Visual prompt or spoken script."
          },
          "duration_s": {
            "type": "integer",
            "description": "Duration in seconds (default: 15; omitted on script-driven avatar-talk)."
          },
          "resolution": {
            "type": "string",
            "description": "Target resolution (e.g. 768p, 720p, 720P, 768P, 1080p, 2k, source)."
          },
          "ratio": {
            "type": "string",
            "description": "Aspect ratio (e.g. 16:9, 9:16; omitted on avatar-talk workflow talk)."
          },
          "ref_asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional uploaded asset UUIDs for i2v."
          },
          "ref_roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional roles (reference_image, reference_video, first_frame, last_frame)."
          },
          "seed": {
            "type": "integer",
            "description": "Optional deterministic generation seed."
          },
          "params": {
            "type": "object",
            "description": "Optional nested GenerationParams object (compatible with @aichili/mcp stdio)."
          },
          "upscale_4k": {
            "type": "boolean",
            "description": "Optional 4K upscale toggle."
          },
          "optimize_prompt": {
            "type": "boolean",
            "description": "Optional prompt optimizer toggle."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "create_video_generation",
      "description": "Submit a live AI video generation job via POST /v1/generations (always run plan_video_generation first).",
      "inputSchema": {
        "type": "object",
        "required": [
          "api_key",
          "mode",
          "model_id"
        ],
        "properties": {
          "api_key": {
            "type": "string",
            "description": "AI Chili Bearer key prefixed with chili_sk_."
          },
          "mode": {
            "type": "string",
            "enum": [
              "t2v",
              "i2v"
            ]
          },
          "model_id": {
            "type": "string",
            "enum": [
              "h3-vdn",
              "h3-sol",
              "wan3.0-video",
              "seedance-2.5",
              "minimax-h3-gmi",
              "avatar-talk"
            ]
          },
          "workflow": {
            "type": "string",
            "description": "Optional workflow (general, reference, photo, talk)."
          },
          "prompt": {
            "type": "string"
          },
          "duration_s": {
            "type": "integer"
          },
          "resolution": {
            "type": "string"
          },
          "ratio": {
            "type": "string"
          },
          "ref_asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ref_roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "seed": {
            "type": "integer",
            "description": "Optional deterministic generation seed."
          },
          "params": {
            "type": "object",
            "description": "Optional nested GenerationParams object (compatible with @aichili/mcp stdio)."
          },
          "upscale_4k": {
            "type": "boolean"
          },
          "optimize_prompt": {
            "type": "boolean"
          },
          "idempotency_key": {
            "type": "string",
            "description": "Unique client key sent in JSON body to prevent duplicate charges on retry."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_video_generation",
      "description": "Poll status, credits_cost, and output_asset for a generation job UUID.",
      "inputSchema": {
        "type": "object",
        "required": [
          "api_key",
          "job_id"
        ],
        "properties": {
          "api_key": {
            "type": "string",
            "description": "AI Chili Bearer key prefixed with chili_sk_."
          },
          "job_id": {
            "type": "string",
            "description": "Job UUID returned by create_video_generation."
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.AI-Chili/aichili",
    "version": "1.0.2",
    "remoteUrl": "https://aichili.ai/mcp",
    "publishedAt": "2026-11-25T22:53:55.370236Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "2084d061d6c5fe1a728a4d7eb89651a82b3a62eb106250ba65362ba27d7e4fce"
  }
}
