{
 "$schema": "../schema.json",
 "name": "io.github.HamedShams/whenship",
 "title": "whenship",
 "category": "Developer Tools & DevOps",
 "description": "When will it ship? A live what-if Gantt for small teams: realistic dates and deadline risk.",
 "repository": "https://github.com/HamedShams/whenship",
 "tools": [
  {
   "name": "show_plan",
   "description": "Schedules work for a small team and shows an interactive Gantt chart: finish dates per item, deadline risk (on time / tight / late, with a rough chance), what sets the end date, and the best options to meet more deadlines. Use for \"when will this ship\", \"can we make these deadlines\", prioritising several projects or clients, and capacity planning. Input: people or teams (lanes) and items in priority order with effort in working days. Returns a text summary plus the chart, which the user edits directly. `changes` apply edits first (the answer compares before and after); `suggestions` are options of your own (title + changes), each measured exactly and shown in the chart for the user to apply.",
   "inputSchema": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
     "plan": {
      "type": "object",
      "properties": {
       "title": {
        "type": "string"
       },
       "start": {
        "description": "First day of work. Default today",
        "type": "string"
       },
       "calendar": {
        "type": "object",
        "properties": {
         "workdays": {
          "description": "Default mon-fri",
          "type": "array",
          "items": {
           "type": "string",
           "enum": [
            "mon",
            "tue",
            "wed",
            "thu",
            "fri",
            "sat",
            "sun"
           ]
          }
         },
         "holidays": {
          "type": "array",
          "items": {
           "type": "object",
           "properties": {
            "from": {
             "type": "string",
             "description": "Calendar date, YYYY-MM-DD"
            },
            "to": {
             "type": "string",
             "description": "Calendar date, YYYY-MM-DD"
            },
            "label": {
             "type": "string"
            }
           },
           "required": [
            "from"
           ]
          }
         }
        }
       },
       "lanes": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "id": {
           "description": "Short id; defaults from the name",
           "type": "string"
          },
          "name": {
           "type": "string",
           "description": "A person (\"Sara\") or a team/role (\"Back-end\")"
          },
          "kind": {
           "type": "string",
           "enum": [
            "person",
            "team"
           ]
          },
          "size": {
           "description": "People in a team. Default 1",
           "type": "number"
          },
          "availability": {
           "description": "Percent of their working time available for this plan, 0-100. Default 100",
           "type": "number"
          }
         },
         "required": [
          "name"
         ]
        }
       },
       "items": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "id": {
           "type": "string"
          },
          "name": {
           "type": "string"
          },
          "work": {
           "description": "Who does what. One entry per lane",
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "lane": {
              "type": "string",
              "description": "Lane id or name"
             },
             "days": {
              "type": "number",
              "description": "Effort in working days of one person, exactly as the user estimated it"
             },
             "maxPeople": {
              "description": "Teams only: most people who can work on this at the same time. Default 1",
              "type": "number"
             },
             "after": {
              "description": "Lane of another part of this item that must finish first (a hand-off)",
              "type": "string"
             }
            },
            "required": [
             "lane",
             "days"
            ]
           }
          },
          "who": {
           "description": "Shorthand for one lane instead of `work`",
           "type": "string"
          },
          "days": {
           "description": "Shorthand effort with `who`",
           "type": "number"
          },
          "deadline": {
           "type": "string",
           "description": "Calendar date, YYYY-MM-DD"
          },
          "dependsOn": {
           "description": "Ids or names of items that must finish first",
           "type": "array",
           "items": {
            "type": "string"
           }
          },
          "notBefore": {
           "description": "Waiting on something external: cannot start before this date",
           "type": "string"
          },
          "note": {
           "type": "string"
          }
         },
         "required": [
          "name"
         ]
        },
        "description": "In priority order: earlier items get people first"
       }
      },
      "required": [
       "items"
      ],
      "description": "A whenship plan. Pass the current plan (from the chart or the last tool result) unchanged unless the user asked for changes"
     },
     "changes": {
      "description": "Edits to apply first, in order (same format as what_if)",
      "type": "array",
      "items": {
       "oneOf": [
        {
         "type": "object",
         "properties": {
          "op": {
           "type": "string",
           "const": "move"
          },
          "item": {
           "type": "string"
          },
          "to": {
           "type": "number",
