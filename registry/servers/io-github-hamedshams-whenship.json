             "type": "null"
            }
           ],
           "description": "Waiting on something external until this date; null clears it"
          }
         },
         "required": [
          "op",
          "item",
          "date"
         ]
        },
        {
         "type": "object",
         "properties": {
          "op": {
           "type": "string",
           "const": "setLane"
          },
          "lane": {
           "type": "string"
          },
          "size": {
           "type": "number"
          },
          "availability": {
           "type": "number"
          },
          "name": {
           "type": "string"
          }
         },
         "required": [
          "op",
          "lane"
         ]
        },
        {
         "type": "object",
         "properties": {
          "op": {
           "type": "string",
           "const": "addLane"
          },
          "lane": {
           "type": "object",
           "properties": {
            "id": {
             "description": "Short id; defaults from the name",
             "type": "string"
            },
            "name": {
             "type": "string",
             "description": "A person (\"Sara\") or a team/role (\"Back-end\")"
            },
            "kind": {
             "type": "string",
             "enum": [
              "person",
              "team"
             ]
            },
            "size": {
             "description": "People in a team. Default 1",
             "type": "number"
            },
            "availability": {
             "description": "Percent of their working time available for this plan, 0-100. Default 100",
             "type": "number"
            }
           },
           "required": [
            "name"
           ]
          }
         },
         "required": [
          "op",
          "lane"
         ]
        },
        {
         "type": "object",
         "properties": {
          "op": {
           "type": "string",
           "const": "setWorkdays"
          },
          "days": {
           "type": "array",
           "items": {
            "type": "string",
            "enum": [
             "mon",
             "tue",
             "wed",
             "thu",
             "fri",
             "sat",
             "sun"
            ]
           }
          }
         },
         "required": [
          "op",
          "days"
         ]
        },
        {
         "type": "object",
         "properties": {
          "op": {
           "type": "string",
           "const": "addHoliday"
          },
          "from": {
           "type": "string",
           "description": "Calendar date, YYYY-MM-DD"
          },
          "to": {
           "type": "string",
           "description": "Calendar date, YYYY-MM-DD"
          },
          "label": {
           "type": "string"
          }
         },
         "required": [
          "op",
          "from"
         ]
        },
        {
         "type": "object",
         "properties": {
          "op": {
           "type": "string",
