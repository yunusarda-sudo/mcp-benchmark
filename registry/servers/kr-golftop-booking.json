{
  "$schema": "../schema.json",
  "name": "kr.golftop/booking",
  "title": "골프탑 예약 도우미",
  "category": "Travel, Maps & Navigation",
  "description": "골프탑(golftop.kr) 빈 티타임, 골프장 정보, 조인·양도 티를 찾아 주는 조회 전용 서버 (한국 골프장)",
  "tools": [
    {
      "name": "search_tee_times",
      "description": "Search available tee times at golf courses in Korea on Golftop(골프탑). 골프탑과 실시간 연동된 골프장의 예약 가능한 빈 티타임을 찾습니다. 그린피는 1인 기준, 결제는 현장 결제입니다. 결과의 booking_url 에서 골프탑 회원 로그인 후 바로 예약할 수 있습니다. 여러 날짜는 days 로 최대 7일까지 한 번에 찾습니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "라운드 날짜 YYYY-MM-DD (오늘부터 최대 40일 뒤까지)"
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7,
            "description": "date 부터 며칠을 찾을지 (기본 1)"
          },
          "region": {
            "type": "string",
            "description": "지역. 예: 경기, 경기남부, 경기북부, 강원, 충청, 경상, 전라, 제주 (일부만 입력해도 됨)"
          },
          "golf_course": {
            "type": "string",
            "description": "골프장 이름 일부. 예: 클럽72, 양평"
          },
          "time_from": {
            "type": "string",
            "description": "이 시각 이후 티오프 HH:MM (예: 06:00)"
          },
          "time_to": {
            "type": "string",
            "description": "이 시각 이전 티오프 HH:MM (예: 09:00)"
          },
          "max_green_fee": {
            "type": "integer",
            "description": "1인 그린피 상한 (원)"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "최대 결과 수 (기본 30)"
          }
        },
        "required": [
          "date"
        ]
      }
    },
    {
      "name": "get_golf_course",
      "description": "Get golf course information (region, address, holes, phone, deposit, cancellation rule) from Golftop(골프탑). 골프탑에 등록된 골프장의 지역·주소·홀 수·전화·선입금·취소 규정·실시간 예약 가능 여부를 알려 줍니다. 이름 또는 지역으로 찾습니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "골프장 이름 일부. 예: 클럽72, 양평"
          },
          "region": {
            "type": "string",
            "description": "지역. 예: 경기, 경기남부, 경기북부, 강원, 충청, 경상, 전라, 제주 (일부만 입력해도 됨)"
          },
          "realtime_only": {
            "type": "boolean",
            "description": "true 면 실시간 예약 가능한 골프장만"
          }
        }
      }
    },
    {
      "name": "search_join_offers",
      "description": "Search join (open seats) and transfer (whole team) tee offers posted by managers on Golftop(골프탑). 골프탑 매니저가 모집 중인 조인(빈자리 채우기)과 양도(팀 전체 넘기기) 티를 찾습니다. 홍보 글은 담당 매니저에게 전화로 예약합니다(manager_phone). 인트라넷 조인 티(source=apply)는 골프탑 웹사이트에서 참여 신청할 수 있습니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "라운드 날짜 YYYY-MM-DD (오늘부터 최대 40일 뒤까지)"
          },
          "region": {
            "type": "string",
            "description": "지역. 예: 경기, 경기남부, 경기북부, 강원, 충청, 경상, 전라, 제주 (일부만 입력해도 됨)"
          },
          "golf_course": {
            "type": "string",
            "description": "골프장 이름 일부. 예: 클럽72, 양평"
          },
          "type": {
            "type": "string",
            "enum": [
              "join",
              "transfer",
              "any"
            ],
            "description": "join=조인, transfer=양도, any=전체 (기본)"
          },
          "people": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "description": "필요한 자리 수"
          },
          "time_from": {
            "type": "string",
            "description": "HH:MM 이후"
          },
          "time_to": {
            "type": "string",
            "description": "HH:MM 이전"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "최대 결과 수 (기본 20)"
          }
        },
        "required": [
          "date"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "kr.golftop/booking",
    "version": "1.0.0",
    "remoteUrl": "https://www.golftop.kr/mcp/server",
    "publishedAt": "2026-11-26T23:49:02.886377Z",
