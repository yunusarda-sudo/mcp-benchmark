{
  "$schema": "../schema.json",
  "name": "com.declaroad/declaroad",
  "title": "Declaroad",
  "category": "Other",
  "description": "Visa status and entry, customs, cash and medicine rules by destination and passport, sourced.",
  "tools": [
    {
      "name": "check_trip",
      "description": "The visa status and the rules that apply to a trip: one destination country, one passport. Each rule has its official source. Use the country's ISO code or its English or Russian name.",
      "inputSchema": {
        "properties": {
          "destination": {
            "description": "the country of the trip, e.g. TR or Turkey",
            "type": "string"
          },
          "items": {
            "description": "what the traveller carries, if anything",
            "items": {
              "enum": [
                "alcohol",
                "antiques",
                "cash",
                "drone",
                "food",
                "meds_rx",
                "minor",
                "pet",
                "phone",
                "sat_device",
                "tobacco",
                "valuables",
                "vape"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "lang": {
            "description": "the language of the rule texts; en if left out",
            "enum": [
              "de",
              "en",
              "es",
              "fr",
              "ru"
            ],
            "type": "string"
          },
          "passport": {
            "description": "the country of the traveller's passport, e.g. KZ or Kazakhstan",
            "type": "string"
          },
          "purpose": {
            "enum": [
              "study",
              "tourism",
              "transit",
              "work"
            ],
            "type": "string"
          },
          "stay_days": {
            "description": "the length of the stay",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "destination",
          "passport"
        ],
        "type": "object"
      }
    },
    {
      "name": "list_coverage",
      "description": "The destination countries Declaroad has rules for and the passports it answers for.",
      "inputSchema": {
        "properties": {},
        "type": "object"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.declaroad/declaroad",
    "version": "1.0.0",
    "remoteUrl": "https://declaroad.com/mcp",
    "publishedAt": "2026-11-17T19:42:16.371863Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "9105692a79191b7af510d3f47b97f5ccf76cec2c052086d9daf17371ea8014db"
  }
}
