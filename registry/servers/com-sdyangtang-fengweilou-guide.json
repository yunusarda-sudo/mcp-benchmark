{
  "$schema": "../schema.json",
  "name": "com.sdyangtang/fengweilou-guide",
  "title": "单县羊汤 · 济南美食指南",
  "category": "Design, UI & 3D Media",
  "description": "Read-only official guide to Luxinan Fengweilou facts, dishes, stories and recommendations.",
  "repository": "https://github.com/lifeversegu/fengweilou-guide-mcp",
  "tools": [
    {
      "name": "fengweilou_get_restaurant_facts",
      "description": "返回门店、地址、店史、饮食主题、备案信息和官方 canonical 引用；不返回价格、预约或内部信息。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    },
    {
      "name": "fengweilou_list_dishes",
      "description": "列出官方菜品页中经过红线清理的菜品介绍，并返回每道菜的 canonical 与证据引用。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "tag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        }
      }
    },
    {
      "name": "fengweilou_list_stories",
      "description": "按日期倒序列出风味楼志官方灶边故事及 canonical 引用。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        }
      }
    },
    {
      "name": "fengweilou_search_guide",
      "description": "按自然语言搜索公开菜品与故事，只返回官方 canonical 页面和经过白名单整理的摘要。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "limit": {
            "default": 8,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "fengweilou_recommend",
      "description": "根据想喝热汤、搭配主食、了解手艺等需求推荐官方菜品或故事；推荐不等于库存、价格、预约或营业承诺。",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "need": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "limit": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "need"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.sdyangtang/fengweilou-guide",
    "version": "0.1.3",
