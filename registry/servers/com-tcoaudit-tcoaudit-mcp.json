{
  "$schema": "../schema.json",
  "name": "com.tcoaudit/tcoaudit-mcp",
  "title": "TCO Audit MCP",
  "category": "AI, LLMs & Agents",
  "description": "36-month B2B SaaS TCO modeling and website SEO/llms.txt AI-readiness checks.",
  "repository": "https://github.com/TCOAudit/tcoaudit-mcp",
  "tools": [
    {
      "name": "calculate_saas_tco",
      "description": "Calculate 12- and 36-month B2B SaaS Total Cost of Ownership comparing Zapier and legacy CRMs against n8n, Make, Railway self-hosting, Brevo, and Systeme.io.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "monthly_tasks": {
            "type": "integer",
            "description": "Monthly automation steps/tasks (e.g. 50000)"
          },
          "steps_per_workflow": {
            "type": "integer",
            "description": "Average steps per workflow run (default 5)"
          },
          "contacts": {
            "type": "integer",
            "description": "Active CRM/email contacts (e.g. 25000)"
          },
          "emails_per_contact": {
            "type": "integer",
            "description": "Monthly emails sent per contact (default 4)"
          }
        },
        "required": [
          "monthly_tasks",
          "contacts"
        ]
      }
    },
    {
      "name": "check_url_geo_readiness",
      "description": "Inspect a public website URL for origin TTFB latency, canonical tag, JSON-LD schema, robots.txt AI crawler access, and /llms.txt AI answer-engine readiness.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Public website domain or https:// URL to inspect"
          }
        },
        "required": [
          "url"
        ]
      }
    }
  ],
