{
  "$schema": "../schema.json",
  "name": "Tavily Search MCP",
  "category": "Vector DBs & AI Search",
  "description": "Tavily Search MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "tavily_search",
      "description": "Execute autonomous AI web search optimized for LLM factual retrieval.",
      "inputSchema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query topic."
          },
          "searchDepth": {
            "type": "string",
            "enum": [
              "basic",
              "advanced"
            ],
            "description": "Search depth intensity."
          }
        }
      }
    }
  ]
}
