{
  "$schema": "../schema.json",
  "name": "com.searchdataapi/google-search-serp-news-mcp",
  "category": "Vector DBs & AI Search",
  "description": "Real-time web search SERP, news, images & autocomplete API for AI agents ($0.001/call or x402).",
  "tools": [
    {
      "name": "google_search",
      "description": "Search live Google web results for any query and country/language, returning ranked canonical organic results (position, title, direct URL, domain, snippet, favicon, sitelinks), native related_keywords array, People Also Ask (PAA) Q&A pairs, and Knowledge Graph. Cost: 2 Credits / call ($0.20/1K queries; 0 Credits if empty or error).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "Search query string, e.g. \"best vector database for rag 2026\" or \"site:sec.gov nvidia 10-k\"."
          },
          "country": {
            "type": "string",
            "default": "us",
            "description": "ISO 3166-1 alpha-2 country code (e.g. \"us\", \"gb\", \"de\", \"jp\")."
          },
          "lang": {
            "type": "string",
            "default": "en",
            "description": "ISO 639-1 language code (e.g. \"en\", \"es\", \"fr\", \"ja\")."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 10,
            "description": "Number of organic results to return (1–100, default 10)."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Pagination offset (>= 0)."
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "google_trends_realtime",
      "description": "Retrieve real-time trending Google searches for any country, including search volume tiers (e.g. \"50000+\"), breakout status, and clustered news context. Cost: 2 Credits / call ($0.20/1K; 0 Credits if empty).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "default": "US",
            "description": "ISO 3166-1 alpha-2 country code (e.g. \"US\", \"GB\", \"CA\", \"DE\", \"IN\", \"JP\")."
          },
          "category": {
            "type": "string",
            "default": "all",
            "description": "Optional trend category (\"all\", \"business\", \"tech\", \"entertainment\", \"sports\", \"science\", \"health\")."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25,
            "description": "Maximum trending items to return (1–100)."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "google_trends_interest",
      "description": "Fetch the 54-week historical Google Trends Interest Over Time curve (0–100 normalized weekly points), YoY velocity %, peak week, and multi-keyword comparison (up to 5 comma-separated keywords). Cost: 10 Credits / call ($1.00/1K; 0 Credits if empty).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "description": "One keyword or up to 5 comma-separated keywords to compare, e.g. \"mcp server\" or \"claude,chatgpt\"."
          },
          "country": {
            "type": "string",
            "default": "US",
            "description": "ISO 3166-1 alpha-2 country code (default \"US\")."
          },
          "lang": {
            "type": "string",
            "default": "en",
            "description": "ISO 639-1 language code (default \"en\")."
          }
        },
        "required": [
          "keyword"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "google_news_search",
      "description": "Search live Google News articles by keyword, company, or ticker with publisher metadata, favicon, publication UTC timestamp, and article snippet. Cost: 2 Credits / call ($0.20/1K; 0 Credits if empty).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "News search query, e.g. \"OpenAI enterprise\", \"solid state batteries\", or \"NVDA earnings\"."
          },
          "country": {
            "type": "string",
            "default": "US",
            "description": "ISO 3166-1 alpha-2 country code (default \"US\")."
          },
          "lang": {
            "type": "string",
            "default": "en",
            "description": "ISO 639-1 language code (default \"en\")."
          },
          "when": {
            "type": "string",
            "description": "Optional recency filter, e.g. \"1h\", \"1d\", \"7d\", \"1m\", \"1y\"."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "description": "Maximum news articles to return (1–100)."
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "google_news_top",
      "description": "Retrieve breaking Google News top headlines by topic (TECHNOLOGY, BUSINESS, WORLD, NATION, SCIENCE, HEALTH, SPORTS, ENTERTAINMENT) and country. Cost: 2 Credits / call ($0.20/1K).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "TOP",
              "TECHNOLOGY",
              "BUSINESS",
              "WORLD",
              "NATION",
              "SCIENCE",
              "HEALTH",
              "SPORTS",
              "ENTERTAINMENT"
            ],
            "default": "TECHNOLOGY",
            "description": "Google News section topic."
          },
          "country": {
            "type": "string",
            "default": "US",
            "description": "ISO 3166-1 alpha-2 country code (default \"US\")."
          },
          "lang": {
            "type": "string",
            "default": "en",
            "description": "ISO 639-1 language code (default \"en\")."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "description": "Maximum headlines to return (1–100)."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "google_autocomplete",
      "description": "Expand a seed keyword into real-time Google Search autocomplete suggestions for SEO keyword research, query fan-out, and agent query expansion. Cost: 1 Credit / call ($0.10/1K; 0 Credits if empty).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "Seed keyword prefix, e.g. \"best crm for\" or \"how to migrate from serpapi\"."
          },
          "country": {
            "type": "string",
            "default": "us",
            "description": "ISO 3166-1 alpha-2 country code (default \"us\")."
          },
          "lang": {
            "type": "string",
            "default": "en",
            "description": "ISO 639-1 language code (default \"en\")."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10,
            "description": "Maximum autocomplete predictions to return (1–20)."
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false
      }
    }
  ],
