  {
   "name": "list_region_subsidies",
   "description": "시·도(또는 시·군·구) 이름으로 그 지역 소관 제도와 전국 제도를 나열합니다. 지역 판별은 소관기관명을 기준으로 합니다.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "sido": {
      "type": "string",
      "description": "예: 인천광역시, 경기"
     },
     "sigungu": {
      "type": "string",
      "description": "예: 서구, 수원시 장안구"
     },
     "track": {
      "type": "string",
      "enum": [
       "all",
       "personal",
       "business"
      ],
      "default": "all"
     },
     "include_national": {
      "type": "boolean",
      "default": true
     },
     "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 50
     }
    },
    "required": [
     "sido"
    ]
   }
  },
  {
   "name": "deadline_calendar",
   "description": "앞으로 N일(기본 30일) 안에 마감되는 지원금·창업지원사업을 날짜별로 보여 줍니다. 두 트랙(개인·창업)을 함께 또는 따로 볼 수 있고, 마감일을 확실히 읽은 것만 넣으며 '상시신청·예산 소진 시'처럼 날짜가 없는 건수도 함께 알립니다.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365,
      "default": 30
     },
     "track": {
      "type": "string",
      "enum": [
       "all",
       "personal",
       "business"
      ],
      "default": "all"
     },
     "sido": {
      "type": "string",
      "description": "지역으로 좁힐 때(예: 인천광역시)"
     },
     "sigungu": {
      "type": "string"
     },
     "keyword": {
      "type": "string",
      "description": "제도명 키워드"
     },
     "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 50
     }
    },
    "required": []
   }
  },
  {
   "name": "compare_ledgers",
   "description": "일자별로 저장한 카탈로그 스냅샷(장부) 두 장을 비교해 새로 올라온 제도·빠진 제도·기간/금액/대상/모집상태가 바뀐 제도를 알려 줍니다. 날짜를 주지 않으면 최근 두 장을 비교합니다.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "from_date": {
      "type": "string",
      "description": "YYYY-MM-DD (비교 기준일)"
     },
     "to_date": {
      "type": "string",
      "description": "YYYY-MM-DD (기본: 최신)"
     },
     "service_id": {
      "type": "string",
      "description": "한 제도만 볼 때"
     },
     "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 50
     }
    },
    "required": []
   }
  },
  {
   "name": "business_report",
   "description": "세무사·노무사·소상공인 담당자가 **거래처 1곳**의 신청 후보를 한 번에 뽑는 리포트. 업종·상시근로자 수·연매출·업력·소재지를 넣으면 소상공인/소기업 기준 해당 여부를 추정하고, 후보를 소상공인·중소기업·고용·노무·정책자금·세제 네 묶음으로 나눠 우선순위와 마감 D-day(7일 이내 강조)를 붙여 줍니다. 같은 요청을 `/v1/report/export.csv`·`/v1/report/print.html` 로 보내면 거래처 전달용 CSV·인쇄용 요약 뷰를 받습니다. 개인 식별 정보(상호·대표자·연락처)는 받지 않습니다.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "sido": {
      "type": "string",
      "description": "소재지 시·도 (예: 인천광역시)"
     },
     "sigungu": {
      "type": "string",
      "description": "시·군·구 (예: 서해구)"
     },
     "industry": {
      "type": "string",
      "description": "업종 — 코드 또는 한글 별칭: manufacturing(제조), retail(도소매), food(음식숙박), ict(IT·정보통신), service(서비스), construction(건설), logistics(물류), agri(농림어업), education(교육), health(보건의료), culture(문화관광), energy(환경에너지), finance(금융), etc(기타), 창업(예비창업자)"
     },
     "employees": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000,
      "description": "상시근로자 수(대표자 제외, 월 60시간 미만 제외, 60시간 이상 단시간은 0.5명)"
     },
     "annual_revenue_krw": {
      "type": "integer",
      "minimum": 0,
      "description": "직전 사업연도 연매출(원)"
     },
     "annual_revenue_eok": {
      "type": "number",
      "minimum": 0,
      "description": "연매출(억 원) — 원 단위 대신 쓸 수 있음"
     },
     "biz_years": {
      "type": "number",
      "minimum": 0,
      "maximum": 60,
      "description": "업력(년)"
     },
     "biz_status": {
      "type": "string",
      "enum": [
       "pre",
       "operating"
      ],
      "description": "pre(사업자등록 전) | operating(운영 중, 기본값)"
     },
     "biz_entity": {
      "type": "string",
      "enum": [
       "pre_startup",
       "sole_proprietor",
       "small_business",
       "sme",
       "corporate",
       "venture",
       "social_enterprise"
      ],
      "description": "기업 형태(비우면 규모 추정으로 정합니다)"
     },
     "interest": {
      "type": "array",
      "items": {
       "type": "string",
       "enum": [
        "small_business",
        "sme",
        "labor",
        "finance_tax"
       ]
      },
      "description": "보고 싶은 묶음만 고르기(기본: 네 묶음 전부)"
     },
     "keyword": {
      "type": "string",
      "description": "공고명 키워드"
     },
     "include_closed": {
      "type": "boolean",
      "default": false
     },
     "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 60
     }
    },
    "required": []
   }
  },
  {
   "name": "batch_match_clients",
   "description": "세무·노무 사무소가 맡긴 **거래처 50~300곳**을 한 번에 매칭합니다. 익명 코드(client_ref)·업종·상시근로자 수(또는 구간)·연매출(금액 또는 구간)·업력·지역에 더해 **세부 업종 키워드·기업 형태·고용 이슈**가 든 CSV(또는 같은 모양의 JSON 배열)를 주면 거래처마다 지금 신청할 만한 공고 3~5건을 판정 등급·혜택·마감 D-day·**판정 근거**와 함께 돌려주고, 거래처마다 **탈락 사유**(지역·업력·연령·업종·기업 형태·상위 후보 밖)를 사유별로 세어 보여 줍니다. 거래처당 1페이지 요약 HTML(인쇄·PDF)과 CSV도 만듭니다. **상호명·사업자번호·대표자·연락처·이메일·상세주소 열은 값을 읽지 않고 버립니다**(열 이름만 응답에 남김). 매칭은 익명 코드와 조건 코드로만 합니다.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "csv": {
      "type": "string",
      "description": "거래처 CSV 텍스트. 열: client_ref(또는 코드·번호), industry, industry_keyword(세부 업종·취급품목), entity(기업형태: 소상공인·중소기업·법인·개인사업자·벤처기업·창업기업 또는 Y/N), employment(고용이슈: 청년·고령·육아휴직·장애인·사회보험료), employees 또는 employees_bracket(5인 미만·10~49명), revenue_krw 또는 revenue_bracket, business_age_years 또는 founded_year, region(시도·시군구), note(선택). 상호·사업자번호 열이 있어도 버립니다."
     },
     "clients": {
      "type": "array",
      "items": {
       "type": "object"
      },
      "description": "CSV 대신 같은 조건을 JSON 객체 배열로 줄 때(민감 키는 무시)."
     },
     "top_n": {
      "type": "integer",
      "minimum": 3,
      "maximum": 5,
      "default": 5,
      "description": "거래처당 추천 건수(3~5)"
     },
     "allow_labels": {
      "type": "boolean",
      "default": false,
      "description": "note 열을 매칭에 쓰지 않는 표시용 라벨로 결과에 붙일지"
     },
     "include_closed": {
      "type": "boolean",
      "default": false
     },
     "keyword": {
      "type": "string",
      "description": "공고명 키워드로 좁히기"
     },
     "include_report_html": {
      "type": "boolean",
      "default": false,
      "description": "응답에 거래처별 1페이지 요약 HTML 포함"
     },
     "include_csv": {
      "type": "boolean",
      "default": false,
      "description": "응답에 CSV 요약 포함"
     }
    },
    "required": []
   }
  },
  {
   "name": "get_service_meta",
   "description": "카탈로그 상태(실데이터/샘플), 판정 등급 정의, 자격 코드 목록, 입력 가능한 상황 태그, 개인정보 설계를 반환합니다.",
   "inputSchema": {
    "type": "object",
    "properties": {}
   }
  }
