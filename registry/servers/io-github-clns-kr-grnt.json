{
 "$schema": "../schema.json",
 "name": "io.github.CLNS-KR/grnt",
 "title": "GRNT — Korean Grant & Subsidy Intelligence",
 "category": "Developer Tools & DevOps",
 "description": "Korean grant and startup-funding eligibility checks with official reasons and sources.",
 "repository": "https://github.com/CLNS-KR/GRNT",
 "tools": [
  {
   "name": "search_subsidies",
   "description": "나이·성별·거주지·소득구간·상황(임신·출산·무주택·구직·장애 등)과 사업자 조건(예비창업자/운영 중, 업력, 소상공인·중소기업, 업종)을 주면 정부·지자체 지원금과 창업·소상공인·기업 지원사업 후보를 '받을 가능성 높음 / 조건 확인 필요 / 정보 부족'으로 나눠 사유·금액·신청기한·문의처와 함께 돌려줍니다. 모르는 항목은 비워 두면 '정보 부족'으로 답하고 무엇을 더 물어야 하는지 알려 줍니다.",
   "inputSchema": {
    "type": "object",
    "properties": {
     "profile": {
      "type": "object",
      "description": "판정에 쓰는 사용자 조건. 없는 항목은 '모름'으로 보고 판정하지 않습니다. 개인은 나이·지역·소득·상황, 창업·기업은 business 블록(예비/운영, 업력, 업종)을 씁니다.",
      "properties": {
       "track": {
        "type": "string",
        "enum": [
         "all",
         "personal",
         "business"
        ],
        "description": "개인·가구는 personal, 창업·소상공인·기업은 business. 기본 all."
       },
       "age": {
        "type": "integer",
        "minimum": 0,
        "maximum": 120,
        "description": "만 나이"
       },
       "birth_year": {
        "type": "integer",
        "minimum": 1900,
        "maximum": 2100
       },
       "sex": {
        "type": "string",
        "enum": [
         "male",
         "female"
        ]
       },
       "region": {
        "type": "object",
        "properties": {
         "sido": {
          "type": "string"
         },
         "sigungu": {
          "type": "string"
         }
        },
        "description": "개인은 거주지, 사업자는 사업장 소재지."
       },
       "household_size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
       },
       "income_percent": {
        "type": "number",
        "minimum": 0,
        "maximum": 1000,
        "description": "기준 중위소득 %"
       },
       "income_band": {
        "type": "string",
        "enum": [
         "JA0201",
         "JA0202",
         "JA0203",
         "JA0204",
         "JA0205"
        ]
       },
       "situations": {
        "type": "array",
        "items": {
         "type": "string",
         "enum": [
          "pregnant",
          "expecting_parent",
          "birth",
          "parenting",
          "student",
          "college_student",
          "worker",
          "jobseeker",
          "disabled",
          "veteran",
          "illness",
          "farmer",
          "fisher",
          "livestock",
          "forestry",
          "multicultural",
          "north_korean",
          "single_parent",
          "single_household",
          "multi_child",
          "no_home",
          "new_move",
          "extended_family",
          "small_business",
          "startup",
          "closing",
          "food_business",
          "manufacturing",
          "organization"
         ]
        },
        "description": "해당하는 상황 태그. 빈 배열이면 '해당 없음'으로 판정합니다."
       },
       "children_years": {
        "type": "array",
        "items": {
         "type": "integer"
        },
        "description": "자녀 출생연도. 아동 대상 제도의 연령 판정에 씁니다."
       },
       "business": {
        "type": "object",
        "description": "창업·기업 조건. status만 있어도 대부분 판정됩니다.",
        "properties": {
         "status": {
          "type": "string",
          "enum": [
           "pre",
           "operating"
          ],
          "description": "pre=예비창업자, operating=사업자등록 후 운영 중"
         },
         "entity": {
          "type": "string",
          "enum": [
           "pre_startup",
           "sole_proprietor",
           "small_business",
           "sme",
           "corporate",
           "venture",
           "social_enterprise"
          ]
         },
         "years": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "description": "업력(창업 후 경과 연수)"
         },
         "industry": {
          "type": "string",
          "enum": [
           "manufacturing",
           "ict",
           "retail",
           "food",
           "service",
           "construction",
           "logistics",
           "agri",
           "finance",
           "education",
           "health",
           "culture",
           "energy",
           "etc"
          ]
         }
        }
       }
      }
     },
     "track": {
      "type": "string",
      "enum": [
       "all",
       "personal",
       "business"
      ],
      "description": "트랙 선택. business 면 창업·기업 공고만 봅니다."
     },
     "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200,
      "default": 10,
      "description": "돌려줄 최대 건수(최대 200). 탭·집계 숫자는 counts·kind_counts 로 함께 오고 상한에 잘리지 않는다."
     },
     "verdict": {
      "type": "string",
      "enum": [
       "eligible_likely",
       "check_needed",
       "insufficient_info",
       "ineligible"
      ],
      "description": "이 판정만 돌려받는다(예: check_needed 253건 전체 보기). counts 는 필터 전 기준."
     },
     "balance_kinds": {
      "type": "boolean",
      "default": false,
      "description": "지원금·바우처와 교육·건강·프로그램을 예산 비율로 함께 돌려준다."
     },
     "balance_verdicts": {
      "type": "boolean",
      "default": false,
      "description": "상한 안에 판정 그룹(가능성·확인 필요·정보 부족)을 최소 1건씩 넣는다."
     },
     "include_ineligible": {
      "type": "boolean",
      "default": false,
      "description": "해당 없음까지 포함할지"
     },
     "include_closed": {
      "type": "boolean",
      "default": false,
      "description": "모집 마감된 공고도 포함할지"
     },
     "tag": {
      "type": "string",
      "description": "청년·주거·창업·자금 등 주제 필터"
     },
     "keyword": {
      "type": "string",
      "description": "제도명·내용 키워드. 생활어도 됩니다(‘전기세’→전기요금, ‘병원비’→의료비로 동의어 확장, 직접 일치 우선)"
     }
    },
    "required": [
     "profile"
    ]
   }
  },
