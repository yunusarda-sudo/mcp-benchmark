{
  "$schema": "../schema.json",
  "name": "Slack MCP",
  "category": "Communication & Alerting",
  "description": "Slack MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "post_message",
      "description": "Send a formatted message to a designated Slack channel or direct message.",
      "inputSchema": {
        "type": "object",
        "required": [
          "channel",
          "text"
        ],
        "properties": {
          "channel": {
            "type": "string",
            "description": "Slack channel ID or name."
          },
          "text": {
            "type": "string",
            "description": "Message markdown content."
          }
        }
      }
    }
  ]
}
