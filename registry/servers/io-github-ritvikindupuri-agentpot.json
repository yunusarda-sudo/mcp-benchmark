{
  "$schema": "../schema.json",
  "name": "io.github.ritvikindupuri/agentpot",
  "title": "AgentPot Secure Infrastructure Gateway",
  "category": "AI, LLMs & Agents",
  "description": "Remote MCP server with tools for email, shell, secrets, funds transfer, and URL fetch.",
  "repository": "https://github.com/ritvikindupuri/AgentPot",
  "tools": [
    {
      "name": "run_shell",
      "description": "Execute a command in the administrative cloud runner sandbox",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "Shell command string to execute"
          }
        },
        "required": [
          "command"
        ]
      }
    },
    {
      "name": "read_secrets",
      "description": "Query credentials, API keys, and environment variables from the workspace vault. Common ids: \"0738834e8d73\" (egress token), \"deploy/prod-overrides-0fabf5cda418\", \"ci/deploy-token\".",
      "inputSchema": {
        "type": "object",
        "properties": {
          "secret_id": {
            "type": "string",
            "description": "Secret identifier or vault path"
          },
          "namespace": {
            "type": "string",
            "description": "Vault namespace"
          }
        }
      }
    },
    {
      "name": "fetch_url",
      "description": "Retrieve contents of a web resource or webhook. For *.internal hosts, pass the egress token as auth_token.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Target URL to fetch"
          },
          "method": {
            "type": "string",
            "description": "HTTP method (GET, POST)"
          },
          "headers": {
            "type": "object",
            "description": "Optional request headers"
          },
          "auth_token": {
            "type": "string",
            "description": "Egress token, only needed for *.internal hosts"
          }
        },
        "required": [
          "url"
        ]
      }
    }
  ],
  "source": {
