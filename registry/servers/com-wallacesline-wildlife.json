{
  "$schema": "../schema.json",
  "name": "com.wallacesline/wildlife",
  "title": "Wallace's Line — wildlife sighting chances",
  "category": "Other",
  "description": "Chance of seeing each animal in national parks and cities worldwide, by month (GBIF data).",
  "tools": [
    {
      "name": "search",
      "description": "Find animals, animal groups, trip types, national parks, countries and regions on Wallace's Line by name (English; common Spanish names work too). Returns ids to pass to fetch.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Free text, e.g. \"jaguar Brazil\" or \"bears North America\"."
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "fetch",
      "description": "Get the sighting figures behind an id returned by search (an animal: where to see it; a park: its easiest animals; a place: its iconic animals).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "species_where",
      "description": "Best national parks to see an animal or animal group (e.g. \"jaguar\", \"Panthera onca\", \"bears\", \"whales\"), ranked by the daily chance of seeing it; optionally in one month and/or one country or region.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "animal": {
            "type": "string",
            "description": "Common name, scientific name or group."
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "description": "Month 1-12 (optional): use that month's probability."
          },
          "place": {
            "type": "string",
            "description": "Country or region (optional), e.g. \"India\", \"Africa\", \"North America\"."
          }
        },
        "required": [
          "animal"
        ]
      }
    },
    {
      "name": "park_species",
      "description": "The animals you are most likely to see in a national park (daily probability), optionally in one month.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "park": {
            "type": "string",
            "description": "Park name or slug, e.g. \"Corcovado\" or \"kruger\"."
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "description": "Month 1-12 (optional): use that month's probability."
          }
        },
        "required": [
          "park"
        ]
      }
    },
    {
      "name": "iconic",
      "description": "The iconic animals of a country or continent with the park where each is easiest to see, and the best-rated parks there.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "place": {
            "type": "string",
            "description": "Country or continent, e.g. \"Costa Rica\", \"Africa\"."
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "description": "Month 1-12 (optional): use that month's probability."
          }
        },
        "required": [
          "place"
        ]
      }
    },
    {
      "name": "plan_trip",
      "description": "A day-by-day route of parks for a trip of N days in one or more countries, maximising the chance of seeing the animals asked for (or the country's iconic animals), with travel legs. Same engine as the site's trip planner.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "countries": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Countries or a region, e.g. [\"Kenya\",\"Tanzania\"]."
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "description": "Month 1-12 (optional): use that month's probability."
          },
          "animals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Animals or groups to target (optional)."
          },
          "trip_type": {
            "type": "string",
            "enum": [
              "safari",
              "big-cats",
              "primates",
              "bears",
              "jungle",
              "birding",
              "marine",
              "night"
            ],
            "description": "Optional trip style."
          }
        },
        "required": [
          "countries",
          "days"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.wallacesline/wildlife",
    "version": "1.0.0",
    "remoteUrl": "https://wallacesline.com/api/mcp",
    "publishedAt": "2026-11-24T12:01:25.11897Z",
    "fetchedAt": "2026-11-24T12:15:48.059Z",
    "toolsSha256": "2946cc7b8bf58192ad94cb6f2edba7021ebe0484f6d7661c2d960951d7a57a25"
  }
}
