{
  "$schema": "../schema.json",
  "name": "com.creatordeskai/machine-growth",
  "title": "Creator Desk Machine Distribution",
  "category": "AI, LLMs & Agents",
  "description": "Make x402/MCP services discoverable and buyable by agents: audits, preflight, fixes.",
  "repository": "https://github.com/creatordeskai-prog/creator-desk-machine-products",
  "tools": [
    {
      "name": "creator_desk_verify_completion",
      "description": "Use when you have a storefront URL and supplied evidence and need a readiness verdict, defects, corrective actions, and an evidence receipt.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "standard_id": {
            "description": "Commerce verification standard identifier.",
            "type": "string",
            "const": "CDS-COMMERCE-001"
          },
          "standard_version": {
            "description": "Commerce verification standard version.",
            "type": "string",
            "const": "0.2.0"
          },
          "objective": {
            "description": "Optional goal for this verification.",
            "type": "string",
            "maxLength": 2000
          },
          "target_url": {
            "type": "string",
            "format": "uri",
            "description": "Public HTTPS commerce/storefront URL being verified."
          },
          "evidence": {
            "type": "object",
            "properties": {
              "contact_url": {
                "description": "Public contact page URL.",
                "type": "string",
                "format": "uri"
              },
              "shipping_url": {
                "description": "Public shipping policy URL.",
                "type": "string",
                "format": "uri"
              },
              "returns_url": {
                "description": "Public returns policy URL.",
                "type": "string",
                "format": "uri"
              },
              "privacy_url": {
                "description": "Public privacy policy URL.",
                "type": "string",
                "format": "uri"
              },
              "terms_url": {
                "description": "Public terms page URL.",
                "type": "string",
                "format": "uri"
              },
              "product": {
                "description": "Product details shown by the storefront.",
                "type": "object",
                "properties": {
                  "title": {
                    "description": "Product title.",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "price": {
                    "description": "Product price and currency.",
                    "type": "object",
                    "properties": {
                      "amount": {
                        "description": "Nonnegative price amount.",
                        "type": "number",
                        "minimum": 0
                      },
                      "currency": {
                        "description": "Three-letter currency code.",
                        "type": "string",
                        "pattern": "^[A-Za-z]{3}$"
                      }
                    },
                    "additionalProperties": false
                  },
                  "inventory": {
                    "description": "Reported product inventory.",
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "cart": {
                "description": "Shopping cart availability and URL.",
                "type": "object",
                "properties": {
                  "available": {
                    "description": "Whether this storefront feature is available.",
                    "type": "boolean"
                  },
                  "url": {
                    "description": "Public storefront feature URL.",
                    "type": "string",
                    "format": "uri"
                  }
                },
                "additionalProperties": false
              },
              "checkout": {
                "description": "Checkout availability and URL.",
                "type": "object",
                "properties": {
                  "available": {
                    "description": "Whether this storefront feature is available.",
                    "type": "boolean"
                  },
                  "url": {
                    "description": "Public storefront feature URL.",
                    "type": "string",
                    "format": "uri"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false,
            "description": "Storefront evidence to check."
          }
        },
        "required": [
          "target_url",
          "evidence"
        ]
      }
    },
    {
      "name": "creator_desk_inspect_url",
      "description": "Use when you have a public HTTPS URL and need its HTTP status, redirects, latency, security headers, and page metadata.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri",
            "description": "Public URL to inspect or extract."
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "creator_desk_agent_preflight",
      "description": "Use when you have a public HTTPS agent origin and need an A2A and x402 readiness verdict with surface checks.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "origin": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri",
            "description": "Public agent origin to check."
          }
        },
        "required": [
          "origin"
        ]
      }
    },
    {
      "name": "creator_desk_machine_distribution_offers",
      "description": "Use when you need Creator Desk Machine Distribution pricing, its service page and available checkout or x402 links.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.creatordeskai/machine-growth",
    "version": "0.1.0",
    "remoteUrl": "https://api.creatordeskai.com/mcp/machine-growth",
    "publishedAt": "2026-11-26T09:04:52.70026Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "75f0031dc69b3742128571c90818e9de78d8a67b6de40282a8368f2bbf6b5d6e"
  }
}
