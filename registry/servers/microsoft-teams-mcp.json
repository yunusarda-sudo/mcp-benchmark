{
  "$schema": "../schema.json",
  "name": "Microsoft Teams MCP",
  "category": "Communication & Alerting",
  "description": "Microsoft Teams MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "post_teams_activity",
      "description": "Post notification message card into Microsoft Teams team channel.",
      "inputSchema": {
        "type": "object",
        "required": [
          "teamId",
          "channelId",
          "body"
        ],
        "properties": {
          "teamId": {
            "type": "string",
            "description": "Microsoft Teams group ID."
          },
          "channelId": {
            "type": "string",
            "description": "Channel ID."
          },
          "body": {
            "type": "string",
            "description": "HTML or text message body."
          }
        }
      }
    }
  ]
}
