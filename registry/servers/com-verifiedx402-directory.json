{
  "$schema": "../schema.json",
  "name": "com.verifiedx402/directory",
  "title": "Verified x402",
  "category": "AI, LLMs & Agents",
  "description": "Verified directory of paid x402 APIs for AI agents. Free search, $0.005 ranked picks in USDC.",
  "tools": [
    {
      "name": "recommend",
      "description": "Rank verified x402 endpoints for a task. On the HTTP transport this call is paid (HTTP 402, then PAYMENT-SIGNATURE). The stdio process reads the local index directly.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "description": "What the agent needs done."
          },
          "category": {
            "type": "string"
          },
          "max_price": {
            "type": "number",
            "description": "Maximum advertised USDC price."
          },
          "network": {
            "type": "string",
            "description": "CAIP-2 network id, for example eip155:8453."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        }
      }
    },
    {
      "name": "check_endpoint",
      "description": "Probe one public URL for a live HTTP 402 challenge and compare it with the catalog entry when one exists. Does not pay.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "search",
      "description": "Free, rate-limited catalog search. Includes listings that have not been probed yet.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "network": {
            "type": "string"
          },
          "max_price": {
            "type": "number"
          },
          "limit": {
            "type": "integer"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.verifiedx402/directory",
    "version": "1.0.0",
    "remoteUrl": "https://verifiedx402.com/mcp",
    "publishedAt": "2026-11-25T01:29:10.067231Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "46561d46ae67a506f2a140709ffddf7997d64cdee017cc6aadc1e43aedcea429"
  }
}
