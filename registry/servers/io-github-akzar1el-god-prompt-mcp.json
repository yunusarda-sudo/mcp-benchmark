{
  "$schema": "../schema.json",
  "name": "io.github.AKzar1el/god-prompt-mcp",
  "title": "GodPrompt MCP Server",
  "category": "AI, LLMs & Agents",
  "description": "GodPrompt MCP + Agent Skill for code review, requirements, test planning, and verification.",
  "repository": "https://github.com/AKzar1el/god-prompt-mcp",
  "tools": [
    {
      "name": "get_god_prompt",
      "description": "Returns the complete GodPrompt.md — a single-file universal system prompt for AI software development (63KB, ~1145 lines). With no arguments, returns the original full text for backward compatibility. Bridges may truncate the middle of such a large response: pass start (initially 0) and maxChars (at most 8192) to retrieve bounded, lossless chunks; structuredContent.nextStart gives the next offset, or null at EOF. For progressive disclosure, use get_core_skill and references instead.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64568
          },
          "maxChars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          }
        }
      }
    },
    {
      "name": "get_core_skill",
      "description": "Returns SKILL.md — the lean core protocol (~32KB) covering the universal 6-phase protocol, Three Iron Laws, and task auto-classification. Load it at the start of a task or after a context reset, then reuse that context instead of reloading it on every message. Start here for progressive disclosure.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_protocols",
      "description": "Returns references/01-PROTOCOLS.md — deep execution guides for each task type (BUILD, DEBUG, REFACTOR, CONTENT, DESIGN, SHIP, ANALYZE, AUTOMATE, PLAN). Load this when the task requires detailed protocol steps beyond the core skill. ~13KB.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_gates",
      "description": "Returns references/02-GATES.md — verification checklists, THE GATE (pre-completion verification), and structured report templates for every deliverable type. Load when you need to verify work before claiming completion. ~9KB.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_anti_patterns",
      "description": "Returns references/03-ANTI-PATTERNS.md — red flags, rationalizations, and recovery patterns. Covers the 10 most dangerous anti-patterns that lead to broken code, scope creep, and false confidence. Load when you catch yourself rationalizing. ~9KB.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "classify_task",
      "description": "Classify one concrete software-development task into one of GodPrompt's 9 task types (BUILD, DEBUG, REFACTOR, CONTENT, DESIGN, SHIP, ANALYZE, AUTOMATE, PLAN), or UNCLASSIFIED when no reliable route is detected. Returns JSON with task_type, deterministic confidence, protocol, matched_signals, alternative_task_types, ambiguous, and recommendation; use it for routing before loading detailed workflow text.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1000,
            "description": "The task description to classify; include at least one Unicode letter or number, e.g. 'fix the login bug' or 'build a REST API for user auth'"
          }
        },
        "required": [
          "description"
        ]
      }
    },
    {
      "name": "get_version",
      "description": "Returns JSON with the GodPrompt content version, MCP server version, repository, bundled file sizes and purposes, and task-type/protocol catalog. Use it to verify which GodPrompt content/server version a client is connected to; use the content retrieval tools when you need the actual workflow text.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "create_work_contract",
      "description": "Create a portable, SHA-256-fingerprinted task contract with explicitly provided scope, acceptance criteria, verification commands and prohibitions. Deterministic, read-only and stateless. Use classify_task first; missing details produce NEEDS_DEFINITION, never inferred commands or permission to execute.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "task": {
            "type": "string",
            "minLength": 5,
            "maxLength": 3000
          },
          "task_type": {
            "default": "UNCLASSIFIED",
            "type": "string",
            "enum": [
              "BUILD",
              "DEBUG",
              "REFACTOR",
              "CONTENT",
              "DESIGN",
              "SHIP",
              "ANALYZE",
              "AUTOMATE",
              "PLAN",
              "UNCLASSIFIED"
            ]
          },
          "risk_level": {
            "default": "medium",
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "allowed_paths": {
            "default": [],
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "forbidden_actions": {
            "default": [],
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 500
            }
          },
          "success_criteria": {
            "default": [],
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 500
            }
          },
          "verification_commands": {
            "default": [],
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        },
        "required": [
          "task"
        ]
      }
    },
    {
      "name": "review_work_evidence",
      "description": "Fail-closed audit of a create_work_contract result against supplied changed paths, command receipts, criteria, prohibited actions and risk review. Returns HOLD or REPORTED_READY_FOR_INDEPENDENT_REVIEW; never independently verifies caller-supplied evidence or authorizes completion, merge or deployment.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "contract": {
            "type": "object",
            "properties": {
              "schema": {
                "type": "string",
                "const": "godprompt.work_contract.v1"
              },
              "task": {
                "type": "string",
                "minLength": 5,
                "maxLength": 3000
              },
              "task_type": {
                "type": "string",
                "enum": [
                  "BUILD",
                  "DEBUG",
                  "REFACTOR",
                  "CONTENT",
                  "DESIGN",
                  "SHIP",
                  "ANALYZE",
                  "AUTOMATE",
                  "PLAN",
                  "UNCLASSIFIED"
                ]
              },
              "risk_level": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "allowed_paths": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                }
              },
              "forbidden_actions": {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 500
                }
              },
              "success_criteria": {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^AC-[0-9]{2}$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 3,
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "id",
                    "text"
                  ]
                }
              },
              "verification_commands": {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^VC-[0-9]{2}$"
                    },
                    "command": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    }
                  },
                  "required": [
                    "id",
                    "command"
                  ]
                }
              },
              "contract_id": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "schema",
              "task",
              "task_type",
              "risk_level",
              "allowed_paths",
              "forbidden_actions",
              "success_criteria",
              "verification_commands",
              "contract_id"
            ]
          },
          "changed_files": {
            "default": [],
            "maxItems": 150,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "operations_performed": {
            "default": [],
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 500
            }
          },
          "checks": {
            "default": [],
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^VC-[0-9]{2}$"
                },
                "command": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "exit_code": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence_excerpt": {
                  "default": "",
                  "type": "string",
                  "maxLength": 1000
                },
                "source": {
                  "default": "self_report",
                  "type": "string",
                  "enum": [
                    "tool_output",
                    "self_report"
                  ]
                }
              },
              "required": [
                "id",
                "command",
                "exit_code"
              ]
            }
          },
          "acceptance": {
            "default": [],
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^AC-[0-9]{2}$"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "met",
                    "unmet",
                    "unknown"
                  ]
                },
                "evidence_refs": {
                  "default": [],
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                }
              },
              "required": [
                "id",
                "status"
              ]
            }
          },
          "observations": {
            "default": [],
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^OBS-[0-9]{2}$"
                },
                "note": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 1000
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "tool_output",
                    "manual_report"
                  ]
                }
              },
              "required": [
                "id",
                "note",
                "source"
              ]
            }
          },
          "human_review_reported": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "contract"
        ]
      }
    },
    {
      "name": "review_code_change",
      "description": "Analyze a bounded unified diff for line-anchored risk signals, changed-file coverage, and review follow-ups. Heuristics only: not a semantic review, vulnerability scanner or verified test result. Stateless, no repository access.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "diff": {
            "type": "string",
            "minLength": 10,
            "maxLength": 120000
          }
        },
        "required": [
          "diff"
        ]
      }
    },
    {
      "name": "audit_requirements",
      "description": "Inspect bounded requirement text for missing acceptance scenarios, qualitative obligations and duplicates. Returns source-line-linked clarification prompts; cannot validate business correctness.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "specification": {
            "type": "string",
            "minLength": 10,
            "maxLength": 16000
          }
        },
        "required": [
          "specification"
        ]
      }
    },
    {
      "name": "build_test_matrix",
      "description": "Draft bounded positive, negative, boundary and regression test cases for supplied requirements. Reuses the requirements parser, reports unspecified expectations and never claims tests ran.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "specification": {
            "type": "string",
            "minLength": 10,
            "maxLength": 16000
          },
          "max_cases": {
            "default": 24,
            "type": "integer",
            "minimum": 4,
            "maximum": 80
          }
        },
        "required": [
          "specification"
        ]
      }
    },
    {
      "name": "get_tailored_guidance",
      "description": "Return only the relevant task-type protocol or quality gate for one phase, paged into small bounded chunks. More efficient than loading the entire reference; no tool execution or verification.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "task_type": {
            "type": "string",
            "enum": [
              "BUILD",
              "DEBUG",
              "REFACTOR",
              "CONTENT",
              "DESIGN",
              "SHIP",
              "ANALYZE",
              "AUTOMATE",
              "PLAN"
            ]
          },
          "phase": {
            "default": "execute",
            "type": "string",
            "enum": [
              "plan",
              "execute",
              "verify",
              "handoff"
            ]
          },
          "start": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 60000
          },
          "max_chars": {
            "default": 1800,
            "type": "integer",
            "minimum": 200,
            "maximum": 4000
          }
        },
        "required": [
          "task_type"
        ]
      }
    },
    {
      "name": "diagnose_failure",
      "description": "Return bounded evidence-class hypotheses and differentiating experiments for supplied symptoms/logs. Does not expose raw logs or claim a root cause.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "symptoms": {
            "type": "string",
            "minLength": 10,
            "maxLength": 3000
          },
          "logs": {
            "type": "string",
            "maxLength": 8000
          }
        },
        "required": [
          "symptoms"
        ]
      }
    },
    {
      "name": "assess_release_readiness",
      "description": "Check caller-reported CI checks, source/artifact revision, rollback, migration and approvals for missing blockers; never authorize deployment or authenticate receipts.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "staging",
              "production"
            ]
          },
          "checks": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "passed",
                    "failed",
                    "not_run"
                  ]
                }
              },
              "required": [
                "name",
                "status"
              ]
            }
          },
          "source_revision": {
            "type": "string",
            "minLength": 7,
            "maxLength": 80
          },
          "artifact_revision": {
            "type": "string",
            "minLength": 7,
            "maxLength": 80
          },
          "rollback_plan": {
            "type": "string",
            "maxLength": 1000
          },
          "migration_involved": {
            "type": "boolean"
          },
          "migration_plan": {
            "type": "string",
            "maxLength": 1000
          },
          "approval_reported": {
            "type": "boolean"
          }
        },
        "required": [
          "target",
          "checks"
        ]
      }
    },
    {
      "name": "create_context_handoff",
      "description": "Compose a bounded, explicitly unverified state transfer from caller-reported decisions, open items and evidence references, with best-effort token/email redaction.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "goal": {
            "type": "string",
            "minLength": 5,
            "maxLength": 600
          },
          "decisions": {
            "default": [],
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 250
            }
          },
          "completed": {
            "default": [],
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 250
            }
          },
          "open_items": {
            "default": [],
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 250
            }
          },
          "evidence": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "reference": {
                  "type": "string",
                  "maxLength": 80
                },
                "description": {
                  "type": "string",
                  "maxLength": 200
                },
                "independently_verified": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "reference",
                "description"
              ]
            }
          }
        },
        "required": [
          "goal"
        ]
      }
    },
    {
      "name": "compare_evaluation_runs",
      "description": "Compare bounded caller-reported outcomes on exact matching case IDs, with coverage exclusions and low-sample warnings. No API calls, statistical significance claims or stored results.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "baseline": {
            "minItems": 1,
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "case_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "passed": {
                  "type": "boolean"
                },
                "duration_ms": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 604800000
                },
                "cost_usd": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000
                }
              },
              "required": [
                "case_id",
                "passed"
              ]
            }
          },
          "candidate": {
            "minItems": 1,
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "case_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "passed": {
                  "type": "boolean"
                },
                "duration_ms": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 604800000
                },
                "cost_usd": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1000000
                }
              },
              "required": [
                "case_id",
                "passed"
              ]
            }
          }
        },
        "required": [
          "baseline",
          "candidate"
        ]
      }
    },
    {
      "name": "audit_agent_trajectory",
      "description": "Read-only review of bounded, sanitized event metadata for repeated failures, scope drift, stale verification and premature completion. No raw logs or independent execution evidence; cannot authorize an agent.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "events": {
            "minItems": 1,
            "maxItems": 150,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "tool_call",
                    "tool_result",
                    "verification",
                    "completion",
                    "decision"
                  ]
                },
                "operation": {
                  "type": "string",
                  "enum": [
                    "read",
                    "write",
                    "verify",
                    "other"
                  ]
                },
                "tool": {
                  "type": "string",
                  "maxLength": 100
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ok",
                    "failed",
                    "skipped",
                    "unknown"
                  ]
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "allowed",
                    "outside",
                    "unknown"
                  ]
                },
                "fingerprint": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]{1,80}$"
                },
                "tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 200000
                }
              },
              "required": [
                "id",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "budget_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000000
          }
        },
        "required": [
          "events"
        ]
      }
    },
    {
      "name": "trace_change_impact",
      "description": "Rank affected files and select test cases with explicit dependency and requirement-to-test mappings. All graph and receipt evidence must be supplied by caller; no repository or command execution.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "changed_files": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "dependencies": {
            "default": [],
            "maxItems": 250,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "consumer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "dependency": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                }
              },
              "required": [
                "consumer",
                "dependency"
              ],
              "additionalProperties": false
            }
          },
          "requirements": {
            "default": [],
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                },
                "files": {
                  "maxItems": 25,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  }
                }
              },
              "required": [
                "id",
                "files"
              ],
              "additionalProperties": false
            }
          },
          "tests": {
            "default": [],
            "maxItems": 70,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                },
                "covers_files": {
                  "default": [],
                  "maxItems": 25,
                  "type": "array",
                  "items": {
