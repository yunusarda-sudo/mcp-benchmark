{
  "$schema": "../schema.json",
  "name": "io.voidjet/empty-legs",
  "title": "voidjet empty legs",
  "category": "Communication & Alerting",
  "description": "Search empty-leg private jet offers; prepare inquiries and alerts the user confirms by email.",
  "tools": [
    {
      "name": "search_empty_legs",
      "description": "Finds current empty-leg flights by origin and/or destination (city, IATA/ICAO code, country, US state, region or area such as Greek Islands), dates, passengers, budget and aircraft class. Returns up to 20 offers with route, date, aircraft, seats, indicative price, a voidjet link and a pre-filled inquiry link; provider names are not included. When more offers match, refine summarises all matches (frequent destinations, date span, prices). With no match, charter_alternative may contain a regular charter via partner Villiers: NOT an empty leg; it names the partner and states that voidjet receives a fee from the partner.",
      "inputSchema": {
        "properties": {
          "origin": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Departure city or IATA/ICAO code (e.g. Nice, NCE), or a country, US state, region or area (e.g. Greece, Florida, Caribbean, Greek Islands).",
            "title": "Origin"
          },
          "destination": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Arrival city, IATA/ICAO code, country, US state, region or area.",
            "title": "Destination"
          },
          "date_from": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Earliest departure date (YYYY-MM-DD), default today.",
            "title": "Date From"
          },
          "date_to": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Latest departure date, at most 120 days after date_from.",
            "title": "Date To"
          },
          "passengers": {
            "anyOf": [
              {
                "maximum": 19,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Number of passengers; only offers with at least this many seats.",
            "title": "Passengers"
          },
          "max_price_eur": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "maximum": 1000000,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Maximum price in EUR for the whole aircraft.",
            "title": "Max Price Eur"
          },
          "aircraft_class": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "vlj",
                    "light",
                    "midsize",
                    "super_midsize",
                    "heavy",
                    "ultra",
                    "turboprop",
                    "airliner_vip"
                  ],
                  "type": "string"
                },
                "maxItems": 8,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only these aircraft classes. Offers without a known aircraft type are excluded.",
            "title": "Aircraft Class"
          },
          "sort": {
            "default": "date",
            "description": "Order of results: date (earliest departure first) or price (cheapest first).",
            "enum": [
              "date",
              "price"
            ],
            "title": "Sort",
            "type": "string"
          },
          "limit": {
            "default": 10,
            "description": "Number of offers to return.",
            "maximum": 20,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "description": "Number of offers to skip, for paging.",
            "maximum": 40,
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          },
          "locale": {
            "default": "en",
            "description": "Language of texts and links in the result: en or de.",
            "enum": [
              "en",
              "de"
            ],
            "title": "Locale",
            "type": "string"
          }
        },
        "type": "object",
        "title": "search_empty_legsArguments"
      }
    },
    {
      "name": "get_empty_leg",
      "description": "Current details of one offer by the ref returned by search_empty_legs. available=false means the offer is no longer listed.",
      "inputSchema": {
        "properties": {
          "ref": {
            "description": "ref exactly as returned by search_empty_legs.",
            "maxLength": 64,
            "title": "Ref",
            "type": "string"
          },
          "locale": {
            "default": "en",
            "description": "Language of texts and links in the result: en or de.",
            "enum": [
              "en",
              "de"
            ],
            "title": "Locale",
            "type": "string"
          }
        },
        "required": [
          "ref"
        ],
        "type": "object",
        "title": "get_empty_legArguments"
      }
    },
    {
      "name": "get_service_info",
      "description": "Returns voidjet's own answers to questions about costs, costs before a binding contract, contract partner, what happens after an inquiry, price binding, cancelled empty legs, how voidjet is funded, who receives the user's data and how fast providers reply. Use it instead of guessing. No information about single providers or flights.",
      "inputSchema": {
        "properties": {
          "locale": {
            "default": "en",
            "description": "Language of texts and links in the result: en or de.",
            "enum": [
              "en",
              "de"
            ],
            "title": "Locale",
            "type": "string"
          }
        },
        "type": "object",
        "title": "get_service_infoArguments"
      }
    },
    {
      "name": "report_unmet_need",
      "description": "Records a need voidjet cannot serve, for when the user wants voidjet to know about it: e.g. no offer on the route, a return flight, pets, instant booking. Takes 1-5 categories and optional route, dates, passengers and budget; no personal data. Helps voidjet decide what to add.",
      "inputSchema": {
        "properties": {
          "categories": {
            "description": "What the user needed that voidjet could not offer (1-5 categories).",
            "items": {
              "enum": [
                "route_not_covered",
                "date_not_covered",
                "too_few_seats",
                "price_above_budget",
                "return_flight",
                "multi_leg",
                "one_way_charter_wanted",
                "flexible_search_wanted",
                "aircraft_type_or_class",
                "cabin_amenities",
                "helicopter_or_other_aircraft",
                "pets",
                "special_luggage",
                "medical_or_accessibility",
                "cargo",
                "instant_booking_or_payment",
                "binding_price_or_availability",
                "notification_on_new_offers",
                "contact_by_phone",
                "provider_details",
                "other_information",
                "language_or_currency",
                "other"
              ],
              "type": "string"
            },
            "maxItems": 5,
            "minItems": 1,
            "title": "Categories",
            "type": "array"
          },
          "origin": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Wanted departure city, airport code or region.",
            "title": "Origin"
          },
          "destination": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Wanted arrival city, airport code or region.",
            "title": "Destination"
          },
          "date_from": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Earliest wanted travel date (YYYY-MM-DD).",
            "title": "Date From"
          },
          "date_to": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Latest wanted travel date (YYYY-MM-DD).",
            "title": "Date To"
          },
          "passengers": {
            "anyOf": [
              {
                "maximum": 500,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Number of passengers.",
            "title": "Passengers"
          },
          "max_budget_eur": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "maximum": 10000000,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Budget in EUR for the whole aircraft.",
            "title": "Max Budget Eur"
          },
          "aircraft_class": {
            "anyOf": [
              {
                "enum": [
                  "vlj",
                  "light",
                  "midsize",
                  "super_midsize",
                  "heavy",
                  "ultra",
                  "turboprop",
                  "airliner_vip"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Wanted aircraft class, if the user named one.",
            "title": "Aircraft Class"
          }
        },
        "required": [
          "categories"
        ],
        "type": "object",
        "title": "report_unmet_needArguments"
      }
    },
    {
      "name": "request_inquiry",
      "description": "Prepares an inquiry for one offer, for when the user has asked to inquire and given their email. voidjet emails the user a link; nothing is forwarded to the provider until the user opens it and sends the pre-filled form on voidjet.io within 48 hours. name, phone and message are optional, come from the user and only pre-fill the form. Prices are indicative.",
      "inputSchema": {
        "properties": {
          "ref": {
            "description": "ref exactly as returned by search_empty_legs.",
            "maxLength": 64,
            "title": "Ref",
            "type": "string"
          },
          "email": {
            "description": "The user's email address.",
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "passengers": {
            "description": "Number of passengers travelling.",
            "maximum": 19,
            "minimum": 1,
            "title": "Passengers",
            "type": "integer"
          },
          "flexible": {
            "default": false,
            "description": "True if the user is flexible on date and time.",
            "title": "Flexible",
            "type": "boolean"
          },
          "locale": {
            "default": "en",
            "description": "Language of texts and links in the result: en or de.",
            "enum": [
              "en",
              "de"
            ],
            "title": "Locale",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The user's name, only if the user gave it.",
            "title": "Name"
          },
          "phone": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The user's phone number, only if the user gave it.",
            "title": "Phone"
          },
          "message": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Message to the provider in the user's own words, optional.",
            "title": "Message"
          }
        },
        "required": [
          "ref",
          "email",
          "passengers"
        ],
        "type": "object",
        "title": "request_inquiryArguments"
      }
    },
    {
      "name": "request_charter_quote",
      "description": "Requests confirmed charter prices from partner Villiers for the route of a charter_alternative, for when the user has seen its price range, asked for confirmed prices and given their email. NOT an empty leg: a regular charter; voidjet receives a fee from the partner. voidjet emails the user a link; Villiers receives the request only after the user sends the form on voidjet.io within 48 hours, then emails confirmed options directly. name, phone and message are optional and come from the user.",
      "inputSchema": {
        "properties": {
          "origin": {
            "description": "origin_code from charter_alternative.",
            "maxLength": 64,
            "title": "Origin",
            "type": "string"
          },
          "destination": {
            "description": "destination_code from charter_alternative.",
            "maxLength": 64,
            "title": "Destination",
            "type": "string"
          },
          "departure_date": {
            "description": "Wanted departure date (YYYY-MM-DD).",
            "format": "date",
            "title": "Departure Date",
            "type": "string"
          },
          "passengers": {
            "description": "Number of passengers travelling.",
            "maximum": 19,
            "minimum": 1,
            "title": "Passengers",
            "type": "integer"
          },
          "email": {
            "description": "The user's email address.",
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "flexible": {
            "default": false,
            "description": "True if the user is flexible on date and time.",
            "title": "Flexible",
            "type": "boolean"
          },
          "locale": {
            "default": "en",
            "description": "Language of texts and links in the result: en or de.",
            "enum": [
              "en",
              "de"
            ],
            "title": "Locale",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The user's name, only if the user gave it.",
            "title": "Name"
          },
          "phone": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The user's phone number, only if the user gave it.",
            "title": "Phone"
          },
          "message": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Message to the provider in the user's own words, optional.",
            "title": "Message"
          }
        },
        "required": [
          "origin",
          "destination",
          "departure_date",
          "passengers",
          "email"
        ],
        "type": "object",
        "title": "request_charter_quoteArguments"
      }
    },
