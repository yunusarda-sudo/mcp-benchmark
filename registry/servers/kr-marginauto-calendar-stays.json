{
  "$schema": "../schema.json",
  "name": "kr.marginauto.calendar/stays",
  "title": "Marginmax Korea Stays",
  "category": "E-Commerce & Retail",
  "description": "Korean pensions & pool villas: search, live availability, KRW prices, refund rules, booking links",
  "tools": [
    {
      "name": "search_stays",
      "description": "Search Korean pensions / pool villas / stays sold by Marginmax. Filter by region (Korean place name in the address, e.g. \"가평\", \"강릉\", \"제주 애월\") and/or keyword (name, facility such as \"수영장\", \"애견\", \"바베큐\"). If checkin/checkout are given, only stays with an available room for the party are returned, cheapest first, with a direct booking_url.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "description": "지역(주소에 들어가는 말). 예: 가평, 양평, 강릉, 여수, 제주"
          },
          "q": {
            "type": "string",
            "description": "숙소 이름이나 특징 낱말. 예: 풀빌라, 애견, 독채, 수영장"
          },
          "checkin": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "입실일 YYYY-MM-DD (선택, 최대 7박)"
          },
          "checkout": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "퇴실일 YYYY-MM-DD (선택)"
          },
          "adults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 2,
            "description": "성인 수"
          },
          "children": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20,
            "default": 0,
            "description": "아동 수"
          },
          "infants": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20,
            "default": 0,
            "description": "영유아 수"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "name": "get_stay",
      "description": "Details of one stay: address, check-in/out time, description, facilities, rooms (capacity, size, amenities, photos, extra guest fees), refund policy (refund % by days before check-in), booking notice, lowest 1-night price in the next 30 days.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "stay_id": {
            "type": "string",
            "description": "search_stays 결과의 stay_id"
          }
        },
        "required": [
          "stay_id"
        ]
      }
    },
    {
      "name": "check_availability",
      "description": "Real-time availability and total price (KRW, whole stay) for every room of a stay for the given dates and party. Each available room includes booking_url: the property's official booking page, where the guest enters name and phone and pays to confirm the booking.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "stay_id": {
            "type": "string"
          },
          "checkin": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "입실일 YYYY-MM-DD"
          },
          "checkout": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "퇴실일 YYYY-MM-DD (최대 30박)"
          },
          "adults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 2,
            "description": "성인 수"
          },
          "children": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20,
            "default": 0,
            "description": "아동 수"
          },
          "infants": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20,
            "default": 0,
            "description": "영유아 수"
          }
        },
        "required": [
          "stay_id",
          "checkin",
          "checkout"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "kr.marginauto.calendar/stays",
    "version": "1.0.0",
    "remoteUrl": "https://calendar.marginauto.kr/api/ai/mcp",
    "publishedAt": "2026-11-26T16:46:32.479235Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "4ab16c2796746b959003ae17227ee97980cded3b138ac5079ce4781f0225d6e9"
  }
}
