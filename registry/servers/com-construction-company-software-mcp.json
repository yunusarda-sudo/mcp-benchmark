{
  "$schema": "../schema.json",
  "name": "com.construction-company-software/mcp",
  "title": "Construction Company Software",
  "category": "Observability & Analytics",
  "description": "Construction scheduling and project management: jobs, schedules, subs, budgets, RFIs, daily logs",
  "repository": "https://github.com/constructioncompanysoftware/mcp",
  "tools": [
    {
      "name": "list_projects",
      "description": "List the company's projects with status, dates and progress. Use first when the user hasn't said which project.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "open",
                  "all"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "open (default) or all"
          }
        }
      }
    },
    {
      "name": "search",
      "description": "Keyword search across projects, tasks, contacts, files, RFIs, punch items and indexed documents.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Words to look for"
          }
        }
      }
    },
    {
      "name": "get_schedule",
      "description": "A project's tasks with dates, status, % complete, float, critical flag and assigned subs. Filter by a date window or task name.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "projectId": {
            "description": "Project id or name. null = the current project.",
            "type": [
              "string",
              "null"
            ]
          },
          "from": {
            "description": "YYYY-MM-DD",
            "type": [
              "string",
              "null"
            ]
          },
          "to": {
            "description": "YYYY-MM-DD",
            "type": [
              "string",
              "null"
            ]
          },
          "taskQuery": {
            "description": "Part of a task or trade name",
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    {
      "name": "critical_path",
      "description": "The chain of tasks that drives the project's finish date (zero or negative float), in order.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "projectId": {
            "description": "Project id or name. null = the current project.",
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    {
      "name": "float_report",
      "description": "Tasks with little or negative float (slack) — how many workdays each can slip before it delays the finish.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "projectId": {
            "description": "Project id or name. null = the current project.",
            "type": [
              "string",
              "null"
            ]
          },
          "maxFloatDays": {
            "description": "Only tasks with float ≤ this (default 3)",
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    {
      "name": "schedule_delays",
      "description": "Why the schedule moved: recent date changes with who/why (delay reason), plus baseline and target variance.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "projectId": {
            "description": "Project id or name. null = the current project.",
            "type": [
              "string",
              "null"
            ]
          },
          "taskQuery": {
            "description": "Limit to one task (name)",
            "type": [
              "string",
              "null"
            ]
          },
          "days": {
            "description": "Look back this many days (default 60)",
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    {
      "name": "sub_status",
      "description": "Which subcontractors are booked on which tasks and whether they confirmed, declined, proposed a new date or haven't answered.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "projectId": {
            "description": "Project id or name. null = the current project.",
            "type": [
              "string",
              "null"
            ]
          },
          "contactQuery": {
            "description": "Sub company, name or trade",
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    {
      "name": "budget_status",
      "description": "Budget vs. actual by cost code: revised budget, committed, actual, projected, variance, contract, billed and projected profit.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "projectId": {
            "description": "Project id or name. null = the current project.",
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    {
      "name": "list_rfis",
      "description": "RFIs for a project with status, ball-in-court, due date, overdue flag and the answer if any.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "projectId": {
            "description": "Project id or name. null = the current project.",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "description": "draft, open, answered, closed (comma-separated)",
            "type": [
              "string",
              "null"
            ]
          },
          "query": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    {
      "name": "daily_logs",
      "description": "Daily logs in a date range: work performed, crew counts, delays, weather and notes.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "projectId": {
            "description": "Project id or name. null = the current project.",
            "type": [
              "string",
              "null"
            ]
          },
          "from": {
            "description": "YYYY-MM-DD (default 7 days ago)",
            "type": [
              "string",
              "null"
            ]
          },
          "to": {
            "description": "YYYY-MM-DD (default today)",
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    {
      "name": "punch_list",
      "description": "Punch, issue and to-do items for a project with status, trade, assignee and due date.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "projectId": {
            "description": "Project id or name. null = the current project.",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "description": "open, in_progress, ready, closed (comma-separated)",
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    {
      "name": "list_submittals",
      "description": "Submittals with status, spec section, required-by task and date warnings (approval too late for lead time).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "projectId": {
            "description": "Project id or name. null = the current project.",
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    {
      "name": "search_documents",
      "description": "Find passages in the project's indexed specs, drawings and RFIs that answer a question. Returns excerpts with page numbers to cite.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "projectId": {
            "description": "Project id or name. null = the current project.",
            "type": [
              "string",
              "null"
            ]
          },
          "question": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "schedule_risks",
      "description": "Rule-based risk list for the next 7 days: late work, unconfirmed or declined subs, weather on outdoor work, negative float, overdue RFIs and punch items.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "projectId": {
            "description": "Project id or name. null = the current project.",
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    {
      "name": "propose_schedule_changes",
      "description": "Propose edits to EXISTING tasks (move dates, change duration, set progress/status, add or remove links, add a task). Nothing changes until a person approves the proposal. Describe the change in `request`; optionally give exact `edits`.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "projectId": {
            "description": "Project id or name. null = the current project.",
            "type": [
              "string",
              "null"
            ]
          },
          "request": {
            "type": "string",
            "description": "The change in plain English, e.g. 'push drywall 3 days for the late inspection'"
          },
          "edits": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": [
                        "shift",
                        "set_start",
                        "set_duration",
                        "set_progress",
                        "set_status",
                        "link",
                        "unlink",
                        "add_task",
                        "rename"
                      ]
                    },
                    "taskId": {
                      "description": "Task id (or exact name)",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "otherTaskId": {
                      "description": "For link/unlink: the predecessor task id or name",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "days": {
                      "description": "shift: workdays (+later/−earlier); set_duration: workdays; link: lag",
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "date": {
                      "description": "set_start: YYYY-MM-DD",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "percent": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "status": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "not_started",
                            "in_progress",
                            "done",
                            "blocked"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "name": {
                      "description": "add_task / rename: the task name",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "action",
                    "taskId",
                    "otherTaskId",
                    "days",
                    "date",
                    "percent",
                    "status",
                    "name"
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "weather",
                  "sub_delay",
                  "material",
                  "client_change",
                  "inspection",
                  "design",
                  "labor",
                  "permit",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    {
      "name": "draft_rfi",
      "description": "Draft an RFI (subject, question, suggested solution) from notes, using the project's specs and schedule. Saved as a proposal; a person approves it to create the RFI as a draft.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "projectId": {
            "description": "Project id or name. null = the current project.",
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string",
            "description": "What's unclear or conflicting, in the user's words"
          }
        }
      }
    },
    {
      "name": "apply_proposal",
      "description": "Apply a pending proposal (schedule change, RFI draft, punch items). ONLY call this after the user has explicitly approved that exact proposal; pass confirm=true. Unless the API key allows direct apply, this returns an approval link the user opens in Construction Company Software to approve it.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "proposalId": {
            "type": "string"
          },
          "confirm": {
            "type": "boolean",
            "description": "Must be true: the user said yes to this proposal"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
