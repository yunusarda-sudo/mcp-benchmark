{
  "$schema": "../schema.json",
  "name": "me.bizstats/mcp",
  "title": "BizStats.me",
  "category": "Payments, CRM & Finance",
  "description": "Montenegro company filings, CRPS registry records, public tenders, Treasury payments and risk lists.",
  "repository": "https://github.com/stevyhacker/bizstats-mcp",
  "tools": [
    {
      "name": "search_companies",
      "description": "Find Montenegrin companies by name, PIB (tax ID), activity or owner. Use this to get the PIB that other tools need.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_company",
      "description": "A company's filings by year, registry identity, ownership, risk flags, and summaries of its tenders, state payments and court activity. Long lists are cut to the first few items and show how many exist.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "pib": {
            "type": "string",
            "pattern": "^\\d{8}$",
            "description": "8-digit Montenegrin tax ID"
          }
        },
        "required": [
          "pib"
        ]
      }
    },
    {
      "name": "rank_companies",
      "description": "Rank companies for a filing year by revenue, profit, employees, pay, margin or revenue change, optionally within a sector or municipality.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "year": {
            "description": "Filing year; defaults to the latest",
            "type": "string",
            "pattern": "^\\d{4}$"
          },
          "sort": {
            "default": "totalIncome",
            "type": "string",
            "enum": [
              "totalIncome",
              "profit",
              "employeeCount",
              "averagePay",
              "incomePerEmployee",
              "margin",
              "revenueChange"
            ]
          },
          "direction": {
            "default": "desc",
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "sector": {
            "type": "string",
            "maxLength": 120
          },
          "municipality": {
            "type": "string",
            "maxLength": 120
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "page": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      }
    },
    {
      "name": "search_tenders",
      "description": "Search public procurement notices from CEJN by keyword, buyer, municipality, status, CPV code, date or estimated value.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "description": "Keywords; a comma or semicolon separates alternatives",
            "type": "string",
            "maxLength": 200
          },
          "buyer": {
            "type": "string",
            "maxLength": 120
          },
          "municipality": {
            "type": "string",
            "maxLength": 120
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "expired",
              "completed",
              "canceled",
              "suspended"
            ]
          },
          "cpv": {
            "description": "CPV division (2 digits) or an 8-digit code",
            "type": "string",
            "pattern": "^\\d{2}(\\d{6})?$"
          },
          "dateFrom": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "dateTo": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "minValue": {
            "type": "number",
            "minimum": 0
          },
          "sort": {
            "default": "publicationDate",
            "type": "string",
            "enum": [
              "publicationDate",
              "deadline",
              "estimatedValue"
            ]
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "page": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      }
    },
    {
      "name": "get_tender",
      "description": "One procurement notice with its lots, status events, awards and matched payments. Use a procurementId from search_tenders.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "procurementId": {
            "type": "string",
            "pattern": "^[\\w:-]{1,80}$",
            "description": "For example me_cejn:tender:125041"
          }
        },
        "required": [
          "procurementId"
        ]
      }
    },
    {
      "name": "search_public_payments",
      "description": "Search State Treasury payments by payee, account, expense item or document number. Pass nextCursor from a result to read the next page.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 200
          },
          "sort": {
            "default": "date",
            "type": "string",
            "enum": [
              "date",
              "amount"
            ]
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "cursor": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    {
      "name": "get_recent_changes",
      "description": "Recently detected company events such as account blockades, tax-debtor listings, tender wins, registry notices and new filings, optionally for one company, municipality or sector. Omit type to include every event type.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "blockade_started",
              "blockade_cleared",
              "tax_debtor_listed",
              "tender_won",
              "registry_notice"
            ]
          },
          "pib": {
            "type": "string",
            "pattern": "^\\d{8}$"
          },
          "municipality": {
            "type": "string",
            "maxLength": 120
          },
          "sector": {
            "type": "string",
            "maxLength": 120
          },
          "minAmount": {
            "type": "number",
            "minimum": 0
          },
          "sort": {
            "default": "recent",
            "type": "string",
            "enum": [
              "recent",
              "eventDate",
              "amount"
            ]
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "page": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        }
      }
    },
    {
      "name": "find_person",
      "description": "Find people named in public company registry records and get the slug for get_person. Results group a name per company, so matching names are not necessarily the same person.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "get_person",
      "description": "A person's public registry roles across companies. Use a slug from find_person. Do not treat matching names as proof of identity.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,160}$",
            "description": "For example aleksandar-petrovic-pib-03760898"
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "get_dataset_status",
      "description": "Which datasets exist, where each comes from and how fresh it is. Check this before relying on recent data.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "me.bizstats/mcp",
    "version": "1.0.1",
    "remoteUrl": "https://api.bizstats.me/mcp",
