{
  "$schema": "../schema.json",
  "name": "be.agimo/agimo",
  "title": "Agimo",
  "category": "Other",
  "description": "Belgian homes for sale and for rent, read from the real estate agencies' own websites. Read-only.",
  "tools": [
    {
      "name": "search_listings",
      "description": "How many listings match, and 24 of them (price, bedrooms, area, city, url). Use `offset` to get the next 24. `count_capped` true means more than `count` match.",
      "inputSchema": {
        "properties": {
          "listing_type": {
            "anyOf": [
              {
                "enum": [
                  "buy",
                  "rent"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Listing Type"
          },
          "property_types": {
            "default": [],
            "items": {
              "enum": [
                "house",
                "apartment",
                "room",
                "garage",
                "office",
                "land",
                "commercial",
                "industrial",
                "hospitality",
                "building"
              ],
              "type": "string"
            },
            "title": "Property Types",
            "type": "array"
          },
          "min_bedrooms": {
            "default": 0,
            "minimum": 0,
            "title": "Min Bedrooms",
            "type": "number"
          },
          "max_bedrooms": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "most bedrooms accepted: a person who wants one or two, not five",
            "title": "Max Bedrooms"
          },
          "min_sqm": {
            "default": 0,
            "description": "minimum habitable area, m2",
            "minimum": 0,
            "title": "Min Sqm",
            "type": "number"
          },
          "energy_label": {
            "anyOf": [
              {
                "enum": [
                  "A++",
                  "A+",
                  "A",
                  "B",
                  "C",
                  "D",
                  "E",
                  "F",
                  "G"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "worst EPC / PEB label accepted; homes with no label are left out",
            "title": "Energy Label"
          },
          "energy_best": {
            "anyOf": [
              {
                "enum": [
                  "A++",
                  "A+",
                  "A",
                  "B",
                  "C",
                  "D",
                  "E",
                  "F",
                  "G"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "best EPC / PEB label accepted: E with energy_label G is the homes to renovate; homes with no label are left out",
            "title": "Energy Best"
          },
          "features": {
            "default": [],
            "description": "every one the ad says the home has, such as pool or sauna",
            "items": {
              "enum": [
                "pool",
                "sauna",
                "jacuzzi",
                "garden",
                "terrace",
                "garage",
                "elevator",
                "solar",
                "heat_pump",
                "air_con",
                "fireplace",
                "view",
                "sea",
                "ev_charger",
                "pets",
                "furnished",
                "new_build"
              ],
              "type": "string"
            },
            "title": "Features",
            "type": "array"
          },
          "exclude_under_option": {
            "default": false,
            "description": "leave out the homes under option: a buyer is already signing",
            "title": "Exclude Under Option",
            "type": "boolean"
          },
          "viager": {
            "anyOf": [
              {
                "enum": [
                  "exclude",
                  "only"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "homes sold in viager / lijfrente: left out, or the only ones shown",
            "title": "Viager"
          },
          "min_facades": {
            "default": 0,
            "description": "fewest facades of a house: 3 is half-open or detached; houses whose ad does not say are left out",
            "maximum": 4,
            "minimum": 0,
            "title": "Min Facades",
            "type": "integer"
          },
          "price_min": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Price Min"
          },
          "price_max": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Price Max"
          },
          "areas": {
            "default": [],
            "description": "deelgemeente codes like \"24104A\"; a bare municipality NIS selects all of it",
            "items": {
              "type": "string"
            },
            "title": "Areas",
            "type": "array"
          },
          "bbox": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "west,south,east,north; ignored when areas are set",
            "title": "Bbox"
          },
          "sources": {
            "default": [],
            "description": "agency domains",
            "items": {
              "type": "string"
            },
            "title": "Sources",
            "type": "array"
          },
          "sort": {
            "default": "newest",
            "enum": [
              "newest",
              "price_asc",
              "price_desc",
              "surface_desc"
            ],
            "title": "Sort",
            "type": "string"
          },
          "offset": {
            "default": 0,
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          },
          "limit": {
            "default": 24,
            "maximum": 200,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "place": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "a place name like \"Gent\" or \"Ixelles\": the deelgemeente of that name, never a whole municipality; adds to `areas`",
            "title": "Place"
          }
        },
        "title": "SearchArgs",
        "type": "object"
      }
    },
    {
      "name": "get_listing",
      "description": "One listing in full, by id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          }
        },
        "required": [
          "id"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "be.agimo/agimo",
    "version": "1.0.0",
    "remoteUrl": "https://api.agimo.be/api/mcp",
    "publishedAt": "2026-11-18T22:29:21.080952Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "bb07bfa37fecf560eecb034a594b8d60bccff7d2ccbffbeaca363c718eab5dc7"
  }
}
