{
  "$schema": "../schema.json",
  "name": "io.github.deepakprashadshukla/pip-chatbot-eval-kit",
  "title": "PIP Chatbot Evaluation Kit",
  "category": "AI, LLMs & Agents",
  "description": "Browse 100 fictional chatbot evaluation cases and estimate monthly costs using your own assumptions.",
  "repository": "https://github.com/deepakprashadshukla/pip-chatbot-eval-kit",
  "tools": [
    {
      "name": "list_businesses",
      "description": "List the five fictional business fixtures and categories in the PIP chatbot evaluation pack.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "list_cases",
      "description": "Browse fictional evaluation prompts with optional business, category and critical filters. Paginated; expected answers are returned by get_case.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "business": {
            "type": "string",
            "enum": [
              "catering",
              "property",
              "retail",
              "hotel",
              "agency"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "accuracy",
              "grounding",
              "unknown",
              "multiturn",
              "lead",
              "language"
            ]
          },
          "critical": {
            "type": "boolean"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000,
            "description": "Zero-based offset"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "description": "Maximum cases returned"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "get_case",
      "description": "Retrieve a specific fictional evaluation case, expected response, and its source facts. No chatbot is executed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "estimate_monthly_cost",
      "description": "Estimate a monthly cost from explicitly supplied base, included usage, additional pack size and price. Amounts are integer cents; no live vendor prices.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "base_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000,
            "description": "Monthly base cents"
          },
          "usage_units": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000,
            "description": "Expected monthly units"
          },
          "included_units": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000,
            "description": "Units included"
          },
          "pack_units": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000,
            "description": "Additional units per pack"
          },
          "pack_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000,
            "description": "Cost per pack in cents"
          },
          "add_on_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000,
            "description": "Optional monthly add-ons"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO-style currency code; defaults to USD"
          }
        },
        "required": [
          "base_cents",
          "usage_units",
          "included_units",
          "pack_units",
          "pack_cents"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.deepakprashadshukla/pip-chatbot-eval-kit",
    "version": "1.0.0",
    "remoteUrl": "https://mcp.chatbotpricing.com/mcp",
    "publishedAt": "2026-11-26T14:25:00.052322Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "d1719f55e39796bb68a5e8db60eb26165adecc4467d798d404e7338774fb5196"
  }
}
