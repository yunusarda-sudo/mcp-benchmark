{
  "$schema": "../schema.json",
  "name": "Elasticsearch MCP",
  "category": "Databases & Storage",
  "description": "Elasticsearch MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "search_index",
      "description": "Execute full-text search query across Elasticsearch index.",
      "inputSchema": {
        "type": "object",
        "required": [
          "index",
          "query"
        ],
        "properties": {
          "index": {
            "type": "string",
            "description": "Target Elasticsearch index name."
          },
          "query": {
            "type": "object",
            "description": "Elasticsearch DSL query object."
          }
        }
      }
    }
  ]
}
