{
  "$schema": "../schema.json",
  "name": "com.feedirl/feedirl-discover",
  "title": "FeedIRL",
  "category": "Travel, Maps & Navigation",
  "description": "Live local event discovery across 53 US cities: search by city, date, budget and interests.",
  "tools": [
    {
      "name": "discover_events",
      "description": "Search FeedIRL for upcoming real-world events and experiences by location, date window, budget, and interests/vibe. Returns ranked results with a one-line reason, local start time when known, price when available, source, referral ticket link, and last-verified timestamp. Discovery only — send people to referral_url; FeedIRL does not book or charge.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "description": "City or metro name"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "date": {
            "type": "string",
            "description": "YYYY-MM-DD start"
          },
          "end_date": {
            "type": "string",
            "description": "YYYY-MM-DD end"
          },
          "budget": {
            "type": "number",
            "description": "Max price in USD"
          },
          "interests": {
            "type": "string",
            "description": "Comma-separated interests / vibe (comedy, live music, …)"
          },
          "radius_mi": {
            "type": "number",
            "default": 25
          },
          "limit": {
            "type": "integer",
            "default": 10,
            "maximum": 50
          },
          "include_adult": {
            "type": "boolean",
            "default": false
          },
          "ai_provider": {
            "type": "string"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.feedirl/feedirl-discover",
    "version": "1.2.0",
    "remoteUrl": "https://www.feedirl.com/api/v1/discover/mcp",
    "publishedAt": "2026-11-17T19:59:25.038261Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "5e7e0ce7afc84bfc72c41a81d4426a2ae7ed6fb93065e59ea33fee658203c985"
  }
}
