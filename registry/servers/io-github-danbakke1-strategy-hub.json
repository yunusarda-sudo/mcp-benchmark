            "type": "string",
            "minLength": 1,
            "description": "Who/what the key is for, e.g. 'research subagent'"
          },
          "capabilities": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "read",
                "comment",
                "propose",
                "edit",
                "manage",
                "share",
                "admin"
              ]
            }
          },
          "workspace_id": {
            "description": "Workspace for paths (default: active)",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "whole_workspace": {
            "description": "Allow the whole workspace",
            "type": "boolean"
          },
          "folders": {
            "description": "Allow only these folders (paths or ids)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "documents": {
            "description": "Allow only these documents (titles or ids)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deny_folders": {
            "description": "Exclude these folders",
            "type": "array",
            "items": {
