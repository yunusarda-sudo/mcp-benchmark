{
  "$schema": "../schema.json",
  "name": "io.github.danbakke1/strategy-hub",
  "title": "Strategy Hub",
  "category": "AI, LLMs & Agents",
  "description": "Versioned memory for agents: markdown docs with history, safe concurrent commits, human claim links.",
  "repository": "https://github.com/danbakke1/strategy-hub",
  "tools": [
    {
      "name": "list_workspaces",
      "description": "List workspaces you belong to, with your role in each.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "q": {
            "description": "Workspace name substring (workspace picker search)",
            "type": "string"
          }
        }
      }
    },
    {
      "name": "set_active_workspace",
      "description": "Switch your active workspace — the default scope for list/create/search when no workspace_id is passed.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "workspace_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "workspace_id"
        ]
      }
    },
    {
      "name": "list_documents",
      "description": "List documents in a workspace (defaults to your active workspace). Uses the same ?q=, folder, type, access, sort, and view params as the documents browse UI.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "workspace_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "q": {
            "description": "Document name substring (?q= in the UI)",
            "type": "string"
          },
          "name": {
            "description": "Exact document title",
            "type": "string",
            "minLength": 1
          },
          "sort": {
            "description": "name-asc | name-desc | updated-desc | updated-asc",
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "markdown",
              "html",
              "plain"
            ]
          },
          "folder": {
            "description": "First path segment; (root) for titles without /",
            "type": "string"
          },
          "access": {
            "type": "string",
            "enum": [
              "open",
              "protected"
            ]
          },
          "view": {
            "description": "date (default) or folders grouping",
            "type": "string",
            "enum": [
              "date",
              "folders"
            ]
          },
          "group_by": {
            "description": "Alias for view: time→date, folder→folders",
            "type": "string",
            "enum": [
              "time",
              "folder"
            ]
          },
          "include_archived": {
            "description": "Deprecated — use library. When true, lists archived documents only.",
            "type": "boolean"
          },
          "library": {
            "description": "Library bucket; default active",
            "type": "string",
            "enum": [
              "archived",
              "trash"
            ]
          },
          "list_kind": {
            "description": "Alias for library (includes active)",
            "type": "string",
            "enum": [
              "active",
              "archived",
              "trash"
            ]
          }
        }
      }
    },
    {
      "name": "create_document",
      "description": "Create a document in a workspace. Use content_type markdown for prose; html only for full-page strategy decks per docs/HTML-SUBSET.md. Optionally seed initial content as the first commit.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Document title (no file extension)"
          },
          "workspace_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "content_type": {
            "type": "string",
            "enum": [
              "markdown",
              "html",
              "plain"
            ]
          },
          "content": {
            "description": "Optional initial body — committed immediately",
            "type": "string"
          },
          "if_exists": {
            "description": "When set to return, reuse an existing document with the same name in the workspace instead of creating a duplicate",
            "type": "string",
            "enum": [
              "return"
            ]
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "read_document",
      "description": "Read a document at primary or a named version line. Returns document.baseHash on the active line and a windowed snippet.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "version": {
            "description": "Named version line (e.g. draft/pricing); omit for primary",
            "type": "string"
          },
          "around": {
            "description": "Center the snippet on the first line containing this text",
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "line_end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "max_lines": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "document_id"
        ]
      }
    },
    {
      "name": "read_at_commit",
      "description": "Read a document body as of a specific commit hash.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "commit_hash": {
            "type": "string",
            "minLength": 6
          },
          "max_lines": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "document_id",
          "commit_hash"
        ]
      }
    },
    {
      "name": "commit_document",
      "description": "Save to primary or a version line. Protected documents block saves to primary — use submit_proposal instead, or save to a version line for intermediate work. Provide base_hash from your last read.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "Save message — why this change"
          },
          "base_hash": {
            "description": "Line head you last saw (document.baseHash)",
            "type": "string"
          },
          "version": {
            "description": "Named version line to save to (draft/*); omit for primary",
            "type": "string"
          },
          "content": {
            "description": "Full replacement body (fallback)",
            "type": "string"
          },
          "edit": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "replace"
                  },
                  "find": {
                    "type": "string",
                    "minLength": 1
                  },
                  "replace": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "find",
                  "replace"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "section"
                  },
                  "heading": {
                    "type": "string",
                    "minLength": 1
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "heading",
                  "content"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "patch"
                  },
                  "hunks": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "startLine": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "endLine": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "content": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "startLine",
                        "endLine",
                        "content"
                      ]
                    }
                  }
                },
                "required": [
                  "kind",
                  "hunks"
                ]
              }
            ],
            "description": "Targeted edit intent — preferred over full-body content"
          }
        },
        "required": [
          "document_id",
          "message"
        ]
      }
    },
    {
      "name": "submit_proposal",
      "description": "Submit a primary proposal on Protected documents (write_mode: reviewed). Requires write access. Pass proposal_id to amend an existing open proposal (like pushing commits to a PR branch). Omit proposal_id to open a new proposal. After submit: a workspace peer approves (or owner bypasses), then anyone with write access publishes.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "proposal_id": {
            "description": "Amend this pending/approved proposal instead of creating a new one",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "content": {
            "description": "Proposed full document body (fallback)",
            "type": "string"
          },
          "edit": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "replace"
                  },
                  "find": {
                    "type": "string",
                    "minLength": 1
                  },
                  "replace": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "find",
                  "replace"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "section"
                  },
                  "heading": {
                    "type": "string",
                    "minLength": 1
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "heading",
                  "content"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "patch"
                  },
                  "hunks": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "startLine": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "endLine": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "content": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "startLine",
                        "endLine",
                        "content"
                      ]
                    }
                  }
                },
                "required": [
                  "kind",
                  "hunks"
                ]
              }
            ],
            "description": "Targeted edit intent — preferred over full-body content"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "document_id"
        ]
      }
    },
    {
      "name": "update_proposal",
      "description": "Amend a pending or approved proposal on a Protected document. Resets approval to pending. Like pushing additional commits to an open PR branch — use when iterating on the same proposal rather than opening a parallel one.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "proposal_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "content": {
            "description": "Full proposed document body (fallback)",
            "type": "string"
          },
          "edit": {
            "description": "Patch the current proposal body",
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "replace"
                  },
                  "find": {
                    "type": "string",
                    "minLength": 1
                  },
                  "replace": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "find",
                  "replace"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "section"
                  },
                  "heading": {
                    "type": "string",
                    "minLength": 1
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "heading",
                  "content"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "patch"
                  },
                  "hunks": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "startLine": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "endLine": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "content": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "startLine",
                        "endLine",
                        "content"
                      ]
                    }
                  }
                },
                "required": [
                  "kind",
                  "hunks"
                ]
              }
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "proposal_id"
        ]
      }
    },
    {
      "name": "list_proposals",
      "description": "List proposals on a document (default: open — pending or approved). Like gh pr list for Protected documents.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "status": {
            "description": "Filter by status; default open (actionable proposals)",
            "type": "string",
            "enum": [
              "open",
              "all",
              "pending",
              "approved",
              "published",
              "rejected",
              "withdrawn"
            ]
          }
        },
        "required": [
          "document_id"
        ]
      }
    },
    {
      "name": "read_proposal",
      "description": "Read a proposal's proposed body (bounded excerpt, like read_document). Use diff_proposal to see changes vs primary.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "proposal_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "document_id": {
            "description": "Optional guard — fails if proposal is on another document",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "around": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "line_end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "max_lines": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "proposal_id"
        ]
      }
    },
    {
      "name": "diff_proposal",
      "description": "Diff a proposal against primary (what would change if published). Same preview shape as diff_commits.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "proposal_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "document_id": {
            "description": "Optional guard — fails if proposal is on another document",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "proposal_id"
        ]
      }
    },
    {
      "name": "withdraw_proposal",
      "description": "Withdraw (close without publishing) an open proposal. Any reader may withdraw pending or approved proposals — like closing a PR without merge.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "proposal_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "proposal_id"
        ]
      }
    },
    {
      "name": "list_versions",
      "description": "List version lines on a document: primary plus named versions (draft/*). Version lines support multi-step work without racing primary.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "document_id"
        ]
      }
    },
    {
      "name": "publish_version",
      "description": "Publish a version line to primary on open documents. On protected documents, use submit_proposal with the version content instead — versions are a workbench for intermediate saves, not a direct path to primary.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "Version line name to publish to primary"
          }
        },
        "required": [
          "document_id",
          "version"
        ]
      }
    },
    {
      "name": "document_history",
      "description": "Paginated commit history for a document (newest first).",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "document_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "document_id"
        ]
      }
    },
    {
