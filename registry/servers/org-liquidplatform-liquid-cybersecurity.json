{
  "$schema": "../schema.json",
  "name": "org.liquidplatform/liquid-cybersecurity",
  "title": "Liquid Cybersecurity",
  "category": "Design, UI & 3D Media",
  "description": "Read-only security guides, sandbox limits, and ownership-gated SPF/DMARC checks for AI-built apps.",
  "repository": "https://github.com/criptogus/secure-ai-portal",
  "tools": [
    {
      "name": "liquid_get_methodology",
      "description": "Read public assessment coverage, limits and retest methodology.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "section": {
            "type": "string",
            "enum": [
              "overview",
              "coverage",
              "limits",
              "retest"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "liquid_get_public_guide",
      "description": "Read a summary of an allowlisted published security guide.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "liquid_get_sandbox_limits",
      "description": "Read the browser sandbox input limits and static analysis coverage.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "liquid_start_domain_check",
      "description": "Issue or verify an exact-host DNS TXT or HTTPS ownership challenge, then check SPF/DMARC through a fixed DNS resolver. Writes only proof and check metadata.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "ownership_proof": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "issue"
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "dns_txt",
                      "http_well_known"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "method"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "dns_txt"
                  },
                  "challenge_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  }
                },
                "required": [
                  "kind",
                  "challenge_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "http_well_known"
                  },
                  "challenge_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  }
                },
                "required": [
                  "kind",
                  "challenge_id"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "domain",
          "ownership_proof"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "liquid_get_check_status",
      "description": "Read high-level SPF/DMARC signals with the bearer token returned when the check started.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string",
            "maxLength": 200
          },
          "status_token": {
            "type": "string",
            "maxLength": 256
          }
        },
        "required": [
          "check_id",
          "status_token"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "org.liquidplatform/liquid-cybersecurity",
    "version": "0.1.0",
    "remoteUrl": "https://liquidplatform.org/api/mcp/public",
    "publishedAt": "2026-11-27T01:58:28.090676Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "eab3a282d9cc99724847a2299d9bdb526d62d8a59ac97575a763cbb822b6aeed"
  }
}
