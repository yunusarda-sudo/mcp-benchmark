{
  "$schema": "../schema.json",
  "name": "com.qconsultai/home-cost-planner",
  "title": "Home Cost Planner by QConsul",
  "category": "Other",
  "description": "Home Cost Planner by QConsul: home cost projections and comparisons over 10, 20, 30 years.",
  "tools": [
    {
      "name": "confirm_availability",
      "description": "Heartbeat confirmation of availability for Home Cost Planner by QConsul. A public, unauthenticated check that this MCP server is live and reachable, independent of OAuth token state, so health checks and registries can confirm availability at any time. Returns server identity, version, status, the tool catalog with which tools require authentication, and canonical links. Read-only and stateless: it computes nothing from user data and stores nothing.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_home_projections",
      "description": "Estimate major ownership costs for a home over 10, 20 and 30 years (all returned by default). Use this tool when the user wants projections or totals for a home. To compare exactly 2 homes and see how their costs differ, use compare_homes instead. Read-only and stateless: calculated only from the details supplied in this call. Present results as a concise table with 10, 20 and 30 year columns. Disclaimer: These figures are estimates. They leave out the purchase price, mortgage, utilities, and routine maintenance. HOA dues and assessments, if applicable, are kept at current amounts. If the user asks to see the replacement detail, call again with includeReplacementDetail set to true and present the per-system list.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "homes": {
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "inputs": {
                  "description": "Required: supplied home details.",
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string"
                    },
                    "county": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "sqft": {
                      "type": "string",
                      "pattern": "^\\d{1,5}$"
                    },
                    "yearBuilt": {
                      "default": "",
                      "type": "string",
                      "pattern": "^(|\\d{4})$"
                    },
                    "stories": {
                      "default": "",
                      "type": "string",
                      "pattern": "^(|\\d{1,2}(\\.\\d)?)$"
                    },
                    "windowQty": {
                      "default": "10",
                      "type": "string",
                      "pattern": "^\\d{1,3}$"
                    },
                    "roofType": {
                      "default": "standard",
                      "type": "string",
                      "enum": [
                        "standard",
                        "premium"
                      ]
                    },
                    "hvacType": {
                      "default": "standard",
                      "type": "string",
                      "enum": [
                        "standard",
                        "heatPump"
                      ]
                    },
                    "exteriorType": {
                      "default": "wood",
                      "type": "string",
                      "maxLength": 40
                    },
                    "materials": {
                      "default": {},
                      "description": "Material for each system, using only these keys: fence, deck, windows, patioDoor, garageDoor, insulation, frontDoor, flooring, flooringGrade. Keys not in this list are ignored and reported in warnings.",
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "maxLength": 40
                      },
                      "additionalProperties": {
                        "type": "string",
                        "maxLength": 40
                      }
                    },
                    "ageByKey": {
                      "default": {},
                      "description": "Age in years for each system, using only these keys: roof, hvac, furnace, ac, waterHeater, exteriorPaint, flooring, foundation, chimney, dishwasher, refrigerator, stove, oven, washer, dryer, fence, deck, windows, patioDoor, garageDoor, frontDoor, insulation. Keys not in this list are ignored and reported in warnings.",
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "maxLength": 40
                      },
                      "additionalProperties": {
                        "type": "string",
                        "pattern": "^(|\\d{1,3})$"
                      }
                    },
                    "annualByKey": {
                      "default": {},
                      "description": "Yearly dollar amount for each item, using only these keys: yardMaintenance, insEarthquake, insFire, insFlood, insProperty. Keys not in this list are ignored and reported in warnings.",
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "maxLength": 40
                      },
                      "additionalProperties": {
                        "type": "string",
                        "pattern": "^\\d{0,7}$"
                      }
                    },
                    "noHoa": {
                      "type": "boolean",
                      "description": "True only when the home has no HOA. False when it has an HOA or when that is unknown."
                    },
                    "hoaAmt": {
                      "default": "",
                      "description": "HOA dues amount in whole dollars, charged per hoaPeriod. If the source listing states HOA dues, supply them here.",
                      "type": "string",
                      "maxLength": 9,
                      "pattern": "^\\d*$"
                    },
                    "hoaPeriod": {
                      "default": "monthly",
                      "type": "string",
                      "enum": [
                        "monthly",
                        "annual"
                      ]
                    },
                    "assess": {
                      "default": "",
                      "description": "Special assessments in whole dollars per year.",
                      "type": "string",
                      "maxLength": 9,
                      "pattern": "^\\d*$"
                    },
                    "taxCurrent": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 999999999
                    },
                    "taxIncreasePct": {
                      "description": "Annual property tax increase, in percent per year (for example, 3 means 3% per year). If supplied, it overrides any rate derived from taxHistory.",
                      "type": "number",
                      "minimum": 0,
                      "maximum": 25
                    },
                    "taxHistory": {
                      "default": [],
                      "maxItems": 60,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "year": {
                            "type": "integer",
                            "minimum": 1777,
                            "maximum": 9999
                          },
                          "amount": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 999999999
                          }
                        },
                        "required": [
                          "year",
                          "amount"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "valueBasis": {
                      "default": 0,
                      "type": "number",
                      "minimum": 0,
                      "maximum": 999999999
                    }
                  },
                  "required": [
                    "state",
                    "county",
                    "sqft",
                    "noHoa",
                    "taxCurrent"
                  ],
                  "additionalProperties": false
                }
              },
              "additionalProperties": {}
            },
            "description": "Provide 1-3 home addresses with street, unit if applicable, city, state, zip or a public URL with all that data, which has the additional benefit in many cases of the link providing annual property tax (current and historical, from which average % increase can be calculated)."
          },
          "horizon": {
            "default": "all",
            "description": "Defaults to all: 10, 20 and 30 years in one reply. Name one period only to narrow it.",
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "10",
                  "20",
                  "30"
                ]
              },
              {
                "type": "string",
                "const": "all"
              }
            ]
          },
          "include_annual": {
            "default": false,
            "description": "Include annual costs only when needed; summaries are returned by default.",
            "type": "boolean"
          },
          "includeReplacementDetail": {
            "description": "Set to true to include the per-system replacement detail (year, system, amount) for each horizon. Leave false for the summary output. Set it when the user asks to see the replacement detail or breakdown.",
            "type": "boolean"
          }
        },
        "required": [
          "homes"
        ],
        "additionalProperties": false
      }
    },
