{
  "$schema": "../schema.json",
  "name": "net.agentshopping/agentshopping",
  "title": "AgentShopping",
  "category": "AI, LLMs & Agents",
  "description": "Neutral Nordic price comparison (NO/SE): verified shop feeds, total price incl. shipping.",
  "tools": [
    {
      "name": "search_offers",
      "description": "Search AgentShopping offers. Optional filters cover typed product attrs (eu_size, size_cm, age_months, head_cm, total_nok_max, and the rest of the schema). q also parses phrases such as 'str 33', 'til 3-åring', 'under 5000 kr' and '52 cm hode'. If sample_data is true, prices are fictional. Ranking never uses commission. Shop links are affiliate ads.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2, or ALL"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217"
          },
          "category": {
            "type": "string",
            "enum": [
              "toys",
              "football",
              "menswear",
              "electronics",
              "other"
            ],
            "description": "Our category slug. Every product in an answer has one of these in category."
          },
          "limit": {
            "type": "integer",
            "description": "Page size. Default 5, maximum 50."
          },
          "cursor": {
            "type": "string",
            "description": "Opaque cursor from next_cursor."
          },
          "detail": {
            "type": "string",
            "enum": [
              "summary",
              "full"
            ],
            "description": "Default summary: per product name, brand, category, gtin, size, and per offer merchant, price_incl_shipping, in_stock, variants and verified_checkout_url. full returns every field, with descriptions cut to 160 characters."
          },
          "fields": {
            "type": "string",
            "description": "Comma-separated response fields. Overrides detail."
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "nb"
            ]
          },
          "brand": {
            "type": "string",
            "description": "Brand, case-insensitive"
          },
          "gtin": {
            "type": "string",
            "description": "Valid GTIN-8/12/13/14. Invalid codes do not match."
          },
          "price_min": {
            "type": "number",
            "description": "Minimum item price in the offer currency"
          },
          "price_max": {
            "type": "number",
            "description": "Maximum item price in the offer currency"
          },
          "shipping_max": {
            "type": "number",
            "description": "Maximum shipping in the offer currency"
          },
          "total_nok_min": {
            "type": "number",
            "description": "Minimum total incl. shipping, converted to NOK with a static approximate rate"
          },
          "total_nok_max": {
            "type": "number",
            "description": "Maximum total incl. shipping in NOK. Norwegian 'under 5000 kr' sets this."
          },
          "total_sek_max": {
            "type": "number",
            "description": "Maximum total incl. shipping in SEK. Swedish 'under 500 kr' sets this."
          },
          "total_dkk_max": {
            "type": "number",
            "description": "Maximum total incl. shipping in DKK."
          },
          "in_stock": {
            "type": "boolean",
            "description": "true to keep only in-stock offers"
          },
          "age_months": {
            "type": "number",
            "description": "Child age in months. The product range must contain it."
          },
          "age_min_months": {
            "type": "number",
            "description": "Youngest age in months. With age_max_months, ranges must overlap."
          },
          "age_max_months": {
            "type": "number",
            "description": "Oldest age in months"
          },
          "gender": {
            "type": "string",
            "description": "girl, boy or unisex"
          },
          "color": {
            "type": "string",
            "description": "Colour"
          },
          "price_checked_since": {
            "type": "string",
            "description": "ISO date. Offer price_checked_at must be on or after this."
          },
          "piece_count": {
            "type": "number",
            "description": "Toys: piece count"
          },
          "theme_series": {
            "type": "string",
            "description": "Toys: theme or series"
          },
          "toy_type": {
            "type": "string",
            "description": "Toys: toy type"
          },
          "small_parts_under_3": {
            "type": "boolean",
            "description": "Toys: small parts warning for under 3"
          },
          "head_cm": {
            "type": "number",
            "description": "Helmet: head circumference the size range must contain"
          },
          "head_min_cm": {
            "type": "number",
            "description": "Helmet: minimum head cm"
          },
          "head_max_cm": {
            "type": "number",
            "description": "Helmet: maximum head cm"
          },
          "size_label": {
            "type": "string",
            "description": "Helmet: size label"
          },
          "mips": {
            "type": "boolean",
            "description": "Helmet: MIPS"
          },
          "standard": {
            "type": "string",
            "description": "Helmet: EN 1078 or EN 1080"
          },
          "use": {
            "type": "string",
            "description": "Helmet: use, such as cycling"
          },
          "junior": {
            "type": "boolean",
            "description": "Junior model"
          },
          "weight_g": {
            "type": "number",
            "description": "Weight in grams"
          },
          "weight_g_max": {
            "type": "number",
            "description": "Maximum weight in grams"
          },
          "eu_size": {
            "type": "number",
            "description": "Football boots: EU size. 'str 33' with boots sets this."
          },
          "sole_type": {
            "type": "string",
            "description": "Football boots: FG, AG, SG, MG, TF or IC"
          },
          "closure": {
            "type": "string",
            "description": "Football boots: laces, velcro or laceless"
          },
          "series": {
            "type": "string",
            "description": "Football boots: series"
          },
          "sock_collar": {
            "type": "boolean",
            "description": "Football boots: sock collar"
          },
          "ball_size": {
            "type": "number",
            "description": "Football: 3, 4 or 5"
          },
          "ball_type": {
            "type": "string",
            "description": "Football: light, training, match or futsal"
          },
          "certification": {
            "type": "string",
            "description": "Football: certification"
          },
          "nff_age": {
            "type": "string",
            "description": "Football: NFF age band derived from ball size"
          },
          "glove_size": {
            "type": "number",
            "description": "Goalkeeper gloves: size"
          },
          "finger_protection": {
            "type": "string",
            "description": "Goalkeeper gloves: finger protection"
          },
          "cut": {
            "type": "string",
            "description": "Goalkeeper gloves: cut"
          },
          "shin_size": {
            "type": "string",
            "description": "Shin guards: size"
          },
          "shin_type": {
            "type": "string",
            "description": "Shin guards: type"
          },
          "size_cm": {
            "type": "number",
            "description": "Kids clothing: body size 50-176. 'str 92' with clothing sets this."
          },
          "garment_type": {
            "type": "string",
            "description": "Kids clothing: garment type"
          },
          "water_column_mm": {
            "type": "number",
            "description": "Kids clothing: water column"
          },
          "water_column_mm_min": {
            "type": "number",
            "description": "Kids clothing: minimum water column"
          },
          "lined": {
            "type": "boolean",
            "description": "Kids clothing: lined"
          },
          "temp_range": {
            "type": "string",
            "description": "Kids clothing: temperature range"
          },
          "stroller_type": {
            "type": "string",
            "description": "Stroller type"
          },
          "seats": {
            "type": "number",
            "description": "Stroller seats"
          },
          "wheels": {
            "type": "number",
            "description": "Wheel count"
          },
          "weight_kg": {
            "type": "number",
            "description": "Weight in kilograms"
          },
          "weight_kg_max": {
            "type": "number",
            "description": "Maximum weight in kilograms"
          },
          "max_child_kg": {
            "type": "number",
            "description": "Stroller: max child weight"
          },
          "max_child_kg_min": {
            "type": "number",
            "description": "Stroller: product must allow at least this child weight"
          },
          "use_tags": {
            "type": "string",
            "description": "Stroller use tag"
          },
          "child_height_cm": {
            "type": "number",
            "description": "Car seat: child height the approved range must contain"
          },
          "child_weight_kg": {
            "type": "number",
            "description": "Car seat: child weight the approved range must contain"
          },
          "direction": {
            "type": "string",
            "description": "Car seat: rear or forward"
          },
          "isofix": {
            "type": "boolean",
            "description": "Car seat: ISOFIX"
          },
          "approval": {
            "type": "string",
            "description": "Car seat: R129 or R44"
          },
          "max_user_kg": {
            "type": "number",
            "description": "Scooter or bike: max user weight"
          },
          "max_user_kg_min": {
            "type": "number",
            "description": "Scooter or bike: product must allow at least this user weight"
          },
          "age_min_years": {
            "type": "number",
            "description": "Scooter or bike: minimum age in years"
          },
          "wheel_size_inch": {
            "type": "number",
            "description": "Scooter or bike: wheel size in inches"
          },
          "brake": {
            "type": "string",
            "description": "Scooter or bike: brake"
          }
        }
      }
    },
    {
      "name": "get_product",
      "description": "Fetch one product by slug, gtin or id with its ranked offers: clean title, brand, category, gtin, size, and per offer price_incl_shipping, in_stock and verified_checkout_url. detail=full adds price history. Sample rows are labelled sample=true.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "gtin": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "detail": {
            "type": "string",
            "enum": [
              "summary",
              "full"
            ],
            "description": "Default summary."
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "nb"
            ]
          }
        }
      }
    },
    {
      "name": "list_merchants",
      "description": "List stores in the merchant directory, compact: categories they sell, markets, currencies, live offer count, price band incl. shipping, affiliate network and the store page. Paged: limit (default 5, maximum 50) and cursor. sample=true means the store is seeded example data, not a live feed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "Page size. Default 5, maximum 50."
          },
          "cursor": {
            "type": "string",
            "description": "Opaque cursor from next_cursor."
          }
        }
      }
    },
    {
      "name": "find_stores_for",
      "description": "Find which stores sell a category, optionally in one country. Returns the same compact store records as list_merchants (price band incl. shipping, live offer count, networks, store page). Use search_offers for products and /go/ shop links. Sample rows must not be cited as live prices.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "toys",
              "football",
              "menswear",
              "electronics",
              "other"
            ]
          },
          "country": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2"
          },
          "limit": {
            "type": "integer",
            "description": "Page size. Default 5, maximum 50."
          },
          "cursor": {
            "type": "string",
            "description": "Opaque cursor from next_cursor."
          }
        },
        "required": [
          "category"
        ]
      }
    }
  ],
