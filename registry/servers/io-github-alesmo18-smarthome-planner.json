{
  "$schema": "../schema.json",
  "name": "io.github.alesmo18/smarthome-planner",
  "title": "Smart Home Purchase Planner",
  "category": "Developer Tools & DevOps",
  "description": "Deterministic Matter/Zigbee/Z-Wave buy planner with Pareto kits.",
  "repository": "https://github.com/alesmo18/mcp-smarthome",
  "tools": [
    {
      "name": "identify_setup",
      "description": "Normalize a declared smart-home setup into a structured SetupProfile.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "controller": {
            "type": "string"
          },
          "integrations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "radios": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "protocol": {
                  "type": "string"
                },
                "coordinator_query": {
                  "type": "string"
                }
              },
              "required": [
                "protocol"
              ]
            }
          },
          "hubs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string"
                },
                "hub_query": {
                  "type": "string"
                }
              },
              "required": [
                "role"
              ]
            }
          },
          "constraints": {
            "type": "object",
            "properties": {
              "local_only": {
                "type": "boolean"
              },
              "matter_certified_only": {
                "type": "boolean"
              },
              "budget_eur_max": {
                "type": "number"
              },
              "allow_extra_hardware": {
                "type": "boolean"
              }
            }
          },
          "free_text": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "check_device_compatibility",
      "description": "Deterministic compatibility verdict for one device against a setup.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "setup": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "query": {
            "type": "string"
          },
          "device_id": {
            "type": "string"
          }
        },
        "required": [
          "setup",
          "query"
        ]
      }
    },
    {
      "name": "plan_pareto_kit",
      "description": "Build 3–5 non-dominated shopping kits for requested categories.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "setup": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "category": {
                  "type": "string"
                },
                "qty": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "category"
              ]
            }
          }
        },
        "required": [
          "setup",
          "items"
        ]
      }
    },
    {
      "name": "explain_constraint",
      "description": "Explain a rule_id or device verdict with canonical rule text.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "setup": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "rule_id": {
            "type": "string"
          },
          "device_id": {
            "type": "string"
          },
          "kit_id": {
            "type": "string"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.alesmo18/smarthome-planner",
    "version": "1.0.0",
    "remoteUrl": "https://mcp-smarthome.alesmo18.workers.dev/mcp",
    "publishedAt": "2026-11-27T14:33:00.624331Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "7ec4c66e6d520ca9fdc94ded52f15848a01180638f7c6e0dd02527196660ae7e"
  }
}
