{
  "$schema": "../schema.json",
  "name": "Redis MCP",
  "category": "Databases & Storage",
  "description": "Redis MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "get_key",
      "description": "Retrieve value of specified key from Redis in-memory store.",
      "inputSchema": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "Target key name in Redis."
          }
        }
      }
    },
    {
      "name": "set_key",
      "description": "Store key-value pair in Redis with optional TTL expiration in seconds.",
      "inputSchema": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "Target key name."
          },
          "value": {
            "type": "string",
            "description": "String value to store."
          },
          "ttlSeconds": {
            "type": "integer",
            "description": "Time to live in seconds."
          }
        }
      }
    }
  ]
}
