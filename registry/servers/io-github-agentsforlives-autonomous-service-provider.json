{
  "$schema": "../schema.json",
  "name": "io.github.AgentsForLives/autonomous-service-provider",
  "category": "AI, LLMs & Agents",
  "description": "Agent output audits and data services. Quote discovers x402 v2 checkout.",
  "repository": "https://github.com/AgentsForLives/autonomous-service-provider",
  "tools": [
    {
      "name": "quote",
      "description": "Discover the x402 v2 HTTP checkout URL, network, USDC price and terms for a standard service.",
      "inputSchema": {
        "type": "object",
        "required": [
          "service"
        ],
        "properties": {
          "service": {
            "enum": [
              "csv-preflight",
              "json-validation",
              "calendar-to-excel",
              "datacheck",
              "securitycheck",
              "outputcheck",
              "privacycheck",
              "fullaudit",
              "custom"
            ]
          }
        }
      }
    },
    {
      "name": "place_order",
      "description": "Submit a demo or supervised order using a fresh order bearer token in the HTTP Authorization header. Use the quote tool for automated x402 checkout.",
      "inputSchema": {
        "type": "object",
        "required": [
          "service",
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "service": {
            "enum": [
              "csv-preflight",
              "json-validation",
              "calendar-to-excel",
              "datacheck",
              "securitycheck",
              "outputcheck",
              "privacycheck",
              "fullaudit",
              "custom"
            ]
          },
          "mode": {
            "enum": [
              "demo",
              "paid",
              "handoff"
            ],
            "default": "demo"
          },
          "input": {
            "type": "string",
            "maxLength": 8192
          },
          "options": {
            "type": "object",
            "properties": {
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "key": {
                "type": "string"
              },
              "reconcile": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "total",
                    "addends"
                  ],
                  "properties": {
                    "total": {
                      "type": "string"
                    },
                    "addends": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 31,
                      "uniqueItems": true,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "schema": {
                "type": "object",
                "description": "Bounded schema subset. Required for OutputCheck and FullAudit."
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "name": "get_order",
      "description": "Fetch order status and inline result using the same bearer token.",
      "inputSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        }
      }
    },
    {
      "name": "accept_order",
      "description": "Record acceptance of a delivered result using the same bearer token.",
      "inputSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.AgentsForLives/autonomous-service-provider",
    "version": "1.2.0",
    "remoteUrl": "https://autonomous-service-provider.agentsforlives.workers.dev/mcp",
    "publishedAt": "2026-11-26T21:25:23.654557Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "7bb875596537c98dad0e3ae5ddd82c065e2d27036e3b8aebfe3ee258f9e3279f"
  }
}
