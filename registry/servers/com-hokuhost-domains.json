{
  "$schema": "../schema.json",
  "name": "com.hokuhost/domains",
  "title": "HokuHost Domains",
  "category": "Security & Identity",
  "description": "Domain search and prices; authenticated registration, nameserver and renewal workflows.",
  "tools": [
    {
      "name": "search_domains",
      "description": "Live availability + yearly price (renewal same). Letters are never changed for you: a name with accents, www., a subdomain or other characters is refused with a suggestion; only spaces and capitals are dropped, and the checked name comes back as name. status: available | taken | premium_not_offered | not_allowed | not_offered_now | unknown (retry later).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "e.g. pixelstudio or pixelstudio.io"
          },
          "tlds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "e.g. [\"com\",\"io\"]; default: 10 popular"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_prices",
      "description": "USD per year for every extension; next = announced price change; restore_usd = fee to restore an expired domain.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "sign_in",
      "description": "Sign in or create an account. Call with email → user gets a 6-digit code by email; call again with email+code → signed in (API key).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "6 digits from the email"
          },
          "totp": {
            "type": "string",
            "description": "only if the answer says totp_required: the current code from the owner's authenticator app"
          },
          "key_name": {
            "type": "string",
            "description": "optional, e.g. Claude"
          }
        },
        "required": [
          "email"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "account",
      "description": "Get the account (owner details, saved card, limits). Pass fields to set the domain owner (registrant) details; needed before the first order.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "individual",
              "company"
            ]
          },
          "full_name": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "company_no": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "description": "with country code, e.g. +1 408 555 0100"
          },
          "street": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "postal": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "description": "2-letter code, e.g. US"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "setup_card",
      "description": "Returns setup_url where the owner saves a card once, with a monthly limit; orders are then paid automatically within it. A lower limit for a saved card applies at once.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "monthly_limit_usd": {
            "type": "number",
            "minimum": 1,
            "maximum": 2000
          }
        },
        "required": [
          "monthly_limit_usd"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "create_order",
      "description": "Register 1–10 available domains for the owner. Pays with the saved card (then waits for the registry) or returns payment_url for the owner.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "e.g. [\"pixelstudio.com\"]"
          },
          "years": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "pay": {
            "type": "string",
            "enum": [
              "auto",
              "link"
            ],
            "description": "auto (default): saved card if possible, else payment_url. link: always payment_url"
          },
          "wait": {
            "type": "integer",
            "minimum": 0,
            "maximum": 25,
            "description": "Seconds to wait for payment/registration to finish (max 25)"
          }
        },
        "required": [
          "domains"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_order",
      "description": "Order status, payment confirmation (paid_at, receipt_url). Use wait=25 instead of polling.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "integer"
          },
          "wait": {
            "type": "integer",
            "minimum": 0,
            "maximum": 25,
            "description": "Seconds to wait for payment/registration to finish (max 25)"
          }
        },
        "required": [
          "order_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_orders",
      "description": "Last 25 orders.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "list_domains",
      "description": "Domains in the account with expiry dates.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "get_domain",
      "description": "Expiry, nameservers, renewal price.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          }
        },
        "required": [
          "domain"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "set_nameservers",
      "description": "Point a domain to 2–4 nameservers. Owner is emailed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "nameservers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "domain",
          "nameservers"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "renew_domain",
      "description": "Renew a domain; paid like create_order.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "years": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "pay": {
            "type": "string",
            "enum": [
              "auto",
              "link"
            ],
            "description": "auto (default): saved card if possible, else payment_url. link: always payment_url"
          },
          "wait": {
            "type": "integer",
            "minimum": 0,
            "maximum": 25,
            "description": "Seconds to wait for payment/registration to finish (max 25)"
          }
        },
        "required": [
          "domain"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.hokuhost/domains",
    "version": "1.1.0",
    "remoteUrl": "https://www.hokuhost.com/mcp",
    "publishedAt": "2026-11-21T18:56:21.706226Z",
    "fetchedAt": "2026-11-22T12:49:37.224Z",
    "toolsSha256": "f032d8a05102ea09f8d7c775bdfb424c5b26a70ff08b4b874d9f2e4fbcfecef7"
  }
}
