{
  "$schema": "../schema.json",
  "name": "com.seesight-tours/booking",
  "title": "See Sight Tours",
  "category": "Travel, Maps & Navigation",
  "description": "Search See Sight Tours, check live availability, and open a checkout link on seesight-tours.com.",
  "tools": [
    {
      "name": "search_products",
      "description": "Use this when a traveler asks which See Sight Tours day tour, private tour or multi-day trip fits a city, country, starting point, length or interest. Covers day tours in 20 cities in Canada and the United States and multi-day small-group trips worldwide (set product_type to multi_day_trip, or location to a country such as Italy or Japan). Returns active products with stable ids, canonical seesight-tours.com links, from-prices and how each one books. Use location for where the tour happens and departure_city for where the traveler starts (e.g. Niagara Falls from Toronto). If notes say a place exists in two countries, ask the traveler which side. Do not use for hotels alone, flights or other operators' tours.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 200,
            "description": "Free-text interests, e.g. 'boat ride', 'night tour', 'walking', 'safari'."
          },
          "location": {
            "type": "string",
            "maxLength": 100,
            "description": "Where the experience happens: city, region or country, e.g. 'Niagara Falls, Ontario' or 'Italy'."
          },
          "departure_city": {
            "type": "string",
            "maxLength": 100,
            "description": "Where the traveler starts, e.g. 'Toronto'."
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Za-z]{2}$",
            "description": "ISO 3166-1 alpha-2, e.g. CA, US, IT. Niagara Falls: CA = Ontario side, US = New York side."
          },
          "product_type": {
            "type": "string",
            "enum": [
              "day_tour",
              "private_tour",
              "experience",
              "multi_day_trip",
              "any"
            ]
          },
          "max_duration_hours": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 24
          },
          "min_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "description": "Multi-day trips only."
          },
          "max_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "description": "Multi-day trips only."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "es",
              "de",
              "fr",
              "pt",
              "it",
              "nl",
              "ja",
              "ko",
              "zh",
              "zh-tw",
              "pl",
              "ru",
              "ar"
            ],
            "description": "Site language for links, e.g. 'en' (default) or 'es'."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_product",
      "description": "Use this when the traveler wants the facts about one See Sight Tours product: what is included and excluded, the itinerary, meeting point or pickup, cancellation terms, price options and the right page to book or request it. For a multi-day trip it returns the full day-by-day itinerary with overnight cities, hotels (when named), meals, inclusions, exclusions, pricing basis, dates and booking terms. Only states facts published on seesight-tours.com.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "description": "Product id from search_products, e.g. 'tour:<uuid>' or 'trip:<slug>'."
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "es",
              "de",
              "fr",
              "pt",
              "it",
              "nl",
              "ja",
              "ko",
              "zh",
              "zh-tw",
              "pl",
              "ru",
              "ar"
            ],
            "description": "Site language for links, e.g. 'en' (default) or 'es'."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "plan_itinerary",
      "description": "Use this when a traveler wants a day-by-day plan from a starting city for a number of days (optionally an end city, start date and interests). Returns packaged See Sight Tours trips that fit the route and a day-tour plan from the base city, and lists which prices or dates need a dated quote. Do not use for hotels alone or flights.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "start_city": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "end_city": {
            "type": "string",
            "maxLength": 100
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 21
          },
          "start_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD, today or later."
          },
          "interests": {
            "type": "string",
            "maxLength": 200
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "es",
              "de",
              "fr",
              "pt",
              "it",
              "nl",
              "ja",
              "ko",
              "zh",
              "zh-tw",
              "pl",
              "ru",
              "ar"
            ],
            "description": "Site language for links, e.g. 'en' (default) or 'es'."
          }
        },
        "required": [
          "start_city",
          "days"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "customize_itinerary",
      "description": "Use this when a traveler wants to change a See Sight Tours multi-day trip: remove, add or reorder days, swap an activity or hotel, set the start date or the party, or split one trip into two separate itineraries. Start from a trip id (search_products or get_product) or from the plan_id of an earlier result to keep editing. Returns each variant day by day with the changes listed, the price the website shows for the unchanged trip (changes to days, activities or hotels are priced by the trip team in a quote, never estimated here), a shareable seesight-tours.com page and a request-form link. Nothing is booked or stored; the trip team receives the plan only when the guest submits the form on the website. Do not use for day tours.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "trip_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "description": "trip:<slug> from search_products. Give this or plan_id."
          },
          "plan_id": {
            "type": "string",
            "minLength": 40,
            "maxLength": 4000,
            "description": "plan_id from an earlier customize_itinerary result, to change that plan further."
          },
          "changes": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "remove_day"
                    },
                    "day": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 30
                    }
                  },
                  "required": [
                    "op",
                    "day"
                  ],
                  "additionalProperties": false,
                  "description": "Drop a day; later days move up."
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "add_day"
                    },
                    "after_day": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 30,
                      "description": "0 inserts before day 1."
                    },
                    "title": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 80
                    },
                    "summary": {
                      "type": "string",
                      "maxLength": 240
                    },
                    "overnight": {
                      "type": "string",
                      "maxLength": 60,
                      "description": "Overnight city; defaults to the previous day's."
                    }
                  },
                  "required": [
                    "op",
                    "after_day",
                    "title"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "move_day"
                    },
                    "day": {
                      "$ref": "#/properties/changes/items/anyOf/0/properties/day"
                    },
                    "to": {
                      "$ref": "#/properties/changes/items/anyOf/0/properties/day"
                    }
                  },
                  "required": [
                    "op",
                    "day",
                    "to"
                  ],
                  "additionalProperties": false,
                  "description": "Reorder: move a day to another position."
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "change_activities"
                    },
                    "day": {
                      "$ref": "#/properties/changes/items/anyOf/0/properties/day"
                    },
                    "remove": {
                      "type": "string",
                      "maxLength": 120,
                      "description": "An included activity to drop (matched by words)."
                    },
                    "add": {
                      "type": "string",
                      "maxLength": 120,
                      "description": "An activity to ask for instead."
                    }
                  },
                  "required": [
                    "op",
                    "day"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "change_hotel"
                    },
                    "day": {
                      "$ref": "#/properties/changes/items/anyOf/0/properties/day"
                    },
                    "hotel": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 80,
                      "description": "Hotel or area to ask for that night."
                    }
                  },
                  "required": [
                    "op",
                    "day",
                    "hotel"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "set_start_date"
                    },
                    "date": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                  },
                  "required": [
                    "op",
                    "date"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "keep_days"
                    },
                    "from": {
                      "$ref": "#/properties/changes/items/anyOf/0/properties/day"
                    },
                    "to": {
                      "$ref": "#/properties/changes/items/anyOf/0/properties/day"
                    }
                  },
                  "required": [
                    "op",
                    "from",
                    "to"
                  ],
                  "additionalProperties": false,
                  "description": "Keep only days from..to (inclusive) and drop the rest; days are renumbered. A split is two plans with complementary keep_days."
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "set_party"
                    },
                    "adults": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 14
                    },
                    "child_ages": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 17
                      },
                      "maxItems": 8
                    }
                  },
                  "required": [
                    "op",
                    "adults"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "maxItems": 10,
            "description": "Changes in order; may be empty to re-read or split a saved plan."
          },
          "split_at_day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 29,
            "description": "Split into two itineraries after this day."
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "es",
              "de",
              "fr",
              "pt",
              "it",
              "nl",
              "ja",
              "ko",
              "zh",
              "zh-tw",
              "pl",
              "ru",
              "ar"
            ],
            "description": "Site language for links, e.g. 'en' (default) or 'es'."
          }
        },
        "required": [
          "changes"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "check_availability",
      "description": "Use this when the traveler has picked a product and a date and wants open times and the exact total for their party. Reads live seats and prices; returns each departure's status, the total in minor units (cents) and an opaque price-lock reference (quote_id) for get_checkout_link. Dates must be real calendar dates, today or later. Trips need one age per child in child_ages. Do not use for other operators' tours.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "description": "Product id from search_products, e.g. 'tour:<uuid>' or 'trip:<slug>'."
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Local date at the tour, YYYY-MM-DD, today or later."
          },
          "adults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "children": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50
          },
          "infants": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "child_ages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 17
            },
            "maxItems": 12
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "CAD"
            ]
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "es",
              "de",
              "fr",
              "pt",
              "it",
              "nl",
              "ja",
              "ko",
              "zh",
              "zh-tw",
              "pl",
              "ru",
              "ar"
            ],
            "description": "Site language for links, e.g. 'en' (default) or 'es'."
          }
        },
        "required": [
          "id",
          "date",
          "adults"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_checkout_link",
      "description": "Use this when the traveler confirms a quoted departure and wants to book. Returns a short-lived link to a review page on seesight-tours.com that restores the product, departure, party and currency; the guest confirms the final total there and pays on the website at the website price. This tool reserves and charges nothing and stores nothing: the same quote_id always returns the same link. Never ask for card or contact details in chat.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "quote_id": {
            "type": "string",
            "minLength": 40,
            "maxLength": 4000,
            "description": "The opaque price-lock reference from check_availability (valid for 15 minutes)."
          }
        },
        "required": [
          "quote_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_quote_link",
      "description": "Use this when a product is booked by request (most multi-day trips, private or custom dates) or the traveler wants a quote. Returns the See Sight Tours request form link; the traveler enters contact details and consent there. No payment is taken.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "description": "Product id from search_products, e.g. 'tour:<uuid>' or 'trip:<slug>'."
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "es",
              "de",
              "fr",
              "pt",
              "it",
              "nl",
              "ja",
              "ko",
              "zh",
              "zh-tw",
              "pl",
              "ru",
              "ar"
            ],
            "description": "Site language for links, e.g. 'en' (default) or 'es'."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "check_checkout_link",
      "description": "Use this when the traveler asks whether a checkout link from this app still works. Returns prepared, expired or invalid. It cannot see payments or bookings: the confirmation email and the See Sight Tours site are the booking record.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "checkout_url": {
            "type": "string",
            "minLength": 40,
            "maxLength": 5000,
            "description": "The seesight-tours.com checkout link returned by get_checkout_link."
          }
        },
        "required": [
          "checkout_url"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
