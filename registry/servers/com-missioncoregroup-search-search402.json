{
  "$schema": "../schema.json",
  "name": "com.missioncoregroup.search/search402",
  "title": "Search402",
  "category": "AI, LLMs & Agents",
  "description": "Web search, page extraction and open US government bids for AI agents, paid per call via x402.",
  "tools": [
    {
      "name": "search",
      "description": "Full web search for AI agents: ranked results with title, URL, snippet, domain and date, as Markdown or JSON. Costs $0.005 USDC per call on Base via x402 (MCP clients with an x402 wallet pay automatically). Free alternative with 3 titles: search_preview.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 2,
            "maxLength": 300,
            "description": "Search query"
          },
          "limit": {
            "description": "Number of results, 1-25 (default 10)",
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "site": {
            "description": "Only this domain, e.g. example.com",
            "type": "string",
            "maxLength": 100
          },
          "format": {
            "description": "md (default) or json",
            "type": "string",
            "enum": [
              "md",
              "json"
            ]
          }
        },
        "required": [
          "q"
        ]
      }
    },
    {
      "name": "extract",
      "description": "Clean Markdown of one public web page (title, description, language, main text), for reading or RAG. Costs $0.002 USDC per call on Base via x402.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2000,
            "format": "uri",
            "description": "Public http(s) URL"
          },
          "format": {
            "description": "md (default) or json",
            "type": "string",
            "enum": [
              "md",
              "json"
            ]
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "bids_search",
      "description": "Open US public-sector bids and grants (state, county, city, school, housing authority, federal SAM.gov, Grants.gov): title, buyer, state, notice type, due date, number, codes, value and the official notice link. Up to 50 per call. Costs $1 USDC per call on Base via x402. Free titles-only sample: bids_preview.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "q": {
            "description": "Keywords, e.g. janitorial, hvac maintenance, roof inspection",
            "type": "string",
            "maxLength": 300
          },
          "state": {
            "description": "Two-letter US state, e.g. PA",
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "kind": {
            "description": "bid or grant (default both)",
            "type": "string",
            "enum": [
              "bid",
              "grant"
            ]
          },
          "due_within": {
            "description": "Only notices due in the next N days",
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          },
          "limit": {
            "description": "1-50 (default 20)",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "format": {
            "description": "md (default) or json",
            "type": "string",
            "enum": [
              "md",
              "json"
            ]
          }
        }
      }
    },
    {
      "name": "bids_preview",
      "description": "Free: titles, state and due date of the 5 nearest open US government bids and grants matching your keywords. Buyer, link, number, codes and value come with the paid bids_search tool.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "q": {
            "description": "Keywords",
            "type": "string",
            "maxLength": 300
          },
          "state": {
            "description": "Two-letter US state",
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          }
        }
      }
    },
    {
      "name": "search_preview",
      "description": "Free web search preview: top 3 result titles and URLs. For full results with snippets use the paid search tool.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 2,
            "maxLength": 300,
            "description": "Search query"
          }
        },
        "required": [
          "q"
        ]
      }
    },
    {
      "name": "index_status",
      "description": "Size and freshness of the Search402 index, prices and payment network.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "how_to_pay",
      "description": "Prices, wallet, network and the x402 payment steps, over MCP or plain HTTP.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "q": {
            "description": "Optional query to build the search URL",
            "type": "string"
          }
        }
      }
    }
  ],
