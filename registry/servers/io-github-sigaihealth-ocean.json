{
  "$schema": "../schema.json",
  "name": "io.github.sigaihealth/ocean",
  "title": "SIG.AI Ocean",
  "category": "AI, LLMs & Agents",
  "description": "Search 667 marine datasets and models, explore forecasts, estimate chlorophyll, classify plankton.",
  "repository": "https://github.com/sigaihealth/marinemodels",
  "tools": [
    {
      "name": "list_datasets",
      "description": "Find public collections by title, instrument or ID, with sources and available Ocean tools.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "default": "",
            "type": "string",
            "maxLength": 120
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "search_sources",
      "description": "Find marine datasets, AI models, benchmarks and data services from the 667-entry source atlas, with licence, sign-up requirement, access method, a command or URL to try and a dated link check.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "default": "",
            "type": "string",
            "maxLength": 120
          },
          "lane": {
            "type": "string",
            "enum": [
              "aerial-maritime-detection",
              "bioacoustics",
              "biodiversity-references",
              "biogeochemistry",
              "coral-reefs",
              "data-infrastructure",
              "in-situ-observations",
              "language-and-scientific-q-a",
              "ocean-physics-forecasting",
              "plankton-imaging",
              "reference-datasets",
              "remote-sensing-foundation-models",
              "satellite-ocean-color-and-radar",
              "storms-and-tropical-cyclones",
              "underwater-imagery",
              "underwater-noise-monitoring",
              "waves"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "dataset",
              "model",
              "benchmark",
              "service"
            ]
          },
          "licence": {
            "type": "string",
            "enum": [
              "open",
              "share-alike",
              "non-commercial-or-restricted",
              "unclear"
            ]
          },
          "sign_up": {
            "type": "string",
            "enum": [
              "none",
              "account",
              "restricted"
            ]
          },
          "link_status": {
            "type": "string",
            "enum": [
              "ok",
              "needs login",
              "api",
              "broken",
              "error",
              "unreachable",
              "no link"
            ]
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limit": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "search_models",
      "description": "Find models and their licenses, availability, benchmarks and trial links within a scientific task lane.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "default": "",
            "type": "string",
            "maxLength": 120
          },
          "lane": {
            "type": "string",
            "enum": [
              "ocean-physics",
              "waves",
              "biogeochemistry",
              "satellite",
              "plankton",
              "underwater-imagery",
              "coral-reefs",
              "bioacoustics",
              "language"
            ]
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limit": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_pioneer_observations",
      "description": "Read Gianna acquisitions and their matched sensor values with original UTC times, quality flags and missing values. Filter by a UTC date or page through the six-day replay.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "utc_date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limit": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_glonet_forecast",
      "description": "Return ten dated daily forecasts and the matched GLO12 persistence baseline from an archived OceanBench run. Depth is in metres.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "reference_date": {
            "type": "string",
            "enum": [
              "2024-01-02",
              "2024-07-02"
            ]
          },
          "site": {
            "type": "string",
            "enum": [
              "west",
              "central",
              "east"
            ]
          },
          "depth_m": {
            "anyOf": [
              {
                "type": "number",
                "const": 0.494025
              },
              {
                "type": "number",
                "const": 47.373692
              },
              {
                "type": "number",
                "const": 92.326073
              }
            ]
          },
          "variable": {
            "type": "string",
            "enum": [
              "thetao",
              "so"
            ]
          }
        },
        "required": [
          "reference_date",
          "site",
          "depth_m",
          "variable"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_pioneer_storm_scores",
      "description": "Read the frozen six-hour salinity model's latest published verification, including paired hours, observations still missing and gain over persistence.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "estimate_chlorophyll",
      "description": "Calculate NASA's R2022 OC3M band-ratio estimate from three remote-sensing reflectances in inverse steradians.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "rrs443": {
            "type": "number"
          },
          "rrs488": {
            "type": "number"
          },
          "rrs547": {
            "type": "number"
          }
        },
        "required": [
          "rrs443",
          "rrs488",
          "rrs547"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "classify_plankton",
      "description": "Send one public example or one permitted PNG to SIG.AI's hosted shared 101-class classifier. It processes the image in memory and returns three provisional candidates. The call does not contribute the image for training.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "sample": {
            "description": "Built-in crop: early and late are Pioneer IFCB, whoi is WHOI IFCB, pelgas is a ZooScan.",
            "type": "string",
            "enum": [
              "early",
              "late",
              "whoi",
              "pelgas"
            ]
          },
          "png_base64": {
            "description": "Alternative to sample: one opaque grayscale or RGB PNG, at most 2 MiB, as plain padded base64.",
            "type": "string",
            "minLength": 1,
            "maxLength": 2796204
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.sigaihealth/ocean",
    "version": "1.1.0",
    "remoteUrl": "https://ocean.sig.ai/api/mcp",
    "publishedAt": "2026-11-28T02:38:40.813815Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "eba71246d00c9ccabf69d0a849f13dce09c3906d2e31ae0a4d0a91e2441b28db"
  }
}
