                            "type": "string"
                          },
                          "proof_url": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "activities": {
            "type": "string",
            "description": "CSV: activity_id,date,award_id,participant_id,visits,hours,evidence_url. Anonymous person IDs only. Dates YYYY-MM-DD."
          },
          "expenses": {
            "type": "string",
            "description": "CSV: line_id,expense_id,date,award_id,amount,expense_total,category,evidence_url. Shared expense IDs must reconcile across all awards."
          },
          "pro_code": {
            "type": "string",
            "description": "Private subscription token. Authorization Bearer is also supported."
          }
        },
        "required": [
          "project"
        ]
      }
    },
    {
      "name": "pro_status",
      "description": "Return subscription access, the price and current file limits. Nothing is bought through this tool.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pro_code": {
