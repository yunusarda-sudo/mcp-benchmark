{
  "$schema": "../schema.json",
  "name": "com.rowhousesoftware/grant-evidence-pack",
  "title": "Grant Evidence Pack",
  "category": "Observability & Analytics",
  "description": "Turn sign-in logs and receipts into a monthly grant report. Every number links to its row.",
  "repository": "https://github.com/rowhousesoftware/grant-evidence-pack",
  "tools": [
    {
      "name": "check_report",
      "description": "Compute monthly counts and costs from inline CSV rows. Return source records, exact row shares, source hashes, monthly tasks and all unresolved issues. Duplicate row IDs are excluded. People counts require anonymous person IDs. No text is written by AI and no file is stored. Free: one award and 100 rows per file. Paid: five awards and 2000 rows per file.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project": {
            "type": "object",
            "description": "Version 1 object with month YYYY-MM and awards. Each award has id, name, org, start, end, budget as a USD string, currency USD and requirements. Each requirement has id, label, metric (expenses, visits, people, hours or none), due_day 1 to 31, proof_required boolean, state todo or done, optional reported number string and source_ref.",
            "additionalProperties": false,
            "required": [
              "version",
              "month",
              "awards"
            ],
            "properties": {
              "version": {
                "type": "integer",
                "enum": [
                  1
                ]
              },
              "month": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}$"
              },
              "awards": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name",
                    "org",
                    "start",
                    "end",
                    "budget",
                    "currency",
                    "requirements"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "org": {
                      "type": "string"
                    },
                    "start": {
                      "type": "string"
                    },
                    "end": {
                      "type": "string"
                    },
                    "budget": {
                      "type": "string"
                    },
                    "currency": {
                      "type": "string",
                      "enum": [
                        "USD"
                      ]
                    },
                    "requirements": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "label",
                          "metric",
                          "due_day",
                          "proof_required"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "metric": {
                            "type": "string",
                            "enum": [
                              "expenses",
                              "visits",
                              "people",
                              "hours",
                              "none"
                            ]
                          },
                          "due_day": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 31
                          },
                          "proof_required": {
                            "type": "boolean"
                          },
                          "state": {
                            "type": "string",
                            "enum": [
                              "todo",
                              "done"
                            ]
                          },
                          "reported": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "source_ref": {
                            "type": "string"
                          },
                          "proof_url": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "activities": {
            "type": "string",
            "description": "CSV: activity_id,date,award_id,participant_id,visits,hours,evidence_url. Anonymous person IDs only. Dates YYYY-MM-DD."
          },
          "expenses": {
            "type": "string",
            "description": "CSV: line_id,expense_id,date,award_id,amount,expense_total,category,evidence_url. Shared expense IDs must reconcile across all awards."
          },
          "pro_code": {
            "type": "string",
            "description": "Private subscription token. Authorization Bearer is also supported."
          }
        },
        "required": [
          "project"
        ]
      }
    },
    {
      "name": "build_pack",
      "description": "Return a base64 ZIP with a draft PDF, editable DOCX, monthly checklist, evidence index, source archive, number ledger and unresolved issues. Text slots stay blank for owner review. All numbers are recomputed from inline CSV rows. Files are not stored. The ZIP is limited to 16 MB.",
