{
  "$schema": "../schema.json",
  "name": "com.blaaklane/booking",
  "title": "BlaakLane.com",
  "category": "Design, UI & 3D Media",
  "description": "Global chauffeur service in 500 cities: airport, corporate, crew, cruise and private-jet transfers.",
  "tools": [
    {
      "name": "search_coverage",
      "description": "Find BlaakLane.com pages for a city, airport, venue, event, service or topic. Returns titles, summaries and URLs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 8
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_page",
      "description": "Return the text of a page on blaaklane.com (Markdown when available). Accepts a full URL or a path.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "get_booking_options",
      "description": "Services, vehicles, coverage, pricing rules, contact channels, the online booker link and booking policies.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "request_booking",
      "description": "Send a chauffeured transportation request to BlaakLane.com for the traveller. Only call when the traveller explicitly asked to book. Returns a reference (BKL-XXXXXXX); the team confirms price, vehicle and chauffeur by email or phone. Not confirmed until then; nothing is charged.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Lead passenger full name"
          },
          "email": {
            "type": "string",
            "description": "Email (email or phone required)"
          },
          "phone": {
            "type": "string",
            "description": "Mobile with country code"
          },
          "service": {
            "type": "string",
            "enum": [
              "Airport transfer",
              "Point to point",
              "Hourly chauffeur",
              "Monthly / yearly chauffeur",
              "Chauffeur for your car",
              "Corporate account",
              "Crew transport",
              "Cruise / private jet",
              "VIP / diplomatic",
              "Sprinter / coach"
            ]
          },
          "pickup": {
            "type": "string",
            "description": "Address, hotel, airport + terminal or venue"
          },
          "dropoff": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "description": "Local pickup date YYYY-MM-DD"
          },
          "time": {
            "type": "string",
            "description": "Local pickup time HH:MM"
          },
          "hours": {
            "type": "string",
            "description": "Hours needed for hourly / as-directed service"
          },
          "flight": {
            "type": "string"
          },
          "passengers": {
            "type": "integer",
            "minimum": 1
          },
          "bags": {
            "type": "integer",
            "minimum": 0
          },
          "vehicle": {
            "type": "string",
            "enum": [
              "Business sedan",
              "First-class sedan",
              "SUV Business Class",
              "SUV First Class",
              "Stretch limousine",
              "Sprinter",
              "Jet Sprinter",
              "Coach",
              "Rolls-Royce / Maybach"
            ]
          },
          "return": {
            "type": "string"
          },
          "notes": {
            "type": "string",
            "description": "Occasion, child seats, accessibility, stops"
          },
          "agent": {
            "type": "string",
            "description": "Name of your assistant or app"
          },
          "consent": {
            "type": "string",
            "enum": [
              "yes"
            ],
            "description": "The traveller explicitly asked for this booking"
          }
        },
        "required": [
          "name",
          "pickup",
          "dropoff",
          "date",
          "time",
          "consent"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.blaaklane/booking",
    "version": "1.0.0",
    "remoteUrl": "https://blaaklane.com/agent-api/mcp.php",
    "publishedAt": "2026-11-24T13:55:27.374899Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "6468496c984bb084165972506b822903b22095d1d23a84f32023e7e1a8e8c7e4"
  }
}
