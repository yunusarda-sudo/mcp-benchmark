{
  "$schema": "../schema.json",
  "name": "com.theletterpilot/the-letter-pilot",
  "title": "The Letter Pilot",
  "category": "Other",
  "description": "Estimate USPS mailing, prepare a letter for private review, and check mailing status.",
  "tools": [
    {
      "name": "tlp_quote",
      "description": "Get a USD estimate and a link to continue on The Letter Pilot for one domestic First-Class, Certified, or Priority Mail letter. Supports 1–20 US Letter pages printed black-and-white and single-sided. Provide only the service and page count.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "first_class",
              "certified",
              "certified_electronic_receipt",
              "certified_paper_receipt",
              "certified_restricted_paper_receipt",
              "priority",
              "priority_signature"
            ]
          },
          "page_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "service",
          "page_count"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tlp_prepare_mailing",
      "description": "Get an expiring link the customer opens on The Letter Pilot. With their approval after sign-in, the site saves an unpaid Quick Send draft. Enter documents, addresses, and payment details only on the site. Provide only the service and page count.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "first_class",
              "certified",
              "certified_electronic_receipt",
              "certified_paper_receipt",
              "certified_restricted_paper_receipt",
              "priority",
              "priority_signature"
            ]
          },
          "page_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "service",
          "page_count"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tlp_prepare_letter",
      "description": "Prepare one domestic US Letter mailing with the customer's approved recipient, return address and finished letter. Provide exact finished text or a customer-selected PDF attachment and a unique UUID request_id. Reuse the request ID only to retry the same mailing. The customer opens the private link to review and authorize any payment and mailing on The Letter Pilot. Keep payment credentials on the website.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "first_class",
              "certified",
              "certified_electronic_receipt",
              "certified_paper_receipt",
              "certified_restricted_paper_receipt",
              "priority",
              "priority_signature"
            ]
          },
          "request_id": {
            "description": "Use a new random UUID for each distinct letter. Reuse the same UUID only when retrying identical inputs.",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "recipient": {
            "type": "object",
            "properties": {
              "first_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              },
              "last_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              },
              "organization": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "address1": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "address2": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "city": {
                "type": "string",
                "minLength": 1,
                "maxLength": 25
              },
              "state": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2
              },
              "zip": {
                "type": "string",
                "pattern": "^\\d{5}(?:-\\d{4})?$"
              },
              "country": {
                "type": "string",
                "const": "US"
              }
            },
            "required": [
              "address1",
              "city",
              "state",
              "zip",
              "country"
            ],
            "additionalProperties": false
          },
          "return_address": {
            "type": "object",
            "properties": {
              "first_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              },
              "last_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              },
              "organization": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "address1": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "address2": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "city": {
                "type": "string",
                "minLength": 1,
                "maxLength": 25
              },
              "state": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2
              },
              "zip": {
                "type": "string",
                "pattern": "^\\d{5}(?:-\\d{4})?$"
              },
              "country": {
                "type": "string",
                "const": "US"
              }
            },
            "required": [
              "address1",
              "city",
              "state",
              "zip",
              "country"
            ],
            "additionalProperties": false
          },
          "letter_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000,
            "description": "The finished, customer-approved letter text. Supply exactly one of letter_text or file."
          },
          "file": {
            "type": "object",
            "properties": {
              "download_url": {
                "type": "string",
                "maxLength": 8192,
                "format": "uri"
              },
              "file_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "mime_type": {
                "type": "string",
                "const": "application/pdf"
              },
              "file_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "download_url",
              "file_id"
            ],
            "additionalProperties": false,
            "description": "One PDF transferred by the supported ChatGPT file attachment flow. Supply exactly one of letter_text or file."
          }
        },
        "required": [
          "service",
          "request_id",
          "recipient",
          "return_address"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tlp_mailing_status",
      "description": "Return the payment and mailing status and available USPS tracking for a letter prepared by this integration. Use only the private status_reference returned for this customer’s mailing. A paid or printing status does not mean the letter has been mailed.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "status_reference": {
            "type": "string",
            "pattern": "^s2\\.[A-Za-z0-9_-]{64}$"
          }
        },
        "required": [
          "status_reference"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.theletterpilot/the-letter-pilot",
    "version": "0.3.0",
    "remoteUrl": "https://theletterpilot.com/api/mcp",
    "publishedAt": "2026-11-26T03:35:31.182681Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "e7e5ff792c6451315bf20a6c6bce6f0a71f0def670e6d14e229160f9f766e83f"
  }
}
