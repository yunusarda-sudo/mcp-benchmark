{
  "$schema": "../schema.json",
  "name": "com.iride360/booking",
  "title": "iRide360 Chauffeur Booking",
  "category": "Design, UI & 3D Media",
  "description": "Book LA & LAX luxury chauffeur rides: live quotes, reservations, and booking changes.",
  "tools": [
    {
      "name": "iride_get_quote",
      "description": "Prices a trip with the live pricing engine. Returns vehicles that fit and a quote_id valid 30 minutes.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "service_type": {
            "type": "string",
            "enum": [
              "airport_pickup",
              "airport_dropoff",
              "point_to_point",
              "hourly"
            ]
          },
          "pickup": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          },
          "dropoff": {
            "default": "",
            "type": "string",
            "maxLength": 300
          },
          "stops": {
            "default": [],
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 300
            }
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "time": {
            "type": "string",
            "pattern": "^\\d{1,2}:\\d{2}$"
          },
          "hours": {
            "type": "integer",
            "minimum": 3,
            "maximum": 18
          },
          "passengers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 14
          },
          "bags": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "vehicle_type": {
            "type": "string",
            "enum": [
              "sedan",
              "suv"
            ]
          },
          "meet_and_greet": {
            "default": false,
            "type": "boolean"
          },
          "child_seats": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "gratuity_percent": {
            "default": 20,
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 15
              },
              {
                "type": "number",
                "const": 18
              },
              {
                "type": "number",
                "const": 20
              },
              {
                "type": "number",
                "const": 25
              }
            ]
          }
        },
        "required": [
          "service_type",
          "pickup",
          "dropoff",
          "stops",
          "date",
          "time",
          "passengers",
          "bags",
          "meet_and_greet",
          "child_seats",
          "gratuity_percent"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "iride_create_booking",
      "description": "Books from a saved quote and emails the secure payment link. Only gratuity may be reselected; no caller-supplied prices. Confirmed once paid. Before booking, confirm the exact pickup date and time with the customer — never assume one, apply a default, or reuse a time from earlier in the conversation. For an airport pickup, set the pickup time from the flight's scheduled arrival (allow time to deplane and collect bags) and read it back to confirm.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "quote_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "vehicle_type": {
            "type": "string",
            "enum": [
              "sedan",
              "suv"
            ]
          },
          "first_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "last_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "mobile": {
            "type": "string",
            "minLength": 10,
            "maxLength": 40,
            "pattern": "^[+\\d\\s().-]*$"
          },
          "email": {
            "type": "string",
            "maxLength": 180,
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "airline": {
            "default": "",
            "type": "string",
            "maxLength": 80
          },
          "flight_number": {
            "default": "",
            "type": "string",
            "maxLength": 20
          },
          "meet_greet_name": {
            "default": "",
            "type": "string",
            "maxLength": 120
          },
          "notes": {
            "default": "",
            "type": "string",
            "maxLength": 500
          },
          "gratuity_percent": {
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 15
              },
              {
                "type": "number",
                "const": 18
              },
              {
                "type": "number",
                "const": 20
              },
              {
                "type": "number",
                "const": 25
              }
            ]
          }
        },
        "required": [
          "quote_id",
          "vehicle_type",
          "first_name",
          "last_name",
          "mobile",
          "email",
          "airline",
          "flight_number",
          "meet_greet_name",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "iride_find_booking",
      "description": "Finds up to 3 bookings by caller ID, confirmation number, or last name + pickup date. Masked data only.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "confirmation_number": {
            "type": "string",
            "maxLength": 30
          },
          "last_name": {
            "type": "string",
            "maxLength": 80
          },
          "pickup_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "iride_verify_caller",
      "description": "Checks two matching factors. Returns a 15-minute token for that booking. 3 failures lock the caller for 1 hour.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "booking_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "confirmation_number": {
            "type": "string",
            "maxLength": 30
          },
          "last_name": {
            "type": "string",
            "maxLength": 80
          },
          "pickup_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "booking_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "iride_get_booking",
      "description": "Verified booking details (no email, card or payment data).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "verification_token": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "verification_token"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "iride_modify_booking",
      "description": "Keeps the 4-hour change lock and new-pickup notice (12h transfers, 3h hourly). Unpaid tip-only edits apply; paid/pending-payment tips need staff approval. Other price increases and stops still need approval; never charges/refunds.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "verification_token": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "changes": {
            "type": "object",
            "properties": {
              "pickup_date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "pickup_time": {
                "type": "string",
                "pattern": "^\\d{1,2}:\\d{2}$"
              },
              "pickup_address": {
                "type": "string",
                "minLength": 3,
                "maxLength": 300
              },
              "dropoff_address": {
                "type": "string",
                "minLength": 3,
                "maxLength": 300
              },
              "stops": {
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 300
                }
              },
              "flight_number": {
                "type": "string",
                "maxLength": 20
              },
              "passengers": {
                "type": "integer",
                "minimum": 1,
                "maximum": 14
              },
              "bags": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              "vehicle_type": {
                "type": "string",
                "enum": [
                  "sedan",
                  "suv"
                ]
              },
              "special_requests": {
                "type": "string",
                "maxLength": 500
              },
              "passenger_first_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "passenger_last_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "passenger_phone": {
                "type": "string",
                "minLength": 10,
                "maxLength": 40,
                "pattern": "^[+\\d\\s().-]*$"
              },
              "gratuity_percent": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 0
                  },
                  {
                    "type": "number",
                    "const": 15
                  },
                  {
                    "type": "number",
                    "const": 18
                  },
                  {
                    "type": "number",
                    "const": 20
                  },
                  {
                    "type": "number",
                    "const": 25
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "verification_token",
          "changes"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "iride_cancel_booking",
      "description": "24+ hours before pickup: records a cancellation request for admin to refund. Otherwise transfer to dispatch.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "verification_token": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reason": {
            "default": "",
            "type": "string",
            "maxLength": 300
          },
          "airline_cancelled_flight": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "verification_token",
          "reason",
          "airline_cancelled_flight"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "iride_get_knowledge",
      "description": "Fleet, service area, airports, policies, child seats, current promotions and FAQ.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "topic": {
            "default": "all",
            "type": "string",
            "enum": [
              "all",
              "fleet",
              "service_area",
              "airports",
              "policies",
              "child_seats",
              "promotions",
              "faq"
            ]
          }
        },
        "required": [
          "topic"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "iride_request_callback",
      "description": "Creates a dispatch callback task and alerts the team.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "phone": {
            "type": "string",
            "minLength": 10,
            "maxLength": 40,
            "pattern": "^[+\\d\\s().-]*$"
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          },
          "booking_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "urgency": {
            "default": "normal",
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high"
            ]
          }
        },
        "required": [
          "name",
          "phone",
          "reason",
          "urgency"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.iride360/booking",
