{
  "$schema": "../schema.json",
  "name": "com.vadyu/vadyu",
  "title": "Vadyu 2.0 AI Commercial Video Ad Studio",
  "category": "E-Commerce & Retail",
  "description": "Preview Shopify/DTC products and generate multi-cut AI video ads with 3D lighting and voiceover.",
  "repository": "https://github.com/crawde/mcp-vadyu",
  "tools": [
    {
      "name": "vadyu_preview_storefront",
      "description": "Extract up to 4 hero SKUs, recommended Vadyu 2.0 ad style, and preloaded Studio link from a Shopify or DTC URL (no API key).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "description": "Public Shopify or DTC storefront/product URL.",
            "examples": [
              "https://www.voluspa.com"
            ]
          }
        },
        "required": [
          "url"
        ],
        "examples": [
          {
            "url": "https://www.voluspa.com"
          }
        ]
      }
    },
    {
      "name": "vadyu_generate_video_ad",
      "description": "Render a multi-cut AI commercial video ad (3D studio lighting, lifestyle scene, and voiceover) from a URL, image, or reuse_video_id.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "product_url": {
            "type": "string",
            "description": "Public Shopify or DTC product/store URL."
          },
          "image_url": {
            "type": "string",
            "description": "Direct HTTPS product or portrait image URL."
          },
          "image_base64": {
            "type": "string",
            "description": "Base64 or data URL of input photo."
          },
          "reuse_video_id": {
            "type": "number",
            "description": "Completed video ID to restitch at 0 credits."
          },
          "recipe": {
            "type": "string",
            "description": "Style ID (e.g. flagship_launch, horology_atelier, or 'auto')."
          },
          "campaign_preset": {
            "type": "string",
            "description": "3-ad funnel ID (e.g. dtc_flagship_funnel, spirits_funnel)."
          },
          "recipe_variants": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Up to 4 style IDs to render in parallel."
          },
          "format": {
            "type": "string",
            "description": "Aspect ratio: 9:16, 4:5, 1:1, or 16:9."
          },
          "voiceover": {
            "type": "boolean",
            "description": "Enable studio AI voiceover narration."
          },
          "audio_mood": {
            "type": "string",
            "description": "Background music mood ID."
          },
          "brand_text": {
            "type": "string",
            "description": "Brand headline for title/end cards."
          },
          "brand_subtext": {
            "type": "string",
            "description": "Product subtitle for cards."
          },
          "cta_text": {
            "type": "string",
            "description": "Closing call-to-action button copy."
          },
          "prompt": {
            "type": "string",
            "description": "Creative direction notes for scene staging."
          }
        },
        "examples": [
          {
            "product_url": "https://www.voluspa.com",
            "recipe": "auto",
            "format": "9:16"
          }
        ]
      }
    },
    {
      "name": "vadyu_get_video_status",
      "description": "Get render status, MP4 download URL, coherence score, and share URL for a video ID.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "video_id": {
            "type": "number",
            "description": "Numeric video job ID.",
            "examples": [
              1580
            ]
          }
        },
        "required": [
          "video_id"
        ],
        "examples": [
          {
            "video_id": 1580
          }
        ]
      }
    },
    {
      "name": "vadyu_list_recipes",
      "description": "List all 20 Vadyu 2.0 commercial ad styles, 16 campaign funnels, and 9 audio moods (no API key).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "examples": [
          {}
        ]
      }
    },
    {
      "name": "vadyu_list_sequences_and_formats",
      "description": "List supported commercial aspect ratios (9:16, 4:5, 1:1, 16:9) and style IDs (no API key).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "examples": [
          {}
        ]
      }
    },
    {
      "name": "vadyu_get_account_quota",
      "description": "Get remaining video credits and active credit pack or plan.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "examples": [
          {}
        ]
      }
    },
    {
      "name": "vadyu_list_videos",
      "description": "List recent generated video ads on the authenticated account.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "number",
            "description": "Max videos to return (1-50, default 10).",
            "examples": [
              10
            ]
          }
        },
        "examples": [
          {
            "limit": 10
          }
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.vadyu/vadyu",
    "version": "2.0.0",
    "remoteUrl": "https://vadyu.com/api/mcp",
    "publishedAt": "2026-11-24T04:17:19.567837Z",
    "fetchedAt": "2026-11-24T12:15:48.059Z",
    "toolsSha256": "9be84ce51ab80696188ff69e4abcefa281ab3aa85d8f9e0ad05d7f387b7063b9"
  }
}
