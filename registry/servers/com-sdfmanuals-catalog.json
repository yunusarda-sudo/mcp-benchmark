{
  "$schema": "../schema.json",
  "name": "com.sdfmanuals/catalog",
  "title": "SDFManuals",
  "category": "AI, LLMs & Agents",
  "description": "Find SDF equipment PDF manuals by model, chassis reference, language, document type or SKU.",
  "tools": [
    {
      "name": "list_filters",
      "description": "List supported brands, manual types and workflow. Public catalogue data only.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "find_models",
      "description": "Find model candidates by model designation, optionally exact brand. Return ambiguity instead of guessing. chassis_reference is an exact catalogue reference, NOT an arbitrary VIN. Select the correct model_id with the user before searching manuals.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "brand": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "chassis_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "find_manuals",
      "description": "Find public PDF product listings by chosen model_id or exact SKU. Optional language (BCP47), type U/operator, W/workshop, M/maintenance, P/parts. Pagination uses next_after_id. Returns shop links, never paid PDF downloads. Empty results do not prove no suitable manual exists.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model_id": {
            "type": "integer",
            "minimum": 1
          },
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "language": {
            "type": "string",
            "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$"
          },
          "document_type": {
            "type": "string",
            "enum": [
              "U",
              "W",
              "M",
              "P"
            ]
          },
          "after_id": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "anyOf": [
          {
            "required": [
              "model_id"
            ]
          },
          {
            "required": [
              "sku"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_manual",
      "description": "Read public product facts and explicitly assigned compatible model categories. Never guarantees VIN compatibility. No checkout, purchase or file access.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.sdfmanuals/catalog",
    "version": "1.1.0",
    "remoteUrl": "https://sdfmanuals.com/wp-json/sdf-catalog/v1/mcp",
    "publishedAt": "2026-11-25T23:23:10.073745Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "33ca28d09c74123ec0d9a7c3d108eb673e7a766b8617477ae1e7970fdafdfada"
  }
}
