{
  "$schema": "../schema.json",
  "name": "ClickHouse MCP",
  "category": "Databases & Storage",
  "description": "ClickHouse MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "query_analytics",
      "description": "Execute high-performance analytical SQL query against ClickHouse cluster.",
      "inputSchema": {
        "type": "object",
        "required": [
          "sql"
        ],
        "properties": {
          "sql": {
            "type": "string",
            "description": "OLAP SQL query string."
          },
          "format": {
            "type": "string",
            "enum": [
              "JSONEachRow",
              "CSV",
              "TabSeparated"
            ],
            "description": "Output format serialization."
          }
        }
      }
    }
  ]
}
