{
  "$schema": "../schema.json",
  "name": "io.github.guylouzon/interq",
  "title": "interQ",
  "category": "Developer Tools & DevOps",
  "description": "interQ public channels (web, RSS, podcast, JSON, OPML); sign in to manage items, tags and follows.",
  "repository": "https://github.com/guylouzon/interQ",
  "tools": [
    {
      "name": "get_channel_feed",
      "description": "Get the latest items from a public interQ channel.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Public interQ channel ID"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20,
            "description": "Maximum number of items to return, 1 to 50 (default 20)"
          }
        },
        "required": [
          "channel_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_channel",
      "description": "Search the latest items in a public interQ channel.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Public interQ channel ID"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Text to search for in the channel latest items, 1 to 120 characters"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20,
            "description": "Maximum number of items to return, 1 to 50 (default 20)"
          }
        },
        "required": [
          "channel_id",
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_channel_urls",
      "description": "Get public web, RSS, podcast, JSON, and OPML URLs for an interQ channel.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Public interQ channel ID"
          }
        },
        "required": [
          "channel_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "login",
      "description": "Start an authenticated interQ session. The password is used only for this TLS request and is not logged or persisted by this server.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email address of the interQ account"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "description": "Password of the interQ account"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "logout",
      "description": "End the current authenticated interQ session.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "add_item",
      "description": "Add an item to the authenticated user stream.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Item title, 1 to 500 characters"
          },
          "link": {
            "type": "string",
            "format": "uri",
            "description": "URL the item points to"
          },
          "description": {
            "type": "string",
            "maxLength": 10000,
            "description": "Optional item description, up to 10000 characters"
          },
          "image_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional URL of an image for the item"
          }
        },
        "required": [
          "title",
          "link"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "remove_item",
      "description": "Remove an item from the authenticated user stream. Safe to retry.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Numeric ID of an item in the signed-in user stream"
          }
        },
        "required": [
          "item_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "add_tag",
      "description": "Add one tag to an item owned by the authenticated user. Safe to retry.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Numeric ID of an item in the signed-in user stream"
          },
          "tag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Tag text, 1 to 80 characters"
          }
        },
        "required": [
          "item_id",
          "tag"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "remove_tag",
      "description": "Remove one tag from an item owned by the authenticated user. Safe to retry.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Numeric ID of an item in the signed-in user stream"
          },
          "tag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Tag text, 1 to 80 characters"
          }
        },
        "required": [
          "item_id",
          "tag"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "follow",
      "description": "Follow a retailer account. Safe to retry.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "retailer_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Numeric ID of the interQ account to follow or unfollow"
          }
        },
        "required": [
          "retailer_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "unfollow",
      "description": "Unfollow a retailer account. Safe to retry.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "retailer_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Numeric ID of the interQ account to follow or unfollow"
          }
        },
        "required": [
          "retailer_id"
        ],
        "additionalProperties": false
      }
    }
  ],
