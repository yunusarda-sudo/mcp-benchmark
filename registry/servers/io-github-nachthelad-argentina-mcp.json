{
  "$schema": "../schema.json",
  "name": "io.github.nachthelad/argentina-mcp",
  "title": "Argentina MCP",
  "category": "Developer Tools & DevOps",
  "description": "Argentine holidays, business days, and judicial deadlines with official sources.",
  "repository": "https://github.com/nachthelad/argentina-mcp",
  "tools": [
    {
      "name": "is_business_day",
      "description": "Check a civil date in the general, banking, or judicial calendar for a supported Argentine jurisdiction.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "Civil date in YYYY-MM-DD format."
          },
          "jurisdiction": {
            "type": "string",
            "enum": [
              "AR",
              "AR-C",
              "AR-B"
            ],
            "description": "Nation, Buenos Aires City, or Buenos Aires Province."
          },
          "calendar": {
            "type": "string",
            "enum": [
              "general",
              "banking",
              "judicial"
            ]
          }
        },
        "required": [
          "date",
          "jurisdiction",
          "calendar"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_holidays",
      "description": "List holidays and non-working days for a year and jurisdiction, including inherited national holidays and official citations.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 9999
          },
          "jurisdiction": {
            "type": "string",
            "enum": [
              "AR",
              "AR-C",
              "AR-B"
            ],
            "description": "Nation, Buenos Aires City, or Buenos Aires Province."
          }
        },
        "required": [
          "year",
          "jurisdiction"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "next_business_day",
      "description": "Find the first business day strictly after a civil date in the selected Argentine calendar.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "Civil date in YYYY-MM-DD format."
          },
          "jurisdiction": {
            "type": "string",
            "enum": [
              "AR",
              "AR-C",
              "AR-B"
            ],
            "description": "Nation, Buenos Aires City, or Buenos Aires Province."
          },
          "calendar": {
            "type": "string",
            "enum": [
              "general",
              "banking",
              "judicial"
            ]
          }
        },
        "required": [
          "date",
          "jurisdiction",
          "calendar"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "add_business_days",
      "description": "Move forward or backward by business days. Zero returns the starting date even if it is not a business day.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "Civil date in YYYY-MM-DD format."
          },
          "jurisdiction": {
            "type": "string",
            "enum": [
              "AR",
              "AR-C",
              "AR-B"
            ],
            "description": "Nation, Buenos Aires City, or Buenos Aires Province."
          },
          "calendar": {
            "type": "string",
            "enum": [
              "general",
              "banking",
              "judicial"
            ]
          },
          "days": {
            "type": "integer",
            "minimum": -3660,
            "maximum": 3660
          }
        },
        "required": [
          "date",
          "jurisdiction",
          "calendar",
          "days"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "judicial_deadline",
      "description": "Count judicial business days after notification and return the deadline, grace period, and documented court scope. The AR scope covers the national calendar; individual federal courts may have their own recesses.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "notification_date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "Civil date in YYYY-MM-DD format."
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3660
          },
          "jurisdiction": {
            "type": "string",
            "enum": [
              "AR",
              "AR-C",
              "AR-B"
            ],
            "description": "Nation, Buenos Aires City, or Buenos Aires Province."
          },
          "court_scope": {
            "type": "string",
            "enum": [
              "national_calendar",
              "national_federal_caba",
              "buenos_aires_provincial",
              "tsj_caba"
            ]
          }
        },
        "required": [
          "notification_date",
          "days",
          "jurisdiction"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_index",
      "description": "Read CER, UVA, UVI, or a national or regional IPC for one date, one month, or an inclusive range. Values stay decimal strings. ICL returns unsupported_index.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "index": {
            "type": "string",
            "enum": [
              "CER",
              "UVA",
              "UVI",
              "ICL",
              "IPC",
              "IPC-GBA",
              "IPC-PAMPEANA",
              "IPC-NEA",
              "IPC-NOA",
              "IPC-CUYO",
              "IPC-PATAGONIA"
            ],
            "description": "CER, UVA, UVI, national IPC, or a regional IPC. ICL is not available."
          },
          "date": {
            "description": "Single civil date. Monthly indexes use the month of this date.",
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "period": {
            "description": "Single month. Daily indexes return every stored day in that month.",
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "from": {
            "description": "Inclusive range start.",
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])(?:-(0[1-9]|[12]\\d|3[01]))?$"
          },
          "to": {
            "description": "Inclusive range end.",
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])(?:-(0[1-9]|[12]\\d|3[01]))?$"
          }
        },
        "required": [
          "index"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "adjust_amount_by_index",
      "description": "Adjust a positive decimal amount between two dates or months by CER, UVA, UVI, or an IPC. The result is a decimal string rounded half up to cents. ICL returns unsupported_index.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "index": {
            "type": "string",
            "enum": [
              "CER",
              "UVA",
              "UVI",
              "ICL",
              "IPC",
              "IPC-GBA",
              "IPC-PAMPEANA",
              "IPC-NEA",
              "IPC-NOA",
              "IPC-CUYO",
              "IPC-PATAGONIA"
            ],
            "description": "CER, UVA, UVI, national IPC, or a regional IPC. ICL is not available."
          },
          "amount": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)?$",
            "description": "Positive decimal amount. Use a period as the separator."
          },
          "from": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])(?:-(0[1-9]|[12]\\d|3[01]))?$",
            "description": "Civil date YYYY-MM-DD or month YYYY-MM."
          },
          "to": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])(?:-(0[1-9]|[12]\\d|3[01]))?$",
            "description": "Civil date YYYY-MM-DD or month YYYY-MM."
          }
        },
        "required": [
          "index",
          "amount",
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    }
  ],
