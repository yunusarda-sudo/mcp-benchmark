{
  "$schema": "../schema.json",
  "name": "io.usefulapi/rackbeat",
  "title": "Rackbeat MCP by usefulapi",
  "category": "Finance, Crypto & Web3",
  "description": "Read Rackbeat products, location stock, sales orders and customer summaries.",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "tools": [
    {
      "name": "rackbeat_account",
      "description": "Read the connected Rackbeat account and user IDs, company name and readiness. Omits addresses and email details.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    },
    {
      "name": "rackbeat_products",
      "description": "Read one bounded page of product summaries, stock and available quantities. Optional search and barred/sellable filters are sent to Rackbeat. Does not change inventory.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "page": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "search": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "is_barred": {
            "type": "boolean"
          },
          "is_sellable": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "rackbeat_get_product",
      "description": "Read one product's pricing and inventory quantities using its product number. Does not change stock, pricing or product data.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "product_number": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          }
        },
        "required": [
          "product_number"
        ]
      }
    },
    {
      "name": "rackbeat_product_locations",
      "description": "Read stock and available quantities for one product across warehouse locations. only_toplevel is an upstream filter. offset/limit slice a bounded complete upstream response locally; very large responses require the Rackbeat dashboard.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "product_number": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "only_toplevel": {
            "default": false,
            "type": "boolean"
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "limit": {
            "default": 25,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "product_number"
        ]
      }
    },
    {
      "name": "rackbeat_orders",
      "description": "Read one bounded page of sales order summaries, totals and shipment/invoice status. Optional search, customer number and status filters are sent to Rackbeat. Does not book, cancel or ship orders.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "page": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "search": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "customer_number": {
            "type": "string",
            "pattern": "^[1-9]\\d{0,15}$"
          },
          "is_cancelled": {
            "type": "boolean"
          },
          "is_booked": {
            "type": "boolean"
          },
          "is_shipped": {
            "type": "boolean"
          },
          "is_ready_for_shipping": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "rackbeat_get_order",
      "description": "Read an order summary plus a bounded page of line quantities and prices. line_offset/line_limit slice locally after fetching one complete order within the response-size limit. Omits attachments, addresses and notes. Does not change the order.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "order_number": {
            "type": "string",
            "pattern": "^[1-9]\\d{0,15}$"
          },
          "line_offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "line_limit": {
            "default": 25,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "order_number"
        ]
      }
    },
    {
      "name": "rackbeat_customers",
      "description": "Read one bounded page of customer number, name, company, currency and barred/deleted status. Optional text search is sent to Rackbeat. Omits contact details, addresses and payment settings.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "page": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "search": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.usefulapi/rackbeat",
    "version": "1.11.9",
    "remoteUrl": "https://rackbeat.usefulapi.io/mcp",
    "publishedAt": "2026-11-27T09:44:19.205822Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "e389688f546bcab9bf64b97327d4615d81a25bade64715788e435a9c86f44663"
  }
}
