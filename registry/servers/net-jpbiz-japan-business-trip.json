{
  "$schema": "../schema.json",
  "name": "net.jpbiz/japan-business-trip",
  "title": "JpBiz Japan Business Trip Planner",
  "category": "Travel, Maps & Navigation",
  "description": "Draft Japan business trip itineraries by industry: trade shows, visits, budget, hotel/flight links.",
  "tools": [
    {
      "name": "flight_search_link",
      "description": "Build a Trip.com flight search link with route, dates, passengers and cabin pre-filled, for a business trip to or from Japan. Returns a link only: no fares, no booking. Give the user the link exactly as returned, with the disclaimer.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "origin": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "description": "Departure airport or city IATA code, e.g. PVG or SHA (Shanghai), PEK (Beijing), CAN, SZX, HKG, TPE, ICN, SIN, BKK."
          },
          "destination": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$",
            "description": "Arrival IATA code. Japan: TYO (all Tokyo airports), HND, NRT, OSA (all Osaka airports), KIX, NGO, FUK, CTS, OKA, SDJ, HIJ."
          },
          "departDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Outbound date, YYYY-MM-DD."
          },
          "returnDate": {
            "description": "Return date, YYYY-MM-DD. Omit for a one-way trip.",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "adults": {
            "default": 1,
            "description": "Number of adult passengers, 1-9.",
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "cabin": {
            "default": "economy",
            "type": "string",
            "enum": [
              "economy",
              "premium_economy",
              "business",
              "first"
            ]
          },
          "language": {
            "default": "zh",
            "description": "Language of the reply (and of the partner page for links): zh = Simplified Chinese, en = English, ja = Japanese. Use the user's language.",
            "type": "string",
            "enum": [
              "zh",
              "en",
              "ja"
            ]
          },
          "currency": {
            "description": "Currency shown on Trip.com. Default: CNY for zh, USD for en, JPY for ja.",
            "type": "string",
            "enum": [
              "CNY",
              "JPY",
              "USD",
              "EUR",
              "TWD",
              "HKD",
              "KRW",
              "GBP",
              "AUD",
              "SGD",
              "THB",
              "MYR",
              "IDR",
              "PHP",
              "VND",
              "CAD",
              "CHF"
            ]
          }
        },
        "required": [
          "origin",
          "destination",
          "departDate"
        ]
      }
    },
    {
      "name": "hotel_search_link",
      "description": "Build an Agoda hotel search link for a Japanese city with dates, guests and rooms pre-filled. Returns a link only: no rates, no booking. Give the user the link exactly as returned, with the disclaimer.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "enum": [
              "tokyo",
              "osaka",
              "kyoto",
              "yokohama",
              "nagoya",
              "fukuoka",
              "sapporo",
              "naha",
              "kobe",
              "hiroshima",
              "sendai",
              "kumamoto",
              "kanazawa",
              "fujikawaguchiko",
              "hakone",
              "nara",
              "wakayama",
              "okayama",
              "takamatsu",
              "matsuyama",
              "beppu",
              "nagasaki",
              "kagoshima",
              "shirahama",
              "kurashiki",
              "onomichi",
              "chiba",
              "himeji",
              "kofu",
              "saitama",
              "tsukuba",
              "mito",
              "otaru",
              "toyota",
              "yufu",
              "utsunomiya",
              "takasaki",
              "maebashi",
              "narita",
              "hitachi",
              "otsu",
              "izumisano",
              "shizuoka",
              "hamamatsu",
              "numazu",
              "toyohashi",
              "okazaki",
              "gifu",
              "takayama",
              "yokkaichi",
              "tsu",
              "nagano",
              "matsumoto",
              "niigata",
              "toyama",
              "fukui",
              "fukuyama",
              "kure",
              "shimonoseki",
              "matsue",
              "tottori",
              "yonago",
              "tokushima",
              "kochi",
              "imabari",
              "kitakyushu",
              "oita",
              "miyazaki",
              "saga",
              "sasebo",
              "hakodate",
              "asahikawa",
              "kushiro",
              "aomori",
              "morioka",
              "akita",
              "yamagata",
              "fukushima",
              "koriyama"
            ],
            "description": "Japanese city. For a place that is not listed, use the nearest listed city (e.g. Kawasaki → tokyo or yokohama)."
          },
          "checkIn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Check-in date, YYYY-MM-DD."
          },
          "checkOut": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Check-out date, YYYY-MM-DD."
          },
          "adults": {
            "default": 1,
            "description": "Number of adults, 1-10.",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "rooms": {
            "description": "Number of rooms. Default: one room per adult (business travellers rarely share).",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "language": {
            "default": "zh",
            "description": "Language of the reply (and of the partner page for links): zh = Simplified Chinese, en = English, ja = Japanese. Use the user's language.",
            "type": "string",
            "enum": [
              "zh",
              "en",
              "ja"
            ]
          },
          "currency": {
            "description": "Currency shown on Agoda. Default: CNY for zh, USD for en, JPY for ja.",
            "type": "string",
            "enum": [
              "JPY",
              "CNY",
              "USD",
              "EUR",
              "TWD",
              "HKD",
              "KRW",
              "GBP",
              "AUD",
              "SGD"
            ]
          }
        },
        "required": [
          "city",
          "checkIn",
          "checkOut"
        ]
      }
    },
    {
      "name": "generate_itinerary",
      "description": "Draft a day-by-day business trip itinerary in Japan for an industry and travel month: relevant trade shows (found with web search), business visits, leisure, a rough budget in JPY, and official institutions verified by JpBiz when they match. Takes 30-60 seconds. The result is an AI draft: tell the user to confirm trade show dates on the official sites. Afterwards hotel_search_link and flight_search_link can turn the trip dates into search links.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "industry": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "The traveller's industry, free text, e.g. 'semiconductors', '汽车零部件', '食品加工'."
          },
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "description": "Travel month, YYYY-MM, from the current month up to 12 months ahead."
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "Trip length in days, 1-10."
          },
          "departure": {
            "description": "Departure city, e.g. 'Shanghai'. Used for the flight budget. If omitted, flights are not estimated and the budget total excludes them.",
            "type": "string",
            "maxLength": 60
          },
          "preferences": {
            "description": "Anything else: cities, companies or facilities to visit, number of travellers, dinner budget, dietary needs.",
            "type": "string",
            "maxLength": 500
          },
          "language": {
            "default": "zh",
            "description": "Language of the reply (and of the partner page for links): zh = Simplified Chinese, en = English, ja = Japanese. Use the user's language.",
            "type": "string",
            "enum": [
              "zh",
              "en",
              "ja"
            ]
          }
        },
        "required": [
          "industry",
          "month",
          "days"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
