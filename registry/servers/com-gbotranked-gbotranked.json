{
  "$schema": "../schema.json",
  "name": "com.gbotranked/gbotranked",
  "title": "GBotRanked",
  "category": "Other",
  "description": "Search, compare and score Grok Bot templates, or check any x.ai/bot link. Read-only, no API key.",
  "tools": [
    {
      "name": "atlas_search_templates",
      "description": "Search the independent GBotRanked index by text, category, source, decision or minimum score.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "Accept",
              "Watchlist",
              "Reject"
            ]
          },
          "minScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "atlas_get_template",
      "description": "Return one indexed template with source evidence and the complete score breakdown.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "atlas_compare_templates",
      "description": "Compare up to five templates using the same versioned GBotRanked rubric.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 5
          }
        },
        "required": [
          "ids"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "atlas_get_top_templates",
      "description": "Return the highest-scoring indexed templates, optionally within one category.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "atlas_get_new_templates",
      "description": "Return templates ordered by their recorded link-check date.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "atlas_explain_score",
      "description": "Return the score decision, dimension breakdown, evidence, gaps and critical flags for one template.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "check_bot",
      "description": "Check one https://x.ai/bot/<id> share link. Returns the indexed template if listed; otherwise a provisional, unreviewed v2 score from the public share page only. Never lists or publishes anything.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "https://x.ai/bot/<id>"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.gbotranked/gbotranked",
    "version": "1.0.0",
    "remoteUrl": "https://gbotranked.com/api/mcp",
    "publishedAt": "2026-11-19T02:41:29.219715Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "64a4266f052406d795c3b9268e73041b495c016da2b7fb85ad21ed3e199e1269"
  }
}
