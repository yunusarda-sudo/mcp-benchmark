            "maximum": 20000,
            "minimum": 200,
            "type": "integer"
          },
          "site_name": {
            "maxLength": 255,
            "type": "string"
          },
          "title": {
            "maxLength": 8192,
            "type": "string"
          },
          "url": {
            "maxLength": 8192,
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      }
    },
