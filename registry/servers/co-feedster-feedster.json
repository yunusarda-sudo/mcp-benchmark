          },
          "q": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      }
    },
    {
      "name": "feeds.discover",
      "description": "Validate an RSS/Atom or website URL and discover available feeds without subscribing. May fetch the source website. Set is_private for credential-bearing subscription URLs.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "enum": [
              "json",
              "markdown"
            ],
            "type": "string"
          },
          "is_private": {
            "type": "boolean"
          },
          "max_chars": {
