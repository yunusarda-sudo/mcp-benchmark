      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "enum": [
              "json",
              "markdown"
            ],
            "type": "string"
          },
          "max_chars": {
            "maximum": 20000,
            "minimum": 200,
            "type": "integer"
          },
          "q": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      }
    },
    {
      "name": "channels.create",
      "description": "Create a channel. Private by default; is_public=true publishes it for other users to discover and subscribe to. Set is_public only when the user requests public sharing.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 4000,
            "type": "string"
          },
          "format": {
            "enum": [
              "json",
              "markdown"
            ],
            "type": "string"
          },
          "is_public": {
            "type": "boolean"
          },
          "max_chars": {
            "maximum": 20000,
            "minimum": 200,
            "type": "integer"
          },
          "name": {
            "maxLength": 255,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      }
    },
    {
      "name": "channels.update",
      "description": "Update only supplied fields on an owned channel. Changes to public channels are visible to other users; is_public=true publishes the channel for discovery and subscription, while is_public=false removes subscriptions.",
