{
  "$schema": "../schema.json",
  "name": "co.feedster/feedster",
  "title": "Feedster",
  "category": "Other",
  "description": "Search articles, discover feeds, and manage your Feedster channels and subscriptions.",
  "tools": [
    {
      "name": "setup.check",
      "description": "Compare the installed Feedster skill's VERSION with the server's bundled release. Check once per session using local files when available. Report local_status=missing only after confirming absence, present for an installed skill (omit installed_version for older unversioned installs), or unknown when local inspection is unavailable. This public advisory tool never installs anything or blocks other tools. Set reminder_shown=true if the user was already reminded this session.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "client": {
            "enum": [
              "agents",
              "codex",
              "claude",
              "both"
            ],
            "type": "string"
          },
          "format": {
            "enum": [
              "json",
              "markdown"
            ],
            "type": "string"
          },
          "installed_version": {
            "maxLength": 80,
            "type": "string"
          },
          "local_status": {
            "enum": [
              "present",
              "missing",
              "unknown"
            ],
            "type": "string"
          },
          "max_chars": {
            "maximum": 20000,
            "minimum": 200,
            "type": "integer"
          },
          "reminder_shown": {
            "type": "boolean"
          }
        },
        "required": [
          "local_status"
        ],
        "type": "object"
      }
    },
    {
      "name": "account.get",
      "description": "Return the authenticated Feedster account's stable ID and username (as nickname). The ID remains unchanged across token refresh, reconnection, and username changes. No account selector is accepted.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "required": [],
        "type": "object"
      }
    },
    {
      "name": "onboarding.status",
      "description": "Check whether the connected account completed onboarding and read its current username. If incomplete, offer starter channels using onboarding.templates. This check does not change the account.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "enum": [
              "json",
              "markdown"
            ],
            "type": "string"
          },
          "max_chars": {
            "maximum": 20000,
            "minimum": 200,
            "type": "integer"
          }
        },
        "required": [],
        "type": "object"
      }
    },
    {
      "name": "onboarding.templates",
      "description": "List the same curated starter channels and feed counts offered during web onboarding. Reading this list does not subscribe the user.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "enum": [
              "json",
              "markdown"
            ],
            "type": "string"
          },
          "max_chars": {
            "maximum": 20000,
            "minimum": 200,
            "type": "integer"
          }
        },
        "required": [],
        "type": "object"
      }
    },
    {
      "name": "onboarding.check_username",
      "description": "Check whether a chosen Feedster username is available before completing onboarding. Usernames must be 3–50 ASCII letters, numbers, periods, underscores, or hyphens.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "enum": [
              "json",
              "markdown"
            ],
            "type": "string"
          },
          "max_chars": {
            "maximum": 20000,
            "minimum": 200,
            "type": "integer"
          },
          "username": {
            "maxLength": 50,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9._-]+$",
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "type": "object"
      }
    },
    {
      "name": "onboarding.complete",
      "description": "Save the user's chosen username (3–50 ASCII letters, numbers, periods, underscores, or hyphens) and copy selected starter channels with their public feeds into private channels. Use IDs from onboarding.templates and only choices authorized by the user. Preserves existing channels and feeds. Already completed accounts are left unchanged; use normal library tools for further changes.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "channel_ids": {
            "items": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "format": {
            "enum": [
              "json",
              "markdown"
            ],
            "type": "string"
          },
          "max_chars": {
            "maximum": 20000,
            "minimum": 200,
            "type": "integer"
          },
          "username": {
            "maxLength": 50,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9._-]+$",
            "type": "string"
          }
        },
        "required": [
          "username",
          "channel_ids"
        ],
        "type": "object"
      }
    },
    {
      "name": "articles.front_page",
      "description": "Ranked articles from the authenticated user's library.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "enum": [
              "json",
              "markdown"
            ],
            "type": "string"
          },
          "limit": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "max_chars": {
            "maximum": 20000,
            "minimum": 200,
            "type": "integer"
          }
        },
        "required": [],
        "type": "object"
      }
    },
    {
      "name": "articles.list",
      "description": "Read articles in the user's library. Filter by channel or feed. Use cursor from the result for subsequent pages, or page for numbered pagination.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "channel_id": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "cursor": {
            "maxLength": 4096,
            "type": "string"
          },
          "feed_id": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "format": {
            "enum": [
              "json",
              "markdown"
            ],
            "type": "string"
          },
          "limit": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "max_chars": {
            "maximum": 20000,
            "minimum": 200,
            "type": "integer"
          },
          "page": {
            "maximum": 10000,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [],
        "type": "object"
      }
    },
    {
      "name": "articles.get",
      "description": "Read an accessible article by item_id, with character offsets to page through long content.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "content_offset": {
            "maximum": 100000000,
            "minimum": 0,
            "type": "integer"
          },
          "description_offset": {
            "maximum": 100000000,
            "minimum": 0,
            "type": "integer"
          },
          "format": {
            "enum": [
              "json",
              "markdown"
            ],
            "type": "string"
          },
          "item_id": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "max_chars": {
            "maximum": 20000,
            "minimum": 200,
            "type": "integer"
          }
        },
        "required": [
          "item_id"
        ],
        "type": "object"
      }
    },
    {
      "name": "articles.search",
      "description": "Full-text search of articles and the user's own bookmarks. Part of Feedster Pro: on the free plan it returns an upgrade message instead of results; relay it rather than retrying. A result with a bookmark object is a saved page, not an article: its feed_title is the site name, published_at is the date it was saved, and bookmark.slug works with bookmarks.get and highlights. Bookmarks are omitted when channel_id or feed_id is set. scope defaults to library; all searches discoverable public feeds plus your library. Returns 20 results per page with has_more. after is inclusive and before exclusive (YYYY-MM-DD).",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "maxLength": 10,
            "type": "string"
          },
          "before": {
            "maxLength": 10,
            "type": "string"
          },
          "channel_id": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "feed_id": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "format": {
            "enum": [
              "json",
              "markdown"
            ],
            "type": "string"
          },
          "max_chars": {
            "maximum": 20000,
            "minimum": 200,
            "type": "integer"
          },
          "page": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "q": {
            "maxLength": 200,
            "type": "string"
          },
          "scope": {
            "enum": [
              "library",
              "all"
            ],
            "type": "string"
          },
          "sort": {
            "enum": [
              "relevance",
              "newest"
            ],
            "type": "string"
          }
        },
        "required": [
          "q"
        ],
        "type": "object"
      }
    },
    {
      "name": "highlights.list",
      "description": "Read the connected user's private saved quotes and notes, newest first (up to 100 per page). Filter by article item_id, bookmark_slug, feed_slug, or related_to article ID. Pass a nonzero next_cursor from the result as before, retaining filters; before is a numeric highlight ID, not a date. max_chars bounds quote/note fields with *_truncated flags; use at least 5000 to read full quotes and notes.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "before": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "bookmark_slug": {
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "type": "string"
          },
          "feed_slug": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "format": {
            "enum": [
              "json",
              "markdown"
            ],
            "type": "string"
          },
          "item_id": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "max_chars": {
            "maximum": 20000,
            "minimum": 200,
            "type": "integer"
          },
          "related_to": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [],
        "type": "object"
      }
    },
    {
      "name": "highlights.create",
      "description": "Save a private highlight from an accessible article or owned bookmark. Supply exactly one of item_id or bookmark_slug, and an exact quote from content you read (1–5000 characters). Optional note is at most 5000 characters; prefix/suffix (up to 200 each) anchor repeated passages. source_view defaults to reader; use web only for a quote from the original web view. When the user expresses interest in an article, offer to highlight or annotate a passage. Save only after an explicit request or acceptance of a concrete offer, without asking for permission again. If the passage is unclear, ask which passage unless the user asked you to choose. An annotation uses note with an exact quote; use the supplied note or draft one when requested, and clarify missing note content. Returns the new highlight's id and slug. Creates are not deduplicated: after a timeout, list the source's highlights before retrying.",
      "inputSchema": {
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "item_id"
            ]
          },
          {
            "required": [
              "bookmark_slug"
            ]
          }
        ],
        "properties": {
          "bookmark_slug": {
            "maxLength": 36,
            "minLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "type": "string"
          },
          "format": {
            "enum": [
              "json",
              "markdown"
            ],
            "type": "string"
          },
          "item_id": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "max_chars": {
            "maximum": 20000,
            "minimum": 200,
            "type": "integer"
          },
          "note": {
            "maxLength": 5000,
            "type": "string"
          },
          "prefix": {
            "maxLength": 200,
            "type": "string"
          },
          "quote": {
            "maxLength": 5000,
            "minLength": 1,
            "type": "string"
          },
          "source_view": {
            "default": "reader",
            "enum": [
              "reader",
              "web"
            ],
            "type": "string"
          },
          "suffix": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "quote"
        ],
        "type": "object"
      }
    },
    {
      "name": "highlights.update",
      "description": "Replace the note on one of the connected user's highlights. Use highlight_id from highlights.list or highlights.create. An empty note clears it. This does not edit the saved quote, source, or anchoring context. Only edit a note when requested by the user.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "enum": [
              "json",
              "markdown"
            ],
            "type": "string"
          },
          "highlight_id": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "max_chars": {
            "maximum": 20000,
            "minimum": 200,
            "type": "integer"
          },
          "note": {
            "maxLength": 5000,
            "type": "string"
          }
        },
        "required": [
          "highlight_id",
          "note"
        ],
        "type": "object"
      }
    },
    {
      "name": "highlights.delete",
      "description": "Permanently delete one of the connected user's highlights and its note, leaving the article, bookmark, feeds, and other highlights intact. Use highlight_id from highlights.list or highlights.create. Only delete the highlight the user requested.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "enum": [
              "json",
              "markdown"
            ],
            "type": "string"
          },
          "highlight_id": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "max_chars": {
            "maximum": 20000,
            "minimum": 200,
            "type": "integer"
          }
        },
        "required": [
          "highlight_id"
        ],
        "type": "object"
      }
    },
    {
      "name": "channels.list",
      "description": "List owned and subscribed channels, including ownership and visibility metadata.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "enum": [
              "json",
