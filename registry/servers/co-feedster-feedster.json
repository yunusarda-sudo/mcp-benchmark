              "markdown"
            ],
            "type": "string"
          },
          "is_public": {
            "type": "boolean"
          },
          "max_chars": {
            "maximum": 20000,
            "minimum": 200,
            "type": "integer"
          },
          "name": {
            "maxLength": 255,
            "type": "string"
          }
        },
        "required": [
          "channel_id"
        ],
        "type": "object"
      }
    },
    {
      "name": "channels.delete",
      "description": "Delete an owned channel and its memberships. Shared public feeds remain; orphaned private subscriptions may be deleted. Cannot delete a subscribed channel owned by someone else.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "channel_id": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
