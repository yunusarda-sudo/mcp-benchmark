    {
      "name": "feeds.list",
      "description": "List your feeds, optionally within a channel. Includes private/unavailable flags; private source credentials are not returned.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "channel_id": {
            "maximum": 9007199254740991,
