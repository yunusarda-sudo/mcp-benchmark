    {
      "name": "feeds.search",
      "description": "Search the public Feedster feed catalog by title or URL. channel_id excludes feeds already in an owned channel. Results are paginated; this does not search the entire web or subscribe.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "channel_id": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "format": {
            "enum": [
              "json",
              "markdown"
            ],
            "type": "string"
          },
          "limit": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "max_chars": {
            "maximum": 20000,
            "minimum": 200,
            "type": "integer"
          },
