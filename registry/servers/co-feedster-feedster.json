      }
    },
    {
      "name": "channels.get",
      "description": "Get a channel from your owned or subscribed channels.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "channel_id": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "format": {
            "enum": [
              "json",
              "markdown"
            ],
            "type": "string"
          },
          "max_chars": {
            "maximum": 20000,
            "minimum": 200,
            "type": "integer"
          }
        },
        "required": [
          "channel_id"
        ],
        "type": "object"
      }
    },
    {
      "name": "channels.search",
