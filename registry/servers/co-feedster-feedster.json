      }
    },
    {
      "name": "feeds.create",
      "description": "Subscribe an owned channel to a feed URL (existing public feeds are reused). Use feeds.search or feeds.discover first when the URL is unknown. Set is_private for personal subscription URLs; never publish those URLs.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "channel_id": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "format": {
            "enum": [
              "json",
              "markdown"
            ],
