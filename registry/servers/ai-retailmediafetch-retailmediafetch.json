{
  "$schema": "../schema.json",
  "name": "ai.retailmediafetch/retailmediafetch",
  "title": "retailmediafetch",
  "category": "AI, LLMs & Agents",
  "description": "84M GTINs on gtinfetch. Agentic commerce hub for the media on the shelf. Was A2A Retailmedia.",
  "tools": [
    {
      "name": "resolve_jurisdiction",
      "description": "Where is the media bought? Resolve a market (e.g. FR, UK, US, Japan) to one of the 20 markets on the record. UK is the label; GB is accepted.",
      "inputSchema": {
        "properties": {
          "market": {
            "type": "string"
          }
        },
        "required": [
          "market"
        ],
        "type": "object"
      }
    },
    {
      "name": "resolve_actor",
      "description": "Who is asking? maker, brand_owner, agency, distributor or retailer_media_team (trade); auditor (read only). The consumer is never the counterparty.",
      "inputSchema": {
        "properties": {
          "actor_class": {
            "type": "string"
          }
        },
        "required": [
          "actor_class"
        ],
        "type": "object"
      }
    },
    {
      "name": "gate_transaction",
      "description": "The gate before a handshake: allow or deny for one market and one actor class. Returns a decision_id the handshake tools ask for. A deny is not charged.",
      "inputSchema": {
        "properties": {
          "market": {
            "type": "string"
          },
          "actor_class": {
            "type": "string"
          }
        },
        "required": [
          "market",
          "actor_class"
        ],
        "type": "object"
      }
    },
    {
      "name": "find_makers",
      "description": "Find the brand: makers on the grocery record of one market (node = one of the 20 markets). segment is taken as a lane where it names one (organic, free-from, plant-based, artisan, origin, premium). Read live from the A2A Grocery door.",
      "inputSchema": {
        "properties": {
          "segment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "node": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "type": "object"
      }
    },
    {
      "name": "resolve_gtin",
      "description": "Product record from gtinfetch.ai (signed); hub layer: seat, market, claim, price, availability. Confirm the product is real: is this Global Trade Item Number (GTIN) well-formed, and is it on the grocery record, with its brand and maker. Read live from the A2A Grocery door.",
      "inputSchema": {
        "properties": {
          "gtin": {
            "type": "string"
          }
        },
        "required": [
          "gtin"
        ],
        "type": "object"
      }
    },
    {
      "name": "check_eligibility",
      "description": "Confirm it is on the shelf: does the grocery record list this GTIN at this banner in this market? No listing, no media pitch. Read live from the A2A Grocery door.",
      "inputSchema": {
        "properties": {
          "gtin": {
            "type": "string"
          },
          "banner": {
            "type": "string"
          },
          "country_iso": {
            "type": "string"
          }
        },
        "required": [
          "gtin",
          "banner",
          "country_iso"
        ],
        "type": "object"
      }
    },
    {
      "name": "list_banners",
      "description": "Pick the banners: the grocery banners of one market with each one's media program (or \"none listed\") and card status. with_program=true returns only banners with a program listed.",
      "inputSchema": {
        "properties": {
          "market": {
            "type": "string"
          },
          "with_program": {
            "default": false,
            "type": "boolean"
          },
          "search": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "limit": {
            "default": 100,
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "type": "integer"
          }
        },
        "required": [
          "market"
        ],
        "type": "object"
      }
    },
    {
      "name": "get_banner_card",
      "description": "The signed card of one banner and its status (listed · claimed · verified). banner = the banner's slug, id or name.",
      "inputSchema": {
        "properties": {
          "market": {
            "type": "string"
          },
          "banner": {
            "type": "string"
          }
        },
        "required": [
          "market",
          "banner"
        ],
        "type": "object"
      }
    },
    {
      "name": "list_banner_cards",
      "description": "The cards of one market, optionally by status (unclaimed, claimed, registered): banner, media program, status and the card's address.",
      "inputSchema": {
        "properties": {
          "market": {
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "limit": {
            "default": 200,
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "type": "integer"
          }
        },
        "required": [
          "market"
        ],
        "type": "object"
      }
    },
    {
      "name": "list_packages",
      "description": "Match a package: what one banner's media program says it sells, in the program's own words, each tagged onsite, offsite or in-store. Offsite is tagged so it is never taken for a shelf slot. Empty where no program is listed — the agent stops.",
      "inputSchema": {
        "properties": {
          "market": {
            "type": "string"
          },
          "banner": {
            "type": "string"
          },
          "decision_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "market",
          "banner"
        ],
        "type": "object"
      }
    },
    {
      "name": "quote_package",
      "description": "Price it: returns where the banner's own media program publishes its rates or takes an enquiry. wefetch never prices; a quote comes from the retailer's program.",
      "inputSchema": {
        "properties": {
          "market": {
            "type": "string"
          },
          "banner": {
            "type": "string"
          },
          "decision_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "market",
          "banner"
        ],
        "type": "object"
      }
    },
    {
      "name": "find_buyer",
      "description": "Qualify the buyer: find a maker on the grocery record by name, with its own website where the record has one.",
      "inputSchema": {
        "properties": {
          "maker": {
            "type": "string"
          },
          "market": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "decision_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "maker"
        ],
        "type": "object"
      }
    },
    {
      "name": "submit_demand",
      "description": "Hand off: the packet — the maker, a budget a person has approved, one or more GTINs, a market and a list of banners — or a gap naming what is missing. Routes each banner by its card status: unclaimed is a referral, claimed goes to the retailer's media team, registered goes agent to agent. Settles at the door.",
      "inputSchema": {
        "properties": {
          "maker": {
            "type": "string"
          },
          "budget": {
            "type": "number"
          },
          "budget_approved_by": {
            "type": "string"
          },
          "gtins": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "market": {
            "type": "string"
          },
          "banners": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "contact": {
            "type": "string"
          },
          "decision_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "maker",
          "budget",
          "budget_approved_by",
          "gtins",
          "market",
          "banners",
          "contact"
        ],
        "type": "object"
      }
    },
    {
      "name": "receive_demand",
      "description": "Retailer side: a registered program agent takes a qualified packet. Only a card in the registered state can receive; any other card is refused and nothing is charged.",
      "inputSchema": {
        "properties": {
          "market": {
            "type": "string"
          },
          "banner": {
            "type": "string"
          },
          "handoff_id": {
            "type": "string"
          },
          "decision_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "market",
          "banner",
          "handoff_id"
        ],
        "type": "object"
      }
    },
    {
      "name": "a2a_handoff",
      "description": "Hand to a person: the state of a handoff and its Navigator desk ticket, where the media program has no agent.",
      "inputSchema": {
        "properties": {
          "handoff_id": {
            "type": "string"
          }
        },
        "required": [
          "handoff_id"
        ],
        "type": "object"
      }
    },
    {
      "name": "pull_measurement",
      "description": "Read the till: results of a campaign, returned by the retailer's program. Available only after the program returns a campaign id for a handoff.",
      "inputSchema": {
        "properties": {
          "handoff_id": {
            "type": "string"
          }
        },
        "required": [
          "handoff_id"
        ],
        "type": "object"
      }
    },
    {
      "name": "renew_package",
      "description": "Renew: a prior quote id from the retailer's program and a new approved budget. Without a quote id from the program there is nothing to renew.",
      "inputSchema": {
        "properties": {
          "prior_quote_id": {
            "type": "string"
          },
          "budget": {
            "type": "number"
          },
          "budget_approved_by": {
            "type": "string"
          },
          "decision_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "prior_quote_id",
          "budget",
          "budget_approved_by"
        ],
        "type": "object"
      }
    },
    {
      "name": "log_audit",
      "description": "Write one audit line for a step of the chain; returns its id.",
      "inputSchema": {
        "properties": {
          "event": {
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "event"
        ],
        "type": "object"
      }
    },
    {
      "name": "enrol_maker",
      "description": "Makers: be seen. Enrol a maker for media exposure in grocery: its name, its markets (one or more of the 20), the tick, and a contact a person can answer. Enrolment only — a handoff waits for a budget a person has approved.",
      "inputSchema": {
        "properties": {
          "maker": {
            "type": "string"
          },
          "markets": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "media_exposure": {
            "type": "boolean"
          },
          "contact": {
            "type": "string"
          }
        },
        "required": [
          "maker",
          "markets",
          "media_exposure",
          "contact"
        ],
        "type": "object"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "ai.retailmediafetch/retailmediafetch",
    "version": "1.0.12",
