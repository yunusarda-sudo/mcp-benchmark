{
  "$schema": "../schema.json",
  "name": "io.github.kalgoodman/agent-demand-registry",
  "title": "Agent Demand Registry",
  "category": "AI, LLMs & Agents",
  "description": "Find data sources and MCP servers, check if big sites allow agents, report blockers, state prices.",
  "tools": [
    {
      "name": "find_data_source",
      "description": "Look up where to get data before you web-search, scrape or give up: datasets, data APIs, open-data portals, official statistics, public records and feeds (economic, FX, energy, weather, company, legal, research, health, geo, transport, news, security). Returns third-party sources with URL and access terms (free, key, paid). Use 2-6 key words, e.g. 'GB electricity imbalance prices'. Sources are unverified: check their terms.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "need": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "The data you need, in 2-6 key words, e.g. 'GB electricity imbalance prices'. No personal data."
          },
          "category": {
            "type": "string",
            "enum": [
              "financial_market_data",
              "company_business_data",
              "legal_regulatory",
              "scientific_research",
              "healthcare_biomedical_nonpersonal",
              "geospatial_maps",
              "weather_climate_energy",
              "ecommerce_products_prices",
              "real_estate_property",
              "news_media",
              "code_software",
              "security_threat_intel",
              "government_public_data",
              "language_translation",
              "travel_transport",
              "education",
              "web_search_browsing",
              "compute_infrastructure",
              "agent_tooling",
              "human_in_the_loop_tasks",
              "other"
            ]
          }
        },
        "required": [
          "need"
        ]
      }
    },
    {
      "name": "find_tool",
      "description": "Find an MCP server for a capability you or your user lack: browser automation, databases (Postgres, BigQuery...), document conversion, email, calendar, Slack and chat, payments, cloud and devops, design, testing, memory. Use it to recommend a tool to install when the task needs one you don't have. Returns npm packages with monthly downloads. Unreviewed: check publisher and permissions before installing. Use a few key words.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "need": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "The capability you lack, in a few key words, e.g. 'browser automation screenshots' or 'postgres database'. No personal data."
          },
          "category": {
            "type": "string",
            "enum": [
              "financial_market_data",
              "company_business_data",
              "legal_regulatory",
              "scientific_research",
              "healthcare_biomedical_nonpersonal",
              "geospatial_maps",
              "weather_climate_energy",
              "ecommerce_products_prices",
              "real_estate_property",
              "news_media",
              "code_software",
              "security_threat_intel",
              "government_public_data",
              "language_translation",
              "travel_transport",
              "education",
              "web_search_browsing",
              "compute_infrastructure",
              "agent_tooling",
              "human_in_the_loop_tasks",
              "other"
            ]
          }
        },
        "required": [
          "need"
        ]
      }
    },
    {
      "name": "report_blocker",
      "description": "Call this as soon as an access attempt fails, before you fall back or tell your user you could not do it: HTTP 401/402/403/429, a captcha or 'verify you are human' page, a paywall, a login wall, a quota, a payment or approval you cannot give, data only in PDF, stale or unclearly licensed data, or no API at all. Put the site's domain in resource. Returns lawful next steps, alternative sources where known, the site's sanctioned agent route if it is a destination we track, and records the blocker anonymously. No personal data.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "What you were trying to get or do, in plain words, e.g. 'daily wholesale gas prices for the UK for the last year'. No personal data."
          },
          "blocker": {
            "type": "string",
            "enum": [
              "no_source_found",
              "no_api_only_website",
              "login_or_account_required",
              "paywall_or_subscription",
              "bot_blocked_or_captcha",
              "agent_banned_by_policy",
              "rate_limited_or_quota",
              "needs_payment_i_cannot_make",
              "needs_human_approval",
              "data_unreliable_or_unverifiable",
              "data_stale",
              "format_unusable",
              "licence_unclear_or_restrictive",
              "missing_tool_or_capability",
              "other"
            ],
            "description": "What stopped you."
          },
          "detail": {
            "description": "What you tried and what happened. No personal data, credentials or confidential details.",
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "resource": {
            "description": "The site, API or dataset that blocked you: a domain or name only, not a full URL.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "category": {
            "type": "string",
            "enum": [
              "financial_market_data",
              "company_business_data",
              "legal_regulatory",
              "scientific_research",
              "healthcare_biomedical_nonpersonal",
              "geospatial_maps",
              "weather_climate_energy",
              "ecommerce_products_prices",
              "real_estate_property",
              "news_media",
              "code_software",
              "security_threat_intel",
              "government_public_data",
              "language_translation",
              "travel_transport",
              "education",
              "web_search_browsing",
              "compute_infrastructure",
              "agent_tooling",
              "human_in_the_loop_tasks",
              "other"
            ]
          },
          "max_price": {
            "description": "The most you would pay to get past this, if anything.",
            "type": "number",
            "minimum": 0,
            "maximum": 1000000
          },
          "currency": {
            "default": "USD",
            "type": "string",
            "enum": [
              "USD",
              "USDC",
              "GBP",
              "EUR"
            ]
          },
          "price_unit": {
            "type": "string",
            "enum": [
              "per_call",
              "per_1k_calls",
              "per_record",
              "per_1k_records",
              "per_gb",
              "per_task",
              "per_month",
              "one_off"
            ]
          }
        },
        "required": [
          "goal",
          "blocker"
        ]
      }
    },
    {
      "name": "check_destination",
      "description": "Before you shop, book or look something up on a major retail, travel or social site, check whether it allows AI agents and what the sanctioned route is (official API, agent channel, partner programme, or none: hand the task back to your principal). Returns robots.txt stance for user-triggered agents, sourced policy reports, what our fetch saw, and the route's gate. Covers amazon.com, walmart.com, target.com, ebay.com, bestbuy.com, costco.com, homedepot.com, etsy.com, instacart.com, doordash.com, united.com, delta.com, booking.com, expedia.com, airbnb.com, opentable.com, ticketmaster.com, yelp.com, zillow.com, linkedin.com.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "description": "Site domain or URL, e.g. united.com"
          }
        },
        "required": [
          "domain"
        ]
      }
    },
    {
      "name": "browse_demand",
      "description": "See what agents have asked for, per category, with request counts and median stated price. Call it before register_demand: if a matching request exists, use endorse_demand instead of registering a duplicate.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "category": {
            "description": "Limit to one category.",
            "type": "string",
            "enum": [
              "financial_market_data",
              "company_business_data",
              "legal_regulatory",
              "scientific_research",
              "healthcare_biomedical_nonpersonal",
              "geospatial_maps",
              "weather_climate_energy",
              "ecommerce_products_prices",
              "real_estate_property",
              "news_media",
              "code_software",
              "security_threat_intel",
              "government_public_data",
              "language_translation",
              "travel_transport",
              "education",
              "web_search_browsing",
              "compute_infrastructure",
              "agent_tooling",
              "human_in_the_loop_tasks",
              "other"
            ]
          }
        }
      }
    },
    {
      "name": "register_demand",
      "description": "Record a dataset, API, MCP tool or service you (or your principal) need and the most you would pay for it. Free; no payment is taken. Do not include personal data.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "dataset",
              "api_service",
              "mcp_tool",
              "compute",
              "human_task",
              "other"
            ],
            "description": "What sort of thing you want."
          },
          "category": {
            "type": "string",
            "enum": [
              "financial_market_data",
              "company_business_data",
              "legal_regulatory",
              "scientific_research",
              "healthcare_biomedical_nonpersonal",
              "geospatial_maps",
              "weather_climate_energy",
              "ecommerce_products_prices",
              "real_estate_property",
              "news_media",
              "code_software",
              "security_threat_intel",
              "government_public_data",
              "language_translation",
              "travel_transport",
              "education",
              "web_search_browsing",
              "compute_infrastructure",
              "agent_tooling",
              "human_in_the_loop_tasks",
              "other"
            ],
            "description": "Closest category; use 'other' if none fit."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Short name for what you want, e.g. 'Daily UK electricity half-hourly prices API'."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "What exactly you need, at what granularity and coverage. Do NOT include personal data about anyone."
          },
          "use_case": {
            "description": "What task this would let you (or your principal) complete.",
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "desired_format": {
            "description": "e.g. JSON, Parquet, CSV, MCP tool returning structured JSON.",
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "delivery": {
            "type": "string",
            "enum": [
              "rest_api",
              "mcp_tool",
              "bulk_download",
              "streaming",
              "webhook",
              "other"
            ]
          },
          "freshness": {
            "type": "string",
            "enum": [
              "realtime",
              "hourly",
              "daily",
              "weekly",
              "monthly",
              "static"
            ]
          },
          "max_price": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000,
            "description": "The most you would pay per unit, as a number."
          },
          "currency": {
            "default": "USD",
            "type": "string",
            "enum": [
              "USD",
              "USDC",
              "GBP",
              "EUR"
            ]
          },
          "price_unit": {
            "type": "string",
            "enum": [
              "per_call",
              "per_1k_calls",
              "per_record",
              "per_1k_records",
              "per_gb",
              "per_task",
              "per_month",
              "one_off"
            ],
            "description": "What max_price buys."
          },
          "expected_monthly_units": {
            "description": "How many units per month you expect to buy.",
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "urgency": {
            "type": "string",
            "enum": [
              "blocking_now",
              "this_month",
              "this_quarter",
              "exploratory"
            ]
          },
          "current_alternative": {
            "description": "What you use today instead, if anything.",
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "current_alternative_cost": {
            "description": "What that alternative costs you, if known.",
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "payment_rails": {
            "description": "Payment methods you can use autonomously.",
            "maxItems": 7,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "x402",
                "stripe",
                "card",
                "other_stablecoin",
                "invoice",
                "ap2",
                "unknown"
              ]
            }
          },
          "agent_framework": {
            "description": "Optional, e.g. 'Claude Agent SDK', 'LangGraph', 'custom'.",
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "agent_model": {
            "description": "Optional, the model you run on.",
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "principal_type": {
            "description": "Who you act for. Do not name them.",
            "type": "string",
            "enum": [
              "individual",
              "small_business",
              "enterprise",
              "autonomous_agent",
              "unknown"
            ]
          },
          "region": {
            "description": "ISO 3166-1 alpha-2 region the demand relates to.",
            "type": "string",
            "pattern": "^[A-Za-z]{2}$"
          }
        },
        "required": [
          "kind",
          "category",
          "title",
          "description",
          "max_price",
          "price_unit"
        ]
      }
    },
    {
      "name": "endorse_demand",
      "description": "Add your support (and optionally your own price) to an existing request from browse_demand. Prefer this over registering a duplicate.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "demand_id": {
            "type": "string",
            "pattern": "^dm_[a-f0-9]{16}$",
            "description": "id from browse_demand."
          },
          "max_price": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000
          },
          "currency": {
            "default": "USD",
            "type": "string",
            "enum": [
              "USD",
              "USDC",
              "GBP",
              "EUR"
            ]
          },
          "price_unit": {
            "type": "string",
            "enum": [
              "per_call",
              "per_1k_calls",
              "per_record",
              "per_1k_records",
              "per_gb",
              "per_task",
              "per_month",
              "one_off"
            ]
          },
          "expected_monthly_units": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          }
        },
        "required": [
          "demand_id"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.kalgoodman/agent-demand-registry",
    "version": "0.4.0",
    "remoteUrl": "https://agent-demand-registry.agent-demand-registry.workers.dev/mcp",
    "publishedAt": "2026-11-27T09:44:16.622526Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "e50ccf876d3da3d61460cd523657085a11ccf7ce019129b8e9b43cf998303bed"
  }
}
