{
  "$schema": "../schema.json",
  "name": "fr.crh.mcp/baticontrol",
  "title": "BatiControl — Construction DPGF, Law 1975, PLU/BIM & Warranties",
  "category": "Design, UI & 3D Media",
  "description": "Deterministic DPGF margin benchmarking, French Law 1975 subcontracting audit, PLU/BIM & warranties.",
  "repository": "https://github.com/antica-labs/baticontrol-mcp",
  "tools": [
    {
      "name": "benchmark_dpgf_quotes_and_margin_floor",
      "description": "Benchmarks M29 supplier DPGF quotes, enforces the 25.0% gross margin floor, and computes counter-offer targets in p95 125 ms (0,30 EUR, 100% deterministic).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lot_reference_code": {
            "type": "string",
            "minLength": 2,
            "default": "LOT-02-GO-RSO-PISCINE"
          },
          "quoted_dry_cost_excl_tax_eur": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 281605
          },
          "client_selling_excl_tax_eur": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 382000
          },
          "matter_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "audit_loi_1975_subcontracting_compliance",
      "description": "Audits Law n° 75-1334 Art. 3 & 14 payment delegation, CGI 283-2 nonies VAT reverse-charge, and Décennale 320.210048 (<= 26 M EUR) in p95 145 ms (0,25 EUR, 99.9% opposable).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "subcontractor_siren": {
            "type": "string",
            "pattern": "^\\d{9}$"
          },
          "contract_amount_excl_tax_eur": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "matter_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "simulate_plu_and_bim_parcel_feasibility",
      "description": "Simulates PLU & 3D BIM parcel footprint m2, floor-area ratio, and R*431-2 architectural regime in p95 110 ms at 0,00 EUR zero-charge with 15-minute quote_token.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "municipality_name": {
            "type": "string",
            "minLength": 2,
            "default": "Bormes-les-Mimosas"
          },
          "parcel_area_m2": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 1200
          },
          "footprint_area_m2": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 140
          },
          "floor_area_m2": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 195
          },
          "is_petitioner_legal_entity": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "certify_construction_warranty_schedule",
      "description": "Computes Civil Code Art. 1792 reception schedule (GPA 1y, Biennale 2y, Décennale 10y) in p95 95 ms (0,18 EUR, 100% calendar determinism).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation_reference_code": {
            "type": "string",
            "minLength": 2,
            "default": "OP-CRH-BELVEDERE-COSTA"
          },
          "reception_date_iso": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "default": "2026-11-10"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "reconcile_monthly_progress_billing_art4",
      "description": "Reconciles Art. 4 monthly situation cut-off (25th M -> 20th M+1 payment) and 3.0% delay penalty cap in p95 120 ms (0,28 EUR, RLS isolated).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "submitted_day_of_month_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31,
            "default": 24
          },
          "gross_situation_excl_tax_eur": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 50000
          },
          "delay_days_count": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "billing_year_month_code": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$",
            "default": "2026-11"
          },
          "matter_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "stage_technical_controller_escalation",
      "description": "Stages an L22 B2A2H technical controller & engineering review in p95 180 ms at 0,00 EUR zero-charge autonomous capture (KZ-076 opposable).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "engineering_issue_summary": {
            "type": "string",
            "minLength": 3,
            "default": "Contrôle technique solidité L+S et étude géotechnique G2 PRO"
          },
          "partner_entities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "preferred_slot_iso": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "subscribe_decennale_and_urssaf_drift",
      "description": "Registers an SSRF-safe L24 Décennale 320.210048 & URSSAF vigilance expiry webhook (1,60 EUR/mo) in p95 110 ms (99.9% recall, opposable Ed25519 JWS).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "subcontractor_siren": {
            "type": "string",
            "pattern": "^\\d{9}$",
            "default": "952449619"
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          },
          "hmac_secret_ref": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128
          }
        },
        "required": [
          "webhook_url"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "search",
      "description": "Searches tenant-isolated construction operations, DPGF lots, and Law 1975 subcontracts in p95 80 ms at 0,00 EUR zero-charge.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "fetch",
      "description": "Fetches a single tenant-isolated construction operation by ID or code in p95 75 ms at 0,00 EUR zero-charge.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
