{
  "$schema": "../schema.json",
  "name": "no.bedriftsatlas/peiling-bedriftsatlas",
  "title": "Peiling Bedriftsatlas",
  "category": "Other",
  "description": "Norwegian company data: registry, accounts and ownership. Norske bedriftsdata fra FullPeiling AS.",
  "tools": [
    {
      "name": "search",
      "description": "Søker etter virksomheter i Peiling Bedriftsatlas på navn eller organisasjonsnummer. Returnerer inntil ti treff med sted og profiladresse.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "fetch",
      "description": "Henter registeropplysninger for én norsk virksomhet etter organisasjonsnummer, med kilde og lenke til firmaprofilen.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "bedriftsdata",
      "description": "Henter én datadel for et organisasjonsnummer. Deler: register, regnskap, roller, avdelinger, konsern, eiere, eierkjede, eierhistorikk eller aksjeposter. Eierdata gjelder 31. desember i valgt årgang. Feltet nesteStart viser starten på neste side når flere rader er tilgjengelige.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "orgnr": {
            "type": "string"
          },
          "del": {
            "default": "register",
            "type": "string",
            "enum": [
              "register",
              "regnskap",
              "roller",
              "avdelinger",
              "konsern",
              "eiere",
              "eierkjede",
              "eierhistorikk",
              "aksjeposter"
            ]
          },
          "aar": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          "start": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "required": [
          "orgnr"
        ]
      }
    }
  ],
