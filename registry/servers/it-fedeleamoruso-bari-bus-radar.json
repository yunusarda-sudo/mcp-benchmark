{
  "$schema": "../schema.json",
  "name": "it.fedeleamoruso/bari-bus-radar",
  "title": "Bari Bus Radar (AMTAB)",
  "category": "Communication & Alerting",
  "description": "Real-time AMTAB urban bus arrivals, live GPS line radar, Bari POIs, and transit alerts.",
  "repository": "https://github.com/fellon83/baribusradarbot",
  "tools": [
    {
      "name": "search_stops",
      "description": "Cerca fermate autobus AMTAB a Bari per nome parziale (es. Torrente, Capruzzi), codice palina a 8 cifre (es. 05508101) o POI cittadino (Stazione Centrale, Policlinico, Politecnico, Aeroporto, Pane e Pomodoro, Bari Vecchia).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 6
          }
        }
      }
    },
    {
      "name": "find_nearby_stops",
      "description": "Trova le fermate AMTAB più vicine a una coppia di coordinate GPS nell'area metropolitana di Bari, ordinate per distanza crescente in metri.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lat",
          "lon"
        ],
        "properties": {
          "lat": {
            "type": "number",
            "minimum": 40.85,
            "maximum": 41.35
          },
          "lon": {
            "type": "number",
            "minimum": 16.55,
            "maximum": 17.25
          },
          "radius_m": {
            "type": "integer",
            "minimum": 50,
            "maximum": 2000,
            "default": 500
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 6
          }
        }
      }
    },
    {
      "name": "get_stop_arrivals",
      "description": "Restituisce gli arrivi in tempo reale (GPS live, stima capolinea, Virtual GPS crowdsourced, più orari programmati con stime di traffico/ritardo storico) per uno specifico stop_id a 8 caratteri.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stop_id"
        ],
        "properties": {
          "stop_id": {
            "type": "string",
            "pattern": "^#?[0-9][0-9A-Za-z]{7}$"
          },
          "route_filter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6
          },
          "horizon_min": {
            "type": "integer",
            "minimum": 10,
            "maximum": 60,
            "default": 35
          },
          "lang": {
            "type": "string",
            "enum": [
              "it",
              "en",
              "es",
              "fr",
              "de",
              "ru"
            ],
            "default": "it"
          }
        }
      }
    },
    {
      "name": "get_next_buses",
      "description": "Tool composito consigliato: risolve un codice fermata, un POI di Bari (es. Stazione Centrale, Aeroporto), un nome via o coordinate GPS nella fermata più pertinente (considerando direction_hint) e restituisce subito arrivi e fermate alternative/opposte.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stop_id": {
            "type": "string",
            "pattern": "^#?[0-9][0-9A-Za-z]{7}$"
          },
          "stop_query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "lat": {
            "type": "number",
            "minimum": 40.85,
            "maximum": 41.35
          },
          "lon": {
            "type": "number",
            "minimum": 16.55,
            "maximum": 17.25
          },
          "route_filter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6
          },
          "direction_hint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "lang": {
            "type": "string",
            "enum": [
              "it",
              "en",
              "es",
              "fr",
              "de",
              "ru"
            ],
            "default": "it"
          }
        }
      }
    },
    {
      "name": "get_line_status",
      "description": "Mostra per una linea AMTAB (es. PJ, 02, 16, 27) tutte le direzioni attive, i bus in servizio in tempo reale (GPS live / TripUpdate / Virtual GPS), le prossime partenze dal capolinea, le fermate principali (key_stops) e gli avvisi attivi.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_id"
        ],
        "properties": {
          "route_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6
          },
          "lang": {
            "type": "string",
            "enum": [
              "it",
              "en",
              "es",
              "fr",
              "de",
              "ru"
            ],
            "default": "it"
          }
        }
      }
    },
    {
      "name": "get_service_notices",
      "description": "Restituisce gli avvisi ufficiali AMTAB attivi (scioperi, deviazioni, fermate soppresse, ripristini) per una fermata, una linea o sull'intera rete, con sintesi/traduzione nella lingua richiesta.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stop_id": {
            "type": "string",
            "pattern": "^#?[0-9][0-9A-Za-z]{7}$"
          },
          "route_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6
          },
          "lang": {
            "type": "string",
            "enum": [
              "it",
              "en",
              "es",
              "fr",
              "de",
              "ru"
            ],
            "default": "it"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
