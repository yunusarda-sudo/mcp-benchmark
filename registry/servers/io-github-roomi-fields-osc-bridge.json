{
  "$schema": "../schema.json",
  "name": "io.github.roomi-fields/osc-bridge",
  "title": "osc-bridge",
  "category": "Developer Tools & DevOps",
  "description": "OSC ↔ MIDI bridge for synthesizers and DAWs, with the SyntHub catalogue. A MIDI MCP and OSC MCP.",
  "repository": "https://github.com/roomi-fields/osc-bridge",
  "tools": [
    {
      "name": "list_devices",
      "description": "Find drivers of synths, drum machines, controllers and DAWs in the SyntHub catalogue, by pages. Pass an id to list_routes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Words of the vendor, name or OSC prefix, all required."
          },
          "vendor": {
            "type": "string",
            "description": "Exact vendor name."
          },
          "kind": {
            "type": "string",
            "enum": [
              "hardware",
              "software"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "cursor": {
            "type": "string",
            "description": "nextCursor of the page before."
          },
          "user_id": {
            "type": "string",
            "description": "Optional, on every tool: your SyntHub id."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_device_docs",
      "description": "A device's markdown guide, sources and licence.",
      "inputSchema": {
        "type": "object",
        "required": [
          "device"
        ],
        "properties": {
          "device": {
            "type": "string",
            "description": "An id from list_devices, or short name (its default driver)."
          },
          "user_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "list_routes",
      "description": "What a device takes: settings (CC, NRPN, SysEx) with ranges, named values and notes, commands, triggers, replies, identity, banks, sources and licence. Follow nextCursor.",
      "inputSchema": {
        "type": "object",
        "required": [
          "device"
        ],
        "properties": {
          "device": {
            "type": "string",
            "description": "An id from list_devices, or short name (its default driver)."
          },
          "filter": {
            "type": "string",
            "description": "A word of a route's address, alias, usage or arguments; 5 per list without limit."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "At most this many routes per list."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Routes to skip per list."
          },
          "cursor": {
            "type": "string",
            "description": "nextCursor of the page before."
          },
          "user_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "export_device",
      "description": "Export a driver (OSCQuery, MIDNAM, CSV…) as text, a link if big, with credit. Never writes to a device.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string",
            "description": "Driver id or short name."
          },
          "format": {
            "type": "string",
            "enum": [
              "midi-csv",
              "midi-triggers-csv",
              "electra-one",
              "midnam",
              "oscquery",
              "midi2-controllers",
              "deluge",
              "knobkraft"
            ]
          },
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "device",
          "format"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "report_result",
      "description": "Report how a driver behaved on a real device you tested: trust is counted per firmware.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string",
            "description": "Driver id or short name."
          },
          "outcome": {
            "type": "string",
            "enum": [
              "works",
              "fails",
              "partial"
            ]
          },
          "address": {
            "type": "string",
            "description": "One address of list_routes; omit for the whole driver."
          },
          "firmware": {
            "type": "string"
          },
          "identity_hex": {
            "type": "string",
            "description": "The device's MIDI Identity Reply, in hex."
          },
          "note": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "device",
          "outcome"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_trust",
      "description": "How far users confirmed a driver, per firmware and address. Check it and source_tier before relying on it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string",
            "description": "Driver id or short name."
          },
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "device"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "report_mapping",
      "description": "Record what a control the user moved really sends (see relay_listen): its address, or its panel label, and exactly one of cc, nrpn_msb + nrpn_lsb, note.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string",
            "description": "Driver id, or vendor and model of a device without a driver."
          },
          "address": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "cc": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "nrpn_msb": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "nrpn_lsb": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "note": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "channel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "firmware": {
            "type": "string"
          },
          "identity_hex": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "device"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "submit_driver",
      "description": "Contribute a driver file (Open Synth Descriptors, https://synthub.roomi-fields.com/osd/) to SyntHub, with its source and licence.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "driver": {
            "type": "object"
          },
          "firmware": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "Where the mapping comes from."
          },
          "note": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "driver"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "submit_fix",
      "description": "Submit a variant of a driver corrected by the learned mappings that differ from it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string",
            "description": "Driver id or short name."
          },
          "firmware": {
            "type": "string",
            "description": "If several firmwares differ."
          },
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "device"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_contribution",
      "description": "Where one of your contributions stands, and why.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "share_preset",
      "description": "Share what the user made (never factory, bought or downloaded sounds) under CC BY-SA 4.0: SysEx, settings by driver address or MIDI file. Through a relay, give code to capture it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "own_sound": {
            "type": "boolean",
            "description": "True only after asking the user."
          },
          "kind": {
            "type": "string",
            "enum": [
              "sound",
              "sequence",
              "kit",
              "project",
              "bank",
              "clip"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "bass",
              "lead",
              "pad",
              "pluck",
              "keys",
              "organ",
              "brass",
              "strings",
              "bell",
              "arp",
              "sequence",
              "drums",
              "percussion",
              "fx",
              "texture",
              "vocal",
              "other"
            ]
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "tips": {
            "type": "string"
          },
          "tempo": {
            "type": "number"
          },
          "key": {
            "type": "string"
          },
          "firmware": {
            "type": "string"
          },
          "derived_from": {
            "type": "string",
            "description": "Id of the preset it was made from."
          },
          "hex": {
            "type": "string",
            "description": "SysEx in hex."
          },
          "librarian": {
            "type": "string",
            "description": "take_sound's librarian."
          },
          "settings": {
            "type": "object",
            "additionalProperties": true,
            "description": "{\"/filter/cutoff\": [90]}"
          },
          "midi_base64": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "The relay's pairing code."
          },
          "port": {
            "type": "string"
          },
          "request_hex": {
            "type": "string",
            "description": "With code: the dump request to send."
          },
          "seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "description": "With code: wait (default 5)."
          },
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "device",
          "name",
          "own_sound"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "update_preset",
      "description": "Publish a new version of your preset: content given replaces it, other fields change in place.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Preset id."
          },
          "changelog": {
            "type": "string",
            "description": "What changed."
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "tips": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "bass",
              "lead",
              "pad",
              "pluck",
              "keys",
              "organ",
              "brass",
              "strings",
              "bell",
              "arp",
              "sequence",
              "drums",
              "percussion",
              "fx",
              "texture",
              "vocal",
              "other"
            ]
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tempo": {
            "type": "number"
          },
          "key": {
            "type": "string"
          },
          "firmware": {
            "type": "string"
          },
          "hex": {
            "type": "string"
          },
          "settings": {
            "type": "object",
            "additionalProperties": true
          },
          "midi_base64": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "find_presets",
      "description": "Search shared sounds, patterns, kits and clips. sort: new (default), stars, loads or trusted.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "device": {
            "type": "string",
            "description": "Includes variants of the device."
          },
          "kind": {
            "type": "string",
            "enum": [
              "sound",
              "sequence",
              "kit",
              "project",
              "bank",
              "clip"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "bass",
              "lead",
              "pad",
              "pluck",
              "keys",
              "organ",
              "brass",
              "strings",
              "bell",
              "arp",
              "sequence",
              "drums",
              "percussion",
              "fx",
              "texture",
              "vocal",
              "other"
            ]
          },
          "genre": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "author": {
            "type": "string",
            "description": "Pseudonym."
          },
          "query": {
            "type": "string",
            "description": "Words, all required."
          },
          "sort": {
            "type": "string",
            "enum": [
              "new",
              "stars",
              "loads",
              "trusted"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "user_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_preset",
      "description": "One preset in full: content, versions, comments, licence and attribution line to credit.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Preset id."
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "An earlier version."
          },
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "report_preset",
      "description": "Report how a preset behaved on a real device; factory flags one that is not its sharer's.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Preset id."
          },
          "outcome": {
            "type": "string",
            "enum": [
              "works",
              "fails",
              "factory"
            ]
          },
          "firmware": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "outcome"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "withdraw_preset",
      "description": "Withdraw a preset you shared.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Preset id."
          },
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "comment_preset",
      "description": "Comment on a preset (public), or remove your comment, or flag another's.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Preset id."
          },
          "text": {
            "type": "string"
          },
          "remix": {
            "type": "string",
            "description": "Id of your remix."
          },
          "remove": {
            "type": "integer",
            "description": "Comment id."
          },
          "flag": {
            "type": "integer",
            "description": "Comment id."
          },
          "user_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "star_preset",
      "description": "Star a preset (on: false undoes). Without id, list your stars.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Preset id."
          },
          "on": {
            "type": "boolean"
          },
          "user_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "preset_collection",
      "description": "Public collections of presets: create, rename, add, remove, delete, get, list.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "rename",
              "add",
              "remove",
              "delete",
              "get",
              "list"
            ]
          },
          "collection": {
            "type": "string",
            "description": "Collection id."
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "Preset id."
          },
          "author": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "follow_author",
      "description": "Follow an author (on) or see their page; without author, the newest from those you follow.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string",
            "description": "Pseudonym."
          },
          "on": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "user_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "set_profile",
      "description": "Set the public profile of your author page; omitted fields stay, empty ones clear. Ask the user first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "featured": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 6,
            "description": "Your preset ids, shown first."
          },
          "location": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 8
          },
          "gear": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "description": "Instruments."
          },
          "about": {
            "type": "string",
            "description": "Markdown README."
          },
          "user_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "relay_status",
      "description": "Check the relay the user opened at https://synthub.roomi-fields.com/connect/: its ports and the drivers they confirmed. Sends nothing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The relay's pairing code."
          },
          "user_id": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "code"
        ]
      }
    },
    {
      "name": "relay_detect",
      "description": "Identify the devices on a relay by their MIDI identity replies. It changes nothing; maker requests need the user's accept at the relay, so tell them first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The relay's pairing code."
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 5000,
            "description": "Wait (default 1000)."
          },
          "maker_requests": {
            "type": "boolean",
            "description": "Also the makers' identity requests."
          },
          "listen_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20000,
            "description": "Then match the knobs the user turns."
          },
          "user_id": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "code"
        ]
      }
    },
    {
      "name": "relay_send",
      "description": "Send to the user's hardware: a driver address with args, or raw hex. SysEx other than the Identity Request may overwrite memory: the user must accept it at the relay (up to 2 min), so tell them first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The relay's pairing code."
          },
          "device": {
            "type": "string",
            "description": "Driver id or short name."
          },
          "address": {
            "type": "string",
            "description": "From list_routes."
          },
          "args": {
            "type": "array",
            "items": {},
            "description": "Device values."
          },
          "hex": {
            "type": "string",
            "description": "Raw MIDI instead."
          },
          "port": {
            "type": "string",
            "description": "Output port name or part of it."
          },
          "gap_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000,
            "description": "Pause between SysEx messages (default 50)."
          },
          "user_id": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "code"
        ]
      }
    },
    {
      "name": "relay_listen",
      "description": "Listen to the user's hardware for a few seconds; with a device, match the controls moved to its addresses.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The relay's pairing code."
          },
          "seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15,
            "description": "Default 3."
          },
          "device": {
            "type": "string",
            "description": "Driver id or short name."
          },
          "user_id": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "code"
        ]
      }
    },
    {
      "name": "take_sound",
      "description": "Take the sound a synth plays, or a stored program, through a relay (the user accepts each step). Share it with share_preset only if they made it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The relay's pairing code."
          },
          "port": {
            "type": "string",
            "description": "Output port name or part of it."
          },
          "program": {
            "type": "integer",
            "minimum": 1,
            "description": "Stored program, from 1."
          },
          "user_id": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
