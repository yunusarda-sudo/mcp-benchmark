{
  "$schema": "../schema.json",
  "name": "com.joincrewpool/crewpool",
  "title": "CrewPool",
  "category": "Communication & Alerting",
  "description": "Hire UK event, festival and bar crew by chat. Saves a draft job; the hirer confirms by email.",
  "tools": [
    {
      "name": "search_crew",
      "description": "Counts reachable UK event crew for a role near a town or postcode and lists a few examples as first name and last initial with town. Returns no contact details.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "near"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "bell_tents",
              "tipis_stretch",
              "marquees",
              "staging",
              "lighting",
              "power",
              "fencing",
              "furniture",
              "labour",
              "driving",
              "plant",
              "bar_staff",
              "cocktail",
              "barista",
              "personal_licence",
              "catering",
              "stewarding",
              "site_crew",
              "litter",
              "management",
              "site_manager",
              "bar_supervisor",
              "head_steward",
              "safety",
              "market_stalls",
              "grotto_hosts",
              "performers",
              "waiting",
              "kitchen_porters",
              "chefs",
              "hosts",
              "security"
            ],
            "description": "Role key, for example bar_staff, stewarding, bell_tents, site_crew."
          },
          "near": {
            "type": "string",
            "description": "Town or postcode, for example Leeds or LS6."
          },
          "experienced_only": {
            "type": "boolean",
            "description": "Only crew who wrote down experience."
          }
        }
      }
    },
    {
      "name": "get_pay_guidance",
      "description": "Returns CrewPool's own figures for what UK event crew are offered and ask for, with the source page.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "bell_tents",
              "tipis_stretch",
              "marquees",
              "staging",
              "lighting",
              "power",
              "fencing",
              "furniture",
              "labour",
              "driving",
              "plant",
              "bar_staff",
              "cocktail",
              "barista",
              "personal_licence",
              "catering",
              "stewarding",
              "site_crew",
              "litter",
              "management",
              "site_manager",
              "bar_supervisor",
              "head_steward",
              "safety",
              "market_stalls",
              "grotto_hosts",
              "performers",
              "waiting",
              "kitchen_porters",
              "chefs",
              "hosts",
              "security"
            ],
            "description": "Optional role key for a group note."
          }
        }
      }
    },
    {
      "name": "draft_job",
      "description": "Saves a held draft job and emails the hirer a confirmation link. Nothing is posted and no crew are contacted until the hirer opens that email and confirms.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "role",
          "headcount",
          "date_start",
          "area"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "The hirer's own work email, as they gave it."
          },
          "role": {
            "type": "string",
            "enum": [
              "bell_tents",
              "tipis_stretch",
              "marquees",
              "staging",
              "lighting",
              "power",
              "fencing",
              "furniture",
              "labour",
              "driving",
              "plant",
              "bar_staff",
              "cocktail",
              "barista",
              "personal_licence",
              "catering",
              "stewarding",
              "site_crew",
              "litter",
              "management",
              "site_manager",
              "bar_supervisor",
              "head_steward",
              "safety",
              "market_stalls",
              "grotto_hosts",
              "performers",
              "waiting",
              "kitchen_porters",
              "chefs",
              "hosts",
              "security"
            ],
            "description": "One role key."
          },
          "headcount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "description": "How many people."
          },
          "date_start": {
            "type": "string",
            "description": "First day, YYYY-MM-DD."
          },
          "date_end": {
            "type": "string",
            "description": "Last day, YYYY-MM-DD. Defaults to date_start."
          },
          "area": {
            "type": "string",
            "description": "Town or postcode where the crew are needed."
          },
          "title": {
            "type": "string",
            "description": "Optional short title. Defaults to the role and area."
          },
          "hours": {
            "type": "string",
            "description": "Optional, for example 6pm to midnight."
          },
          "pay_amount": {
            "type": "number",
            "description": "Optional pay offered."
          },
          "pay_unit": {
            "type": "string",
            "enum": [
              "hour",
              "day"
            ],
            "description": "Required when pay_amount is given."
          },
          "pay_min": {
            "type": "number",
            "description": "Optional lower end of a pay range."
          },
          "client": {
            "type": "string",
            "description": "Name of the assistant making the request, for example Claude or ChatGPT."
          },
          "idempotency_key": {
            "type": "string",
            "description": "A random string of 16 to 100 characters, such as a UUID. The same key with the same email and client returns the same draft."
          }
        }
      }
    },
    {
      "name": "job_status",
      "description": "Reads whether a saved draft has been confirmed and, once live, how many people said yes, as first name and last initial with town and match. Never returns contact details.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job_id",
          "status_token"
        ],
        "properties": {
          "job_id": {
            "type": "string",
            "description": "The job_id from draft_job."
          },
          "status_token": {
            "type": "string",
            "description": "The status_token from draft_job."
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.joincrewpool/crewpool",
    "version": "1.0.0",
