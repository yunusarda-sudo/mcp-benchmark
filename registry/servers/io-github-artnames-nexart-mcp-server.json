{
  "$schema": "../schema.json",
  "name": "io.github.artnames/nexart-mcp-server",
  "title": "NexArt MCP Server",
  "category": "Developer Tools & DevOps",
  "description": "Certificate verification and opt-in customer-authorised confidential recording over stdio or HTTP.",
  "repository": "https://github.com/artnames/nexart-mcp-server",
  "tools": [
    {
      "name": "nexart_verify_ai_cer",
      "description": "Verify inline AI CER V1/V2 integrity using the NexArt SDK. No signature, signer-trust or completeness claim.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "bundle": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "array",
                "minItems": 0
              },
              {
                "type": "string",
                "minLength": 0
              },
              {
                "type": "number",
                "description": "Any JSON number."
              },
              {
                "type": "boolean",
                "description": "Any JSON boolean."
              },
              {
                "type": "null",
                "description": "JSON null."
              }
            ],
            "description": "An inline NexArt artifact. No URLs, paths, credentials or openings."
          }
        },
        "required": [
          "bundle"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "nexart_verify_consequential_cer",
      "description": "Verify inline consequential CER integrity. Producer identity and reported actions are not authenticated.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "bundle": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "array",
                "minItems": 0
              },
              {
                "type": "string",
                "minLength": 0
              },
              {
                "type": "number",
                "description": "Any JSON number."
              },
              {
                "type": "boolean",
                "description": "Any JSON boolean."
              },
              {
                "type": "null",
                "description": "JSON null."
              }
            ],
            "description": "An inline NexArt artifact. No URLs, paths, credentials or openings."
          }
        },
        "required": [
          "bundle"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "nexart_verify_governed_execution",
      "description": "Verify inline governed execution 0.1/0.2 with explicit version dispatch. No state-hash or producer authentication.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "bundle": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "array",
                "minItems": 0
              },
              {
                "type": "string",
                "minLength": 0
              },
              {
                "type": "number",
                "description": "Any JSON number."
              },
              {
                "type": "boolean",
                "description": "Any JSON boolean."
              },
              {
                "type": "null",
                "description": "JSON null."
              }
            ],
            "description": "An inline NexArt artifact. No URLs, paths, credentials or openings."
          }
        },
        "required": [
          "bundle"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "nexart_verify_project_bundle",
      "description": "Verify an inline Project Bundle and embedded AI CERs using the SDK; require project hash integrity.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "bundle": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "array",
                "minItems": 0
              },
              {
                "type": "string",
                "minLength": 0
              },
              {
                "type": "number",
                "description": "Any JSON number."
              },
              {
                "type": "boolean",
                "description": "Any JSON boolean."
              },
              {
                "type": "null",
                "description": "JSON null."
              }
            ],
            "description": "An inline NexArt artifact. No URLs, paths, credentials or openings."
          }
        },
        "required": [
          "bundle"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "nexart_lookup_cer",
      "description": "Look up one exact public NexArt hash. Return safe summaries and local returned-bundle integrity, not raw evidence or attestation authenticity.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "certificateHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "certificateHash"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "nexart_lookup_project_bundle",
      "description": "Look up one exact public NexArt hash. Return safe summaries and local returned-bundle integrity, not raw evidence or attestation authenticity.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "projectHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "projectHash"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "nexart_verify_node_receipt",
      "description": "Verify a CER receipt Ed25519 signature with the published SDK. Signature, binding, lifecycle and server-pinned trust are separate; Project receipts are unsupported.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "inline",
              "public_lookup"
            ]
          },
          "certificateHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "receipt": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "array",
                "minItems": 0
              },
              {
                "type": "string",
                "minLength": 0
              },
              {
                "type": "number",
                "description": "Any JSON number."
              },
              {
                "type": "boolean",
                "description": "Any JSON boolean."
              },
              {
                "type": "null",
                "description": "JSON null."
              }
            ]
          },
          "signatureB64Url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "source",
          "certificateHash"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "nexart_record_execution",
      "description": "Create and certify a new confidential AI V2 execution using the customer API key in the HTTP Authorization header and the approved NexArt dashboard policy. Explicitly select public or private visibility; there is no hosted default. May consume the customer account allowance. Existing CERs and local-only mode are unsupported on hosted HTTP. Model/provider require policy approval; other optional readable metadata is rejected. Structural IDs, timestamps, parameters, roles, SDK version, hashes and commitment descriptors remain readable. Input/output, instructions and decision references receive confidential commitments and durable age-encrypted recovery custody before submission. Producer-supplied data is not an authenticated provider observation. No plaintext/openings returned. Keep a stable executionId on retries; uncertain submissions are never automatically repeated.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "kind": {
            "type": "string",
            "const": "execution"
          },
          "execution": {
            "type": "object",
            "properties": {
              "executionId": {
                "type": "string",
                "minLength": 1
              },
              "timestamp": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "input": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                ]
              },
              "output": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                ]
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "temperature": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "maxTokens": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "topP": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "seed": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "temperature",
                  "maxTokens",
                  "topP",
                  "seed"
                ],
                "additionalProperties": false
              },
              "executionRole": {
                "type": "string",
                "enum": [
                  "advisory",
                  "operative",
                  "unspecified"
                ]
              },
              "instruction": {
                "type": "string"
              },
              "instructionKind": {
                "type": "string",
                "enum": [
                  "system",
                  "derived",
                  "label"
                ]
              },
              "decisionRefs": {
                "type": "array",
                "items": {}
              },
              "modelEvidence": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "identity": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sub": {
                    "type": "string",
                    "minLength": 1
                  },
                  "assertionHash": {
                    "type": "string",
                    "pattern": "^sha256:"
                  },
                  "emailHash": {
                    "type": "string",
                    "pattern": "^sha256:"
                  },
                  "verified": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "provider",
                  "sub",
                  "assertionHash",
                  "verified"
                ],
                "additionalProperties": false
              },
              "toolCalls": {
                "minItems": 1,
                "type": "array",
                "items": {}
              },
              "runId": {
                "type": "string",
                "minLength": 1
              },
              "stepId": {
                "type": "string",
                "minLength": 1
              },
              "stepIndex": {
                "type": "number"
              },
              "workflowId": {
                "type": "string",
                "minLength": 1
              },
              "conversationId": {
                "type": "string",
                "minLength": 1
              },
              "prevStepHash": {
                "type": "string",
                "minLength": 1
              },
              "sdkVersion": {
                "type": "string",
                "minLength": 1
              },
              "appId": {
                "type": "string",
                "minLength": 1
              },
              "ext": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "executionId",
              "timestamp",
              "provider",
              "model",
              "input",
              "output",
              "parameters",
              "executionRole"
            ],
            "additionalProperties": false
          },
          "createdAt": {
            "type": "string",
            "minLength": 1
          },
          "certification": {
            "type": "object",
            "properties": {
              "mode": {
                "default": "node",
                "type": "string",
                "const": "node"
              },
              "visibility": {
                "type": "string",
                "enum": [
                  "public",
                  "private"
                ]
              },
              "policy_revision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "visibility",
              "policy_revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "kind",
          "execution",
          "createdAt",
          "certification"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "nexart_get_certification_setup",
      "description": "Get non-certifying NexArt customer setup instructions: where to obtain a key, approve policy and configure protected client authentication. Never provide credentials or private age identities as tool arguments.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {},
        "additionalProperties": false
      }
    }
  ],
