{
  "$schema": "../schema.json",
  "name": "travel.goliath/goliath",
  "title": "Goliath Travel MCP",
  "category": "Other",
  "description": "Goliath is a free, read-only travel MCP server for cash fares, awards, hotels, trains and cruises.",
  "tools": [
    {
      "name": "get_service_status",
      "description": "Service limits, storage policy, the caller's workspace ID (for privacy requests) and a summary of supplier health. Pass supplier_id for one supplier's tools, limits and last health record, or category for a compact list of that category's suppliers.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "supplier_id": {
            "description": "Return this installed supplier's full record instead of the summary.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "category": {
            "description": "Return a compact list of the installed suppliers in this category instead of the summary.",
            "type": "string",
            "enum": [
              "stays",
              "cash_flights",
              "awards",
              "ground",
              "rental_cars",
              "cruises",
              "packages",
              "activities",
              "multi"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "find_sources",
      "description": "Find suppliers and reference data; this never searches inventory. catalogue (default) lists reviewed suppliers, ten compact rows per page, filtered by category, query or connected. award_programs lists loyalty-program coverage and bank transfer relationships. booking_guide gives official booking steps for an Aeroplan, Flying Blue or Virgin Atlantic award the traveler has chosen. registry searches the public MCP registry for unreviewed candidates, which cannot be executed. Query with provider or capability names, never private trip details.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "mode": {
            "default": "catalogue",
            "description": "Discovery mode (default catalogue).",
            "type": "string",
            "enum": [
              "catalogue",
              "registry",
              "award_programs",
              "booking_guide"
            ]
          },
          "booking_guide": {
            "description": "booking_guide mode only.",
            "type": "object",
            "properties": {
              "program": {
                "type": "string",
                "enum": [
                  "aeroplan",
                  "flyingblue",
                  "virginatlantic"
                ],
                "description": "Exact redemption program. Virgin Red, bank currencies and operating airlines are not aliases."
              },
              "operating_carriers": {
                "minItems": 1,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z0-9]{2}$"
                },
                "description": "Actual operating-airline IATA codes for all selected segments, not marketing codes. Omit if unknown."
              },
              "party": {
                "type": "object",
                "properties": {
                  "adults": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9
                  },
                  "children": {
                    "default": 0,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9
                  },
                  "infants_in_seat": {
                    "default": 0,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9
                  },
                  "infants_on_lap": {
                    "default": 0,
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9
                  }
                },
                "required": [
                  "adults"
                ],
                "additionalProperties": false,
                "description": "Adults and accompanied children use the program’s age definitions; infants are under two at travel. Zero adults with children requires unaccompanied-minor verification. Omit if unknown."
              }
            },
            "required": [
              "program"
            ],
            "additionalProperties": false
          },
          "query": {
            "type": "string",
            "maxLength": 100,
            "description": "One provider ID, name, capability term or country per call, matched as a literal substring; a country also matches the words sources use for it (Norway finds Norwegian). Exact ID and name matches come first. Not a sentence or a list. Omit to browse. Registry mode searches its remote index."
          },
          "category": {
            "description": "Catalogue mode: filter by category.",
            "type": "string",
            "enum": [
              "stays",
              "cash_flights",
              "awards",
              "ground",
              "rental_cars",
              "cruises",
              "packages",
              "activities",
              "multi"
            ]
          },
          "connected": {
            "description": "Catalogue mode. true lists only installed suppliers that search_travel can call; false lists only reviewed candidates.",
            "type": "boolean"
          },
          "detail": {
            "description": "Catalogue mode. compact (default) names each source and its tools; full adds hosts, evidence links and per-method freshness.",
            "type": "string",
            "enum": [
              "compact",
              "full"
            ]
          },
          "limit": {
            "description": "Rows per page for catalogue and award_programs (default 10).",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "description": "Row offset for catalogue or award_programs.",
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "cursor": {
            "description": "Registry mode pagination marker.",
            "type": "string",
            "maxLength": 1000
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_supplier_tools",
      "description": "Read one supplier's current tool names and input schemas before calling it through search_travel. freshness_policy=live_only leaves out cached and published-price tools.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "supplier_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Installed supplier ID from find_sources or get_service_status."
          },
          "freshness_policy": {
            "default": "prefer_live",
            "description": "prefer_live (default) lists all enabled tools; live_only omits cached-fallback methods.",
            "type": "string",
            "enum": [
              "prefer_live",
              "live_only"
            ]
          }
        },
        "required": [
          "supplier_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_travel",
      "description": "Search suppliers. Pass exactly one of: requirements (Goliath plans up to four requests; continue with plan_offset), searches (one to four explicit supplier/tool/arguments requests built from get_supplier_tools), or award_search (flexible-date award windows, served from cached sources). Live sources run first and cached results are labeled; freshness_policy=live_only refuses cached prices. Each result is the supplier's own data fitted to max_result_chars, plus offers, booking_links and award_observations where Goliath recognizes the response. Long lists come as tables that the reply's tables field explains. Trip details are not stored.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "requirements": {
            "description": "Trip requirements for a planned round-trip search.",
            "type": "object",
            "properties": {
              "travelers": {
                "minItems": 1,
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    },
                    "origin": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    },
                    "age_group": {
                      "type": "string",
                      "enum": [
                        "adult",
                        "child",
                        "infant"
                      ]
                    },
                    "max_budget": {
                      "type": "string",
                      "pattern": "^(?:0|[1-9]\\d{0,9})(?:\\.\\d{1,3})?$"
                    }
                  },
                  "required": [
                    "origin"
                  ],
                  "additionalProperties": false
                }
              },
              "origin": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "Shorthand departure airport IATA code or city name when travelers is omitted."
              },
              "adults": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12,
                "description": "Shorthand adult count (defaults to 1 with origin) when travelers is omitted."
              },
              "destinations": {
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "airport": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    },
                    "latitude": {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    },
                    "longitude": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                }
              },
              "departure_date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "return_date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "currency": {
                "default": "USD",
                "type": "string",
                "enum": [
                  "USD",
                  "EUR",
                  "GBP",
                  "CAD",
                  "AUD",
                  "NZD",
                  "JPY",
                  "CHF",
                  "MXN",
                  "BRL",
                  "INR",
                  "SGD",
                  "HKD",
                  "KRW",
                  "CNY",
                  "THB",
                  "AED",
                  "SEK",
                  "NOK",
                  "DKK",
                  "PLN",
                  "CZK",
                  "HUF",
                  "TRY",
                  "ZAR",
                  "BHD",
                  "KWD"
                ]
              },
              "rooms": {
                "default": 1,
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "min_beds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "max_stops": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "rewards": {
                "type": "object",
                "properties": {
                  "cabin": {
                    "type": "string",
                    "enum": [
                      "economy",
                      "premium_economy",
                      "business",
                      "first"
                    ],
                    "description": "Exact cabin for award-flight searches only; does not set the cash-flight cabin or permit mixed-cabin awards."
                  },
                  "loyalty_programs": {
                    "minItems": 1,
                    "maxItems": 35,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "description": "Exact redemption-program IDs, such as aeroplan, flyingblue, united or virginatlantic. These select mileage programs, not operating airlines or transferable bank points. Unknown IDs are retained; automatic award searches are skipped with a warning if any selected program cannot be mapped."
                  },
                  "transfer_programs": {
                    "minItems": 1,
                    "maxItems": 12,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "amexau",
                        "amexca",
                        "amexus",
                        "bilt",
                        "capitalone",
                        "chaseus",
                        "citius",
                        "esfera",
                        "livelo",
                        "rove",
                        "usbank",
                        "wellsfargo"
                      ]
                    },
                    "description": "Exact bank-program filters supported by Seats.aero, such as amexus, amexca, bilt or chaseus. Country-qualified IDs must match the traveler. These filter transfer relationships only; they do not establish card eligibility, balances, ratios, bonuses or available awards. Bank balances are not award-program mileage caps."
                  }
                },
                "additionalProperties": false,
                "description": "Optional award-flight preferences, independent of cash searches."
              },
              "free_cancellation_required": {
                "default": false,
                "type": "boolean"
              },
              "lodging": {
                "type": "object",
                "properties": {
                  "check_in": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "check_out": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "adults": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "children_ages": {
                    "default": [],
                    "maxItems": 12,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 17
                    }
                  },
                  "guest_country": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                  },
                  "bounding_box": {
                    "type": "object",
                    "properties": {
                      "north": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "south": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "east": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      },
                      "west": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "required": [
                      "north",
                      "south",
                      "east",
                      "west"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "check_in",
                  "check_out",
                  "adults",
                  "guest_country"
                ],
                "additionalProperties": false
              },
              "preferences": {
                "default": [],
                "maxItems": 15,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            },
            "additionalProperties": false
          },
          "searches": {
            "description": "One to four explicit supplier tool calls.",
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "supplier_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "description": "Installed supplier ID."
                },
                "tool": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 150,
                  "description": "Supplier tool name from get_supplier_tools."
                },
                "arguments": {
                  "default": {},
                  "description": "Supplier tool arguments.",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "fallback_for": {
                  "minItems": 1,
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                  },
                  "description": "Indexes of earlier live searches in this same batch for the same route/dates/party/product intent. Only for a cached fallback. Caller asserts equivalent intent; never group unrelated routes or cash and award products."
                }
              },
              "required": [
                "supplier_id",
                "tool"
              ],
              "additionalProperties": false
            }
          },
          "award_search": {
            "description": "Flexible award search across dates and programs.",
            "type": "object",
            "properties": {
              "source": {
                "default": "goliath",
                "description": "goliath (the default; seats_aero is accepted as the same choice) searches Goliath’s own award sources: its award cache (prices kept only from airlines that authorized it) and live searches on the airlines that serve the route (Aerolíneas, Bahamasair, RwandAir), up to 330 days ahead. A server that switches Seats.aero on adds its anonymous 60-day cache. Qantas selects the official cached finder with a 353-day horizon, exact airport pair, at most 31 days per leg and 5 seats. Qantas requires max_stops:null and sort:source_order.",
                "type": "string",
                "enum": [
                  "goliath",
                  "seats_aero",
                  "qantas"
                ]
              },
              "legs": {
                "minItems": 1,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "origins": {
                      "minItems": 1,
                      "maxItems": 10,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$"
                      },
                      "description": "Explicit source-confirmed IATA airport choices accepted by the traveler. Resolve places using search_airports first; do not invent nearby airports or positioning flights."
                    },
                    "destinations": {
                      "minItems": 1,
                      "maxItems": 10,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$"
                      },
                      "description": "Explicit source-confirmed IATA airport choices accepted by the traveler. Resolve places using search_airports first; do not invent nearby airports or positioning flights."
                    },
                    "start_date": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "end_date": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "min_seats": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 12,
                      "description": "Confirmed seats required together for this leg. This is a screening count, not a multiplier or a confirmed party award price."
                    },
                    "max_stops": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 2
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "Goliath’s sources (and Seats.aero) need an explicit permitted stop count; 0 means nonstop. Qantas requires null to explicitly accept unrestricted stops because its adapter cannot enforce a stop filter."
                    }
                  },
                  "required": [
                    "id",
                    "origins",
                    "destinations",
                    "start_date",
                    "end_date",
                    "min_seats",
                    "max_stops"
                  ],
                  "additionalProperties": false
                },
                "description": "Independent directional searches. Outbound and return date windows are searched independently; they do not establish a combined trip or acceptable stay length."
              },
              "filters": {
                "type": "object",
                "properties": {
                  "cabin": {
                    "type": "string",
                    "enum": [
                      "economy",
                      "premium_economy",
                      "business",
                      "first"
                    ]
                  },
                  "loyalty_programs": {
                    "minItems": 1,
                    "maxItems": 35,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "aeromexico",
                        "aeroplan",
                        "alaska",
                        "american",
                        "asiamiles",
                        "azul",
                        "british",
                        "copa",
                        "delta",
                        "emirates",
                        "ethiopian",
                        "etihad",
                        "eurobonus",
                        "eva",
                        "finnair",
                        "flyingblue",
                        "frontier",
                        "iberia",
                        "jal",
                        "jetblue",
                        "lifemiles",
                        "livelo",
                        "lufthansa",
                        "porter",
                        "qantas",
                        "qatar",
                        "saudia",
                        "singapore",
                        "smiles",
                        "spirit",
                        "turkish",
                        "united",
                        "velocity",
                        "virginatlantic",
                        "atmos"
                      ]
                    },
                    "description": "Redemption-program IDs, not bank currencies. Canonical atmos maps explicitly to upstream alaska; Virgin Red, hotel and rail currencies do not map to flight filters."
                  },
                  "transfer_programs": {
                    "minItems": 1,
                    "maxItems": 12,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "amexau",
                        "amexca",
                        "amexus",
                        "bilt",
                        "capitalone",
                        "chaseus",
                        "citius",
                        "esfera",
                        "livelo",
                        "rove",
                        "usbank",
                        "wellsfargo"
                      ]
                    },
                    "description": "Exact bank-program filters supported by Seats.aero. Country-qualified IDs must match the traveler; this screens program relationships and does not verify card eligibility, balances, transfer ratios or timing."
                  },
                  "alliances": {
                    "minItems": 1,
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "Star Alliance",
                        "Oneworld",
                        "SkyTeam"
                      ]
                    },
                    "description": "Operating-carrier alliances, not award-program or transfer eligibility."
                  },
                  "operating_carriers": {
                    "minItems": 1,
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Z0-9]{2}$"
                    }
                  },
                  "max_points": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000000,
                    "description": "Positive upstream mileage-cost cap, not a cash valuation or party total. Points in different programs are not interchangeable."
                  },
                  "max_fees_usd_cents": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000000,
                    "description": "Positive supplier screening cap in USD cents: 40000 = USD400. A zero cap is unsupported because upstream zero means unlimited. Preserve the returned original fee currency."
                  }
                },
                "additionalProperties": false
              },
              "sort": {
                "default": "departure_time",
                "description": "Goliath’s sources default to departure time. Qantas requires source_order because its first-page results do not promise chronological or price ordering. Choose mileage_cost or taxes only when requested and supported; neither establishes the cheapest full journey.",
                "type": "string",
                "enum": [
                  "departure_time",
                  "duration_minutes",
                  "stops",
                  "mileage_cost",
                  "taxes",
                  "source_order"
                ]
              }
            },
            "required": [
              "legs"
            ],
            "additionalProperties": false
          },
          "award_recheck": {
            "description": "Party and cabin context for live award rechecks.",
            "type": "object",
            "properties": {
              "enabled": {
                "default": true,
                "description": "Automatically recheck supported cached award candidates when party and cabin are confirmed. Set false to leave cached results unchanged.",
                "type": "boolean"
              },
              "adults": {
                "description": "Confirm the entire flight party consists of this many adults, with no children or infants. This cannot override conflicting trip requirements or combine travelers from different origins.",
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "cabin": {
                "description": "Explicitly confirmed cabin for a direct award recheck. Does not authorize changing a conflicting requested cabin or accepting mixed-cabin travel.",
                "type": "string",
                "enum": [
                  "economy",
                  "business"
                ]
              }
            },
            "additionalProperties": false
          },
          "plan_offset": {
            "description": "Offset from a previous reply next_offset.",
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "result_detail": {
            "default": "full",
            "description": "offers leaves out the supplier response wherever Goliath built normalized offers, keeping offers, booking_links and award_observations. full (default) returns both.",
            "type": "string",
            "enum": [
              "full",
              "offers"
            ]
          },
          "max_result_chars": {
            "description": "Approximate character budget for the raw supplier responses in this reply (default 60000). It never costs an option: a response is shortened only where every row cut is still in offers.items (result.omitted lists the cuts); otherwise it is returned whole and marked result.over_budget.",
            "type": "integer",
            "minimum": 10000,
            "maximum": 400000
          },
          "freshness_policy": {
            "default": "prefer_live",
            "description": "Prefer fresh live-capable suppliers; allow clearly labeled cached/published fallback when needed. live_only rejects cached-price sources and disclosed cache-hit inventory.",
            "type": "string",
            "enum": [
              "prefer_live",
              "live_only"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "compare_quotes",
      "description": "Arithmetic on quotes you already have; it looks nothing up. cash (default) totals flight, stay and extra costs per traveler. The other modes (awards, award_options, journeys, earning_plan, split_transfers) each take one object: call once with describe_mode=true to get that mode's input schema and rules. Nothing is ranked unless you pass the traveler's explicit objective. Long lists come as tables that the reply's tables field explains.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "mode": {
            "default": "cash",
            "description": "Comparison mode (default cash).",
            "type": "string",
            "enum": [
              "cash",
              "awards",
              "award_options",
              "journeys",
              "earning_plan",
              "split_transfers"
            ]
          },
          "describe_mode": {
            "description": "true returns the input schema and rules for `mode` and compares nothing. Do this once before first using a mode other than cash.",
            "type": "boolean"
          },
          "traveler_count": {
