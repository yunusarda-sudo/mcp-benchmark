{
  "$schema": "../schema.json",
  "name": "Trello MCP",
  "category": "Productivity & Notes",
  "description": "Trello MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "create_card",
      "description": "Add a new card to a specified Trello board list with description.",
      "inputSchema": {
        "type": "object",
        "required": [
          "listId",
          "name"
        ],
        "properties": {
          "listId": {
            "type": "string",
            "description": "Trello list identifier."
          },
          "name": {
            "type": "string",
            "description": "Card title name."
          }
        }
      }
    }
  ]
}
