{
  "$schema": "../schema.json",
  "name": "dog.pcb/mcp",
  "title": "pcb.dog",
  "category": "E-Commerce & Retail",
  "description": "PCB quotes in USD with door-to-door dates, Gerber DFM checks and ordering. Keyless; DDP to US/EU.",
  "tools": [
    {
      "name": "get_pcb_quote",
      "description": "Get a tiered PCB manufacturing quote from pcb.dog. USD prices with a door-to-door delivery_by date per tier; US and EU shipments are DDP. All parameters optional; defaults: 2 layers, 100x100 mm, qty 5.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "layers": {
            "type": "integer",
            "enum": [
              2,
              4,
              6
            ]
          },
          "width_mm": {
            "type": "number",
            "minimum": 10,
            "maximum": 400
          },
          "height_mm": {
            "type": "number",
            "minimum": 10,
            "maximum": 500
          },
          "qty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "thickness_mm": {
            "type": "number",
            "enum": [
              0.6,
              0.8,
              1,
              1.2,
              1.6,
              2
            ]
          },
          "finish": {
            "type": "string",
            "enum": [
              "hasl_lf",
              "hasl",
              "enig"
            ]
          },
          "mask": {
            "type": "string",
            "enum": [
              "green",
              "blue",
              "red",
              "black",
              "white",
              "yellow",
              "purple"
            ]
          }
        }
      }
    },
    {
      "name": "analyze_gerbers",
      "description": "Analyze a PCB Gerber .zip (up to 25 MB): detected layers, board size, hole count, DFM findings and a reusable id, from the same engine as the site. Pass exactly one of file_id, file_url or file_base64. With a shell, upload the local zip first with `curl -F file=@board.zip https://pcb.dog/api/analyze` and pass the returned id as file_id; base64 inside a tool call costs about one token per three bytes. file_url must be a public, direct link.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "file_url": {
            "type": "string",
            "format": "uri",
            "description": "Publicly reachable http(s) URL of one Gerber .zip (RS-274X + Excellon), up to 25 MB. Redirects are not followed."
          },
          "file_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$",
            "description": "id from `curl -F file=@board.zip https://pcb.dog/api/analyze` or a previous analysis; cached 24 hours after last use. The cheapest way to send a local file."
          },
          "file_base64": {
            "type": "string",
            "description": "The .zip as base64, up to 25 MB decoded. Last resort for clients without a shell: about one token per three bytes. With a shell, upload with curl and pass file_id."
          }
        }
      }
    },
    {
      "name": "find_cost_reductions",
      "description": "Find what makes a PCB spec cheaper: re-prices nearby specs (finish, thickness, mask, slower tiers, quantity breaks) from the live tariff and returns the USD savings for a tier (default economy).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "layers": {
            "type": "integer",
            "enum": [
              2,
              4,
              6
            ]
          },
          "width_mm": {
            "type": "number",
            "minimum": 10,
            "maximum": 400
          },
          "height_mm": {
            "type": "number",
            "minimum": 10,
            "maximum": 500
          },
          "qty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "thickness_mm": {
            "type": "number",
            "enum": [
              0.6,
              0.8,
              1,
              1.2,
              1.6,
              2
            ]
          },
          "finish": {
            "type": "string",
            "enum": [
              "hasl_lf",
              "hasl",
              "enig"
            ]
          },
          "mask": {
            "type": "string",
            "enum": [
              "green",
              "blue",
              "red",
              "black",
              "white",
              "yellow",
              "purple"
            ]
          },
          "tier": {
            "type": "string",
            "enum": [
              "economy",
              "standard",
              "express"
            ],
            "default": "economy"
          }
        }
      }
    },
    {
      "name": "get_capabilities",
      "description": "Manufacturing limits, reference stack-ups, accepted quote parameters and DRC rule-file URLs.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "create_order",
      "description": "Create a PCB order for a Gerber file analyzed with analyze_gerbers (its file_id). Checks the file for production problems, the tier and the shipping address, prices it server-side and returns an order summary: order_id, USD total, delivery_by date, links to a preview of the board and any DFM warnings (problems that would stop production come back as findings with a rule id). Nothing is charged. Show the summary and the preview to the person, then call confirm_order once they approve it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "file_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$",
            "description": "id from analyze_gerbers; layers and board size come from this file."
          },
          "tier": {
            "type": "string",
            "enum": [
              "economy",
              "standard",
              "express"
            ],
            "default": "economy",
            "description": "a tier get_pcb_quote offered for this board"
          },
          "qty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 5
          },
          "thickness_mm": {
            "type": "number",
            "enum": [
              0.6,
              0.8,
              1,
              1.2,
              1.6,
              2
            ]
          },
          "finish": {
            "type": "string",
            "enum": [
              "hasl_lf",
              "hasl",
              "enig"
            ]
          },
          "mask": {
            "type": "string",
            "enum": [
              "green",
              "blue",
              "red",
              "black",
              "white",
              "yellow",
              "purple"
            ]
          },
          "ship_to": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 100
              },
              "company": {
                "type": "string",
                "maxLength": 100
              },
              "line1": {
                "type": "string",
                "maxLength": 200
              },
              "line2": {
                "type": "string",
                "maxLength": 200
              },
              "city": {
                "type": "string",
                "maxLength": 100
              },
              "state": {
                "type": "string",
                "maxLength": 100
              },
              "postal_code": {
                "type": "string",
                "maxLength": 20
              },
              "country": {
                "type": "string",
                "pattern": "^[A-Za-z]{2}$",
                "description": "ISO 3166-1 alpha-2, e.g. US"
              },
              "phone": {
                "type": "string",
                "maxLength": 40
              }
            },
            "required": [
              "name",
              "line1",
              "city",
              "postal_code",
              "country"
            ]
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "the person's e-mail for order updates"
          },
          "reference": {
            "type": "string",
            "maxLength": 100,
            "description": "optional PO number or project name"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 100,
            "description": "optional; the same key and e-mail return the same order instead of a duplicate"
          }
        },
        "required": [
          "file_id",
          "ship_to",
          "email"
        ]
      }
    },
    {
      "name": "confirm_order",
      "description": "Place an order created with create_order, after the person approved its summary. Returns whether pcb.dog accepted the order, with a message for the person: an accepted order carries a payment link for the person to open (the agent never handles card details). Calling it again with the same order_id returns the same answer and never places a second order.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "pattern": "^ord_[0-9a-f]{12}$",
            "description": "order_id from create_order"
          }
        },
        "required": [
          "order_id"
        ]
      }
    },
    {
      "name": "save_quote",
      "description": "Save a pcb.dog quote against an e-mail address so pcb.dog can follow up on it. The server computes the price authoritatively. To order a board, use create_order.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "tier": {
            "type": "string",
            "enum": [
              "economy",
              "standard",
              "express"
            ],
            "default": "economy"
          },
          "layers": {
            "type": "integer",
            "enum": [
              2,
              4,
              6
            ]
          },
          "width_mm": {
            "type": "number",
            "minimum": 10,
            "maximum": 400
          },
          "height_mm": {
            "type": "number",
            "minimum": 10,
            "maximum": 500
          },
          "qty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "thickness_mm": {
            "type": "number",
            "enum": [
              0.6,
              0.8,
              1,
              1.2,
              1.6,
              2
            ]
          },
          "finish": {
            "type": "string",
            "enum": [
              "hasl_lf",
              "hasl",
              "enig"
            ]
          },
          "mask": {
            "type": "string",
            "enum": [
              "green",
              "blue",
              "red",
              "black",
              "white",
              "yellow",
              "purple"
            ]
          }
        },
        "required": [
          "email"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "dog.pcb/mcp",
