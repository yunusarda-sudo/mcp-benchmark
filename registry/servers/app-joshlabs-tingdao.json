{
  "$schema": "../schema.json",
  "name": "app.joshlabs/tingdao",
  "title": "TingDao",
  "category": "E-Commerce & Retail",
  "description": "Chinese Christian sermon catalog, Scripture-indexed transcripts, quotes & study notes via MCP.",
  "repository": "https://github.com/JoshLabs-App/tingdao-mcp",
  "tools": [
    {
      "name": "get_system_manifest",
      "description": "返回听到（Tingdao）轻量能力域索引、URL直达协议与安全边界（<250 Token）。先调此工具再按需展开域工具。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "expand_domain_tools",
      "description": "按需展开指定能力域（catalog | transcript | study | community | proposals）的完整工具参数 Schema。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "enum": [
              "catalog",
              "transcript",
              "study",
              "community",
              "proposals"
            ]
          }
        },
        "required": [
          "domain"
        ]
      }
    },
    {
      "name": "browse_catalog",
      "description": "浏览全站书卷/专辑、讲员列表、高频主题标签或专题查经读物（只读）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "books",
              "speakers",
              "topics",
              "reading_modules"
            ],
            "default": "books"
          },
          "query": {
            "type": "string",
            "description": "可选过滤词"
          },
          "lang": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ],
            "default": "zh"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 25
          }
        }
      }
    },
    {
      "name": "search_sermons",
      "description": "按关键词、书卷名或讲员检索听到讲道目录，返回真实短链、音频直链与文字稿可用标识（只读）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "标题、经文或主题关键词"
          },
          "book": {
            "type": "string",
            "description": "圣经书卷名（如：罗马书、约翰福音）"
          },
          "speaker": {
            "type": "string",
            "description": "讲员名（如：麦克阿瑟、寇绍涵、高路）"
          },
          "hasTranscriptOnly": {
            "type": "boolean",
            "description": "是否仅返回带有文字稿的课程",
            "default": false
          },
          "lang": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ],
            "default": "zh"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 10
          }
        }
      }
    },
    {
      "name": "search_by_scripture",
      "description": "按圣经经文引用（如“罗8:28”“约15”“诗篇 23”“Rom 8”）智能反查对应书卷讲道与相关经文金句（只读）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "description": "圣经书卷名或经文引用（支持中文全称、简称及英文）"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 10
          }
        },
        "required": [
          "reference"
        ]
      }
    },
    {
      "name": "get_lesson_detail",
      "description": "按 lessonId / key / short（如 52/1）获取单课讲道详情、音频直链、文字稿可用性与同系列上下课（只读）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lessonId": {
            "type": "string",
            "description": "课程 ID、短 key 或短网址（如 52/1）"
          },
          "lang": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ],
            "default": "zh"
          }
        },
        "required": [
          "lessonId"
        ]
      }
    },
    {
      "name": "get_lesson_transcript",
      "description": "分段读取单课讲道文字稿（自动合并最新众包勘误），每段附带可点击的时间戳直达链接（只读）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lessonId": {
            "type": "string",
            "description": "课程 ID、短 key 或短网址（如 32/35）"
          },
          "startSec": {
            "type": "number",
            "minimum": 0,
            "description": "起始秒数（可选）"
          },
          "endSec": {
            "type": "number",
            "minimum": 0,
            "description": "结束秒数（可选）"
          },
          "query": {
            "type": "string",
            "description": "可选：仅筛选包含该关键词的段落"
          },
          "maxChars": {
            "type": "integer",
            "minimum": 500,
            "maximum": 24000,
            "default": 8000
          }
        },
        "required": [
          "lessonId"
        ]
      }
    },
    {
      "name": "search_transcript_quotes",
      "description": "跨多篇讲道文字稿精准检索讲道原话，返回命中原句与时间戳直达链接（只读）。建议配合 book 或 speaker 缩小范围。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "要检索的原话、神学词或经文关键词"
          },
          "book": {
            "type": "string",
            "description": "限定圣经书卷名（推荐填写以提速）"
          },
          "speaker": {
            "type": "string",
            "description": "限定讲员名"
          },
          "lessonIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "可选：指定要搜索的课程 ID/短码列表"
          },
          "maxLessons": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "default": 6
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 8
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_user_study_state",
      "description": "读取当前登录听友的收听进度、收藏统计与最近听道笔记（只读，需 Authorization: Bearer <token>）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10
          }
        }
      }
    },
    {
      "name": "get_community_pulse",
      "description": "获取最新听友动态流（≤5 条）与近 7 天热门讲道（只读）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5
          }
        }
      }
    },
    {
      "name": "propose_note",
      "description": "两阶段安全写入：起草一条带时间戳的听道笔记，进入 mcp_proposals 收件箱待本人在端内确认后入库。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lessonId": {
            "type": "string"
          },
          "timeSec": {
            "type": "number",
            "minimum": 0,
            "default": 0
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "lessonId",
          "text"
        ]
      }
    },
    {
      "name": "propose_bookmark",
      "description": "两阶段安全写入：提案收藏一节讲道（可附带时间戳），进入收件箱待端内确认后加入收藏夹。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lessonId": {
            "type": "string"
          },
          "timeSec": {
            "type": "number",
            "minimum": 0,
            "default": 0
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "lessonId"
        ]
      }
    },
    {
      "name": "propose_playlist",
      "description": "两阶段安全写入：为听友编排一份专题听单（如 3 天灵修听单），返回一键导入播放队列直达链接并进入端内收件箱。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "听单名称（如：平安与信靠 3 日听单）"
          },
          "lessonIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 15,
            "description": "按收听顺序排列的课程 ID/短码"
          },
          "reason": {
            "type": "string",
            "maxLength": 300,
            "description": "编排思路与收听建议"
          }
        },
        "required": [
          "title",
          "lessonIds"
        ]
      }
    },
    {
      "name": "propose_transcript_edit",
      "description": "两阶段安全写入：提交讲道文字稿修订建议，进入 mcp_proposals 收件箱待端内确认后生效。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lessonId": {
            "type": "string"
          },
          "sSec": {
            "type": "number",
            "minimum": 0
          },
          "wasText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "bodyText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "lessonId",
          "sSec",
          "wasText",
          "bodyText"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "app.joshlabs/tingdao",
    "version": "1.0.0",
    "remoteUrl": "https://tingdao-sync.joshlabs.app/mcp",
    "publishedAt": "2026-11-28T05:18:33.393218Z",
