{
  "$schema": "../schema.json",
  "name": "net.barrielimo/booking",
  "title": "BarrieLimo.net",
  "category": "E-Commerce & Retail",
  "description": "Barrie, Ontario limo service: Pearson and Billy Bishop transfers, ski resorts, Casino Rama, Muskoka.",
  "tools": [
    {
      "name": "search_coverage",
      "description": "Find BarrieLimo.net pages for a city, airport, venue, event, service or topic. Returns titles, summaries and URLs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 8
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_page",
      "description": "Return the text of a page on www.barrielimo.net (Markdown when available). Accepts a full URL or a path.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "get_booking_options",
      "description": "Services, vehicles, coverage, pricing rules, contact channels, the online booker link and booking policies.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "request_booking",
      "description": "Send a chauffeured transportation request to BarrieLimo.net for the traveller. Only call when the traveller explicitly asked to book. Returns a reference (BRL-XXXXXXX); the team confirms price, vehicle and chauffeur by email or phone. Not confirmed until then; nothing is charged.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Lead passenger full name"
          },
          "email": {
            "type": "string",
            "description": "Email (email or phone required)"
          },
          "phone": {
            "type": "string",
            "description": "Mobile with country code"
          },
          "service": {
            "type": "string",
            "enum": [
              "Hourly private chauffeur",
              "Airport transfer",
              "Point to point",
              "Wedding / event",
              "Ski / cottage / casino trip",
              "Group / Sprinter"
            ]
          },
          "pickup": {
            "type": "string",
            "description": "Address, hotel, airport + terminal or venue"
          },
          "dropoff": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "description": "Local pickup date YYYY-MM-DD"
          },
          "time": {
            "type": "string",
            "description": "Local pickup time HH:MM"
          },
          "hours": {
            "type": "string",
            "description": "Hours needed for hourly / as-directed service"
          },
          "flight": {
            "type": "string"
          },
          "passengers": {
            "type": "integer",
            "minimum": 1
          },
          "bags": {
            "type": "integer",
            "minimum": 0
          },
          "vehicle": {
            "type": "string",
            "enum": [
              "Business sedan",
              "Business SUV",
              "Executive SUV",
              "First-class sedan",
              "Executive Sprinter",
              "Jet Sprinter",
              "Stretch limousine",
              "Stretch SUV limousine",
              "Party bus",
              "Rolls-Royce / Maybach"
            ]
          },
          "return": {
            "type": "string"
          },
          "notes": {
            "type": "string",
            "description": "Occasion, child seats, accessibility, stops"
          },
          "agent": {
            "type": "string",
            "description": "Name of your assistant or app"
          },
          "consent": {
            "type": "string",
            "enum": [
              "yes"
            ],
            "description": "The traveller explicitly asked for this booking"
          }
        },
        "required": [
          "name",
          "pickup",
          "dropoff",
          "date",
          "time",
          "consent"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "net.barrielimo/booking",
    "version": "1.0.0",
    "remoteUrl": "https://www.barrielimo.net/agent-api/mcp.php",
    "publishedAt": "2026-11-24T13:55:25.631902Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "06e7c4e70b2db5ca40369230df817b8d3c9ff0a2a755b5a867a2d817fe2248ff"
  }
}
