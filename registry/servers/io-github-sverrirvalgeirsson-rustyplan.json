{
  "$schema": "../schema.json",
  "name": "io.github.SverrirValgeirsson/rustyplan",
  "title": "Rustyplan",
  "category": "Developer Tools & VCS",
  "description": "Self-hosted group event scheduling with availability polling and voting.",
  "repository": "https://github.com/SverrirValgeirsson/rustyplan",
  "tools": [
    {
      "name": "create_event",
      "description": "Create a new scheduling event",
      "inputSchema": {
        "properties": {
          "description": {
            "description": "Optional event description",
            "type": "string"
          },
          "duration_minutes": {
            "description": "Duration in minutes",
            "type": "integer"
          },
          "name": {
            "description": "Event name",
            "type": "string"
          },
          "participants": {
            "description": "Participant names",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "participants_can_add_participants": {
            "description": "Whether participants may add other participants (default false)",
            "type": "boolean"
          },
          "participants_can_add_timeslots": {
            "description": "Whether participants may add time slots (default false)",
            "type": "boolean"
          },
          "proposed_start": {
            "description": "Proposed start time (ISO 8601)",
            "type": "string"
          }
        },
        "required": [
          "name",
          "duration_minutes"
        ],
        "type": "object"
      }
    },
    {
      "name": "get_event",
      "description": "Get details of an event, including per-time-option vote tallies and who voted. Pass share_token to also get your own vote per option.",
      "inputSchema": {
        "properties": {
          "event_id": {
            "description": "Event ID",
            "type": "string"
          },
          "share_token": {
            "description": "Optional: the caller's participant share token, to include your_response per time option.",
            "type": "string"
          }
        },
        "required": [
          "event_id"
        ],
        "type": "object"
      }
    },
    {
      "name": "list_events",
      "description": "List events for a user",
      "inputSchema": {
        "properties": {
          "user_id": {
            "description": "User ID (optional)",
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      }
    },
    {
      "name": "add_time_option",
      "description": "Add a time option to an event",
      "inputSchema": {
        "properties": {
          "duration_minutes": {
            "description": "Duration in minutes (optional)",
            "type": "integer"
          },
          "event_id": {
            "description": "Event ID",
            "type": "string"
          },
          "owner_token": {
            "description": "Organizer owner token (alternative to share_token)",
            "type": "string"
          },
          "share_token": {
            "description": "Participant share token (or use owner_token for the organizer)",
            "type": "string"
          },
          "start_time": {
            "description": "Proposed start time (ISO 8601)",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "start_time"
        ],
        "type": "object"
      }
    },
    {
      "name": "vote_time_option",
      "description": "Vote yes/no/maybe on a proposed meeting time. Organizers use owner_token; other voters use share_token.",
      "inputSchema": {
        "properties": {
          "owner_token": {
            "description": "Organizer owner token (alternative to share_token)",
            "type": "string"
          },
          "response": {
            "description": "Response: 'yes', 'no', or 'maybe'",
            "type": "string"
          },
          "share_token": {
            "description": "The voter's participant share token",
            "type": "string"
          },
          "time_option_id": {
            "description": "Time option ID to vote on",
            "type": "string"
          }
        },
        "required": [
          "time_option_id",
          "response"
        ],
        "type": "object"
      }
    },
    {
      "name": "get_summary",
      "description": "Get a summary of event availability with per-time-option breakdown and your own votes. Pass share_token for per-option your_response.",
      "inputSchema": {
        "properties": {
          "event_id": {
            "description": "Event ID",
            "type": "string"
          },
          "share_token": {
            "description": "Optional: the caller's participant share token.",
            "type": "string"
          }
        },
        "required": [
          "event_id"
        ],
        "type": "object"
      }
    },
    {
      "name": "add_participant",
      "description": "Add a participant to an existing event",
      "inputSchema": {
        "properties": {
          "email": {
            "description": "Optional participant email",
            "type": "string"
          },
          "event_id": {
            "description": "Event ID",
            "type": "string"
          },
          "name": {
            "description": "Participant name",
            "type": "string"
          },
          "owner_token": {
            "description": "Event owner token (for authorization)",
            "type": "string"
          },
          "share_token": {
            "description": "Participant share token (alternative authorization)",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "name"
        ],
        "type": "object"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.SverrirValgeirsson/rustyplan",
    "version": "0.1.0",
    "remoteUrl": "https://rustyplan.nerdur.com/mcp",
    "publishedAt": "2026-11-21T22:33:37.062074Z",
    "fetchedAt": "2026-11-22T12:49:37.224Z",
    "toolsSha256": "97d09375529dd5aa9b282bb16c4edf5d6ddfc653014a37bdc98ad741ea3ed12c"
  }
}
