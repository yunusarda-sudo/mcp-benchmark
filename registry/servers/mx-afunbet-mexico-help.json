{
  "$schema": "../schema.json",
  "name": "mx.afunbet/mexico-help",
  "title": "Afun Bet México Help",
  "category": "Design, UI & 3D Media",
  "description": "Read-only Mexico guides: app installation, account access, SPEI/OXXO, and game rules in ES/EN.",
  "tools": [
    {
      "name": "search_guides",
      "description": "Search cited Afun Bet Mexico guides by a general issue. Returns source excerpts or no_match. Do not include personal account or payment data.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 240
          },
          "locale": {
            "default": "es-MX",
            "description": "Both languages serve Mexico; Spanish is the default.",
            "type": "string",
            "enum": [
              "es-MX",
              "en-MX"
            ]
          },
          "limit": {
            "default": 4,
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "installation_help",
      "description": "Find device-specific instructions for Android APK, browser PWA, iPhone or desktop. Distinguishes missing install buttons, update conflicts, checksum checks and offline limits. Does not fetch or execute installers.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "device": {
            "type": "string",
            "enum": [
              "android",
              "iphone",
              "windows",
              "macos",
              "linux"
            ]
          },
          "issue": {
            "default": "choose-route",
            "type": "string",
            "enum": [
              "choose-route",
              "install-option-missing",
              "apk-not-installed",
              "update-conflict",
              "verify-download",
              "offline"
            ]
          },
          "locale": {
            "default": "es-MX",
            "description": "Both languages serve Mexico; Spanish is the default.",
            "type": "string",
            "enum": [
              "es-MX",
              "en-MX"
            ]
          }
        },
        "required": [
          "device"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "account_payment_help",
      "description": "Look up published next checks for sign-in, lost phone, recovery codes, SPEI/OXXO deposits, pending withdrawals and fees. Accepts an issue category only, never account details; cannot see or change a transaction.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "issue": {
            "type": "string",
            "enum": [
              "login",
              "password-recovery",
              "phone-lost",
              "code-not-received",
              "spei-deposit",
              "oxxo-deposit",
              "deposit-missing",
              "withdrawal-pending",
              "withdrawal-fees",
              "account-restriction"
            ]
          },
          "locale": {
            "default": "es-MX",
            "description": "Both languages serve Mexico; Spanish is the default.",
            "type": "string",
            "enum": [
              "es-MX",
              "en-MX"
            ]
          }
        },
        "required": [
          "issue"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "game_rules",
      "description": "Retrieve published rule explanations for slots, roulette, table games, crash or sports. Category coverage is labelled when no dedicated same-language guide exists. Does not predict outcomes or promise winnings.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "enum": [
              "slots",
              "roulette",
              "table-games",
              "crash",
              "sports"
            ]
          },
          "locale": {
            "default": "es-MX",
            "description": "Both languages serve Mexico; Spanish is the default.",
            "type": "string",
            "enum": [
              "es-MX",
              "en-MX"
            ]
          }
        },
        "required": [
          "family"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "mx.afunbet/mexico-help",
    "version": "1.0.0",
    "remoteUrl": "https://afunbet.mx/mcp",
    "publishedAt": "2026-11-24T03:00:05.013495Z",
    "fetchedAt": "2026-11-24T12:15:48.059Z",
    "toolsSha256": "7f6512a017a8b032116eec397e9e99b827a0b24fb0c9073333aa40e2b937398f"
  }
}
