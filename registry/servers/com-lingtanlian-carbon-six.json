{
  "$schema": "../schema.json",
  "name": "com.lingtanlian/carbon-six",
  "title": "碳小六 · AI 原生节能降碳平台",
  "category": "Other",
  "description": "查全国工业节能在建项目线索、算节能率与投资回收期、代企业递需求单。",
  "tools": [
    {
      "name": "platform_info",
      "description": "碳小六 · AI 原生节能降碳平台是什么、能做什么、不能做什么。先调这个再调别的。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "search_leads",
      "description": "查线索墙：全国在建项目的公开信息（暖通、净化、冷库、机房、蒸汽等需求）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "description": "地区关键词，如 河南、山东、郑州"
          },
          "sector": {
            "type": "string",
            "description": "类别关键词，如 实验室洁净、医院、化工"
          },
          "stage": {
            "type": "string",
            "description": "阶段：投标中 / 报名中 / 计划期 / 前期"
          },
          "q": {
            "type": "string",
            "description": "自由词"
          },
          "limit": {
            "type": "integer",
            "description": "返回条数，1-50，默认 20"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "estimate_saving",
      "description": "节能快算：给定行业与年能源支出，返回按回收期排序的措施清单与区间。不构成保证。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "industry": {
            "type": "string",
            "description": "行业键或名称，如 chem、化工"
          },
          "fee": {
            "type": "number",
            "description": "年能源支出，单位万元"
          }
        },
        "required": [
          "industry"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "submit_inquiry",
      "description": "替客户递一单：必须带单位、需求、真实联系方式，并且必须先获得当事人同意（consent=true）。进信箱后人工核验，平台不承诺结果。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "org": {
            "type": "string",
            "description": "单位名称"
          },
          "need": {
            "type": "string",
            "description": "要解决的事，写清现场与目标"
          },
          "contact": {
            "type": "string",
            "description": "手机号或微信号"
          },
          "region": {
            "type": "string"
          },
          "sector": {
            "type": "string"
          },
          "member": {
            "type": "string",
            "description": "常务 / 会员 / 访客"
          },
          "consent": {
            "type": "boolean",
            "description": "必填且必须为 true：已当面或书面获得当事人同意，由其指定你代为提交。没有同意就不要调用本工具。"
          }
        },
        "required": [
          "org",
          "need",
          "contact",
          "consent"
        ],
        "additionalProperties": false
      }
    }
  ],
