{
  "$schema": "../schema.json",
  "name": "es.h1756.mcp/h1756-mcp",
  "title": "h1756.es — Datos financieros y regulatorios oficiales de España",
  "category": "Other",
  "description": "Servidor MCP público de solo lectura con datos financieros y regulatorios oficiales de España.",
  "tools": [
    {
      "name": "list_sources",
      "description": "Lista las fuentes oficiales conectadas en config/sources.yaml, su estado actual (ok/unavailable) y su fecha data_as_of.",
      "inputSchema": {
        "properties": {},
        "type": "object",
        "title": "list_sourcesArguments",
        "additionalProperties": false
      }
    },
    {
      "name": "resolve_entity",
      "description": "Busca entidades e instrumentos candidatos en isin-es a partir de un nombre, ISIN o LEI (límite por defecto 5, máximo 10; salida <= 16 KB).",
      "inputSchema": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "limit": {
            "default": 5,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "type": "object",
        "title": "resolve_entityArguments",
        "additionalProperties": false
      }
    },
    {
      "name": "instrument_dossier",
      "description": "Ficha de un instrumento financiero por código ISIN (FIRDS, FITRS aplicable, ANCV, colateral BCE y listings acotados; preserva not_in_sources; <= 24 KB).",
      "inputSchema": {
        "properties": {
          "isin": {
            "title": "Isin",
            "type": "string",
            "pattern": "^[A-Za-z0-9]{12}$",
            "minLength": 12,
            "maxLength": 12
          }
        },
        "required": [
          "isin"
        ],
        "type": "object",
        "title": "instrument_dossierArguments",
        "additionalProperties": false
      }
    },
    {
      "name": "entity_risk_profile",
      "description": "Perfil cruzado en paralelo por código LEI (20 caracteres): estructura GLEIF e instrumentos, posiciones cortas netas CNMV con snapshot_sha256 y reclamaciones oficiales BdE/CNMV/DGSFP (tope duro <= 32 KB).",
      "inputSchema": {
        "properties": {
          "lei": {
            "title": "Lei",
            "type": "string",
            "pattern": "^[A-Za-z0-9]{20}$",
            "minLength": 20,
            "maxLength": 20
          }
        },
        "required": [
          "lei"
        ],
        "type": "object",
        "title": "entity_risk_profileArguments",
        "additionalProperties": false
      }
    },
    {
      "name": "search_sanctions",
      "description": "Busca sanciones públicas exclusivamente sobre empresas (subject_type=entity forzado; nunca personas físicas). Solo compara la consulta contra la identidad de la entidad (`subject_name_raw` normalizado, `entity_slug`, ISIN o LEI), nunca contra el texto libre de la sanción, y no devuelve campos `*_raw` de texto libre: usa `source_url` y `source_document_url` para el texto oficial completo. Filtros opcionales: authority, severity, year, limit (defecto 10, máx 20; salida <= 24 KB).",
      "inputSchema": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "authority": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Authority"
          },
          "severity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Severity"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Year"
          },
          "limit": {
            "default": 10,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "type": "object",
        "title": "search_sanctionsArguments",
        "additionalProperties": false
      }
    },
    {
      "name": "due_diligence_guide",
      "description": "Guía estructurada en español con reglas de citación oficial, límites de interpretación y flujo recomendado de verificación (<= 8 KB).",
      "inputSchema": {
        "properties": {},
        "type": "object",
        "title": "due_diligence_guideArguments",
        "additionalProperties": false
      }
    },
    {
      "name": "report_gap",
      "description": "Registra de forma totalmente anónima (solo valores enumerados cerrados, sin texto libre ni IPs) qué herramienta, motivo o fuente falló o faltó.",
      "inputSchema": {
        "properties": {
          "tool": {
            "enum": [
              "list_sources",
              "resolve_entity",
              "instrument_dossier",
              "entity_risk_profile",
              "search_sanctions",
              "due_diligence_guide",
              "other"
            ],
            "title": "Tool",
            "type": "string"
          },
          "reason": {
            "enum": [
              "missing_entity",
              "missing_isin",
              "missing_lei",
              "source_unavailable",
              "truncated_data",
              "stale_data",
              "format_error",
              "other"
            ],
            "title": "Reason",
            "type": "string"
          },
          "source": {
            "anyOf": [
              {
                "enum": [
                  "isin-es",
                  "shorts",
                  "reclamometro",
                  "sanciones",
                  "unknown"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source"
          }
        },
        "required": [
          "tool",
          "reason"
        ],
        "type": "object",
        "title": "report_gapArguments",
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "es.h1756.mcp/h1756-mcp",
    "version": "1.0.1",
