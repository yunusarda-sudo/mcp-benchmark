{
  "$schema": "../schema.json",
  "name": "com.syntheticm2m.used-car-sold-prices/soldboard",
  "title": "Soldboard",
  "category": "E-Commerce & Retail",
  "description": "Real used-car sold prices and used-car loan rates by credit score band. Read-only, no sign-in.",
  "tools": [
    {
      "name": "price_check",
      "description": "What a used car of this year, make and model really sold for. Use it for questions like 'how much is my 2019 Civic worth', 'what is it valued at' or 'what does it go for'. Shows the range most sold in, the middle price, number of sales and recent trend. Pass asking_price to see where that price sits among real sales. No mileage, trim or condition.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 1981,
            "maximum": 2027,
            "description": "Model year, 1981 to 2027."
          },
          "make": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "Make, e.g. Toyota, Chevy, VW."
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Model, e.g. RAV4, CR-V, F-150."
          },
          "asking_price": {
            "description": "Optional asking price in US dollars. Adds where it sits among real sales.",
            "type": "number",
            "minimum": 500,
            "maximum": 300000
          },
          "state": {
            "description": "Optional US state (2-letter code or full name). Uses sales in that state when there are enough.",
            "type": "string",
            "minLength": 2,
            "maxLength": 30
          }
        },
        "required": [
          "year",
          "make",
          "model"
        ]
      }
    },
    {
      "name": "compare_cars",
      "description": "Compare real sold prices of two used cars side by side, with the gap between their middle prices.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "a": {
            "type": "object",
            "properties": {
              "year": {
                "type": "integer",
                "minimum": 1981,
                "maximum": 2027,
                "description": "Model year, 1981 to 2027."
              },
              "make": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "Make, e.g. Toyota, Chevy, VW."
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "description": "Model, e.g. RAV4, CR-V, F-150."
              }
            },
            "required": [
              "year",
              "make",
              "model"
            ]
          },
          "b": {
            "type": "object",
            "properties": {
              "year": {
                "type": "integer",
                "minimum": 1981,
                "maximum": 2027,
                "description": "Model year, 1981 to 2027."
              },
              "make": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "Make, e.g. Toyota, Chevy, VW."
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "description": "Model, e.g. RAV4, CR-V, F-150."
              }
            },
            "required": [
              "year",
              "make",
              "model"
            ]
          }
        },
        "required": [
          "a",
          "b"
        ]
      }
    },
    {
      "name": "year_ladder",
      "description": "Real sold prices of one model across every model year with enough sales, oldest first, with the change in middle price from one year to the next.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "make": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "Make, e.g. Toyota."
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Model, e.g. RAV4."
          }
        },
        "required": [
          "make",
          "model"
        ]
      }
    },
    {
      "name": "budget_search",
      "description": "Models whose middle sold price is at or under a budget: the newest and most-sold ones, one row per model. Optional body group, oldest year and make.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "max_price": {
            "type": "number",
            "minimum": 2000,
            "maximum": 250000,
            "description": "Highest middle sold price in US dollars."
          },
          "type": {
            "description": "Optional body group. Default any.",
            "type": "string",
            "enum": [
              "car",
              "truck",
              "suv",
              "any"
            ]
          },
          "min_year": {
            "description": "Optional oldest model year.",
            "type": "integer",
            "minimum": 1990,
            "maximum": 2027
          },
          "make": {
            "description": "Optional make, e.g. Honda.",
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "required": [
          "max_price"
        ]
      }
    },
    {
      "name": "rate_check",
      "description": "Typical interest rates on real used-car loans for a credit score band, optionally for a loan length. Pass offered_apr to see where a rate sits among those loans. Not advice.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "credit_score": {
            "type": "integer",
            "minimum": 300,
            "maximum": 850,
            "description": "Credit score, 300 to 850."
          },
          "term_months": {
            "description": "Optional loan length in months.",
            "type": "integer",
            "minimum": 12,
            "maximum": 96
          },
          "offered_apr": {
            "description": "Optional APR percent you were offered, e.g. 7.9.",
            "type": "number",
            "minimum": 0,
            "maximum": 40
          }
        },
        "required": [
          "credit_score"
        ]
      }
    },
    {
      "name": "find_model",
      "description": "List model names (with the years that have sales) for a make, optionally filtered by part of a name. Use it to fix spelling before price_check.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "make": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "Make, e.g. Toyota."
          },
          "query": {
            "description": "Optional part of a model name.",
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "required": [
          "make"
        ]
      }
    },
    {
      "name": "quote_check",
      "description": "Check a whole used-car dealer quote in one call. Give the car (year, make, model), the quoted price, and the loan APR, term in months and credit score. Returns where the price sits among real sales of that car, where the rate sits among real loans for that credit score band, and what the interest costs at the quoted rate versus the middle rate. Optional state, down_payment or loan_amount. No mileage, trim or condition. Not advice.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 1981,
            "maximum": 2027,
            "description": "Model year, 1981 to 2027."
          },
          "make": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "Make, e.g. Toyota, Chevy, VW."
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Model, e.g. RAV4, CR-V, F-150."
          },
          "state": {
            "description": "Optional US state (2-letter code or full name). Uses sales in that state when there are enough.",
            "type": "string",
            "minLength": 2,
            "maxLength": 30
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 500000,
            "description": "The car price the dealer quoted, in US dollars."
          },
          "apr": {
            "type": "number",
            "minimum": 0,
            "maximum": 40,
            "description": "The APR percent in the quote, e.g. 9.9."
          },
          "term_months": {
            "type": "integer",
            "minimum": 12,
            "maximum": 96,
            "description": "Loan length in months in the quote."
          },
          "credit_score": {
            "type": "integer",
            "minimum": 300,
            "maximum": 850,
            "description": "Credit score, 300 to 850."
          },
          "down_payment": {
            "description": "Optional down payment in US dollars. Loan amount is price minus this.",
            "type": "number",
            "minimum": 0
          },
          "loan_amount": {
            "description": "Optional loan amount in US dollars. Wins over down_payment.",
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "year",
          "make",
          "model",
          "price",
          "apr",
          "term_months",
          "credit_score"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.syntheticm2m.used-car-sold-prices/soldboard",
    "version": "1.0.0",
