{
  "$schema": "../schema.json",
  "name": "io.github.oscilabs/charitysense",
  "title": "CharitySense Nonprofit Research",
  "category": "Developer Tools & DevOps",
  "description": "Research U.S. nonprofits: IRS filings, financials, governance, grants, ratings and cited evidence.",
  "tools": [
    {
      "name": "search_nonprofits",
      "description": "Find nonprofits. Use Identity for a named organization or EIN and Discovery for a cause or mission. State refers to headquarters. Explicit metric sorts in Discovery rank indexed name/classification matches; inspect MatchScope before claiming population coverage.",
      "inputSchema": {
        "properties": {
          "query": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "mode": {
            "default": "Identity",
            "enum": [
              "Identity",
              "Discovery"
            ],
            "title": "Mode",
            "type": "string"
          },
          "state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "State"
          },
          "cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cause"
          },
          "min_revenue": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Min Revenue"
          },
          "sort": {
            "default": "Relevance",
            "enum": [
              "Relevance",
              "Revenue",
              "Assets",
              "Recent"
            ],
            "title": "Sort",
            "type": "string"
          },
          "primary_form": {
            "anyOf": [
              {
                "enum": [
                  "990",
                  "990EZ",
                  "990N",
                  "990PF",
                  "990T"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Primary Form"
          },
          "entity_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Entity Type"
          },
          "evidence_tier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Evidence Tier"
          },
          "cursor": {
            "default": 1,
            "minimum": 1,
            "title": "Cursor",
            "type": "integer"
          },
          "limit": {
            "default": 10,
            "maximum": 50,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "title": "search_nonprofitsArguments",
        "type": "object"
      }
    },
    {
      "name": "ask_research_assistant",
      "description": "Ask the public AI research assistant for 100 credits from the shared daily allowance. No key required. The question is sent to the configured AI provider; results may be incomplete.",
      "inputSchema": {
        "properties": {
          "question": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "ein": {
            "anyOf": [
              {
                "pattern": "^[0-9]{9}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ein"
          }
        },
        "required": [
          "question"
        ],
        "title": "ask_research_assistantArguments",
        "type": "object"
      }
    },
    {
      "name": "start_research",
      "description": "Start public durable AI research for 100 credits. No key required; internal reads are included. Reuse the idempotency key for a free retry; polling and cancellation are free. Retain data.ResearchID and private data.AccessToken; pass both to polling or cancellation even if your client IP changes. Read data.Status for the job state; outer status describes the tool call.",
      "inputSchema": {
        "properties": {
          "question": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "idempotency_key": {
            "pattern": "^[A-Za-z0-9._-]{1,128}$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "ein": {
            "anyOf": [
              {
                "pattern": "^[0-9]{9}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ein"
          }
        },
        "required": [
          "question",
          "idempotency_key"
        ],
        "title": "start_researchArguments",
        "type": "object"
      }
    },
    {
      "name": "get_research",
      "description": "Get the current status or result of your research job. Pass the exact ResearchID and private AccessToken returned by start_research; polling without a token requires the original client identity. Read data.Status for the job state; outer status describes the tool call. Polling is free.",
      "inputSchema": {
        "properties": {
          "research_id": {
            "pattern": "^res_[0-9a-f]{64}$",
            "title": "Research Id",
            "type": "string"
          },
          "access_token": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Private AccessToken returned by start_research; retain and supply on every poll to survive client IP changes.",
            "title": "Access Token"
          }
        },
        "required": [
          "research_id"
        ],
        "title": "get_researchArguments",
        "type": "object"
      }
    },
    {
      "name": "cancel_research",
      "description": "Request cancellation of your research job. Pass the exact ResearchID and private AccessToken returned by start_research; without a token the original client identity is required. Read data.Status for the job state; outer status describes the tool call. A running provider request may already have incurred cost.",
      "inputSchema": {
        "properties": {
          "research_id": {
            "pattern": "^res_[0-9a-f]{64}$",
            "title": "Research Id",
            "type": "string"
          },
          "access_token": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Private AccessToken returned by start_research; authorizes cancellation of this job only.",
            "title": "Access Token"
          }
        },
        "required": [
          "research_id"
        ],
        "title": "cancel_researchArguments",
        "type": "object"
      }
    },
    {
      "name": "get_nonprofit",
      "description": "Get a nonprofit's selected profile and its available section manifest.",
      "inputSchema": {
        "properties": {
          "ein": {
            "pattern": "^[0-9]{9}$",
            "title": "Ein",
            "type": "string"
          },
          "form": {
            "anyOf": [
              {
                "enum": [
                  "990",
                  "990EZ",
                  "990N",
                  "990PF",
                  "990T"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Form"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Year"
          }
        },
        "required": [
          "ein"
        ],
        "title": "get_nonprofitArguments",
        "type": "object"
      }
    },
    {
      "name": "get_rating_methodology",
      "description": "Explain the active rating policy for a filing form. Use the nonprofit profile for its actual score and evidence.",
      "inputSchema": {
        "properties": {
          "form": {
            "enum": [
              "990",
              "990EZ",
              "990N",
              "990PF",
              "990T"
            ],
            "title": "Form",
            "type": "string"
          }
        },
        "required": [
          "form"
        ],
        "title": "get_rating_methodologyArguments",
        "type": "object"
      }
    },
    {
      "name": "get_nonprofit_section",
      "description": "Get one section and its original evidence. Use section IDs and evidence references returned by CharitySense.",
      "inputSchema": {
        "properties": {
          "ein": {
            "pattern": "^[0-9]{9}$",
            "title": "Ein",
            "type": "string"
          },
          "section_id": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Section Id",
            "type": "string"
          },
          "form": {
            "anyOf": [
              {
                "enum": [
                  "990",
                  "990EZ",
                  "990N",
                  "990PF",
                  "990T"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Form"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Year"
          },
          "cursor": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          },
          "limit": {
            "default": 50,
            "maximum": 200,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "evidence_ref": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Evidence Ref"
          },
          "evidence_token": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Evidence Token"
          }
        },
        "required": [
          "ein",
          "section_id"
        ],
        "title": "get_nonprofit_sectionArguments",
        "type": "object"
      }
    },
    {
      "name": "list_nonprofit_filings",
      "description": "List available filings for the selected form.",
      "inputSchema": {
        "properties": {
          "ein": {
            "pattern": "^[0-9]{9}$",
            "title": "Ein",
            "type": "string"
          },
          "form": {
            "anyOf": [
              {
                "enum": [
                  "990",
                  "990EZ",
                  "990N",
                  "990PF",
                  "990T"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Form"
          },
          "cursor": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          },
          "limit": {
            "default": 25,
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "ein"
        ],
        "title": "list_nonprofit_filingsArguments",
        "type": "object"
      }
    },
    {
      "name": "review_nonprofit",
      "description": "Assemble a bounded deterministic review; pass the continuation cursor to resume.",
      "inputSchema": {
        "properties": {
          "ein": {
            "pattern": "^[0-9]{9}$",
            "title": "Ein",
            "type": "string"
          },
          "purpose": {
            "enum": [
              "donor",
              "grantmaker"
            ],
            "title": "Purpose",
            "type": "string"
          },
          "depth": {
            "default": "standard",
            "enum": [
              "brief",
              "standard",
              "detailed"
            ],
            "title": "Depth",
            "type": "string"
          },
          "form": {
            "anyOf": [
              {
                "enum": [
                  "990",
                  "990EZ",
                  "990N",
                  "990PF",
                  "990T"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Form"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Year"
          },
          "cursor": {
            "anyOf": [
              {
                "maxLength": 16384,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          },
          "detail": {
            "default": "compact",
            "enum": [
              "compact",
              "full"
            ],
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "ein",
          "purpose"
        ],
        "title": "review_nonprofitArguments",
        "type": "object"
      }
    },
    {
      "name": "review_donation",
      "description": "Assemble donor evidence for a proposed gift. Ask for useful missing context; never invent it.\n\n    Values in decision_context are donor-provided. Current websites, registries and gift acceptance are not verified by this tool.\n    Repeat identical decision_context when following a continuation cursor.\n    ",
      "inputSchema": {
        "$defs": {
          "DonationContext": {
            "additionalProperties": false,
            "description": "Donor-provided decision details; these are not verified charity facts.",
            "properties": {
              "gift_type": {
                "anyOf": [
                  {
                    "enum": [
                      "cash",
                      "in_kind",
                      "other"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Form of the proposed gift, if known.",
                "title": "Gift Type"
              },
              "gift_description": {
                "anyOf": [
                  {
                    "maxLength": 1000,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "What the donor plans to give, including quantity or intended beneficiaries when known.",
                "title": "Gift Description"
              },
              "estimated_value": {
                "anyOf": [
                  {
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Donor's estimated gift value, not an independently verified valuation.",
                "title": "Estimated Value"
              },
              "currency": {
                "anyOf": [
                  {
                    "pattern": "^[A-Z]{3}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Three-letter currency code for the estimated value, if known.",
                "title": "Currency"
              },
              "decision_deadline": {
                "anyOf": [
                  {
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Decision date in YYYY-MM-DD format, if known.",
                "title": "Decision Deadline"
              },
              "question": {
                "anyOf": [
                  {
                    "maxLength": 1000,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "The donor's specific question or decision.",
                "title": "Question"
              }
            },
            "title": "DonationContext",
            "type": "object"
          }
        },
        "properties": {
          "ein": {
            "pattern": "^[0-9]{9}$",
            "title": "Ein",
            "type": "string"
          },
          "decision_context": {
            "$ref": "#/$defs/DonationContext"
          },
          "depth": {
            "default": "detailed",
            "enum": [
              "brief",
              "standard",
              "detailed"
            ],
            "title": "Depth",
            "type": "string"
          },
          "form": {
            "anyOf": [
              {
                "enum": [
                  "990",
                  "990EZ",
                  "990N",
                  "990PF",
                  "990T"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Form"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Year"
          },
          "cursor": {
            "anyOf": [
              {
                "maxLength": 16384,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          },
          "detail": {
            "default": "compact",
            "enum": [
              "compact",
              "full"
            ],
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "ein",
          "decision_context"
        ],
        "title": "review_donationArguments",
        "type": "object"
      }
    },
