{
  "$schema": "../schema.json",
  "name": "io.github.ChristopherLaughlin/mcp-us-tariff",
  "title": "US Tariff (USITC HTS)",
  "category": "Developer Tools & DevOps",
  "description": "USITC HTS lookup, base duty and Chapter 99 provisions. Pay per call in USDC (x402) or Pro key.",
  "repository": "https://github.com/ChristopherLaughlin/factory-mcp-docs",
  "tools": [
    {
      "name": "lookup_hts_code",
      "description": "Search the official USITC Harmonized Tariff Schedule by keyword or HTS number. Returns codes with general, special and column 2 rates.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "limit": {
            "default": 25,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "calculate_import_duty",
      "description": "Base HTS duty for an 8/10-digit code, ISO-2 country of origin and customs value. Applies Column 2 for CU/KP/RU/BY and FTA special rates where the HTS lists the country's program. Ad valorem rates only; Chapter 99 additional duties are not included.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "hts_code": {
            "type": "string",
            "minLength": 8,
            "maxLength": 14
          },
          "country_of_origin": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "customs_value_usd": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000000000
          }
        },
        "required": [
          "hts_code",
          "country_of_origin",
          "customs_value_usd"
        ]
      }
    },
    {
      "name": "lookup_chapter99_duties",
      "description": "Official HTS Chapter 99 provisions (Section 301, 232, IEEPA and other additional duties) from the USITC schedule, filtered by country_of_origin (ISO-2), keyword, heading prefix (e.g. 9903.88) and/or an HTS code's footnote references. Returns the published rate text and, only when unambiguous, the extra ad valorem percent. Lists candidates; does not determine applicability.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "hts_code": {
            "description": "8/10-digit HTS code; adds its footnote-referenced 9903 headings",
            "type": "string",
            "minLength": 8,
            "maxLength": 14
          },
          "country_of_origin": {
            "description": "ISO 3166-1 alpha-2, e.g. CN",
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "query": {
            "description": "Keywords matched against provision descriptions",
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "heading_prefix": {
            "description": "e.g. 9903.88 (Section 301 China lists)",
            "type": "string",
            "minLength": 4,
            "maxLength": 10
          },
          "limit": {
            "default": 25,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.ChristopherLaughlin/mcp-us-tariff",
    "version": "0.1.1",
    "remoteUrl": "https://mcp-us-tariff.scorematic.workers.dev/mcp",
    "publishedAt": "2026-11-26T06:16:18.138601Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "c87a1eeb90a2b0435185dfd48e444f4b03be9b76fa0e30d774407c67ece2c5b8"
  }
}
