{
  "$schema": "../schema.json",
  "name": "LaunchDarkly MCP",
  "category": "Observability & Analytics",
  "description": "LaunchDarkly MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "evaluate_flag",
      "description": "Evaluate LaunchDarkly targeting rules and return flag value for user context.",
      "inputSchema": {
        "type": "object",
        "required": [
          "projectKey",
          "flagKey",
          "userKey"
        ],
        "properties": {
          "projectKey": {
            "type": "string",
            "description": "Project key."
          },
          "flagKey": {
            "type": "string",
            "description": "Feature flag key."
          },
          "userKey": {
            "type": "string",
            "description": "User context key."
          }
        }
      }
    }
  ]
}
