{
  "$schema": "../schema.json",
  "name": "ae.genosys/genosys",
  "title": "GENOSYS UAE",
  "category": "Communication & Alerting",
  "description": "Shop GENOSYS Korean skincare in the UAE from chat: find products, AED prices, order and pay.",
  "tools": [
    {
      "name": "search_products",
      "description": "Search the live GENOSYS UAE catalog (Korean professional skincare, haircare, devices, beauty boxes). Use for any \"what do you have for...\" question. Accepts plain language in English, Russian or Arabic, plus optional filters. Returns name, price in AED (VAT included), size, stock, concerns and the product link.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "description": "What the shopper wants, e.g. \"serum for dry skin\", \"SPF cushion\", \"hair loss shampoo\".",
            "type": "string",
            "maxLength": 200
          },
          "category": {
            "description": "Category filter, e.g. Serum, Cream, Mask, Cleanser, Toner/Mist, Sun, Cushion BB, Eye care, Scalp/Hair, Beauty Boxes, Device, Microneedling, PRO Solution. Call list_categories for the full list.",
            "type": "string",
            "maxLength": 60
          },
          "concern": {
            "description": "Skin concern, e.g. hydration, anti-aging, sensitivity, pore-care, brightening, acne-blemishes, eye-care, hair-loss, sun-protection.",
            "type": "string",
            "maxLength": 60
          },
          "skin_type": {
            "type": "string",
            "enum": [
              "dry",
              "oily",
              "combination",
              "normal",
              "sensitive",
              "mature"
            ]
          },
          "max_price_aed": {
            "description": "Only products at or below this price (AED, VAT included).",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "in_stock_only": {
            "type": "boolean"
          },
          "limit": {
            "description": "Default 8.",
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "locale": {
            "description": "Language of descriptions and links: en (default), ru or ar. Product names stay in English.",
            "type": "string",
            "enum": [
              "en",
              "ru",
              "ar"
            ]
          }
        }
      }
    },
    {
      "name": "get_product",
      "description": "Full details for one product: description, key features, benefits, key ingredients and actives, step-by-step how to use, sizes or shades with prices, and an add-to-bag link. Use the id from search_products (e.g. \"18\" or \"68\").",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Product id from search_products, e.g. \"18\"."
          },
          "locale": {
            "description": "Language of descriptions and links: en (default), ru or ar. Product names stay in English.",
            "type": "string",
            "enum": [
              "en",
              "ru",
              "ar"
            ]
          }
        },
        "required": [
          "product_id"
        ]
      }
    },
    {
      "name": "recommend_routine",
      "description": "Ranked product picks for a shopper's skin type and concerns, the same scoring as the skin quiz on genosys.ae. Use when someone describes their skin and asks what to use.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "skin_type": {
            "type": "string",
            "enum": [
              "dry",
              "oily",
              "combination",
              "normal",
              "sensitive"
            ]
          },
          "concerns": {
            "description": "e.g. [\"hydration\",\"anti-aging\"]. Tags: hydration, anti-aging, sensitivity, pore-care, brightening, acne-blemishes, eye-care, hair, hair-loss.",
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "age_group": {
            "type": "string",
            "enum": [
              "teen",
              "young-adult",
              "adult",
              "mature"
            ]
          },
          "at_home_only": {
            "description": "True (default) leaves out professional clinic-only products.",
            "type": "boolean"
          },
          "limit": {
            "description": "Default 6.",
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "locale": {
            "description": "Language of descriptions and links: en (default), ru or ar. Product names stay in English.",
            "type": "string",
            "enum": [
              "en",
              "ru",
              "ar"
            ]
          }
        }
      }
    },
    {
      "name": "list_categories",
      "description": "All product categories and skin concerns in the live catalog, with product counts. Use to orient before searching.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "create_bag_link",
      "description": "Build one link that opens genosys.ae with these items already in the shopper's bag, ready to check out. Use when the shopper decides to buy. Products with sizes or shades (see get_product options) need one picked: pass size, or color as its label or value (e.g. \"#01 Bright\").",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "items": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "product_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "size": {
                  "type": "string",
                  "maxLength": 40
                },
                "color": {
                  "type": "string",
                  "maxLength": 60
                }
              },
              "required": [
                "product_id"
              ]
            }
          }
        },
        "required": [
          "items"
        ]
      }
    },
    {
      "name": "open_checkout",
      "description": "Show the shopper a checkout form for these items: shade picker where needed, quantities, delivery details (name, email, phone, emirate, address), live total and a button that creates the order and opens secure Stripe payment. Use when the shopper wants to buy. Pass any details the shopper already gave as prefill.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "items": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "product_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "size": {
                  "type": "string",
                  "maxLength": 40
                },
                "color": {
                  "type": "string",
                  "maxLength": 60
                }
              },
              "required": [
                "product_id"
              ]
            }
          },
          "prefill": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 100
              },
              "email": {
                "type": "string",
                "maxLength": 200
              },
              "phone": {
                "type": "string",
                "maxLength": 30
              },
              "emirate": {
                "type": "string",
                "enum": [
                  "Dubai",
                  "Abu Dhabi",
                  "Sharjah",
                  "Ajman",
                  "Ras Al Khaimah",
                  "Fujairah",
                  "Umm Al Quwain"
                ]
              },
              "address": {
                "type": "string",
                "maxLength": 500
              },
              "notes": {
                "type": "string",
                "maxLength": 1000
              }
            }
          },
          "locale": {
            "description": "Language of descriptions and links: en (default), ru or ar. Product names stay in English.",
            "type": "string",
            "enum": [
              "en",
              "ru",
              "ar"
            ]
          }
        },
        "required": [
          "items"
        ]
      }
    },
    {
      "name": "place_order",
      "description": "Create a GENOSYS UAE order from this chat and get a secure Stripe payment link (card, Apple Pay, Google Pay). Call only after the shopper has confirmed the items, the total and their delivery details. The order is confirmed by email once paid; unpaid orders are not shipped. Delivery is UAE only. Prices are retail AED including VAT.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "items": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "product_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "description": "Id from search_products / get_product."
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "size": {
                  "type": "string",
                  "maxLength": 40
                },
                "color": {
                  "description": "Shade label or value, e.g. \"#01 Bright\".",
                  "type": "string",
                  "maxLength": 60
                }
              },
              "required": [
                "product_id"
              ]
            }
          },
          "customer": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2,
                "maxLength": 100,
                "description": "Full name of the person receiving the order."
              },
              "email": {
                "type": "string",
                "maxLength": 200,
                "format": "email",
                "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                "description": "Receipt and order updates go here. If it matches a GENOSYS account, the order appears in that account."
              },
              "phone": {
                "type": "string",
                "minLength": 7,
                "maxLength": 30,
                "description": "For the courier: UAE number or one with its country code."
              },
              "emirate": {
                "type": "string",
                "enum": [
                  "Dubai",
                  "Abu Dhabi",
                  "Sharjah",
                  "Ajman",
                  "Ras Al Khaimah",
                  "Fujairah",
                  "Umm Al Quwain"
                ]
              },
              "address": {
                "type": "string",
                "minLength": 8,
                "maxLength": 500,
                "description": "Building or villa, street, area, and apartment number."
              }
            },
            "required": [
              "name",
              "email",
              "phone",
              "emirate",
              "address"
            ]
          },
          "notes": {
            "description": "Delivery notes, e.g. preferred time.",
            "type": "string",
            "maxLength": 1000
          },
          "locale": {
            "description": "Language of descriptions and links: en (default), ru or ar. Product names stay in English.",
            "type": "string",
            "enum": [
              "en",
              "ru",
              "ar"
            ]
          }
        },
        "required": [
          "items",
          "customer"
        ]
      }
    },
    {
      "name": "order_status",
      "description": "Status and payment of a GENOSYS order. Needs the order number and the email used for the order.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "order_number": {
            "type": "string",
            "minLength": 6,
            "maxLength": 40
          },
          "email": {
            "type": "string",
            "maxLength": 200,
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        },
        "required": [
          "order_number",
          "email"
        ]
      }
    },
    {
      "name": "store_info",
      "description": "Delivery areas, times and fees, payment methods, returns, contact (WhatsApp, email), apps and policies for GENOSYS UAE.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "locale": {
            "description": "Language of descriptions and links: en (default), ru or ar. Product names stay in English.",
            "type": "string",
            "enum": [
              "en",
              "ru",
              "ar"
            ]
          }
        }
      }
    },
    {
      "name": "search",
      "description": "Search GENOSYS products and skincare articles. Returns ids to pass to fetch. (\"product:<id>\" for products, \"blog:<slug>\" for articles.)",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "fetch",
      "description": "Full text of a result from search, by id (\"product:18\" or \"blog:<slug>\").",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "id"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "ae.genosys/genosys",
