{
  "$schema": "../schema.json",
  "name": "systems.phion/evidence-engine",
  "title": "PHION Task Router",
  "category": "AI, LLMs & Agents",
  "description": "Find, authorize and verify the best eligible service for an agent task in one compact MCP journey.",
  "tools": [
    {
      "name": "find_or_quote_task",
      "description": "Start here. Describe the desired result in ordinary language. PHION identifies the exact service, input schema, price ceiling and next call without charging or executing anything.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "constraints": {
            "properties": {
              "allowedAssets": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "allowedNetworks": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "allowedPaymentRails": {
                "items": {
                  "enum": [
                    "x402",
                    "mpp",
                    "api_key",
                    "prepaid"
                  ]
                },
                "type": "array",
                "uniqueItems": true
              },
              "allowedProviders": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "currency": {
                "type": "string"
              },
              "deadlineMs": {
                "minimum": 0,
                "type": "integer"
              },
              "excludedProviders": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "freshnessSeconds": {
                "minimum": 0,
                "type": "integer"
              },
              "jurisdiction": {
                "type": "string"
              },
              "maxPrice": {
                "minimum": 0,
                "type": "number"
              },
              "minimumQuality": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "privacy": {
                "type": "string"
              },
              "requireVerification": {
                "type": "boolean"
              }
            },
            "type": "object"
          },
          "task": {
            "description": "The outcome the agent needs, written naturally; do not translate it into a PHION service name.",
            "maxLength": 2000,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "task"
        ],
        "type": "object"
      }
    },
    {
      "name": "authorize_and_execute_selected_task",
      "description": "After find_or_quote_task selects a service, submit its input, an idempotency key and an explicit maximum atomic-USDC budget. The first call returns payment requirements without execution; an x402-aware client may obtain local approval and retry this identical MCP call with payment metadata. PHION never receives a private key and never expands the stated budget.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "acceptance_criteria": {
            "items": {
              "properties": {
                "equals": {},
                "pointer": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "pointer"
              ],
              "type": "object"
            },
            "maxItems": 32,
            "type": "array"
          },
          "dry_run": {
            "type": "boolean"
          },
          "idempotency_key": {
            "maxLength": 256,
            "minLength": 8,
            "type": "string"
          },
          "input": {
            "type": "object"
          },
          "max_budget_atomic": {
            "pattern": "^[0-9]+$",
            "type": "string"
          },
          "objective": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "target_service": {
            "type": "string"
          }
        },
        "required": [
          "objective",
          "target_service",
          "input",
          "max_budget_atomic",
          "idempotency_key"
        ],
        "type": "object"
      }
    },
    {
      "name": "verify_or_explain_result",
      "description": "Verify a PHION receipt for free, or turn a structured failed status into one safe next action. This tool never charges, retries, or executes a provider.",
      "inputSchema": {
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "receipt"
            ]
          },
          {
            "required": [
              "failure"
            ]
          },
          {
            "required": [
              "statusCode"
            ]
          }
        ],
        "properties": {
          "content": {},
          "failure": {
            "type": "object"
          },
          "receipt": {
            "type": "object"
          },
          "sources": {
            "type": "array"
          },
          "statusCode": {
            "type": "integer"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "find_best_service_for_task",
      "description": "Compatibility alias for find_or_quote_task. Free, advisory and non-executing.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "constraints": {
            "properties": {
              "allowedAssets": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "allowedNetworks": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "allowedPaymentRails": {
                "items": {
                  "enum": [
                    "x402",
                    "mpp",
                    "api_key",
                    "prepaid"
                  ]
                },
                "type": "array",
                "uniqueItems": true
              },
              "allowedProviders": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "currency": {
                "type": "string"
              },
              "deadlineMs": {
                "minimum": 0,
                "type": "integer"
              },
              "excludedProviders": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "freshnessSeconds": {
                "minimum": 0,
                "type": "integer"
              },
              "jurisdiction": {
                "type": "string"
              },
              "maxPrice": {
                "minimum": 0,
                "type": "number"
              },
              "minimumQuality": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "privacy": {
                "type": "string"
              },
              "requireVerification": {
                "type": "boolean"
              }
            },
            "type": "object"
          },
          "task": {
            "description": "The outcome the agent needs, written naturally; do not translate it into a PHION service name.",
            "maxLength": 2000,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "task"
        ],
        "type": "object"
      }
    }
  ],
  "source": {
