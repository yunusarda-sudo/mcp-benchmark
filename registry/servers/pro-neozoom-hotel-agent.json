{
  "$schema": "../schema.json",
  "name": "pro.neozoom/hotel-agent",
  "title": "Hotel Agent Booking",
  "category": "AI, LLMs & Agents",
  "description": "Multi-hotel Bnovo search, private guest sessions and guest-confirmed booking. Pilot access.",
  "tools": [
    {
      "name": "begin_session",
      "description": "Start private trip context. Optional recovery question plus secret phrase (12+ chars), never personal facts.",
      "inputSchema": {
        "properties": {
          "request": {
            "$ref": "#/$defs/Begin"
          }
        },
        "required": [
          "request"
        ],
        "type": "object",
        "$defs": {
          "Begin": {
            "additionalProperties": false,
            "properties": {
              "trip": {
                "$ref": "#/$defs/Trip"
              },
              "recovery_question": {
                "default": "",
                "maxLength": 200,
                "title": "Recovery Question",
                "type": "string"
              },
              "recovery_answer": {
                "default": "",
                "maxLength": 200,
                "title": "Recovery Answer",
                "type": "string"
              }
            },
            "title": "Begin",
            "type": "object"
          },
          "Trip": {
            "additionalProperties": false,
            "properties": {
              "city": {
                "default": "",
                "maxLength": 120,
                "title": "City",
                "type": "string"
              },
              "hotel_query": {
                "default": "",
                "maxLength": 120,
                "title": "Hotel Query",
                "type": "string"
              },
              "checkin": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Checkin"
              },
              "checkout": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Checkout"
              },
              "adults": {
                "anyOf": [
                  {
                    "maximum": 6,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Adults"
              },
              "children_ages": {
                "anyOf": [
                  {
                    "items": {
                      "type": "integer"
                    },
                    "maxItems": 6,
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Children Ages"
              },
              "max_total_rub": {
                "anyOf": [
                  {
                    "maximum": 10000000,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Max Total Rub"
              },
              "requirements": {
                "items": {
                  "type": "string"
                },
                "maxItems": 10,
                "title": "Requirements",
                "type": "array"
              }
            },
            "title": "Trip",
            "type": "object"
          }
        },
        "title": "begin_sessionArguments"
      }
    },
    {
      "name": "get_session",
      "description": "Read only this guest's saved trip and operation IDs using the private token; ID alone grants no access.",
      "inputSchema": {
        "properties": {
          "session": {
            "$ref": "#/$defs/SessionRef"
          }
        },
        "required": [
          "session"
        ],
        "type": "object",
        "$defs": {
          "SessionRef": {
            "additionalProperties": false,
            "properties": {
              "session_id": {
                "maxLength": 40,
                "minLength": 34,
                "title": "Session Id",
                "type": "string"
              },
              "session_token": {
                "maxLength": 100,
                "minLength": 32,
                "title": "Session Token",
                "type": "string"
              }
            },
            "required": [
              "session_id",
              "session_token"
            ],
            "title": "SessionRef",
            "type": "object"
          }
        },
        "title": "get_sessionArguments"
      }
    },
    {
      "name": "update_session",
      "description": "Merge newly answered trip fields into this guest's saved context.",
      "inputSchema": {
        "properties": {
          "request": {
            "$ref": "#/$defs/Update"
          }
        },
        "required": [
          "request"
        ],
        "type": "object",
        "$defs": {
          "SessionRef": {
            "additionalProperties": false,
            "properties": {
              "session_id": {
                "maxLength": 40,
                "minLength": 34,
                "title": "Session Id",
                "type": "string"
              },
              "session_token": {
                "maxLength": 100,
                "minLength": 32,
                "title": "Session Token",
                "type": "string"
              }
            },
            "required": [
              "session_id",
              "session_token"
            ],
            "title": "SessionRef",
            "type": "object"
          },
          "Trip": {
            "additionalProperties": false,
            "properties": {
              "city": {
                "default": "",
                "maxLength": 120,
                "title": "City",
                "type": "string"
              },
              "hotel_query": {
                "default": "",
                "maxLength": 120,
                "title": "Hotel Query",
                "type": "string"
              },
              "checkin": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Checkin"
              },
              "checkout": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Checkout"
              },
              "adults": {
                "anyOf": [
                  {
                    "maximum": 6,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Adults"
              },
              "children_ages": {
                "anyOf": [
                  {
                    "items": {
                      "type": "integer"
                    },
                    "maxItems": 6,
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Children Ages"
              },
              "max_total_rub": {
                "anyOf": [
                  {
                    "maximum": 10000000,
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Max Total Rub"
              },
              "requirements": {
                "items": {
                  "type": "string"
                },
                "maxItems": 10,
                "title": "Requirements",
                "type": "array"
              }
            },
            "title": "Trip",
            "type": "object"
          },
          "Update": {
            "additionalProperties": false,
            "properties": {
              "session": {
                "$ref": "#/$defs/SessionRef"
              },
              "changes": {
                "$ref": "#/$defs/Trip"
              }
            },
            "required": [
              "session",
              "changes"
            ],
            "title": "Update",
            "type": "object"
          }
        },
        "title": "update_sessionArguments"
      }
    },
    {
      "name": "set_recovery_question",
      "description": "Enable/change private recovery after starting a trip. Requires the current session token; no plaintext answer is stored.",
      "inputSchema": {
        "properties": {
          "session": {
            "$ref": "#/$defs/SessionRef"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "secret_answer": {
            "title": "Secret Answer",
            "type": "string"
          }
        },
        "required": [
          "session",
          "question",
          "secret_answer"
        ],
        "type": "object",
        "$defs": {
          "SessionRef": {
            "additionalProperties": false,
            "properties": {
              "session_id": {
                "maxLength": 40,
                "minLength": 34,
                "title": "Session Id",
                "type": "string"
              },
              "session_token": {
                "maxLength": 100,
                "minLength": 32,
                "title": "Session Token",
                "type": "string"
              }
            },
            "required": [
              "session_id",
              "session_token"
            ],
            "title": "SessionRef",
            "type": "object"
          }
        },
        "title": "set_recovery_questionArguments"
      }
    },
    {
      "name": "get_recovery_question",
      "description": "Return only the configured recovery question, no guest trip/contact/booking details.",
      "inputSchema": {
        "properties": {
          "session_id": {
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "type": "object",
        "title": "get_recovery_questionArguments"
      }
    },
    {
      "name": "recover_session",
      "description": "Recover a known session using the secret answer, max 5 attempts/hour. Rotates/revokes the previous session token.",
      "inputSchema": {
        "properties": {
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "secret_answer": {
            "title": "Secret Answer",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "secret_answer"
        ],
        "type": "object",
        "title": "recover_sessionArguments"
      }
    },
    {
      "name": "list_hotels",
      "description": "Search/paginate the imported Bnovo catalog. Unresolved ID records are explicitly labelled, not invented hotel names.",
      "inputSchema": {
        "properties": {
          "request": {
            "$ref": "#/$defs/Listing"
          }
        },
        "required": [
          "request"
        ],
        "type": "object",
        "$defs": {
          "Listing": {
            "additionalProperties": false,
            "properties": {
              "city": {
                "default": "",
                "maxLength": 120,
                "title": "City",
                "type": "string"
              },
              "query": {
                "default": "",
                "maxLength": 120,
                "title": "Query",
                "type": "string"
              },
              "offset": {
                "default": 0,
                "maximum": 100000,
                "minimum": 0,
                "title": "Offset",
                "type": "integer"
              },
              "limit": {
                "default": 20,
                "maximum": 50,
                "minimum": 1,
                "title": "Limit",
                "type": "integer"
              },
              "identified_only": {
                "default": false,
                "title": "Identified Only",
                "type": "boolean"
              }
            },
            "title": "Listing",
            "type": "object"
          }
        },
        "title": "list_hotelsArguments"
      }
    },
    {
      "name": "get_hotel_info",
      "description": "Read public room types and regular plans of one allowlisted hotel.",
      "inputSchema": {
        "properties": {
          "hotel_id": {
            "title": "Hotel Id",
            "type": "string"
          }
        },
        "required": [
          "hotel_id"
        ],
        "type": "object",
        "title": "get_hotel_infoArguments"
      }
    },
    {
      "name": "search_rooms",
      "description": "Live offers for the saved trip across at most 10 chosen/identified hotels. Partial supplier failures remain visible.",
      "inputSchema": {
        "properties": {
          "request": {
            "$ref": "#/$defs/Search"
          }
        },
        "required": [
          "request"
        ],
        "type": "object",
        "$defs": {
          "Search": {
            "additionalProperties": false,
            "properties": {
              "session": {
                "$ref": "#/$defs/SessionRef"
              },
              "hotel_ids": {
                "items": {
                  "type": "string"
                },
                "maxItems": 10,
                "title": "Hotel Ids",
                "type": "array"
              },
              "room_query": {
                "default": "",
                "maxLength": 120,
                "title": "Room Query",
                "type": "string"
              }
            },
            "required": [
              "session"
            ],
            "title": "Search",
            "type": "object"
          },
          "SessionRef": {
            "additionalProperties": false,
            "properties": {
              "session_id": {
                "maxLength": 40,
                "minLength": 34,
                "title": "Session Id",
                "type": "string"
              },
              "session_token": {
                "maxLength": 100,
                "minLength": 32,
                "title": "Session Token",
                "type": "string"
              }
            },
            "required": [
              "session_id",
              "session_token"
            ],
            "title": "SessionRef",
            "type": "object"
          }
        },
        "title": "search_roomsArguments"
      }
    },
    {
      "name": "get_quote",
      "description": "Recheck selected hotel/room/plan and bind a 5-minute quote to this guest's saved trip.",
      "inputSchema": {
        "properties": {
          "request": {
            "$ref": "#/$defs/Quote"
          }
        },
        "required": [
          "request"
        ],
        "type": "object",
        "$defs": {
          "Quote": {
            "additionalProperties": false,
            "properties": {
              "session": {
                "$ref": "#/$defs/SessionRef"
              },
              "offer_id": {
                "pattern": "^bnovo-[1-9][0-9]{0,8}:[0-9]{1,12}:[0-9]{1,12}$",
                "title": "Offer Id",
                "type": "string"
              }
            },
            "required": [
              "session",
              "offer_id"
            ],
            "title": "Quote",
            "type": "object"
          },
          "SessionRef": {
            "additionalProperties": false,
            "properties": {
              "session_id": {
                "maxLength": 40,
                "minLength": 34,
                "title": "Session Id",
                "type": "string"
              },
              "session_token": {
                "maxLength": 100,
                "minLength": 32,
                "title": "Session Token",
                "type": "string"
              }
            },
            "required": [
              "session_id",
              "session_token"
            ],
            "title": "SessionRef",
            "type": "object"
          }
        },
        "title": "get_quoteArguments"
      }
    },
    {
      "name": "create_booking",
      "description": "Create one real supplier reservation after explicit consent. Requires secure client access and private guest session.",
      "inputSchema": {
        "properties": {
          "request": {
            "$ref": "#/$defs/Book"
          }
        },
        "required": [
          "request"
        ],
        "type": "object",
        "$defs": {
          "Book": {
            "additionalProperties": false,
            "properties": {
              "session": {
                "$ref": "#/$defs/SessionRef"
              },
              "booking": {
                "$ref": "#/$defs/DirectRequest"
              }
            },
            "required": [
              "session",
              "booking"
            ],
            "title": "Book",
            "type": "object"
          },
          "DirectRequest": {
            "additionalProperties": false,
            "properties": {
              "quote_token": {
                "maxLength": 4096,
                "minLength": 40,
                "title": "Quote Token",
                "type": "string"
              },
              "guest": {
                "$ref": "#/$defs/Guest"
              },
              "confirmed": {
                "title": "Confirmed",
                "type": "boolean"
              },
              "terms_accepted": {
                "title": "Terms Accepted",
                "type": "boolean"
              },
              "personal_data_consent": {
                "title": "Personal Data Consent",
                "type": "boolean"
              },
              "idempotency_key": {
                "maxLength": 128,
                "minLength": 12,
                "title": "Idempotency Key",
                "type": "string"
              },
              "agent": {
                "default": "other",
                "enum": [
                  "claude",
                  "codex",
                  "other"
                ],
                "title": "Agent",
                "type": "string"
              }
            },
            "required": [
              "quote_token",
              "guest",
              "confirmed",
              "terms_accepted",
              "personal_data_consent",
              "idempotency_key"
            ],
            "title": "DirectRequest",
            "type": "object"
          },
          "Guest": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "maxLength": 100,
                "minLength": 1,
                "title": "Name",
                "type": "string"
              },
              "surname": {
                "maxLength": 100,
                "minLength": 1,
                "title": "Surname",
                "type": "string"
              },
              "phone": {
                "maxLength": 30,
                "minLength": 7,
                "pattern": "^\\+?[0-9 ()-]+$",
                "title": "Phone",
                "type": "string"
              },
              "email": {
                "maxLength": 200,
                "minLength": 5,
                "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
                "title": "Email",
                "type": "string"
              }
            },
            "required": [
              "name",
              "surname",
              "phone",
              "email"
            ],
            "title": "Guest",
            "type": "object"
          },
          "SessionRef": {
            "additionalProperties": false,
            "properties": {
              "session_id": {
                "maxLength": 40,
                "minLength": 34,
                "title": "Session Id",
                "type": "string"
              },
              "session_token": {
                "maxLength": 100,
                "minLength": 32,
                "title": "Session Token",
                "type": "string"
              }
            },
            "required": [
              "session_id",
              "session_token"
            ],
            "title": "SessionRef",
            "type": "object"
          }
        },
        "title": "create_bookingArguments"
      }
    },
    {
      "name": "get_booking",
      "description": "Read only a booking attached to this private guest session. Last recorded result, not a fresh PMS/payment assertion.",
      "inputSchema": {
        "properties": {
          "session": {
            "$ref": "#/$defs/SessionRef"
          },
          "booking_id": {
            "title": "Booking Id",
            "type": "string"
          }
        },
        "required": [
          "session",
          "booking_id"
        ],
        "type": "object",
        "$defs": {
          "SessionRef": {
            "additionalProperties": false,
            "properties": {
              "session_id": {
                "maxLength": 40,
                "minLength": 34,
                "title": "Session Id",
                "type": "string"
              },
              "session_token": {
                "maxLength": 100,
                "minLength": 32,
                "title": "Session Token",
                "type": "string"
              }
            },
            "required": [
              "session_id",
              "session_token"
            ],
            "title": "SessionRef",
            "type": "object"
          }
        },
        "title": "get_bookingArguments"
      }
    },
    {
      "name": "create_booking_link",
      "description": "Return the selected hotel's own booking form. Does not reserve or pay.",
      "inputSchema": {
        "properties": {
          "request": {
            "$ref": "#/$defs/Link"
          }
        },
        "required": [
          "request"
        ],
        "type": "object",
        "$defs": {
          "Link": {
            "additionalProperties": false,
            "properties": {
              "session": {
                "$ref": "#/$defs/SessionRef"
              },
              "quote_token": {
                "maxLength": 4096,
                "minLength": 40,
                "title": "Quote Token",
                "type": "string"
              }
            },
            "required": [
              "session",
              "quote_token"
            ],
            "title": "Link",
            "type": "object"
          },
          "SessionRef": {
            "additionalProperties": false,
            "properties": {
              "session_id": {
                "maxLength": 40,
                "minLength": 34,
                "title": "Session Id",
                "type": "string"
              },
              "session_token": {
                "maxLength": 100,
                "minLength": 32,
                "title": "Session Token",
                "type": "string"
              }
            },
            "required": [
              "session_id",
              "session_token"
            ],
            "title": "SessionRef",
            "type": "object"
          }
        },
        "title": "create_booking_linkArguments"
      }
    }
  ],
