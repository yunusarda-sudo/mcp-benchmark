{
  "$schema": "../schema.json",
  "name": "com.cspriceapi/mcp",
  "title": "CSPriceAPI – CS2 skin prices",
  "category": "E-Commerce & Retail",
  "description": "Live CS2 skin prices from 16 marketplaces: BUFF163, YouPin, CSFloat, Skinport, Steam, Doppler phases",
  "repository": "https://github.com/cspriceapi/cspriceapi-mcp",
  "tools": [
    {
      "name": "find_items",
      "description": "Finds exact CS2 market_hash_name values (skins, knives, gloves, stickers, cases, agents) from a loose query, e.g. 'ak redline ft', 'karambit doppler fn', 'st m4a1 printstream'. Use it before the price tools, which need exact names. Abbreviations: st = StatTrak, fn/mw/ft/ww/bs = exterior.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "description": "Free-text item search"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "description": "Max results (default 10)"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_prices",
      "description": "Live lowest listing prices for CS2 items on up to 15 marketplaces (YouPin898, BUFF163, C5Game, EcoSteam, SkinBaron, Skinport, CSFloat, LIS-SKINS, DMarket, ShadowPay, Waxpeer, CS.MONEY, White.market, Tradeit.gg, Market.CSGO) plus the Steam Community Market best ask/bid. Refreshed about every 5 minutes. Prices are in each market's own currency (CNY, EUR or USD) with an approximate USD value for comparison, plus listing counts and the cheapest market. Doppler / Gamma Doppler names without a phase return every phase separately. Without an API key (preview): one item per call, 5 calls per day, prices from a snapshot up to 6 hours old.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 50,
            "description": "Exact market_hash_name values (use find_items first if unsure)"
          },
          "markets": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "youpin",
                "buff163",
                "c5game",
                "ecosteam",
                "skinbaron",
                "skinport",
                "csfloat",
                "lisskins",
                "dmarket",
                "shadowpay",
                "waxpeer",
                "csmoney",
                "whitemarket",
                "tradeit",
                "market-csgo"
              ]
            },
            "description": "Limit to these marketplaces (default: all)"
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_youpin_buy_orders",
      "description": "Current YouPin898 buy orders (bids) for an item, in CNY, refreshed about every 30 minutes. Default: best buy-order price and order count (Pro plan). With detail=true or any float/phase/fade/tier filter: every individual buy order with its float range and conditions (Enterprise plan). Requires an API key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market_hash_name": {
            "type": "string",
            "minLength": 1,
            "description": "Exact market_hash_name"
          },
          "detail": {
            "type": "boolean",
            "description": "Return every order with float ranges (Enterprise)"
          },
          "float": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Only orders accepting this float"
          },
          "phase": {
            "type": "string",
            "enum": [
              "Phase 1",
              "Phase 2",
              "Phase 3",
              "Phase 4",
              "Ruby",
              "Sapphire",
              "Black Pearl",
              "Emerald"
            ]
          },
          "fade": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Fade % of the item"
          },
          "tier": {
            "type": "string",
            "enum": [
              "T1",
              "T2",
              "T3",
              "T4",
              "Full Blue"
            ],
            "description": "Case Hardened tier"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Max orders returned (default 25)"
          }
        },
        "required": [
          "market_hash_name"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_float_ranged_prices",
      "description": "YouPin898 lowest listing price per float range (e.g. 0.00-0.01, 0.01-0.02) for an item, in CNY, with Doppler phase and Fade % where relevant. Use it for low-float or high-fade valuations. Requires an API key (Pro plan).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market_hash_name": {
            "type": "string",
            "minLength": 1,
            "description": "Exact market_hash_name"
          }
        },
        "required": [
          "market_hash_name"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_price_history",
      "description": "Daily or hourly price history of one item on one marketplace (lowest listing price and listing count), in the market's currency. Daily covers up to a year and more, hourly up to 30 days. Requires an API key (Enterprise plan).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market_hash_name": {
            "type": "string",
            "minLength": 1
          },
          "market": {
            "type": "string",
            "enum": [
              "youpin",
              "buff163",
              "c5game",
              "skinport",
              "skinbaron",
              "market-csgo",
              "csfloat",
              "dmarket",
              "ecosteam",
              "lisskins",
              "skinland",
              "shadowpay",
              "waxpeer",
              "tradeit"
            ],
            "description": "Default youpin"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "daily",
              "hourly"
            ],
            "description": "Default daily"
          },
          "from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD"
          },
          "to": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD"
          }
        },
        "required": [
          "market_hash_name"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_recent_sales",
      "description": "Recent completed sales of an item on CSFloat, YouPin or Skinport with price, float, pattern (paint seed), stickers and keychains. Filter by float range or pattern. Requires an API key (Enterprise plan).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "market_hash_name": {
            "type": "string",
            "minLength": 1
          },
          "marketplace": {
            "type": "string",
            "enum": [
              "csfloat",
              "youpin",
              "skinport"
            ]
          },
          "float_min": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "float_max": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "paint_seed": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "maxItems": 20,
            "description": "Pattern / paint seed filter"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Max sales returned (default 30)"
          }
        },
        "required": [
          "market_hash_name"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
