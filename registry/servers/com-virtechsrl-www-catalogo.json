{
  "$schema": "../schema.json",
  "name": "com.virtechsrl.www/catalogo",
  "title": "Catalogo prodotti Virtech",
  "category": "E-Commerce & Retail",
  "description": "Catalogo pubblico, siti e contatti ufficiali dei prodotti software Virtech.",
  "tools": [
    {
      "name": "list_virtech_products",
      "description": "Elenca i prodotti pubblicati da Virtech, opzionalmente filtrati per stato.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "status": {
            "description": "Ometti per leggere il catalogo completo.",
            "type": "string",
            "enum": [
              "online",
              "in-development"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_virtech_product",
      "description": "Trova il prodotto attraverso il suo identificativo esatto, per esempio tracciamy.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_virtech_contact",
      "description": "Restituisce l'indirizzo della pagina Contattaci e l'email pubblica di Virtech.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {},
        "additionalProperties": false
      }
    }
  ],
