{
  "$schema": "../schema.json",
  "name": "net.claudecodemods/mods-registry",
  "title": "ClaudeCodeMods Registry MCP",
  "category": "Developer Tools & VCS",
  "description": "Search Claude Code mods, MCP servers, hooks, skills, and install guides on claudecodemods.net.",
  "repository": "https://github.com/yueliao11/mcp-servers",
  "tools": [
    {
      "name": "search_claude_mods",
      "description": "Search curated Claude Code mods, plugins, hooks, skills, statuslines, and MCP integrations on claudecodemods.net with GitHub stars and security scores.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search keyword (e.g., \"mcp\", \"hooks\", \"git\", \"statusline\", \"memory\")."
          },
          "category": {
            "type": "string",
            "description": "Optional category filter (or \"all\")."
          },
          "sort": {
            "type": "string",
            "enum": [
              "trending",
              "stars",
              "newest",
              "security"
            ],
            "description": "Sort order (default: trending)."
          },
          "limit": {
            "type": "number",
            "description": "Maximum results to return (1-20, default 10)."
          }
        }
      }
    },
    {
      "name": "get_mod_install_guide",
      "description": "Get full details, security score, GitHub repository, and install command for a specific Claude Code mod by slug.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "The mod slug from search_claude_mods or list_trending_mods."
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    {
      "name": "list_trending_mods",
      "description": "Get top trending, most installed, or highest-starred Claude Code mods plus overall directory stats.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sort": {
            "type": "string",
            "enum": [
              "trending",
              "installed",
              "stars",
              "security"
            ],
            "description": "Leaderboard ranking metric (default: trending)."
          },
          "limit": {
            "type": "number",
            "description": "Number of mods to return (1-20, default 10)."
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "net.claudecodemods/mods-registry",
    "version": "1.0.1",
    "remoteUrl": "https://claudecodemods.net/api/mcp",
    "publishedAt": "2026-11-22T00:57:48.047361Z",
    "fetchedAt": "2026-11-22T12:49:37.224Z",
    "toolsSha256": "3f006a65c7678240bb1d51d402a7c1529edd0ef0e98c5c29c9fe90b1567de5b7"
  }
}
