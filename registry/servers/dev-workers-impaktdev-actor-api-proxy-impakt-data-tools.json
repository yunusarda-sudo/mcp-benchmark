{
  "$schema": "../schema.json",
  "name": "dev.workers.impaktdev.actor-api-proxy/impakt-data-tools",
  "title": "Impakt Data Tools",
  "category": "Communication & Alerting",
  "description": "Agent data tools: company jobs, SEC Form D leads, new businesses, email/domain checks, PDF text.",
  "tools": [
    {
      "name": "search_jobs",
      "description": "List open jobs from a company career page on Greenhouse, Lever, Ashby, Workable, SmartRecruiters or Recruitee. Use when asked what a company is hiring for. Returns title, department, location, remote flag, salary when published, posted date and apply URL. Max 10 rows per call, up to 5 companies. When company values are plain slugs (e.g. \"airbnb\"), ats is required; it is not needed for prefixed values such as ashby:ramp or a career-page URL.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "company"
        ],
        "properties": {
          "company": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Company slugs or career-page URLs, e.g. \"airbnb\". Max 5.",
            "maxItems": 5
          },
          "ats": {
            "type": "string",
            "description": "Required when company values are plain slugs. Not needed for ashby:ramp or a career-page URL.",
            "enum": [
              "greenhouse",
              "lever",
              "ashby",
              "workable",
              "smartrecruiters",
              "recruitee"
            ]
          },
          "keyword": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Only jobs whose title or text contains one of these.",
            "maxItems": 10
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Skip jobs containing these words.",
            "maxItems": 10
          },
          "location": {
            "type": "string",
            "description": "Location filter, e.g. \"United States\"."
          },
          "remote": {
            "type": "boolean",
            "description": "Only remote jobs."
          },
          "posted_within_days": {
            "type": "integer",
            "description": "Only jobs posted in the last N days (0 = any).",
            "minimum": 0,
            "maximum": 365
          },
          "include_description": {
            "type": "boolean",
            "description": "Include the full job description text."
          },
          "limit": {
            "type": "integer",
            "description": "Rows to return (default 10).",
            "minimum": 1,
            "maximum": 10
          }
        }
      }
    },
    {
      "name": "find_funding_leads",
      "description": "Recent SEC Form D filings: companies that just raised or are raising private capital, with offering size, amount sold, investors count, industry, state and the SEC filing link. Use for startup funding leads and deal sourcing. Official EDGAR data, issuer-level only. Max 10 rows per call; window up to 14 days.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "days": {
            "type": "integer",
            "description": "Filed in the last N days (default 5).",
            "minimum": 1,
            "maximum": 14
          },
          "date_from": {
            "type": "string",
            "description": "Window start, YYYY-MM-DD."
          },
          "date_to": {
            "type": "string",
            "description": "Window end, YYYY-MM-DD (default today)."
          },
          "industry": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Industry group contains, e.g. \"technology\".",
            "maxItems": 10
          },
          "name_contains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Issuer name contains.",
            "maxItems": 10
          },
          "state": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Two-letter issuer state codes.",
            "maxItems": 10
          },
          "min_offering_usd": {
            "type": "integer",
            "description": "Minimum total offering amount in USD.",
            "minimum": 0,
            "maximum": 100000000000
          },
          "max_offering_usd": {
            "type": "integer",
            "description": "Maximum total offering amount in USD.",
            "minimum": 0,
            "maximum": 100000000000
          },
          "young_only": {
            "type": "boolean",
            "description": "Only companies incorporated within five years."
          },
          "include_funds": {
            "type": "boolean",
            "description": "Include pooled investment funds (excluded by default)."
          },
          "include_amendments": {
            "type": "boolean",
            "description": "Include Form D/A amendments."
          },
          "limit": {
            "type": "integer",
            "description": "Rows to return (default 10).",
            "minimum": 1,
            "maximum": 10
          }
        }
      }
    },
    {
      "name": "find_insider_trades",
      "description": "Insider transactions from SEC Form 4 filings: who (officer, director, 10% owner) bought or sold a company's stock, with transaction code and plain label, shares, price, value, shares owned afterwards, dates and the SEC filing link. Requires at least one of ticker, insider or company. Defaults to open-market buys and sells over the last 7 days (max 14). Official EDGAR data. Max 10 rows per call.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ticker": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Stock tickers, e.g. NVDA. Max 3.",
            "maxItems": 3
          },
          "insider": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Insider name contains, e.g. \"Cook\". Max 3.",
            "maxItems": 3
          },
          "company": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Issuer name contains. Max 3.",
            "maxItems": 3
          },
          "transaction_type": {
            "type": "string",
            "description": "buy = open-market purchases, sell = open-market sales, buy_sell (default) = both, all = every non-derivative code.",
            "enum": [
              "buy",
              "sell",
              "buy_sell",
              "all"
            ]
          },
          "min_value_usd": {
            "type": "integer",
            "description": "Minimum shares x price in USD.",
            "minimum": 0,
            "maximum": 100000000000
          },
          "days": {
            "type": "integer",
            "description": "Filed in the last N days (default 7).",
            "minimum": 1,
            "maximum": 14
          },
          "date_from": {
            "type": "string",
            "description": "Window start, YYYY-MM-DD (window max 14 days)."
          },
          "date_to": {
            "type": "string",
            "description": "Window end, YYYY-MM-DD (default today)."
          },
          "limit": {
            "type": "integer",
            "description": "Rows to return (default 10).",
            "minimum": 1,
            "maximum": 10
          }
        }
      }
    },
    {
      "name": "find_new_business_registrations",
      "description": "Newly registered LLCs, corporations and nonprofits from official state open data for NY, CO, CT and OR: name, state, entity type, formation date, status, county, city, ZIP. Use for new-business lead lists. No personal contact data. Max 10 rows per call; window up to 31 days.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Any of NY, CO, CT, OR (default all).",
            "maxItems": 4
          },
          "days": {
            "type": "integer",
            "description": "Formed in the last N days (default 7).",
            "minimum": 1,
            "maximum": 31
          },
          "date_from": {
            "type": "string",
            "description": "Window start, YYYY-MM-DD."
          },
          "date_to": {
            "type": "string",
            "description": "Window end, YYYY-MM-DD."
          },
          "entity_type": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "e.g. LLC, CORPORATION.",
            "maxItems": 5
          },
          "name_contains": {
            "type": "string",
            "description": "Business name contains."
          },
          "city": {
            "type": "string",
            "description": "City."
          },
          "county": {
            "type": "string",
            "description": "County."
          },
          "zip": {
            "type": "string",
            "description": "ZIP code."
          },
          "limit": {
            "type": "integer",
            "description": "Rows to return (default 10).",
            "minimum": 1,
            "maximum": 10
          }
        }
      }
    },
    {
      "name": "validate_emails",
      "description": "Check email addresses without sending anything: syntax, MX records, disposable domains, role accounts, free providers and likely typos (gmial.com). Returns status valid/risky/invalid, a 0-100 score, reasons and a suggested correction. Up to 25 addresses per call.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "emails"
        ],
        "properties": {
          "emails": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Email addresses to check (max 25).",
            "maxItems": 25
          },
          "check_dns": {
            "type": "boolean",
            "description": "Run DNS/MX lookups (default true)."
          }
        }
      }
    },
    {
      "name": "check_domain_availability",
      "description": "Check whether domain names are free or registered using official RDAP. Pass full domains, or brand names plus TLDs. Returns available or registered, registrar, expiry date, age and nameservers. Max 12 domains per call.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Brand names without TLD, e.g. \"mybrand\".",
            "maxItems": 12
          },
          "tlds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "TLDs to combine with names (default com, io, ai, dev).",
            "maxItems": 10
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Full domains, e.g. \"example.com\".",
            "maxItems": 12
          },
          "details": {
            "type": "boolean",
            "description": "Include registrar, dates and nameservers (default true)."
          }
        }
      }
    },
    {
      "name": "check_domain_health",
      "description": "Audit a domain: DNS records, email authentication (SPF, DKIM, DMARC), TLS certificate, HTTP behavior and AI/search crawler rules in robots.txt. Returns findings per check. Up to 3 domains per call.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain"
        ],
        "properties": {
          "domain": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Domains to audit (max 3).",
            "maxItems": 3
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "dns",
                "email",
                "tls",
                "http",
                "crawlers"
              ]
            },
            "description": "Subset of checks (default all)."
          }
        }
      }
    },
    {
      "name": "extract_pdf_text",
      "description": "Download public PDF URLs and return clean text and/or Markdown, page count, metadata and a scanned-PDF flag (image-only PDFs return no text). Up to 2 PDFs per call, up to 50 pages each.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "urls"
        ],
        "properties": {
          "urls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Public http(s) PDF URLs (max 2).",
            "maxItems": 2
          },
          "format": {
            "type": "string",
            "description": "Output format.",
            "enum": [
              "both",
              "text",
              "markdown"
            ]
          },
          "max_pages": {
            "type": "integer",
            "description": "Max pages per PDF (default 30).",
            "minimum": 1,
            "maximum": 50
          },
          "include_pages": {
            "type": "boolean",
            "description": "Add per-page text."
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
