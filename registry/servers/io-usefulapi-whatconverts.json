          },
          "start_date": {
            "description": "Profiles created from this date (UTC). Pass 2014-11-11 (the earliest date WhatConverts accepts) to list all.",
            "type": "string"
          },
          "end_date": {
            "description": "Profiles created up to this date (UTC).",
            "type": "string"
          },
          "order": {
            "description": "Sort by date created: asc or desc (default desc).",
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "page": {
            "description": "Page number, from 1 (default 1). Pass the previous reply's next_page.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 100000
          },
          "per_page": {
            "description": "Results per page, 1-250 (default 25).",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 250
          }
        },
        "required": [
          "account_id"
        ]
      }
    },
    {
      "name": "whatconverts_get_profile",
      "description": "Agency key only: one profile by id (name, date created). GET /accounts/{account_id}/profiles/{profile_id}.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
