{
  "$schema": "../schema.json",
  "name": "io.github.Flowish/toolgiv",
  "title": "toolgiv (툴기브)",
  "category": "Payments, CRM & Finance",
  "description": "Find small, verified work tools (payroll, tax, invoices, splitting bills) made by real workers.",
  "tools": [
    {
      "name": "toolgiv_search",
      "description": "사용자의 업무에 맞는 toolgiv 도구를 낱말로 찾습니다(예: 주휴수당, 4대보험, 정산, 견적, 엑셀). 제목·부제·설명·바로 쓰는 링크(url)를 돌려줍니다. 열쇠 없이 쓸 수 있습니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "찾을 낱말 (예: \"알바 주휴수당\")"
          },
          "category": {
            "type": "string",
            "description": "분류로 좁히기 (선택)"
          },
          "limit": {
            "type": "number",
            "description": "최대 개수 (기본 8, 최대 20)"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "toolgiv_tool",
      "description": "toolgiv 도구 하나의 설명·분류·제작자·한계(어디까지 맞추는지)·링크를 돌려줍니다. 열쇠 없이 쓸 수 있습니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "도구 id (toolgiv_search 결과의 id)"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "toolgiv_guide",
      "description": "toolgiv에 올릴 수 있는 도구의 조건과 필드 설명을 돌려줍니다. 올리기 전에 먼저 읽으세요.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "toolgiv_me",
      "description": "키 주인의 이름과 오늘 더 올릴 수 있는 도구 수를 돌려줍니다.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "toolgiv_upload",
      "description": "HTML 도구(또는 프롬프트 글) 하나를 toolgiv에 올립니다. 자동 안전 검사를 거쳐 깨끗하면 바로 공개되고, 공개 링크를 돌려줍니다. 인터넷 통신·외부 스크립트가 있으면 거절됩니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "제목 (80자)"
          },
          "subtitle": {
            "type": "string",
            "description": "한 줄 부제 — 무엇을 넣으면 무엇이 나오는지 (120자)"
          },
          "description": {
            "type": "string",
            "description": "설명 — 「무엇이 불편한 사람이 쓰는가」로 시작 (2000자)"
          },
          "kind": {
            "type": "string",
            "enum": [
              "web",
              "prompt",
              "job"
            ],
            "description": "web=웹 도구(기본), prompt=문서·프롬프트, job=업무 기능"
          },
          "category": {
            "type": "string",
            "description": "분류 (예: 정산, 엑셀, 사진)"
          },
          "code": {
            "type": "string",
            "description": "HTML 전체(CSS·JS 포함) 또는 프롬프트 글 (380KB)"
          }
        },
        "required": [
          "title",
          "code"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "toolgiv_my_tools",
      "description": "내가 올린 도구와 각 상태(live 공개 · held 확인 대기 · rejected 거절 · down 내려감)를 돌려줍니다.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "toolgiv_status",
      "description": "내 도구 하나의 상태와 검사 점수를 돌려줍니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "도구 id (올렸을 때 받은 것)"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "toolgiv_update",
      "description": "이미 올린 내 도구에 새 코드를 올립니다. 검사를 다시 거쳐 깨끗하면 바로 바뀝니다.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "description": "무엇을 바꿨는지 (300자)"
          }
        },
        "required": [
          "id",
          "code"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
