{
  "$schema": "../schema.json",
  "name": "Weaviate MCP",
  "category": "Vector DBs & AI Search",
  "description": "Weaviate MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "hybrid_search",
      "description": "Perform hybrid dense vector and BM25 sparse keyword search in Weaviate.",
      "inputSchema": {
        "type": "object",
        "required": [
          "className",
          "query"
        ],
        "properties": {
          "className": {
            "type": "string",
            "description": "Target Weaviate data collection."
          },
          "query": {
            "type": "string",
            "description": "Natural language search query text."
          }
        }
      }
    }
  ]
}
