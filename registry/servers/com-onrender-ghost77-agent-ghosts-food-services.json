{
  "$schema": "../schema.json",
  "name": "com.onrender.ghost77-agent/ghosts-food-services",
  "title": "Ghost's Food Services",
  "category": "AI, LLMs & Agents",
  "description": "Look up US restaurants and menus, then pay $5 for Rebecca to phone in an order. Not a certification.",
  "tools": [
    {
      "name": "search_restaurant",
      "description": "Look up a US restaurant by name and town from public map listings and, when found, the restaurant's own website menu. Never invents items or prices. Returns a placeToken needed to quote or place an order.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "locality": {
            "type": "string",
            "description": "Town or city, optionally with state"
          }
        },
        "required": [
          "name",
          "locality"
        ]
      }
    },
    {
      "name": "get_menu",
      "description": "Fetch menu items and prices taken from the restaurant's own website only. If none are found, returns a note to type items. Does not invent dishes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "locality": {
            "type": "string"
          },
          "placeToken": {
            "type": "string"
          }
        },
        "required": [
          "locality"
        ]
      }
    },
    {
      "name": "quote_order",
      "description": "Validate an order and return the $5 call-placement fee, a Stripe checkout URL for the human, and x402 payment terms. Requires termsAccepted true and termsVersion 2026-11-17 (the human must have agreed). Does not charge and does not call the restaurant.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "placeToken": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "orderType": {
            "type": "string",
            "enum": [
              "pickup",
              "delivery"
            ]
          },
          "termsAccepted": {
            "type": "boolean"
          },
          "termsVersion": {
            "type": "string"
          },
          "consent": {
            "type": "boolean"
          },
          "customerName": {
            "type": "string"
          },
          "customerPhone": {
            "type": "string"
          },
          "deliveryAddress": {
            "type": "string"
          },
          "allergies": {
            "type": "string"
          }
        },
        "required": [
          "placeToken",
          "items",
          "orderType",
          "termsAccepted",
          "termsVersion",
          "consent"
        ]
      }
    },
    {
      "name": "place_order",
      "description": "Does not place the call by itself. Returns how to pay the $5 fee (Stripe checkout URL for the human, or x402 USDC on Base) and the endpoints to call after payment. Paid placement is a separate HTTP POST after payment is confirmed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "placeToken": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "orderType": {
            "type": "string",
            "enum": [
              "pickup",
              "delivery"
            ]
          },
          "termsAccepted": {
            "type": "boolean"
          },
          "termsVersion": {
            "type": "string"
          },
          "consent": {
            "type": "boolean"
          },
          "payRef": {
            "type": "string"
          },
          "customerName": {
            "type": "string"
          },
          "customerPhone": {
            "type": "string"
          },
          "deliveryAddress": {
            "type": "string"
          },
          "allergies": {
            "type": "string"
          }
        },
        "required": [
          "placeToken",
          "items",
          "orderType",
          "termsAccepted",
          "termsVersion",
          "consent"
        ]
      }
    },
    {
      "name": "order_status",
      "description": "Look up a paid order by its public reference (G77-YYYYMMDD-…). Returns outcome, ready time, total, and whether a $5 refund is due. Does not return customer phone or address.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "ref"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.onrender.ghost77-agent/ghosts-food-services",
    "version": "1.0.0",
    "remoteUrl": "https://ghosts-food-services.vercel.app/mcp",
    "publishedAt": "2026-11-18T03:55:19.810925Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "780dcced8f5460578fe5fa095b7efb20cebbb2ef5ab57de578ee8349a074c419"
  }
}
