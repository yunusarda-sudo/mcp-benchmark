{
  "$schema": "../schema.json",
  "name": "io.github.PacketFabric/packetfabric-mcp",
  "title": "PacketFabric",
  "category": "Developer Tools & DevOps",
  "description": "Query and manage PacketFabric NaaS: ports, virtual circuits, cloud routers, pricing, metrics.",
  "repository": "https://github.com/PacketFabric/public-mcp",
  "tools": [
    {
      "name": "pf_list_api_areas",
      "description": "List the areas (tags) of the PacketFabric API with counts of read and write operations.\n\n    Use this to orient yourself before pf_search_endpoints.",
      "inputSchema": {
        "properties": {},
        "type": "object",
        "title": "pf_list_api_areasArguments"
      }
    },
    {
      "name": "pf_search_endpoints",
      "description": "Search all PacketFabric API endpoints by keyword. Returns operation_ids to pass to\n    pf_describe_endpoint / pf_call_endpoint.",
      "inputSchema": {
        "properties": {
          "query": {
            "default": "",
            "description": "Keywords, e.g. 'cloud router bgp', 'port metrics', 'aws hosted'.",
            "title": "Query",
            "type": "string"
          },
          "tag": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Restrict to one API area from pf_list_api_areas.",
            "title": "Tag"
          },
          "read_only": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "True = only safe reads, False = only writes.",
            "title": "Read Only"
          },
          "limit": {
            "default": 25,
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "type": "object",
        "title": "pf_search_endpointsArguments"
      }
    },
    {
      "name": "pf_describe_endpoint",
      "description": "Show parameters, request body schema and response shape for one endpoint.\n    Call this before pf_call_endpoint for anything you haven't used yet.",
      "inputSchema": {
        "properties": {
          "operation_id": {
            "title": "Operation Id",
            "type": "string"
          }
        },
        "required": [
          "operation_id"
        ],
        "type": "object",
        "title": "pf_describe_endpointArguments"
      }
    },
    {
      "name": "pf_call_endpoint",
      "description": "Call any PacketFabric API endpoint by operation_id.\n\n    Reads run immediately. Writes (create/modify/delete — may create billable services)\n    are only possible when the server was started with PF_ALLOW_WRITES=true, and return a\n    dry-run preview unless confirm=true. Always show the user the preview and get explicit\n    approval before re-calling with confirm=true.",
      "inputSchema": {
        "properties": {
          "operation_id": {
            "description": "From pf_search_endpoints.",
            "title": "Operation Id",
            "type": "string"
          },
          "params": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Path and query parameters by name, e.g. {'port_circuit_id': 'PF-AP-LAX1-1234', 'since': '1 day ago'}. Lists are sent as repeated query params.",
            "title": "Params"
          },
          "body": {
            "default": null,
            "description": "JSON request body for POST/PUT/PATCH.",
            "title": "Body"
          },
          "confirm": {
            "default": false,
            "description": "Required true to actually execute a write. Without it, writes return a preview only.",
            "title": "Confirm",
            "type": "boolean"
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only return these keys from each item (dot paths allowed, e.g. 'interfaces'). Omit for all.",
            "title": "Fields"
          },
          "max_items": {
            "default": 100,
            "description": "Cap on list items returned.",
            "maximum": 5000,
            "minimum": 1,
            "title": "Max Items",
            "type": "integer"
          }
        },
        "required": [
          "operation_id"
        ],
        "type": "object",
        "title": "pf_call_endpointArguments"
      }
    },
    {
      "name": "pf_get_account",
      "description": "Get the current PacketFabric customer account (name, account number, UUID, type).\n    Good first call to confirm credentials work.",
      "inputSchema": {
        "properties": {},
        "type": "object",
        "title": "pf_get_accountArguments"
      }
    },
