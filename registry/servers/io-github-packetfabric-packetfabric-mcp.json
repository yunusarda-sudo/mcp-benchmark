            "default": null,
            "title": "Is Ptp"
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only return these keys from each item (dot paths allowed, e.g. 'interfaces'). Omit for all.",
            "title": "Fields"
          },
          "max_items": {
            "default": 100,
            "description": "Cap on list items returned.",
            "maximum": 5000,
            "minimum": 1,
