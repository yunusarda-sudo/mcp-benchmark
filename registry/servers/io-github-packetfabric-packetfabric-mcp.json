    {
      "name": "pf_get_pricing",
      "description": "Look up list pricing (MRC/NRC) for a PacketFabric product between locations. Read-only, no order is created.\n    vcbwc = backbone virtual circuit bandwidth. Works without an API key.",
      "inputSchema": {
        "properties": {
          "product_type": {
            "enum": [
              "aggregate_capacity",
              "cloud_dedicated",
              "cloud_dedicated_vc",
              "cloud_hosted",
              "crossconnect",
              "pointtopoint",
              "port",
              "port_enni",
              "vcbwc",
              "cloud_router",
              "cr_connection",
              "vc_ix",
              "vc_marketplace",
              "add_on_fee",
              "high_performance_internet",
              "ip_subnet",
              "alert_credits"
            ],
            "title": "Product Type",
            "type": "string"
          },
          "location_type": {
            "default": "pop",
            "enum": [
              "site",
              "pop",
              "market",
              "country",
              "region"
            ],
            "title": "Location Type",
            "type": "string"
          },
          "side_a": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "A-side location code, e.g. LAX1 (or market/region per location_type).",
            "title": "Side A"
          },
          "side_z": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Z-side location code, e.g. NYC5.",
            "title": "Side Z"
          },
          "speed": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "e.g. 1Gbps, 10Gbps, 100Gbps.",
            "title": "Speed"
          },
          "subscription_term": {
            "anyOf": [
              {
                "enum": [
                  1,
                  12,
                  24,
                  36
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Months.",
            "title": "Subscription Term"
          },
          "service_class": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "'metro' or 'longhaul'.",
            "title": "Service Class"
          },
          "media": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optic media, e.g. LR, LR4.",
            "title": "Media"
          },
          "max_items": {
            "default": 100,
            "description": "Cap on list items returned.",
            "maximum": 5000,
            "minimum": 1,
            "title": "Max Items",
            "type": "integer"
          }
        },
        "required": [
          "product_type"
        ],
        "type": "object",
        "title": "pf_get_pricingArguments"
      }
    },
