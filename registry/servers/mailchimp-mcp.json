{
  "$schema": "../schema.json",
  "name": "Mailchimp MCP",
  "category": "Communication & Alerting",
  "description": "Mailchimp MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
