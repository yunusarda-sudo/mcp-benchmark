{
  "$schema": "../schema.json",
  "name": "com.seoulmarkets/market-data",
  "title": "SeoulMarkets: Korea, Japan and Taiwan market data",
  "category": "Observability & Analytics",
  "description": "Korean, Japanese and Taiwanese listed-company financials, valuation and filings in English.",
  "tools": [
    {
      "name": "coverage",
      "description": "What SeoulMarkets has actually collected: datasets, row counts, date ranges, and what is NOT covered. Call this first when unsure whether a question can be answered.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "korea_trade_by_country",
      "description": "Korea exports, imports and trade balance by partner country and month (customs basis). National totals by default.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "description": "Partner country, English name or code, e.g. \"vietnam\". Omit for national totals."
          },
          "since": {
            "type": "string",
            "description": "Earliest month, YYYY-MM."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum rows to return (free tier caps this).",
            "minimum": 1,
            "maximum": 500
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "trade_countries",
      "description": "Partner country codes with English names, for use with korea_trade_by_country.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "hs_code_lookup",
      "description": "Resolve an HS code (2, 4, 6 or 10 digits) to its English description.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "HS code digits."
          }
        },
        "required": [
          "code"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "hs_code_search",
      "description": "Search HS chapters and headings by English keyword.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "English keyword, e.g. \"semiconductor\"."
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false
      }
    },
    {
