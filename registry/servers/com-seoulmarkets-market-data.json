      "inputSchema": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "description": "6-digit KRX ticker, e.g. \"005930\"."
          },
          "industry": {
            "type": "string",
            "description": "Industry name filter."
          },
          "measured": {
            "type": "string",
            "description": "\"true\" to keep only rows where the multiple could be computed."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum rows to return (free tier caps this).",
            "minimum": 1,
            "maximum": 500
          }
        },
        "additionalProperties": false
      }
    },
