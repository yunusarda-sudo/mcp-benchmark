{
  "$schema": "../schema.json",
  "name": "io.github.willowrock-holdings/willow-rock-data-tools",
  "title": "Willow Rock Data Tools",
  "category": "Developer Tools & DevOps",
  "description": "Pay-per-job CSV cleanup, schema validation, and table format conversion.",
  "tools": [
    {
      "name": "list_services",
      "description": "Free. Lists the paid data tools, prices in USD, limits and how payment works.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "clean_csv",
      "description": "$1.00 per job. Cleans a messy CSV/TSV/JSON table: auto-detects delimiter, snake_cases and de-duplicates headers, trims whitespace, turns blanks/\"N/A\" into null, drops empty rows/columns and exact duplicate rows, infers integers/numbers/booleans, converts dates to ISO 8601, lowercases emails and formats US phone numbers as E.164. Returns typed JSON rows (or CSV/JSONL/TSV/Markdown/HTML) plus a per-column report. Returns a free preview and a paymentLink; the full result is released after payment.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "data": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              }
            ],
            "description": "The table: CSV/TSV/JSONL/Markdown text, or a JSON array of objects."
          },
          "format": {
            "description": "Input format; auto-detected if omitted.",
            "type": "string",
            "enum": [
              "csv",
              "tsv",
              "json",
              "jsonl",
              "markdown"
            ]
          },
          "options": {
            "type": "object",
            "properties": {
              "normalizeHeaders": {
                "type": "boolean"
              },
              "trim": {
                "type": "boolean"
              },
              "dropEmptyRows": {
                "type": "boolean"
              },
              "dropEmptyColumns": {
                "type": "boolean"
              },
              "dedupe": {
                "type": "boolean"
              },
              "inferTypes": {
                "type": "boolean"
              },
              "dateOrder": {
                "type": "string",
                "enum": [
                  "MDY",
                  "DMY"
                ]
              },
              "normalizeEmails": {
                "type": "boolean"
              },
              "normalizePhones": {
                "type": "boolean"
              },
              "output": {
                "type": "string",
                "enum": [
                  "csv",
                  "tsv",
                  "json",
                  "jsonl",
                  "markdown",
                  "html"
                ]
              }
            }
          }
        },
        "required": [
          "data"
        ]
      }
    },
    {
      "name": "validate_data",
      "description": "$0.75 per job. Checks every row of a CSV/TSV/JSON/JSONL table against a simple column schema (type: string|integer|number|boolean|date|email|url|phone; required; unique; min/max; minLength/maxLength; pattern; enum). Returns a pass/fail verdict, invalid-row count, counts per column and rule, and up to 1,000 row-level issues with messages. Returns a free preview (verdict, counts, first issues) and a paymentLink for the full issue list.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "data": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              }
            ],
            "description": "The table: CSV/TSV/JSONL/Markdown text, or a JSON array of objects."
          },
          "format": {
            "description": "Input format; auto-detected if omitted.",
            "type": "string",
            "enum": [
              "csv",
              "tsv",
              "json",
              "jsonl",
              "markdown"
            ]
          },
          "schema": {
            "type": "object",
            "properties": {
              "columns": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "string",
                        "integer",
                        "number",
                        "boolean",
                        "date",
                        "email",
                        "url",
                        "phone"
                      ]
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "unique": {
                      "type": "boolean"
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "minLength": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "maxLength": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "pattern": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "enum": {
                      "type": "array",
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      }
                    }
                  }
                }
              },
              "allowExtraColumns": {
                "type": "boolean"
              }
            },
            "required": [
              "columns"
            ]
          }
        },
        "required": [
          "data",
          "schema"
        ]
      }
    },
    {
      "name": "convert_format",
      "description": "$0.50 per job. Converts a table between formats. Input: csv, tsv, json, jsonl, markdown. Output: csv, tsv, json, jsonl, markdown, html. Nested JSON objects are flattened to dot.notation columns. Quoting and escaping are handled correctly (RFC 4180 CSV). Returns a free preview and a paymentLink.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "data": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              }
            ],
            "description": "The table: CSV/TSV/JSONL/Markdown text, or a JSON array of objects."
          },
          "format": {
            "description": "Input format; auto-detected if omitted.",
            "type": "string",
            "enum": [
              "csv",
              "tsv",
              "json",
              "jsonl",
              "markdown"
            ]
          },
          "to": {
            "type": "string",
            "enum": [
              "csv",
              "tsv",
              "json",
              "jsonl",
              "markdown",
              "html"
            ]
          }
        },
        "required": [
          "data",
          "to"
        ]
      }
    },
    {
      "name": "get_job_result",
      "description": "Free. Returns the full result of a paid job, or its status, preview and paymentLink if unpaid.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          }
        },
        "required": [
          "job_id"
        ]
      }
    }
  ],
  "source": {
