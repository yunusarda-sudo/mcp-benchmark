{
  "$schema": "../schema.json",
  "name": "Neo4j Graph MCP",
  "category": "Vector DBs & AI Search",
  "description": "Neo4j Graph MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "execute_cypher",
      "description": "Execute Cypher graph query against Neo4j database and return nodes and relationships.",
      "inputSchema": {
        "type": "object",
        "required": [
          "cypher"
        ],
        "properties": {
          "cypher": {
            "type": "string",
            "description": "Cypher query string."
          },
          "params": {
            "type": "object",
            "description": "Cypher parameter map."
          }
        }
      }
    }
  ]
}
