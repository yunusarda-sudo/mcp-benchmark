  "repository": "https://github.com/Anon2052/search-mcp",
  "tools": [
    {
      "name": "search_web",
      "description": "Search the web and return titles, URLs, and snippets.",
      "inputSchema": {
        "properties": {
          "query": {
            "type": "string",
            "description": "The search query."
          },
          "count": {
            "default": 5,
            "type": "integer",
            "description": "Maximum results to return (1-10, default 5)."
          }
        },
        "required": [
          "query"
        ],
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "fetch_url",
      "description": "Fetch a public http(s) URL and return its main text content as plain text.",
      "inputSchema": {
        "properties": {
          "url": {
            "type": "string",
            "description": "The http(s) URL to fetch. Private/loopback hosts are rejected."
          }
        },
        "required": [
          "url"
        ],
        "type": "object",
        "additionalProperties": false
      }
    }
  ],
