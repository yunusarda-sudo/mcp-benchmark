{
  "$schema": "../schema.json",
  "name": "fi.korkopuntari/korkopuntari",
  "title": "KorkoPuntari",
  "category": "Other",
  "description": "Finnish loan calculator: APR, KSL interest-rate cap check, Euribor rates and lender comparison.",
  "tools": [
    {
      "name": "calculate_loan",
      "description": "Calculates monthly annuity payment, total interest and fees, EU/Finnish KSL effective annual rate (todellinen vuosikorko), and statutory KSL 7:8 representative example.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "amount_eur": {
            "type": "number",
            "description": "Loan amount in euros (100–500000)",
            "default": 15000
          },
          "years": {
            "type": "number",
            "description": "Loan term in years (1–30)",
            "default": 6
          },
          "nominal_rate_pct": {
            "type": "number",
            "description": "Annual nominal interest rate in percent (e.g. 7.9)",
            "default": 7.9
          },
          "monthly_fee_eur": {
            "type": "number",
            "description": "Monthly account fee in euros",
            "default": 5
          },
          "opening_fee_eur": {
            "type": "number",
            "description": "One-time opening fee in euros",
            "default": 0
          }
        },
        "required": [
          "amount_eur",
          "years",
          "nominal_rate_pct"
        ]
      }
    },
    {
      "name": "check_rate_cap",
      "description": "Verifies whether a consumer credit in Finland complies with the statutory interest cap (reference rate 2.50% + 15 pp = 17.50%, absolute max 20%) and annual fee cap (0.01%/day, max 150 EUR/year).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "amount_eur": {
            "type": "number",
            "description": "Loan amount in euros",
            "default": 10000
          },
          "nominal_rate_pct": {
            "type": "number",
            "description": "Nominal annual interest rate (%)",
            "default": 15
          },
          "monthly_fee_eur": {
            "type": "number",
            "description": "Monthly account management fee (€)",
            "default": 5
          },
          "opening_fee_eur": {
            "type": "number",
            "description": "One-time opening fee (€)",
            "default": 0
          },
          "years": {
            "type": "number",
            "description": "Loan term in years",
            "default": 5
          }
        },
        "required": [
          "amount_eur",
          "nominal_rate_pct"
        ]
      }
    },
    {
      "name": "compare_lenders",
      "description": "Lists Finnish loan brokers and major benchmark banks (including non-affiliate banks OP, Nordea, S-Pankki, Danske Bank) filtered by category and amount, sorted by lowest advertised nominal rate.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "yhdistely",
              "kulutus",
              "asunto",
              "auto",
              "kaikki"
            ],
            "default": "yhdistely"
          },
          "amount_eur": {
            "type": "number",
            "description": "Desired loan amount in euros",
            "default": 15000
          },
          "include_non_affiliate_banks": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    {
      "name": "calculate_consolidation",
      "description": "Compares multiple existing loans/credit cards (balance, rate, monthly fee) against a single consolidated loan.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "loans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "balance_eur": {
                  "type": "number"
                },
                "nominal_rate_pct": {
                  "type": "number"
                },
                "monthly_fee_eur": {
                  "type": "number"
                }
              },
              "required": [
                "balance_eur",
                "nominal_rate_pct"
              ]
            }
          },
          "new_term_years": {
            "type": "number",
            "default": 6
          },
          "new_nominal_rate_pct": {
            "type": "number",
            "default": 7.9
          },
          "new_monthly_fee_eur": {
            "type": "number",
            "default": 5
          }
        },
        "required": [
          "loans"
        ]
      }
    },
    {
      "name": "get_finnish_rates",
      "description": "Returns latest Suomen Pankki Euribor (1, 3, 6, 12 month), Finnish statutory reference rate (korkolain viitekorko), and KSL 7:17a consumer credit interest & fee caps.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "fi.korkopuntari/korkopuntari",
    "version": "1.0.0",
    "remoteUrl": "https://korkopuntari.fi/mcp",
    "publishedAt": "2026-11-27T16:16:23.979867Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "61ee76304ec2713c2dab755637fed2377f6e86e1bf9fdab508ba9516f927ea8f"
  }
}
