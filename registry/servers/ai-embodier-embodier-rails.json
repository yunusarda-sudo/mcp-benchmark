{
  "$schema": "../schema.json",
  "name": "ai.embodier/embodier-rails",
  "title": "Embodier Rails — Direct Booking for AI Agents",
  "category": "AI, LLMs & Agents",
  "description": "Book resorts and hotels directly through AI agents — cheapest-direct quotes, no OTA in the path.",
  "repository": "https://github.com/Espenator/embodier-brain",
  "tools": [
    {
      "name": "search_properties",
      "description": "Find directly bookable properties for a stay. Direct paths only — no OTA inventory is ever returned.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "check_in": {
            "type": "string",
            "format": "date"
          },
          "check_out": {
            "type": "string",
            "format": "date"
          },
          "guests": {
            "type": "object",
            "properties": {
              "adults": {
                "type": "integer"
              },
              "children": {
                "type": "integer"
              }
            }
          },
          "max_results": {
            "type": "integer"
          }
        },
        "required": [
          "check_in",
          "check_out"
        ]
      }
    },
    {
      "name": "get_quote",
      "description": "Cheapest direct quote for one property stay, taxes included, with the rail fee disclosed inside the quote.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string"
          },
          "check_in": {
            "type": "string",
            "format": "date"
          },
          "check_out": {
            "type": "string",
            "format": "date"
          },
          "guests": {
            "type": "object",
            "properties": {
              "adults": {
                "type": "integer"
              },
              "children": {
                "type": "integer"
              }
            }
          }
        },
        "required": [
          "property_id",
          "check_in",
          "check_out"
        ]
      }
    },
    {
      "name": "get_quote_multi",
      "description": "Every direct source for a property, ranked cheapest-direct first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string"
          },
          "check_in": {
            "type": "string",
            "format": "date"
          },
          "check_out": {
            "type": "string",
            "format": "date"
          },
          "guests": {
            "type": "object",
            "properties": {
              "adults": {
                "type": "integer"
              },
              "children": {
                "type": "integer"
              }
            }
          }
        },
        "required": [
          "property_id",
          "check_in",
          "check_out"
        ]
      }
    },
    {
      "name": "describe_property",
      "description": "Agent-readable self-description of one property.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string"
          }
        },
        "required": [
          "property_id"
        ]
      }
    },
    {
      "name": "create_booking",
      "description": "Create a booking from a quote id. Requires a caller token AND a single-use human approval token (contract §5.4).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "quote_id": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          },
          "guest": {
            "type": "object"
          },
          "approval": {
            "type": "object",
            "properties": {
              "approval_token": {
                "type": "string"
              }
            },
            "required": [
              "approval_token"
            ]
          }
        },
        "required": [
          "quote_id",
          "idempotency_key",
          "guest",
          "approval"
        ]
      }
    },
    {
      "name": "cancel_booking",
      "description": "Cancel an existing booking. Requires a caller token.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "booking_id": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "booking_id",
          "idempotency_key"
        ]
      }
    },
    {
      "name": "get_booking",
      "description": "Read a booking's current state. Requires a caller token.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "booking_id": {
            "type": "string"
          }
        },
        "required": [
          "booking_id"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
