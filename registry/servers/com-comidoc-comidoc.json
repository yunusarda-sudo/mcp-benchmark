                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              ]
            },
            "description": "The final courses to show, in display order: Udemy course IDs (numbers) or Comidoc slugs taken from previous Comidoc results. At most 10 for this connection."
