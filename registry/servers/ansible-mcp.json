{
  "$schema": "../schema.json",
  "name": "Ansible MCP",
  "category": "Developer Tools & VCS",
  "description": "Ansible MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "run_playbook",
      "description": "Execute an Ansible playbook against specified inventory hosts.",
      "inputSchema": {
        "type": "object",
        "required": [
          "playbookPath",
          "inventoryPath"
        ],
        "properties": {
          "playbookPath": {
            "type": "string",
            "description": "Path to playbook YAML file."
          },
          "inventoryPath": {
            "type": "string",
            "description": "Path to hosts inventory file."
          },
          "checkMode": {
            "type": "boolean",
            "description": "Run in dry-run check mode."
          }
        }
      }
    }
  ]
}
