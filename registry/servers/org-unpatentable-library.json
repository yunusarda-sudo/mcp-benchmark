{
  "$schema": "../schema.json",
  "name": "org.unpatentable/library",
  "title": "Unpatentable.org",
  "category": "Other",
  "description": "Search and read 1,300+ public-domain (CC0) invention disclosures: open prior art in 12 domains.",
  "tools": [
    {
      "name": "search_inventions",
      "description": "Search the Unpatentable.org library of public-domain (CC0) invention disclosures by words in the title/summary, research domain, subdomain and publish date. Returns up to 25 summaries with URLs.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 200,
            "description": "Words that must all appear in the title or summary."
          },
          "domain": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,120}$",
            "description": "Top-level domain slug from list_domains."
          },
          "subdomain": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,120}$",
            "description": "Subdomain slug from get_domain."
          },
          "published_after": {
            "type": "string",
            "format": "date"
          },
          "published_before": {
            "type": "string",
            "format": "date"
          },
          "sort": {
            "type": "string",
            "enum": [
              "relevance",
              "newest",
              "oldest",
              "title"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 10
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 1
          }
        }
      }
    },
    {
      "name": "get_invention",
      "description": "One invention by id or slug: abstract, problem, section outline, domain, publish date, URLs of its 3 reports (main, Implementation Guide, Industry Impact), PDFs, Arweave transaction ids, GitHub repo and CC0 license.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Numeric id or URL slug (any of the three reports)."
          }
        }
      }
    },
    {
      "name": "get_invention_text",
      "description": "Full text of one report as markdown, in chunks. part = main | guide | impact. Use offset to continue; the result says the next offset.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "part": {
            "type": "string",
            "enum": [
              "main",
              "guide",
              "impact"
            ],
            "default": "main"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 40000,
            "default": 20000
          }
        }
      }
    },
    {
      "name": "list_domains",
      "description": "The 12 research domains with invention counts and subdomain counts (use get_domain for its subdomains).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    {
      "name": "get_domain",
      "description": "One research domain: its subdomains with counts and its 10 newest inventions.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,120}$"
          }
        }
      }
    },
    {
      "name": "newest_inventions",
      "description": "The most recently published inventions, optionally in one domain.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25,
            "default": 10
          },
          "domain": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,120}$"
          }
        }
      }
    },
    {
      "name": "library_stats",
      "description": "Totals: inventions, reports, domains, subdomains, first/last publish date, inventions per domain.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "org.unpatentable/library",
    "version": "1.0.1",
    "remoteUrl": "https://unpatentable.org/mcp",
    "publishedAt": "2026-11-24T16:20:04.681732Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "cb881395aae4026c7efd3d7254b27e0e3c014e8da0c2876e4c5aa8dfc849dae5"
  }
}
