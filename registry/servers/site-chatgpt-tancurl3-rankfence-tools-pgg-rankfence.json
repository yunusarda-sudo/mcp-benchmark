{
  "$schema": "../schema.json",
  "name": "site.chatgpt.tancurl3.rankfence-tools-pgg/rankfence",
  "title": "RankFence",
  "category": "Communication & Alerting",
  "description": "Replay supplied ranked lists and check when shard-local reciprocal rank fusion has an exact top k.",
  "repository": "https://github.com/pgg898200-ship-it/streamsieve",
  "tools": [
    {
      "name": "rankfence_analyze",
      "description": "Replay a fully supplied reciprocal-rank-fusion query in equal page rounds. Return exact winners, simulated ranked IDs read and saved, and exhaustive agreement. Supply source_groups only for disjoint ID namespaces. Up to 2,048 ID occurrences.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rankings",
          "k"
        ],
        "properties": {
          "rankings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "array",
              "maxItems": 512,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 256
              }
            }
          },
          "k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256,
            "default": 8
          },
          "c": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1024,
            "default": 60
          },
          "source_groups": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 256
            }
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "site.chatgpt.tancurl3.rankfence-tools-pgg/rankfence",
    "version": "0.1.0",
    "remoteUrl": "https://rankfence-tools-pgg.tancurl3.chatgpt.site/rpc",
    "publishedAt": "2026-11-22T20:37:59.905074Z",
    "fetchedAt": "2026-11-23T16:50:40.239Z",
    "toolsSha256": "0ca23e23b8bbdce62d014cd6978d38ed6a14d6b4b6bebbf0004b723658cc59f1"
  }
}
