{
  "$schema": "../schema.json",
  "name": "com.chexlow/catalog",
  "title": "Chexlow Public Catalog",
  "category": "E-Commerce & Retail",
  "description": "Search fashion, beauty, and sports products and compare live store prices across retailers.",
  "tools": [
    {
      "name": "search_products",
      "description": "Search public products by query or explicit filters. queryMatch reports literal name/brand terms and whether the query phrase occurs in the name, not verified model identity; partial/none candidates remain visible and even a whole phrase can describe an accessory. Inspect product details and variants. Price bounds are USD major units, not converted source prices or delivered totals. Country is a preference and can fall back; inspect offer shipping evidence. Does not purchase or follow retailer links.",
