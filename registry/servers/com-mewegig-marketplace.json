{
  "$schema": "../schema.json",
  "name": "com.mewegig/marketplace",
  "title": "MeWe Gig",
  "category": "E-Commerce & Retail",
  "description": "Search local tasks, estimate prices, draft and post service jobs on the MeWe Gig marketplace.",
  "tools": [
    {
      "name": "list_categories",
      "description": "All task categories (slug + name).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "locale": {
            "description": "en | ur | ar | fr | sw",
            "type": "string"
          }
        }
      }
    },
    {
      "name": "list_cities",
      "description": "Cities where the marketplace operates, with currency.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "search_tasks",
      "description": "Search open tasks by text, category, city, location radius, remote-only and budget (major units).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "city": {
            "description": "city slug, e.g. lahore",
            "type": "string"
          },
          "category": {
            "description": "category slug, e.g. plumbing",
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "radiusKm": {
            "type": "number"
          },
          "remote": {
            "type": "boolean"
          },
          "minBudget": {
            "type": "number"
          },
          "maxBudget": {
            "type": "number"
          },
          "page": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        }
      }
    },
    {
      "name": "get_task",
      "description": "Full details of a task by id.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "draft_task",
      "description": "Turn a rough request in any language into a structured task draft (does not post it).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "city": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "estimate_price",
      "description": "Fair local price range for a task in a category and city.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "category",
          "city"
        ]
      }
    },
    {
      "name": "post_task",
      "description": "Publish a task on behalf of the API-key owner. Confirm details with the user first. Budget in major units.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "locationType": {
            "default": "in_person",
            "type": "string",
            "enum": [
              "in_person",
              "remote"
            ]
          },
          "address": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "budget": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "budgetType": {
            "default": "fixed",
            "type": "string",
            "enum": [
              "fixed",
              "hourly"
            ]
          },
          "hours": {
            "type": "number"
          },
          "paymentPref": {
            "default": "online",
            "type": "string",
            "enum": [
              "online",
              "cash"
            ]
          },
          "dueType": {
            "default": "flexible",
            "type": "string",
            "enum": [
              "flexible",
              "on_date",
              "before_date"
            ]
          },
          "dueAt": {
            "description": "ISO date",
            "type": "string"
          }
        },
        "required": [
          "title",
          "description",
          "category",
          "budget"
        ]
      }
    },
    {
      "name": "list_my_tasks",
      "description": "Tasks the key owner posted (role=poster) or is doing (role=tasker).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "role": {
            "default": "poster",
            "type": "string",
            "enum": [
              "poster",
              "tasker"
            ]
          }
        }
      }
    },
    {
      "name": "list_offers",
      "description": "Offers on a task (all offers if you are the poster).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          }
        },
        "required": [
          "taskId"
        ]
      }
    },
    {
      "name": "accept_offer",
      "description": "Accept an offer (poster only). Creates a booking; online tasks then need payment in the app.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "offerId": {
            "type": "string"
          }
        },
        "required": [
          "offerId"
        ]
      }
    },
    {
      "name": "make_offer",
      "description": "Send an offer on a task as a tasker. Amount in major units.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "taskId",
          "amount",
          "message"
        ]
      }
    },
    {
      "name": "get_wallet",
      "description": "Tasker wallet balances and commission due.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_booking",
      "description": "Status of a booking you are part of.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "string"
          }
        },
        "required": [
          "bookingId"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.mewegig/marketplace",
    "version": "1.0.0",
    "remoteUrl": "https://mewegig.com/mcp",
    "publishedAt": "2026-11-24T08:10:30.912673Z",
    "fetchedAt": "2026-11-24T12:15:48.059Z",
    "toolsSha256": "59df47a9e0bb59a3029a197700c13189ada15ed8994e63d2e60cc32193c33102"
  }
}
