{
  "$schema": "../schema.json",
  "name": "com.neuralroles/ai-jobs",
  "title": "Neural Roles: AI jobs",
  "category": "Other",
  "description": "Search open AI and machine learning jobs, and AI training work, from employers' own careers sites.",
  "tools": [
    {
      "name": "search_jobs",
      "description": "Search open artificial intelligence and machine learning jobs, and AI training work (AI trainers, evaluators, annotators), at companies worldwide. Returns the newest matches first, or the best matches for the query. Each job's url is its Neural Roles page, with the full description and the link to apply.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Natural language search query, e.g. 'machine learning engineer', 'LLM', 'AI trainer spanish'. May be empty."
          },
          "location": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              },
              "country": {
                "type": "string",
                "description": "ISO 3166-1 alpha-2 code, e.g. ES, US. Remote jobs open to it count."
              },
              "remote_ok": {
                "type": "boolean"
              },
              "remote_policy": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "on_site",
                    "hybrid",
                    "remote",
                    "flexible"
                  ]
                }
              }
            }
          },
          "filters": {
            "type": "object",
            "properties": {
              "employment_type": {
                "type": "string",
                "description": "full_time, part_time, contract, internship, temporary"
              },
              "salary_min": {
                "type": "number",
                "description": "Yearly, in US dollars"
              },
              "salary_max": {
                "type": "number",
                "description": "Yearly, in US dollars"
              },
              "experience_level": {
                "type": "string",
                "description": "intern, entry, mid, senior, staff, principal, manager, director"
              },
              "posted_within_days": {
                "type": "integer"
              }
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "integer",
                "default": 10,
                "maximum": 50
              },
              "offset": {
                "type": "integer",
                "default": 0
              }
            }
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_job_detail",
      "description": "Full details of one job from search_jobs: description, pay, skills, location and its Neural Roles page, where the candidate applies through the employer's site.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "description": "The ojcp_id from search_jobs"
          }
        },
        "required": [
          "job_id"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.neuralroles/ai-jobs",
    "version": "1.0.1",
    "remoteUrl": "https://neuralroles.com/ojcp/mcp",
    "publishedAt": "2026-11-22T14:09:41.815792Z",
    "fetchedAt": "2026-11-23T16:50:40.239Z",
    "toolsSha256": "5020baf9c578203b104c0a9292169766b9957047e824d9c86cef6374da92c12d"
  }
}
