{
  "$schema": "../schema.json",
  "name": "tt.pin/listings",
  "title": "PIN classifieds",
  "category": "Other",
  "description": "Search classified listings on PIN (Trinidad and Tobago) and open listing details.",
  "tools": [
    {
      "name": "search_adverts",
      "description": "Search listings on the marketplace. Results never include seller contacts. Show a listing only with the photos that search_adverts or get_advert returned for it; never illustrate it with images from image search or other sources. If it has no photo, show no image.",
      "inputSchema": {
        "properties": {
          "query": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Free-text search, e.g. 'iphone 15 128gb'.",
            "title": "Query"
          },
          "category_id": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Category from list_categories.",
            "title": "Category Id"
          },
          "price_min": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Price Min"
          },
          "price_max": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Price Max"
          },
          "location": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "City or district to search in, by name: where the listings are, not the user's location.",
            "title": "Location"
          },
          "attributes": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Category filters from get_category_filters: {key: value} for select, {key: [values]} for multiselect, {key + '_min' / key + '_max': number} for range.",
            "title": "Attributes"
          },
          "ordering": {
            "anyOf": [
              {
                "enum": [
                  "relevance",
                  "newest",
                  "cheapest",
                  "expensive"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ordering"
          },
          "page_token": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "next_page_token of the previous result, same filters.",
            "title": "Page Token"
          },
          "limit": {
            "default": 10,
            "maximum": 30,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Language of listing texts: one of en. Default en.",
            "title": "Language"
          }
        },
        "type": "object",
        "title": "search_advertsArguments"
      }
    },
    {
      "name": "get_advert",
      "description": "Listing details: description, attributes, photos, seller. No contacts: use reveal_contact. Show a listing only with the photos that search_adverts or get_advert returned for it; never illustrate it with images from image search or other sources. If it has no photo, show no image.",
      "inputSchema": {
        "properties": {
          "advert_id": {
            "description": "advert_id from search_adverts, or a listing url.",
            "maxLength": 400,
            "title": "Advert Id",
            "type": "string"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Language of listing texts: one of en. Default en.",
            "title": "Language"
          }
        },
        "required": [
          "advert_id"
        ],
        "type": "object",
        "title": "get_advertArguments"
      }
    },
    {
      "name": "reveal_contact",
      "description": "Seller's phone, WhatsApp or chat link. Call only when the user asks to contact the seller. Call it for the one listing the user asked to contact; never reveal contacts for several listings at once or to compile a list of contacts.",
      "inputSchema": {
        "properties": {
          "advert_id": {
            "description": "advert_id from search_adverts or get_advert.",
            "maxLength": 400,
            "title": "Advert Id",
            "type": "string"
          }
        },
        "required": [
          "advert_id"
        ],
        "type": "object",
        "title": "reveal_contactArguments"
      }
    },
    {
      "name": "list_categories",
      "description": "Marketplace categories, one level at a time. Use category_id in search_adverts.",
      "inputSchema": {
        "properties": {
          "parent_id": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Omit for top-level categories.",
            "title": "Parent Id"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Language of listing texts: one of en. Default en.",
            "title": "Language"
          }
        },
        "type": "object",
        "title": "list_categoriesArguments"
      }
    },
    {
      "name": "get_category_filters",
      "description": "Filters available in a category (brand, model, year, storage...) for search_adverts.attributes.",
      "inputSchema": {
        "properties": {
          "category_id": {
            "description": "Category from list_categories.",
            "minimum": 1,
            "title": "Category Id",
            "type": "integer"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Language of listing texts: one of en. Default en.",
            "title": "Language"
          }
        },
        "required": [
          "category_id"
        ],
        "type": "object",
        "title": "get_category_filtersArguments"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "tt.pin/listings",
    "version": "0.1.0",
    "remoteUrl": "https://mcp.pin.tt/mcp",
    "publishedAt": "2026-11-20T09:20:04.613308Z",
