{
  "$schema": "../schema.json",
  "name": "io.github.balrok12/choiflix",
  "title": "CHOIFLIX AI Pricing",
  "category": "AI, LLMs & Agents",
  "description": "Compare AI generation costs, inspect model and platform rate cards, and find visual prompts.",
  "tools": [
    {
      "name": "quote_cheapest_platform",
      "description": "Compare one generation, or set monthly_project to budget for finished outputs and retries at regular subscription prices. Rank only current, comparable USD prices verified for U.S. customers. Other and unconfirmed markets appear in reference_prices with no rank. The currency argument converts the output amount.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model_id": {
            "type": "string",
            "description": "Model ID or name (e.g. 'seedance-2-5', 'kling-4-0', 'pika-2-5')."
          },
          "resolution": {
            "type": "string",
            "description": "Resolution tier (e.g. '480p', '720p', '1080p', '4k', '2k')."
          },
          "qty": {
            "type": "number",
            "description": "Duration in seconds (for video/audio) or image count."
          },
          "billing": {
            "type": "string",
            "enum": [
              "all",
              "monthly",
              "annual"
            ],
            "description": "One generation defaults to all billing cycles, including active promotions. Monthly projects default to monthly billing at regular prices."
          },
          "monthly_project": {
            "type": "object",
            "additionalProperties": false,
            "description": "Return monthly estimates for a finished output target. A plan must cover all required generations to rank.",
            "properties": {
              "clips": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000,
                "default": 30,
                "description": "Finished outputs per month."
              },
              "tries": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "default": 2,
                "description": "Generation attempts per finished output."
              },
              "aspect": {
                "type": "string",
                "maxLength": 32,
                "description": "Optional verified aspect ratio, e.g. 16:9."
              },
              "audio": {
                "type": "string",
                "enum": [
                  "on",
                  "off"
                ],
                "description": "Optional verified audio condition."
              }
            }
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "KRW",
              "JPY",
              "EUR",
              "CNY",
              "GBP",
              "BRL",
              "INR",
              "MXN"
            ],
            "description": "Output currency."
          }
        },
        "required": [
          "model_id"
        ]
      }
    },
    {
      "name": "get_platform_rate_card",
      "description": "Return modeled credit consumption and U.S. generation costs for a platform, with pricing evidence. Prices from other or unconfirmed markets are returned separately in reference_prices.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "description": "Platform slug (e.g. 'higgsfield', 'freepik', 'fal', 'pika')."
          },
          "plan_id": {
            "type": "string",
            "description": "Optional plan ID (e.g. 'starter', 'plus', 'ultra')."
          },
          "subscriber": {
            "type": "string",
            "enum": [
              "new",
              "existing"
            ],
            "description": "Defaults to new signups. Set existing with your current plan_id to check the regular renewal rate."
          },
          "billing": {
            "type": "string",
            "enum": [
              "monthly",
              "annual"
            ],
            "description": "Subscription billing cycle."
          },
          "purchase_offer_id": {
            "type": "string",
            "description": "Optional active purchase offer ID for the selected plan."
          },
          "resolution": {
            "type": "string",
            "description": "Optional resolution ('720p', '1080p')."
          },
          "qty": {
            "type": "number",
            "description": "Optional duration in seconds (default 5)."
          }
        },
        "required": [
          "platform"
        ]
      }
    },
    {
      "name": "list_indexed_models_and_platforms",
      "description": "List the indexed AI models and creator platforms across Video, Image, Music, Voice, SFX, Studio, and LLM.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "video",
              "image",
              "music",
              "voice",
              "sfx",
              "studio",
              "llm",
              "audio",
              "avatar",
              "edit"
            ]
          }
        }
      }
    },
    {
      "name": "get_visual_recipes",
      "description": "Fetch tested cinematography, product ad, narration, and vertical shorts prompts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.balrok12/choiflix",
    "version": "5.0.0",
    "remoteUrl": "https://choiflix.md/mcp",
    "publishedAt": "2026-11-26T17:15:40.078701Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "7c394a59b884b6923658ce98a787b79e06f74f0f1908e9221af73d391902702c"
  }
}
