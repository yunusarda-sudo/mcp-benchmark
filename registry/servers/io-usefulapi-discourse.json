{
  "$schema": "../schema.json",
  "name": "io.usefulapi/discourse",
  "title": "Discourse MCP by usefulapi",
  "category": "Communication & Alerting",
  "description": "Search topics and posts; create topics, reply and mark notifications read in Discourse.",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "tools": [
    {
      "name": "discourse_search",
      "description": "Search topics, posts, users and categories of the forum for a term. Returns matching posts and topics with their ids. Discourse API: GET /search.json?q=.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Search term; supports Discourse search syntax such as in:title or #category."
          },
          "page": {
            "description": "Page number, starting at 0.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "discourse_list_latest_topics",
      "description": "List the latest topics of the forum, newest activity first by default. Discourse API: GET /latest.json.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "order": {
            "description": "Sort order (default: activity).",
            "type": "string",
            "enum": [
              "default",
              "created",
              "activity",
              "views",
              "posts",
              "likes",
              "op_likes"
            ]
          },
          "ascending": {
            "description": "Sort ascending instead of descending.",
            "type": "boolean"
          },
          "per_page": {
            "description": "Topics per page.",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "page": {
            "description": "Page number, starting at 0.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    {
      "name": "discourse_list_top_topics",
      "description": "List the top topics of the forum for a period. Discourse API: GET /top.json.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "period": {
            "description": "Period (default: all).",
            "type": "string",
            "enum": [
              "all",
              "yearly",
              "quarterly",
              "monthly",
              "weekly",
              "daily"
            ]
          },
          "per_page": {
            "description": "Topics per page.",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    {
      "name": "discourse_get_topic",
      "description": "Get one topic with its title, category, tags and the first posts of its post stream. Discourse API: GET /t/{id}.json.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "topic_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Numeric id."
          }
        },
        "required": [
          "topic_id"
        ]
      }
    },
    {
      "name": "discourse_get_post",
      "description": "Get one post with its raw Markdown, author and cooked HTML. Discourse API: GET /posts/{id}.json.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "post_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Numeric id."
          }
        },
        "required": [
          "post_id"
        ]
      }
    },
    {
      "name": "discourse_list_categories",
      "description": "List the categories of the forum with their ids, slugs and colours. Discourse API: GET /categories.json.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "include_subcategories": {
            "description": "Include subcategories in the list.",
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "discourse_list_tags",
      "description": "List the tags of the forum with their topic counts. Discourse API: GET /tags.json.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    },
    {
      "name": "discourse_get_user",
      "description": "Get a user's profile by username: name, trust level, groups and activity counts. Discourse API: GET /u/{username}.json.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,60}$",
            "description": "Forum username."
          }
        },
        "required": [
          "username"
        ]
      }
    },
    {
      "name": "discourse_list_notifications",
      "description": "List the notifications of the user the key acts as: replies, mentions, likes and messages. Discourse API: GET /notifications.json.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    },
    {
      "name": "discourse_list_private_messages",
      "description": "List the private message topics received by a user. Discourse API: GET /topics/private-messages/{username}.json.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,60}$",
            "description": "Forum username."
          }
        },
        "required": [
          "username"
        ]
      }
    },
    {
      "name": "discourse_get_site_info",
      "description": "Get the forum's basic information: title, description, logo and version. Discourse API: GET /site/basic-info.json.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    },
    {
      "name": "discourse_create_topic",
      "description": "Create a new public topic in a category as the key's user. Publishes content on the forum: confirm the text first. Discourse API: POST /posts.json.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Topic title."
          },
          "raw": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000,
            "description": "First post body in Markdown."
          },
          "category_id": {
            "description": "Category id (from discourse_list_categories).",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "title",
          "raw"
        ]
      }
    },
    {
      "name": "discourse_reply_to_topic",
      "description": "Post a reply in an existing topic as the key's user. Publishes content on the forum: confirm the text first. Discourse API: POST /posts.json.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "topic_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "Numeric id."
          },
          "raw": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000,
            "description": "Reply body in Markdown."
          },
          "reply_to_post_number": {
            "description": "Post number this reply answers.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "topic_id",
          "raw"
        ]
      }
    },
    {
      "name": "discourse_mark_notifications_read",
      "description": "Mark all notifications of the key's user as read, or one notification by id. Discourse API: PUT /notifications/mark-read.json.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "id": {
            "description": "Notification id; omit to mark all as read.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.usefulapi/discourse",
    "version": "1.1.0",
    "remoteUrl": "https://discourse.usefulapi.io/mcp",
    "publishedAt": "2026-11-26T10:26:13.220557Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "a616a2f3f61262528560d5995aea62190aad46f71666c899ac4d79e59c04f49f"
  }
}
