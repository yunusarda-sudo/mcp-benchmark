{
  "$schema": "../schema.json",
  "name": "com.frenyap/passo",
  "title": "PASSO",
  "category": "Travel, Maps & Navigation",
  "description": "Motorcycle passes and curvy roads: list passes, get pass details, plan winding routes. Read-only.",
  "tools": [
    {
      "name": "find_place",
      "description": "Finds up to 5 places matching a name in one country and returns their names and coordinates. Results come from OpenStreetMap data.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "maxLength": 2,
            "pattern": "^[A-Za-z]{2}$",
            "description": "Two-letter ISO 3166-1 country code, for example DE"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Name to search for"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Maximum number of results"
          },
          "lang": {
            "type": "string",
            "maxLength": 8,
            "description": "Optional language code for the reply, for example en"
          }
        },
        "required": [
          "country",
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "find_motorcycle_passes",
      "description": "Lists up to 10 mountain passes and famous roads for motorcycles in one country, with their names, locations and elevations. Give a point and a radius to list the nearest first, or a name to filter; otherwise the most notable come first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "maxLength": 2,
            "pattern": "^[A-Za-z]{2}$",
            "description": "Two-letter ISO 3166-1 country code, for example DE"
          },
          "query": {
            "type": "string",
            "maxLength": 120,
            "description": "Optional name filter"
          },
          "near": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "lat",
              "lon"
            ],
            "additionalProperties": false,
            "description": "Optional point; results are ordered by distance from it"
          },
          "radius_km": {
            "type": "integer",
            "minimum": 5,
            "maximum": 300,
            "description": "Search radius around near, in kilometres (default 100)"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "Maximum number of results"
          }
        },
        "required": [
          "country"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_pass_details",
      "description": "Returns the details of one mountain pass or famous road: name, location, elevation, length, steepness, road surface and season where known, from its id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pass_id": {
            "type": "string",
            "maxLength": 130,
            "pattern": "^(wd:Q[1-9][0-9]{0,11}|osm:[nw][1-9][0-9]{0,14}|road-[a-z0-9-]{1,120}|road:[a-z]{2}:[a-z0-9-]{1,120})$",
            "description": "Pass id as returned by find_motorcycle_passes"
          }
        },
        "required": [
          "pass_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "plan_curvy_route",
      "description": "Plans a motorcycle route between two points in one country, with a choice of how winding the road should be, and returns the distance, the travel time and the main steps. It does not return a map, and riders must follow road signs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "maxLength": 2,
            "pattern": "^[A-Za-z]{2}$",
            "description": "Two-letter ISO 3166-1 country code, for example DE"
          },
          "from": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "lat",
              "lon"
            ],
            "additionalProperties": false,
            "description": "Start point: latitude and longitude"
          },
          "to": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "lat",
              "lon"
            ],
            "additionalProperties": false,
            "description": "End point: latitude and longitude"
          },
          "curviness": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1,
            "description": "0 for the direct motorcycle route, 1 for a more winding one"
          },
          "lang": {
            "type": "string",
            "maxLength": 8,
            "description": "Optional language code for the reply, for example en"
          }
        },
        "required": [
          "country",
          "from",
          "to"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.frenyap/passo",
    "version": "1.0.1",
    "remoteUrl": "https://passo-mcp.frenyap.com/mcp",
    "publishedAt": "2026-11-25T10:28:49.213192Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "84c568893c6abeb73d1129c55567deb7b13d94b314a874636174d071125cebe4"
  }
}
