{
  "$schema": "../schema.json",
  "name": "com.youneedtosign/sign",
  "title": "YouNeedToSign",
  "category": "Communication & Alerting",
  "description": "Sign a PDF, Word or image file in chat, or get a link for someone else to sign.",
  "tools": [
    {
      "name": "prepare_document",
      "description": "Use this when the user wants to sign a document, or have someone else sign it, and you can pass the file: an attached file, an upload_id from create_upload, an HTTPS link to the file, or a small file as base64. Accepts PDF, Word (.docx) or image (PNG/JPG) files up to 25 MB (base64 up to 3 MB). Stores the file on YouNeedToSign and opens a signing view where supported. Anyone with the document's link can open it until it is deleted automatically 72 hours after upload; saving does not extend this. Word files keep their text only. Keep document_id and manage_token for later steps. If you can't pass the file, call get_upload_page_link instead. Do not use for legal advice or to sign on behalf of someone else.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "file": {
            "type": "object",
            "properties": {
              "download_url": {
                "type": "string"
              },
              "file_id": {
                "type": "string"
              },
              "mime_type": {
                "type": "string"
              },
              "file_name": {
                "type": "string"
              }
            },
            "required": [
              "download_url",
              "file_id"
            ],
            "additionalProperties": false
          },
          "upload_id": {
            "type": "string",
            "pattern": "^[a-z0-9]{24}$"
          },
          "file_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "file_base64": {
            "type": "string",
            "maxLength": 4194304
          },
          "file_name": {
            "type": "string",
            "maxLength": 150
          },
          "mime_type": {
            "type": "string",
            "enum": [
              "application/pdf",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
              "image/png",
              "image/jpeg"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "create_upload",
      "description": "Use this when the user wants to sign a file that you can read but can't attach directly, such as a file in your sandbox or workspace. Returns a one-time upload URL. Upload the file with an HTTP PUT using exactly the given headers, then call prepare_document with upload_id. Accepts PDF, Word (.docx), PNG or JPG files up to 25 MB.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "file_name": {
            "type": "string",
            "maxLength": 150
          },
          "mime_type": {
            "type": "string",
            "enum": [
              "application/pdf",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
              "image/png",
              "image/jpeg"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 26214400
          }
        },
        "required": [
          "file_name",
          "mime_type",
          "size"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_upload_page_link",
      "description": "Use this when the user wants to sign a document but you can't pass the file to YouNeedToSign. Returns a link to youneedtosign.com, where the user opens the file in their browser and signs it. Nothing is uploaded unless they choose Share.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "sign_document_typed",
      "description": "Use this when the user wants their own typed name as the signature (and optionally a date) added without the signing view. Creates a new signed copy; the original is kept. Only sign with the user's own name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "pattern": "^[a-z0-9]{16}$"
          },
          "manage_token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{22,64}$"
          },
          "typed_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "date_text": {
            "type": "string",
            "maxLength": 40
          },
          "placement": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "auto"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "page": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "page",
                  "x",
                  "y"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "document_id",
          "manage_token",
          "typed_name"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "register_signed_document",
      "description": "Called by the YouNeedToSign signing view after the user signs. Saves the signed copy and returns its links.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "original_document_id": {
            "type": "string",
            "pattern": "^[a-z0-9]{16}$"
          },
          "manage_token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{22,64}$"
          },
          "upload_id": {
            "type": "string",
            "pattern": "^[a-z0-9]{24}$"
          }
        },
        "required": [
          "original_document_id",
          "manage_token",
          "upload_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_signing_link",
      "description": "Use this when the user wants a link so someone else can sign, or asks whether someone has saved a shared document. YouNeedToSign does not send emails; the user shares the link.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "pattern": "^[a-z0-9]{16}$"
          },
          "manage_token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{22,64}$"
          }
        },
        "required": [
          "document_id",
          "manage_token"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "delete_document",
      "description": "Use this when the user asks to delete their document and its signed copies now, before automatic deletion.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "pattern": "^[a-z0-9]{16}$"
          },
          "manage_token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{22,64}$"
          }
        },
        "required": [
          "document_id",
          "manage_token"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.youneedtosign/sign",
    "version": "1.0.0",
    "remoteUrl": "https://youneedtosign.com/mcp",
    "publishedAt": "2026-11-27T15:00:12.711064Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "633ef43950276a5d54954476438ac27e95b8e0bd48c360390bfe28dd0722cbe6"
  }
}
