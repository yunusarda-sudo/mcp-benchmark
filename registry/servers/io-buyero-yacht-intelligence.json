{
  "$schema": "../schema.json",
  "name": "io.buyero/yacht-intelligence",
  "category": "Vector DBs & AI Search",
  "description": "Read-only yacht inventory, published buyer requirements and brokerage services from BUYERO.",
  "tools": [
    {
      "name": "search_yachts",
      "description": "Search published yacht listings by literal text, type, location, year and asking price. Price filters require explicit currency; unknown values are excluded from filtered results. Availability and tax status are not independently verified.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minimum_year": {
            "type": "integer",
            "minimum": 1800,
            "maximum": 2100
          },
          "max_price": {
            "type": "number",
            "minimum": 0,
            "maximum": 2000000000
          },
          "currency": {
            "type": "string",
            "enum": [
              "EUR",
              "USD",
              "GBP"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "get_yacht_details",
      "description": "Retrieve one published yacht using its exact inventory ID, including original public photograph URLs where available.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "compare_yachts",
      "description": "Retrieve two to five published yachts side by side as reported, without converting currencies or estimating market value.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "minItems": 2,
            "maxItems": 5,
            "uniqueItems": true
          }
        },
        "required": [
          "ids"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "find_buyer_requests",
      "description": "Search only published confirmed editorial buyer briefs. No private buyers or CRM records. Confirmation is not a guarantee of current intent.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "get_services",
      "description": "Retrieve public BUYERO services and enquiry URLs. Does not submit an enquiry.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.buyero/yacht-intelligence",
    "version": "1.0.0",
    "remoteUrl": "https://buyero.io/mcp",
    "publishedAt": "2026-11-26T20:31:13.237228Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "f71116591fd9c62155e98323c26b55364c9d53a8c9929698851a2d9defff8aa8"
  }
}
