{
  "$schema": "../schema.json",
  "name": "com.dzbuild/dzship",
  "title": "dzship: shipping for Algeria",
  "category": "Other",
  "description": "Create, track, price and cancel cash-on-delivery parcels with 101 Algerian couriers. No login.",
  "tools": [
    {
      "name": "list_couriers",
      "description": "Find a courier: its key, the credential fields it needs and what it supports (create, track, rates, stop desks, label, cancel). Pass q to search by name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "example": "ecotrack"
          },
          "q": {
            "type": "string",
            "example": "rocket"
          }
        }
      }
    },
    {
      "name": "list_wilayas",
      "description": "The 58 wilayas couriers deliver to, in French and Arabic. Pass all=true for the 69 of the 2026 division, each with the code to ship it under.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "minimum": 1,
            "maximum": 69
          },
          "q": {
            "type": "string"
          },
          "all": {
            "type": "boolean",
            "description": "Include the wilayas created in 2026 that couriers do not accept yet"
          }
        }
      }
    },
    {
      "name": "list_communes",
      "description": "Communes in the spelling couriers accept. Pass wilaya, q or both: the full list is too large to return.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "wilaya": {
            "type": "integer",
            "minimum": 1,
            "maximum": 69
          },
          "q": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "create_parcel",
      "description": "Create a cash-on-delivery parcel on the merchant's courier account. The \"sandbox\" courier needs no credentials and creates nothing. Ask the user before creating a real parcel.",
      "inputSchema": {
        "type": "object",
        "required": [
          "courier",
          "order"
        ],
        "properties": {
          "courier": {
            "type": "string",
            "example": "yalidine"
          },
          "credentials": {
            "type": "object",
            "description": "The caller's own credentials for that courier, 1-8 string fields. Never stored. Omit entirely for the sandbox courier.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "options": {
            "type": "object",
            "properties": {
              "baseUrl": {
                "type": "string",
                "format": "uri",
                "description": "Tenant URL, accepted only for the generic \"ecotrack\" courier and only under *.ecotrack.dz. Every other courier has its own key and takes no URL."
              },
              "fromWilaya": {
                "type": "integer",
                "minimum": 1,
                "maximum": 58
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 30000
              }
            }
          },
          "order": {
            "type": "object",
            "required": [
              "recipient",
              "deliveryType",
              "productList",
              "codAmount"
            ],
            "properties": {
              "reference": {
                "type": "string",
                "maxLength": 64
              },
              "recipient": {
                "type": "object",
                "required": [
                  "fullName",
                  "phone",
                  "wilayaCode",
                  "communeName"
                ],
                "properties": {
                  "fullName": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 120
                  },
                  "phone": {
                    "type": "string",
                    "description": "Algerian mobile: 05/06/07"
                  },
                  "phoneAlt": {
                    "type": "string"
                  },
                  "wilayaCode": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 58
                  },
                  "communeName": {
                    "type": "string"
                  },
                  "addressLine": {
                    "type": "string",
                    "maxLength": 255
                  }
                }
              },
              "deliveryType": {
                "type": "string",
                "enum": [
                  "home",
                  "stopdesk"
                ]
              },
              "stopDeskId": {
                "type": "string"
              },
              "productList": {
                "type": "string",
                "maxLength": 500
              },
              "codAmount": {
                "type": "integer",
                "minimum": 0,
                "description": "Integer DZD"
              },
              "weightKg": {
                "type": "number"
              },
              "declaredValue": {
                "type": "integer"
              },
              "freeShipping": {
                "type": "boolean"
              },
              "isExchange": {
                "type": "boolean"
              },
              "hasOpenPackage": {
                "type": "boolean"
              },
              "notes": {
                "type": "string",
                "maxLength": 255
              }
            }
          }
        }
      }
    },
    {
      "name": "track_parcel",
      "description": "Status and event history of one parcel, in the same status vocabulary for every courier.",
      "inputSchema": {
        "type": "object",
        "required": [
          "courier",
          "trackingNumber"
        ],
        "properties": {
          "courier": {
            "type": "string"
          },
          "credentials": {
            "type": "object",
            "description": "The caller's own credentials for that courier, 1-8 string fields. Never stored. Omit entirely for the sandbox courier.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "options": {
            "type": "object",
            "properties": {
              "baseUrl": {
                "type": "string",
                "format": "uri",
                "description": "Tenant URL, accepted only for the generic \"ecotrack\" courier and only under *.ecotrack.dz. Every other courier has its own key and takes no URL."
              },
              "fromWilaya": {
                "type": "integer",
                "minimum": 1,
                "maximum": 58
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 30000
              }
            }
          },
          "trackingNumber": {
            "type": "string",
            "maxLength": 80
          }
        }
      }
    },
    {
      "name": "get_rates",
      "description": "Delivery and return fees for a route with one courier.",
      "inputSchema": {
        "type": "object",
        "required": [
          "courier",
          "query"
        ],
        "properties": {
          "courier": {
            "type": "string"
          },
          "credentials": {
            "type": "object",
            "description": "The caller's own credentials for that courier, 1-8 string fields. Never stored. Omit entirely for the sandbox courier.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "options": {
            "type": "object",
            "properties": {
              "baseUrl": {
                "type": "string",
                "format": "uri",
                "description": "Tenant URL, accepted only for the generic \"ecotrack\" courier and only under *.ecotrack.dz. Every other courier has its own key and takes no URL."
              },
              "fromWilaya": {
                "type": "integer",
                "minimum": 1,
                "maximum": 58
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 30000
              }
            }
          },
          "query": {
            "type": "object",
            "required": [
              "toWilaya",
              "deliveryType"
            ],
            "properties": {
              "fromWilaya": {
                "type": "integer",
                "minimum": 1,
                "maximum": 58
              },
              "toWilaya": {
                "type": "integer",
                "minimum": 1,
                "maximum": 58
              },
              "toCommune": {
                "type": "string"
              },
              "deliveryType": {
                "type": "string",
                "enum": [
                  "home",
                  "stopdesk"
                ]
              },
              "tier": {
                "type": "string",
                "enum": [
                  "express",
                  "economic"
                ]
              },
              "codAmount": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    {
      "name": "list_stop_desks",
      "description": "The stop desks a courier runs in one wilaya. Send a desk id as order.stopDeskId.",
      "inputSchema": {
        "type": "object",
        "required": [
          "courier",
          "wilayaCode"
        ],
        "properties": {
          "courier": {
            "type": "string",
            "example": "sandbox"
          },
          "credentials": {
            "type": "object",
            "description": "The caller's own credentials for that courier, 1-8 string fields. Never stored. Omit entirely for the sandbox courier.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "options": {
            "type": "object",
            "properties": {
              "baseUrl": {
                "type": "string",
                "format": "uri",
                "description": "Tenant URL, accepted only for the generic \"ecotrack\" courier and only under *.ecotrack.dz. Every other courier has its own key and takes no URL."
              },
              "fromWilaya": {
                "type": "integer",
                "minimum": 1,
                "maximum": 58
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 30000
              }
            }
          },
          "wilayaCode": {
            "type": "integer",
            "minimum": 1,
            "maximum": 58,
            "example": 31
          }
        }
      }
    },
    {
      "name": "cancel_parcel",
      "description": "Cancel a parcel before the courier collects it. Few couriers offer it: list_couriers says which. Ask the user first.",
      "inputSchema": {
        "type": "object",
        "required": [
          "courier",
          "trackingNumber"
        ],
        "properties": {
          "courier": {
            "type": "string",
            "example": "sandbox"
          },
          "credentials": {
            "type": "object",
            "description": "The caller's own credentials for that courier, 1-8 string fields. Never stored. Omit entirely for the sandbox courier.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "options": {
            "type": "object",
            "properties": {
              "baseUrl": {
                "type": "string",
                "format": "uri",
                "description": "Tenant URL, accepted only for the generic \"ecotrack\" courier and only under *.ecotrack.dz. Every other courier has its own key and takes no URL."
              },
              "fromWilaya": {
                "type": "integer",
                "minimum": 1,
                "maximum": 58
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 30000
              }
            }
          },
          "trackingNumber": {
            "type": "string",
            "maxLength": 80,
            "example": "DZTEST-1A2B3C"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.dzbuild/dzship",
    "version": "1.0.0",
    "remoteUrl": "https://freeship.dzbuild.com/mcp",
    "publishedAt": "2026-11-22T11:16:40.524026Z",
