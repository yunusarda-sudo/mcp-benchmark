            "properties": {
              "ucp-agent": {
                "type": "object",
                "properties": {
                  "profile": {
                    "type": "string",
                    "maxLength": 2048,
                    "format": "uri"
                  }
                },
                "required": [
                  "profile"
                ],
                "additionalProperties": {}
              }
            },
            "additionalProperties": {}
          },
          "cart": {
            "type": "object",
            "properties": {
              "line_items": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "description": "Sólo en update_cart: el id de una línea existente que se conserva.",
                      "type": "string",
                      "maxLength": 80
                    },
                    "item": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
