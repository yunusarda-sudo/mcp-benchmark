              "ids": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "description": "Hasta 20 identificadores: id de producto (prod_…), de variante (variant_…), SKU o handle."
              },
              "filters": {
                "type": "object",
                "properties": {
                  "categories": {
                    "description": "Nombres o ids de categoría (basta una).",
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    }
                  },
                  "price": {
                    "description": "Precio con IVA en pesos chilenos enteros (CLP no tiene decimales).",
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": {}
              },
              "context": {
                "description": "Señales provisionales del comprador (país, intención). Los precios siempre van en CLP.",
                "type": "object",
                "properties": {
                  "address_country": {
                    "type": "string",
                    "maxLength": 2
                  },
                  "address_region": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "intent": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "language": {
                    "type": "string",
                    "maxLength": 35
                  },
                  "currency": {
                    "type": "string",
                    "maxLength": 3
                  }
                },
                "additionalProperties": {}
              },
              "signals": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "attribution": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "ids"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "catalog"
        ],
        "additionalProperties": false
      }
    },
