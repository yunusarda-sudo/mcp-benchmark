                      "additionalProperties": {}
                    },
                    "quantity": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 999
                    }
                  },
                  "required": [
                    "item",
                    "quantity"
                  ],
                  "additionalProperties": false
                }
              },
              "context": {
                "description": "Señales provisionales del comprador (país, intención). Los precios siempre van en CLP.",
                "type": "object",
                "properties": {
                  "address_country": {
                    "type": "string",
                    "maxLength": 2
                  },
                  "address_region": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "intent": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "language": {
                    "type": "string",
                    "maxLength": 35
                  },
                  "currency": {
                    "type": "string",
                    "maxLength": 3
                  }
                },
                "additionalProperties": {}
