{
  "$schema": "../schema.json",
  "name": "cl.kruuse/tienda",
  "title": "Kruuse Chile",
  "category": "Finance, Crypto & Web3",
  "description": "Machinery and tools in Chile: search the catalog, prices with VAT and stock, and build a cart.",
  "repository": "https://github.com/KSS-Develop/kruuse-claude-plugin",
  "tools": [
    {
      "name": "search_catalog",
      "description": "Busca productos de Kruuse Chile por texto (producto, modelo, marca o SKU) y filtros de categoría o precio con IVA. Devuelve productos con variantes, precio, disponibilidad y url. Para la página siguiente repite la llamada con pagination.cursor.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "meta": {
            "description": "Metadatos de UCP: {\"ucp-agent\": {\"profile\": URL del perfil del agente}}. Opcional en esta tienda.",
            "type": "object",
            "properties": {
              "ucp-agent": {
                "type": "object",
                "properties": {
                  "profile": {
                    "type": "string",
                    "maxLength": 2048,
                    "format": "uri"
                  }
                },
                "required": [
                  "profile"
                ],
                "additionalProperties": {}
              }
            },
            "additionalProperties": {}
          },
          "catalog": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "description": "Texto libre: producto, modelo, marca o SKU (obligatorio; los filtros acotan la búsqueda)."
              },
              "context": {
                "description": "Señales provisionales del comprador (país, intención). Los precios siempre van en CLP.",
                "type": "object",
                "properties": {
                  "address_country": {
                    "type": "string",
                    "maxLength": 2
                  },
                  "address_region": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "intent": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "language": {
                    "type": "string",
                    "maxLength": 35
                  },
                  "currency": {
                    "type": "string",
                    "maxLength": 3
                  }
                },
                "additionalProperties": {}
              },
              "filters": {
                "type": "object",
                "properties": {
                  "categories": {
                    "description": "Nombres o ids de categoría (basta una).",
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    }
                  },
                  "price": {
                    "description": "Precio con IVA en pesos chilenos enteros (CLP no tiene decimales).",
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": {}
              },
              "signals": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "attribution": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "pagination": {
                "description": "cursor: el de la respuesta anterior para la página siguiente. limit: tamaño pedido (por omisión 10, máximo 24).",
                "type": "object",
                "properties": {
                  "cursor": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "query"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "catalog"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "lookup_catalog",
      "description": "Revalida hasta 20 productos o variantes por id, SKU o handle (precio y disponibilidad de ahora). Cada variante indica en inputs qué identificador la resolvió; los que no existen llegan en messages con code not_found.",
