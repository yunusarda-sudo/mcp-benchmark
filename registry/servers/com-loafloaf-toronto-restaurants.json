{
  "$schema": "../schema.json",
  "name": "com.loafloaf/toronto-restaurants",
  "title": "LoafLoaf Toronto Restaurants",
  "category": "Other",
  "description": "Toronto and GTA restaurant search, menus, CAD prices, hours, awards and reservation links.",
  "tools": [
    {
      "name": "find_restaurant",
      "description": "Look up a Toronto restaurant you already have a name for.\n\nReturns candidates, each with name_match (exact | partial | fuzzy | none) and a place_id.\nAn exact match is the restaurant; otherwise check the address. Next: get_restaurant(place_id)\nor get_menu(place_id).",
      "inputSchema": {
        "properties": {
          "name": {
            "description": "The restaurant's name, as the user or a web page wrote it.",
            "title": "Name",
            "type": "string"
          },
          "near": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional location to disambiguate branches: coordinates, postal code, address or neighbourhood. Without it the name is searched across Toronto.",
            "title": "Near"
          },
          "limit": {
            "default": 5,
            "description": "Most candidates to return.",
            "maximum": 10,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "name"
        ],
        "type": "object",
        "title": "find_restaurantArguments"
      }
    },
    {
      "name": "search_restaurants",
      "description": "Find restaurants around a location, with Google's filters plus a per-person budget.\n\nEach result has a place_id, rating, price range, distance, whether it is open now and any\nawards. `excluded` counts places dropped by the filters and why. Next: get_restaurant(place_id)\nfor hours, booking and ordering links; get_menu(place_id) for the menu.",
      "inputSchema": {
        "properties": {
          "near": {
            "description": "The user's location: 'lat,lng' coordinates, a postal code ('M6J 1G1'), an address, an intersection ('Queen and Ossington') or a neighbourhood ('Little Italy').",
            "title": "Near",
            "type": "string"
          },
          "cuisine": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Cuisine or kind of place: 'italian', 'korean bbq', 'sushi', 'ramen', 'steak house', 'cafe', 'bar', 'vegan'. Matched to Google's place types when one exists.",
            "title": "Cuisine"
          },
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Free text Google matches against places, e.g. 'tapas', 'patio', 'date night', 'tasting menu'.",
            "title": "Query"
          },
          "radius_m": {
            "default": 2000,
            "description": "Hard limit on distance, metres.",
            "maximum": 50000,
            "minimum": 100,
            "title": "Radius M",
            "type": "number"
          },
          "open_now": {
            "default": false,
            "title": "Open Now",
            "type": "boolean"
          },
          "open_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Open at a local day and time, e.g. 'fri 19:30' or 'saturday 11am'.",
            "title": "Open At"
          },
          "price_levels": {
            "anyOf": [
              {
                "items": {
                  "maximum": 4,
                  "minimum": 1,
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Google price levels to keep: 1=$ 2=$$ 3=$$$ 4=$$$$.",
            "title": "Price Levels"
          },
          "budget_min": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Per person, CAD.",
            "title": "Budget Min"
          },
          "budget_max": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Per person, CAD. Compared with Google's per-person price range (e.g. '$50-100').",
            "title": "Budget Max"
          },
          "include_unknown_price": {
            "default": false,
            "description": "With a budget, also keep places Google has no price range for.",
            "title": "Include Unknown Price",
            "type": "boolean"
          },
          "min_rating": {
            "anyOf": [
              {
                "maximum": 5,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Min Rating"
          },
          "min_reviews": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Min Reviews"
          },
          "features": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "accepts_cash_only",
                    "accepts_credit_cards",
                    "accepts_debit_cards",
                    "accepts_nfc",
                    "allows_dogs",
                    "curbside_pickup",
                    "delivery",
                    "dine_in",
                    "free_garage_parking",
                    "free_parking_lot",
                    "free_street_parking",
                    "good_for_children",
                    "good_for_groups",
                    "good_for_watching_sports",
                    "live_music",
                    "menu_for_children",
                    "outdoor_seating",
                    "paid_garage_parking",
                    "paid_parking_lot",
                    "paid_street_parking",
                    "reservable",
                    "restroom",
                    "serves_beer",
                    "serves_breakfast",
                    "serves_brunch",
                    "serves_cocktails",
                    "serves_coffee",
                    "serves_dessert",
                    "serves_dinner",
                    "serves_lunch",
                    "serves_vegetarian_food",
                    "serves_wine",
                    "takeout",
                    "valet_parking",
                    "wheelchair_accessible_entrance",
                    "wheelchair_accessible_parking",
                    "wheelchair_accessible_restroom",
                    "wheelchair_accessible_seating"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Attributes that must all be true, e.g. ['reservable', 'outdoor_seating'].",
            "title": "Features"
          },
          "sort": {
            "default": "relevance",
            "enum": [
              "relevance",
              "distance",
              "rating",
              "reviews",
              "price"
            ],
            "title": "Sort",
            "type": "string"
          },
          "limit": {
            "default": 10,
            "maximum": 20,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "near"
        ],
        "type": "object",
        "title": "search_restaurantsArguments"
      }
    },
    {
      "name": "get_restaurant",
      "description": "One restaurant's full profile: weekly hours (and kitchen, brunch, happy-hour hours), price\nper person, phone, website, how to book (booking platform link, the restaurant's own booking\npage, or phone), ordering links (own storefront, delivery apps), amenities (reservable,\noutdoor seating, vegetarian food...) and awards. Takes a few seconds: it reads the\nrestaurant's website for booking and ordering links.",
      "inputSchema": {
        "properties": {
          "place_id": {
            "description": "place_id from find_restaurant or search_restaurants.",
            "title": "Place Id",
            "type": "string"
          }
        },
        "required": [
          "place_id"
        ],
        "type": "object",
        "title": "get_restaurantArguments"
      }
    },
    {
      "name": "get_menu",
      "description": "The menu, read from the restaurant's own website: sections and items with prices as\nprinted. Menus that are only images or scanned PDFs come back as attached images for you\nto read; a result holds a few, and says how to get the rest. Typically 5-90 s the first\ntime (slow sites can take longer), then served from cache for the configured lifetime. `website_status` explains an empty result\n(no_menu_found, blocked, robots_disallowed, unreachable...).",
      "inputSchema": {
        "properties": {
          "place_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "place_id from find_restaurant or search_restaurants.",
            "title": "Place Id"
          },
          "website": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The restaurant's website, when you have it and no place_id.",
            "title": "Website"
          },
          "media_offset": {
            "default": 0,
            "description": "Index of the first menu image to attach. A result that could not attach every image says which offset to ask for next.",
            "minimum": 0,
            "title": "Media Offset",
            "type": "integer"
          }
        },
        "type": "object",
        "title": "get_menuArguments"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.loafloaf/toronto-restaurants",
    "version": "0.1.0",
    "remoteUrl": "https://www.loafloaf.com/mcp",
    "publishedAt": "2026-11-23T02:09:09.094837Z",
    "fetchedAt": "2026-11-23T16:50:40.239Z",
