{
  "$schema": "../schema.json",
  "name": "uk.co.candid-finance/calculators",
  "title": "Candid calculators",
  "category": "Finance, Crypto & Web3",
  "description": "Free UK personal finance calculators: £100k tax trap, student loan overpaying, mortgage vs saving.",
  "repository": "https://github.com/CandidFinance/Candid-mcp",
  "tools": [
    {
      "name": "tax_trap_100k",
      "description": "Whether adjusted net income falls in the Personal Allowance taper (£100,000 to £125,140), what it costs including lost Tax-Free Childcare and funded hours, and the pension salary sacrifice that would bring income back to £100,000. UK only. Guidance, not regulated financial advice.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "salary": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000,
            "description": "Gross annual salary, £."
          },
          "bonus": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000,
            "description": "Annual bonus, £. Default 0."
          },
          "pension": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Pension salary sacrifice, % of salary. Default 0."
          },
          "kids": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10,
            "description": "Children under 5. Default 0."
          },
          "loan": {
            "type": "string",
            "enum": [
              "none",
              "plan1",
              "plan2",
              "plan4",
              "plan5",
              "postgrad"
            ],
            "description": "Student loan plan, if repaying one. Default none."
          }
        },
        "required": [
          "salary"
        ]
      }
    },
    {
      "name": "student_loan_overpay",
      "description": "Whether overpaying a UK student loan (Plan 1, 2, 4, 5 or Postgraduate) reduces total repayments, or only hands over money that would otherwise be written off. UK only. Guidance, not regulated financial advice.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "salary": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000,
            "description": "Gross annual salary, £."
          },
          "plan": {
            "type": "string",
            "enum": [
              "plan1",
              "plan2",
              "plan4",
              "plan5",
              "postgrad"
            ],
            "description": "Loan plan."
          },
          "balance": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000,
            "description": "Loan balance now, £."
          },
          "overpay": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000,
            "description": "Overpayment considered, £ a month."
          },
          "rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 20,
            "description": "The loan's interest rate, % a year, if known. Default: the plan's rate for this salary."
          },
          "growth": {
            "type": "string",
            "enum": [
              "stable",
              "moderate",
              "high"
            ],
            "description": "Salary growth: stable, moderate or high. Default stable."
          },
          "finished": {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2100,
            "description": "Year the course finished, which sets the write-off date."
          },
          "age": {
            "type": "integer",
            "minimum": 16,
            "maximum": 100,
            "description": "Age, used to estimate the write-off date when finished isn't given."
          }
        },
        "required": [
          "salary",
          "plan",
          "balance",
          "overpay"
        ]
      }
    },
    {
      "name": "mortgage_overpay_vs_savings",
      "description": "Over the time left on a fixed-rate mortgage, the value of overpaying against saving the same monthly amount, after tax and the Personal Savings Allowance. Without savingsRate, uses the highest easy-access rate Candid tracks. UK only. Guidance, not regulated financial advice.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "balance": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000,
            "description": "Mortgage balance, £."
          },
          "term": {
            "type": "number",
            "minimum": 1,
            "maximum": 40,
            "description": "Years left on the mortgage."
          },
          "rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 20,
            "description": "Mortgage rate, % a year."
          },
          "fixEnds": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$",
            "description": "When the fixed rate ends: YYYY-MM or YYYY-MM-DD, in the future."
          },
          "overpay": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000,
            "description": "Monthly amount to overpay or save, £."
          },
          "savingsRate": {
            "type": "number",
            "minimum": 0,
            "maximum": 20,
            "description": "Savings rate, % AER. Default: the highest easy-access rate Candid tracks."
          },
          "account": {
            "type": "string",
            "enum": [
              "isa",
              "standard"
            ],
            "description": "isa (Cash ISA, tax-free) or standard (taxed above the Personal Savings Allowance). Default isa."
          },
          "band": {
            "type": "string",
            "enum": [
              "basic",
              "higher",
              "additional"
            ],
            "description": "Income tax band, for tax on savings interest. Default basic."
          }
        },
        "required": [
          "balance",
          "term",
          "rate",
          "fixEnds",
          "overpay"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "uk.co.candid-finance/calculators",
    "version": "1.0.2",
    "remoteUrl": "https://www.candid-finance.co.uk/mcp",
    "publishedAt": "2026-11-25T13:03:17.433899Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "ddd6f2d2f53363bdc4f216394cf066257e9415c4c5e39bd5dbd0df3513ae1961"
  }
}
