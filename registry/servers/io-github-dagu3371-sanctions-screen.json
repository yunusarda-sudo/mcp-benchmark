{
  "$schema": "../schema.json",
  "name": "io.github.dagu3371/sanctions-screen",
  "title": "Sanctions Screen (OFAC, UN, EU, UK)",
  "category": "Developer Tools & DevOps",
  "description": "Fuzzy sanctions screening for people, companies, vessels: OFAC, UN, EU, UK. Pay per call via x402.",
  "tools": [
    {
      "name": "screen_sanctions",
      "description": "Fuzzy-match one name against US OFAC (SDN + Consolidated), UN, EU and UK sanctions lists. Returns scored candidate matches with programs, countries, DOB and list references. $0.005 per call after the free daily quota.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Person, company, vessel or aircraft name"
          },
          "type": {
            "type": "string",
            "enum": [
              "individual",
              "entity",
              "vessel",
              "aircraft"
            ]
          },
          "lists": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "OFAC",
                "UN",
                "EU",
                "UK"
              ]
            }
          },
          "min_score": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1,
            "description": "Match threshold, default 0.85"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "screen_sanctions_batch",
      "description": "Screen up to 10 names in one call against OFAC, UN, EU and UK sanctions lists. $0.05 per call after the free daily quota.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "names": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "minItems": 1,
            "maxItems": 10
          },
          "type": {
            "type": "string",
            "enum": [
              "individual",
              "entity",
              "vessel",
              "aircraft"
            ]
          },
          "lists": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "OFAC",
                "UN",
                "EU",
                "UK"
              ]
            }
          },
          "min_score": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1
          }
        },
        "required": [
          "names"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "sanctions_lists_status",
      "description": "Free. When the sanctions lists were last refreshed and how many entries each contains.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.dagu3371/sanctions-screen",
    "version": "1.0.0",
    "remoteUrl": "https://sanctions-screen.agent-data-apis.workers.dev/mcp",
    "publishedAt": "2026-11-17T17:13:20.821621Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "4254418b80da21e8cba5dd81e1bdc0debbf2cb412e0032b1577f7c28fc133e69"
  }
}
