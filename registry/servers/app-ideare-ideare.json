{
  "$schema": "../schema.json",
  "name": "app.ideare/ideare",
  "title": "ideare",
  "category": "Design, UI & 3D Media",
  "description": "A small business's brand kit: logo in every version, colors, fonts, social sizes and posts.",
  "tools": [
    {
      "name": "list_brands",
      "description": "The brands in your workspace, the most recently changed first, with the total. Each one says its current version and whether a change waits for approval. Costs no credits.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_brand",
      "description": "A brand with its draft: the masters (brand.json) as last saved, the draft's rev, the current version and any change waiting for approval. Send the rev back when you save or approve. Costs no credits.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$"
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "create_brand",
      "description": "Start a brand with a name, and the masters you drew so far if you have them. It starts as a private draft; nothing is public until an owner approves it. The slug comes from the name when you leave it out, and becomes the brand's address: ideare.app/b/<slug>. Costs no credits.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$"
          },
          "masters": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "schemaVersion",
              "name"
            ],
            "additionalProperties": {}
          },
          "origin": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "idea",
                  "link",
                  "files",
                  "try",
                  "import"
                ]
              },
              "idea": {
                "type": "string",
                "maxLength": 500
              },
              "url": {
                "type": "string",
                "maxLength": 2000,
                "format": "uri"
              },
              "seed": {
                "type": "string",
                "maxLength": 100
              },
              "picks": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              },
              "run": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200,
            "description": "A key you make up for this call. Send the SAME one again after a lost answer to get the first answer back, with nothing spent twice."
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "update_draft",
      "description": "Replace the draft's masters (brand.json). Send the draftRev you started from: if someone saved in between, you get a 409 with the current draft, so no change is lost. Saving publishes nothing. Costs no credits.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$"
          },
          "draftRev": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "masters": {
            "type": "object",
            "properties": {
              "schemaVersion": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "schemaVersion",
              "name"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "slug",
          "draftRev",
          "masters"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "approve_draft",
      "description": "From an owner or an admin: make the draft a new public version. Every file is drawn again and published at cdn.ideare.app/b/<slug>/v<n>/; follow the run to see it finish. From anyone else: ask the owner to approve this draft, which they do in one tap. Send the draftRev you looked at. Costs no credits.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$"
          },
          "draftRev": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200,
            "description": "A key you make up for this call. Send the SAME one again after a lost answer to get the first answer back, with nothing spent twice."
          }
        },
        "required": [
          "slug",
          "draftRev"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "check_brand",
      "description": "Check the draft the way an approval does: contrast, legibility at small sizes, text that fits, safe areas on every social size, and the copy rules. Each result says what to fix. Changes nothing. Costs no credits.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$"
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_versions",
      "description": "Every approved version of a brand, newest first, with what changed in each. Versions are public: no key needed. Costs no credits.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$"
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_version",
      "description": "One approved version and every file in it, each with its address and sha256. Ask for `latest` to get the version the brand points at now: the CLI resolves it here, then fetches the files of that exact version. Versions are public: no key needed. Costs no credits.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$"
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "const": "latest"
              },
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            ]
          }
        },
        "required": [
          "slug",
          "version"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "restore_version",
      "description": "Put an older version's masters back in the draft and approve them as a new version, so the history only grows. From anyone but an owner or admin, this asks the owner to approve instead. Send the draft's current draftRev: the draft is replaced. Costs no credits.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "draftRev": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200,
            "description": "A key you make up for this call. Send the SAME one again after a lost answer to get the first answer back, with nothing spent twice."
          }
        },
        "required": [
          "slug",
          "version",
          "draftRev"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_files",
      "description": "Every file of a version (the current one when you leave it out): logos, site icons, share cards, social sizes, tokens, the email signature, the business card. Each has its address, type, size and sha256. Pass a group (web, logo, og, social, tokens, registry, docs, email, print) to get one folder. Costs no credits.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$"
          },
          "version": {
            "default": "latest",
            "anyOf": [
              {
                "type": "string",
                "const": "latest"
              },
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            ]
          },
          "group": {
            "type": "string",
            "pattern": "^[a-z-]{2,20}$"
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "render_template",
      "description": "Draw one of the brand's post templates with your words, as PNG or JPEG, and get a link to it that works for an hour. Templates: promotion, hours, menu, pix (send the Pix key), new-product, status-offer and carousel (5 pages). Sizes: ig-post, ig-square, ig-story, wa-status and share-card. Words that don't fit are refused, with which slot to shorten. Uses the draft unless you name a version. Costs no credits, within the hourly render allowance.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$"
          },
          "template": {
            "type": "string",
            "enum": [
              "promotion",
              "hours",
              "menu",
              "pix",
              "new-product",
              "status-offer",
              "carousel"
            ]
          },
          "size": {
            "type": "string",
            "enum": [
              "ig-post",
              "ig-square",
              "ig-story",
              "wa-status",
              "share-card"
            ]
          },
          "text": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,40}$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 500
            }
          },
          "locale": {
            "type": "string",
            "enum": [
              "pt-BR",
              "en",
              "es"
            ]
          },
          "page": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 19
          },
          "pix": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 77
              },
              "city": {
                "type": "string",
                "minLength": 1,
                "maxLength": 15
              },
              "amount": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000
              }
            },
            "required": [
              "key"
            ],
            "additionalProperties": false
          },
          "format": {
            "default": "png",
            "type": "string",
            "enum": [
              "png",
              "jpeg"
            ]
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "slug",
          "template"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_run",
      "description": "Where a long job stands (drawing a version's files, AI pictures, an import): queued with its place in line, running, or finished with its result or what went wrong. For live updates, open its eventsUrl as Server-Sent Events. Costs no credits.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "cancel_run",
      "description": "Stop a run that is queued or running. Credits for pictures not made yet come back. A version's cascade can't be stopped: once approved, its files finish. Answers the run as it stands.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "generate_text",
      "description": "Suggestions from what the business does: names, taglines in each of the brand's languages, a voice, palette moods and font tags. Free, within a daily allowance (see get_usage).",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "idea": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "locales": {
            "default": [
              "pt-BR"
            ],
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "pt-BR",
                "en",
                "es"
              ]
            }
          },
          "brand": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$"
          }
        },
        "required": [
          "idea"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "generate_symbols",
      "description": "Draw up to 4 symbol ideas for the brand with AI: vector, no letters, in its colors. Costs 2 credits per idea, charged when the run starts and refunded for each idea that fails. A batch of 4 costs 8 credits. Answers with the run; each idea arrives as an event.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$"
          },
          "count": {
            "default": 4,
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "hint": {
            "type": "string",
            "maxLength": 200
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200,
            "description": "A key you make up for this call. Send the SAME one again after a lost answer to get the first answer back, with nothing spent twice."
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "generate_art",
      "description": "Draw a picture in the brand's own style with AI, from your prompt and the brand's references. A 1k draft costs 1 credit and a 2k keeper costs 2, taken when the run starts and given back if it fails. Answers with the run.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$"
          },
          "prompt": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1000
          },
          "size": {
            "default": "1k",
            "type": "string",
            "enum": [
              "1k",
              "2k"
            ]
          },
          "references": {
            "default": [],
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200,
            "description": "A key you make up for this call. Send the SAME one again after a lost answer to get the first answer back, with nothing spent twice."
          }
        },
        "required": [
          "slug",
          "prompt"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "import_link",
      "description": "Read a site or a social profile and pull out the name, the about text, up to 6 colors and the logo, in about 20 seconds. The logo comes as it was and as a clean vector. Free, within a daily allowance. Answers with the run; its result is what it found, to start a brand from.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 3,
            "maxLength": 2000
          },
          "brand": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "import_files",
      "description": "Read uploaded logos and pictures: find their colors and trace a logo into a clean vector, always next to your original. Upload first with create_upload. Free, within a daily allowance. Answers with the run.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "assetIds": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "brand": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$"
          }
        },
        "required": [
          "assetIds"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "import_folder",
      "description": "Sort a brand folder or zip you already uploaded (up to 200 files): logos in every version, fonts, a guide PDF, posts and photos. Code reads each file first, then AI looks at the pictures and reads the guide. Each file comes back with the slot it fits and how sure we are, and nothing changes in a brand until you call apply_import. Free, within the daily import allowance. Answers with the run; read it with get_folder_import.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "files": {
            "minItems": 1,
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "assetId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "assetId"
              ],
              "additionalProperties": false
            }
          },
          "brand": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200,
            "description": "A key you make up for this call. Send the SAME one again after a lost answer to get the first answer back, with nothing spent twice."
          }
        },
        "required": [
          "files"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "import_brand",
      "description": "Read up to 5 different sites or social profiles together with uploaded files (up to 200 files, 200 MB total, 25 MB per file) and optional local style files in repo. One daily import, one review and one private draft, never a redesign. Read with get_folder_import, choose sources where findings differ and confirm with apply_import. Upload files first with create_upload and complete_upload. A failed link does not discard other sources: retry only failed links with retryOf. Retries keep successful reads and do not use another daily import. Every provider read and model call is logged and budgeted. Nothing is public until approval.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "links": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
