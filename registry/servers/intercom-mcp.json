{
  "$schema": "../schema.json",
  "name": "Intercom MCP",
  "category": "Communication & Alerting",
  "description": "Intercom MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "reply_conversation",
      "description": "Send reply to customer conversation thread in Intercom inbox.",
      "inputSchema": {
        "type": "object",
        "required": [
          "conversationId",
          "body"
        ],
        "properties": {
          "conversationId": {
            "type": "string",
            "description": "Conversation ID."
          },
          "body": {
            "type": "string",
            "description": "Reply message text."
          }
        }
      }
    }
  ]
}
