{
  "$schema": "../schema.json",
  "name": "io.github.luthandomaqondo-95/agri-prices",
  "title": "Agri Prices (MCP Africa Master Class)",
  "category": "Developer Tools & VCS",
  "description": "Sample fresh-produce prices (ZAR/kg) for five South African markets. Teaching server.",
  "repository": "https://github.com/AppimateSA/mcp-masterclass",
  "tools": [
    {
      "name": "list_markets",
      "description": "List the South African fresh-produce markets this server has prices for.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_price",
      "description": "Get the average price (ZAR per kg) of a crop at one market. Returns provenance (source, asOf).",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "crop": {
            "type": "string",
            "enum": [
              "tomatoes",
              "potatoes",
              "onions",
              "cabbage",
              "carrots",
              "spinach"
            ],
            "description": "Crop name, e.g. tomatoes"
          },
          "marketId": {
            "type": "string",
            "enum": [
              "jhb",
              "tsh",
              "cpt",
              "dbn",
              "eln"
            ],
            "description": "Market id: jhb, tsh, cpt, dbn or eln (call list_markets to see them)"
          }
        },
        "required": [
          "crop",
          "marketId"
        ]
      }
    },
    {
      "name": "compare_markets",
      "description": "Compare a crop's price across all markets and report the cheapest, the dearest and the spread.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "crop": {
            "type": "string",
            "enum": [
              "tomatoes",
              "potatoes",
              "onions",
              "cabbage",
              "carrots",
              "spinach"
            ],
            "description": "Crop name, e.g. tomatoes"
          }
        },
        "required": [
          "crop"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.luthandomaqondo-95/agri-prices",
    "version": "0.3.0",
