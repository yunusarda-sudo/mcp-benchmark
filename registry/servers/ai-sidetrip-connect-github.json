{
  "$schema": "../schema.json",
  "name": "ai.sidetrip.connect/github",
  "title": "Sidetrip GitHub",
  "category": "Developer Tools & DevOps",
  "description": "Read-only explorer for public GitHub repos, releases, issues. Demo by Sidetrip Connect. No key.",
  "tools": [
    {
      "name": "search_repositories",
      "description": "Search public GitHub repositories. Use this to find projects by keywords, language, or star count. Returns a short list with name, description, stars, language, and URL.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "GitHub repository search query, such as language:typescript stars:>1000."
          },
          "limit": {
            "description": "How many results to return, from 1 to 10. Defaults to 5.",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "sort": {
            "description": "Sort key. Omit it to use GitHub's best-match order.",
            "type": "string",
            "enum": [
              "stars",
              "forks",
              "updated",
              "help-wanted-issues"
            ]
          },
          "order": {
            "description": "Sort direction.",
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_repository",
      "description": "Get one public GitHub repository by owner and name. Use this when the repository is already known. Returns stars, forks, license, default branch, topics, and URL. open_issues_count includes pull requests.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$",
            "description": "GitHub user or organization login."
          },
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,100}$",
            "description": "Repository name, without the owner."
          }
        },
        "required": [
          "owner",
          "repo"
        ]
      }
    },
    {
      "name": "list_releases",
      "description": "List recent releases for a public GitHub repository. Use this for tags and publish dates. Release note bodies are omitted.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$",
            "description": "GitHub user or organization login."
          },
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,100}$",
            "description": "Repository name, without the owner."
          },
          "limit": {
            "description": "How many results to return, from 1 to 10. Defaults to 5.",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "owner",
          "repo"
        ]
      }
    },
    {
      "name": "list_open_issues",
      "description": "List open issues for a public GitHub repository. Pull requests are omitted. Use this for current issues, not code or releases.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$",
            "description": "GitHub user or organization login."
          },
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,100}$",
            "description": "Repository name, without the owner."
          },
          "limit": {
            "description": "How many results to return, from 1 to 10. Defaults to 5.",
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "owner",
          "repo"
        ]
      }
    },
    {
      "name": "get_user_profile",
      "description": "Get a public GitHub user or organization profile by login. Returns name, bio, company, location, follower counts, and URL.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$",
            "description": "GitHub user or organization login."
          }
        },
        "required": [
          "username"
        ]
      }
    },
    {
      "name": "get_readme",
      "description": "Fetch a public repository README, truncated to a short excerpt. Use this for the maintainer's project overview.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$",
            "description": "GitHub user or organization login."
          },
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,100}$",
            "description": "Repository name, without the owner."
          },
          "ref": {
            "description": "Git branch, tag, or commit. Defaults to the repository default branch.",
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]{1,255}$"
          }
        },
        "required": [
          "owner",
          "repo"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "ai.sidetrip.connect/github",
    "version": "1.0.0",
    "remoteUrl": "https://demo-github.sidetrip.ai/mcp",
    "publishedAt": "2026-11-26T02:50:10.61199Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "856956afc36d21610f8b95b9ae662b6a3a27675d78df05f5cd0039eb42fe57db"
  }
}
