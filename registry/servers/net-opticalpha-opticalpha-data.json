{
  "$schema": "../schema.json",
  "name": "net.opticalpha/opticalpha-data",
  "title": "OpticAlpha Data",
  "category": "Other",
  "description": "Free, keyless OpticAlpha market data: options flow, GEX, 13F, yield curve, funding, Fed odds.",
  "repository": "https://github.com/OpticAlpha870/trading-terminal-docs",
  "tools": [
    {
      "name": "list_datasets",
      "description": "List the public OpticAlpha market datasets (slug and one-line description). Data is a delayed snapshot with a stated as_of time.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_dataset",
      "description": "Fetch one public OpticAlpha dataset by slug (see list_datasets). Returns JSON with stats, tables, as_of timestamp, license and citation, or Markdown if format is markdown.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "enum": [
              "analyst-rating-changes",
              "cftc-cot-positioning",
              "congress-trading",
              "cross-asset-volatility",
              "crowded-stocks",
              "crypto-etf-flows",
              "crypto-funding-open-interest",
              "crypto-liquidations",
              "crypto-regime",
              "dia-gamma-exposure",
              "earnings-implied-move",
              "fear-and-greed",
              "fed-rate-odds",
              "insider-trading",
              "institutional-buying",
              "nvda-gamma-exposure",
              "tsla-gamma-exposure",
              "aapl-gamma-exposure",
              "amd-gamma-exposure",
              "avgo-gamma-exposure",
              "mu-gamma-exposure",
              "pltr-gamma-exposure",
              "iwm-gamma-exposure",
              "max-pain",
              "options-sector-flow",
              "prediction-market-odds",
              "qqq-gamma-exposure",
              "short-squeeze",
              "spy-gamma-exposure",
              "treasury-yield-spreads",
              "unusual-options-activity",
              "us-funding-conditions",
              "us-yield-curve"
            ],
            "description": "Dataset slug"
          },
          "format": {
            "type": "string",
            "enum": [
              "json",
              "markdown"
            ],
            "description": "Defaults to json"
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "net.opticalpha/opticalpha-data",
    "version": "1.0.1",
    "remoteUrl": "https://mcp.opticalpha.net/mcp",
    "publishedAt": "2026-11-25T01:42:18.942231Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "3f42b356b3d52d120bbb13caba8f76d01c97e5a8445396c471f5f5e6eb89d150"
  }
}
