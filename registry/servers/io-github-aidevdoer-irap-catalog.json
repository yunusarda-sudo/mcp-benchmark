{
  "$schema": "../schema.json",
  "name": "io.github.AIdevdoer/irap-catalog",
  "title": "iRap Video Catalog",
  "category": "Developer Tools & DevOps",
  "description": "Read published iRap Video templates and how-to guides. No generation.",
  "tools": [
    {
      "name": "search_templates",
      "description": "Search published iRap Video templates by name, scene, role, or id. Omits drafts and archived templates. Does not generate a video.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 200
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "zh"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_template",
      "description": "Read one published template page: copy, roles, example media, related published templates, and the public credit offer when this id has one. Does not generate, upload, or charge.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "zh"
            ]
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_guides",
      "description": "Search the public how-to guide and published articles about making a photo rap video. Does not return drafts.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 200
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "zh"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_guide",
      "description": "Read the public how-to (slug how-to-make-an-ai-rap-video) or one published article, including its text. Does not return drafts.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "zh"
            ]
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.AIdevdoer/irap-catalog",
    "version": "1.0.0",
    "remoteUrl": "https://irapvideo.com/api/mcp",
    "publishedAt": "2026-11-23T13:46:35.716432Z",
    "fetchedAt": "2026-11-24T12:15:48.059Z",
    "toolsSha256": "3e46707f92fa17db2f4a729077bc8b053a18ace039350fb3cdc197c0853f0d87"
  }
}
