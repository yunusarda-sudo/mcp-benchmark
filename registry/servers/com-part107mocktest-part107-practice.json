{
  "$schema": "../schema.json",
  "name": "com.part107mocktest/part107-practice",
  "title": "Part 107 Mock Test — FAA Drone Exam Practice & METAR Decoder",
  "category": "Social, Media & Knowledge",
  "description": "Deterministic FAA Part 107 sample questions, rule-based grading, and METAR/TAF weather decoder.",
  "tools": [
    {
      "name": "get_part107_sample_questions",
      "description": "Return the FAA Part 107 ACS exam blueprint (60-question topic weights, 70% pass score, 120-minute limit) and a deterministic selection of free sample practice questions without exposing answer keys. Call grade_part107_answers to score responses.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "all",
              "regulations",
              "airspace",
              "weather",
              "loading",
              "operations",
              "chart"
            ],
            "default": "all",
            "description": "Knowledge area filter: all (exam-weighted mix), regulations, airspace, weather, loading, operations, or chart (sectional chart questions)."
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15,
            "default": 5,
            "description": "Number of free sample questions to return (1 to 15)."
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647,
            "default": 1,
            "description": "Deterministic integer seed controlling question selection order."
          }
        }
      }
    },
    {
      "name": "grade_part107_answers",
      "description": "Deterministically grade answers to free sample Part 107 questions against 14 CFR Part 107 and FAA ACS references, returning pass/fail status (70% threshold), per-topic breakdown, weakest knowledge area, and rule explanations.",
      "inputSchema": {
        "type": "object",
        "required": [
          "answers"
        ],
        "additionalProperties": false,
        "properties": {
          "answers": {
            "type": "object",
            "description": "Map of free sample question IDs (from get_part107_sample_questions) to chosen 0-based option index (0, 1, 2, or 3).",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "reg-001": {
                "type": "integer",
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "description": "Regulations (reg-001): option index 0-3."
              },
              "reg-010": {
                "type": "integer",
                "enum": [
                  0,
                  1,
                  2,
                  3
                ],
                "description": "Regulations (reg-010): option index 0-3."
              },
              "reg-025": {
