    {
      "name": "decode_part107_metar",
      "description": "Deterministically parse a raw aviation METAR, SPECI, or TAF report into plain English and evaluate FAA 14 CFR 107.51(c)-(d) visibility (3 SM) and cloud-clearance (500 ft below ceiling) minimums for small UAS flight.",
      "inputSchema": {
        "type": "object",
        "required": [
          "report"
        ],
        "additionalProperties": false,
        "properties": {
          "report": {
            "type": "string",
            "minLength": 4,
            "maxLength": 500,
            "description": "Raw METAR, SPECI, or TAF weather string, e.g. \"METAR KORF 251451Z 21012G19KT 10SM FEW035 SCT060 22/14 A3012 RMK AO2\"."
          }
        }
      }
    }
