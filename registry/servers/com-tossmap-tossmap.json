{
  "$schema": "../schema.json",
  "name": "com.tossmap/tossmap",
  "title": "TossMap",
  "category": "Travel, Maps & Navigation",
  "description": "Find US hazardous-waste, paint, battery and e-waste drop-off sites by ZIP or city",
  "tools": [
    {
      "name": "search_facilities",
      "description": "Find facilities by ZIP or covered city and material.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "zip": {
            "type": "string",
            "pattern": "^[0-9]{5}$"
          },
          "city": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "pattern": "^[A-Za-z]{2}$"
          },
          "material": {
            "type": "string",
            "enum": [
              "tires",
              "paint",
              "e_waste",
              "batteries",
              "motor_oil",
              "household_chemicals"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "material"
        ],
        "anyOf": [
          {
            "required": [
              "zip"
            ]
          },
          {
            "required": [
              "city"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_facility",
      "description": "Get a facility by ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "coverage",
      "description": "Check coverage by ZIP or covered city.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "zip": {
            "type": "string",
            "pattern": "^[0-9]{5}$"
          },
          "city": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "pattern": "^[A-Za-z]{2}$"
          }
        },
        "anyOf": [
          {
            "required": [
              "zip"
            ]
          },
          {
            "required": [
              "city"
            ]
          }
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.tossmap/tossmap",
    "version": "1.0.0",
    "remoteUrl": "https://api.tossmap.com/mcp",
    "publishedAt": "2026-11-26T02:18:52.302142Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "51b372d62dfcd16af71f03b095751c687bca75ebedb4cf4276541316353fabab"
  }
}
