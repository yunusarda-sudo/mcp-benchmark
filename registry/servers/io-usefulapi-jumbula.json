    {
      "name": "jumbula_create_coupon",
      "description": "Create a discount coupon code that families enter at checkout. This is a live change: it can cut real prices. Jumbula: POST /v1/Coupon.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Display name of the coupon."
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "description": "Unique code families enter at checkout."
          },
          "amount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Whole-number discount value: a percent or a fixed amount, set by amountType."
          },
          "amountType": {
            "type": "string",
            "enum": [
              "percent",
              "fixed"
            ],
            "description": "Discount type."
          },
          "startDate": {
            "type": "string",
            "minLength": 1,
            "description": "Activation date, as the Jumbula API expects it (for example 2026-12-01)."
          },
          "endDate": {
            "type": "string",
            "minLength": 1,
            "description": "Expiry date, as the Jumbula API expects it (for example 2026-12-31)."
          },
          "seasonId": {
            "description": "Season id the coupon applies to.",
            "type": "string"
          },
          "applyToAllInstallments": {
            "description": "Apply the discount to every installment.",
            "type": "boolean"
          },
          "isAllProgram": {
            "description": "Apply to all programs.",
            "type": "boolean"
          },
          "selectedProgramIds": {
            "description": "Program ids, when not all programs.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isAllTuition": {
            "description": "Apply to all tuition types.",
            "type": "boolean"
          },
          "appliesTo": {
            "description": "Target: all_schedule, least_expensive_schedule, most_expensive_schedule, least_expensive_order or most_expensive_order.",
            "type": "string"
          },
          "calculateType": {
            "description": "Calculation mode, for example only_tuition, only_extra_services or total_amount.",
            "type": "string"
          },
          "isPerFamily": {
            "description": "Limit usage to once per family.",
            "type": "boolean"
          },
          "maximumNumberOfUse": {
            "description": "Maximum number of uses, as a string.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "code",
          "amount",
          "amountType",
          "startDate",
          "endDate"
        ]
      }
    },
    {
      "name": "jumbula_update_coupon",
      "description": "Change the fields you pass on an existing coupon. Fields you leave out stay as they are. This is a live change to a discount in use. Jumbula: PUT /v1/Coupon/{id}.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "couponId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "The coupon id, as returned when it was created."
          },
          "name": {
            "description": "New display name.",
            "type": "string"
          },
          "code": {
            "description": "New unique code.",
            "type": "string"
          },
          "amount": {
            "description": "New whole-number discount value.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "amountType": {
            "description": "New discount type.",
            "type": "string",
            "enum": [
              "percent",
              "fixed"
            ]
          },
          "startDate": {
            "description": "New activation date, as the Jumbula API expects it.",
            "type": "string"
          },
          "endDate": {
            "description": "New expiry date, as the Jumbula API expects it.",
            "type": "string"
          },
          "seasonId": {
            "description": "Season id the coupon applies to.",
            "type": "string"
          },
          "applyToAllInstallments": {
            "description": "Apply the discount to every installment.",
            "type": "boolean"
          },
          "isAllProgram": {
            "description": "Apply to all programs.",
            "type": "boolean"
          },
          "selectedProgramIds": {
            "description": "Program ids, when not all programs.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isAllTuition": {
            "description": "Apply to all tuition types.",
            "type": "boolean"
          },
          "appliesTo": {
            "description": "Target: all_schedule, least_expensive_schedule, most_expensive_schedule, least_expensive_order or most_expensive_order.",
            "type": "string"
          },
          "calculateType": {
            "description": "Calculation mode, for example only_tuition, only_extra_services or total_amount.",
            "type": "string"
          },
          "isPerFamily": {
            "description": "Limit usage to once per family.",
            "type": "boolean"
          },
          "maximumNumberOfUse": {
            "description": "Maximum number of uses, as a string.",
            "type": "string"
          }
        },
        "required": [
          "couponId"
        ]
      }
    }
