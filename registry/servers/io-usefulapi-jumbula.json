    {
      "name": "jumbula_search_families",
      "description": "Search family accounts by parent email, phone, participant name, external id or business. Returns the matching families. Jumbula: POST /v1/Family/GetAllFamily (a read-only search).",
      "inputSchema": {
        "type": "object",
