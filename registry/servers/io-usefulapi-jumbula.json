{
  "$schema": "../schema.json",
  "name": "io.usefulapi/jumbula",
  "title": "Jumbula MCP by usefulapi",
  "category": "Payments, CRM & Finance",
  "description": "Read orders, forms, installments, families and payments; create and update coupons in Jumbula.",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "tools": [
    {
      "name": "jumbula_search_orders",
      "description": "Search registration orders by season, program, status, family name, email, confirmation id or date range. Returns order details. Filters are optional. Jumbula: POST /v2/orders (a read-only search).",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "seasonId": {
            "description": "Season id.",
            "type": "string"
          },
          "programId": {
            "description": "Program id.",
            "type": "string"
          },
          "programScheduleId": {
            "description": "Program schedule id.",
            "type": "string"
          },
          "businessId": {
            "description": "Business (school or organization) id.",
            "type": "string"
          },
          "status": {
            "description": "Order status filter, as Jumbula names it.",
            "type": "string"
          },
          "name": {
            "description": "Matches the first name, last name, or both.",
            "type": "string"
          },
          "email": {
            "description": "Matches the email address.",
            "type": "string"
          },
          "confirmationId": {
            "description": "Matches the confirmation id.",
            "type": "string"
          },
          "orderId": {
            "description": "One order id.",
            "type": "string"
          },
          "registrationDateRange": {
            "description": "Registration date range, as the Jumbula API expects it.",
            "type": "string"
          },
          "modifiedDateRange": {
            "description": "Last-modified date range, as the Jumbula API expects it.",
            "type": "string"
          },
          "offset": {
            "description": "Records to skip, for pagination.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "size": {
            "description": "Orders per page (1-100).",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sort": {
            "description": "Field name to sort by.",
            "type": "string"
          },
          "sortOrder": {
            "description": "Sort direction.",
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "include": {
            "description": "Nested data to include, as Jumbula names it (for example form or installment).",
            "type": "string"
          }
        }
      }
    },
    {
      "name": "jumbula_get_order",
      "description": "Get one order by id. Use include to add nested data such as the form or installments. Jumbula: GET /v2/orders/{id}.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "orderId": {
            "type": "string",
            "minLength": 1,
            "description": "The id, as returned by another Jumbula tool."
          },
          "include": {
            "description": "Nested data to include (for example form), as Jumbula names it.",
            "type": "string"
          }
        },
        "required": [
          "orderId"
        ]
      }
    },
    {
      "name": "jumbula_get_order_forms",
      "description": "Get the registration form answers for one order. Jumbula: GET /v2/orders/Form-By-OrderId?orderId=.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "orderId": {
            "type": "string",
            "minLength": 1,
            "description": "The id, as returned by another Jumbula tool."
          }
        },
        "required": [
          "orderId"
        ]
      }
    },
    {
      "name": "jumbula_get_order_waiver",
