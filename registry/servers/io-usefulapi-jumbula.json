            "type": "string"
          },
          "externalId": {
            "description": "The family's external id (from another system).",
            "type": "string"
          },
          "participantFullName": {
            "description": "Participant full name.",
            "type": "string"
          },
          "participantExternalId": {
            "description": "The participant's external id.",
            "type": "string"
          },
          "familyId": {
            "description": "One family id.",
            "type": "string"
          },
          "businessId": {
            "description": "Business id.",
            "type": "string"
          },
          "limit": {
            "description": "Maximum records to return (1-100).",
