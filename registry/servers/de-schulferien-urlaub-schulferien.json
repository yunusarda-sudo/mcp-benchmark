{
  "$schema": "../schema.json",
  "name": "de.schulferien-urlaub/schulferien",
  "title": "Schulferien Deutschland",
  "category": "Jobs, Career & Learning",
  "description": "German school holidays, public holidays and bridge days for all 16 federal states.",
  "tools": [
    {
      "name": "get_holiday_status",
      "description": "Ferien-/Feiertagsstatus für ein Bundesland (Slug, z. B. \"bayern\") und Datum.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "state": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "state",
          "date"
        ]
      }
    },
    {
      "name": "get_next_or_current_holiday",
      "description": "Laufende oder nächste Ferienperiode für ein Bundesland.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "state": {
            "type": "string"
          },
          "referenceDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "state"
        ]
      }
    },
    {
      "name": "count_holiday_days",
      "description": "Anzahl Ferientage pro Bundesland in einem Zeitraum.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "endDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "states",
          "startDate",
          "endDate"
        ]
      }
    },
    {
      "name": "find_bridge_days",
      "description": "Brückentage für ein Bundesland und Jahr, gleiche Rechnung wie auf schulferien-urlaub.de: frei sind nur Wochenenden und gesetzliche Feiertage. vacationDaysInSchoolHolidays nennt, wie viele Urlaubstage in die Schulferien fallen (null = Feriendaten fehlen). Vorschläge brauchen 1 bis 10 Urlaubstage; lange Wochenenden ohne Urlaubstag sind nicht enthalten, und von überlappenden Varianten wird nur eine genannt.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "state": {
            "type": "string"
          },
          "year": {
            "type": "number"
          },
          "maxVacationDays": {
            "type": "number"
          }
        },
        "required": [
          "state",
          "year",
          "maxVacationDays"
        ]
      }
    },
    {
      "name": "find_vacation_extensions",
      "description": "Verlängerungs-Brücken am Anfang/Ende von Ferienperioden für ein Bundesland und Jahr (z. B. 'X Urlaubstage vor Sommerferienbeginn = Y Tage frei'). Ergänzt find_bridge_days, das nur gesetzliche Feiertage als Anker kennt, nicht Ferien-Grenzen. Andere Ferienperioden zählen hier als frei (Sicht der Schulkinder).",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "state": {
            "type": "string"
          },
          "year": {
            "type": "number"
          },
          "maxVacationDays": {
            "type": "number"
          }
        },
        "required": [
          "state",
          "year",
          "maxVacationDays"
        ]
      }
    },
    {
      "name": "find_holidays_in_period",
      "description": "Ferien/Feiertage in einem Monat, über mehrere Bundesländer.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "month": {
            "type": "number"
          },
          "year": {
            "type": "number"
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "month"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "de.schulferien-urlaub/schulferien",
    "version": "1.0.0",
