{
  "$schema": "../schema.json",
  "name": "io.usefulapi/timetrex",
  "title": "TimeTrex MCP by usefulapi",
  "category": "Other",
  "description": "Read employees, time punches, branches and departments in TimeTrex.",
  "repository": "https://github.com/m190/usefulapi-mcp",
  "tools": [
    {
      "name": "timetrex_list_employees",
      "description": "List employees in the TimeTrex installation: record id, employee number, first and last name. Filter by employee number or name. Use the id in the other tools. TimeTrex API: APIUser.getUser.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "employee_number": {
            "description": "Exact employee number.",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "first_name": {
            "description": "Filter by first name.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "last_name": {
            "description": "Filter by last name.",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "page": {
            "description": "Page number for pagination (default 1).",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "page_size": {
            "description": "Records per page (default 25, maximum 100).",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    {
      "name": "timetrex_list_punches",
      "description": "List time punches (clock in and clock out records) for one employee between two dates. Dates are yyyy-mm-dd. TimeTrex API: APIPunch.getPunch.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "user_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F-]{36}$",
            "description": "Employee record id (from timetrex_list_employees)."
          },
          "start_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "First day, yyyy-mm-dd."
          },
          "end_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Last day, yyyy-mm-dd."
          },
          "page": {
            "description": "Page number for pagination (default 1).",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "page_size": {
            "description": "Records per page (default 10, maximum 100).",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "user_id",
          "start_date",
          "end_date"
        ]
      }
    },
    {
      "name": "timetrex_list_branches",
      "description": "List branches (work sites) of the TimeTrex installation. TimeTrex API: APIBranch.getBranch.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "page": {
            "description": "Page number for pagination (default 1).",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "page_size": {
            "description": "Records per page (default 25, maximum 100).",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    {
      "name": "timetrex_list_departments",
      "description": "List departments of the TimeTrex installation. TimeTrex API: APIDepartment.getDepartment.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "page": {
            "description": "Page number for pagination (default 1).",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "page_size": {
            "description": "Records per page (default 25, maximum 100).",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.usefulapi/timetrex",
    "version": "1.2.1",
    "remoteUrl": "https://timetrex.usefulapi.io/mcp",
    "publishedAt": "2026-11-24T11:33:28.038037Z",
    "fetchedAt": "2026-11-24T12:15:48.059Z",
