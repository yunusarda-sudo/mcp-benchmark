{
  "$schema": "../schema.json",
  "name": "com.askpandi/ask-pandi",
  "title": "Ask Pandi",
  "category": "Social, Media & Knowledge",
  "description": "Ask research questions, follow progress, and get answers with numbered citations. No Pandi login.",
  "tools": [
    {
      "name": "ask_pandi",
      "description": "Prepare or submit a text research question to Pandi. A first call without a request ID prepares a private submission ID. A repeat with that ID, question and locale creates a research job and returns its private receipt.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "locale": {
            "default": "en",
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8}){0,2}$"
          },
          "request_id": {
            "description": "Use the private request_id issued by Pandi for this guest question. Linked accounts may also generate their own unique ID. Reuse the same ID for retries.",
            "type": "string",
            "pattern": "^[\\w.:-]{8,64}$"
          }
        },
        "required": [
          "question"
        ]
      }
    },
    {
      "name": "get_ask",
      "description": "Read the state, progress or completed text answer and numbered citations for a Pandi research job. The private receipt identifies the job. An optional cursor resumes progress from an earlier read.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ask_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{1,20}\\.[\\w-]{43}$"
              },
              {
                "type": "string",
                "pattern": "^ga\\.([a-z0-9]{1,8}\\.[\\w-]{22})\\.(\\d{1,20})\\.[\\w-]{22}$"
              }
            ]
          },
          "cursor": {
            "type": "string",
            "pattern": "^\\d{1,20}\\/[\\w:.-]{1,100}$"
          },
          "wait_seconds": {
            "default": 8,
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          }
        },
        "required": [
          "ask_id"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.askpandi/ask-pandi",
    "version": "1.0.0",
    "remoteUrl": "https://askpandi.com/api/mcp",
    "publishedAt": "2026-11-26T09:05:46.8832Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
    "toolsSha256": "18c8c07431142e34eb5180fe499b225a0bc7b0fdf060993a949257336600e6b0"
  }
}
