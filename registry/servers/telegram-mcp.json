{
  "$schema": "../schema.json",
  "name": "Telegram MCP",
  "category": "Communication & Alerting",
  "description": "Telegram MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "send_message",
      "description": "Send message or alert to Telegram chat ID using Bot API.",
      "inputSchema": {
        "type": "object",
        "required": [
          "chatId",
          "text"
        ],
        "properties": {
          "chatId": {
            "type": "string",
            "description": "Telegram chat or group ID."
          },
          "text": {
            "type": "string",
            "description": "Message text."
          }
        }
      }
    }
  ]
}
