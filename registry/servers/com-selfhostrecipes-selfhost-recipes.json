{
  "$schema": "../schema.json",
  "name": "com.selfhostrecipes/selfhost-recipes",
  "title": "Selfhost Recipes",
  "category": "Cloud & Hosting Platforms",
  "description": "Search and fetch 870+ ready-to-run Compose stacks for self-hosting and home labs.",
  "tools": [
    {
      "name": "search_recipes",
      "description": "Search Docker Compose recipes by keywords (app name, technology, use case). Returns ranked matches with slug, title, description and URLs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Keywords, e.g. 'postgres pgadmin' or 'media server'"
          },
          "category": {
            "type": "string",
            "enum": [
              "web-servers",
              "databases",
              "full-stacks",
              "cms",
              "monitoring",
              "devops",
              "productivity",
              "media",
              "security",
              "development",
              "ai-ml",
              "ecommerce",
              "messaging",
              "homelab",
              "storage"
            ],
            "description": "Limit to one category slug"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Max results (default 10)"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "get_recipe",
      "description": "Get one recipe as Markdown: overview, docker-compose.yml, .env template, prerequisites, usage notes and troubleshooting.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "description": "Recipe slug from search_recipes, e.g. 'postgresql'"
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "list_categories",
      "description": "List all recipe categories with their slug, name, description and recipe count.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "list_recipes",
      "description": "List every recipe in one category (slug, title, description, URLs).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "web-servers",
              "databases",
              "full-stacks",
              "cms",
              "monitoring",
              "devops",
              "productivity",
              "media",
              "security",
              "development",
              "ai-ml",
              "ecommerce",
              "messaging",
              "homelab",
              "storage"
            ],
            "description": "Category slug from list_categories"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          }
        },
        "required": [
          "category"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.selfhostrecipes/selfhost-recipes",
    "version": "1.0.0",
    "remoteUrl": "https://selfhostrecipes.com/mcp",
    "publishedAt": "2026-11-21T13:37:27.59991Z",
    "fetchedAt": "2026-11-22T12:49:37.224Z",
    "toolsSha256": "e8b1c9ba8d174d48e1d513a6f3f078e9f9c9379386130fe0923ef508fb852dff"
  }
}
