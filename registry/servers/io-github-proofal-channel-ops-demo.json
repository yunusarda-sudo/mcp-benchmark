{
  "$schema": "../schema.json",
  "name": "io.github.ProofAl/channel-ops-demo",
  "title": "Channel Ops Demo",
  "category": "Developer Tools & DevOps",
  "description": "Calculate campaign contribution and draft YouTube UTM links with example inputs.",
  "repository": "https://github.com/ProofAl/channel-ops-mcp",
  "tools": [
    {
      "name": "demo_contribution",
      "description": "Subtract refunds, fulfillment, fees and campaign costs from example cash receipts. Use illustrative USD values only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "collected_usd": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000,
            "multipleOf": 0.01
          },
          "refunds_usd": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000,
            "multipleOf": 0.01
          },
          "delivery_fees_usd": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000,
            "multipleOf": 0.01
          },
          "campaign_cost_usd": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000,
            "multipleOf": 0.01,
            "description": "Production, promotion, tools and loaded team time in USD."
          }
        },
        "required": [
          "collected_usd",
          "refunds_usd",
          "delivery_fees_usd",
          "campaign_cost_usd"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "draft_campaign_link",
      "description": "Format a public HTTPS landing page with YouTube organic UTM tags. The URL is returned as text and is never visited.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "landing_url": {
            "type": "string",
            "maxLength": 1024,
            "format": "uri"
          },
          "campaign": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "content_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "description": "Optional known placement slug. Omit for shared profile links."
          }
        },
        "required": [
          "landing_url",
          "campaign"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.ProofAl/channel-ops-demo",
    "version": "0.1.0",
    "remoteUrl": "https://channel-ops-lab.knowingfoxglove4.chatgpt.site/demo/mcp",
    "publishedAt": "2026-11-24T21:55:00.869448Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "c5a981eb7b69a2aaa48f3c95d66c76e08cf6acd92c4237bebfb3d67c4796235b"
  }
}
