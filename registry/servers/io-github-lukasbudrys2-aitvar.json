{
  "$schema": "../schema.json",
  "name": "io.github.lukasbudrys2/aitvar",
  "title": "Aitvar",
  "category": "Developer Tools & DevOps",
  "description": "Write scripts and make narrated, animated Shorts (YouTube Shorts, TikTok, Reels) from a topic.",
  "tools": [
    {
      "name": "get_aitvar_options",
      "description": "Lists what Aitvar can make: the visual looks, video lengths, narration languages, voices, music and tones that write_video_script accepts, and how Aitvar works. Needs no account.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_new_video_link",
      "description": "Returns a link to the Aitvar website with the topic filled in, where the person can start the video themselves (they type their email there and read the script in about half a minute). Needs no account; use it when the person prefers the website or hasn’t connected their account.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "description": "What the video is about, in a sentence.",
            "maxLength": 500
          }
        },
        "required": [
          "topic"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "write_video_script",
      "description": "Starts a new video draft in the person’s Aitvar account and has the AI write its script (scenes of narration with what is shown on screen, a title, caption and hashtags). Free. Usually takes 20-60 seconds; a long video can take longer, then call get_video later. Returns the video id and the script.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "description": "What the video is about. A specific angle works best, e.g. \"Why octopuses have three hearts\".",
            "maxLength": 500
          },
          "look": {
            "type": "string",
            "enum": [
              "toon",
              "clay",
              "paper",
              "blocky",
              "lowpoly",
              "cinematic",
              "fantasy",
              "scifi",
              "retro",
              "anime",
              "comic",
              "sketch"
            ],
            "description": "Visual look. Default toon. See get_aitvar_options."
          },
          "length_seconds": {
            "type": "integer",
            "enum": [
              30,
              45,
              60,
              90,
              120,
              180,
              300,
              600
            ],
            "description": "Video length in seconds. Default 45. A first video is up to 60."
          },
          "language": {
            "type": "string",
            "enum": [
              "English",
              "Spanish",
              "Portuguese (Brazil)",
              "Portuguese (Portugal)",
              "French",
              "German",
              "Italian",
              "Dutch",
              "Polish",
              "Lithuanian",
              "Latvian",
              "Estonian",
              "Finnish",
              "Swedish",
              "Norwegian",
              "Danish",
              "Czech",
              "Slovak",
              "Hungarian",
              "Romanian",
              "Bulgarian",
              "Croatian",
              "Greek",
              "Turkish",
              "Ukrainian",
              "Russian",
              "Arabic",
              "Hindi",
              "Indonesian",
              "Malay",
              "Filipino",
              "Vietnamese",
              "Thai",
              "Japanese",
              "Korean",
              "Chinese (Mandarin)"
            ],
            "description": "Narration language. Default English."
          },
          "tone": {
            "type": "string",
            "enum": [
              "curious",
              "funny",
              "dramatic",
              "spooky",
              "calm",
              "hype"
            ],
            "description": "Default curious."
          },
          "voice": {
            "type": "string",
            "enum": [
              "any",
              "female",
              "male",
              "bella",
              "alice",
              "jessica",
              "laura",
              "matilda",
              "sarah",
              "george",
              "brian",
              "liam",
              "chris",
              "callum",
              "river"
            ],
            "description": "Narrator voice. Default \"any\" (best fit)."
          },
          "music": {
            "type": "string",
            "enum": [
              "cinematic",
              "upbeat",
              "lofi",
              "tense",
              "emotional",
              "none"
            ],
            "description": "Background music. Default cinematic."
          },
          "notes": {
            "type": "string",
            "description": "Anything else the writer should know: audience, facts to include, a call to action.",
            "maxLength": 1000
          }
        },
        "required": [
          "topic"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_my_videos",
      "description": "Lists the videos in the person’s Aitvar account, newest first: drafts, videos being made and finished videos, with their ids and status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "How many to return (default 20)."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_video",
      "description": "Returns one video’s status, script, settings, cost and preview progress, and the link to its page in Aitvar, where the person watches and downloads it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "video_id": {
            "type": "string",
            "description": "The video’s id (from write_video_script or list_my_videos)."
          }
        },
        "required": [
          "video_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "update_video_script",
      "description": "Changes a draft: replaces its script (title, scenes, caption, hashtags; give the whole scene list) and/or its look, length, voice, music or tone. Only drafts can change. Free.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "video_id": {
            "type": "string",
            "description": "The video’s id (from write_video_script or list_my_videos)."
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "scenes": {
            "type": "array",
            "description": "The full list of scenes, in order. Narration is what the voice says; visual is what is shown (optional).",
            "maxItems": 150,
            "items": {
              "type": "object",
              "properties": {
                "narration": {
                  "type": "string",
                  "maxLength": 600
                },
                "visual": {
                  "type": "string",
                  "maxLength": 800
                }
              },
              "required": [
                "narration"
              ],
              "additionalProperties": false
            }
          },
          "caption": {
            "type": "string",
            "maxLength": 2200
          },
          "hashtags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 30
          },
          "look": {
            "type": "string",
            "enum": [
              "toon",
              "clay",
              "paper",
              "blocky",
              "lowpoly",
              "cinematic",
              "fantasy",
              "scifi",
              "retro",
              "anime",
              "comic",
              "sketch"
            ]
          },
          "length_seconds": {
            "type": "integer",
            "enum": [
              30,
              45,
              60,
              90,
              120,
              180,
              300,
              600
            ]
          },
          "voice": {
            "type": "string",
            "enum": [
              "any",
              "female",
              "male",
              "bella",
              "alice",
              "jessica",
              "laura",
              "matilda",
              "sarah",
              "george",
              "brian",
              "liam",
              "chris",
              "callum",
              "river"
            ]
          },
          "music": {
            "type": "string",
            "enum": [
              "cinematic",
              "upbeat",
              "lofi",
              "tense",
              "emotional",
              "none"
            ]
          },
          "tone": {
            "type": "string",
            "enum": [
              "curious",
              "funny",
              "dramatic",
              "spooky",
              "calm",
              "hype"
            ]
          }
        },
        "required": [
          "video_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "rewrite_video_script",
      "description": "Has the AI rewrite a draft’s script following an instruction, e.g. \"make the hook punchier\" or \"add the 1969 study\". Free, a limited number of times per draft.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "video_id": {
            "type": "string",
            "description": "The video’s id (from write_video_script or list_my_videos)."
          },
          "instruction": {
            "type": "string",
            "maxLength": 500,
            "description": "What to change."
          }
        },
        "required": [
          "video_id",
          "instruction"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "make_free_preview",
      "description": "Renders the draft as it is now so the person can watch it before paying: the first 5 seconds in about 2 minutes, the whole video in about 6, on the video’s page. Free (an account has a few free previews until it buys videos; a draft can be previewed again after edits a few times).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "video_id": {
            "type": "string",
            "description": "The video’s id (from write_video_script or list_my_videos)."
          }
        },
        "required": [
          "video_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "approve_video",
      "description": "Approves a draft and makes the final video, using videos from the person’s Aitvar balance (the cost is in get_video as cost_in_videos). Only call this after the person has seen the script and agreed to the cost. Pass that cost as expected_cost; nothing is charged if the price is higher.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "video_id": {
            "type": "string",
            "description": "The video’s id (from write_video_script or list_my_videos)."
          },
          "expected_cost": {
            "type": "number",
            "minimum": 0,
            "description": "The cost_in_videos the person agreed to."
          }
        },
        "required": [
          "video_id",
          "expected_cost"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_my_balance",
      "description": "Returns how many videos are in the person’s Aitvar balance and how many free previews the account has left.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
