{
  "$schema": "../schema.json",
  "name": "Google Cloud MCP",
  "category": "Cloud & Hosting Platforms",
  "description": "Google Cloud MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "list_compute_instances",
      "description": "Retrieve Compute Engine VM instances in a Google Cloud project zone.",
      "inputSchema": {
        "type": "object",
        "required": [
          "projectId"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "description": "GCP project ID."
          },
          "zone": {
            "type": "string",
            "description": "Target compute zone (e.g. europe-west1-b)."
          }
        }
      }
    }
  ]
}
