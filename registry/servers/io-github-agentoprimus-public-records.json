{
  "$schema": "../schema.json",
  "name": "io.github.agentoprimus/public-records",
  "title": "Public Records for Agents (Federal Register)",
  "category": "AI, LLMs & Agents",
  "description": "Pay-per-call US Federal Register search: proposed rules, notices, comment deadlines. x402 USDC.",
  "tools": [
    {
      "name": "federal_register_search",
      "description": "Search the US Federal Register (rules, proposed rules, notices, presidential documents) via the official API. Filters: agency slug, type, publication date range, open_for_comment. Returns comment deadlines, docket IDs and regulations.gov comment links. $0.003 USDC per call (x402, Base).",
      "inputSchema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "type": {
            "enum": [
              "rule",
              "proposed_rule",
              "notice",
              "presidential"
            ],
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "maximum": 20,
            "minimum": 1
          },
          "order": {
            "enum": [
              "newest",
              "relevance"
            ],
            "type": "string"
          },
          "query": {
            "type": "string",
            "description": "Search terms, e.g. emissions"
          },
          "agency": {
            "type": "string",
            "description": "Federal Register agency slug, e.g. environmental-protection-agency"
          },
          "published_after": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "open_for_comment": {
            "type": "boolean",
            "description": "Only documents whose comment period has not closed"
          },
          "published_before": {
            "type": "string",
            "description": "YYYY-MM-DD"
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
