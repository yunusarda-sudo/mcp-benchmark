{
  "$schema": "../schema.json",
  "name": "io.github.dislop-ai/dislop",
  "title": "dislop",
  "category": "Cloud & Hosting Platforms",
  "description": "Cutting AI slop is real productivity. Linter for AI Slop in docs, web UI & slides (Cloud MCP).",
  "repository": "https://github.com/dislop-ai/dislop",
  "tools": [
    {
      "name": "dislop_check",
      "description": "Free deterministic anti-slop check for AI residue, clichés, and UI templates (0 credits, no login required).",
      "inputSchema": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "modality": {
            "type": "string",
            "enum": [
              "markdown",
              "text",
              "html",
              "css",
              "jsx",
              "svg"
            ]
          },
          "pack": {
            "type": "string",
            "enum": [
              "auto",
              "business-brief",
              "core",
              "deck-and-ui",
              "engineering-spec",
              "executive-deck",
              "literary-essay",
              "regulated-comms"
            ]
          },
          "register": {
            "type": "string",
            "enum": [
              "auto",
              "unspecified",
              "official",
              "casual",
              "argumentative",
              "technical",
              "marketing",
              "narrative",
              "expressive",
              "instructional",
              "deck-ui"
            ]
          },
          "verbose": {
            "type": "boolean",
            "description": "Include full rule descriptions (default false for compact output)"
          }
        }
      }
    },
    {
      "name": "dislop_verify",
      "description": "Verify fact ledger, keep terms, and anti-degradation guardrails on a revision pair (0 credits, no login required).",
