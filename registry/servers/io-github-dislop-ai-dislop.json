    {
      "name": "dislop_office",
      "description": "Review or rewrite .docx/.pptx text segments without emitting binary base64 (2 cr review / 3 cr deslop, sign-in required).",
      "inputSchema": {
        "type": "object",
        "required": [
          "kind",
          "mode",
          "segments"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "docx",
              "pptx"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "review",
              "deslop"
            ]
          },
          "pack": {
            "type": "string",
            "enum": [
              "auto",
              "business-brief",
              "core",
              "deck-and-ui",
              "engineering-spec",
              "executive-deck",
              "literary-essay",
              "regulated-comms"
            ]
          },
          "lang": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ]
          },
          "voiceProfileId": {
            "type": "string"
          },
          "segments": {
            "type": "array",
            "maxItems": 400,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "slide": {
                  "type": "integer"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "dislop_visual_review",
      "description": "Multimodal visual anti-slop screenshot audit for webpages, slides, posters, infographics, diagrams, comics, and print layouts (2 credits, sign-in required).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "imageBase64": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "html": {
            "type": "string"
          },
          "targetType": {
            "type": "string",
            "enum": [
              "webpage",
              "slide",
              "poster",
              "infographic",
              "diagram",
              "comic",
              "print"
            ]
          },
          "lang": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ]
          },
          "protect": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 12
          }
        }
      }
    },
    {
      "name": "dislop_voice_extract",
      "description": "Extract a reusable dislop.voice/1 style card from 1-5 human samples and optionally save it to your account (2 credits).",
      "inputSchema": {
        "type": "object",
        "required": [
          "samples"
        ],
        "properties": {
          "samples": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 5
          },
          "lang": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ]
          },
          "save": {
            "type": "boolean",
            "description": "Save extracted voice card to your cloud account"
          },
          "name": {
            "type": "string",
            "description": "Label when saving to account"
          }
        }
      }
    },
    {
      "name": "dislop_voice_manage",
      "description": "List, view, or delete saved personal voice cards in your account (0 credits, sign-in required).",
      "inputSchema": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "get",
              "delete"
            ]
          },
          "voiceId": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "dislop_account",
      "description": "Inspect your active dislop plan, remaining credits, and saved voice count (0 credits, sign-in required).",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    }
