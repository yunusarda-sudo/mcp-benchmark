        "type": "object",
        "required": [
          "before",
          "after"
        ],
        "properties": {
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "modality": {
            "type": "string",
            "enum": [
              "markdown",
              "text",
              "html",
              "css",
              "jsx",
              "svg"
            ]
          },
          "pack": {
            "type": "string",
            "enum": [
              "auto",
              "business-brief",
              "core",
              "deck-and-ui",
              "engineering-spec",
              "executive-deck",
              "literary-essay",
              "regulated-comms"
            ]
          },
          "register": {
            "type": "string",
            "enum": [
              "auto",
              "unspecified",
              "official",
              "casual",
              "argumentative",
              "technical",
              "marketing",
              "narrative",
              "expressive",
              "instructional",
              "deck-ui"
            ]
          },
          "keep": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 32
          },
          "allowAdded": {
            "type": "boolean"
          },
          "strict": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "dislop_rules",
      "description": "List available anti-slop rule packs or explain a specific ruleId with examples (0 credits).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ruleId": {
            "type": "string",
            "description": "Omit to list all packs; pass a ruleId to get its explanation and examples"
          },
          "lang": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ]
          }
        }
      }
    },
    {
