              "auto",
              "business-brief",
              "core",
              "deck-and-ui",
              "engineering-spec",
              "executive-deck",
              "literary-essay",
              "regulated-comms"
            ]
          },
          "register": {
            "type": "string",
            "enum": [
              "auto",
