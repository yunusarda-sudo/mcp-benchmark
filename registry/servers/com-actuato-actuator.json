{
 "$schema": "../schema.json",
 "name": "com.actuato/actuator",
 "title": "Actuator",
 "category": "Design, UI & 3D Media",
 "description": "Hire vetted local people for real-world jobs: post, rank, hire, pay in escrow, verify with photos.",
 "tools": [
  {
   "name": "whoami",
   "description": "Which agent and principal this key acts for, and remaining spending limits.",
   "inputSchema": {
    "type": "object",
    "properties": {}
   }
  },
  {
   "name": "search_categories",
   "description": "Map a plain-language problem ('toilet won't flush') to Actuator job categories and skill slugs, with the certifications each category requires.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "query": {
      "type": "string",
      "minLength": 2,
      "description": "Plain-language description of the problem or task"
     }
    },
    "required": [
     "query"
    ]
   }
  },
  {
   "name": "estimate_price",
   "description": "Typical price range (25th/50th/75th percentile) for a job in a category, from local bids and hires. Use it to set budget_min_cents/budget_max_cents.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "category_slug": {
      "type": "string"
     },
     "skill_slugs": {
      "default": [],
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "region": {
      "description": "US state code, e.g. MD",
      "type": "string",
      "minLength": 2,
      "maxLength": 2
     }
    },
    "required": [
     "category_slug"
    ]
   }
  },
  {
   "name": "upload_photo",
   "description": "Upload an image the person shared so it can be attached to a job. Returns a file_id for create_job_draft.attachments.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "image_base64": {
      "type": "string",
      "minLength": 16,
      "maxLength": 10666667
     },
     "content_type": {
      "default": "image/jpeg",
      "type": "string",
      "enum": [
       "image/jpeg",
       "image/png",
       "image/webp",
       "image/heic"
      ]
     },
     "filename": {
      "type": "string"
     }
    },
    "required": [
     "image_base64"
    ]
   }
  },
  {
   "name": "check_coverage",
   "description": "Before drafting, check whether vetted workers serve a location. Actuator is live in Baltimore, MD and expanding; elsewhere jobs cannot be published yet and the request is recorded as demand.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "lat": {
      "type": "number"
     },
     "lng": {
      "type": "number"
     },
     "category_slug": {
      "type": "string"
     },
     "skill_slugs": {
      "default": [],
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "lat",
     "lng"
    ]
   }
  },
  {
   "name": "create_job_draft",
   "description": "Create a job on behalf of the person (unpublished). Returns the draft plus warnings about missing details. Call publish_job when the person confirms.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 160
     },
     "summary": {
      "type": "string",
      "maxLength": 400
     },
     "category_slug": {
      "type": "string"
     },
     "skill_slugs": {
      "default": [],
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "structured_spec": {
      "default": {},
      "type": "object",
      "properties": {
       "symptoms": {
        "default": [],
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "likely_cause": {
        "type": [
         "string",
         "null"
        ]
       },
       "tasks": {
        "default": [],
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "materials": {
        "default": [],
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "name": {
           "type": "string"
          },
          "quantity": {
           "type": [
            "string",
            "null"
           ]
          },
          "provided_by": {
           "default": "worker",
           "type": "string",
           "enum": [
            "worker",
            "principal"
           ]
          }
         },
         "required": [
          "name"
         ]
        }
       },
       "access_instructions": {
        "type": [
         "string",
         "null"
        ]
       },
       "hazards": {
        "default": [],
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "success_criteria": {
        "default": [],
        "description": "Concrete, checkable outcomes; the worker photographs each one",
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "notes": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     },
     "location": {
      "type": "object",
      "properties": {
       "lat": {
        "type": "number"
       },
       "lng": {
        "type": "number"
       }
      },
      "required": [
       "lat",
       "lng"
      ]
     },
     "address": {
      "type": "object",
      "properties": {
       "line1": {
        "type": "string"
       },
       "city": {
        "type": "string"
       },
       "region": {
        "type": "string",
        "minLength": 2,
        "maxLength": 2
       },
       "postal_code": {
        "type": "string"
       }
      },
      "required": [
       "city",
       "region"
      ]
     },
     "urgency": {
      "default": "flexible",
      "type": "string",
      "enum": [
       "asap",
       "today",
       "this_week",
       "flexible",
       "scheduled"
      ]
     },
     "window_start": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
     },
     "window_end": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
     },
     "budget_min_cents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "budget_max_cents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "reimbursable_max_cents": {
      "description": "Purchase allowance in cents: the worker may buy up to this (with receipts) and be reimbursed without asking. Set it for errands, groceries, parts runs.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "required_cert_slugs": {
      "description": "Defaults to the category's required certifications",
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "cert_enforcement": {
      "type": "string",
      "enum": [
       "strict",
       "preferred"
      ]
     },
     "attachments": {
      "default": [],
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "file_id": {
         "type": "string",
         "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "caption": {
         "type": "string"
        }
       },
       "required": [
        "file_id"
       ]
      }
     },
     "external_ref": {
      "type": "string",
      "maxLength": 128
     },
     "invite_worker_ids": {
      "default": [],
      "description": "worker_id values from list_past_workers: people the person hired and approved before. They are told about the job directly.",
      "maxItems": 5,
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[A-Za-z0-9_-]{1,64}$"
      }
     },
     "visibility": {
      "default": "public",
      "description": "invite_only: only the invited workers can see and bid on it. Use when the person wants the same worker again.",
      "type": "string",
      "enum": [
       "public",
       "invite_only"
      ]
     }
    },
    "required": [
     "title",
     "category_slug",
     "location",
     "address"
    ]
   }
  },
  {
   "name": "publish_job",
   "description": "Make a draft visible to workers. May return PENDING APPROVAL if the person requires approval before publishing.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
     }
    },
    "required": [
     "job_id"
    ]
   }
  },
  {
   "name": "get_job",
   "description": "Full job details including status and pending_actions (what to do next).",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
     }
    },
    "required": [
     "job_id"
    ]
   }
  },
  {
   "name": "list_my_jobs",
   "description": "Jobs posted for this principal, newest first.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "status": {
      "type": "string"
     }
    }
   }
  },
  {
   "name": "list_past_workers",
   "description": "Workers this person hired and approved before. Mutual matches (both said they'd work together again) come first, then the most recent. Pass their worker_id in create_job_draft's invite_worker_ids to ask them first.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {}
   }
  },
  {
   "name": "open_job_to_everyone",
   "description": "Make an invite-only job public so nearby workers can bid, for when the invited workers decline. Ask the person first.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
     }
    },
    "required": [
     "job_id"
    ]
   }
  },
  {
   "name": "cancel_job",
   "description": "Cancel a draft or open job. Once a worker is hired only the person can cancel, from the contract, so the cancellation policy and refund apply.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
     },
     "reason": {
      "type": "string"
     }
    },
    "required": [
     "job_id"
    ]
   }
  },
  {
   "name": "list_applicants",
   "description": "Applicants for a job, ranked by fit (skills, verified certifications, rating, price, distance, reliability) with plain-language reasons. Show these to the person; they choose.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
     }
    },
    "required": [
     "job_id"
    ]
   }
  },
  {
   "name": "get_worker",
   "description": "Public profile of a worker: skills with verified job counts, certifications, experience, rating, reviews.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "worker_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
     }
    },
    "required": [
     "worker_id"
    ]
   }
  },
  {
   "name": "shortlist_applicant",
   "description": "Mark an applicant as shortlisted (they are notified).",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "application_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
     }
    },
    "required": [
     "application_id"
    ]
   }
  },
  {
   "name": "decline_applicant",
   "description": "Decline an applicant (they are notified).",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "application_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
     },
     "reason": {
      "type": "string"
     }
    },
    "required": [
     "application_id"
    ]
   }
  },
  {
   "name": "hire",
   "description": "Hire the applicant the person chose. Creates a contract (other applicants are declined). Returns PENDING APPROVAL when the price exceeds what the person pre-authorized. Then call fund_contract.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
     },
     "application_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
     },
     "scheduled_start_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
     }
    },
    "required": [
     "job_id",
     "application_id"
    ]
   }
  },
  {
   "name": "fund_contract",
   "description": "Charge the person's saved card for the hire. Stripe processes the payment and the worker's payout is withheld until approve_completion (or the review window ends). Fails with 402 if no saved card: tell the person to add one in the Actuator app (Billing).",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "contract_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
     }
    },
    "required": [
     "contract_id"
    ]
   }
  },
  {
   "name": "get_contract",
   "description": "Contract status, timeline, check-in, the worker's progress updates (on the way, progress notes, running late), expected_finish_at, and completion evidence with viewable photo URLs (valid ~15 minutes). Pass progress on to the person when they ask how it's going. Look at the photos before approving.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "contract_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
     }
    },
    "required": [
     "contract_id"
    ]
   }
  },
  {
   "name": "approve_completion",
   "description": "Releases the withheld payout to the worker. Only after the person has reviewed the evidence.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "contract_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
     }
    },
    "required": [
     "contract_id"
    ]
   }
  },
  {
   "name": "request_rework",
   "description": "Send the worker back (max 2 rounds) with a specific reason.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "contract_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
     },
     "reason": {
      "type": "string",
      "minLength": 3
     }
    },
    "required": [
     "contract_id",
     "reason"
    ]
   }
  },
  {
   "name": "open_dispute",
   "description": "Pause the payout and ask Actuator to decide. Only possible before payment is released. Use after rework has failed or for no-shows/damage.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "contract_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
     },
     "reason": {
      "type": "string",
      "enum": [
       "not_completed",
       "poor_quality",
       "no_show",
       "overcharge",
       "damage",
       "safety",
       "other"
      ]
     },
     "description": {
      "type": "string",
      "minLength": 10
     },
     "requested_worker_cents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
     }
    },
    "required": [
     "contract_id",
     "reason",
     "description"
    ]
   }
  },
  {
   "name": "message_worker",
   "description": "Send a message to an applicant or hired worker. Give application_id (pre-hire) or thread_id.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
     },
     "application_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
     },
     "thread_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
     }
    },
    "required": [
     "text"
    ]
   }
  },
  {
   "name": "read_messages",
   "description": "Messages in a thread, oldest first. Pass after=<message_id> for new ones only.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "thread_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
     },
     "after": {
      "type": "string"
     }
    },
    "required": [
     "thread_id"
    ]
   }
  },
  {
   "name": "wait_for_event",
   "description": "Long-poll (up to 55 s) for events such as application.created, approval_request.decided, contract.work_submitted, message.created. Returns immediately with anything new after `after`.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "types": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "after": {
      "description": "Last event id you have seen",
      "type": "string"
     },
     "timeout_s": {
      "default": 30,
      "type": "integer",
      "minimum": 1,
      "maximum": 55
     }
    }
   }
  },
  {
   "name": "check_approval",
   "description": "Status of a PENDING APPROVAL request.",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "approval_request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
     }
    },
    "required": [
     "approval_request_id"
    ]
   }
  }
 ],
 "source": {
  "type": "registry",
  "registry": "registry.modelcontextprotocol.io",
  "name": "com.actuato/actuator",
  "version": "0.1.1",
  "remoteUrl": "https://actuator-mcp.actuator-mcp.workers.dev/mcp",
  "publishedAt": "2026-11-20T18:38:17.312242Z",
  "fetchedAt": "2026-11-22T12:49:37.224Z",
  "toolsSha256": "07ccbdf9322a326d5a40502ac457d6c5cb11edcc6ab0a957004809e275c3c1c3"
 }
}
