        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "station_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "request_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "max_cost_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "station_id",
          "request_id",
          "max_cost_cents"
        ]
      }
    }
