  "description": "EV/PHEV charging and stops. MCP and sandboxed Code Mode with explicit prepaid limits.",
  "tools": [
    {
      "name": "discover_plugtrip",
      "description": "Découvrir les fonctionnalités réelles de Plugtrip pour la recharge, les pauses, le trajet, le logement, la communauté et les véhicules. Gratuit.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {}
      }
    },
    {
      "name": "search_stations",
      "description": "Rechercher des stations et leur contexte documenté. 0,01 EUR par réponse utile ; aucune facturation en cas d’échec ou de résultat vide. Clé API dans Authorization, request_id stable pour les reprises.",
