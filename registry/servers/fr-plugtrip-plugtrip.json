            "default": 10,
            "type": "number",
            "minimum": 1,
            "maximum": 50
          },
          "limit": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "request_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "max_cost_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "latitude",
          "longitude",
          "request_id",
          "max_cost_cents"
        ]
      }
    },
    {
      "name": "station_context",
      "description": "Lire une fiche avec sources et état connu. 0,02 EUR par réponse utile ; aucune disponibilité ne doit être inventée.",
