{
  "$schema": "../schema.json",
  "name": "com.miaotoolbox/miaotoolbox",
  "title": "MiaoToolbox (妙用盒)",
  "category": "Other",
  "description": "Free keyless MCP: unit, timezone, mortgage, IRR/APR, China tax, YAML/TOML, Cron (妙用盒11项确定性工具)",
  "tools": [
    {
      "name": "convert_units",
      "description": "高精度确定性单位换算（11 类 64 单位，50 位精度）/ Deterministic unit converter across 11 physical dimensions (length/area/volume/mass/temperature/speed/data/pressure/energy/power/angle, incl. CN mu/jin/chi, KB/KiB, kcal/kWh, PS/hp). Category is auto-inferred from from/to when omitted. Example: {\"value\": 100, \"from\": \"km\", \"to\": \"mile\"}.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "category": {
            "description": "可选物理量类别（省略时自动按 from/to 推断）/ Optional category: length|area|volume|mass|temperature|speed|data|pressure|energy|power|angle",
            "type": "string",
            "enum": [
              "length",
              "area",
              "volume",
              "mass",
              "temperature",
              "speed",
              "data",
              "pressure",
              "energy",
              "power",
              "angle"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            ],
            "description": "待换算数值 / Numeric value (number or string, |v| in 1e-30..1e30), e.g. 100"
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "源单位 ID（不区分大小写，支持常见别名如 lb/ft/in/km/h/celsius）/ Source unit ID, e.g. km, m, kg, jin, c, f, mb, mib, kpa, kcal, kw, deg"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "目标单位 ID（须与 from 属于同一物理量纲）/ Target unit ID in the same category, e.g. mile, foot, pound, f, gib, psi, kwh, hp, rad"
          }
        },
        "required": [
          "value",
          "from",
          "to"
        ]
      }
    },
    {
      "name": "calculate_mortgage",
      "description": "固定名义年利率房贷试算，支持等额本息(annuity)、等额本金(principal)与对比(both) / Fixed-rate mortgage calculator (annuity vs equal-principal). Pass annualRate in percent (e.g. 3.5 for 3.5%). Example: {\"principal\": 1000000, \"months\": 360, \"annualRate\": 3.5}.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "principal": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            ],
            "description": "贷款本金（人民币元，0 < P <= 100000000）/ Loan principal in CNY, e.g. 1000000"
          },
          "months": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "maxLength": 16,
                "pattern": "^-?\\d+$"
              }
            ],
            "description": "贷款期限（整月，1–600，如 30 年填 360）/ Loan term in months (1-600), e.g. 360"
          },
          "annualRate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            ],
            "description": "固定年利率百分数（如 3.5 表示 3.5%，非 0.035，范围 0–30）/ Annual rate in %, e.g. 3.5"
          },
          "mode": {
            "default": "both",
            "description": "还款方式 / Repayment mode: both (default) | annuity | principal",
            "type": "string",
            "enum": [
              "both",
              "annuity",
              "principal"
            ]
          },
          "includeSchedule": {
            "default": false,
            "description": "是否返回分页明细（默认 false）/ Include paginated schedule (default false)",
            "type": "boolean"
          },
          "scheduleStart": {
            "default": 1,
            "description": "明细起始期数（从 1 开始）/ Start month index (default 1)",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "maxLength": 16,
                "pattern": "^-?\\d+$"
              }
            ]
          },
          "scheduleLimit": {
            "default": 12,
            "description": "明细返回期数上限（1–24）/ Max schedule rows (1-24, default 12)",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "maxLength": 16,
                "pattern": "^-?\\d+$"
              }
            ]
          }
        },
        "required": [
          "principal",
          "months",
          "annualRate"
        ]
      }
    },
    {
      "name": "calculate_mortgage_plus",
      "description": "组合贷（商贷+公积金）与一次性提前还本对比（缩短年限 vs 减少月供）/ Combined commercial+provident mortgage & lump-sum prepayment comparison. scenario is auto-inferred when omitted. Examples: combined={\"commercialPrincipal\":1000000,\"commercialMonths\":360,\"commercialRate\":3.5,\"providentPrincipal\":600000,\"providentMonths\":360,\"providentRate\":2.85}; prepayment={\"principal\":1000000,\"months\":360,\"annualRate\":3.5,\"prepayMonth\":24,\"prepayAmount\":200000}.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "scenario": {
            "description": "可选场景（省略时按入参自动推断）/ Optional scenario: combined | prepayment",
            "type": "string",
            "enum": [
              "combined",
              "prepayment"
            ]
          },
          "commercialPrincipal": {
            "description": "【combined】商贷本金（元）/ Commercial principal (CNY)",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            ]
          },
          "commercialMonths": {
            "description": "【combined】商贷期限（整月，1–600）/ Commercial months",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "maxLength": 16,
                "pattern": "^-?\\d+$"
              }
            ]
          },
          "commercialRate": {
            "description": "【combined】商贷年利率（%，如 3.5）/ Commercial annual rate (%)",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            ]
          },
          "commercialMode": {
            "default": "annuity",
            "description": "【combined】商贷还款方式：annuity | principal",
            "type": "string",
            "enum": [
              "annuity",
              "principal"
            ]
          },
          "providentPrincipal": {
            "description": "【combined】公积金本金（元）/ Provident fund principal (CNY)",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            ]
          },
          "providentMonths": {
            "description": "【combined】公积金期限（整月，1–600）/ Provident fund months",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "maxLength": 16,
                "pattern": "^-?\\d+$"
              }
            ]
          },
          "providentRate": {
            "description": "【combined】公积金年利率（%，如 2.85）/ Provident fund annual rate (%)",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            ]
          },
          "providentMode": {
            "default": "annuity",
            "description": "【combined】公积金还款方式：annuity | principal",
            "type": "string",
            "enum": [
              "annuity",
              "principal"
            ]
          },
          "principal": {
            "description": "【prepayment】原贷款本金（元）/ Original loan principal (CNY)",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            ]
          },
          "months": {
            "description": "【prepayment】原贷款期限（整月，2–600）/ Original months (2-600)",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "maxLength": 16,
                "pattern": "^-?\\d+$"
              }
            ]
          },
          "annualRate": {
            "description": "【prepayment】原年利率（%，如 3.5）/ Original annual rate (%)",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            ]
          },
          "mode": {
            "default": "annuity",
            "description": "【prepayment】原还款方式：annuity | principal",
            "type": "string",
            "enum": [
              "annuity",
              "principal"
            ]
          },
          "prepayMonth": {
            "description": "【prepayment】已还满第几期后提前还本（1–599）/ Prepay after month N",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "maxLength": 16,
                "pattern": "^-?\\d+$"
              }
            ]
          },
          "prepayAmount": {
            "description": "【prepayment】一次性提前还款本金（元）/ Lump-sum prepay amount (CNY)",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            ]
          },
          "includeSchedule": {
            "default": false,
            "description": "是否附带分页明细（默认 false）/ Include paginated schedule",
            "type": "boolean"
          },
          "scheduleStart": {
            "default": 1,
            "description": "明细起始期数（从 1 开始）/ Start month index",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "maxLength": 16,
                "pattern": "^-?\\d+$"
              }
            ]
          },
          "scheduleLimit": {
            "default": 12,
            "description": "明细返回期数上限（1–24）/ Max schedule rows (1-24)",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "maxLength": 16,
                "pattern": "^-?\\d+$"
              }
            ]
          }
        }
      }
    },
    {
      "name": "calculate_date",
      "description": "确定性日历与工作日计算（1900–2100，内置 2025–2027 中国法定节假日与调休补班）/ Deterministic date & China workday calculator (2025-2027 official holidays). action is auto-inferred when omitted. Examples: diff={\"startDate\":\"2026-01-01\",\"endDate\":\"2026-12-31\"}; offset={\"baseDate\":\"2026-09-28\",\"delta\":5,\"unit\":\"workdays\"}; inspect={\"date\":\"2027-02-06\"}.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "action": {
            "description": "可选操作类型（省略时自动推断）/ Optional action: diff | offset | inspect",
            "type": "string",
            "enum": [
              "diff",
              "offset",
              "inspect"
            ]
          },
          "workdayRule": {
            "default": "cn_official",
            "description": "工作日规则 / Workday rule: cn_official (China holidays, default) | standard (Mon-Fri)",
            "type": "string",
            "enum": [
              "cn_official",
              "standard"
            ]
          },
          "startDate": {
            "description": "【diff】开始日期 YYYY-MM-DD, e.g. 2026-01-01",
            "type": "string",
            "maxLength": 16
          },
          "endDate": {
            "description": "【diff】结束日期 YYYY-MM-DD, e.g. 2026-12-31",
            "type": "string",
            "maxLength": 16
          },
          "includeEnd": {
            "default": true,
            "description": "【diff】是否含结束日（默认 true）/ Include end date (default true)",
            "type": "boolean"
          },
          "baseDate": {
            "description": "【offset】基准日期 YYYY-MM-DD, e.g. 2026-09-28",
            "type": "string",
            "maxLength": 16
          },
          "delta": {
            "description": "【offset】加减整数（负数倒推，范围 -36500..36500）/ Integer offset, e.g. 5 or -10",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "maxLength": 16,
                "pattern": "^-?\\d+$"
              }
            ]
          },
          "unit": {
            "default": "workdays",
            "description": "【offset】偏移单位 / Unit: workdays (default) | days | weeks | months | years",
            "type": "string",
            "enum": [
              "workdays",
              "days",
              "weeks",
              "months",
              "years"
            ]
          },
          "date": {
            "description": "【inspect】要查询的单日 YYYY-MM-DD, e.g. 2027-02-06",
            "type": "string",
            "maxLength": 16
          }
        }
      }
    },
    {
      "name": "convert_timezone",
      "description": "确定性 IANA 时区换算与跨国会议时段规划（含夏令时消歧）/ Deterministic IANA timezone converter & meeting window planner. mode is auto-inferred when omitted. Examples: convert={\"dateTime\":\"2026-06-15 12:00\",\"sourceTimeZone\":\"Asia/Shanghai\",\"targetTimeZones\":[\"America/New_York\",\"Europe/London\"]}; meeting={\"date\":\"2026-06-15\",\"participants\":[{\"timeZone\":\"Asia/Shanghai\"},{\"timeZone\":\"America/New_York\"}]}.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "mode": {
            "description": "可选模式（省略时自动推断）/ Optional mode: convert | meeting",
            "type": "string",
            "enum": [
              "convert",
              "meeting"
            ]
          },
          "dateTime": {
            "description": "【convert】基准当地日期时间 / Local date-time, e.g. \"2026-06-15 12:00\"",
            "type": "string",
            "maxLength": 40
          },
          "date": {
            "description": "【convert/meeting】日期 YYYY-MM-DD（meeting 模式必填）/ Date YYYY-MM-DD",
            "type": "string",
            "maxLength": 16
          },
          "time": {
            "description": "【convert】时间 HH:mm（配合 date 使用，默认 09:00）/ Time HH:mm",
            "type": "string",
            "maxLength": 16
          },
          "sourceTimeZone": {
            "description": "【convert】基准 IANA 时区 / Source IANA TZ, e.g. Asia/Shanghai",
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "targetTimeZones": {
            "description": "【convert】1–12 个目标 IANA 时区（支持单字符串或数组）/ Target IANA TZ string or array, e.g. [\"America/New_York\"]",
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              {
                "minItems": 1,
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            ]
          },
          "disambiguation": {
            "default": "earlier",
            "description": "【convert】夏令时重叠消歧：earlier (default) | later | reject",
            "type": "string",
            "enum": [
              "earlier",
              "later",
              "reject"
            ]
          },
          "participants": {
            "description": "【meeting】2–12 位参与者时区配置 / 2-12 participants",
            "minItems": 2,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "timeZone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "参与者 IANA 时区 ID, e.g. Asia/Shanghai"
                },
                "label": {
                  "description": "城市或成员备注名 / Optional label",
                  "type": "string",
                  "maxLength": 40
                },
                "workStartHour": {
                  "description": "工作开始小时（0–23，默认 9）/ Work start hour",
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "maxLength": 16,
                      "pattern": "^-?\\d+$"
                    }
                  ]
                },
                "workEndHour": {
                  "description": "工作结束小时（1–24，默认 18）/ Work end hour",
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "string",
                      "maxLength": 16,
                      "pattern": "^-?\\d+$"
                    }
                  ]
                }
              },
              "required": [
                "timeZone"
              ]
            }
          },
          "stepMinutes": {
            "default": 60,
            "description": "【meeting】步长：60（默认）或 30 分钟 / Step minutes: 60 | 30",
            "anyOf": [
              {
                "type": "number",
                "const": 30
              },
              {
                "type": "number",
                "const": 60
              }
            ]
          },
          "includeSlots": {
            "default": false,
            "description": "【meeting】是否返回全天 slots 明细（默认 false）/ Include full day slots",
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "calculate_interest",
      "description": "50 位精度理财与分期试算：simple(单利)、compound(复利/EAR)、sip(定投)、irr(内部收益率)、installment_apr(分期真实年化 EAR/APR)/ High-precision finance calculator. mode & installment inputMode are auto-inferred when omitted; irr defaults to yearly, sip defaults to monthly. Examples: compound={\"mode\":\"compound\",\"principal\":100000,\"annualRatePercent\":4.5,\"years\":10}; irr={\"cashFlows\":[-10000,3000,4000,5000]}; installment_apr={\"principal\":12000,\"months\":12,\"monthlyFeeRatePercent\":0.5}.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "mode": {
            "description": "可选模式（省略时按独占参数推断）/ Optional mode: simple | compound | sip | irr | installment_apr",
            "type": "string",
            "enum": [
              "simple",
              "compound",
              "sip",
              "irr",
              "installment_apr"
            ]
          },
          "principal": {
            "description": "【simple/compound/installment_apr】本金（元）/ Principal (CNY)",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            ]
          },
          "annualRatePercent": {
            "description": "【simple/compound/sip】年利率百分数（如 4.5 表示 4.5%）/ Annual rate in %",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            ]
          },
          "term": {
            "description": "【simple/compound】投资期限数值（可与 years 二选一）/ Term value",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            ]
          },
          "termUnit": {
            "description": "【simple/compound】期限单位：year (default) | month | day",
            "type": "string",
            "enum": [
              "year",
              "month",
              "day"
            ]
          },
          "years": {
            "description": "【simple/compound】投资年数（等价 term+year）/ Investment years",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            ]
          },
          "compounding": {
            "default": "monthly",
            "description": "【compound】复利频率（默认 monthly）/ Compounding frequency",
            "type": "string",
            "enum": [
              "yearly",
              "half_yearly",
              "quarterly",
              "monthly",
              "daily"
            ]
          },
          "initialPrincipal": {
            "description": "【sip】初始本金（默认 0）/ Initial principal",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            ]
          },
          "periodicContribution": {
            "description": "【sip】每期定投金额（元）/ Periodic contribution",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            ]
          },
          "periods": {
            "description": "【sip】定投总期数（1–600）/ Total SIP periods",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "maxLength": 16,
                "pattern": "^-?\\d+$"
              }
            ]
