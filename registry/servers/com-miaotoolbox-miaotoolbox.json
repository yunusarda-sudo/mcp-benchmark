{
 "$schema": "../schema.json",
 "name": "com.miaotoolbox/miaotoolbox",
 "title": "MiaoToolbox (妙用盒)",
 "category": "Other",
 "description": "Free keyless MCP: unit, timezone, mortgage, IRR, China tax, RMB/VAT & table tools (妙用盒9项确定性工具)",
 "tools": [
  {
   "name": "convert_units",
   "description": "高精度确定性单位换算，支持长度(length: mm/cm/m/km/inch/foot/mile)、面积(area: mm2/cm2/m2/km2/ha)、体积(volume: ml/l/cm3/m3)、质量(mass: mg/g/kg/tonne/pound)、温度(temperature: c/f/k)、速度(speed: ms/kmh/mph)。使用 50 位十进制精度计算，返回精确结果与网页链接。",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "category": {
      "type": "string",
      "enum": [
       "length",
       "area",
       "volume",
       "mass",
       "temperature",
       "speed"
      ],
      "description": "物理量类别：length / area / volume / mass / temperature / speed"
     },
     "value": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       }
      ],
      "description": "待换算数值（数字或数字字符串，绝对值 1e-30 至 1e30）"
     },
     "from": {
      "type": "string",
      "enum": [
       "mm",
       "cm",
       "m",
       "km",
       "inch",
       "foot",
       "mile",
       "mm2",
       "cm2",
       "m2",
       "km2",
       "ha",
       "ml",
       "l",
       "cm3",
       "m3",
       "mg",
       "g",
       "kg",
       "tonne",
       "pound",
       "c",
       "f",
       "k",
       "ms",
       "kmh",
       "mph"
      ],
      "description": "源单位 ID，必须属于所选 category"
     },
     "to": {
      "type": "string",
      "enum": [
       "mm",
       "cm",
       "m",
       "km",
       "inch",
       "foot",
       "mile",
       "mm2",
       "cm2",
       "m2",
       "km2",
       "ha",
       "ml",
       "l",
       "cm3",
       "m3",
       "mg",
       "g",
       "kg",
       "tonne",
       "pound",
       "c",
       "f",
       "k",
       "ms",
       "kmh",
       "mph"
      ],
      "description": "目标单位 ID，必须属于所选 category"
     }
    },
    "required": [
     "category",
     "value",
     "from",
     "to"
    ]
   }
  },
  {
   "name": "calculate_mortgage",
   "description": "固定名义年利率、整月期末还款模型房贷试算。支持等额本息(annuity)、等额本金(principal)及两者对比(both)。默认仅返回汇总结果，避免占用过多上下文；如需逐月明细可设置 includeSchedule=true 并分页（每次最多 24 期）。",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "principal": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       }
      ],
      "description": "贷款本金（人民币元），大于 0 且不超过 100000000，最多 2 位小数"
     },
     "months": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600,
      "description": "贷款期限（整月，1 至 600 个月，即最多 50 年）"
     },
     "annualRate": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       }
      ],
      "description": "固定名义年利率（百分数，如 3.5 表示 3.5%），范围 0 至 30，最多 6 位小数"
     },
     "mode": {
      "default": "both",
      "description": "还款方式：both（默认对比）/ annuity（等额本息）/ principal（等额本金）",
      "type": "string",
      "enum": [
       "both",
       "annuity",
       "principal"
      ]
     },
     "includeSchedule": {
      "default": false,
      "description": "是否附带还款计划明细（默认 false）",
      "type": "boolean"
     },
     "scheduleStart": {
      "default": 1,
      "description": "明细起始期数（从 1 开始）",
      "type": "integer",
      "minimum": 1,
      "maximum": 600
     },
     "scheduleLimit": {
      "default": 12,
      "description": "明细返回期数上限（1 至 24 期）",
      "type": "integer",
      "minimum": 1,
      "maximum": 24
     }
    },
    "required": [
     "principal",
     "months",
     "annualRate"
    ]
   }
  },
  {
   "name": "calculate_mortgage_plus",
   "description": "支持两大场景：1) scenario=\"combined\" 商业贷款+公积金贷款组合试算（各自支持独立本金/期限/利率/等额本息或等额本金）；2) scenario=\"prepayment\" 一次性提前还本对比“缩短年限”与“减少月供”的省息与缩期效果。默认仅返回汇总，可选分页明细（单次最多 24 期）。",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "scenario": {
      "type": "string",
      "enum": [
       "combined",
       "prepayment"
      ],
      "description": "试算场景：combined（组合贷款）或 prepayment（提前还款）"
     },
     "commercialPrincipal": {
      "description": "【组合贷】商贷本金（元，0 < P <= 100000000）",
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       }
      ]
     },
     "commercialMonths": {
      "description": "【组合贷】商贷期限（整月，1-600）",
      "type": "integer",
      "minimum": 1,
      "maximum": 600
     },
     "commercialRate": {
      "description": "【组合贷】商贷固定年利率（%，0-30）",
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       }
      ]
     },
     "commercialMode": {
      "default": "annuity",
      "description": "【组合贷】商贷还款方式",
      "type": "string",
      "enum": [
       "annuity",
       "principal"
      ]
     },
     "providentPrincipal": {
      "description": "【组合贷】公积金本金（元，0 < P <= 100000000）",
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       }
      ]
     },
     "providentMonths": {
      "description": "【组合贷】公积金期限（整月，1-600）",
      "type": "integer",
      "minimum": 1,
      "maximum": 600
     },
     "providentRate": {
      "description": "【组合贷】公积金固定年利率（%，0-30）",
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       }
      ]
     },
     "providentMode": {
      "default": "annuity",
      "description": "【组合贷】公积金还款方式",
      "type": "string",
      "enum": [
       "annuity",
       "principal"
      ]
     },
     "principal": {
      "description": "【提前还款】原贷款本金（元）",
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       }
      ]
     },
     "months": {
      "description": "【提前还款】原贷款期限（整月，2-600）",
      "type": "integer",
      "minimum": 2,
      "maximum": 600
     },
     "annualRate": {
      "description": "【提前还款】原固定年利率（%，0-30）",
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       }
      ]
     },
     "mode": {
      "default": "annuity",
      "description": "【提前还款】原还款方式",
      "type": "string",
      "enum": [
       "annuity",
       "principal"
      ]
     },
     "prepayMonth": {
      "description": "【提前还款】已还满第几期后一次性还本",
      "type": "integer",
      "minimum": 1,
      "maximum": 599
     },
     "prepayAmount": {
      "description": "【提前还款】提前还款本金（元）",
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       }
      ]
     },
     "includeSchedule": {
      "default": false,
      "description": "是否附带还款明细（默认 false）",
      "type": "boolean"
     },
     "scheduleStart": {
      "default": 1,
      "description": "明细起始期数（从 1 开始）",
      "type": "integer",
      "minimum": 1,
      "maximum": 600
     },
     "scheduleLimit": {
      "default": 12,
      "description": "明细返回期数上限（1-24）",
      "type": "integer",
      "minimum": 1,
      "maximum": 24
     }
    },
    "required": [
     "scenario"
    ]
   }
  },
  {
   "name": "calculate_date",
   "description": "确定性日历与工作日计算（1900-2100年，内置 2025-2026 中国国务院办公厅法定节假日与调休补班）。支持 3 种操作：1) action=\"diff\" 计算两个日期间隔天数与工作日数；2) action=\"offset\" 从基准日加减 N 个工作日/自然日/周/月/年推算目标日期；3) action=\"inspect\" 查询单日星期、是否工作日、法定假日/补班及年内天数。",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "action": {
      "type": "string",
      "enum": [
       "diff",
       "offset",
       "inspect"
      ],
      "description": "计算类型：diff（日期间隔）/ offset（日期加减推算）/ inspect（单日属性查询）"
     },
     "workdayRule": {
      "default": "cn_official",
      "description": "工作日规则：cn_official（中国法定节假日含调休，默认）或 standard（周一至周五）",
      "type": "string",
      "enum": [
       "cn_official",
       "standard"
      ]
     },
     "startDate": {
      "description": "【diff】开始日期 YYYY-MM-DD",
      "type": "string",
      "maxLength": 16
     },
     "endDate": {
      "description": "【diff】结束日期 YYYY-MM-DD",
      "type": "string",
      "maxLength": 16
     },
     "includeEnd": {
      "default": true,
      "description": "【diff】是否包含结束日（默认 true，两头都算）",
      "type": "boolean"
     },
     "baseDate": {
      "description": "【offset】基准日期 YYYY-MM-DD",
      "type": "string",
      "maxLength": 16
     },
     "delta": {
      "description": "【offset】加减数量（负数往前倒推）",
      "type": "integer",
      "minimum": -36500,
      "maximum": 36500
     },
     "unit": {
      "default": "workdays",
      "description": "【offset】偏移单位",
      "type": "string",
      "enum": [
       "workdays",
       "days",
       "weeks",
       "months",
       "years"
      ]
     },
     "date": {
      "description": "【inspect】要查询的日期 YYYY-MM-DD",
      "type": "string",
      "maxLength": 16
     }
    },
    "required": [
     "action"
    ]
   }
  },
  {
   "name": "convert_timezone",
   "description": "确定性 IANA 时区换算与跨国会议工作时段规划。1) mode=\"convert\" 将基准时间从 sourceTimeZone 转换至 1–12 个 targetTimeZones，自动识别夏令时跳空与重叠消歧；2) mode=\"meeting\" 评估 2–12 位参与者指定日期的工作时段重合度，默认仅返回推荐黄金/可协调窗口以节省上下文（如需全天逐时段明细可设 includeSlots=true）。",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "mode": {
      "type": "string",
      "enum": [
       "convert",
       "meeting"
      ],
      "description": "模式：convert（多城市换算）或 meeting（跨国会议时间规划）"
     },
     "dateTime": {
      "description": "【convert】基准当地日期时间，如 \"2026-06-15 12:00\"",
      "type": "string",
      "maxLength": 40
     },
     "date": {
      "description": "【convert/meeting】日期 YYYY-MM-DD（meeting 模式必填）",
      "type": "string",
      "maxLength": 16
     },
     "time": {
      "description": "【convert】时间 HH:mm（与 date 配合使用，默认 09:00）",
      "type": "string",
      "maxLength": 16
     },
     "sourceTimeZone": {
      "description": "【convert】基准 IANA 时区 ID，如 Asia/Shanghai",
      "type": "string",
      "minLength": 1,
      "maxLength": 80
     },
     "targetTimeZones": {
      "description": "【convert】1 至 12 个目标 IANA 时区 ID",
      "minItems": 1,
      "maxItems": 12,
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1,
       "maxLength": 80
      }
     },
     "disambiguation": {
      "default": "earlier",
      "description": "【convert】夏令时重叠时刻消歧策略：earlier（默认）/ later / reject",
      "type": "string",
      "enum": [
       "earlier",
       "later",
       "reject"
      ]
     },
     "participants": {
      "description": "【meeting】2 至 12 位参与者时区配置",
      "minItems": 2,
      "maxItems": 12,
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "timeZone": {
         "type": "string",
         "minLength": 1,
         "maxLength": 80,
         "description": "参与者 IANA 时区 ID"
        },
        "label": {
         "description": "城市或成员备注名",
         "type": "string",
         "maxLength": 40
        },
        "workStartHour": {
         "description": "工作开始小时（0-23，默认 9）",
         "type": "integer",
         "minimum": 0,
         "maximum": 23
        },
        "workEndHour": {
         "description": "工作结束小时（1-24，默认 18）",
         "type": "integer",
         "minimum": 1,
         "maximum": 24
        }
       },
       "required": [
        "timeZone"
       ]
      }
     },
     "stepMinutes": {
      "default": 60,
      "description": "【meeting】评估步长：60（默认）或 30 分钟",
      "anyOf": [
       {
        "type": "number",
        "const": 30
       },
       {
        "type": "number",
        "const": 60
       }
      ]
     },
     "includeSlots": {
      "default": false,
      "description": "【meeting】是否返回全天全部时段 slots 明细（默认 false，避免占用过多上下文）",
      "type": "boolean"
     }
    },
    "required": [
     "mode"
    ]
   }
  },
  {
   "name": "calculate_interest",
   "description": "使用 50 位十进制精度试算四种理财与投资模型：simple（单利）、compound（复利与有效年利率 EAR）、sip（定期定投）、irr（现金流内部收益率，支持 2–120 期）。默认仅返回汇总结果；compound/sip 如需分期明细可设 includeSchedule=true 并分页（每次最多 24 期）。",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "mode": {
      "type": "string",
      "enum": [
       "simple",
       "compound",
       "sip",
       "irr"
      ],
      "description": "试算模式：simple / compound / sip / irr"
     },
     "principal": {
      "description": "【simple/compound】本金（元，>0 且 <=1万亿）",
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       }
      ]
     },
     "annualRatePercent": {
      "description": "【simple/compound/sip】年利率或预期年化收益率（%，0–1000）",
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       }
      ]
     },
     "term": {
      "description": "【simple/compound】投资期限数值",
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       }
      ]
     },
     "termUnit": {
      "description": "【simple/compound】期限单位：year / month / day（默认 year）",
      "type": "string",
      "enum": [
       "year",
       "month",
       "day"
      ]
     },
     "years": {
      "description": "【compound】投资年数（与 term/termUnit 二选一）",
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       }
      ]
     },
     "compounding": {
      "default": "monthly",
      "description": "【compound】复利计息频率",
      "type": "string",
      "enum": [
       "yearly",
       "half_yearly",
       "quarterly",
       "monthly",
       "daily"
      ]
     },
     "initialPrincipal": {
      "description": "【sip】初始本金（元，默认 0）",
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       }
      ]
     },
     "periodicContribution": {
      "description": "【sip】每期定投金额（元）",
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       }
      ]
     },
     "periods": {
      "description": "【sip】定投总期数（1–600）",
      "type": "integer",
      "minimum": 1,
      "maximum": 600
     },
     "frequency": {
      "description": "【sip/irr】频率：sip 支持 monthly/weekly/yearly；irr 支持 yearly/quarterly/monthly",
      "type": "string",
      "enum": [
       "yearly",
       "quarterly",
       "monthly",
       "weekly"
      ]
     },
     "timing": {
      "default": "end",
      "description": "【sip】扣款时机：end（期末，默认）或 begin（期初）",
      "type": "string",
      "enum": [
       "end",
       "begin"
      ]
     },
     "cashFlows": {
      "description": "【irr】现金流数组（2–120 期，负数为投入、正数为回流，至少 1 次符号变化）",
      "minItems": 2,
      "maxItems": 120,
      "type": "array",
      "items": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "string",
         "minLength": 1,
         "maxLength": 80
        }
       ]
      }
     },
     "includeSchedule": {
      "default": false,
      "description": "【compound/sip】是否附带分期明细（默认 false）",
      "type": "boolean"
     },
     "scheduleStart": {
      "default": 1,
      "description": "【compound/sip】明细起始期数（从 1 开始）",
      "type": "integer",
      "minimum": 1,
      "maximum": 600
     },
     "scheduleLimit": {
      "default": 12,
      "description": "【compound/sip】明细每页条数（1–24）",
      "type": "integer",
      "minimum": 1,
      "maximum": 24
     }
    },
    "required": [
     "mode"
    ]
   }
  },
  {
   "name": "convert_rmb_and_invoice_tax",
   "description": "按《会计基础工作规范》将金额转换为规范人民币中文大写（无漏零、不出现亿万，精确到分），并支持增值税含税↔不含税分位减法平账拆算（1%/3%/5%/6%/9%/13% 或 0–50% 自定义税率）。",
   "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
     "mode": {
      "type": "string",
      "enum": [
       "rmb",
       "invoice",
       "both"
      ],
      "description": "模式：rmb（仅转人民币大写）/ invoice（仅价税分离）/ both（同时输出价税分离与含税大写）"
     },
     "amount": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       }
      ],
