    {
      "name": "convert_table_format",
      "description": "RFC 4180 CSV、JSON 对象数组与 Markdown GFM 表格双向转换。为适配 MCP 上下文预算，仅处理有界小段结构化数据（输入 ≤ 8,000 字符且 ≤ 12,000 字节、≤ 200 行、≤ 30 列）；超限将返回网页版处理引导链接。",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "minLength": 1,
            "description": "待转换表格文本（支持 CSV/TSV/分号分隔、JSON 对象数组或 Markdown GFM 表格，上限 8,000 字符）"
          },
          "sourceFormat": {
            "type": "string",
            "enum": [
              "csv",
              "json",
              "markdown"
            ],
            "description": "源格式：csv / json / markdown"
          },
          "targetFormat": {
            "type": "string",
            "enum": [
              "csv",
              "json",
              "markdown"
            ],
            "description": "目标格式：csv / json / markdown"
          },
          "sourceDelimiter": {
            "default": "auto",
            "description": "【源为 csv】输入分隔符：auto（默认自动识别）/ , / ; / \\t",
            "type": "string",
            "enum": [
              "auto",
              ",",
              ";",
              "\t"
            ]
          },
          "targetDelimiter": {
            "default": ",",
            "description": "【目标为 csv】输出分隔符：,（默认）/ ; / \\t",
            "type": "string",
            "enum": [
              ",",
              ";",
              "\t"
            ]
          },
          "inferTypes": {
            "default": false,
            "description": "【目标为 json】是否启用安全类型推断（布尔/null/安全数字，默认 false）",
            "type": "boolean"
          },
          "jsonIndent": {
            "default": 2,
            "description": "【目标为 json】缩进空格数（0–4，默认 2）",
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "escapeFormula": {
            "default": false,
            "description": "【目标为 csv】是否对公式风险前缀（= + - @ \\t \\r）加前置单引号防注入（默认 false）",
            "type": "boolean"
          },
          "includeBom": {
            "default": false,
            "description": "【目标为 csv】是否在输出前添加 UTF-8 BOM（默认 false）",
            "type": "boolean"
          }
        },
        "required": [
          "input",
          "sourceFormat",
          "targetFormat"
        ]
      }
    },
