        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "5 位或 6 位 Cron 表达式（支持 @daily/@hourly 等宏）"
