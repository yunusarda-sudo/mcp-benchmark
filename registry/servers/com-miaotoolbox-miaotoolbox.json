              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "maxLength": 16,
                "pattern": "^-?\\d+$"
              }
            ]
          },
          "from": {
            "description": "可选基准时间（ISO 8601 字符串，默认当前时间）/ Optional ISO-8601 start time",
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "expression"
        ]
      }
    }
