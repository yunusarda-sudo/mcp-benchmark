    {
      "name": "convert_table_format",
      "description": "RFC 4180 CSV、JSON 对象数组与 Markdown GFM 表格双向转换（≤8,000 字符、≤200 行、≤30 列）/ Convert between CSV/TSV, JSON array, and Markdown table. Case-insensitive format names with md/tsv aliases. Example: {\"input\":\"name,age\\nAlice,30\",\"sourceFormat\":\"csv\",\"targetFormat\":\"markdown\"}.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "minLength": 1,
            "description": "待转换表格文本（≤8,000 字符）/ Table text (CSV/TSV, JSON array, or Markdown GFM)"
          },
          "sourceFormat": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16,
            "description": "源格式：csv | json | markdown（不区分大小写，支持 tsv/md）"
          },
          "targetFormat": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16,
            "description": "目标格式：csv | json | markdown（不区分大小写，支持 tsv/md）"
          },
          "sourceDelimiter": {
            "description": "【源为 csv】输入分隔符：auto (default) | , | ; | \\t",
            "type": "string",
            "enum": [
              "auto",
              ",",
              ";",
              "\t"
            ]
          },
          "targetDelimiter": {
            "description": "【目标为 csv】输出分隔符：, (default；targetFormat 为 tsv 时默认 \\t) | ; | \\t",
            "type": "string",
            "enum": [
              ",",
              ";",
              "\t"
            ]
          },
          "inferTypes": {
            "default": false,
            "description": "【目标为 json】是否启用安全类型推断（默认 false）",
            "type": "boolean"
          },
