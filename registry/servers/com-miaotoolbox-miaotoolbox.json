            "description": "【目标为 json】缩进空格数（0–4，默认 2）",
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "maxLength": 16,
                "pattern": "^-?\\d+$"
              }
            ]
          },
          "escapeFormula": {
