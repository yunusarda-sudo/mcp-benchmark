{
  "$schema": "../schema.json",
  "name": "com.miaotoolbox/miaotoolbox",
  "title": "MiaoToolbox (妙用盒)",
  "category": "Other",
  "description": "Free keyless MCP: unit, timezone, mortgage, IRR/APR, China tax, YAML/TOML, Cron (妙用盒11项确定性工具)",
  "tools": [
    {
      "name": "convert_units",
      "description": "高精度确定性单位换算（11 个独立物理量纲、64 个单位，50 位十进制精度）：长度/面积/体积/质量（含大陆常用市制亩/斤/尺）/温度/速度/存储(KB与KiB)/压强/能量(kcal=4184J)/功率(PS与hp)/角度。",
