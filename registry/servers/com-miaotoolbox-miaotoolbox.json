            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "from": {
            "description": "可选基准时间（ISO 8601 字符串，默认当前时间）",
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "expression"
        ]
      }
