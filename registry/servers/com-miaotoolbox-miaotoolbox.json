    {
      "name": "parse_cron",
      "description": "解析 5 位 Unix Cron 与 6 位秒级 Cron，输出中文语义解释及指定 IANA 时区未来 1–20 次触发时间 / Parse 5-field or 6-field Cron expression (supports @daily/@hourly) and compute next 1-20 runs in an IANA timezone. Example: {\"expression\":\"0 9 * * 1-5\",\"timeZone\":\"Asia/Shanghai\",\"count\":5}.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "5 位或 6 位 Cron 表达式（支持 @daily/@hourly 等宏）/ Cron expression, e.g. \"0 9 * * 1-5\" or \"0 */15 * * * *\""
          },
          "timeZone": {
            "default": "Asia/Shanghai",
            "description": "IANA 时区 ID，默认 Asia/Shanghai / IANA timezone",
