{
  "$schema": "../schema.json",
  "name": "io.github.RandallShanePhD/SmartyPantsAPI",
  "title": "Smarty-Pants AI",
  "category": "AI, LLMs & Agents",
  "description": "Agentic cybersecurity tool: URL phishing/malware scanning and more.",
  "tools": [
    {
      "name": "scan_url",
      "description": "Scan a single URL for phishing or malware risk.\n\n    Args:\n        url: The URL to scan.\n        temperature: Optional decision threshold from 0.0 to 1.0. Higher is\n            stricter; when omitted the service default is used.\n    ",
      "inputSchema": {
        "properties": {
          "url": {
            "title": "Url",
            "type": "string"
          },
          "temperature": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Temperature"
          }
        },
        "required": [
          "url"
        ],
        "type": "object",
        "title": "scan_urlArguments"
      }
    },
    {
      "name": "scan_urls",
      "description": "Scan several URLs in one request.\n\n    Args:\n        urls: The URLs to scan.\n        temperature: Optional decision threshold from 0.0 to 1.0. Higher is\n            stricter; when omitted the service default is used.\n    ",
      "inputSchema": {
        "properties": {
          "urls": {
            "items": {
              "type": "string"
            },
            "title": "Urls",
            "type": "array"
          },
          "temperature": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Temperature"
          }
        },
        "required": [
          "urls"
        ],
        "type": "object",
        "title": "scan_urlsArguments"
      }
    },
    {
      "name": "get_usage",
      "description": "Return this account's monthly usage and remaining plan allowance.\n\n    Args:\n        year: Four-digit UTC year; defaults to the current year.\n        month: UTC month from 1 to 12; defaults to the current month.\n    ",
      "inputSchema": {
        "properties": {
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Year"
          },
          "month": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Month"
          }
        },
        "type": "object",
        "title": "get_usageArguments"
      }
    }
  ],
