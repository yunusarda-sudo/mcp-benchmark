{
  "$schema": "../schema.json",
  "name": "trade.ellimist/ellimist",
  "title": "Ellimist",
  "category": "Observability & Analytics",
  "description": "Pay-per-call on-chain data, OFAC screening, macro data, quantum analytics and LI.FI swaps (x402).",
  "tools": [
    {
      "name": "find_skill",
      "description": "Describe what you need in plain words (e.g. 'is this wallet sanctioned', 'earthquakes near Tokyo'). Returns matching tools with price, input schema and an example call. Free.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 300
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "get_task",
      "description": "Poll a task returned by a paid tool: pass its task_id and the read_token from the task's access block. Returns its state and, once complete, the signed result. Free.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "read_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "task_id",
          "read_token"
        ]
      }
    },
    {
      "name": "cancel_task",
      "description": "Cancel a task that is still queued, using the cancel_token from its access block. The payment authorization is released and nothing is charged. Free.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "cancel_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "task_id",
          "cancel_token"
        ]
      }
    },
    {
      "name": "data_attest_snapshot",
      "description": "Signed statement of the value Ellimist recorded at or just before time T: Aave USDC rates, native USDC supply or the Treasury curve. For backtests, audits and disputes. Price: $0.01 USDC per call via x402 (no account). Not charged if it fails.",
      "inputSchema": {
        "properties": {
          "feed": {
            "enum": [
              "treasury_curve",
              "aave_rates",
              "usdc_supply"
            ],
            "title": "Feed",
            "type": "string"
          },
          "key": {
            "description": "Chain (base, ethereum) or UST",
            "maxLength": 160,
            "title": "Key",
            "type": "string"
          },
          "at": {
            "description": "Point in time (UTC) to attest",
            "format": "date-time",
            "title": "At",
            "type": "string"
          }
        },
        "required": [
          "feed",
          "key",
          "at"
        ],
        "title": "SnapshotParams",
        "type": "object"
      }
    },
    {
      "name": "data_chain_account",
      "description": "Use this to know everything basic about a wallet in one call: native and USDC balances (plus up to 5 tokens you name), nonce, whether it is a contract or an EIP-7702 delegated account, whether its public key is already revealed on this chain (quantum exposure), contract details (code size, minimal proxy, owner) and an official OFAC sanctions check. All read at once. Price: $0.01 USDC per call via x402 (no account). Not charged if it fails.",
      "inputSchema": {
        "properties": {
          "address": {
            "title": "Address",
            "type": "string"
          },
          "chain": {
            "default": "ethereum",
            "enum": [
              "ethereum",
              "base",
              "arbitrum",
              "optimism",
              "polygon",
              "bsc",
              "avalanche"
            ],
            "title": "Chain",
            "type": "string"
          },
          "tokens": {
            "description": "extra ERC-20 tokens to include (native USDC is always included)",
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "title": "Tokens",
            "type": "array"
          }
        },
        "required": [
          "address"
        ],
        "title": "AccountParams",
        "type": "object"
      }
    },
    {
      "name": "data_chain_erc20_transfers",
      "description": "Use this to list recent ERC-20 Transfer events for a token, optionally only those to or from one address (up to 2,000 recent blocks): incoming/outgoing payments, flows. Price: $0.005 USDC per call via x402 (no account). Not charged if it fails.",
      "inputSchema": {
        "properties": {
          "chain": {
            "default": "ethereum",
            "enum": [
              "ethereum",
              "base",
              "arbitrum",
              "optimism",
              "polygon",
              "bsc",
              "avalanche"
            ],
            "title": "Chain",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          },
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Address"
          },
          "blocks": {
            "default": 500,
            "maximum": 2000,
            "minimum": 1,
            "title": "Blocks",
            "type": "integer"
          }
        },
        "required": [
          "token"
        ],
        "title": "TransfersParams",
        "type": "object"
      }
    },
    {
      "name": "data_defi_aave_rates",
      "description": "Use this to get the current USDC lending (supply) APR and variable borrow APR on Aave V3 (Base or Ethereum), read from the Aave pool contract at a finalized block. Price: $0.005 USDC per call via x402 (no account). Not charged if it fails.",
      "inputSchema": {
        "properties": {
          "chain": {
            "default": "base",
            "enum": [
              "ethereum",
              "base"
            ],
            "title": "Chain",
            "type": "string"
          }
        },
        "title": "AaveRateParams",
        "type": "object"
      }
    },
    {
      "name": "data_defi_yield_vs_tbill",
      "description": "Use this to compare parking USDC on Aave V3 with a 3-month U.S. Treasury bill right now: Aave's supply APR and APY, the T-bill yield, and the spread in basis points, with both source dates. Data comparison, not advice; Aave carries smart-contract risk a T-bill does not. Price: $0.01 USDC per call via x402 (no account). Not charged if it fails.",
      "inputSchema": {
        "properties": {
          "chain": {
            "default": "base",
            "enum": [
              "base",
              "ethereum"
            ],
            "title": "Chain",
            "type": "string"
          }
        },
        "title": "YieldVsTbillParams",
        "type": "object"
      }
    },
    {
      "name": "data_macro_bls",
      "description": "Use this to get U.S. Bureau of Labor Statistics series: CPI inflation, unemployment rate, payrolls, wages and other BLS series IDs (e.g. CUUR0000SA0, LNS14000000). Official public-domain data. Price: $0.005 USDC per call via x402 (no account). Not charged if it fails.",
      "inputSchema": {
        "properties": {
          "series_ids": {
            "examples": [
              [
                "CUUR0000SA0",
                "LNS14000000"
              ]
            ],
            "items": {
              "pattern": "^[A-Za-z0-9_#\\-]{1,50}$",
              "type": "string"
            },
            "maxItems": 25,
            "minItems": 1,
            "title": "Series Ids",
            "type": "array"
          }
        },
        "required": [
          "series_ids"
        ],
        "title": "BlsParams",
        "type": "object"
      }
    },
    {
      "name": "data_macro_recession_signals",
      "description": "Use this to answer 'are recession signals on?' in one call: Treasury yield-curve inversion (10y-2y and 10y-3m), the Sahm rule from BLS unemployment, and real 10-year and 3-month rates after CPI inflation. Each with its official source date. Data, not advice. Price: $0.01 USDC per call via x402 (no account). Not charged if it fails.",
      "inputSchema": {
        "properties": {},
        "title": "NoParams",
        "type": "object"
      }
    },
    {
      "name": "data_macro_treasury_curve",
      "description": "Use this to get the U.S. Treasury par yield curve (1-month to 30-year yields) by day, with 10y-2y and 10y-3m spreads for recession and rates signals. Official data. Price: $0.005 USDC per call via x402 (no account). Not charged if it fails.",
      "inputSchema": {
        "properties": {
          "start": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start"
          },
          "end": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "End"
          }
        },
        "title": "CurveParams",
        "type": "object"
      }
    },
    {
      "name": "data_risk_ofac",
      "description": "Use this to check whether a crypto wallet address is sanctioned: matches it against digital currency addresses on the official U.S. Treasury OFAC SDN list (KYC/AML screening, compliance). Price: $0.005 USDC per call via x402 (no account). Not charged if it fails.",
      "inputSchema": {
        "properties": {
          "address": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^\\S+$",
            "title": "Address",
            "type": "string"
          },
          "at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Past point in time (UTC) to check instead of today: proves whether the address was listed then, from Ellimist's list history",
            "title": "At"
          }
        },
        "required": [
          "address"
        ],
        "title": "OfacParams",
        "type": "object"
      }
    },
    {
      "name": "exchange_build_swap",
      "description": "Unsigned approval + swap transactions for the best route. Your agent signs and broadcasts from its own wallet; Ellimist never takes custody. Conversions are executed by third-party smart contracts (routed by LI.FI) that may fail or be exploited; funds may be lost and transactions are irreversible. Price: $0.005 USDC per call via x402 (no account). Not charged if it fails.",
      "inputSchema": {
        "properties": {
          "from_chain": {
            "examples": [
              "base"
            ],
            "maxLength": 40,
            "title": "From Chain",
            "type": "string"
          },
          "to_chain": {
            "examples": [
              "arbitrum"
            ],
            "maxLength": 40,
            "title": "To Chain",
            "type": "string"
          },
          "from_token": {
            "description": "symbol (USDC) or token address",
            "maxLength": 100,
            "title": "From Token",
            "type": "string"
          },
          "to_token": {
            "description": "symbol (ETH) or token address",
            "maxLength": 100,
            "title": "To Token",
            "type": "string"
          },
          "from_amount": {
            "description": "amount in the token's smallest unit",
            "pattern": "^[0-9]{1,78}$",
            "title": "From Amount",
            "type": "string"
          },
          "from_address": {
            "maxLength": 100,
            "title": "From Address",
            "type": "string"
          },
          "to_address": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "To Address"
          },
          "slippage": {
            "default": 0.005,
            "exclusiveMinimum": 0,
            "maximum": 0.03,
            "title": "Slippage",
            "type": "number"
          },
          "order": {
            "default": "CHEAPEST",
            "enum": [
              "CHEAPEST",
              "FASTEST"
            ],
            "title": "Order",
            "type": "string"
          },
          "allow_high_impact": {
            "default": false,
            "title": "Allow High Impact",
            "type": "boolean"
          }
        },
        "required": [
          "from_chain",
          "to_chain",
          "from_token",
          "to_token",
          "from_amount",
          "from_address"
        ],
        "title": "SwapParams",
        "type": "object"
      }
    },
    {
      "name": "exchange_quote",
      "description": "Best route to convert any token to any token across chains: output, minimum output, fees, gas, time; with 'alternatives', other routes to compare. Sanctions-screened. Ellimist fee: 0.25% of volume, at least $0.05 and never more than 1%. Conversions are executed by third-party smart contracts (routed by LI.FI) that may fail or be exploited; funds may be lost and transactions are irreversible. Price: $0.005 USDC per call via x402 (no account). Not charged if it fails.",
      "inputSchema": {
        "properties": {
          "from_chain": {
            "examples": [
              "base"
            ],
            "maxLength": 40,
            "title": "From Chain",
            "type": "string"
          },
          "to_chain": {
            "examples": [
              "arbitrum"
            ],
            "maxLength": 40,
            "title": "To Chain",
            "type": "string"
          },
          "from_token": {
            "description": "symbol (USDC) or token address",
            "maxLength": 100,
            "title": "From Token",
            "type": "string"
          },
          "to_token": {
            "description": "symbol (ETH) or token address",
            "maxLength": 100,
            "title": "To Token",
            "type": "string"
          },
          "from_amount": {
            "description": "amount in the token's smallest unit",
            "pattern": "^[0-9]{1,78}$",
            "title": "From Amount",
            "type": "string"
          },
          "from_address": {
            "maxLength": 100,
            "title": "From Address",
            "type": "string"
          },
          "to_address": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "To Address"
          },
          "slippage": {
            "default": 0.005,
            "exclusiveMinimum": 0,
            "maximum": 0.03,
            "title": "Slippage",
            "type": "number"
          },
          "order": {
            "default": "CHEAPEST",
            "enum": [
              "CHEAPEST",
              "FASTEST"
            ],
            "title": "Order",
            "type": "string"
          },
          "allow_high_impact": {
            "default": false,
            "title": "Allow High Impact",
            "type": "boolean"
          },
          "alternatives": {
            "default": 0,
            "description": "also return up to this many alternative routes",
            "maximum": 10,
            "minimum": 0,
            "title": "Alternatives",
            "type": "integer"
          }
        },
        "required": [
          "from_chain",
          "to_chain",
          "from_token",
          "to_token",
          "from_amount",
          "from_address"
        ],
        "title": "QuoteParams",
        "type": "object"
      }
    },
    {
      "name": "exchange_status",
      "description": "Track a broadcast swap or bridge transfer until it completes. Price: $0 USDC per call via x402 (no account). Not charged if it fails.",
      "inputSchema": {
        "properties": {
          "tx_hash": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Tx Hash",
            "type": "string"
          },
          "from_chain": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "From Chain"
          },
          "to_chain": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "To Chain"
          },
          "quote_id": {
            "anyOf": [
              {
                "maxLength": 36,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Quote Id"
          }
        },
        "required": [
          "tx_hash"
        ],
        "title": "StatusParams",
        "type": "object"
      }
    },
    {
      "name": "exchange_supported",
      "description": "Use this (free) to see which chains Ellimist can convert between and, for one chain, which tokens with their USD prices. Price: $0 USDC per call via x402 (no account). Not charged if it fails.",
      "inputSchema": {
        "properties": {
          "chain": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "chain name or id; include its tokens with prices",
            "title": "Chain"
          }
        },
        "title": "SupportedParams",
        "type": "object"
      }
    },
    {
      "name": "quantum_exposure_index",
      "description": "Use this to see how much tracked ETH sits in addresses whose public key is already revealed, and so would be exposed to a future quantum computer: daily index with history, shares of tracked balance (revealed, hidden, contract), counts and coverage. Aggregate only; no addresses. Price: $0.01 USDC per call via x402 (no account). Not charged if it fails.",
      "inputSchema": {
        "properties": {
          "chain": {
            "default": "ethereum",
            "enum": [
              "ethereum",
              "base"
            ],
            "title": "Chain",
            "type": "string"
          },
          "days": {
            "default": 30,
            "description": "history to include",
            "maximum": 365,
            "minimum": 1,
            "title": "Days",
            "type": "integer"
          }
        },
        "title": "ExposureIndexParams",
        "type": "object"
      }
    },
    {
      "name": "quantum_portfolio_index_tracking",
      "description": "Use this to pick K assets and weights that track an index with minimal tracking error, from your own asset and index return series. Price: $0.05 USDC per call via x402 (no account). Not charged if it fails.",
      "inputSchema": {
        "properties": {
          "requested_backend": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "set by Ellimist; leave empty",
            "title": "Requested Backend"
          },
          "backend_note": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "set by Ellimist; leave empty",
            "title": "Backend Note"
          },
          "assets": {
            "items": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 500,
            "minItems": 1,
            "title": "Assets",
            "type": "array"
          },
          "asset_returns": {
            "description": "T x N",
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "title": "Asset Returns",
            "type": "array"
          },
          "index_returns": {
            "description": "length T",
            "items": {
              "type": "number"
            },
            "maxItems": 5000,
            "title": "Index Returns",
            "type": "array"
          },
          "max_assets": {
            "maximum": 24,
            "minimum": 1,
            "title": "Max Assets",
            "type": "integer"
          },
          "backend": {
            "default": "aer",
            "enum": [
              "classical",
              "aer",
              "ibm"
            ],
            "title": "Backend",
            "type": "string"
          }
        },
        "required": [
          "assets",
          "asset_returns",
          "index_returns",
          "max_assets"
        ],
        "title": "TrackingParams",
        "type": "object"
      }
    },
    {
      "name": "quantum_portfolio_optimize",
      "description": "Use this to compute mean-variance portfolio weights from your own returns or covariance, optionally limited to a maximum number of assets; QAOA asset selection next to an exact classical baseline. Price: $0.05 USDC per call via x402 (no account). Not charged if it fails.",
      "inputSchema": {
        "properties": {
          "requested_backend": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "set by Ellimist; leave empty",
            "title": "Requested Backend"
          },
          "backend_note": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "set by Ellimist; leave empty",
            "title": "Backend Note"
          },
          "assets": {
            "anyOf": [
              {
                "items": {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 64,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Assets"
          },
          "expected_returns": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "maxItems": 64,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Expected Returns"
          },
          "covariance": {
            "anyOf": [
              {
                "items": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Covariance"
          },
          "returns": {
            "anyOf": [
              {
                "items": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "T x N periodic returns",
            "title": "Returns"
          },
          "periods_per_year": {
            "default": 365,
            "maximum": 100000,
            "minimum": 1,
            "title": "Periods Per Year",
            "type": "integer"
          },
          "backend": {
            "default": "aer",
            "enum": [
              "classical",
              "aer",
              "ibm"
            ],
            "title": "Backend",
            "type": "string"
          },
          "current_weights": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Your current holdings (weights by asset). Given, the result trades off turnover cost.",
            "title": "Current Weights"
          },
          "turnover_penalty": {
            "default": 0.002,
            "description": "cost per unit of turnover (e.g. fees + slippage)",
            "minimum": 0,
            "title": "Turnover Penalty",
            "type": "number"
          },
          "risk_aversion": {
            "default": 2,
            "exclusiveMinimum": 0,
            "title": "Risk Aversion",
            "type": "number"
          },
          "max_assets": {
            "anyOf": [
              {
                "maximum": 24,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Assets"
          },
          "max_weight": {
            "default": 1,
            "exclusiveMinimum": 0,
            "maximum": 1,
            "title": "Max Weight",
            "type": "number"
          }
        },
        "title": "OptimizeParams",
        "type": "object"
      }
    },
    {
      "name": "quantum_pq_exposure",
