{
  "$schema": "../schema.json",
  "name": "io.github.Tgwedwin/tgw-mindset-api",
  "title": "Think and Grow Wealthy",
  "category": "Vector DBs & AI Search",
  "description": "Web search, URL to markdown, email verify, x402 pay-to safety, SEC facts, FX. USDC/Base, no API key.",
  "tools": [
    {
      "name": "daily_mindset",
      "description": "$0.02 USDC. One wealth-mindset journal prompt and affirmation. Optional day from 1 to 90, or a theme.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "day": {
            "type": "string"
          },
          "theme": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "journal_pack",
      "description": "$0.05 USDC. Three to fourteen days of prompts. Optional goal and days.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "goal": {
            "type": "string"
          },
          "days": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "coaching",
      "description": "$0.10 USDC. A short coaching reflection on text you supply.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "selftalk",
      "description": "$0.05 USDC. The Self Talk University method for one negative thought.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "affirmations",
      "description": "$0.03 USDC. Five to ten first-person lines for a goal.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "goal": {
            "type": "string"
          },
          "count": {
            "type": "number"
          }
        },
        "required": [
          "goal"
        ]
      }
    },
    {
      "name": "affirmations_audio",
      "description": "$0.10 USDC. A short spoken affirmation MP3. Not charged if speech fails.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "goal": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "voice": {
            "type": "string"
          },
          "inline": {
            "type": "boolean"
          }
        },
        "required": [
          "goal"
        ]
      }
    },
    {
      "name": "content_pack",
      "description": "$0.07 USDC. Five social posts, three hooks, a caption, and hashtags.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "audience": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          }
        },
        "required": [
          "topic"
        ]
      }
    },
    {
      "name": "search",
      "description": "Search the live web and return snippet sources plus a short cited summary. Use it when an agent needs current public information. Buyer synonyms: web search, search API, SERP, cited summary, source lookup. Snippets are not fetched pages and are not verified. No charge if search fails.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "maxResults": {
            "type": "number"
          },
          "focus": {
            "type": "string"
          },
          "task": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "research_pack",
      "description": "$0.02 USDC. Up to 3 searches and 8 snippet sources. Not charged if nothing usable comes back.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "focus": {
            "type": "string"
          },
          "options": {
            "type": "object",
            "properties": {
              "max_searches": {
                "type": "number"
              },
              "max_sources": {
                "type": "number"
              },
              "fetch_page": {
                "type": "boolean"
              },
              "ticker": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "name": "offer_normalize",
      "description": "$0.01 USDC. Normalize up to three pasted offers. No URL is fetched.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "currency": {
            "type": "string"
          },
          "offers": {
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "horizon_months": {
            "type": "number"
          },
          "usage": {
            "type": "object",
            "properties": {
              "seats": {
                "type": "number"
              },
              "monthly_units": {
                "type": "number"
              }
            }
          },
          "fx": {
            "type": "object",
            "properties": {
              "base": {
                "type": "string"
              },
              "quote": {
                "type": "string"
              },
              "rate": {
                "type": "string"
              }
            },
            "required": [
              "base",
              "quote",
              "rate"
            ]
          }
        }
      }
    },
    {
      "name": "claim_audit",
      "description": "$0.01 USDC. Check claims against excerpts you supply. No page is fetched.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required_freshness_days": {
            "type": "number"
          },
          "as_of": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          }
        },
        "required": [
          "claims",
          "sources"
        ]
      }
    },
    {
      "name": "invoice_check",
      "description": "Check a supplied invoice's line items, tax, and total. Use it when you need to know if the arithmetic balances. Buyer synonyms: invoice checker, invoice math, tax check, AP audit, bill verification. Unknown amounts are not treated as zero. No URL is fetched.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "line_items": {
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "subtotal": {
            "type": "string"
          },
          "tax": {
            "type": "string"
          },
          "tax_rate": {
            "type": "string"
          },
          "total": {
            "type": "string"
          },
          "convert_to": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "quote_invoice_check",
      "description": "$0.01 USDC. Compare a supplied quote or purchase order with a later invoice, line by line. Flags quantity, unit price, missing and extra lines, tax, and total mismatches. Text is untrusted and is not fetched. Not accounting or legal advice.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "currency": {
            "type": "string"
          },
          "quote": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "purchase_order": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "invoice": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "mode": {
            "type": "string"
          }
        },
        "required": [
          "invoice"
        ]
      }
    },
    {
      "name": "vendor_check",
      "description": "Check a vendor domain with RDAP, DNS, SPF, DKIM, DMARC, and an optional OFAC screen. Use it when you are about to pay a new supplier. Buyer synonyms: vendor due diligence, domain age, KYB screen, email authentication, sanctions check. Not a full KYB guarantee.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "pay_to": {
            "type": "string"
          }
        },
        "required": [
          "domain"
        ]
      }
    },
    {
      "name": "pay_to_check",
      "description": "Screen a URL or wallet before paying an x402 endpoint. Use it when an agent is about to send USDC and wants safe, caution, or avoid. Buyer synonyms: x402 safety check, payTo screen, wallet risk, 402 price check, sanctions screen. A failed source is not a clean bill of health.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "pay_to": {
            "type": "string"
          },
          "expected_price": {
            "type": "string"
          },
          "network": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "email_check",
      "description": "Check one email address for syntax, MX, disposable domains, and SPF/DMARC. Use it when you need to know an address can receive mail. Buyer synonyms: email verification, email validator, disposable email check, MX lookup, SPF DMARC. No mail is sent and no SMTP connection is opened.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      }
    },
    {
      "name": "fx",
      "description": "Convert an amount with ECB reference rates and optional VAT math. Use it when an invoice or quote needs a conversion or a standard tax add-on. Buyer synonyms: currency converter, FX rate, ECB rates, VAT calculator, sales tax. Not a tradable quote and not a tax filing.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "amount": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "vat_rate": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "vat_included": {
            "type": "boolean"
          }
        },
        "required": [
          "amount",
          "from",
          "to"
        ]
      }
    },
    {
      "name": "company_facts",
      "description": "Look up a US public company by ticker or CIK and return the latest annual SEC figures. Use it when you need filing facts such as revenue or net income. Buyer synonyms: SEC EDGAR, company facts, 10-K data, ticker lookup, CIK search. Not investment advice. A missing concept is omitted, not zero.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string"
          },
          "cik": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "page_to_markdown",
      "description": "Fetch one public URL and return readable markdown. Use it when an agent needs the text of a page, docs, or article. Buyer synonyms: URL to markdown, web scraper, article extractor, HTML to text, page reader. Private and internal addresses are refused. The download is size-capped.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      }
    }
  ],
