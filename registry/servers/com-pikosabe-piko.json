{
  "$schema": "../schema.json",
  "name": "com.pikosabe/piko",
  "title": "Piko",
  "category": "Vector DBs & AI Search",
  "description": "Search real offers and providers on Piko, mostly in Paraguay today, and draft a listing.",
  "tools": [
    {
      "name": "search",
      "description": "Searches the Piko marketplace in one country, by meaning and by exact words. Returns at most 5 providers or 10 listings from real accounts, ordered by relevance, each with its pikosabe.com link. Listings that are job openings or job seekers' offers carry a job field with the working arrangement and the pay when stated. A count of 0 means no listing matches these terms; when the whole market has no listing yet, the result carries a market field that says so and names the markets that have listings. Results carry no phone number: contact happens on the pikosabe.com page of the listing or profile.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "providers",
              "listings"
            ],
            "description": "providers: people who offer a service, grouped by profile. listings: individual published offers or demands of any type."
          },
          "query": {
            "type": "string",
            "description": "What is searched: a short phrase such as \"plomero\", \"auto usado\" or \"Toyota Hilux\". Listings are written in the language of their market, so a phrase in that language matches best."
          },
          "side": {
            "description": "Listings mode only. offer: things and services people offer. demand: things and services people are looking for. Omitted: both.",
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "offer",
                  "demand"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "types": {
            "description": "Listings mode only. Limits the search to these listing types.",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "service",
                    "good",
                    "rental",
                    "property",
                    "vehicle",
                    "pet"
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "city": {
            "description": "Limits the search to this city, for example \"Asunción\".",
            "type": "string"
          },
          "neighborhood": {
            "description": "Limits the search to this neighborhood of the city.",
            "type": "string"
          },
          "job_openings": {
            "description": "true: only job openings, the positions an employer wants to fill (a nanny, a shop assistant). They are demand listings of type service; mode, side and types are set accordingly.",
            "type": "boolean"
          },
          "job_seekers": {
            "description": "true: only job seekers, the providers who marked a service offer as available for a job, with the arrangement and the pay they expect when stated. They are offer listings of type service; mode, side and types are set accordingly. Not combined with job_openings.",
            "type": "boolean"
          },
          "country": {
            "type": "string",
