{
  "$schema": "../schema.json",
  "name": "com.getboxaudit/boxaudit",
  "title": "BoxAudit — USPS Cubic & DIM-139 Shipping Box Optimizer",
  "category": "E-Commerce & Retail",
  "description": "USPS Notice 123 Commercial Cubic, outer-wall tier-bump & UPS/FedEx DIM-139 box leak calculator.",
  "tools": [
    {
      "name": "quote_usps_cubic_box",
      "description": "Calculate official Oct 4, 2026 USPS Notice 123 Commercial Cubic vs Weight-based rate for a single corrugated box.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "lengthIn": {
            "type": "number",
            "description": "Inner length in inches (1-48)"
          },
          "widthIn": {
            "type": "number",
            "description": "Inner width in inches (1-48)"
          },
          "heightIn": {
            "type": "number",
            "description": "Inner height in inches (1-48)"
          },
          "weightOz": {
            "type": "number",
            "description": "Gross package weight in ounces (1-1120)"
          },
          "zone": {
            "type": "integer",
            "description": "USPS Zone (1-8)"
          }
        },
        "required": [
          "lengthIn",
          "widthIn",
          "heightIn",
          "weightOz",
          "zone"
        ]
      }
    },
    {
      "name": "compare_box_leak",
      "description": "Detect USPS Cubic outer-wall tier bumps (+0.25 in corrugated walls), compare against smaller standard boxes, and project 90-day shipping savings with UPS/FedEx DIM-139 billable weight.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "currentLengthIn": {
            "type": "number",
            "description": "Current box inner length in inches (1-48)"
          },
          "currentWidthIn": {
            "type": "number",
            "description": "Current box inner width in inches (1-48)"
          },
          "currentHeightIn": {
            "type": "number",
            "description": "Current box inner height in inches (1-48)"
          },
          "weightOz": {
            "type": "number",
            "description": "Gross parcel weight in ounces (1-1120)"
          },
          "zone": {
            "type": "integer",
            "description": "USPS Zone 1-8 (default 5)"
          },
          "monthlyOrders": {
            "type": "integer",
            "description": "Monthly orders using this box (default 200)"
          },
          "itemLengthIn": {
            "type": "number",
            "description": "Optional product length in inches"
          },
          "itemWidthIn": {
            "type": "number",
            "description": "Optional product width in inches"
          },
          "itemHeightIn": {
            "type": "number",
            "description": "Optional product height in inches"
          },
          "fragilePaddingIn": {
            "type": "number",
            "description": "Optional per-side fragile padding in inches (default 0.5)"
          }
        },
        "required": [
          "currentLengthIn",
          "currentWidthIn",
          "currentHeightIn",
          "weightOz"
        ]
      }
    }
  ],
