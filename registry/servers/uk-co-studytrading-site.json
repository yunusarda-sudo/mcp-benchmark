{
  "$schema": "../schema.json",
  "name": "uk.co.studytrading/site",
  "category": "Finance, Crypto & Web3",
  "description": "Study Trading: the site's own MCP server — shop; every answer cites the site.",
  "tools": [
    {
      "name": "store",
      "description": "What Study Trading sells, its currency, where it ships, how a purchase completes, and the catalogue's size. Call this first.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "categories",
      "description": "The categories Study Trading organises its products into (path, name, page URL, product count). Use a path or a name as the category of browse.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "browse",
      "description": "A page of Study Trading's products, optionally within a category (path or name), in stock only, sorted. Up to 50 per page.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "a category path (e.g. coffee/espresso-machines) or name"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "in_stock_only": {
            "type": "boolean"
          },
          "sort": {
            "type": "string",
            "enum": [
              "relevance",
              "price_asc",
              "price_desc",
              "title"
            ],
            "description": "order of the results"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "search",
      "description": "Products of Study Trading whose title, description, brand, category or attributes contain the words of the query (all words, any order, case-insensitive).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "sort": {
            "type": "string",
            "enum": [
              "relevance",
              "price_asc",
              "price_desc",
              "title"
            ],
            "description": "order of the results"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "filter",
      "description": "Products of Study Trading matching attribute values (key: value, exact, case-insensitive — the keys are the store's own specification attributes, see any product's attributes) and/or a price range in Study Trading's currency, e.g. price_min 200, price_max 1500. Combine with a category, brand and in-stock.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "description": "e.g. {\"material\": \"teak\", \"groups\": 2}"
          },
          "price_min": {
            "type": "number",
            "minimum": 0,
            "description": "in major units of the store's currency"
          },
          "price_max": {
            "type": "number",
            "minimum": 0
          },
          "category": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "in_stock_only": {
            "type": "boolean"
          },
          "fulfilment": {
            "type": "string",
            "enum": [
              "own",
              "affiliate"
            ]
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "sort": {
            "type": "string",
            "enum": [
              "relevance",
              "price_asc",
              "price_desc",
              "title"
            ],
            "description": "order of the results"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "product",
      "description": "Everything Study Trading publishes about one product — by id, product URL or GTIN: description, price, stock, identifiers, attributes, images, and where it is bought.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product": {
            "type": "string",
            "minLength": 1,
            "description": "product id, product page URL, or GTIN"
          }
        },
        "required": [
          "product"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "cart",
      "description": "A cart kept for this MCP session (never the store's own cart). add / remove / set a quantity / view / clear; the total is live from the feed. Then checkout_link tells the buyer where to complete the purchase.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "add",
              "remove",
              "set",
              "view",
              "clear"
            ]
          },
          "product": {
            "type": "string",
            "description": "product id or URL (add/remove/set)"
          },
          "qty": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99,
            "description": "quantity to add (add, default 1) or to set (set)"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "name": "checkout_link",
      "description": "For this session's cart (or one product), the link(s) where a PERSON completes the purchase: the product page and the store's cart for own products (Study Trading's own checkout), the retailer's buy link for affiliate products. This server never places an order or takes a payment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "product": {
            "type": "string",
            "description": "one product instead of the cart"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "uk.co.studytrading/site",
    "version": "1.0.1",
    "remoteUrl": "https://studytrading.co.uk/mcp",
    "publishedAt": "2026-11-23T22:26:41.764273Z",
    "fetchedAt": "2026-11-24T12:15:48.059Z",
    "toolsSha256": "c868cac569f1fb744b61fc2bbe1eff25a357fb50baee5cca12e2aaa23109483e"
  }
}
