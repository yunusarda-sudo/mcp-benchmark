{
 "$schema": "../schema.json",
 "name": "com.ansvra/mcp",
 "title": "Ansvra",
 "category": "Design, UI & 3D Media",
 "description": "Read saved AI visibility, competitor and citation reports. Requires a paid Ansvra account.",
 "repository": "https://github.com/tobhol-lab/ansvra-mcp",
 "tools": [
  {
   "name": "list_projects",
   "description": "List the issuing Ansvra account and eligible projects for this connection. Show the options when the user asks to pick a project and pass the selected ID to other tools. Use the returned nextCursor to continue with the same limit.",
   "inputSchema": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
     "limit": {
      "default": 20,
      "type": "integer",
      "minimum": 1,
      "maximum": 50
     },
     "cursor": {
      "type": "string",
      "maxLength": 2048
     }
    },
    "additionalProperties": false
   }
  },
  {
   "name": "get_project",
   "description": "Identify the selected Ansvra project, including its name, website, market, and language. An All account projects key requires a project ID.",
   "inputSchema": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
     "projectId": {
      "description": "Project ID from list_projects. Required with an All account projects key.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
     }
    },
    "additionalProperties": false
   }
  },
  {
   "name": "list_tracked_prompts",
   "description": "Find tracked prompts and their IDs. Pass the returned nextCursor to continue with the same filters.",
   "inputSchema": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
     "projectId": {
      "description": "Project ID from list_projects. Required with an All account projects key.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
     },
     "limit": {
      "default": 20,
      "type": "integer",
      "minimum": 1,
      "maximum": 50
     },
     "cursor": {
      "type": "string",
      "maxLength": 2048
     },
     "active": {
      "type": "boolean"
     },
     "branded": {
      "type": "boolean"
     },
     "archived": {
      "default": false,
      "type": "boolean"
     },
     "market": {
      "type": "string",
      "maxLength": 30
     },
     "language": {
      "type": "string",
      "maxLength": 30
     }
    },
    "additionalProperties": false
   }
  },
  {
   "name": "get_prompt_results",
   "description": "Read saved results for a tracked prompt. Use list_tracked_prompts to find the prompt ID. Use the responses view to find an observation ID, then pass that ID to read the full answer.",
   "inputSchema": {
    "type": "object",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
     "projectId": {
      "description": "Project ID from list_projects. Required with an All account projects key.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
     },
     "from": {
      "description": "Calendar date in YYYY-MM-DD. Provide both dates or omit both.",
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
     },
     "to": {
      "description": "Calendar date in YYYY-MM-DD. Provide both dates or omit both.",
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
     },
     "promptId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
     },
     "platforms": {
      "maxItems": 8,
      "type": "array",
      "items": {
       "type": "string",
       "enum": [
        "openai",
        "claude",
        "perplexity",
        "google_overview",
        "google_mode",
        "gemini",
        "copilot",
        "bing_mode"
       ]
      }
     },
     "tab": {
      "default": "overview",
      "type": "string",
      "enum": [
       "overview",
       "responses",
       "citations",
       "fanout"
      ]
     },
     "observationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
     },
     "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
     }
    },
    "required": [
     "promptId"
    ],
    "additionalProperties": false
   }
  },
