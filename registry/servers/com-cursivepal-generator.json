{
  "$schema": "../schema.json",
  "name": "com.cursivepal/generator",
  "title": "CursivePal – Cursive Generator – Free Script Fonts (PNG & SVG)",
  "category": "Design, UI & 3D Media",
  "description": "Create cursive PNG and outlined SVG lettering, list 18 fonts, and convert text into Unicode styles.",
  "tools": [
    {
      "name": "list_styles",
      "description": "Find lettering font IDs and licenses for PNG/SVG, or style IDs for copyable Unicode.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "kind": {
            "default": "fonts",
            "type": "string",
            "enum": [
              "fonts",
              "unicode"
            ]
          }
        }
      }
    },
    {
      "name": "convert_text",
      "description": "Turn English letters into copyable decorative Unicode. Preserve accents, digits and emoji.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "style": {
            "default": "u-bold-script",
            "type": "string",
            "enum": [
              "u-bold-script",
              "u-script",
              "u-bold-italic",
              "u-italic",
              "u-sans-bold-italic",
              "u-sans-italic",
              "u-swirl",
              "u-bold-fraktur",
              "u-fraktur",
              "u-double"
            ]
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "render_lettering",
      "description": "Generate actual transparent PNG lettering or an SVG with outlined glyphs. Preserve manual line breaks. Select a font that covers the input.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "font": {
            "default": "great-vibes",
            "type": "string",
            "enum": [
              "great-vibes",
              "allura",
              "dancing-script",
              "sacramento",
              "parisienne",
              "satisfy",
              "pinyon-script",
              "alex-brush",
              "herr-von",
              "tangerine",
              "caveat",
              "marck-script",
              "kalam",
              "pacifico",
              "playball",
              "yellowtail",
              "playwrite-us-trad",
              "homemade-apple"
            ]
          },
          "format": {
            "default": "png",
            "type": "string",
            "enum": [
              "png",
              "svg"
            ]
          },
          "color": {
            "default": "#141417",
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "align": {
            "default": "center",
            "type": "string",
            "enum": [
              "left",
              "center"
            ]
          }
        },
        "required": [
          "text"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.cursivepal/generator",
    "version": "1.0.0",
    "remoteUrl": "https://cursivepal.com/mcp",
    "publishedAt": "2026-11-27T16:52:46.152799Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "4d0ebaa6bffe057f3b23236c0c74cb371b43619b75db85b3386984dc1a95aeb3"
  }
}
