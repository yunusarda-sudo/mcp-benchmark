{
  "$schema": "../schema.json",
  "name": "Exa Neural Search MCP",
  "category": "Developer Tools & VCS",
  "description": "Exa Neural Search MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "search_exa",
      "description": "Search the web using Exa embeddings-based semantic neural link retrieval.",
      "inputSchema": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "description": "Semantic search text."
          },
          "useAutoprompt": {
            "type": "boolean",
            "description": "Enhance query with neural autoprompt."
          }
        }
      }
    }
  ]
}
