{
  "$schema": "../schema.json",
  "name": "de.berliner-kurierdienst/courier",
  "title": "Berliner Kurierdienst",
  "category": "E-Commerce & Retail",
  "description": "Berlin B2B courier and direct runs: tariff prices from the website calculator and inquiries.",
  "tools": [
    {
      "name": "get_service_profile",
      "description": "Returns what Berliner Kurierdienst (Logisticoo GmbH) offers: services, what is not offered, whether prices are available, how to submit an inquiry, contact and legal links. Call this first.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "de",
              "en"
            ]
          }
        }
      }
    },
    {
      "name": "estimate_transport_price",
      "description": "Non-binding tariff price (EUR net and gross) for a dedicated courier run by Berliner Kurierdienst, computed by the same calculator as on https://berliner-kurierdienst.de. Domestic runs within Germany by postal code; abroad and the 40 t truck return manual_quote_required. No booking is made. Returns status: estimated | needs_information | manual_quote_required | unsupported.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "de",
              "en"
            ]
          },
          "origin": {
            "type": "object",
            "properties": {
              "country": {
                "description": "DE (default), PL, CZ, AT, DK, NL — abroad is quoted on request",
                "type": "string",
                "enum": [
                  "DE",
                  "PL",
                  "CZ",
                  "AT",
                  "DK",
                  "NL"
                ]
              },
              "postal_code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10,
                "description": "Postal code, e.g. 10829"
              }
            },
            "required": [
              "postal_code"
            ]
          },
          "destination": {
            "type": "object",
            "properties": {
              "country": {
                "description": "DE (default), PL, CZ, AT, DK, NL — abroad is quoted on request",
                "type": "string",
                "enum": [
                  "DE",
                  "PL",
                  "CZ",
                  "AT",
                  "DK",
                  "NL"
                ]
              },
              "postal_code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10,
                "description": "Postal code, e.g. 10829"
              }
            },
            "required": [
              "postal_code"
            ]
          },
          "vehicle": {
            "type": "string",
            "enum": [
              "pkw",
              "kombi",
              "transporter",
              "planensprinter",
              "lkw75",
              "lkw12",
              "sattel"
            ],
            "description": "pkw (car, up to 100 kg), kombi (small van, up to 400 kg), transporter (van, 3.2 × 1.7 × 1.7 m, up to 1,000 kg), planensprinter (3.5 t truck, 4.2 × 2.1 × 2.0 m, up to 1,000 kg, side loading), lkw75 (7.5 t truck, 6.2 × 2.4 × 2.3 m, up to 2,500 kg), lkw12 (12 t truck, 7.2 × 2.45 × 2.3 m, up to 5,000 kg), sattel (40 t truck, 13.6 × 2.45 × 2.6 m, up to 24,000 kg: on request)"
          },
          "date": {
            "description": "Pickup date YYYY-MM-DD (Europe/Berlin), today up to +90 days; default today",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "time": {
            "description": "Pickup time HH:MM",
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "stops": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "waiting_minutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 240
          },
          "extras": {
            "description": "zeitfenster30 (30-min time window), zustellnachweis (proof of delivery), ladehilfe (loading help)",
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "zeitfenster30",
                "zustellnachweis",
                "ladehilfe"
              ]
            }
          }
        },
        "required": [
          "origin",
          "destination",
          "vehicle"
        ]
      }
    },
    {
      "name": "preview_inquiry",
      "description": "Step 1 of 2 for a real transport inquiry to the operator's sales team (they reply by e-mail with a quote). Validates the data and returns exactly what will be sent, a privacy notice and a preview_token (15 min). Nothing is sent yet. Show the summary AND privacy_notice to the user and get explicit confirmation before calling submit_inquiry. Only use contact details the user provided for this purpose.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "de",
              "en"
            ]
          },
          "origin": {
            "type": "object",
            "properties": {
              "country": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2,
                "description": "ISO 3166-1 alpha-2, e.g. DE, PL, FR"
              },
              "city": {
                "description": "City name (German or English), e.g. Berlin, Warsaw",
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "postal_code": {
                "description": "5-digit postal code for DE (used for the estimate); other countries: passed on to the team",
                "type": "string",
                "minLength": 1,
                "maxLength": 10
              }
            },
            "required": [
              "country"
            ]
          },
          "destination": {
            "type": "object",
            "properties": {
              "country": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2,
                "description": "ISO 3166-1 alpha-2, e.g. DE, PL, FR"
              },
              "city": {
                "description": "City name (German or English), e.g. Berlin, Warsaw",
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "postal_code": {
                "description": "5-digit postal code for DE (used for the estimate); other countries: passed on to the team",
                "type": "string",
                "minLength": 1,
                "maxLength": 10
              }
            },
            "required": [
              "country"
            ]
          },
          "vehicle": {
            "description": "Requested vehicle, free text (optional)",
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "weight_kg": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100000
          },
          "pallets": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 200
          },
          "loading_meters": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          },
          "dimensions_cm": {
            "description": "Largest single piece",
            "type": "object",
            "properties": {
              "length_cm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10000
              },
              "width_cm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000
              },
              "height_cm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000
              }
            }
          },
          "dangerous_goods": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "temperature_controlled": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "oversize": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          },
          "pickup_date": {
            "description": "YYYY-MM-DD",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "delivery_by": {
            "description": "Latest delivery date YYYY-MM-DD",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "cargo_description": {
            "description": "What is shipped (goods, packaging), max 500 chars",
            "type": "string",
            "maxLength": 500
          },
          "message": {
            "description": "Additional notes for the sales team, max 1000 chars",
            "type": "string",
            "maxLength": 1000
          },
          "contact": {
            "type": "object",
            "properties": {
              "company": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "email": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "phone": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "company",
              "name",
              "email"
            ],
            "description": "The requesting person's business contact — required"
          }
        },
        "required": [
          "origin",
          "destination",
          "contact"
        ]
      }
    },
    {
      "name": "submit_inquiry",
      "description": "Step 2 of 2: sends the previewed inquiry to the operator's sales team. Only call after the user explicitly confirmed the summary and privacy notice. Use a new random idempotency_key per inquiry and reuse it when retrying the same inquiry. Status accepted means we received it; it is NOT a booking and NOT a binding price — a person replies by e-mail.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "preview_token": {
            "type": "string",
            "minLength": 10,
            "maxLength": 20000
          },
          "idempotency_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,100}$",
            "description": "Random key, e.g. a UUID; same key for retries"
          },
          "user_confirmed": {
            "type": "boolean",
            "const": true,
            "description": "true = the user explicitly confirmed summary and privacy notice"
          },
          "language": {
            "type": "string",
            "enum": [
              "de",
              "en"
            ]
          }
        },
        "required": [
          "preview_token",
          "idempotency_key",
          "user_confirmed"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
