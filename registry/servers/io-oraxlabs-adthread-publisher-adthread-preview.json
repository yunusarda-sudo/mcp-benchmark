  "$schema": "../schema.json",
  "name": "io.oraxlabs.adthread.publisher/adthread-preview",
  "title": "AdThread Sponsored Card Preview",
  "category": "Other",
  "description": "Preview labeled sponsored-card fixtures for AI app results. Read-only sandbox.",
  "tools": [
    {
      "name": "preview_sponsored_card",
      "description": "Preview a sample Sponsored card for a result placement. Send only a context category and placement type. Uses fixed sample content and never issues a tracked ad.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "context": {
            "type": "string",
            "enum": [
              "travel",
              "shopping",
              "learning",
              "none"
            ]
          },
          "placement": {
            "type": "string",
            "enum": [
              "answer",
              "video",
              "image",
              "other"
            ]
          }
        },
        "required": [
          "context",
          "placement"
        ],
        "additionalProperties": false
      }
    }
  ],
