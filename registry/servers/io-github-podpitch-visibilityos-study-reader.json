{
  "$schema": "../schema.json",
  "name": "io.github.PodPitch/visibilityos-study-reader",
  "title": "VisibilityOS Study Reader",
  "category": "Developer Tools & DevOps",
  "description": "Read and compare the published AI answer study from VisibilityOS by PodPitch.",
  "repository": "https://github.com/PodPitch/visibilityos-audit-template",
  "tools": [
    {
      "name": "read_study_summary",
      "description": "Return the study's published totals, presence gains and losses, official-link changes, and per-view counts. Use for aggregate questions about this specific study and its methodology.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "read_engine_view",
      "description": "Return the published comparison count, brand-presence change count and rate for one exact engine view. Engine-specific official-link counts are unavailable in the public dataset.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "engine_view": {
            "type": "string",
            "enum": [
              "ChatGPT",
              "ChatGPT web",
              "Claude",
              "Gemini",
              "Gemini web",
              "Google AI Mode",
              "Grok",
              "Perplexity"
            ]
          }
        },
        "required": [
          "engine_view"
        ]
      }
    },
    {
      "name": "compare_engine_views",
      "description": "Compare the published brand-presence change rates of two engine views in the VisibilityOS study. Return both denominators and the first rate minus the second in percentage points.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "first_view": {
            "type": "string",
            "enum": [
              "ChatGPT",
              "ChatGPT web",
              "Claude",
              "Gemini",
              "Gemini web",
              "Google AI Mode",
              "Grok",
              "Perplexity"
            ]
          },
          "second_view": {
            "type": "string",
            "enum": [
              "ChatGPT",
              "ChatGPT web",
              "Claude",
              "Gemini",
              "Gemini web",
              "Google AI Mode",
              "Grok",
              "Perplexity"
            ]
          }
        },
        "required": [
          "first_view",
          "second_view"
        ]
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.PodPitch/visibilityos-study-reader",
    "version": "1.0.0",
    "remoteUrl": "https://visibilityos-study-reader.vercel.app/api/mcp",
    "publishedAt": "2026-11-20T12:50:18.502144Z",
    "fetchedAt": "2026-11-25T11:03:46.215Z",
    "toolsSha256": "dd3e5a84c200d8ea67eaab31c53f6ccfcf7b7365294a9355e35a2e5edd4d4913"
  }
}
