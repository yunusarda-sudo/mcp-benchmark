{
  "$schema": "../schema.json",
  "name": "io.github.Selfware/flexeo",
  "title": "Flexeo",
  "category": "Developer Tools & DevOps",
  "description": "Public read-only facts and budget guidance for Flexeo SEO/GEO, from US$30 a month.",
  "repository": "https://github.com/Selfware/flexeo",
  "tools": [
    {
      "name": "estimate_budget",
      "description": "Orientation for a monthly Flexeo budget: minimum US$30, not a forecast.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "business_size": {
            "type": "string",
            "enum": [
              "solo",
              "small",
              "medium",
              "large"
            ]
          },
          "goal": {
            "type": "string",
            "enum": [
              "local_visibility",
              "more_leads",
              "ai_answers",
              "online_sales",
              "other"
            ]
          },
          "niche": {
            "type": "string",
            "maxLength": 100
          },
          "region": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "business_size",
          "goal"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "explain_service",
      "description": "Explain how Flexeo works, what is included, or what the client connects.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "workflow",
              "included",
              "connections"
            ]
          }
        },
        "required": [
          "topic"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_assessment_link",
      "description": "Link to start the Flexeo brief and site assessment.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "list_resources",
      "description": "Public Flexeo pages (from llms.txt) in English or Spanish.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "en",
              "es"
            ]
          }
        },
        "required": [
          "language"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
