    {
      "name": "read_plan",
      "description": "Use when the user shares a Room Planner link, to read and modify that plan. Takes a link to the Room Planner web app (https://room-planner.andrechek.com; link formats #s=, #j=, #p= and the older ?config= are documented at https://room-planner.andrechek.com/agents/#plan-links) and decodes the plan from the link itself; it fetches nothing. Returns {plan, summary, issues, url, editable}, the plan in the unit it is shown in, ready to edit and send to create_plan for a new link. A link cut off when copied returns an error, since the whole link is needed. Clients with MCP Apps show the drawing in the chat.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "The whole link, as the user gave it."
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    }
