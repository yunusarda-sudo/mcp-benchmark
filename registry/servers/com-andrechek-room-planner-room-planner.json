                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "shape": {
                      "default": "rect",
                      "description": "\"ellipse\": round or oval; \"l\" needs cut.",
                      "type": "string",
                      "enum": [
                        "rect",
                        "l",
                        "ellipse"
                      ]
                    },
                    "width": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 10000,
                      "description": "Along x, before rotation."
                    },
                    "depth": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 10000,
                      "description": "Along y, before rotation."
                    },
                    "cut": {
                      "description": "Shape \"l\" only: the rectangle removed from one corner.",
                      "type": "object",
                      "properties": {
                        "corner": {
                          "type": "string",
                          "enum": [
                            "tl",
                            "tr",
                            "br",
                            "bl"
                          ],
                          "description": "Corner removed."
                        },
                        "width": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 10000,
                          "description": "Removed part, along x."
                        },
                        "depth": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 10000,
                          "description": "Removed part, along y."
                        }
                      },
                      "required": [
                        "corner",
                        "width",
                        "depth"
                      ]
                    },
                    "placement": {
                      "description": "Omit to set the piece aside: off the floor, not checked.",
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": -100000,
                          "maximum": 100000,
                          "description": "Floor x of the CENTRE."
                        },
                        "y": {
                          "type": "number",
                          "minimum": -100000,
                          "maximum": 100000,
                          "description": "Floor y of the CENTRE."
                        },
                        "rotation": {
                          "default": 0,
                          "description": "Clockwise degrees.",
                          "type": "number",
                          "minimum": 0,
                          "exclusiveMaximum": 360
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ]
                    },
                    "locked": {
                      "description": "Not movable in the planner.",
                      "type": "boolean"
                    },
                    "hidden": {
                      "description": "Not drawn or checked.",
                      "type": "boolean"
                    },
                    "notes": {
                      "description": "The user's notes.",
                      "type": "string",
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "width",
                    "depth"
                  ],
                  "additionalProperties": {}
                }
              },
              "settings": {
                "description": "Display preferences.",
                "type": "object",
                "properties": {
                  "unitSystem": {
                    "description": "Display unit. Default: unit (\"ft\" as \"ft-in\").",
                    "type": "string",
                    "enum": [
                      "ft-in",
