{
  "$schema": "../schema.json",
  "name": "Linear MCP",
  "category": "Productivity & Notes",
  "description": "Linear MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "create_issue",
      "description": "Create a new engineering issue ticket in Linear workspace with priority and team.",
      "inputSchema": {
        "type": "object",
        "required": [
          "teamId",
          "title"
        ],
        "properties": {
          "teamId": {
            "type": "string",
            "description": "Linear team identifier."
          },
          "title": {
            "type": "string",
            "description": "Issue title."
          },
          "priority": {
            "type": "integer",
            "description": "Priority level (0=none, 1=urgent, 4=low)."
          }
        }
      }
    }
  ]
}
