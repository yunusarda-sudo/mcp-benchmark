{
  "$schema": "../schema.json",
  "name": "Filesystem MCP",
  "category": "Developer Tools & VCS",
  "description": "Filesystem MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "read_file",
      "description": "Read the complete UTF-8 contents of a file from the local filesystem.",
      "inputSchema": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute path to the file to read."
          }
        }
      }
    },
    {
      "name": "write_file",
      "description": "Create a new file or overwrite an existing file with provided string content.",
      "inputSchema": {
        "type": "object",
        "required": [
          "path",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute path of destination file."
          },
          "content": {
            "type": "string",
            "description": "String content to write."
          }
        }
      }
    },
    {
      "name": "list_directory",
      "description": "List contents of a directory, returning filenames and file types.",
      "inputSchema": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Directory path to inspect."
          }
        }
      }
    }
  ]
}
