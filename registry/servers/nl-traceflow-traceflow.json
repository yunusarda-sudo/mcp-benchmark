{
  "$schema": "../schema.json",
  "name": "nl.traceflow/traceflow",
  "title": "Traceflow - Zero-UI Telemetry, Webhook & Chaos Blackbox",
  "category": "AI, LLMs & Agents",
  "description": "Zero-signup OTLP, webhook HMAC, HTTP/SSE chaos, and causal /diff blackbox for coding agents.",
  "repository": "https://github.com/MichelGP/traceflow",
  "tools": [
    {
      "name": "traceflow_create_cell",
      "description": "Mint a 30m in-memory OTLP, webhook, CSP, and chaos cell. Returns OTEL_EXPORTER_OTLP_ENDPOINT, hook_url, cell_id, and read_token.",
      "inputSchema": {
        "properties": {
          "hmac_secret": {
            "description": "Optional webhook HMAC secret for raw-byte signature verification",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "traceflow_wait",
      "description": "Block up to 25s without polling until expected traces or webhooks hit the cell, returning a token-budgeted causal digest.",
      "inputSchema": {
        "properties": {
          "after_seq": {
            "type": "integer"
          },
          "cell_id": {
            "type": "string"
          },
          "expect_count": {
            "type": "integer"
          },
          "max_tokens": {
            "type": "integer"
          },
          "read_token": {
            "type": "string"
          },
          "timeout_sec": {
            "type": "integer"
          }
        },
        "required": [
          "cell_id",
          "read_token"
        ],
        "type": "object"
      }
    },
    {
      "name": "traceflow_digest",
      "description": "Summarize traces, webhooks, chaos retries, and detected anti-patterns (N+1, floating async, lock herds, leaks) within max_tokens.",
      "inputSchema": {
        "properties": {
          "after_seq": {
            "type": "integer"
          },
          "cell_id": {
            "type": "string"
          },
          "max_tokens": {
            "type": "integer"
          },
          "read_token": {
            "type": "string"
          }
        },
        "required": [
          "cell_id",
          "read_token"
        ],
        "type": "object"
      }
    },
    {
      "name": "traceflow_inspect_trace",
      "description": "Show compact span waterfall and error logs for trace_id (or latest failing trace if omitted).",
      "inputSchema": {
        "properties": {
          "cell_id": {
            "type": "string"
          },
          "max_tokens": {
            "type": "integer"
          },
          "read_token": {
            "type": "string"
          },
          "trace_id": {
            "type": "string"
          }
        },
        "required": [
          "cell_id",
          "read_token"
        ],
        "type": "object"
      }
    },
    {
      "name": "traceflow_mark",
      "description": "Save a sequence checkpoint (e.g. 'before') prior to applying a code fix.",
      "inputSchema": {
        "properties": {
          "cell_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "read_token": {
            "type": "string"
          }
        },
        "required": [
          "cell_id",
          "read_token"
        ],
        "type": "object"
      }
    },
    {
      "name": "traceflow_diff",
      "description": "Compare telemetry before vs after a checkpoint and generate a GitHub PR Proof Receipt.",
      "inputSchema": {
        "properties": {
          "cell_id": {
            "type": "string"
          },
          "from_mark": {
            "type": "string"
          },
          "read_token": {
            "type": "string"
          },
          "to_mark": {
            "type": "string"
          }
        },
        "required": [
          "cell_id",
          "read_token"
        ],
        "type": "object"
      }
    },
    {
      "name": "traceflow_audit_ai",
      "description": "Audit MCP tools/list JSON token bloat OR hash prompt chunks across turns to pinpoint KV prompt-cache prefix invalidation.",
      "inputSchema": {
        "properties": {
          "cell_id": {
            "type": "string"
          },
          "chunk_chars": {
            "type": "integer"
          },
          "mcp_tools_json": {
            "type": "string"
          },
          "prompt_text": {
            "type": "string"
          },
          "read_token": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    {
      "name": "traceflow_wishlist",
      "description": "List, propose, or upvote missing agent debugging tools (action=list|propose|vote). Pass cell_id + read_token from an active cell to cast a verified session vote.",
      "inputSchema": {
        "properties": {
          "action": {
            "description": "list, propose, or vote",
            "type": "string"
          },
          "blind_spot": {
            "description": "Concise description of the blind spot encountered (maintainer-only)",
            "type": "string"
          },
          "category": {
            "description": "ingest, chaos, protocol, security, perf, genai, or diff",
            "type": "string"
          },
          "cell_id": {
            "type": "string"
          },
          "proposed_io": {
            "description": "Desired input/output contract (maintainer-only)",
            "type": "string"
          },
          "read_token": {
            "type": "string"
          },
          "slug": {
            "description": "snake_case identifier (^[a-z0-9_]{3,40}$), e.g. websocket_frame_chaos",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "nl.traceflow/traceflow",
    "version": "1.0.0",
    "remoteUrl": "https://traceflow.nl/mcp",
    "publishedAt": "2026-11-28T09:04:10.102738Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
    "toolsSha256": "3f0fa0419a85a35026d0f9e3f1ab5e4d9c08aef063776b4ef419991fbc5c6871"
  }
}
