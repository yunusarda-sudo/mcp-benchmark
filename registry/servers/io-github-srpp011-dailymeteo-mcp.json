{
  "$schema": "../schema.json",
  "name": "io.github.srpp011/dailymeteo-mcp",
  "title": "DailyMeteo",
  "category": "Developer Tools & DevOps",
  "description": "Historical weather and climate normals for any land location, 1 km grids, 1961 to today",
  "repository": "https://github.com/srpp011/dailymeteo-mcp",
  "tools": [
    {
      "name": "find_location",
      "description": "Latitude and longitude of a place (OpenStreetMap Nominatim). If several match, ask the user which one.",
      "inputSchema": {
        "properties": {
          "query": {
            "description": "Place name, e.g. 'Kopaonik' or 'Lisbon, Portugal'",
            "title": "Query",
            "type": "string"
          },
          "limit": {
            "default": 3,
            "maximum": 5,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "type": "object",
        "title": "find_locationArguments"
      }
    },
    {
      "name": "find_area",
      "description": "Boundary polygon (WKT) and size of a named area, for estimate_area_download / request_area_download.",
      "inputSchema": {
        "properties": {
          "query": {
            "description": "Area name, e.g. 'Opština Brus' or 'Lake Bled'",
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object",
        "title": "find_areaArguments"
      }
    },
    {
      "name": "get_weather",
      "description": "Daily, monthly or annual values for one location and one or more variables, 1961 to the present.\n\n    Monthly and annual values are free. Daily values cost 1 credit per day and variable and need the\n    user's DailyMeteo API key or account (see the server instructions). Results include a summary per\n    variable; series longer than 400 rows are not listed but summarised by year and saved as CSV.\n    ",
      "inputSchema": {
        "properties": {
          "lat": {
            "description": "Latitude in decimal degrees (WGS84)",
            "maximum": 90,
            "minimum": -90,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "description": "Longitude in decimal degrees (WGS84)",
            "maximum": 180,
            "minimum": -180,
            "title": "Lon",
            "type": "number"
          },
          "variables": {
            "default": [
              "tmean"
            ],
            "description": "One or more of tmean, tmax, tmin (°C), prcp (mm)",
            "items": {
              "enum": [
                "tmean",
                "tmax",
                "tmin",
                "prcp"
              ],
              "type": "string"
            },
            "minItems": 1,
            "title": "Variables",
            "type": "array"
          },
          "time_scale": {
            "default": "mon",
            "description": "day, mon (monthly) or ann (annual)",
            "enum": [
              "day",
              "mon",
              "ann"
            ],
            "title": "Time Scale",
            "type": "string"
          },
          "start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "First date: YYYY-MM-DD (day), YYYY-MM (mon) or YYYY (ann); from 1961",
            "title": "Start"
          },
          "end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Last date, same format",
            "title": "End"
          },
          "dates": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Individual dates instead of a range, same format",
            "title": "Dates"
          },
          "confirm_credits": {
            "default": false,
            "description": "Set true only after the user agreed to a day request over 1000 credits",
            "title": "Confirm Credits",
            "type": "boolean"
          },
          "save_csv": {
            "default": false,
            "description": "Save the table as CSV (long series are always saved)",
            "title": "Save Csv",
            "type": "boolean"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "type": "object",
        "title": "get_weatherArguments"
      }
    },
    {
      "name": "get_climate_normals",
      "description": "Climate normals for 1961-1990 and 1991-2020 and the change (newer minus older). Free.\n\n    Without `month`, time_scale=mon returns all 12 months. Annual precipitation normals are yearly totals.\n    ",
      "inputSchema": {
        "properties": {
          "lat": {
            "description": "Latitude in decimal degrees (WGS84)",
            "maximum": 90,
            "minimum": -90,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "description": "Longitude in decimal degrees (WGS84)",
            "maximum": 180,
            "minimum": -180,
            "title": "Lon",
            "type": "number"
          },
          "variables": {
            "default": [
              "tmean"
            ],
            "description": "One or more of tmean, tmax, tmin (°C), prcp (mm)",
            "items": {
              "enum": [
                "tmean",
                "tmax",
                "tmin",
                "prcp"
              ],
              "type": "string"
            },
            "minItems": 1,
            "title": "Variables",
            "type": "array"
          },
          "time_scale": {
            "default": "mon",
            "description": "ann (year), mon (by month) or day (one calendar day)",
            "enum": [
              "ann",
              "mon",
              "day"
            ],
            "title": "Time Scale",
            "type": "string"
          },
          "month": {
            "anyOf": [
              {
                "maximum": 12,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only this month (mon), or the month of the day (day)",
            "title": "Month"
          },
          "day": {
            "anyOf": [
              {
                "maximum": 31,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Day of month, required for time_scale=day",
            "title": "Day"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "type": "object",
        "title": "get_climate_normalsArguments"
      }
    },
    {
      "name": "app_link",
      "description": "Link that opens the location, variable and period on the DailyMeteo map with its chart and CSV export.",
      "inputSchema": {
        "properties": {
          "lat": {
            "description": "Latitude in decimal degrees (WGS84)",
            "maximum": 90,
            "minimum": -90,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "description": "Longitude in decimal degrees (WGS84)",
            "maximum": 180,
            "minimum": -180,
            "title": "Lon",
            "type": "number"
          },
          "variable": {
            "default": "tmean",
            "enum": [
              "tmean",
              "tmax",
              "tmin",
              "prcp"
            ],
            "title": "Variable",
            "type": "string"
          },
          "time_scale": {
            "default": "ann",
            "enum": [
              "day",
              "mon",
              "ann"
            ],
            "title": "Time Scale",
            "type": "string"
          },
          "start": {
            "default": "1961",
            "description": "YYYY-MM-DD, YYYY-MM or YYYY to match time_scale",
            "title": "Start",
            "type": "string"
          },
          "end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Same format; default the current year",
            "title": "End"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "type": "object",
        "title": "app_linkArguments"
      }
    },
    {
      "name": "list_gridded_files",
      "description": "MeteoEurope1km archives on Zenodo (Europe, 1 km, 1961-2020, Cloud-Optimized GeoTIFF), free.\n\n    Rasters are Equi7 Europe (EPSG:27704), Int16 in tenths of the unit (°C, mm, hPa), NoData -9999.\n    ",
      "inputSchema": {
        "properties": {
          "variable": {
            "description": "tmean, tmax, tmin, prcp or slp (sea-level pressure, daily only)",
            "enum": [
              "tmean",
              "tmax",
              "tmin",
              "prcp",
              "slp"
            ],
            "title": "Variable",
            "type": "string"
          },
          "product": {
            "default": "day",
            "description": "day (one archive per year), mon (one per decade), ann (1961-2020), ltm_day / ltm_mon_ann (normals), ltm_diff (1991-2020 minus 1961-1990)",
            "enum": [
              "day",
              "mon",
              "ann",
              "ltm_day",
              "ltm_mon_ann",
              "ltm_diff"
            ],
            "title": "Product",
            "type": "string"
          },
          "years": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Years 1961-2020; required for day and mon",
            "title": "Years"
          },
          "period": {
            "anyOf": [
              {
                "enum": [
                  "1961-1990",
                  "1991-2020"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Normal period for ltm_day / ltm_mon_ann; default both",
            "title": "Period"
          }
        },
        "required": [
          "variable"
        ],
        "type": "object",
        "title": "list_gridded_filesArguments"
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.srpp011/dailymeteo-mcp",
    "version": "0.3.0",
    "remoteUrl": "https://mcp.gilab.rs/mcp",
    "publishedAt": "2026-11-18T12:48:10.337507Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "28c6558dcfcfbba21ae98ee8af9caf8bb302941a32a1c592f368923bfa5d32aa"
  }
}
