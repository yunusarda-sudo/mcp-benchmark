{
  "$schema": "../schema.json",
  "name": "com.boternity/boternity",
  "title": "BOTERNITY",
  "category": "Social, Media & Knowledge",
  "description": "Free MCP tools: weather, FX, quakes, holidays, service status, packages, CVEs, web, MCP audits.",
  "repository": "https://github.com/botcraftmarket/boternity-mcp",
  "tools": [
    {
      "name": "read_page",
      "description": "Read a public web page as clean Markdown with metadata and outline. Paginated; robots.txt respected.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Public http(s) URL."
          },
          "start_index": {
            "type": "integer",
            "minimum": 0,
            "description": "Offset to continue a long page."
          },
          "max_length": {
            "type": "integer",
            "minimum": 500,
            "maximum": 20000,
            "description": "Default 8000."
          },
          "include_links": {
            "type": "boolean",
            "description": "Also return links."
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "watch_page",
      "description": "Watch a public page for changes and keep each diff. Optional CSS selector, keywords, webhook. Returns an id for get_watch.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Public http(s) URL."
          },
          "interval_minutes": {
            "type": "integer",
            "minimum": 60,
            "maximum": 10080,
            "description": "Default 360."
          },
          "selector": {
            "type": "string",
            "description": "CSS selector to watch, e.g. 'main .price'."
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 10,
            "description": "Words to track."
          },
          "webhook_url": {
            "type": "string",
            "description": "https URL POSTed on change."
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "get_watch",
      "description": "State of a page watch: last check, HTTP status and recent diffs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id from watch_page."
          },
          "history": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "Default 5."
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "check_watch_now",
      "description": "Re-check a watched page now (at most once every 10 minutes).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id from watch_page."
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "stop_watch",
      "description": "Stop a page watch and delete its stored copy.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id from watch_page."
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "check_site_for_agents",
      "description": "Can AI agents use a website? Grade A-F with fixes: bot walls, robots.txt, no-JS text, schema.org, forms, APIs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Site or page URL."
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "verify_ai_bot",
      "description": "Is a visitor the real GPTBot, ClaudeBot, Googlebot...? Checks its IP against official vendor lists.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ip": {
            "type": "string",
            "description": "Visitor IP."
          },
          "user_agent": {
            "type": "string",
            "description": "User agent it sent."
          }
        },
        "required": [
          "ip"
        ]
      }
    },
    {
      "name": "test_mcp_server",
      "description": "Audit a remote MCP server: score /100 with fixes (schemas, tokens, CORS, latency). Returns an id for get_mcp_test. Only servers you may test.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "MCP endpoint URL."
          },
          "probe_tool": {
            "type": "object",
            "description": "Optional tool call to try.",
            "properties": {
              "name": {
                "type": "string",
                "description": "Tool name."
              },
              "arguments": {
                "type": "object",
                "description": "Its arguments."
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "find_mcp_server",
      "description": "Most reliable public MCP servers for a need (postgres, github...), from nightly MCP Registry checks.",
      "inputSchema": {
        "type": "object",
        "required": [
          "need"
        ],
        "properties": {
          "need": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200,
            "description": "e.g. postgres, github, web search."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Default 5."
          },
          "min_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Minimum score."
          },
          "include_auth": {
            "type": "boolean",
            "description": "Also list servers needing sign-in."
          }
        }
      }
    },
    {
      "name": "check_mcp_server_status",
      "description": "Is a public MCP server up, slow or down? Give server, or need for servers up now, or nothing for incidents.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "minLength": 2,
            "maxLength": 300,
            "description": "Registry name or endpoint URL."
          },
          "need": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80,
            "description": "e.g. postgres: servers up now."
          }
        }
      }
    },
    {
      "name": "get_mcp_test",
      "description": "Report of a test_mcp_server audit: score, grade, checks with fixes, Markdown.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id from test_mcp_server."
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "create_notebook",
      "description": "Private notebook for memory across sessions. Returns a secret token. Notes expire 30 days after last use.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "write_note",
      "description": "Save or replace a named note (up to 8000 characters).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "notebook": {
            "type": "string",
            "description": "Token from create_notebook."
          },
          "key": {
            "type": "string",
            "description": "Note name, e.g. todo (letters, digits, _.:/-)."
          },
          "value": {
            "type": "string",
            "description": "Note text."
          }
        },
        "required": [
          "notebook",
          "key",
          "value"
        ]
      }
    },
    {
      "name": "read_notes",
      "description": "Read a note by name, or list your notes (optional prefix).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "notebook": {
            "type": "string",
            "description": "Token from create_notebook."
          },
          "key": {
            "type": "string",
            "description": "Omit to list notes."
          },
          "prefix": {
            "type": "string",
            "description": "Name prefix filter."
          }
        },
        "required": [
          "notebook"
        ]
      }
    },
    {
      "name": "delete_note",
      "description": "Delete one note from your notebook by name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "notebook": {
            "type": "string",
            "description": "Token from create_notebook."
          },
          "key": {
            "type": "string",
            "description": "Note name, e.g. todo (letters, digits, _.:/-)."
          }
        },
        "required": [
          "notebook",
          "key"
        ]
      }
    },
    {
      "name": "convert_data",
      "description": "Convert data between JSON, CSV and XML; syntax errors with position.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "description": "Document text."
          },
          "from_format": {
            "type": "string",
            "description": "Format of data.",
            "enum": [
              "json",
              "csv",
              "xml"
            ]
          },
          "to_format": {
            "type": "string",
            "description": "Target format.",
            "enum": [
              "json",
              "csv",
              "xml"
            ]
          },
          "delimiter": {
            "type": "string",
            "description": "CSV delimiter for csv→json.",
            "enum": [
              ",",
              ";",
              "\t",
              "|"
            ]
          },
          "pretty": {
            "type": "boolean",
            "description": "Default true."
          }
        },
        "required": [
          "data",
          "from_format",
          "to_format"
        ]
      }
    },
    {
      "name": "inspect_json",
      "description": "Validate JSON (error line and column) or extract a value by JSON Pointer.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string",
            "description": "The JSON document as text."
          },
          "pointer": {
            "type": "string",
            "description": "RFC 6901 pointer, e.g. /items/0."
          }
        },
        "required": [
          "json"
        ]
      }
    },
    {
      "name": "analyze_table",
      "description": "Per-column table statistics: type, missing, distinct, min, max, mean, median, top values.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "minItems": 1,
            "maxItems": 500,
            "description": "Array of flat objects, one per row."
          }
        },
        "required": [
          "rows"
        ]
      }
    },
    {
      "name": "compare_tables",
      "description": "Diff two versions of a table: rows added, removed and changed (by key column).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "before": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "minItems": 1,
            "maxItems": 500,
            "description": "Array of flat objects, one per row."
          },
          "after": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "minItems": 1,
            "maxItems": 500,
            "description": "Array of flat objects, one per row."
          },
          "key": {
            "type": "string",
            "description": "Key column, e.g. id."
          }
        },
        "required": [
          "before",
          "after"
        ]
      }
    },
    {
      "name": "clean_table",
      "description": "Clean a table: trim, empty to null, dedupe, optionally parse numbers and snake_case columns.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "minItems": 1,
            "maxItems": 500,
            "description": "Array of flat objects, one per row."
          },
          "trim": {
            "type": "boolean",
            "description": "Default true."
          },
          "empty_to_null": {
            "type": "boolean",
            "description": "Default true."
          },
          "dedupe": {
            "type": "boolean",
            "description": "Default true."
          },
          "parse_numbers": {
            "type": "boolean",
            "description": "Default false."
          },
          "normalize_keys": {
            "type": "boolean",
            "description": "Default false."
          }
        },
        "required": [
          "rows"
        ]
      }
    },
    {
      "name": "compare_texts",
      "description": "Line diff of two texts with a similarity ratio.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "before": {
            "type": "string",
            "description": "Original text."
          },
          "after": {
            "type": "string",
            "description": "New text."
          }
        },
        "required": [
          "before",
          "after"
        ]
      }
    },
    {
      "name": "get_current_time",
      "description": "Current date and time in UTC or any IANA timezone.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "timezone": {
            "type": "string",
            "description": "IANA timezone, default UTC."
          }
        }
      }
    },
    {
      "name": "convert_time",
      "description": "Convert a date-time to another IANA timezone (daylight saving aware).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "datetime": {
            "type": "string",
            "description": "e.g. 2026-03-29T01:30:00Z."
          },
          "from_timezone": {
            "type": "string",
            "description": "For a date-time without offset."
          },
          "to_timezone": {
            "type": "string",
            "description": "IANA timezone, default UTC."
          }
        },
        "required": [
          "datetime"
        ]
      }
    },
    {
      "name": "compute_duration",
      "description": "Exact duration between two ISO 8601 date-times.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "description": "Start date-time (ISO 8601)."
          },
          "end": {
            "type": "string",
            "description": "End date-time (ISO 8601)."
          }
        },
        "required": [
          "start",
          "end"
        ]
      }
    },
    {
      "name": "list_cron_runs",
      "description": "Next run times of a cron expression in a timezone.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "expression": {
            "type": "string",
            "description": "Cron expression, e.g. */15 9-17 * * mon-fri."
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone, default UTC."
          },
          "after": {
            "type": "string",
            "description": "Start date-time (default now)."
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Number of runs (default 5)."
          }
        },
        "required": [
          "expression"
        ]
      }
    },
    {
      "name": "encode_text",
      "description": "Base64, base64url or URL encode/decode, or hash (SHA-256, SHA-512, SHA-1, MD5).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Text to transform (UTF-8)."
          },
          "mode": {
            "type": "string",
            "description": "Operation.",
            "enum": [
              "base64_encode",
              "base64_decode",
              "base64url_encode",
              "base64url_decode",
              "url_encode",
              "url_decode",
              "hash_sha256",
              "hash_sha512",
              "hash_sha1",
              "hash_md5"
            ]
          }
        },
        "required": [
          "text",
          "mode"
        ]
      }
    },
    {
      "name": "generate_uuid",
      "description": "Generate random UUID v4 identifiers (up to 20).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "How many UUIDs (default 1)."
          }
        }
      }
    },
    {
      "name": "parse_url",
      "description": "Split a URL into scheme, host, port, path, query parameters and fragment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "The URL to parse."
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "explain_http_status",
      "description": "Meaning, specification and retry advice for an HTTP status code.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599,
            "description": "HTTP status code, e.g. 429."
          }
        },
        "required": [
          "code"
        ]
      }
    },
    {
      "name": "search_catalog",
      "description": "Search verified spec extracts (MCP, HTTP, OpenAPI, robots.txt) by keywords.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Keywords; omit to list all."
          },
          "topic": {
            "type": "string",
            "description": "Filter by topic.",
            "enum": [
              "catalog",
              "documentation",
              "examples"
            ]
          }
        }
      }
    },
    {
      "name": "read_catalog_resource",
      "description": "Read one catalog resource: extracts and source URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Resource id from search_catalog."
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "request_resource",
      "description": "Tell BOTERNITY which data or tool you are missing; reviewed privately. No personal data.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "description": "Kind of need.",
            "enum": [
              "catalog",
              "documentation",
              "examples"
            ]
          },
          "need": {
            "type": "string",
            "minLength": 3,
            "maxLength": 280,
            "description": "What you need."
          }
        },
        "required": [
          "topic"
        ]
      }
    },
    {
      "name": "get_request_status",
      "description": "Status of a request made with request_resource.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Id from request_resource."
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "get_weather",
      "description": "Weather, 7-day forecast, air quality and local time for 250 cities (by name or coordinates). Metric.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "description": "e.g. 'Paris' or 'Portland, US'."
          },
          "latitude": {
            "type": "number",
            "description": "Latitude."
          },
          "longitude": {
            "type": "number",
            "description": "Longitude."
          },
          "days": {
            "type": "integer",
            "description": "Forecast days (default 3)."
          }
        }
      }
    },
    {
      "name": "get_exchange_rates",
      "description": "ECB rates for 30 currencies, last 90 days, any base, optional amount. No crypto.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "base": {
            "type": "string",
            "description": "Default EUR."
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "e.g. [\"USD\"]."
          },
          "amount": {
            "type": "number",
            "description": "Default 1."
          },
          "date": {
            "type": "string",
            "description": "YYYY-MM-DD (default latest)."
          }
        }
      }
    },
    {
      "name": "get_earthquakes",
      "description": "Recent earthquakes worldwide (USGS), by magnitude, hours and distance.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "min_magnitude": {
            "type": "number",
            "description": "Default 4.5."
          },
          "hours": {
            "type": "integer",
            "description": "Default 24."
          },
          "latitude": {
            "type": "number",
            "description": "Center."
          },
          "longitude": {
            "type": "number",
            "description": "Center."
          },
          "radius_km": {
            "type": "number",
            "description": "Default 500."
          },
          "sort": {
            "type": "string",
            "enum": [
              "time",
              "magnitude"
            ]
          },
          "limit": {
            "type": "integer",
            "description": "Max items."
          }
        }
      }
    },
    {
      "name": "get_disaster_alerts",
      "description": "GDACS disaster alerts: cyclones, floods, earthquakes, volcanoes, droughts, wildfires.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "tropical cyclone",
              "flood",
              "earthquake",
              "volcano",
              "drought",
              "wildfire"
            ]
          },
          "min_alert_level": {
            "type": "string",
            "description": "Default orange.",
            "enum": [
              "green",
              "orange",
              "red"
            ]
          },
          "country": {
            "type": "string",
            "description": "Country name."
          },
          "current_only": {
            "type": "boolean",
            "description": "Default true."
          },
          "limit": {
            "type": "integer",
            "description": "Max items."
          }
        }
      }
    },
    {
      "name": "get_public_holidays",
      "description": "Public holidays of 200 countries; with date, business day check.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 code, e.g. FR."
          },
          "year": {
            "type": "integer",
            "description": "Default this year."
          },
          "upcoming_only": {
            "type": "boolean",
            "description": "From today."
          },
          "date": {
            "type": "string",
            "description": "YYYY-MM-DD: business day check."
          },
          "weekend": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "0=Mon..6=Sun, default [5,6]."
          }
        },
        "required": [
          "country"
        ]
      }
    },
    {
      "name": "get_trending_topics",
      "description": "Most-read Wikipedia articles yesterday in 16 languages.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "description": "Default en.",
            "enum": [
              "en",
              "fr",
              "de",
              "es",
              "it",
              "pt",
              "ru",
              "ja",
              "zh",
              "ar",
              "pl",
              "nl",
              "ko",
              "tr",
              "hi",
              "id"
            ]
          },
          "include_adult": {
            "type": "boolean",
            "description": "Default false."
          },
          "limit": {
            "type": "integer",
            "description": "Max items."
          }
        }
      }
    },
    {
      "name": "get_exploited_vulnerabilities",
      "description": "CISA list of CVEs exploited in the wild, by CVE, vendor, product, or newest.",
      "inputSchema": {
        "type": "object",
