{
  "$schema": "../schema.json",
  "name": "net.continental/expiring-domains",
  "title": "continental.net Expiring Domains",
  "category": "Other",
  "description": "Search expiring and deleted domains with backlinks: Ahrefs DR, Moz DA, TF/CF and a Clean Score.",
  "tools": [
    {
      "name": "search_expiring_domains",
      "description": "Search expiring and deleted domains with backlinks. Returns domain, DR (Ahrefs), DA, TF, CF, TF/CF, referring domains, first year, Clean Score (0-100, Wayback history), state (backorder / free / caught / watch), drop date and a page URL. Lists: all, today, tomorrow, available (deleted and free to register now), high-dr (DR 20+), clean-domains, aged-domains, short-domains, brandable-domains, domains-with-history.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "list": {
            "type": "string",
            "enum": [
              "all",
              "today",
              "tomorrow",
              "available",
              "high-dr",
              "clean-domains",
              "aged-domains",
              "short-domains",
              "brandable-domains",
              "domains-with-history",
              "health-domains",
              "crypto-domains",
              "finance-domains",
              "travel-domains",
              "tech-domains",
              "education-domains",
              "food-domains",
              "real-estate-domains",
              "fashion-domains",
              "sports-domains",
              "pet-domains",
              "news-domains"
            ],
            "default": "all"
          },
          "keyword": {
            "type": "string",
            "description": "Part of the domain name, e.g. \"travel\""
          },
          "tld": {
            "type": "string",
            "description": "Extension without dot, e.g. \"com\""
          },
          "min_dr": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "min_ref_domains": {
            "type": "integer",
            "minimum": 0
          },
          "max_length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40,
            "description": "Max characters before the extension"
          },
          "no_digits": {
            "type": "boolean"
          },
          "no_hyphens": {
            "type": "boolean"
          },
          "clean_links": {
            "type": "boolean",
            "description": "Only TF/CF 0.5 or more"
          },
          "sort": {
            "type": "string",
            "enum": [
              "dr",
              "da",
              "tf",
              "tfcf",
              "ref_domains",
              "oldest",
              "shortest",
              "drop_date"
            ],
            "default": "dr"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_domain",
      "description": "Everything we know about one domain on the list: metrics, state, drop date, Clean Score with reasons, Wayback history (first/last year, titles, language).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "e.g. example.com"
          }
        },
        "required": [
          "domain"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "drop_stats",
      "description": "Totals: domains on the list, DR 20+, free to register now, and how many drop on each upcoming date.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "net.continental/expiring-domains",
    "version": "2.10.0",
    "remoteUrl": "https://www.continental.net/mcp",
    "publishedAt": "2026-11-22T15:46:47.205958Z",
    "fetchedAt": "2026-11-23T16:50:40.239Z",
    "toolsSha256": "8451b3341124a54459a42bc98458a58f901a3d05c1b2651efdcb82901edc9e28"
  }
}
