{
  "$schema": "../schema.json",
  "name": "io.github.reunion-one/india-real-estate",
  "title": "Reunion India Real Estate",
  "category": "Developer Tools & DevOps",
  "description": "Search official India real-estate RERA, stamp-duty and registration-charge references.",
  "tools": [
    {
      "name": "search_real_estate_regulations",
      "description": "Search Reunion's indexed official India real-estate regulatory material by keyword, state and topic, including RERA references plus reviewed stamp-duty and registration-charge material.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "states": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            }
          },
          "topics": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "enum": [
                "project_registration",
                "complaint",
                "agent_registration",
                "fees",
                "project_bank",
                "qpr_reporting",
                "public_search",
                "rules_and_circulars",
                "stamp_duty",
                "registration_fee",
                "other"
              ]
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10
          }
        }
      }
    },
    {
      "name": "compare_state_rera_processes",
      "description": "Compare indexed official references for the same RERA task across 2–6 Indian states; no-match is explicit and is not treated as absence of a legal requirement.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "states",
          "task"
        ],
        "properties": {
          "states": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            }
          },
          "task": {
            "type": "string",
            "enum": [
              "project_registration",
              "complaint",
              "agent_registration",
              "fees",
              "project_bank",
              "qpr_reporting",
              "public_search",
              "rules_and_circulars",
              "stamp_duty",
              "registration_fee",
              "other"
            ]
          }
        }
      }
    },
    {
      "name": "get_rera_portal_capabilities",
      "description": "Locate indexed official RERA portal entry points for project search, registration, complaints, agent registration and related tasks, with source provenance.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "task": {
            "type": "string",
            "enum": [
              "project_registration",
              "complaint",
              "agent_registration",
              "fees",
              "project_bank",
              "qpr_reporting",
              "public_search",
              "rules_and_circulars",
              "stamp_duty",
              "registration_fee",
              "other"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10
          }
        }
      }
    },
    {
      "name": "get_regulatory_change_history",
      "description": "Search indexed official RERA notices and circulars by state, topic and publication date, retaining source provenance and observed dates.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "topics": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "enum": [
                "project_registration",
                "complaint",
                "agent_registration",
                "fees",
                "project_bank",
                "qpr_reporting",
                "public_search",
                "rules_and_circulars",
                "stamp_duty",
                "registration_fee",
                "other"
              ]
            }
          },
          "from_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "to_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10
          }
        }
      }
    },
    {
      "name": "get_project_bank_qpr_requirements",
      "description": "Locate indexed official RERA directions and references related to project-bank and quarterly progress reporting requirements, with source provenance.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "topic": {
            "type": "string",
            "enum": [
              "project_bank",
              "qpr_reporting",
              "both"
            ],
            "default": "both"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10
          }
        }
      }
    },
    {
      "name": "get_stamp_duty_reference",
      "description": "Return reviewed official-source stamp-duty rules or calculator/rate-table references for a state and optional instrument. Numeric rates are returned only when the indexed official source states them explicitly.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "instrument_type": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10
          }
        }
      }
    },
    {
      "name": "compare_stamp_duty_rules",
      "description": "Compare stamp-duty references across 2–8 states. Each state is labeled observed, calculator_required, reference_only, or not_observed_in_current_snapshot; the tool never invents a combined rate.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "states"
        ],
        "properties": {
          "states": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            }
          },
          "instrument_type": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          }
        }
      }
    },
    {
      "name": "get_registration_charge_reference",
      "description": "Return reviewed official-source registration-fee rules, calculator references or governing determination references for a state and optional instrument, with effective/source dates where available.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "instrument_type": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10
          }
        }
      }
    },
    {
      "name": "get_source_provenance",
      "description": "Verify one Reunion MCP record against its official source URL, observation time, source-page SHA-256 and extraction locators.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{24}$"
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.reunion-one/india-real-estate",
    "version": "1.1.0",
    "remoteUrl": "https://mcp.reunionhq.in/mcp",
    "publishedAt": "2026-11-19T11:39:52.981887Z",
