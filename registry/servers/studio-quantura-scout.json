{
  "$schema": "../schema.json",
  "name": "studio.quantura/scout",
  "title": "Quantura Scout",
  "category": "Social, Media & Knowledge",
  "description": "Find tickers, retrieve historical data and forecast ranges, and analyze them with Scout.",
  "tools": [
    {
      "name": "quantura_search_markets",
      "description": "Find a stock ticker such as NVDA, a currency pair, a prediction market, a FRED series such as UNRATE, or a public SageMaker forecast. Use source=fred for economic data.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "source": {
            "type": "string",
            "maxLength": 40
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "q"
        ]
      }
    },
    {
      "name": "quantura_describe_dataset",
      "description": "Inspect columns, units and required dimensions for an economic_series source from Search. Select a single series before download or forecasting. FRED supports series_id and optional vintage_date; historical forecasts cap the vintage conservatively to avoid revised-data look-ahead.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "source": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "source"
        ]
      }
    },
    {
      "name": "quantura_forecast_models",
      "description": "Get currently available models, frequencies and minimum history requirements.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "quantura_sagemaker_forecast",
      "description": "Find the most recently published public forecast for the ticker, optionally ending on an exact date. Returns computed quantile statistics, data quality warnings and the original forecast link.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9.-]{0,11}$"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "symbol"
        ]
      }
    },
    {
      "name": "quantura_get_forecast",
      "description": "Retrieve a saved forecast by ID. Return dated quantiles and available historical context so you can explain the range for the requested ticker and horizon. Requires access to the forecast.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "forecast_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "forecast_id"
        ]
      }
    },
    {
      "name": "quantura_verify_forecast",
      "description": "Verify saved forecast content against its vBase timestamp receipt. This verifies content and time, not accuracy or historical publication before the receipt timestamp.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "forecast_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "forecast_id"
        ]
      }
    },
    {
      "name": "quantura_create_forecast",
      "description": "Forecast a ticker for a specified horizon and obtain quantile ranges. Creates an asynchronous job, uses compute and saves a request in your account. Inspect capabilities first, then poll the returned ID. Omit advanced fields for the seven-model automatic default. Paid plans, including active trials, can override models, weights, context, transforms, Toto variant and failure policy; free callers cannot. Automatic weights calibrate on earlier history with a separate audit; explicit manual mode preserves configured weights. Read weighting and effective_weights_by_quantile in the result. This does not trade.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "request": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "request",
          "idempotency_key"
        ]
      }
    },
    {
      "name": "quantura_download_history",
      "description": "Get stocks, FX, perpetuals, events, Gemini or economic history as JSON. Set mode=canvas for SageMaker Canvas item_id/timestamp/target rows. Gemini and economic datasets use a structured source object matching the forecast source. For complete Alpaca coverage use limit=all, page_mode=true and a fixed end. Follow next_cursor for paged Alpaca or Dukascopy requests without changing the other settings.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "request": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "request"
        ]
      }
    },
    {
      "name": "quantura_ask_scout",
      "description": "Ask a structured question grounded in a completed forecast, game, CSV preview or SageMaker forecast. Saves the question in your account.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "context": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "turn_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "context",
          "question",
          "turn_id"
        ]
      }
    },
    {
      "name": "quantura_my_access",
      "description": "Read your current API access and permissions.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "quantura_list_screener_forecasts",
      "description": "List the same published stock, sports-game or Kalshi perpetual forecasts shown in the screener. Returns original forecast URLs, scan_id, publication date and pagination without running models or metered billing. Stocks view=home selects the homepage feed; view=full selects the full universe. date=today requires a publication for today and never labels an old scan as new. For the next page keep scan_id and the same filters.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "stocks",
              "games",
              "kalshi_perps"
            ]
          },
          "view": {
            "type": "string",
            "enum": [
              "full",
              "home"
            ]
          },
          "date": {
            "type": "string",
            "maxLength": 10
          },
          "q": {
            "type": "string",
            "maxLength": 100
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "scan_id": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    },
    {
      "name": "quantura_get_screener_forecast",
      "description": "Retrieve a published screener forecast and its original quantile trajectory without creating a new forecast. Stocks/perpetuals use ticker and optional exact scan_id from the item’s forecast_scan_id (omit for latest); the list-level scan_id is for pagination; sports games use forecast_id from the list tool. This is separate from private saved ensemble forecast IDs.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "stocks",
              "games",
              "kalshi_perps"
            ]
          },
          "ticker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "forecast_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "scan_id": {
            "type": "string",
            "maxLength": 160
          }
        },
        "required": [
          "source"
        ]
      }
    },
    {
      "name": "quantura_preview_csv",
      "description": "Validate predictions versus observed history and supplied metrics, without saving or starting models. Exactly one of csv_text/content_base64 is required.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "source_timezone": {
            "type": "string",
            "enum": [
              "UTC",
              "America/New_York"
            ]
          },
          "dataset_kind": {
            "type": "string",
            "enum": [
              "sagemaker_predictions",
              "historical_series"
            ]
          },
          "csv_text": {
            "type": "string",
            "maxLength": 3000000
          },
          "content_base64": {
            "type": "string",
            "maxLength": 3950000
          },
          "filename": {
            "type": "string",
            "maxLength": 240
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "ticker": {
            "type": "string",
            "maxLength": 12
          },
          "date_column": {
            "type": "string",
            "maxLength": 160
          },
          "value_column": {
            "type": "string",
            "maxLength": 160
          },
          "metrics": {
            "type": "object",
            "properties": {
              "average_wql": {
                "type": "number",
                "minimum": 0
              },
              "mape": {
                "type": "number",
                "minimum": 0
              },
              "wape": {
                "type": "number",
                "minimum": 0
              },
              "rmse": {
                "type": "number",
                "minimum": 0
              },
              "mase": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "required": [
          "dataset_kind"
        ]
      }
    },
    {
      "name": "quantura_import_csv",
      "description": "Use the same import service as Upload CSV in Quantura market search. Store privately for the uploader or a currently authorized Clerk organization. Public visibility requires the designated verified platform owner, publish scope and publish_confirmed=true. Reuse request_id for an identical retry; never start a new upload automatically after an uncertain response. Prediction uploads require ticker; names default to ticker, row count and actual CSV byte size. No training starts.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "source_timezone": {
            "type": "string",
            "enum": [
              "UTC",
              "America/New_York"
            ]
          },
          "dataset_kind": {
            "type": "string",
            "enum": [
              "sagemaker_predictions",
              "historical_series"
            ]
          },
          "csv_text": {
            "type": "string",
            "maxLength": 3000000
          },
          "content_base64": {
            "type": "string",
            "maxLength": 3950000
          },
          "filename": {
            "type": "string",
            "maxLength": 240
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "ticker": {
            "type": "string",
            "maxLength": 12
          },
          "date_column": {
            "type": "string",
            "maxLength": 160
          },
          "value_column": {
            "type": "string",
            "maxLength": 160
          },
          "metrics": {
            "type": "object",
            "properties": {
              "average_wql": {
                "type": "number",
                "minimum": 0
              },
              "mape": {
                "type": "number",
                "minimum": 0
              },
              "wape": {
                "type": "number",
                "minimum": 0
              },
              "rmse": {
                "type": "number",
                "minimum": 0
              },
              "mase": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "request_id": {
            "type": "string",
            "minLength": 16,
            "maxLength": 100
          },
          "workspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "workspace",
              "public"
            ]
          },
          "publish_confirmed": {
            "type": "boolean"
          },
          "email_alert": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "rules": {
                "maxItems": 4,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "price"
                        },
                        "direction": {
                          "type": "string",
                          "enum": [
                            "above",
                            "below"
                          ]
                        },
                        "value": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 1000000000
                        }
                      },
                      "required": [
                        "kind",
                        "direction",
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "quantile"
                        },
                        "direction": {
                          "type": "string",
                          "enum": [
                            "above",
                            "below"
                          ]
                        },
                        "quantile": {
                          "type": "string",
                          "maxLength": 12
                        }
                      },
                      "required": [
                        "kind",
                        "direction",
                        "quantile"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": [
              "enabled",
              "rules"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "dataset_kind",
          "request_id"
        ]
      }
    },
    {
      "name": "quantura_list_private_csvs",
      "description": "List only currently authorized private datasets in the active workspace. Source ownership and organization membership are rechecked. No public sharing.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    {
      "name": "quantura_get_csv",
      "description": "Read original columns, values, supplied metrics and provenance from an authorized uploaded CSV or public catalog ID.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "quantura_resolve_market_link",
      "description": "Resolve exact HTTPS polymarket.com, polymarket.us or kalshi.com event/market links into venue-specific outcomes. International Polymarket is download-only sampled-price history.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "quantura_option_expiry_horizons",
      "description": "Get Alpaca-listed expiries, calendar days since the downloaded close date, and projected trading periods. Counts use XNYS regular sessions; weekly/monthly grids may not land on an expiry. Not an option trading/exercise deadline.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "underlying": {
            "type": "string",
            "maxLength": 12
          },
          "last_timestamp": {
            "type": "string",
            "maxLength": 40
          },
          "last_close_date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "frequency": {
            "type": "string",
            "maxLength": 12
          },
          "session": {
            "type": "string",
            "enum": [
              "regular",
              "extended"
            ]
          }
        },
        "required": [
          "underlying",
          "last_timestamp",
          "frequency"
        ]
      }
    },
    {
      "name": "quantura_analyze_csv",
      "description": "Compute the ZIP-compatible dated quantile inversions, rolling observed-close sample variance (ddof=1), nearest quantile and ranges of every column. Separately returns population forecast statistics and conditional latest-close bias. SELL comparisons are descriptive, not validated trades. Pages preserve full summary; detailed comparisons are capped at 10000.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "interval": {
            "type": "string",
            "enum": [
              "1m",
              "5m",
              "15m",
              "30m",
              "1h",
              "4h",
              "1d"
            ]
          },
          "lookback": {
            "type": "integer",
            "minimum": 2,
            "maximum": 1000
          },
          "start": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "causal": {
            "type": "boolean"
          },
          "bar_label": {
            "type": "string",
            "enum": [
              "start",
              "end"
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "include_comparisons": {
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "quantura_get_csv_close_alert",
      "description": "Requires alerts:read and datasets:read plus current CSV access. Returns only your subscription. Uses completed raw IEX regular-session daily closes; no recipient address is exposed.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "quantura_set_csv_close_alert",
      "description": "Opt in or disable a personal email notification. Requires alerts:write, datasets:read, current source access and verified primary account email. No arbitrary recipient. One email per matching new trading date; 90-day expiry. Quantile rules require daily rows and use the same New York date, skipping crossed rows. No trade execution or model run.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "settings": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "rules": {
                "maxItems": 4,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "price"
                        },
                        "direction": {
                          "type": "string",
                          "enum": [
                            "above",
                            "below"
                          ]
                        },
                        "value": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 1000000000
                        }
                      },
                      "required": [
                        "kind",
                        "direction",
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "quantile"
                        },
                        "direction": {
                          "type": "string",
                          "enum": [
                            "above",
                            "below"
                          ]
                        },
                        "quantile": {
                          "type": "string",
                          "maxLength": 12
                        }
                      },
                      "required": [
                        "kind",
                        "direction",
                        "quantile"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": [
              "enabled",
              "rules"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "settings"
        ]
      }
    },
    {
      "name": "quantura_export_csv_google_sheets",
      "description": "Creates a private Google spreadsheet in the authenticated user’s linked Google account. Requires sheets:export scope, Google drive.file consent and source download permission. Preserve request_id when retrying; uncertain creation is never duplicated automatically. Does not share the Google file with the organization.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "request_id": {
            "type": "string",
            "minLength": 16,
            "maxLength": 100
          }
        },
        "required": [
          "id",
          "request_id"
        ]
      }
    },
    {
      "name": "quantura_export_csv_workbook",
      "description": "Creates a private Google workbook with a tab per source and a summary Index. Requires datasets:read, sheets:export, current download permissions and Google consent. Use the same IDs, title and request_id for retries.",
      "inputSchema": {
