{
  "$schema": "../schema.json",
  "name": "Cheerio MCP",
  "category": "Web Scraping & Automation",
  "description": "Cheerio MCP integration tools for AI agent workflows.",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "maintainer": "community",
  "tools": [
    {
      "name": "extract_html_text",
      "description": "Parse raw HTML string using Cheerio DOM parser and extract matching text elements.",
      "inputSchema": {
        "type": "object",
        "required": [
          "html",
          "selector"
        ],
        "properties": {
          "html": {
            "type": "string",
            "description": "Raw HTML markup content."
          },
          "selector": {
            "type": "string",
            "description": "CSS selector to extract."
          }
        }
      }
    }
  ]
}
