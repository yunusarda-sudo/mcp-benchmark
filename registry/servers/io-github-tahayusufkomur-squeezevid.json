{
  "$schema": "../schema.json",
  "name": "io.github.tahayusufkomur/squeezevid",
  "title": "SqueezeVid",
  "category": "Developer Tools & DevOps",
  "description": "Platform video upload limits, target-size bitrate & FFmpeg planner, and browser media tool router.",
  "repository": "https://github.com/tahayusufkomur/squeezevid-mcp",
  "tools": [
    {
      "name": "get_platform_upload_limits",
      "description": "Return verified video file size limits, recommended target sizes, resolutions, official source URLs, and pre-configured zero-upload SqueezeVid URLs for Discord, WhatsApp, Email (Gmail/Outlook), TikTok, Instagram, X (Twitter), and Telegram.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "description": "Platform name ('discord', 'whatsapp', 'email', 'tiktok', 'instagram', 'twitter', 'x', 'telegram') or 'all'.",
            "default": "all"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "calculate_compression_plan",
      "description": "Calculate exact target video/audio bitrates with 5% container safety headroom, recommended resolution (never upscaling), quality assessment, copy-pasteable 1-pass and 2-pass FFmpeg commands, and the best SqueezeVid browser/cloud mode to fit a target size or platform upload cap.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "duration_seconds": {
            "type": "number",
            "description": "Video duration in seconds (must be > 0).",
            "minimum": 0.5,
            "maximum": 86400
          },
          "target_size_mb": {
            "type": "number",
            "description": "Maximum desired output file size in MB (optional if platform provides a preset target).",
            "minimum": 0.5,
            "maximum": 20000
          },
          "platform": {
            "type": "string",
            "description": "Optional target platform ('discord', 'whatsapp', 'email', 'tiktok', 'instagram', 'twitter', 'x', 'telegram')."
          },
          "input_size_mb": {
            "type": "number",
            "description": "Optional current file size in MB (used to compute reduction % and pick browser WASM vs WebCodecs vs Cloud).",
            "minimum": 0.1
          },
          "source_resolution": {
            "type": "string",
            "enum": [
              "original",
              "4k",
              "2160p",
              "1440p",
              "1080p",
              "720p",
              "480p",
              "360p",
              "240p"
            ],
            "description": "Optional source resolution so recommendations never upscale.",
            "default": "original"
          },
          "audio_bitrate_kbps": {
            "type": "integer",
            "description": "Desired audio bitrate in kbps (0 for muted video, default 128).",
            "minimum": 0,
            "maximum": 320,
            "default": 128
          },
          "codec": {
            "type": "string",
            "enum": [
              "h264",
              "h265",
              "vp9"
            ],
            "description": "Target video codec (default 'h264' for widest compatibility).",
            "default": "h264"
          }
        },
        "required": [
          "duration_seconds"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "build_ffmpeg_command",
      "description": "Generate a shell-safe, ready-to-run FFmpeg CLI command with flag explanations and a matching zero-upload SqueezeVid browser tool URL for common media tasks (compress, convert, to_gif, gif_to_mp4, extract_audio, trim, crop, mute, rotate, change_speed, reverse).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "compress",
              "convert",
              "to_gif",
              "extract_audio",
              "trim",
              "crop",
              "mute",
              "rotate",
              "change_speed",
              "reverse",
              "gif_to_mp4"
            ],
            "description": "Media operation to build an FFmpeg command for."
          },
          "input_file": {
            "type": "string",
            "description": "Input filename or path (default 'input.mp4')."
          },
          "output_file": {
            "type": "string",
            "description": "Optional output filename."
          },
          "crf": {
            "type": "integer",
            "description": "CRF value for 'compress' (14–40, default 26).",
            "minimum": 14,
            "maximum": 40
          },
          "resolution": {
            "type": "string",
            "enum": [
              "original",
              "1080p",
              "720p",
              "480p",
              "360p",
              "240p"
            ],
            "description": "Target resolution for 'compress'."
          },
          "output_format": {
            "type": "string",
            "enum": [
              "mp4",
              "webm",
              "mov",
              "mkv",
              "avi"
            ],
            "description": "Output container format for 'convert'."
          },
          "audio_format": {
            "type": "string",
            "enum": [
              "mp3",
              "wav",
              "aac",
              "ogg",
              "flac"
            ],
            "description": "Output audio format for 'extract_audio'."
          },
          "start_time": {
            "type": "string",
            "description": "Start timestamp for 'trim' (seconds or HH:MM:SS)."
          },
          "end_time": {
            "type": "string",
            "description": "End timestamp for 'trim' (seconds or HH:MM:SS)."
          },
          "fps": {
            "type": "integer",
            "description": "Frame rate for 'to_gif' (1–30, default 12).",
            "minimum": 1,
            "maximum": 30
          },
          "width": {
            "type": "integer",
            "description": "Width in pixels for 'to_gif' (64–1920, default 480).",
            "minimum": 64,
            "maximum": 1920
          },
          "speed": {
            "type": "number",
            "description": "Playback speed multiplier for 'change_speed' (0.25–4.0, default 2.0).",
            "minimum": 0.25,
            "maximum": 4
          },
          "rotation": {
            "type": "string",
            "enum": [
              "90_cw",
              "90_ccw",
              "180"
            ],
            "description": "Rotation direction for 'rotate' (default '90_cw')."
          },
          "crop_rect": {
            "type": "string",
            "description": "Crop rectangle 'width:height:x:y' for 'crop' (e.g. '1080:1080:420:0')."
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "recommend_squeezevid_tool",
      "description": "Recommend the best SqueezeVid tool(s) and processing engine (Browser WASM <=2 GB, Large Browser WebCodecs Beta <=10 GB, Cloud <=10 GB, Canvas image, or browser PDF) for a user's media task, file size, format pair, privacy requirement, and locale.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "description": "Plain-language description of what the user wants to do (e.g. 'compress 4GB MOV privately', 'convert HEIC to JPG', 'merge PDFs')."
          },
          "file_size_mb": {
            "type": "number",
            "description": "Optional file size in MB to route between WASM (<=2 GB), WebCodecs Beta (<=10 GB), and Cloud (<=10 GB).",
            "minimum": 0.01
          },
          "input_format": {
            "type": "string",
            "description": "Optional input extension (e.g. 'mov', 'mkv', 'heic', 'pdf', 'm4a')."
          },
          "output_format": {
            "type": "string",
            "description": "Optional target extension (e.g. 'mp4', 'gif', 'mp3', 'jpg', 'pdf')."
          },
          "privacy_required": {
            "type": "boolean",
            "description": "Prefer zero-upload on-device browser tools (default true).",
            "default": true
          },
          "locale": {
            "type": "string",
            "description": "Preferred ISO language code (e.g. 'en', 'de', 'es', 'fr', 'pt', 'ja', 'ru', 'tr'). Falls back to 'en' if unavailable.",
            "default": "en"
          }
        },
        "required": [
          "task"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_squeezevid_tools",
      "description": "List SqueezeVid's enabled privacy-first browser and cloud media tools, file size limits, engines, supported formats, pricing summary, and direct URLs.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "all",
              "compress",
              "convert",
              "edit",
              "audio",
              "gif",
              "image",
              "pdf",
              "platforms",
              "target_sizes"
            ],
            "description": "Filter by tool category (default 'all').",
            "default": "all"
          },
          "locale": {
            "type": "string",
            "description": "Preferred ISO language code (default 'en').",
            "default": "en"
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "io.github.tahayusufkomur/squeezevid",
    "version": "1.0.0",
    "remoteUrl": "https://www.squeezevid.com/mcp",
    "publishedAt": "2026-11-26T20:27:35.975202Z",
    "fetchedAt": "2026-11-27T10:42:49.718Z",
    "toolsSha256": "4a54c6b8cd00f64820daf404050934a1829f3a5813047cef173ec5a91b60c3c1"
  }
}
