{
  "$schema": "../schema.json",
  "name": "com.japanground/public-sandbox",
  "title": "Japan Ground Network public synthetic sandbox",
  "category": "Finance, Crypto & Web3",
  "description": "Japan field-recording service discovery and synthetic request previews. No booking or payments.",
  "tools": [
    {
      "name": "jgn_get_public_status",
      "description": "Read current public sandbox limits and live-commerce closure.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "jgn_list_services",
      "description": "Read JGN public service scope and indicative pilot pricing from the official public catalog. No live availability or accepted quote.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "jgn_search_demo_workers",
      "description": "Compare fictional operators for integration testing. These are synthetic fixtures, never real staff or availability.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "zone": {
            "type": "string",
            "const": "osaka-demo"
          },
          "service_code": {
            "type": "string",
            "enum": [
              "site_photo_check",
              "item_condition_record"
            ]
          },
          "budget_cap_jpy": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 1000000
          }
        },
        "required": [
          "zone",
          "service_code"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "jgn_get_demo_worker",
      "description": "Read a fictional operator fixture. Not real identity, skills verification, history or availability.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "worker_id": {
            "type": "string",
            "enum": [
              "demo-operator-a",
              "demo-operator-b"
            ]
          }
        },
        "required": [
          "worker_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "jgn_preview_request",
      "description": "Validate a fixed synthetic request example against the local request schema. Does not persist a draft, submit, quote, book, pay or dispatch. Only enum selections and bounded integers are accepted.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "service_code": {
            "type": "string",
            "enum": [
              "site_photo_check",
              "item_condition_record"
            ]
          },
          "target_id": {
            "type": "string",
            "enum": [
              "demo-osaka-building",
              "demo-osaka-item"
            ]
          },
          "worker_id": {
            "type": "string",
            "enum": [
              "demo-operator-a",
              "demo-operator-b"
            ]
          },
          "checklist_codes": {
            "minItems": 1,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "target_match",
                "front_view",
                "side_view",
                "entrance_view",
                "signage",
                "frontage_road",
                "limitations",
                "permission",
                "model_number",
                "all_sides",
                "damage",
                "accessories"
              ]
            }
          },
          "budget_cap_jpy": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 1000000
          },
          "report_locale": {
            "type": "string",
            "enum": [
              "en",
              "ja"
            ]
          },
          "access_basis": {
            "type": "string",
            "enum": [
              "public_vantage_point",
              "documented_permission",
              "unverified"
            ]
          }
        },
        "required": [
          "service_code",
          "target_id",
          "worker_id",
          "checklist_codes",
          "budget_cap_jpy",
          "report_locale",
          "access_basis"
        ],
        "additionalProperties": false
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "com.japanground/public-sandbox",
    "version": "0.1.0",
    "remoteUrl": "https://jgn-public-sandbox.japanground-sandbox.workers.dev/mcp",
    "publishedAt": "2026-11-18T00:35:05.512566Z",
    "fetchedAt": "2026-11-28T10:03:29.931Z",
