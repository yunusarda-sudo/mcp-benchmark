{
  "$schema": "../schema.json",
  "name": "ai.toolsenabled/tesi-agent",
  "title": "TESI Agent Computer (1–8 vCPU Linux + Chrome)",
  "category": "AI, LLMs & Agents",
  "description": "Isolated 1-8 vCPU Firecracker Linux + Chrome computer for AI agents. $2.50 free trial, $0/mo.",
  "tools": [
    {
      "name": "tesi_discover",
      "description": "Read the free TESI Agent API offer, credit pack prices, Remote HTTP MCP & Binary Files endpoints, and Work starters.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "full": {
            "type": "boolean",
            "description": "Set true for full /api/v1/agents catalog; default false returns compact quickstart."
          }
        }
      }
    },
    {
      "name": "tesi_quote",
      "description": "Quote exact minimum starting credit and eligible USD packs for a planned Ask or Work brief (free, keyless; optional Authorization: Bearer compares against your key balance).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "promptBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500000
          },
          "mode": {
            "type": "string",
            "enum": [
              "ask",
              "work"
            ]
          },
          "effort": {
            "type": "string",
            "enum": [
              "auto",
              "auto-fast",
              "auto-ultrafast",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultra"
            ]
          },
          "inputTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        }
      }
    },
    {
      "name": "tesi_shortlist_work",
      "description": "Compare public TESI Work starters against a planned decimal credit budget or your authenticated bearer key balance.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "budgetCredits": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "tesi_balance",
      "description": "Read spendable prepaid TESI credits on your Authorization: Bearer key (reconciling up to 5 unsettled top-ups) and optional rolling-window spend.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "windowHours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 744
          }
        }
      }
    },
    {
      "name": "tesi_usage",
      "description": "Inspect itemized settled debit charges (agc_... IDs and exact TESI credits) or rolling-window debit totals.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "windowHours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 744
          }
        }
      }
    },
    {
      "name": "tesi_plan_topup",
      "description": "Read-only check comparing a planned brief against your key balance and unsettled top-ups without opening Stripe Checkout.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "promptBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500000
          }
        }
      }
    },
    {
      "name": "tesi_prepare_purchase",
      "description": "Keyless: review a USD credit pack (quoteOnly: true) or create a one-time Stripe Checkout session ($10, $25, $50, or $100 USD) for human approval.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amountCents"
        ],
        "properties": {
          "amountCents": {
            "type": "integer",
            "minimum": 100,
            "maximum": 1000000
          },
          "quoteOnly": {
            "type": "boolean"
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "purchaseId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    {
      "name": "tesi_claim_key",
      "description": "Keyless: claim a free $2.50 trial key (trial=true, no card), claim a paid Stripe sessionId (2-8 vCPU), or preview/redeem an issued giftCode to mint a reusable tesi_ak_... bearer key.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "trial": {
            "type": "boolean",
            "description": "Set true to claim a free $2.50 USD trial key with no credit card (1 key per subnet per 30 days)."
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "sessionId": {
            "type": "string"
          },
          "purchaseId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "giftCode": {
            "type": "string",
            "minLength": 1
          },
          "preview": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "tesi_prepare_topup",
      "description": "Create, recover, or reconcile a same-key Stripe Checkout top-up for your authenticated bearer key.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "amountCents": {
            "type": "integer",
            "minimum": 100,
            "maximum": 1000000
          },
          "sessionId": {
            "type": "string"
          },
          "recoverOnly": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "tesi_ask",
      "description": "Run a paid read-only TESI Ask turn on your key's isolated Linux computer with manual top-up protection and idempotent requestId receipt recovery.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "string",
            "enum": [
              "auto",
              "auto-fast",
              "auto-ultrafast",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultra"
            ]
          },
          "requestId": {
            "type": "string",
            "pattern": "^mw_[a-f0-9]{32}$"
          },
          "allowAutoTopupCheckout": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "tesi_work",
      "description": "Commission a paid TESI Work deliverable (software, SQLite/CSV, PDF/Excel/PPTX in /home/user/workspace, or browser QA) on your key's isolated Linux computer.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1
          },
          "acceptanceChecks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "effort": {
            "type": "string",
            "enum": [
              "auto",
              "auto-fast",
              "auto-ultrafast",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              "ultra"
            ]
          },
          "requestId": {
            "type": "string",
            "pattern": "^mw_[a-f0-9]{32}$"
          },
          "allowAutoTopupCheckout": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "tesi_receipt",
      "description": "Read a turn receipt by requestId (recovering verified replies with zero extra spend) or list recent receipts for your key.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "pattern": "^mw_[a-f0-9]{32}$"
          },
          "listReceipts": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "enum": [
              "ask",
              "work"
            ]
          },
          "delivery": {
            "type": "string",
            "enum": [
              "ready",
              "unresolved"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "pattern": "^mw_[a-f0-9]{32}$"
          }
        }
      }
    },
    {
      "name": "tesi_files_list",
      "description": "List files and folders inside your bearer key's isolated 4 GB TESI workspace (default /home/user/workspace), returning version tokens for SHA-256 downloads.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "folder": {
            "type": "string",
            "description": "Workspace directory path (default /home/user/workspace)."
          },
          "after": {
            "type": "string",
            "description": "Optional pagination cursor."
          }
        }
      }
    },
    {
      "name": "tesi_upload_file",
      "description": "Upload a binary (contentBase64) or UTF-8 (contentUtf8) file into your bearer key's isolated TESI workspace with X-Content-Sha256 verification (up to 768 KiB inline over MCP; stream up to 50 MiB via POST /api/v1/agents/files/upload).",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fileName"
        ],
        "properties": {
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "folder": {
            "type": "string",
            "description": "Destination workspace folder (default /home/user/workspace)."
          },
          "contentBase64": {
            "type": "string",
            "description": "Base64-encoded binary payload (PDF, XLSX, PNG, ZIP, CSV, etc.)."
          },
          "contentUtf8": {
            "type": "string",
            "description": "Plain UTF-8 file text when uploading text/CSV/JSON."
          }
        }
      }
    },
    {
      "name": "tesi_download_file",
      "description": "Download a versioned binary or text artifact (.xlsx, .pdf, .pptx, .png, .zip) from your bearer key's isolated TESI workspace with SHA-256 verification.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "version"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 2,
            "description": "Full workspace file path (e.g. /home/user/workspace/report.xlsx)."
          },
          "version": {
            "type": "string",
            "pattern": "^v1-(?:[0-9a-f]+-){4}[0-9a-f]+$",
            "description": "File version token returned by tesi_files_list."
          },
          "includeBase64": {
            "type": "boolean",
            "description": "Default true (returns verified contentBase64 up to 1 MiB); set false for streaming endpoint metadata."
          }
        }
      }
    }
  ],
  "source": {
    "type": "registry",
    "registry": "registry.modelcontextprotocol.io",
    "name": "ai.toolsenabled/tesi-agent",
    "version": "1.0.1",
    "remoteUrl": "https://toolsenabled.ai/api/v1/agents/mcp",
    "publishedAt": "2026-11-26T07:05:33.800261Z",
    "fetchedAt": "2026-11-26T10:40:47.803Z",
